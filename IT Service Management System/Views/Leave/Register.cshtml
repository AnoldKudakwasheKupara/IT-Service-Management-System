@using IT_Service_Management_System.Models.Hr
@using IT_Service_Management_System.Helpers
@model List<LeaveRequest>
@{
    ViewData["Title"] = "Leave Register";
    var paging = ViewBag.Paging as PagingInfo;
    var types = ViewBag.LeaveTypes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    string Spaced(string v) => System.Text.RegularExpressions.Regex.Replace(v, "(?<=[a-z])(?=[A-Z])", " ");
    string StatusClass(LeaveRequestStatus s) => s switch
    {
        LeaveRequestStatus.Approved or LeaveRequestStatus.Taken => "b-active",
        LeaveRequestStatus.Rejected => "b-danger",
        LeaveRequestStatus.Cancelled => "b-left",
        LeaveRequestStatus.ManagerApproved => "b-leave",
        LeaveRequestStatus.Submitted => "b-probation",
        _ => "b-neutral"
    };
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div style="display:flex; gap:.9rem; align-items:flex-start;">
                    <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-table-list"></i> Leave Register</h1>
                        <p class="page-sub">Every leave request across the organisation</p>
                    </div>
                </div>
                <div class="head-actions">
                    <a asp-action="Balances" class="btn-ghost-hr"><i class="fas fa-scale-balanced"></i> Balances</a>
                    <a asp-action="Types" class="btn-ghost-hr"><i class="fas fa-sliders"></i> Leave types</a>
                    <a asp-action="Calendar" class="btn-outline-hr"><i class="fas fa-calendar-days"></i> Calendar</a>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-filter"></i> Filter</span></div>
            <div class="card-body">
                <form method="get" class="toolbar">
                    <div class="fg" style="flex:2; min-width:200px;">
                        <label class="lbl">Employee</label>
                        <input type="text" name="q" value="@ViewBag.Q" class="inp" placeholder="Name or employee number…" />
                    </div>
                    <div class="fg">
                        <label class="lbl">Leave type</label>
                        <select name="leaveTypeId" class="inp">
                            <option value="">All</option>
                            @foreach (var t in types)
                            {
                                <option value="@t.Id" selected="@(ViewBag.LeaveTypeId as int? == (int)t.Id)">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="fg">
                        <label class="lbl">Status</label>
                        <select name="status" class="inp">
                            <option value="">All</option>
                            @foreach (var s in Enum.GetValues<LeaveRequestStatus>())
                            {
                                <option value="@s" selected="@(ViewBag.Status as LeaveRequestStatus? == s)">@Spaced(s.ToString())</option>
                            }
                        </select>
                    </div>
                    <div class="fg">
                        <label class="lbl">From</label>
                        <input type="date" name="from" class="inp" value="@((ViewBag.From as DateTime?)?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <div class="fg">
                        <label class="lbl">To</label>
                        <input type="date" name="to" class="inp" value="@((ViewBag.To as DateTime?)?.ToString("yyyy-MM-dd"))" />
                    </div>
                    <button type="submit" class="btn-hr"><i class="fas fa-magnifying-glass"></i> Search</button>
                    <a asp-action="Register" class="btn-ghost-hr"><i class="fas fa-rotate-left"></i> Clear</a>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-list"></i> Requests</span>
                <span class="meta">@(paging?.TotalCount ?? Model.Count) total</span>
            </div>
            <div class="card-body flush">
                @if (Model.Count == 0)
                {
                    <div class="empty">
                        <i class="fas fa-umbrella-beach"></i>
                        <h3>Nothing matches</h3>
                        <p>Adjust the filters above.</p>
                    </div>
                }
                else
                {
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Ref</th><th>Employee</th><th>Department</th><th>Type</th>
                                <th>Dates</th><th class="num">Days</th><th>Pay split</th><th>Status</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td><a asp-action="Details" asp-route-id="@r.Id" class="ref">@r.Reference</a></td>
                                    <td>
                                        <a asp-controller="Employees" asp-action="Details" asp-route-id="@r.EmployeeId" class="strong-link">
                                            @r.Employee?.DisplayName
                                        </a>
                                        <div class="meta" style="font-size:.7rem;">@r.Employee?.EmployeeNumber</div>
                                    </td>
                                    <td class="meta">@(r.Employee?.Department?.Name ?? "—")</td>
                                    <td>
                                        <i class="fas fa-circle" style="font-size:.55rem; color:@(r.LeaveType?.Colour ?? "#94a3b8");"></i>
                                        @r.LeaveType?.Name
                                    </td>
                                    <td class="meta">@r.StartDate.ToString("d MMM yy") – @r.EndDate.ToString("d MMM yy")</td>
                                    <td class="num">@r.Days.ToString("0.##")</td>
                                    <td class="meta" style="font-size:.75rem;">
                                        @if (r.HalfPayDays > 0 || r.UnpaidDays > 0)
                                        {
                                            <text>@r.FullPayDays.ToString("0.##") full</text>
                                            @if (r.HalfPayDays > 0)
                                            {
                                                <text> · @r.HalfPayDays.ToString("0.##") half</text>
                                            }
                                            @if (r.UnpaidDays > 0)
                                            {
                                                <text> · @r.UnpaidDays.ToString("0.##") unpaid</text>
                                            }
                                        }
                                        else
                                        {
                                            <text>full pay</text>
                                        }
                                    </td>
                                    <td><span class="badge-hr @StatusClass(r.Status)">@Spaced(r.Status.ToString())</span></td>
                                    <td style="text-align:right;">
                                        <a asp-action="Details" asp-route-id="@r.Id" class="act view"><i class="fas fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <partial name="_HrPager" model="@paging" />

    </div>
</div>
