@using IT_Service_Management_System.Models.Hr
@{
    ViewData["Title"] = "Leave Approvals";
    var asManager = ViewBag.AsManager as List<LeaveRequest> ?? new List<LeaveRequest>();
    var asHr = ViewBag.AsHr as List<LeaveRequest> ?? new List<LeaveRequest>();
    var isHr = ViewBag.IsHr as bool? ?? false;
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div style="display:flex; gap:.9rem; align-items:flex-start;">
                    <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-inbox"></i> Leave Approvals</h1>
                        <p class="page-sub">
                            The line manager decides first, then HR — HR sees the balance across the
                            organisation and the statutory position behind it.
                        </p>
                    </div>
                </div>
                <div class="head-actions">
                    <a asp-action="Calendar" class="btn-ghost-hr"><i class="fas fa-calendar-days"></i> Who's away</a>
                    @if (isHr)
                    {
                        <a asp-action="Register" class="btn-outline-hr"><i class="fas fa-table-list"></i> Register</a>
                    }
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        <div class="stats">
            <div class="stat">
                <div class="ic amber"><i class="fas fa-user-tie"></i></div>
                <div><h3>@asManager.Count</h3><p>Waiting on you as manager</p></div>
            </div>
            @if (isHr)
            {
                <div class="stat">
                    <div class="ic brand"><i class="fas fa-building-user"></i></div>
                    <div><h3>@asHr.Count</h3><p>Waiting on HR</p></div>
                </div>
                <div class="stat">
                    <div class="ic blue"><i class="fas fa-calendar-day"></i></div>
                    <div><h3>@(asManager.Concat(asHr).Count(r => r.StartDate <= DateTime.Today.AddDays(7)))</h3><p>Starting within a week</p></div>
                </div>
            }
        </div>

        @{
            async Task RenderQueue(string title, string icon, List<LeaveRequest> items, bool hr)
            {
                <div class="card">
                    <div class="card-head">
                        <span class="t"><i class="fas @icon"></i> @title</span>
                        <span class="meta">@items.Count awaiting a decision</span>
                    </div>
                    <div class="card-body flush">
                        @if (items.Count == 0)
                        {
                            <div class="empty" style="padding:2rem 1rem;">
                                <i class="fas fa-circle-check" style="color:var(--success);"></i>
                                <h3>Nothing waiting</h3>
                            </div>
                        }
                        else
                        {
                            <table class="tbl">
                                <thead>
                                    <tr>
                                        <th>Ref</th><th>Employee</th><th>Type</th><th>Dates</th>
                                        <th class="num">Days</th><th>Starts in</th><th style="text-align:right;">Decide</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in items)
                                    {
                                        var daysAway = (r.StartDate.Date - DateTime.Today).Days;
                                        <tr>
                                            <td><a asp-action="Details" asp-route-id="@r.Id" class="ref">@r.Reference</a></td>
                                            <td>
                                                <span class="with-avatar">
                                                    <span class="avatar sm">@r.Employee?.FirstName.FirstOrDefault()@r.Employee?.LastName.FirstOrDefault()</span>
                                                    <span>@r.Employee?.DisplayName</span>
                                                </span>
                                            </td>
                                            <td>
                                                <i class="fas fa-circle" style="font-size:.55rem; color:@(r.LeaveType?.Colour ?? "#94a3b8");"></i>
                                                @r.LeaveType?.Name
                                            </td>
                                            <td class="meta">@r.StartDate.ToString("d MMM") – @r.EndDate.ToString("d MMM yyyy")</td>
                                            <td class="num">@r.Days.ToString("0.##")</td>
                                            <td class="meta @(daysAway <= 3 ? "overdue" : "")">
                                                @(daysAway < 0 ? "already started" : daysAway == 0 ? "today" : $"{daysAway} day(s)")
                                            </td>
                                            <td style="text-align:right;">
                                                <form asp-action="Decide" method="post" style="display:inline-flex; gap:.3rem; align-items:center;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <input type="hidden" name="asHr" value="@hr.ToString().ToLower()" />
                                                    <input type="text" name="note" class="inp" placeholder="Note"
                                                           style="width:130px; padding:.25rem .45rem; font-size:.75rem;" />
                                                    <button type="submit" name="approve" value="true" class="act ok" title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                    <button type="submit" name="approve" value="false" class="act del" title="Reject — needs a note">
                                                        <i class="fas fa-xmark"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
        }

        @{ await RenderQueue("Your team's leave", "fa-user-tie", asManager, false); }

        @if (isHr)
        {
            await RenderQueue("Manager-approved, awaiting HR", "fa-building-user", asHr, true);
        }

    </div>
</div>
