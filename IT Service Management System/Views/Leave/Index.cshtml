@using IT_Service_Management_System.Models.Hr
@{
    var me = ViewBag.Employee as Employee;
    var year = (int)(ViewBag.Year ?? DateTime.Today.Year);
    ViewData["Title"] = "My Leave";
    var balances = ViewBag.Balances as List<LeaveBalance> ?? new List<LeaveBalance>();
    var requests = ViewBag.Requests as List<LeaveRequest> ?? new List<LeaveRequest>();
    var teamAway = ViewBag.TeamAway as List<LeaveRequest> ?? new List<LeaveRequest>();

    string StatusClass(LeaveRequestStatus s) => s switch
    {
        LeaveRequestStatus.Approved or LeaveRequestStatus.Taken => "b-active",
        LeaveRequestStatus.Rejected => "b-danger",
        LeaveRequestStatus.Cancelled => "b-left",
        LeaveRequestStatus.ManagerApproved => "b-leave",
        LeaveRequestStatus.Submitted => "b-probation",
        _ => "b-neutral"
    };
    string Spaced(string v) => System.Text.RegularExpressions.Regex.Replace(v, "(?<=[a-z])(?=[A-Z])", " ");
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-umbrella-beach"></i> My Leave</h1>
                    <p class="page-sub">
                        @me?.DisplayName · @me?.JobTitle · entitlements under the Labour Act [Chapter 28:01]
                    </p>
                </div>
                <div class="head-actions">
                    <a asp-action="Calendar" class="btn-ghost-hr"><i class="fas fa-calendar-days"></i> Who's away</a>
                    <a asp-action="Queue" class="btn-ghost-hr"><i class="fas fa-inbox"></i> Approvals</a>
                    <a asp-action="Apply" class="btn-hr"><i class="fas fa-plus-circle"></i> Apply for leave</a>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        @* ── BALANCES ────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-scale-balanced"></i> Balances for @year</span>
                <span style="display:flex; gap:.4rem;">
                    <a asp-action="Index" asp-route-year="@(year - 1)" class="btn-ghost-hr btn-sm">@(year - 1)</a>
                    <a asp-action="Index" asp-route-year="@year" class="btn-hr btn-sm">@year</a>
                </span>
            </div>
            <div class="card-body flush">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>Leave type</th><th class="num">Entitlement</th><th class="num">Taken</th>
                            <th class="num">Booked</th><th class="num">Pending</th><th class="num">Available</th>
                            <th>Basis</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in balances)
                        {
                            <tr>
                                <td>
                                    <span style="display:inline-flex; align-items:center; gap:.5rem;">
                                        <i class="fas fa-circle" style="font-size:.6rem; color:@(b.LeaveType?.Colour ?? "#94a3b8");"></i>
                                        <strong style="color:var(--gray-800);">@b.LeaveType?.Name</strong>
                                    </span>
                                    @if (b.LeaveType?.HasHalfPayTier == true && b.HalfPayTaken > 0)
                                    {
                                        <div><span class="badge-hr b-warn">@b.HalfPayTaken.ToString("0.##") day(s) at half pay</span></div>
                                    }
                                    @if (b.LeaveType?.IsPaid == false)
                                    {
                                        <span class="chip">Unpaid</span>
                                    }
                                </td>
                                <td class="num">@b.Entitlement.ToString("0.##")</td>
                                <td class="num">@b.Taken.ToString("0.##")</td>
                                <td class="num">@b.Booked.ToString("0.##")</td>
                                <td class="num">@(b.Pending > 0 ? b.Pending.ToString("0.##") : "—")</td>
                                <td class="num">
                                    <strong style="color:@(b.Available > 0 ? "var(--success)" : "var(--gray-400)");">
                                        @b.Available.ToString("0.##")
                                    </strong>
                                </td>
                                <td class="meta" style="font-size:.75rem; max-width:240px;">@b.LeaveType?.Authority</td>
                                <td style="text-align:right;">
                                    <a asp-action="Ledger" asp-route-employeeId="@b.EmployeeId"
                                       asp-route-leaveTypeId="@b.LeaveTypeId" asp-route-year="@year"
                                       class="act view" title="Movement history"><i class="fas fa-list"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="grid-2-1">
            <div>
                @* ── MY REQUESTS ─────────────────────────────────────────── *@
                <div class="card">
                    <div class="card-head">
                        <span class="t"><i class="fas fa-list"></i> My requests</span>
                        <span class="meta">@requests.Count in @year</span>
                    </div>
                    <div class="card-body flush">
                        @if (requests.Count == 0)
                        {
                            <div class="empty">
                                <i class="fas fa-umbrella-beach"></i>
                                <h3>No leave booked this year</h3>
                                <p>Your vacation entitlement accrues every month whether or not you use it.</p>
                                <a asp-action="Apply" class="btn-hr"><i class="fas fa-plus-circle"></i> Apply for leave</a>
                            </div>
                        }
                        else
                        {
                            <table class="tbl">
                                <thead><tr><th>Ref</th><th>Type</th><th>Dates</th><th class="num">Days</th><th>Status</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var r in requests)
                                    {
                                        <tr>
                                            <td><a asp-action="Details" asp-route-id="@r.Id" class="ref">@r.Reference</a></td>
                                            <td>
                                                <i class="fas fa-circle" style="font-size:.55rem; color:@(r.LeaveType?.Colour ?? "#94a3b8");"></i>
                                                @r.LeaveType?.Name
                                            </td>
                                            <td class="meta">
                                                @r.StartDate.ToString("d MMM")
                                                @if (r.StartDate.Date != r.EndDate.Date) { <text>– @r.EndDate.ToString("d MMM yyyy")</text> }
                                                @if (r.IsHalfDay) { <span class="chip">half day</span> }
                                            </td>
                                            <td class="num">@r.Days.ToString("0.##")</td>
                                            <td>
                                                <span class="badge-hr @StatusClass(r.Status)">@Spaced(r.Status.ToString())</span>
                                                @if (r.IsInProgress) { <div><span class="chip">away now</span></div> }
                                            </td>
                                            <td style="text-align:right;">
                                                <a asp-action="Details" asp-route-id="@r.Id" class="act view"><i class="fas fa-eye"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>

            <div>
                <div class="card">
                    <div class="card-head"><span class="t"><i class="fas fa-users"></i> Others away</span></div>
                    <div class="card-body">
                        @if (teamAway.Count == 0)
                        {
                            <p class="meta">Nobody else in your team has leave booked.</p>
                        }
                        @foreach (var r in teamAway)
                        {
                            <div style="display:flex; gap:.55rem; align-items:center; padding:.4rem 0; border-bottom:1px solid var(--gray-100);">
                                <span class="avatar sm">@r.Employee?.FirstName.FirstOrDefault()@r.Employee?.LastName.FirstOrDefault()</span>
                                <div style="flex:1; min-width:0;">
                                    <div style="font-size:.84rem; color:var(--gray-800);">@r.Employee?.DisplayName</div>
                                    <div class="meta" style="font-size:.72rem;">
                                        @r.LeaveType?.Name · @r.StartDate.ToString("d MMM") – @r.EndDate.ToString("d MMM")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-head"><span class="t"><i class="fas fa-circle-info"></i> Your statutory minimums</span></div>
                    <div class="card-body">
                        <p class="meta" style="line-height:1.6; font-size:.82rem;">
                            The Labour Act [Chapter 28:01] sets the floor: 30 days vacation a year accruing
                            monthly (s.14A), 90 days sick leave on full pay then 90 at half pay (s.14),
                            98 days maternity leave (s.18), and up to 12 days special leave (s.14B).
                        </p>
                        <p class="meta" style="line-height:1.6; font-size:.82rem; margin-top:.6rem;">
                            Your contract or the NEC agreement for this sector may give you more. Where it
                            does, the better term applies.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
