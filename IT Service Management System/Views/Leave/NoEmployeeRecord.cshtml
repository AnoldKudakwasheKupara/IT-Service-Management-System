@{
    ViewData["Title"] = "No employee record";
}

<partial name="_HrStyles" />

<div class="hr narrow">
    <div class="page-container">
        <div class="card">
            <div class="card-body">
                <div class="empty">
                    <i class="fas fa-address-book"></i>
                    <h3>Your account is not linked to an employee record</h3>
                    <p>
                        Leave, attendance and payroll all hang off the employee register rather than
                        off the login account, so there is nothing to show until HR links the two.
                    </p>
                    <p class="meta">
                        Ask HR to open the employee register, find your record and set its
                        <strong>linked account</strong> — or to create one if you are not on it yet.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
