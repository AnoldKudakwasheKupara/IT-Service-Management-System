@model IT_Service_Management_System.ViewModels.Ecie.RefSection

@if (Model.Items != null && Model.Items.Count > 0)
{
    <div class="ref-section-card">
        <div class="ref-section-header">
            <div class="ref-section-title">
                <i class="fas @Model.Icon"></i>
                <span>@Model.Title</span>
            </div>
            <span class="ref-section-count">@Model.Items.Count</span>
        </div>
        <div class="ref-section-body">
            @foreach (var e in Model.Items)
            {
                var hasUrl = !string.IsNullOrEmpty(e.Url);
                <a href="@(hasUrl ? e.Url : "javascript:void(0)")"
                   class="ref-item @(hasUrl ? "clickable" : "non-clickable")"
                    @(hasUrl ? "" : "style=cursor:default;")>
                    <div class="ref-item-icon">
                        <i class="fas @e.Icon"></i>
                    </div>
                    <div class="ref-item-content">
                        <div class="ref-item-title">
                            @if (!string.IsNullOrEmpty(e.Reference))
                            {
                                <span class="ref-item-ref">@e.Reference</span>
                                <span class="ref-item-separator">—</span>
                            }
                            <span>@e.Title</span>
                        </div>
                        <div class="ref-item-meta">
                            <span>@e.Kind</span>
                            @if (!string.IsNullOrEmpty(e.Subtitle))
                            {
                                <span class="ref-item-meta-separator">·</span>
                                <span>@e.Subtitle</span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(e.Badge))
                    {
                        <span class="ref-item-badge">@e.Badge</span>
                    }
                    @if (hasUrl)
                    {
                        <i class="fas fa-chevron-right ref-item-arrow"></i>
                    }
                </a>
            }
        </div>
    </div>
}

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== REFERENCE SECTION CARD ===== */
    .ref-section-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

        .ref-section-card:hover {
            box-shadow: var(--shadow-md);
        }

    /* ===== HEADER ===== */
    .ref-section-header {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .ref-section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--gray-700);
        font-size: 0.875rem;
    }

        .ref-section-title i {
            font-size: 0.95rem;
            color: var(--primary);
            width: 20px;
            text-align: center;
        }

    .ref-section-count {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--gray-500);
        background: var(--gray-100);
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        border: 1px solid var(--gray-200);
    }

    /* ===== BODY ===== */
    .ref-section-body {
        padding: 0;
    }

    /* ===== REFERENCE ITEM ===== */
    .ref-item {
        display: flex;
        gap: 0.85rem;
        align-items: center;
        padding: 0.7rem 1.25rem;
        border-bottom: 1px solid var(--gray-100);
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
        position: relative;
    }

        .ref-item:last-child {
            border-bottom: none;
        }

        .ref-item.clickable {
            cursor: pointer;
        }

            .ref-item.clickable:hover {
                background-color: var(--gray-50);
                text-decoration: none;
            }

                .ref-item.clickable:hover .ref-item-arrow {
                    transform: translateX(4px);
                    color: var(--primary);
                }

                .ref-item.clickable:hover .ref-item-title span {
                    color: var(--primary);
                }

        .ref-item.non-clickable {
            cursor: default;
            opacity: 0.75;
        }

    /* ===== ICON ===== */
    .ref-item-icon {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--gray-50);
        border-radius: 0.5rem;
        border: 1px solid var(--gray-200);
        transition: all 0.2s ease;
    }

    .ref-item.clickable:hover .ref-item-icon {
        background: var(--primary-light);
        border-color: var(--primary);
    }

    .ref-item-icon i {
        font-size: 0.8rem;
        color: var(--primary);
        width: 16px;
        text-align: center;
        transition: color 0.2s ease;
    }

    .ref-item.clickable:hover .ref-item-icon i {
        color: white;
    }

    .ref-item.clickable:hover .ref-item-icon {
        background: var(--primary);
        border-color: var(--primary);
    }

    /* ===== CONTENT ===== */
    .ref-item-content {
        flex: 1;
        min-width: 0;
    }

    .ref-item-title {
        font-weight: 600;
        color: var(--gray-800);
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        flex-wrap: wrap;
        transition: color 0.2s ease;
    }

        .ref-item-title span {
            transition: color 0.2s ease;
        }

    .ref-item-ref {
        color: var(--primary);
        font-weight: 700;
        font-size: 0.8rem;
    }

    .ref-item-separator {
        color: var(--gray-300);
        font-weight: 400;
    }

    .ref-item-meta {
        font-size: 0.75rem;
        color: var(--gray-500);
        margin-top: 0.05rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
    }

    .ref-item-meta-separator {
        color: var(--gray-300);
    }

    /* ===== BADGE ===== */
    .ref-item-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .ref-item-badge.b-internal {
            background: #fceaeb;
            color: var(--info);
            border-color: #f4ced0;
        }

        .ref-item-badge.b-critical {
            background: #fee;
            color: var(--danger);
            border-color: #fed7d7;
        }

        .ref-item-badge.b-success {
            background: #e6f5e9;
            color: var(--success);
            border-color: #c6e0c9;
        }

        .ref-item-badge.b-warning {
            background: #fffbeb;
            color: #92400e;
            border-color: #fde68a;
        }

    /* ===== ARROW ===== */
    .ref-item-arrow {
        flex-shrink: 0;
        color: var(--gray-300);
        font-size: 0.75rem;
        transition: all 0.25s ease;
        margin-left: 0.25rem;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .ref-section-header {
            padding: 0.75rem 1rem;
        }

        .ref-section-title {
            font-size: 0.8rem;
        }

            .ref-section-title i {
                font-size: 0.85rem;
            }

        .ref-item {
            padding: 0.6rem 1rem;
            gap: 0.65rem;
        }

        .ref-item-icon {
            width: 28px;
            height: 28px;
        }

            .ref-item-icon i {
                font-size: 0.7rem;
            }

        .ref-item-title {
            font-size: 0.8rem;
        }

        .ref-item-ref {
            font-size: 0.7rem;
        }

        .ref-item-meta {
            font-size: 0.65rem;
        }

        .ref-item-badge {
            font-size: 0.55rem;
            padding: 0.1rem 0.4rem;
        }

        .ref-item-arrow {
            font-size: 0.65rem;
        }
    }

    @@media (max-width: 576px) {
        .ref-item {
            padding: 0.5rem 0.75rem;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .ref-item-icon {
            width: 24px;
            height: 24px;
        }

            .ref-item-icon i {
                font-size: 0.6rem;
            }

        .ref-item-title {
            font-size: 0.75rem;
        }

        .ref-item-ref {
            font-size: 0.65rem;
        }

        .ref-item-meta {
            font-size: 0.6rem;
        }

        .ref-item-badge {
            font-size: 0.5rem;
            padding: 0.05rem 0.35rem;
            margin-left: auto;
        }

        .ref-item-arrow {
            display: none;
        }
    }
</style>
