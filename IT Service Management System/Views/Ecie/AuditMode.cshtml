@using IT_Service_Management_System.ViewModels.Ecie
@model AuditModeVm
@{
    ViewData["Title"] = "Audit Mode";
    string Ring(string band) => band == "green" ? "var(--success)" : band == "amber" ? "var(--warning)" : "var(--danger)";
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-user-secret"></i> Audit Mode</h1>
                    <p class="page-sub">The engine acts as an external auditor — requesting evidence, scoring readiness and identifying gaps</p>
                </div>
                <div class="head-actions">
                    <a class="btn-ghost-ims" asp-action="Index"><i class="fas fa-brain"></i> Ask the Engine</a>
                    <a class="btn-outline-ims" asp-action="Health"><i class="fas fa-heart-pulse"></i> Compliance Health</a>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-gavel"></i> Audit Readiness Verdict</span>
                <span class="badge-ims @(Model.Health.OverallBand == "green" ? "b-published" : Model.Health.OverallBand == "amber" ? "b-medium" : "b-critical")">Overall @Model.Health.Overall/100</span>
            </div>
            <div class="card-body">
                <p style="margin:0;color:var(--gray-800);font-size:1.05rem;font-weight:600;">@Model.Readiness.Summary</p>
                @if (Model.Readiness.Answer.Any())
                {
                    <ul style="margin:1rem 0 0;padding-left:1.1rem;color:var(--gray-700);line-height:1.7;">
                        @foreach (var a in Model.Readiness.Answer) { <li>@a</li> }
                    </ul>
                }
            </div>
        </div>

        @* Readiness scores strip *@
        <div class="stats">
            @foreach (var s in Model.Health.Scores)
            {
                <div class="stat">
                    <div class="ic @s.Band" style="background:@Ring(s.Band);"><i class="fas @s.Icon"></i></div>
                    <div><h3>@s.Score</h3><p>@s.Name</p></div>
                </div>
            }
        </div>

        <div class="form-grid" style="align-items:start;">
            <partial name="_Notes" model='new NoteSection("Identified Gaps &amp; Improvements", "fa-list-check", Model.Readiness.NextActions)' />
            <partial name="_Notes" model='new NoteSection("Auditor Recommendations", "fa-lightbulb", Model.Readiness.Recommendations)' />
        </div>

        <partial name="_Refs" model='new RefSection("Evidence Sampled", "fa-folder-open", Model.Readiness.EvidenceUsed)' />

        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-clipboard-question"></i> Auditor Evidence Requests</span></div>
            <div class="card-body">
                <p class="hint" style="margin-top:0;">Click a request to have the engine retrieve the supporting evidence:</p>
                <div style="display:flex;flex-direction:column;gap:.5rem;">
                    @foreach (var q in Model.Questions)
                    {
                        <a asp-action="Index" asp-route-q="@q" style="display:flex;gap:.6rem;align-items:center;padding:.7rem 1rem;border:1px solid var(--gray-200);border-radius:.7rem;text-decoration:none;color:var(--gray-800);background:white;">
                            <i class="fas fa-magnifying-glass" style="color:var(--primary);"></i> @q
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
