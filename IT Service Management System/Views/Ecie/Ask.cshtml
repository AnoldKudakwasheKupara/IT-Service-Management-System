@using IT_Service_Management_System.ViewModels.Ecie
@model EcieResponse
@{
    ViewData["Title"] = "Compliance Intelligence";
    var aiEnabled = (bool)(ViewBag.AiEnabled ?? false);
    var confClass = Model.Confidence switch { EcieConfidence.High => "green", EcieConfidence.Medium => "amber", _ => "red" };
    string confColor = Model.Confidence switch { EcieConfidence.High => "var(--success)", EcieConfidence.Medium => "var(--warning)", EcieConfidence.Low => "var(--danger)", _ => "var(--gray-400)" };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-brain"></i> Compliance Intelligence Engine</h1>
                    <p class="page-sub">
                        Grounded answers from your approved records — never invented.
                        <span class="badge-ims @(aiEnabled ? "b-published" : "b-internal")">
                            <i class="fas @(aiEnabled ? "fa-robot" : "fa-shield-halved")"></i> @(aiEnabled ? "AI phrasing on" : "Deterministic mode")
                        </span>
                    </p>
                </div>
                <div class="head-actions">
                    <a class="btn-outline-ims" asp-action="Health"><i class="fas fa-heart-pulse"></i> Compliance Health</a>
                    <a class="btn-ghost-ims" asp-action="AuditMode"><i class="fas fa-user-secret"></i> Audit Mode</a>
                </div>
            </div>
        </div>

        <form method="get" asp-action="Index" class="card">
            <div class="card-body">
                <div style="display:flex;gap:.5rem;">
                    <input class="inp" name="q" value="@Model.Query" placeholder="e.g. What evidence supports ISO 27001 Clause 6.1?" autofocus />
                    <button class="btn-primary-ims" type="submit"><i class="fas fa-paper-plane"></i> Ask</button>
                </div>
                <div style="margin-top:.75rem;display:flex;flex-wrap:wrap;gap:.4rem;">
                    @foreach (var s in Model.Suggestions)
                    {
                        <a class="badge-ims b-internal" style="text-decoration:none;cursor:pointer;" asp-action="Index" asp-route-q="@s">@s</a>
                    }
                </div>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="card">
                <div class="card-head">
                    <span class="t"><i class="fas @Model.SpecialistIcon"></i> @Model.Specialist</span>
                    <span class="meta" title="Confidence reflects how much approved evidence backs this answer">
                        Confidence: <strong style="color:@confColor">@Model.Confidence (@Model.ConfidencePercent%)</strong>
                    </span>
                </div>
                <div class="card-body">
                    <div style="display:flex;gap:.85rem;align-items:flex-start;">
                        <div class="ic blue" style="width:42px;height:42px;border-radius:.7rem;display:flex;align-items:center;justify-content:center;color:white;background:linear-gradient(135deg,var(--primary),var(--primary-dark));flex-shrink:0;"><i class="fas @Model.SpecialistIcon"></i></div>
                        <div style="flex:1;">
                            <p style="margin:0 0 .5rem;color:var(--gray-800);font-size:1.05rem;font-weight:600;">@Model.Summary</p>
                            <div class="progress-ims @confClass" style="max-width:280px;"><span style="width:@Model.ConfidencePercent%"></span></div>
                        </div>
                    </div>
                    @if (Model.Answer.Any())
                    {
                        <ul style="margin:1rem 0 0;padding-left:1.1rem;color:var(--gray-700);line-height:1.7;">
                            @foreach (var a in Model.Answer) { <li>@a</li> }
                        </ul>
                    }
                </div>
            </div>

            <partial name="_Refs" model='new RefSection("Evidence Used", "fa-shield-halved", Model.EvidenceUsed)' />

            <div class="form-grid" style="align-items:start;">
                <partial name="_Refs" model='new RefSection("Related Documents", "fa-file-shield", Model.RelatedDocuments)' />
                <partial name="_Refs" model='new RefSection("Related Policies", "fa-file-lines", Model.RelatedPolicies)' />
                <partial name="_Refs" model='new RefSection("Related Procedures", "fa-diagram-project", Model.RelatedProcedures)' />
                <partial name="_Refs" model='new RefSection("Related Risks", "fa-gauge-high", Model.RelatedRisks)' />
                <partial name="_Refs" model='new RefSection("Related CAPAs", "fa-screwdriver-wrench", Model.RelatedCapas)' />
                <partial name="_Refs" model='new RefSection("Related Audits & Findings", "fa-magnifying-glass", Model.RelatedAudits)' />
                <partial name="_Refs" model='new RefSection("Related Meetings", "fa-people-group", Model.RelatedMeetings)' />
                <partial name="_Refs" model='new RefSection("Related Training", "fa-graduation-cap", Model.RelatedTraining)' />
            </div>

            <div class="form-grid" style="align-items:start;">
                <partial name="_Notes" model='new NoteSection("Recommendations", "fa-lightbulb", Model.Recommendations)' />
                <partial name="_Notes" model='new NoteSection("Next Actions", "fa-list-check", Model.NextActions)' />
                <partial name="_Notes" model='new NoteSection("Potential Risks", "fa-triangle-exclamation", Model.PotentialRisks)' />
            </div>
        }
    </div>
</div>
