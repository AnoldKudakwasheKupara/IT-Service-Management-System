@model IT_Service_Management_System.ViewModels.Ecie.ComplianceHealthVm
@{
    ViewData["Title"] = "Compliance Health";
    string Ring(string band) => band == "green" ? "var(--success)" : band == "amber" ? "var(--warning)" : "var(--danger)";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-heart-pulse me-2" style="color: var(--primary);"></i>
                    Compliance Health Score
                </h1>
                <p class="text-muted mt-2">Continuously computed from live records — every figure is itself audit evidence</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn-create-ticket" asp-action="Index" style="background: var(--gray-100); color: var(--gray-700);">
                    <i class="fas fa-brain"></i>
                    Ask the Engine
                </a>
                <a class="btn-create-ticket" asp-action="AuditMode" style="background: var(--gray-100); color: var(--gray-700);">
                    <i class="fas fa-user-secret"></i>
                    Audit Mode
                </a>
            </div>
        </div>
    </div>

    <!-- OVERALL SCORE CARD -->
    <div class="data-card">
        <div class="card-body-custom">
            <div class="score-container">
                <!-- Gauge -->
                <div class="gauge-wrapper">
                    <div class="gauge-ring" style="background: conic-gradient(@Ring(Model.OverallBand) @(Model.Overall * 3.6)deg, var(--gray-100) 0deg);">
                        <div class="gauge-inner">
                            <div class="gauge-value" style="color: @Ring(Model.OverallBand);">@Model.Overall</div>
                            <div class="gauge-label">Overall</div>
                        </div>
                    </div>
                </div>

                <!-- Details -->
                <div class="score-details">
                    <h2 class="score-title">
                        Compliance is <span style="color: @Ring(Model.OverallBand);">@Model.OverallLabel</span>
                    </h2>
                    <p class="score-meta">
                        Weighted across nine management-system dimensions.
                        @(Model.AiEnabled ? "AI phrasing enabled." : "Deterministic engine — no external AI calls.")
                    </p>
                    @if (Model.Alerts.Any())
                    {
                        <div class="alert-list">
                            @foreach (var a in Model.Alerts)
                            {
                                <div class="alert-item">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    <span>@a</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- DIMENSION SCORES -->
    <div class="dimension-grid">
        @foreach (var s in Model.Scores)
        {
            var bandClass = s.Band == "green" ? "green" : s.Band == "amber" ? "amber" : "red";
            <div class="dimension-card">
                <div class="dimension-header">
                    <div class="dimension-icon" style="background: @Ring(s.Band);">
                        <i class="fas @s.Icon"></i>
                    </div>
                    <div class="dimension-info">
                        <div class="dimension-score">@s.Score<span class="dimension-total">/100</span></div>
                        <div class="dimension-name">@s.Name</div>
                    </div>
                </div>
                <div class="progress-bar-track @bandClass">
                    <div class="progress-bar-fill @bandClass" style="width: @s.Score%;"></div>
                </div>
                <div class="dimension-detail">@s.Detail</div>
            </div>
        }
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== SCORE CONTAINER ===== */
    .score-container {
        display: flex;
        gap: 2rem;
        align-items: center;
        flex-wrap: wrap;
    }

    /* ===== GAUGE ===== */
    .gauge-wrapper {
        flex-shrink: 0;
    }

    .gauge-ring {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.6s ease;
    }

    .gauge-inner {
        width: 118px;
        height: 118px;
        border-radius: 50%;
        background: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.04);
    }

    .gauge-value {
        font-size: 2.4rem;
        font-weight: 800;
        line-height: 1.1;
        transition: color 0.3s ease;
    }

    .gauge-label {
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--gray-400);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ===== SCORE DETAILS ===== */
    .score-details {
        flex: 1;
        min-width: 240px;
    }

    .score-title {
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
    }

    .score-meta {
        margin: 0.35rem 0 0 0;
        font-size: 0.85rem;
        color: var(--gray-500);
        line-height: 1.5;
    }

    /* ===== ALERTS ===== */
    .alert-list {
        margin-top: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .alert-item {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        color: var(--gray-700);
        font-size: 0.875rem;
        padding: 0.4rem 0.75rem;
        background: #fffbeb;
        border-radius: 0.5rem;
        border-left: 3px solid var(--warning);
    }

        .alert-item i {
            color: var(--warning);
            font-size: 0.9rem;
            flex-shrink: 0;
        }

    /* ===== DIMENSION GRID ===== */
    .dimension-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .dimension-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

        .dimension-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    /* ===== DIMENSION HEADER ===== */
    .dimension-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .dimension-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

    .dimension-card:hover .dimension-icon {
        transform: scale(1.05);
    }

    .dimension-info {
        flex: 1;
    }

    .dimension-score {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        line-height: 1.2;
    }

    .dimension-total {
        font-size: 0.85rem;
        color: var(--gray-400);
        font-weight: 400;
        margin-left: 0.1rem;
    }

    .dimension-name {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-top: 0.05rem;
    }

    /* ===== PROGRESS BAR ===== */
    .progress-bar-track {
        width: 100%;
        height: 8px;
        background: var(--gray-100);
        border-radius: 1rem;
        overflow: hidden;
    }

        .progress-bar-track.green .progress-bar-fill {
            background: linear-gradient(90deg, #6ee7b7, var(--success));
        }

        .progress-bar-track.amber .progress-bar-fill {
            background: linear-gradient(90deg, #fcd34d, var(--warning));
        }

        .progress-bar-track.red .progress-bar-fill {
            background: linear-gradient(90deg, #fca5a5, var(--danger));
        }

    .progress-bar-fill {
        height: 100%;
        border-radius: 1rem;
        transition: width 0.8s ease;
        min-width: 4px;
    }

    /* ===== DIMENSION DETAIL ===== */
    .dimension-detail {
        font-size: 0.78rem;
        color: var(--gray-500);
        line-height: 1.4;
        padding-top: 0.1rem;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .score-container {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .score-details {
            min-width: 0;
            width: 100%;
        }

        .score-title {
            font-size: 1.25rem;
        }

        .gauge-ring {
            width: 130px;
            height: 130px;
        }

        .gauge-inner {
            width: 102px;
            height: 102px;
        }

        .gauge-value {
            font-size: 2rem;
        }

        .dimension-grid {
            grid-template-columns: 1fr;
        }

        .dimension-card {
            padding: 1rem;
        }

        .dimension-score {
            font-size: 1.25rem;
        }

        .alert-item {
            font-size: 0.8rem;
            padding: 0.35rem 0.6rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .gauge-ring {
            width: 110px;
            height: 110px;
        }

        .gauge-inner {
            width: 86px;
            height: 86px;
        }

        .gauge-value {
            font-size: 1.7rem;
        }

        .gauge-label {
            font-size: 0.6rem;
        }

        .score-title {
            font-size: 1.1rem;
        }

        .score-meta {
            font-size: 0.8rem;
        }

        .dimension-icon {
            width: 38px;
            height: 38px;
            font-size: 0.9rem;
        }

        .dimension-score {
            font-size: 1.1rem;
        }

        .dimension-name {
            font-size: 0.65rem;
        }

        .dimension-detail {
            font-size: 0.72rem;
        }

        .progress-bar-track {
            height: 6px;
        }
    }
</style>
