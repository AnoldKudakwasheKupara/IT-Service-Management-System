@model IT_Service_Management_System.ViewModels.Ecie.NoteSection

@if (Model.Items != null && Model.Items.Count > 0)
{
    <div class="note-section-card">
        <div class="note-section-header">
            <i class="fas @Model.Icon"></i>
            <span>@Model.Title</span>
        </div>
        <div class="note-section-body">
            <ul class="note-section-list">
                @foreach (var i in Model.Items)
                {
                    <li>@i</li>
                }
            </ul>
        </div>
    </div>
}

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== NOTE SECTION CARD ===== */
    .note-section-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

        .note-section-card:hover {
            box-shadow: var(--shadow-md);
        }

    /* ===== HEADER ===== */
    .note-section-header {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .note-section-header i {
            font-size: 0.95rem;
            color: var(--primary);
            width: 20px;
            text-align: center;
        }

        .note-section-header span {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--gray-700);
        }

    /* ===== BODY ===== */
    .note-section-body {
        padding: 1rem 1.5rem;
    }

    /* ===== LIST ===== */
    .note-section-list {
        margin: 0;
        padding-left: 1.5rem;
        color: var(--gray-700);
        line-height: 1.8;
        list-style: none;
    }

        .note-section-list li {
            position: relative;
            padding: 0.3rem 0 0.3rem 1.5rem;
            font-size: 0.9rem;
            color: var(--gray-700);
            border-bottom: 1px solid var(--gray-50);
        }

            .note-section-list li:last-child {
                border-bottom: none;
            }

            .note-section-list li::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0.7rem;
                width: 8px;
                height: 8px;
                background: var(--primary-light);
                border-radius: 50%;
                border: 1.5px solid var(--primary);
                transition: all 0.2s ease;
            }

    .note-section-card:hover .note-section-list li::before {
        background: var(--primary);
        transform: scale(1.1);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 576px) {
        .note-section-header {
            padding: 0.75rem 1rem;
        }

            .note-section-header i {
                font-size: 0.85rem;
            }

            .note-section-header span {
                font-size: 0.8rem;
            }

        .note-section-body {
            padding: 0.75rem 1rem;
        }

        .note-section-list {
            padding-left: 1.25rem;
        }

            .note-section-list li {
                font-size: 0.8rem;
                padding: 0.2rem 0 0.2rem 1.25rem;
            }

                .note-section-list li::before {
                    width: 6px;
                    height: 6px;
                    top: 0.55rem;
                }
    }
</style>
