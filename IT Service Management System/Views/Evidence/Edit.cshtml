@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model IsoEvidence
@{
    ViewData["Title"] = "Edit " + Model.Reference;
}
<partial name="_ImsStyles" />

<div class="ims narrow">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Details" asp-route-id="@Model.Id"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-pen-to-square"></i> Edit @Model.Reference</h1>
                        <p class="page-sub">Update evidence metadata. The attached file is not changed here.</p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="hint" style="color:var(--danger)"></div>
                    <div class="form-grid">
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
                            <input class="inp" asp-for="Title" required />
                            <span asp-validation-for="Title" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-tag"></i> Type</label>
                            <select class="inp" asp-for="Type" asp-items="Html.GetEnumSelectList<EvidenceType>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
                            <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-list-ol"></i> ISO Clause</label>
                            <input class="inp" asp-for="IsoClause" placeholder="e.g. 9.2" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-link"></i> Linked Record Type</label>
                            <input class="inp" asp-for="LinkedEntityType" placeholder="e.g. Audit, Capa, Risk (optional)" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-hashtag"></i> Linked Record Id</label>
                            <input class="inp" type="number" asp-for="LinkedEntityId" placeholder="Optional" />
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-align-left"></i> Description</label>
                            <textarea class="inp" asp-for="Description" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Save Changes</button>
                        <a class="btn-ghost-ims" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
