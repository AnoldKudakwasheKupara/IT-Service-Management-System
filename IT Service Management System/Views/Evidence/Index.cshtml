@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<IsoEvidence>
@{
    ViewData["Title"] = "Evidence Repository";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    string TypeClass(EvidenceType t) => t switch
    {
        EvidenceType.Certificate => "b-published",
        EvidenceType.Report or EvidenceType.Record => "b-medium",
        EvidenceType.Photo or EvidenceType.Screenshot => "b-internal",
        _ => "b-open"
    };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-paperclip"></i> Evidence Repository</h1>
                    <p class="page-sub">Objective evidence of conformity — records, certificates, reports &amp; more</p>
                </div>
                <div class="head-actions">
                    @if (canManage)
                    {
                        <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Capture Evidence</a>
                    }
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="card" style="border-color:#a7f3d0;background:#ecfdf5;"><div class="card-body" style="color:#1e6b45;"><i class="fas fa-circle-check"></i> @TempData["Success"]</div></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="card" style="border-color:#fecaca;background:#fef2f2;"><div class="card-body" style="color:#b3261e;"><i class="fas fa-triangle-exclamation"></i> @TempData["Error"]</div></div>
        }

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-paperclip"></i></div><div><h3>@ViewBag.Total</h3><p>Total Evidence</p></div></div>
            <div class="stat"><div class="ic teal"><i class="fas fa-file-lines"></i></div><div><h3>@ViewBag.Documents</h3><p>Documents / Records</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-certificate"></i></div><div><h3>@ViewBag.Certificates</h3><p>Certificates</p></div></div>
            <div class="stat"><div class="ic purple"><i class="fas fa-file-arrow-down"></i></div><div><h3>@ViewBag.WithFile</h3><p>With File</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <input class="inp" type="text" name="q" value="@ViewBag.Query" placeholder="Search title, description, file…" />
            <select class="inp" name="type" onchange="this.form.submit()">
                <option value="">All types</option>
                @foreach (EvidenceType t in Enum.GetValues(typeof(EvidenceType)))
                {
                    <option value="@t" selected="@(ViewBag.Type as EvidenceType? == t)">@t</option>
                }
            </select>
            <select class="inp" name="standard" onchange="this.form.submit()">
                <option value="">All standards</option>
                @foreach (IsoStandard s in Enum.GetValues(typeof(IsoStandard)))
                {
                    <option value="@s" selected="@(ViewBag.Standard as IsoStandard? == s)">@IsoStandards.Label(s)</option>
                }
            </select>
            <input class="inp" type="text" name="clause" value="@ViewBag.Clause" placeholder="Clause e.g. 9.2" style="max-width:140px;" />
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-magnifying-glass"></i> Filter</button>
        </form>

        <div class="card">
            <div class="card-body" style="padding:0;">
                @if (Model.Any())
                {
                    <table class="tbl">
                        <thead>
                            <tr><th>Reference</th><th>Title</th><th>Type</th><th>Standard</th><th>Clause</th><th>File</th><th>Captured</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model)
                            {
                                <tr>
                                    <td><span class="docnum">@e.Reference</span></td>
                                    <td><a asp-action="Details" asp-route-id="@e.Id">@e.Title</a></td>
                                    <td><span class="badge-ims @TypeClass(e.Type)">@e.Type</span></td>
                                    <td class="meta">@IsoStandards.Label(e.Standard)</td>
                                    <td class="meta">@(e.IsoClause ?? "—")</td>
                                    <td>
                                        @if (e.HasFile)
                                        {
                                            <a class="meta" asp-action="Download" asp-route-id="@e.Id"><i class="fas fa-download"></i> @(e.OriginalFileName ?? "file")</a>
                                        }
                                        else { <span class="meta">—</span> }
                                    </td>
                                    <td class="meta">@e.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="act-btns">
                                            <a class="act view" asp-action="Details" asp-route-id="@e.Id" title="Open"><i class="fas fa-eye"></i></a>
                                            @if (canManage)
                                            {
                                                <a class="act edit" asp-action="Edit" asp-route-id="@e.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-paperclip"></i>
                        <h3>No evidence captured yet</h3>
                        @if (canManage)
                        {
                            <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Capture the first evidence</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
