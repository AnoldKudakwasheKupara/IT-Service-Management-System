@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model IsoEvidence
@{
    ViewData["Title"] = "Capture Evidence";
}
<partial name="_ImsStyles" />

<div class="ims narrow">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-paperclip"></i> Capture Evidence</h1>
                        <p class="page-sub">Record a piece of objective evidence and attach its supporting file.</p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Create" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="hint" style="color:var(--danger)"></div>
                    <div class="form-grid">
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
                            <input class="inp" asp-for="Title" required placeholder="e.g. Fire drill attendance sheet — Q3 2026" />
                            <span asp-validation-for="Title" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-tag"></i> Type</label>
                            <select class="inp" asp-for="Type" asp-items="Html.GetEnumSelectList<EvidenceType>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
                            <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-list-ol"></i> ISO Clause</label>
                            <input class="inp" asp-for="IsoClause" placeholder="e.g. 9.2" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-link"></i> Linked Record Type</label>
                            <input class="inp" asp-for="LinkedEntityType" placeholder="e.g. Audit, Capa, Risk (optional)" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-hashtag"></i> Linked Record Id</label>
                            <input class="inp" type="number" asp-for="LinkedEntityId" placeholder="Optional" />
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-align-left"></i> Description</label>
                            <textarea class="inp" asp-for="Description" rows="3" placeholder="What this evidence demonstrates"></textarea>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-paperclip"></i> Attach File</label>
                            <input class="inp" type="file" name="file" />
                            <span class="hint">PDF, Office, text or image up to 25 MB.</span>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Save Evidence</button>
                        <a class="btn-ghost-ims" asp-action="Index">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
