@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model IsoEvidence
@{
    ViewData["Title"] = Model.Reference;
    var canManage = (bool)(ViewBag.CanManage ?? false);
    string TypeClass(EvidenceType t) => t switch
    {
        EvidenceType.Certificate => "badge-success",
        EvidenceType.Report or EvidenceType.Record => "badge-warning",
        EvidenceType.Photo or EvidenceType.Screenshot => "badge-primary",
        _ => "badge-gray"
    };
    string FileSizeLabel(long bytes)
    {
        if (bytes <= 0) return "—";
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes; int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a class="btn-back" asp-action="Index">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <span class="doc-number" style="font-size:1rem;font-weight:600;color:var(--primary);">@Model.Reference</span>
                        <span style="font-weight:700;color:var(--gray-800);">@Model.Title</span>
                    </h1>
                    <div class="page-subtitle">
                        <span class="status-badge @TypeClass(Model.Type)">@Model.Type</span>
                        <span class="meta-separator">·</span>
                        <span class="meta-text">@IsoStandards.Label(Model.Standard)@(string.IsNullOrWhiteSpace(Model.IsoClause) ? "" : $" · clause {Model.IsoClause}")</span>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (Model.HasFile)
                {
                    <a class="btn-create-ticket" asp-action="Download" asp-route-id="@Model.Id" style="background:var(--gray-100);color:var(--gray-700);">
                        <i class="fas fa-download"></i> Download File
                    </a>
                }
                @if (canManage)
                {
                    <a class="btn-create-ticket" asp-action="Edit" asp-route-id="@Model.Id" style="background:var(--gray-100);color:var(--gray-700);">
                        <i class="fas fa-pen"></i> Edit
                    </a>
                    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Delete this evidence record?');" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button class="btn-danger" type="submit">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-flash danger">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <!-- TWO COLUMN GRID -->
    <div class="two-col-grid">
        <!-- METADATA CARD -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-circle-info me-2" style="color: var(--primary);"></i>
                <span>Details</span>
            </div>
            <div class="card-body-custom">
                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Reference</div>
                        <div class="detail-value">@Model.Reference</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Type</div>
                        <div class="detail-value">
                            <span class="status-badge @TypeClass(Model.Type)">@Model.Type</span>
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">ISO Standard</div>
                        <div class="detail-value">@IsoStandards.Label(Model.Standard)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">ISO Clause</div>
                        <div class="detail-value">@(Model.IsoClause ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Linked Record</div>
                        <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.LinkedEntityType) ? "—" : $"{Model.LinkedEntityType} #{Model.LinkedEntityId}")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Uploaded By</div>
                        <div class="detail-value">@(Model.UploadedBy?.FullName ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Captured</div>
                        <div class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="description-section">
                        <div class="detail-label">Description</div>
                        <div class="description-text">@Model.Description</div>
                    </div>
                }
            </div>
        </div>

        <!-- FILE CARD -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-file me-2" style="color: var(--primary);"></i>
                <span>Attached File</span>
            </div>
            <div class="card-body-custom">
                @if (Model.HasFile)
                {
                    <div class="file-details">
                        <div class="file-icon">
                            <i class="fas @(Model.ContentType?.Contains("pdf") == true ? "fa-file-pdf" :
                                                                     Model.ContentType?.Contains("image") == true ? "fa-file-image" :
                                                                     Model.ContentType?.Contains("word") == true ? "fa-file-word" :
                                                                     Model.ContentType?.Contains("excel") == true ? "fa-file-excel" : "fa-file")"></i>
                        </div>
                        <div class="file-info">
                            <div class="file-name">@(Model.OriginalFileName ?? "—")</div>
                            <div class="file-meta">
                                <span>@(Model.ContentType ?? "—")</span>
                                <span class="file-meta-separator">·</span>
                                <span>@FileSizeLabel(Model.FileSize)</span>
                                <span class="file-meta-separator">·</span>
                                <span>@(Model.StorageProvider ?? "—")</span>
                            </div>
                        </div>
                    </div>
                    <div class="file-actions">
                        <a class="btn-download-file" asp-action="Download" asp-route-id="@Model.Id">
                            <i class="fas fa-download"></i> Download File
                        </a>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-file-circle-xmark" style="font-size:2rem;color:var(--gray-300);"></i>
                        <span>No file attached</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .doc-number {
        font-weight: 600;
        color: var(--primary);
        font-size: 1rem;
    }

    .page-subtitle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    .meta-separator {
        color: var(--gray-300);
    }

    .meta-text {
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-danger {
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        background: linear-gradient(100deg, #dc2626, var(--danger));
        color: white;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        font-family: inherit;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .btn-download-file {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-download-file:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

        .alert-flash.success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .alert-flash.danger {
            background: #fef2f2;
            border-color: #fecaca;
            color: #b91c1c;
        }

        .alert-flash i {
            font-size: 1.1rem;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    /* ===== DETAILS GRID ===== */
    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .detail-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-400);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .detail-value {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--gray-700);
    }

    .description-section {
        padding-top: 1rem;
        border-top: 1px solid var(--gray-200);
        margin-top: 1rem;
    }

    .description-text {
        font-size: 0.9rem;
        color: var(--gray-700);
        line-height: 1.6;
        margin-top: 0.3rem;
        white-space: pre-wrap;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-primary {
        background: #fceaeb;
        color: var(--info);
        border: 1px solid #f4ced0;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    /* ===== FILE DISPLAY ===== */
    .file-details {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: var(--gray-50);
        border-radius: 0.75rem;
        border: 1px solid var(--gray-200);
    }

    .file-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        border: 1px solid var(--gray-200);
        font-size: 1.5rem;
        color: var(--primary);
        flex-shrink: 0;
    }

    .file-info {
        flex: 1;
        min-width: 0;
    }

    .file-name {
        font-weight: 600;
        color: var(--gray-800);
        font-size: 0.95rem;
        word-break: break-all;
    }

    .file-meta {
        font-size: 0.8rem;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        gap: 0.25rem;
        flex-wrap: wrap;
        margin-top: 0.1rem;
    }

    .file-meta-separator {
        color: var(--gray-300);
    }

    .file-actions {
        margin-top: 1rem;
        display: flex;
        gap: 0.5rem;
    }

    /* ===== EMPTY STATE MINI ===== */
    .empty-state-mini {
        text-align: center;
        padding: 2rem;
        color: var(--gray-500);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .empty-state-mini span {
            font-size: 0.95rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .two-col-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }

    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }

        .btn-create-ticket,
        .btn-danger,
        .btn-download-file {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .file-details {
            flex-direction: column;
            text-align: center;
        }

        .file-meta {
            justify-content: center;
        }

        .file-actions {
            justify-content: center;
        }

        .page-subtitle {
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.1rem;
        }

        .doc-number {
            font-size: 0.85rem;
        }

        .btn-create-ticket,
        .btn-danger {
            width: 100%;
            justify-content: center;
        }

        .d-flex.gap-2 {
            width: 100%;
            flex-direction: column;
        }

        .detail-value {
            font-size: 0.8rem;
        }

        .description-text {
            font-size: 0.8rem;
        }

        .file-name {
            font-size: 0.85rem;
        }

        .file-meta {
            font-size: 0.7rem;
        }

        .status-badge {
            font-size: 0.65rem;
            padding: 0.15rem 0.5rem;
        }

        .meta-text {
            font-size: 0.75rem;
        }

        .file-icon {
            width: 44px;
            height: 44px;
            font-size: 1.2rem;
        }
    }
</style>
