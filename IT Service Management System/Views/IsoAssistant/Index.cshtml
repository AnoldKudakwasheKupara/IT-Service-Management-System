@model IT_Service_Management_System.ViewModels.Ims.IsoAssistantVm
@{
    ViewData["Title"] = "AI Compliance Assistant";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-robot me-2" style="color: var(--primary);"></i>
                    AI Compliance Assistant
                </h1>
                <p class="text-muted mt-2">
                    Ask about your ISO documents, CAPAs, risks, audits, training &amp; compliance — grounded in approved records
                </p>
            </div>
        </div>
    </div>

    <!-- SEARCH FORM -->
    <div class="data-card">
        <div class="card-body-custom">
            <form method="get" asp-action="Ask">
                <div class="search-form-row">
                    <input class="form-control search-input-large" name="q" value="@Model.Query" placeholder="e.g. When is the Password Policy due for review?" autofocus />
                    <button class="btn-create-ticket" type="submit">
                        <i class="fas fa-paper-plane"></i> Ask
                    </button>
                </div>
                <div class="suggestions-row">
                    @foreach (var s in Model.Suggestions)
                    {
                        <a class="suggestion-badge" asp-action="Ask" asp-route-q="@s">@s</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- ANSWER -->
    @if (!string.IsNullOrWhiteSpace(Model.Answer))
    {
        <div class="data-card">
            <div class="card-body-custom">
                <div class="answer-header">
                    <div class="answer-icon blue">
                        <i class="fas fa-robot"></i>
                    </div>
                    <div class="answer-content">
                        <p class="answer-text">@Model.Answer</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- RESULTS -->
    @if (Model.Results.Any())
    {
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-list me-2" style="color: var(--primary);"></i>
                <span>@Model.Results.Count result(s)</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @foreach (var r in Model.Results)
                {
                    <a href="@r.Url" class="result-item">
                        <div class="result-item-icon">
                            <i class="fas @r.Icon"></i>
                        </div>
                        <div class="result-item-content">
                            <div class="result-item-title">@r.Title</div>
                            <div class="result-item-subtitle">@r.Subtitle</div>
                        </div>
                        @if (!string.IsNullOrEmpty(r.Badge))
                        {
                            <span class="result-item-badge">@r.Badge</span>
                        }
                        <i class="fas fa-chevron-right result-item-arrow"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
        flex-shrink: 0;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    /* ===== SEARCH FORM ===== */
    .search-form-row {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .search-input-large {
        flex: 1;
        padding: 0.7rem 1rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.6rem;
        font-size: 0.95rem;
        font-weight: 400;
        font-family: inherit;
        background: white;
        transition: all 0.2s ease;
        color: var(--gray-800);
        min-height: 48px;
    }

        .search-input-large:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
        }

        .search-input-large::placeholder {
            color: var(--gray-400);
            font-size: 0.9rem;
        }

    .suggestions-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }

    .suggestion-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.8rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--gray-600);
        background: var(--gray-50);
        border: 1px solid var(--gray-200);
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
    }

        .suggestion-badge:hover {
            background: var(--primary-light);
            color: white;
            border-color: var(--primary);
            text-decoration: none;
            transform: translateY(-1px);
        }

    /* ===== ANSWER ===== */
    .answer-header {
        display: flex;
        gap: 0.85rem;
        align-items: flex-start;
    }

    .answer-icon {
        width: 42px;
        height: 42px;
        border-radius: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        flex-shrink: 0;
        font-size: 1.1rem;
    }

        .answer-icon.blue {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        }

    .answer-content {
        flex: 1;
    }

    .answer-text {
        margin: 0;
        color: var(--gray-800);
        font-size: 1.02rem;
        font-weight: 500;
        line-height: 1.6;
    }

    /* ===== RESULT ITEMS ===== */
    .result-item {
        display: flex;
        gap: 0.85rem;
        align-items: center;
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid var(--gray-100);
        text-decoration: none;
        color: inherit;
        transition: all 0.2s ease;
    }

        .result-item:last-child {
            border-bottom: none;
        }

        .result-item:hover {
            background-color: var(--gray-50);
            text-decoration: none;
        }

            .result-item:hover .result-item-arrow {
                transform: translateX(4px);
                color: var(--primary);
            }

            .result-item:hover .result-item-title {
                color: var(--primary);
            }

    .result-item-icon {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--gray-50);
        border-radius: 0.5rem;
        border: 1px solid var(--gray-200);
        color: var(--primary);
        font-size: 0.8rem;
        transition: all 0.2s ease;
    }

    .result-item:hover .result-item-icon {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }

    .result-item-content {
        flex: 1;
        min-width: 0;
    }

    .result-item-title {
        font-weight: 600;
        color: var(--gray-800);
        font-size: 0.9rem;
        transition: color 0.2s ease;
    }

    .result-item-subtitle {
        font-size: 0.78rem;
        color: var(--gray-500);
        margin-top: 0.05rem;
    }

    .result-item-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .result-item-badge.b-internal {
            background: #fceaeb;
            color: var(--info);
            border-color: #f4ced0;
        }

    .result-item-arrow {
        flex-shrink: 0;
        color: var(--gray-300);
        font-size: 0.75rem;
        transition: all 0.25s ease;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .search-form-row {
            flex-direction: column;
        }

            .search-form-row .btn-create-ticket {
                width: 100%;
                justify-content: center;
            }

        .search-input-large {
            font-size: 0.85rem;
            min-height: 42px;
        }

        .answer-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .answer-text {
            font-size: 0.95rem;
        }

        .result-item {
            padding: 0.7rem 1rem;
            flex-wrap: wrap;
        }

        .result-item-title {
            font-size: 0.85rem;
        }

        .result-item-subtitle {
            font-size: 0.7rem;
        }

        .result-item-badge {
            font-size: 0.55rem;
            padding: 0.1rem 0.4rem;
        }

        .result-item-arrow {
            display: none;
        }

        .suggestion-badge {
            font-size: 0.7rem;
            padding: 0.2rem 0.6rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .search-input-large {
            font-size: 0.8rem;
            padding: 0.5rem 0.75rem;
            min-height: 38px;
        }

        .answer-text {
            font-size: 0.85rem;
        }

        .result-item-title {
            font-size: 0.8rem;
        }

        .result-item-subtitle {
            font-size: 0.65rem;
        }

        .result-item-icon {
            width: 28px;
            height: 28px;
            font-size: 0.7rem;
        }

        .answer-icon {
            width: 36px;
            height: 36px;
            font-size: 0.9rem;
        }
    }
</style>
