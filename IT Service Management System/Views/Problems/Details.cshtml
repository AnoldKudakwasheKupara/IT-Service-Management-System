@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Itsm
@model IT_Service_Management_System.Models.Itsm.Problem

@{
    ViewData["Title"] = $"{Model.ProblemRef} - Axis IT Operations";
    var incidents = ViewBag.Incidents as List<Ticket> ?? new List<Ticket>();
    var changes = ViewBag.Changes as List<ChangeRequest> ?? new List<ChangeRequest>();
    var linkable = ViewBag.LinkableIncidents as IEnumerable<dynamic>;

    var prio = Model.Priority.ToString();
    var prioClass = prio switch
    {
        "Critical" => "badge-critical",
        "High" => "badge-warning",
        "Medium" => "badge-primary",
        _ => "badge-gray"
    };
    var stClass = Model.Status switch
    {
        ProblemStatus.New => "badge-primary",
        ProblemStatus.Investigating => "badge-warning",
        ProblemStatus.RootCauseIdentified => "badge-warning",
        ProblemStatus.KnownError => "badge-warning",
        ProblemStatus.Resolved => "badge-success",
        ProblemStatus.Closed => "badge-success",
        _ => "badge-gray"
    };
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-triangle-exclamation me-2" style="color: var(--primary);"></i>
                        <span class="doc-number" style="font-size:1rem;">@Model.ProblemRef</span>
                    </h1>
                    <p class="text-muted mt-1" style="font-size:0.95rem;">@Model.Title</p>
                    <div class="page-subtitle">
                        <span class="status-badge @prioClass">@prio</span>
                        <span class="status-badge @stClass">@Model.Status</span>
                    </div>
                </div>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-create-ticket" style="background:var(--gray-100);color:var(--gray-700);">
                <i class="fas fa-pencil-alt"></i> Edit
            </a>
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-flash danger">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <!-- TWO COLUMN GRID -->
    <div class="two-col-grid">
        <!-- LEFT COLUMN -->
        <div class="left-column">
            <!-- OVERVIEW CARD -->
            <div class="data-card">
                <div class="card-header-custom">
                    <i class="fas fa-circle-info me-2" style="color:var(--primary);"></i>
                    <span>Overview</span>
                </div>
                <div class="card-body-custom">
                    <div class="detail-block">
                        <div class="detail-label"><i class="fas fa-align-left" style="color:var(--primary);"></i> Description</div>
                        <div class="detail-content">@Model.Description</div>
                    </div>

                    <div class="detail-block">
                        <div class="detail-label"><i class="fas fa-magnifying-glass" style="color:var(--primary);"></i> Root Cause</div>
                        <div class="detail-content @(string.IsNullOrWhiteSpace(Model.RootCause) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.RootCause) ? "Not yet identified." : Model.RootCause)
                        </div>
                    </div>

                    <div class="detail-block">
                        <div class="detail-label"><i class="fas fa-life-ring" style="color:var(--primary);"></i> Workaround</div>
                        <div class="detail-content @(string.IsNullOrWhiteSpace(Model.Workaround) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.Workaround) ? "No workaround recorded." : Model.Workaround)
                        </div>
                    </div>

                    <div class="details-grid">
                        <div class="detail-item">
                            <div class="detail-label">Configuration Item</div>
                            <div class="detail-value">@(Model.ConfigurationItem?.Name ?? "—")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Assignee</div>
                            <div class="detail-value">@(Model.AssignedTo != null ? $"{Model.AssignedTo.FirstName} {Model.AssignedTo.LastName}" : "Unassigned")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Created by</div>
                            <div class="detail-value">@(Model.CreatedBy != null ? $"{Model.CreatedBy.FirstName} {Model.CreatedBy.LastName}" : "—")</div>
                        </div>
                        <div class="detail-item">
                            <div class="detail-label">Created</div>
                            <div class="detail-value">@Model.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")</div>
                        </div>
                        @if (Model.UpdatedAt != null)
                        {
                            <div class="detail-item">
                                <div class="detail-label">Last updated</div>
                                <div class="detail-value">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy 'at' HH:mm")</div>
                            </div>
                        }
                        @if (Model.ResolvedAt != null)
                        {
                            <div class="detail-item">
                                <div class="detail-label">Resolved</div>
                                <div class="detail-value">@Model.ResolvedAt.Value.ToString("MMM dd, yyyy 'at' HH:mm")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- LINKED INCIDENTS -->
            <div class="data-card">
                <div class="card-header-custom">
                    <div>
                        <i class="fas fa-link me-2" style="color:var(--primary);"></i>
                        <span>Linked Incidents</span>
                    </div>
                    <div class="ticket-count">
                        <i class="fas fa-ticket-alt"></i>
                        <span>@incidents.Count</span> linked
                    </div>
                </div>
                <div class="card-body-custom" style="padding:0;">
                    @if (incidents.Any())
                    {
                        <div class="table-responsive">
                            <table class="tickets-table">
                                <thead>
                                    <tr>
                                        <th><i class="fas fa-hashtag me-1"></i> Ref</th>
                                        <th><i class="fas fa-heading me-1"></i> Title</th>
                                        <th><i class="fas fa-tag me-1"></i> Status</th>
                                        <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in incidents)
                                    {
                                        <tr>
                                            <td>
                                                <a href="/Tickets/Details/@t.Id" class="doc-link">
                                                    <span class="doc-number">TKT-@t.Id.ToString("D5")</span>
                                                </a>
                                            </td>
                                            <td>@t.Title</td>
                                            <td><span class="status-badge badge-gray">@t.Status</span></td>
                                            <td style="text-align:right;">
                                                <form asp-action="UnlinkIncident" method="post" class="inline-form"
                                                      onsubmit="return confirm('Unlink TKT-@t.Id.ToString("D5") from this problem?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@Model.Id" />
                                                    <input type="hidden" name="ticketId" value="@t.Id" />
                                                    <button type="submit" class="action-btn btn-unlink" title="Unlink incident">
                                                        <i class="fas fa-link-slash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state-mini">
                            <i class="fas fa-link-slash"></i>
                            <span>No incidents linked to this problem yet.</span>
                        </div>
                    }
                </div>
                <div class="card-footer-custom">
                    <form asp-action="LinkIncident" method="post" class="link-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="ticketId" class="form-control link-select" required>
                            <option value="">Select an incident to link…</option>
                            @if (linkable != null)
                            {
                                foreach (var t in linkable)
                                {
                                    <option value="@t.Id">@t.Label</option>
                                }
                            }
                        </select>
                        <button type="submit" class="btn-link-incident">
                            <i class="fas fa-link"></i> Link Incident
                        </button>
                    </form>
                </div>
            </div>

            <!-- RELATED CHANGES -->
            <div class="data-card">
                <div class="card-header-custom">
                    <div>
                        <i class="fas fa-code-branch me-2" style="color:var(--primary);"></i>
                        <span>Related Changes</span>
                    </div>
                    <div class="ticket-count">
                        <i class="fas fa-code-branch"></i>
                        <span>@changes.Count</span> changes
                    </div>
                </div>
                <div class="card-body-custom" style="padding:0;">
                    @if (changes.Any())
                    {
                        <div class="table-responsive">
                            <table class="tickets-table">
                                <thead>
                                    <tr>
                                        <th><i class="fas fa-hashtag me-1"></i> Ref</th>
                                        <th><i class="fas fa-heading me-1"></i> Title</th>
                                        <th><i class="fas fa-tag me-1"></i> Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in changes)
                                    {
                                        <tr>
                                            <td>
                                                <a href="/Changes/Details/@c.Id" class="doc-link">
                                                    <span class="doc-number">CHG-@c.Id.ToString("D5")</span>
                                                </a>
                                            </td>
                                            <td>@c.Title</td>
                                            <td><span class="status-badge badge-gray">@c.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state-mini">
                            <i class="fas fa-code-branch"></i>
                            <span>No changes raised for this problem yet.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="right-column">
            <div class="data-card">
                <div class="card-header-custom" style="border-left:4px solid var(--primary);">
                    <i class="fas fa-bolt me-2" style="color:var(--primary);"></i>
                    <span>Update Status</span>
                </div>
                <div class="card-body-custom">
                    <form asp-action="ChangeStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="form-group">
                            <label class="form-label-sm"><i class="fas fa-chart-simple"></i> Status</label>
                            <select name="status" class="form-control">
                                @foreach (var s in Enum.GetValues<ProblemStatus>())
                                {
                                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn-update-status">
                            <i class="fas fa-arrows-rotate"></i> Update
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .doc-number {
        font-weight: 600;
        color: var(--primary);
        font-size: 1rem;
    }

    .page-subtitle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-link-incident {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 1.2rem;
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        border: none;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        font-family: inherit;
        white-space: nowrap;
    }

        .btn-link-incident:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
        }

    .btn-update-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        border: none;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        font-family: inherit;
        width: 100%;
        justify-content: center;
    }

        .btn-update-status:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        background: transparent;
    }

    .btn-unlink {
        background: var(--gray-100);
        color: var(--danger);
    }

        .btn-unlink:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
        }

    .inline-form {
        display: inline;
        margin: 0;
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }

    .left-column {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .right-column {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .card-footer-custom {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--gray-200);
        background: var(--gray-50);
    }

    .ticket-count {
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    /* ===== DETAIL BLOCKS ===== */
    .detail-block {
        margin-bottom: 1.25rem;
    }

        .detail-block:last-of-type {
            margin-bottom: 0;
        }

    .detail-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-400);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 0.3rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .detail-content {
        background: var(--gray-50);
        padding: 0.75rem 1rem;
        border-radius: 0.5rem;
        line-height: 1.6;
        color: var(--gray-700);
        white-space: pre-wrap;
        font-size: 0.9rem;
    }

        .detail-content.muted {
            color: var(--gray-400);
            font-style: italic;
        }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem 1.5rem;
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--gray-200);
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

        .detail-item .detail-label {
            font-size: 0.6rem;
            color: var(--gray-400);
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .detail-item .detail-value {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--gray-700);
        }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-critical {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    .badge-primary {
        background: #fceaeb;
        color: var(--info);
        border: 1px solid #f4ced0;
    }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

        .alert-flash.success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .alert-flash.danger {
            background: #fef2f2;
            border-color: #fecaca;
            color: #b91c1c;
        }

        .alert-flash i {
            font-size: 1.1rem;
        }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 0.75rem 1.2rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.65rem 1.2rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== LINK FORM ===== */
    .link-form {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .link-select {
        flex: 1;
        min-width: 220px;
        padding: 0.5rem 0.75rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.85rem;
        font-family: inherit;
        background: white;
        transition: all 0.2s;
    }

        .link-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
        }

    /* ===== FORM GROUP ===== */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        margin-bottom: 1rem;
    }

        .form-group:last-of-type {
            margin-bottom: 0;
        }

    .form-label-sm {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .form-label-sm i {
            color: var(--gray-400);
            font-size: 0.65rem;
        }

    .form-control {
        padding: 0.5rem 0.75rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.85rem;
        font-family: inherit;
        background: white;
        transition: all 0.2s;
        width: 100%;
