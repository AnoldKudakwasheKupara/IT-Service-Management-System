@using IT_Service_Management_System.Models.Itsm
@model List<IT_Service_Management_System.Models.Itsm.Problem>

@{
    ViewData["Title"] = "Problem Management - Axis IT Operations";
    var incidentCounts = ViewBag.IncidentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var curStatus = ViewBag.Status as ProblemStatus?;
    var curQ = ViewBag.Q as string;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-triangle-exclamation me-2" style="color: var(--primary);"></i>
                    Problem Management
                </h1>
                <p class="text-muted mt-2">Track root causes behind recurring incidents, record known errors, and drive permanent fixes</p>
            </div>
            <a asp-action="Create" class="btn-create">
                <i class="fas fa-plus-circle me-2"></i>
                New Problem
            </a>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--primary-light), var(--primary));">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="stat-info">
                <h3>@(ViewBag.Total ?? 0)</h3>
                <p>Total Problems</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f5b042, #e6a017);">
                <i class="fas fa-magnifying-glass"></i>
            </div>
            <div class="stat-info">
                <h3>@(ViewBag.Open ?? 0)</h3>
                <p>Open</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                <i class="fas fa-bug"></i>
            </div>
            <div class="stat-info">
                <h3>@(ViewBag.KnownErrors ?? 0)</h3>
                <p>Known Errors</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #2c9e6e, #227a55);">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@(ViewBag.Resolved ?? 0)</h3>
                <p>Resolved / Closed</p>
            </div>
        </div>
    </div>

    <!-- FILTERS CARD -->
    <div class="filters-card mb-4">
        <div class="filters-header">
            <i class="fas fa-filter"></i>
            <span>Filter Problems</span>
        </div>
        <form method="get" asp-action="Index" class="filters-body">
            <div class="filter-group">
                <label>Status</label>
                <select name="status" class="filter-select">
                    <option value="">All Status</option>
                    @foreach (var s in Enum.GetValues<ProblemStatus>())
                    {
                        <option value="@s" selected="@(curStatus == s)">@s</option>
                    }
                </select>
            </div>
            <div class="filter-group" style="flex: 2;">
                <label>Search</label>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="@curQ" placeholder="Search by title or description..." class="search-input">
                </div>
            </div>
            <button type="submit" class="btn-clear-filters" style="background:var(--primary,#3b82f6);color:#fff;border:none;">
                <i class="fas fa-search"></i>
                Search
            </button>
            <a asp-action="Index" class="btn-clear-filters" style="text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                <i class="fas fa-undo-alt"></i>
                Clear
            </a>
        </form>
    </div>

    <!-- MAIN DATA CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-list me-2"></i>
                <span>Problem List</span>
            </div>
            <div class="record-count">
                <i class="fas fa-chart-simple me-1"></i>
                @Model.Count problems
            </div>
        </div>

        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag me-1"></i> Ref / Title</th>
                            <th><i class="fas fa-flag me-1"></i> Priority</th>
                            <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                            <th><i class="fas fa-server me-1"></i> CI</th>
                            <th style="text-align:center;"><i class="fas fa-link me-1"></i> Incidents</th>
                            <th><i class="fas fa-user-gear me-1"></i> Assignee</th>
                            <th><i class="fas fa-calendar me-1"></i> Created</th>
                            <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            var linkedCount = incidentCounts.TryGetValue(p.Id, out var lc) ? lc : 0;

                            var prio = p.Priority.ToString();
                            var prioClass = prio switch
                            {
                                "Critical" => "badge-red",
                                "High" => "badge-amber",
                                "Medium" => "badge-blue",
                                _ => "badge-gray"
                            };

                            var st = p.Status;
                            var stClass = st switch
                            {
                                ProblemStatus.New => "badge-blue",
                                ProblemStatus.Investigating => "badge-amber",
                                ProblemStatus.RootCauseIdentified => "badge-amber",
                                ProblemStatus.KnownError => "badge-amber",
                                ProblemStatus.Resolved => "badge-green",
                                ProblemStatus.Closed => "badge-green",
                                _ => "badge-gray"
                            };

                            <tr>
                                <td>
                                    <div class="list-avatar-cell">
                                        <div class="list-avatar" style="background: linear-gradient(135deg, var(--primary), var(--primary-light));">
                                            <i class="fas fa-triangle-exclamation"></i>
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@p.Id" class="prb-ref">@p.ProblemRef</a>
                                            <span class="prb-title">@p.Title</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="status-badge @prioClass">@prio</span></td>
                                <td><span class="status-badge @stClass">@st</span></td>
                                <td>
                                    @if (p.ConfigurationItem != null)
                                    {
                                        <span class="chip">@p.ConfigurationItem.Name</span>
                                    }
                                    else
                                    {
                                        <span class="chip-muted">—</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <span class="status-badge @(linkedCount > 0 ? "badge-blue" : "badge-gray")">
                                        <i class="fas fa-link"></i> @linkedCount
                                    </span>
                                </td>
                                <td>
                                    @if (p.AssignedTo != null)
                                    {
                                        <span class="chip"><i class="fas fa-user-gear"></i> @p.AssignedTo.FirstName @p.AssignedTo.LastName</span>
                                    }
                                    else
                                    {
                                        <span class="chip-muted">Unassigned</span>
                                    }
                                </td>
                                <td class="date-cell">
                                    <i class="far fa-calendar-alt"></i>
                                    @p.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td style="text-align:right;">
                                    <div class="action-buttons" style="justify-content:flex-end;">
                                        <a asp-action="Details" asp-route-id="@p.Id" class="action-btn btn-view" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@p.Id" class="action-btn btn-edit" title="Edit Problem">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete problem @p.ProblemRef? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn btn-delete" title="Delete Problem">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-triangle-exclamation"></i>
                    <h3>No problems found</h3>
                    <p>@(string.IsNullOrWhiteSpace(curQ) && curStatus == null ? "Get started by logging your first problem record." : "No problems match your current filters.")</p>
                    <a asp-action="Create" class="btn-create btn-create-sm">
                        <i class="fas fa-plus-circle"></i> New Problem
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
    }

    .page-container { max-width: 1400px; margin: 0 auto; }
    .table-responsive { overflow-x: auto; }

    .prb-ref {
        display: block;
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--primary);
        letter-spacing: 0.5px;
        text-decoration: none;
    }
        .prb-ref:hover { text-decoration: underline; }

    .prb-title { color: var(--gray-800); font-weight: 500; }

    @@media (max-width: 768px) {
        .stats-cards { grid-template-columns: 1fr 1fr; }
        .filters-body { flex-direction: column; align-items: stretch; }
        .filter-group { min-width: 100%; }
    }

    @@media (max-width: 576px) {
        .stats-cards { grid-template-columns: 1fr; }
        .page-title { font-size: 1.5rem; }
    }
</style>
