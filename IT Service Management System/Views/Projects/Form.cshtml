@using IT_Service_Management_System.Models.Pm
@model Project
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New Project" : $"Edit {Model.Reference}";
    var users = ViewBag.Users as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var templates = ViewBag.Templates as List<ProjectTemplate> ?? new List<ProjectTemplate>();
}

<partial name="_PmStyles" />

<div class="pm narrow">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div style="display:flex; gap:.9rem; align-items:flex-start;">
                    <a href="@(isNew ? Url.Action("Portfolio") : Url.Action("Details", new { id = Model.Id }))" class="btn-back">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-diagram-project"></i> @(isNew ? "New project" : "Edit project")</h1>
                        <p class="page-sub">
                            @(isNew
                                ? "Set up the business case. You can start from a template to pre-populate the plan."
                                : $"{Model.Reference} — {Model.Name}")
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <partial name="_PmAlerts" />

        <form asp-action="@(isNew ? "Create" : "Edit")" method="post">
            @Html.AntiForgeryToken()
            @if (!isNew)
            {
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Code" />
                <input type="hidden" asp-for="Status" />
                <input type="hidden" asp-for="ApprovedChangeValue" />
            }

            <div asp-validation-summary="ModelOnly" class="field-error" style="margin-bottom:1rem;"></div>

            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-circle-info"></i> Basics</span></div>
                <div class="card-body">
                    <div class="form-grid">
                        <div class="fg full">
                            <label class="lbl" asp-for="Name"><i class="fas fa-heading"></i> Project name <span class="req">*</span></label>
                            <input asp-for="Name" class="inp" placeholder="e.g. Core network refresh" />
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>
                        <div class="fg full">
                            <label class="lbl" asp-for="Description"><i class="fas fa-align-left"></i> Description</label>
                            <textarea asp-for="Description" class="inp" rows="4"
                                      placeholder="What the project will deliver, and why it matters."></textarea>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Client"><i class="fas fa-handshake"></i> Client</label>
                            <input asp-for="Client" class="inp" placeholder="Internal, or the client organisation" />
                            <span class="hint">Client-portal users see projects matched to their organisation name.</span>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Location"><i class="fas fa-location-dot"></i> Location</label>
                            <input asp-for="Location" class="inp" />
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="DepartmentId"><i class="fas fa-building"></i> Department</label>
                            <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="inp">
                                <option value="">— Select —</option>
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Tags"><i class="fas fa-tags"></i> Tags</label>
                            <input asp-for="Tags" class="inp" placeholder="comma, separated, tags" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-users"></i> Ownership &amp; classification</span></div>
                <div class="card-body">
                    <div class="form-grid three">
                        <div class="fg">
                            <label class="lbl" asp-for="SponsorId"><i class="fas fa-user-shield"></i> Sponsor</label>
                            <select asp-for="SponsorId" class="inp">
                                <option value="">— Select —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" selected="@(Model.SponsorId == (int)u.Id)">@u.Name</option>
                                }
                            </select>
                            <span class="hint">Accountable for the business case; approves high-value spend.</span>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="ProjectManagerId"><i class="fas fa-user-tie"></i> Project manager</label>
                            <select asp-for="ProjectManagerId" class="inp">
                                <option value="">— Select —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" selected="@(Model.ProjectManagerId == (int)u.Id)">@u.Name</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Priority"><i class="fas fa-flag"></i> Priority</label>
                            <select asp-for="Priority" class="inp">
                                @foreach (var v in Enum.GetValues<ProjectPriority>())
                                {
                                    <option value="@v" selected="@(Model.Priority == v)">@v</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Category"><i class="fas fa-shapes"></i> Category</label>
                            <select asp-for="Category" class="inp">
                                @foreach (var v in Enum.GetValues<ProjectCategory>())
                                {
                                    <option value="@v" selected="@(Model.Category == v)">@v</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Type"><i class="fas fa-diagram-next"></i> Type</label>
                            <select asp-for="Type" class="inp">
                                @foreach (var v in Enum.GetValues<ProjectType>())
                                {
                                    <option value="@v" selected="@(Model.Type == v)">@v</option>
                                }
                            </select>
                        </div>
                        @if (!isNew)
                        {
                            <div class="fg">
                                <label class="lbl" asp-for="ProgressPercent"><i class="fas fa-percent"></i> Progress</label>
                                <input asp-for="ProgressPercent" type="number" min="0" max="100" class="inp" />
                                <label class="check" style="margin-top:.4rem;">
                                    <input asp-for="AutoCalculateProgress" type="checkbox" />
                                    Roll up automatically from tasks
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-calendar-days"></i> Schedule &amp; budget</span></div>
                <div class="card-body">
                    <div class="form-grid three">
                        <div class="fg">
                            <label class="lbl" asp-for="StartDate"><i class="far fa-calendar-plus"></i> Start date</label>
                            <input asp-for="StartDate" type="date" class="inp" />
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="EndDate"><i class="far fa-calendar-check"></i> End date</label>
                            <input asp-for="EndDate" type="date" class="inp" />
                            <span asp-validation-for="EndDate" class="field-error"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="EstimatedDurationDays"><i class="fas fa-stopwatch"></i> Duration (days)</label>
                            <input asp-for="EstimatedDurationDays" type="number" min="0" class="inp" />
                            <span class="hint">Left blank, this is derived from the dates.</span>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Budget"><i class="fas fa-sack-dollar"></i> Budget</label>
                            <input asp-for="Budget" type="number" step="0.01" min="0" class="inp" />
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Currency"><i class="fas fa-coins"></i> Currency</label>
                            <input asp-for="Currency" class="inp" maxlength="10" />
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="HealthNote"><i class="fas fa-note-sticky"></i> Health note</label>
                            <input asp-for="HealthNote" class="inp" placeholder="Shown on the executive dashboard" />
                        </div>
                    </div>
                </div>
            </div>

            @if (isNew && templates.Count > 0)
            {
                <div class="card">
                    <div class="card-head"><span class="t"><i class="fas fa-clone"></i> Start from a template</span></div>
                    <div class="card-body">
                        <div class="fg">
                            <label class="lbl">Template</label>
                            <select name="templateId" class="inp">
                                <option value="">Start from an empty plan</option>
                                @foreach (var t in templates)
                                {
                                    <option value="@t.Id">@t.Name — @t.Category (@t.DefaultDurationDays days)</option>
                                }
                            </select>
                            <span class="hint">
                                Phases, tasks and milestones are created immediately, with dates offset from the start date.
                            </span>
                        </div>
                    </div>
                </div>
            }

            <div class="form-actions">
                <button type="submit" class="btn-pm">
                    <i class="fas fa-floppy-disk"></i> @(isNew ? "Create project" : "Save changes")
                </button>
                <a href="@(isNew ? Url.Action("Portfolio") : Url.Action("Details", new { id = Model.Id }))" class="btn-ghost-pm">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
