@model IT_Service_Management_System.Models.Pm.Project
@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Pm

@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = (isNew ? "New project" : $"Edit {Model.Name}") + " - Axis IT Helpdesk";

    var departments = ViewBag.Departments as List<Department> ?? new List<Department>();
    var users = ViewBag.Users as List<User> ?? new List<User>();
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="btn-back" asp-action="@(isNew ? "Index" : "Details")" asp-route-id="@(isNew ? null : (int?)Model.Id)">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-diagram-project me-2" style="color: var(--primary);"></i>
                    @(isNew ? "New project" : "Edit project")
                </h1>
                <p class="text-muted mt-2">
                    @(isNew
                        ? "Register the project, its owner and the window it runs in"
                        : Model.Reference)
                </p>
            </div>
        </div>
    </div>

    <form method="post" asp-action="@(isNew ? "Create" : "Edit")">
        @Html.AntiForgeryToken()
        @if (!isNew)
        {
            <input type="hidden" asp-for="Id" />
        }

        @* "All", not "ModelOnly": most fields here have no inline message of their own, so a
           property-level error would otherwise reject the form with nothing on screen to explain
           it. Better a summary that repeats Name than a form that silently refuses to save. *@
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="data-card mb-4">
            <div class="card-header-custom">
                <div><i class="fas fa-circle-info me-2"></i><span>What it is</span></div>
            </div>
            <div class="field-grid">
                <div class="field-item" style="grid-column: 1 / -1;">
                    <label asp-for="Name">Project name</label>
                    <input asp-for="Name" class="filter-select" placeholder="e.g. Fiscal cloud rollout" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:0.75rem;"></span>
                </div>

                <div class="field-item">
                    <label asp-for="Code">Project code</label>
                    <input asp-for="Code" class="filter-select" placeholder="Leave blank to generate" />
                    <span style="font-size:0.7rem;color:var(--gray-400);">
                        Blank generates PRJ-@DateTime.Today.Year-nnn
                    </span>
                </div>

                <div class="field-item">
                    <label asp-for="Client">Client</label>
                    <input asp-for="Client" class="filter-select" placeholder="Internal, or the client's name" />
                </div>

                <div class="field-item">
                    <label asp-for="Type">Type</label>
                    <select asp-for="Type" class="filter-select" asp-items="Html.GetEnumSelectList<ProjectType>()"></select>
                </div>

                <div class="field-item">
                    <label asp-for="Category">Category</label>
                    <select asp-for="Category" class="filter-select" asp-items="Html.GetEnumSelectList<ProjectCategory>()"></select>
                </div>

                <div class="field-item">
                    <label asp-for="Priority">Priority</label>
                    <select asp-for="Priority" class="filter-select" asp-items="Html.GetEnumSelectList<ProjectPriority>()"></select>
                </div>

                <div class="field-item">
                    <label asp-for="DepartmentId">Department</label>
                    <select asp-for="DepartmentId" class="filter-select">
                        <option value="">Not assigned</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                </div>

                <div class="field-item" style="grid-column: 1 / -1;">
                    <label asp-for="Description">Description</label>
                    <textarea asp-for="Description" class="filter-select" rows="4"
                              placeholder="Scope, objective, and anything a reader needs to judge the rest"></textarea>
                </div>
            </div>
        </div>

        <div class="data-card mb-4">
            <div class="card-header-custom">
                <div><i class="fas fa-user-tie me-2"></i><span>Who owns it</span></div>
            </div>
            <div class="field-grid">
                <div class="field-item">
                    <label asp-for="ProjectManagerId">Project manager</label>
                    <select asp-for="ProjectManagerId" class="filter-select">
                        <option value="">@(isNew ? "Me, unless changed" : "Unassigned")</option>
                        @foreach (var u in users)
                        {
                            <option value="@u.Id">@u.FullName</option>
                        }
                    </select>
                    <span style="font-size:0.7rem;color:var(--gray-400);">
                        Day-to-day owner. Gets edit rights whatever their role.
                    </span>
                </div>

                <div class="field-item">
                    <label asp-for="SponsorId">Sponsor</label>
                    <select asp-for="SponsorId" class="filter-select">
                        <option value="">Unassigned</option>
                        @foreach (var u in users)
                        {
                            <option value="@u.Id">@u.FullName</option>
                        }
                    </select>
                    <span style="font-size:0.7rem;color:var(--gray-400);">
                        Executive accountable for the business case.
                    </span>
                </div>
            </div>
        </div>

        <div class="data-card mb-4">
            <div class="card-header-custom">
                <div><i class="fas fa-calendar me-2"></i><span>Schedule and budget</span></div>
            </div>
            <div class="field-grid">
                <div class="field-item">
                    <label asp-for="StartDate">Scheduled start</label>
                    <input asp-for="StartDate" type="date" class="filter-select" />
                </div>
                <div class="field-item">
                    <label asp-for="EndDate">Scheduled end</label>
                    <input asp-for="EndDate" type="date" class="filter-select" />
                    <span style="font-size:0.7rem;color:var(--gray-400);">
                        Every variance figure is measured against this.
                    </span>
                </div>
                <div class="field-item">
                    <label asp-for="Budget">Budget</label>
                    <input asp-for="Budget" type="number" step="0.01" min="0" class="filter-select" />
                </div>
                <div class="field-item">
                    <label asp-for="Currency">Currency</label>
                    <input asp-for="Currency" class="filter-select" maxlength="10" />
                </div>
                <div class="field-item">
                    <label asp-for="Location">Location</label>
                    <input asp-for="Location" class="filter-select" />
                </div>
                <div class="field-item">
                    <label asp-for="Tags">Tags</label>
                    <input asp-for="Tags" class="filter-select" placeholder="Comma separated" />
                </div>
            </div>
        </div>

        <div class="data-card mb-4">
            <div class="card-header-custom">
                <div><i class="fas fa-heart-pulse me-2"></i><span>Health and progress</span></div>
            </div>
            <div class="field-grid">
                <div class="field-item">
                    <label asp-for="Health">Health</label>
                    <select asp-for="Health" class="filter-select" asp-items="Html.GetEnumSelectList<ProjectHealth>()"></select>
                </div>
                <div class="field-item" style="grid-column: span 2;">
                    <label asp-for="HealthNote">Health note</label>
                    <input asp-for="HealthNote" class="filter-select"
                           placeholder="Why it is amber or red — the sentence a sponsor reads first" />
                </div>

                <div class="field-item" style="grid-column: 1 / -1;">
                    <label class="d-flex align-items-center gap-2" style="text-transform:none;font-size:0.85rem;color:var(--gray-700);">
                        <input asp-for="AutoCalculateProgress" type="checkbox" class="form-check-input m-0" />
                        Roll progress up from tasks
                    </label>
                    <span style="font-size:0.7rem;color:var(--gray-400);">
                        Leave on and the tasks decide the percentage. Switch off to enter it by hand —
                        otherwise a typed figure is overwritten at the next refresh.
                    </span>
                </div>

                <div class="field-item">
                    <label asp-for="ProgressPercent">Progress %</label>
                    <input asp-for="ProgressPercent" type="number" min="0" max="100" class="filter-select" />
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mb-5">
            <button type="submit" class="btn-create">
                <i class="fas fa-save"></i> @(isNew ? "Create project" : "Save changes")
            </button>
            <a class="btn-clear-filters" asp-action="@(isNew ? "Index" : "Details")" asp-route-id="@(isNew ? null : (int?)Model.Id)">
                Cancel
            </a>
        </div>
    </form>
</div>

@await Html.PartialAsync("_ProjectStyles")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
