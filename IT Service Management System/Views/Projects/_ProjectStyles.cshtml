@*
    Styles shared by every project page. Structure (page-container, data-card, filters-card,
    stats-cards, data-table, badges, action buttons) all comes from site.css so these pages read
    like Tickets and Audit Logs; only the things unique to project delivery live here — health
    lamps, progress bars, variance chips and the milestone timeline.
*@
<style>
    /* ── Health: the RAG lamp that drives portfolio triage ───────────────── */
    .health-lamp {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.74rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .health-lamp::before {
        content: "";
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        flex-shrink: 0;
    }
    .health-Green        { color: var(--success); }
    .health-Green::before { background: var(--success); }
    .health-Amber        { color: #b45309; }
    .health-Amber::before { background: var(--warning); }
    .health-Red          { color: var(--danger); }
    .health-Red::before   { background: var(--danger); }

    /* ── Status chips. Enum names are CamelCase, so the class is too. ────── */
    .pstatus {
        display: inline-block;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        font-size: 0.71rem;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid transparent;
    }
    .pstatus-Draft      { background: var(--gray-100); color: var(--gray-600); border-color: var(--gray-300); }
    .pstatus-Planning   { background: #eef2ff; color: #4338ca; border-color: #c7d2fe; }
    .pstatus-Approved   { background: #ecfeff; color: #0e7490; border-color: #a5f3fc; }
    .pstatus-Active     { background: var(--success-light); color: var(--success); border-color: #c6e0c9; }
    .pstatus-OnHold     { background: var(--warning-light); color: #b45309; border-color: #ffe0b3; }
    .pstatus-Delayed    { background: var(--danger-light); color: var(--danger); border-color: #fed7d7; }
    .pstatus-Completed  { background: #ecfdf5; color: #047857; border-color: #a7f3d0; }
    .pstatus-Cancelled  { background: var(--gray-100); color: var(--gray-500); border-color: var(--gray-300); }
    .pstatus-Archived   { background: var(--gray-100); color: var(--gray-400); border-color: var(--gray-200); }

    /* ── Progress bar. Doubles as a schedule comparison: the thin marker is
         how much of the plan has elapsed, so a bar behind its marker is late. ── */
    .progress-cell { min-width: 150px; }
    .progress-track {
        position: relative;
        height: 0.5rem;
        background: var(--gray-200);
        border-radius: 999px;
        overflow: visible;
    }
    .progress-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--success);
        transition: width 0.3s;
    }
    .progress-fill.is-behind { background: var(--warning); }
    .progress-fill.is-late   { background: var(--danger); }
    .progress-marker {
        position: absolute;
        top: -0.2rem;
        width: 2px;
        height: 0.9rem;
        background: var(--gray-500);
        border-radius: 1px;
    }
    .progress-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.68rem;
        color: var(--gray-500);
        margin-top: 0.25rem;
    }

    /* ── Variance chips ─────────────────────────────────────────────────── */
    .variance {
        display: inline-block;
        padding: 0.15rem 0.45rem;
        border-radius: 0.35rem;
        font-size: 0.7rem;
        font-weight: 600;
        white-space: nowrap;
    }
    .variance-ahead    { background: var(--success-light); color: var(--success); }
    .variance-ontrack  { background: var(--gray-100); color: var(--gray-600); }
    .variance-slipping { background: var(--warning-light); color: #b45309; }
    .variance-late     { background: var(--danger-light); color: var(--danger); }

    .project-name { font-weight: 600; color: var(--gray-800); text-decoration: none; }
    .project-name:hover { color: var(--primary); }
    .project-code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        color: var(--gray-400);
        display: block;
    }
    .client-chip { font-size: 0.72rem; color: var(--gray-500); }

    /* ── Tab bar on the project record ──────────────────────────────────── */
    .project-tabs {
        display: flex;
        gap: 0.25rem;
        border-bottom: 1px solid var(--gray-200);
        overflow-x: auto;
        margin-bottom: 1.5rem;
    }
    .project-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.7rem 1.1rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--gray-500);
        text-decoration: none;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
        transition: var(--transition-smooth);
    }
    .project-tab:hover { color: var(--primary); background: var(--gray-50); }
    .project-tab.active { color: var(--primary); border-bottom-color: var(--primary); }

    /* ── Overview layout: the record beside its summary rail ─────────────── */
    .project-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr);
        gap: 1.5rem;
        align-items: start;
    }
    @@media (max-width: 991px) {
        .project-grid { grid-template-columns: 1fr; }
    }

    .field-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 1rem 1.5rem;
        padding: 1.25rem 1.5rem;
    }
    .field-item label {
        display: block;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--gray-400);
        margin-bottom: 0.2rem;
    }
    .field-item .value { font-size: 0.85rem; color: var(--gray-700); font-weight: 500; word-break: break-word; }

    /* ── Summary rail ───────────────────────────────────────────────────── */
    .rail-stat {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--gray-100);
        font-size: 0.82rem;
    }
    .rail-stat:last-child { border-bottom: none; }
    .rail-stat .label { color: var(--gray-500); }
    .rail-stat .figure { font-weight: 700; color: var(--gray-800); }

    .rollup { padding: 1rem 1.25rem; border-bottom: 1px solid var(--gray-100); }
    .rollup-head {
        display: flex;
        justify-content: space-between;
        font-size: 0.78rem;
        color: var(--gray-600);
        margin-bottom: 0.4rem;
    }
    .rollup-head strong { color: var(--gray-800); }

    /* ── Team list ──────────────────────────────────────────────────────── */
    .team-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 1.5rem;
        border-bottom: 1px solid var(--gray-100);
    }
    .team-row:last-child { border-bottom: none; }
    .team-row .who { flex-grow: 1; min-width: 0; }
    .team-row .name { font-weight: 600; font-size: 0.84rem; color: var(--gray-700); display: block; }
    .team-row .meta { font-size: 0.72rem; color: var(--gray-400); }
    .team-role {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        padding: 0.15rem 0.45rem;
        border-radius: 0.35rem;
        background: var(--primary-surface);
        color: var(--primary-dark);
    }

    .inline-form { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: flex-end; padding: 1rem 1.5rem; }
    .inline-form .filter-group { min-width: 140px; }

    /* Board task statuses reuse the project status chips where the names match, so
       these fill in the ones they do not cover. */
    .pstatus-NotStarted  { background: var(--gray-100); color: var(--gray-600); border-color: var(--gray-300); }
    .pstatus-Assigned    { background: #eef2ff; color: #4338ca; border-color: #c7d2fe; }
    .pstatus-InProgress  { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
    .pstatus-Waiting     { background: var(--warning-light); color: #b45309; border-color: #ffe0b3; }
    .pstatus-Blocked     { background: var(--danger-light); color: var(--danger); border-color: #fed7d7; }
    .pstatus-UnderReview { background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe; }
    .pstatus-Planned     { background: var(--gray-100); color: var(--gray-600); border-color: var(--gray-300); }
    .pstatus-AtRisk      { background: var(--warning-light); color: #b45309; border-color: #ffe0b3; }
    .pstatus-Achieved    { background: var(--success-light); color: var(--success); border-color: #c6e0c9; }
    .pstatus-Missed      { background: var(--danger-light); color: var(--danger); border-color: #fed7d7; }

    .tprio {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.1rem 0.35rem;
        border-radius: 0.3rem;
    }
    .tprio-Low      { background: var(--gray-100); color: var(--gray-500); }
    .tprio-Medium   { background: #eff6ff; color: #1d4ed8; }
    .tprio-High     { background: var(--warning-light); color: #b45309; }
    .tprio-Critical { background: var(--danger-light); color: var(--danger); }

    .active-view { border-color: var(--primary); color: var(--primary); font-weight: 700; }

    /* ── Kanban board ───────────────────────────────────────────────────── */
    .kanban {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(215px, 1fr);
        gap: 0.85rem;
        overflow-x: auto;
        padding-bottom: 0.75rem;
        align-items: start;
    }
    .kanban-col {
        background: var(--gray-50);
        border: 1px solid var(--gray-200);
        border-radius: var(--radius-md);
        overflow: hidden;
    }
    .kanban-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem 0.9rem;
        background: #fff;
        border-bottom: 1px solid var(--gray-200);
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--gray-700);
    }
    .kanban-count {
        background: var(--gray-100);
        color: var(--gray-500);
        border-radius: 999px;
        padding: 0.05rem 0.45rem;
        font-size: 0.7rem;
    }
    .kanban-body { padding: 0.6rem; display: flex; flex-direction: column; gap: 0.6rem; min-height: 4rem; }
    .kanban-card {
        background: #fff;
        border: 1px solid var(--gray-200);
        border-left: 3px solid var(--primary);
        border-radius: 0.6rem;
        padding: 0.6rem 0.7rem;
        box-shadow: var(--shadow-sm);
    }
    .kanban-card.is-blocked { border-left-color: var(--danger); }
    .kanban-card-title { font-size: 0.8rem; font-weight: 600; color: var(--gray-800); margin-bottom: 0.4rem; }
    .kanban-card-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        font-size: 0.68rem;
        color: var(--gray-500);
        align-items: center;
    }
    .kanban-card-actions { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.5rem; }
    .lane-btn {
        font-size: 0.62rem;
        padding: 0.12rem 0.35rem;
        border: 1px solid var(--gray-200);
        background: var(--gray-50);
        color: var(--gray-500);
        border-radius: 0.3rem;
        cursor: pointer;
        transition: var(--transition-smooth);
    }
    .lane-btn:hover { background: var(--primary); border-color: var(--primary); color: #fff; }
    .kanban-empty { font-size: 0.72rem; color: var(--gray-400); text-align: center; padding: 0.75rem 0; margin: 0; }
</style>
