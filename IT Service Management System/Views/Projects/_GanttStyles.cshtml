@*
    Gantt chart styling. Everything is positioned by percentage against a window computed on the
    server, so the chart reflows to any width without recomputing dates. Used by the per-project
    chart and by the portfolio timeline on the schedule page.
*@
<style>
    .gantt-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid var(--gray-100);
        font-size: 0.72rem;
        color: var(--gray-500);
    }
    .gantt-legend .swatch {
        display: inline-block;
        width: 0.85rem;
        height: 0.55rem;
        border-radius: 0.15rem;
        margin-right: 0.3rem;
        vertical-align: middle;
    }
    .gantt-legend .swatch.bar-today { width: 2px; height: 0.85rem; background: var(--danger); }

    .gantt { display: flex; align-items: stretch; }

    /* Labels are a fixed column; the chart beside them scrolls horizontally. */
    .gantt-labels {
        flex: 0 0 220px;
        border-right: 1px solid var(--gray-200);
        background: #fff;
        z-index: 2;
    }
    .gantt-corner {
        height: 28px;
        display: flex;
        align-items: center;
        padding: 0 0.75rem;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--gray-400);
        border-bottom: 1px solid var(--gray-200);
        background: var(--gray-50);
    }
    .gantt-label {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0 0.75rem;
        font-size: 0.78rem;
        color: var(--gray-700);
        border-bottom: 1px solid var(--gray-100);
        overflow: hidden;
    }
    .gantt-label .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .gantt-label .who {
        margin-left: auto;
        flex-shrink: 0;
        font-size: 0.65rem;
        color: var(--gray-400);
    }
    .gantt-label.is-milestone { font-weight: 700; color: var(--gray-800); background: var(--gray-50); }
    .gantt-label.is-milestone i { color: var(--primary); font-size: 0.7rem; }

    .gantt-scroll { flex: 1; overflow-x: auto; min-width: 0; }
    .gantt-chart { position: relative; min-width: 640px; }

    .gantt-axis {
        position: relative;
        height: 28px;
        border-bottom: 1px solid var(--gray-200);
        background: var(--gray-50);
    }
    .gantt-tick {
        position: absolute;
        top: 0;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-left: 1px solid var(--gray-200);
        font-size: 0.66rem;
        color: var(--gray-500);
        overflow: hidden;
        white-space: nowrap;
    }

    .gantt-rows { position: relative; }
    .gantt-gridline {
        position: absolute;
        top: 0; bottom: 0;
        width: 1px;
        background: var(--gray-100);
    }
    .gantt-today {
        position: absolute;
        top: 0; bottom: 0;
        width: 2px;
        background: var(--danger);
        z-index: 3;
    }
    .gantt-today::after {
        content: "";
        position: absolute;
        top: -4px; left: -3px;
        border: 4px solid transparent;
        border-top-color: var(--danger);
    }

    .gantt-links {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }
    .gantt-link {
        fill: none;
        stroke: var(--gray-400);
        stroke-width: 1;
        stroke-dasharray: 3 2;
    }

    .gantt-row {
        position: absolute;
        left: 0; right: 0;
        border-bottom: 1px solid var(--gray-100);
        z-index: 2;
    }

    .gantt-bar {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        height: 0.95rem;
        border-radius: 0.3rem;
        overflow: hidden;
        min-width: 3px;
        box-shadow: var(--shadow-sm);
    }
    .bar-task     { background: #93b4d8; }
    .bar-done     { background: var(--success); }
    .bar-critical { background: var(--primary); }
    .bar-overdue  { background: var(--danger); }

    .gantt-progress {
        height: 100%;
        background: rgba(255, 255, 255, 0.45);
        border-right: 1px solid rgba(255, 255, 255, 0.8);
    }

    /* Baseline sits behind the live bar as a ghost, so slippage is visible as a shift. */
    .bar-baseline {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        height: 1.45rem;
        border: 1px dashed var(--gray-300);
        border-radius: 0.3rem;
        background: transparent;
        min-width: 3px;
    }

    .gantt-diamond {
        position: absolute;
        top: 50%;
        width: 0.7rem;
        height: 0.7rem;
        margin-left: -0.35rem;
        transform: translateY(-50%) rotate(45deg);
        background: var(--primary);
        border: 1px solid #fff;
        box-shadow: var(--shadow-sm);
    }
    .gantt-diamond.is-done { background: var(--success); }
    .gantt-diamond.is-overdue { background: var(--danger); }

    @@media (max-width: 767px) {
        .gantt-labels { flex-basis: 140px; }
        .gantt-label { font-size: 0.72rem; }
        .gantt-label .who { display: none; }
    }
</style>
