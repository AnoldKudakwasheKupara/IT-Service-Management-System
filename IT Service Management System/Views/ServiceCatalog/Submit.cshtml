@model IT_Service_Management_System.ViewModels.Itsm.SubmitServiceRequestVm
@{
    ViewData["Title"] = "Request " + Model.Item?.Name;
}
<partial name="_Styles" />
<div class="page-container" style="max-width:900px">
    <a asp-action="Details" asp-route-id="@Model.ServiceCatalogItemId" class="btn btn-link px-0 mb-3"><i class="fas fa-arrow-left me-1"></i>Back</a>
    <div class="catalog-panel">
        <h1 class="h3 mb-2">Request @Model.Item?.Name</h1>
        <p class="text-muted mb-4">Provide enough information for the fulfilment team to complete your request.</p>
        <form asp-action="Submit" method="post">
            <input asp-for="ServiceCatalogItemId" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-semibold"></label>
                <input asp-for="Subject" class="form-control" />
                <span asp-validation-for="Subject" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Details" class="form-label fw-semibold">Request details</label>
                <textarea asp-for="Details" class="form-control" rows="7" placeholder="Describe what you need, who it is for, and any required dates."></textarea>
                <span asp-validation-for="Details" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="BusinessJustification" class="form-label fw-semibold">Business justification</label>
                <textarea asp-for="BusinessJustification" class="form-control" rows="3"></textarea>
            </div>
            @if (Model.Item?.RequiresApproval == true)
            {
                <div class="alert alert-warning"><i class="fas fa-user-check me-2"></i>This service requires approval before fulfilment begins.</div>
            }
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@Model.ServiceCatalogItemId" class="btn btn-outline-secondary">Cancel</a>
                <button class="btn btn-primary"><i class="fas fa-paper-plane me-1"></i>Submit request</button>
            </div>
        </form>
    </div>
</div>
