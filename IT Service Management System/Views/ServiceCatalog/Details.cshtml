@model IT_Service_Management_System.Models.Itsm.ServiceCatalogItem
@{
    ViewData["Title"] = Model.Name;
}
<partial name="_Styles" />
<div class="catalog-shell">
    <a asp-action="Index" class="btn btn-link px-0 mb-3"><i class="fas fa-arrow-left me-1"></i>Back to catalogue</a>
    <div class="catalog-panel">
        <div class="d-flex gap-3 align-items-start">
            <div class="catalog-icon"><i class="fas @Model.Icon"></i></div>
            <div class="flex-grow-1">
                <span class="catalog-badge mb-2">@Model.Category</span>
                <h1 class="h2">@Model.Name</h1>
                <p class="lead text-muted">@Model.Summary</p>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="mt-4" style="white-space:pre-line">@Model.Description</div>
                }
                <hr class="my-4" />
                <div class="row g-3 mb-4">
                    <div class="col-md-4"><strong>Priority</strong><div class="text-muted">@Model.DefaultPriority</div></div>
                    <div class="col-md-4"><strong>Target</strong><div class="text-muted">@TimeSpan.FromMinutes(Model.FulfillmentTargetMinutes).TotalHours.ToString("0.#") hours</div></div>
                    <div class="col-md-4"><strong>Approval</strong><div class="text-muted">@(Model.RequiresApproval ? "Required" : "Not required")</div></div>
                </div>
                <a asp-action="Submit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg"><i class="fas fa-paper-plane me-2"></i>Request this service</a>
            </div>
        </div>
    </div>
</div>
