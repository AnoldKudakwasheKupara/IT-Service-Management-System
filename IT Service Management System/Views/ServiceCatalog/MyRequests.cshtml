@model List<IT_Service_Management_System.Models.Itsm.ServiceRequest>
@{
    ViewData["Title"] = "My Service Requests";
}
<partial name="_Styles" />
<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="h2 mb-1">My Service Requests</h1><p class="text-muted mb-0">Track approval and fulfilment progress.</p></div>
        <a asp-action="Index" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New request</a>
    </div>
    <div class="catalog-panel table-responsive">
        <table class="catalog-table">
            <thead><tr><th>Reference</th><th>Service</th><th>Subject</th><th>Status</th><th>Due</th><th></th></tr></thead>
            <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td><strong>@request.Reference</strong></td>
                    <td>@request.ServiceCatalogItem?.Name</td>
                    <td>@request.Subject</td>
                    <td><span class="catalog-badge status-@request.Status">@request.Status</span></td>
                    <td class="@(request.IsOverdue ? "text-danger fw-semibold" : "")">@(request.DueAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                    <td><a asp-action="RequestDetails" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
        @if (!Model.Any()) { <div class="text-center text-muted py-5">You have not submitted any service requests.</div> }
    </div>
</div>
