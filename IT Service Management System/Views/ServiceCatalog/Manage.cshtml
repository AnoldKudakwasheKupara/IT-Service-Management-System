@model List<IT_Service_Management_System.Models.Itsm.ServiceCatalogItem>
@using IT_Service_Management_System.Models
@using static IT_Service_Management_System.Models.Ticket
@{
    ViewData["Title"] = "Manage Service Catalogue";
    var owners = ViewBag.Owners as List<User> ?? new();
}
<partial name="_Styles" />
<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="h2 mb-1">Manage Service Catalogue</h1><p class="text-muted mb-0">Publish requestable services and configure their owners and targets.</p></div>
        <a asp-action="Queue" class="btn btn-outline-primary">Fulfilment queue</a>
    </div>
    <div class="catalog-panel mb-4">
        <h2 class="h5 mb-3">Add catalogue item</h2>
        <form asp-action="SaveItem" method="post">
            <input type="hidden" name="id" value="0" />
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Name</label><input name="name" class="form-control" required maxlength="120" /></div>
                <div class="col-md-6"><label class="form-label">Category</label><input name="category" class="form-control" required maxlength="80" /></div>
                <div class="col-12"><label class="form-label">Summary</label><input name="summary" class="form-control" required maxlength="240" /></div>
                <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3"></textarea></div>
                <div class="col-md-3"><label class="form-label">Icon class</label><input name="icon" value="fa-concierge-bell" class="form-control" /></div>
                <div class="col-md-3"><label class="form-label">Default priority</label><select name="defaultPriority" class="form-select">@foreach (var p in Enum.GetValues<TicketPriority>()) { <option value="@p">@p</option> }</select></div>
                <div class="col-md-3"><label class="form-label">Target minutes</label><input name="fulfillmentTargetMinutes" type="number" min="1" value="1440" class="form-control" required /></div>
                <div class="col-md-3"><label class="form-label">Owner</label><select name="ownerId" class="form-select"><option value="">Unassigned</option>@foreach (var owner in owners) { <option value="@owner.Id">@owner.FullName</option> }</select></div>
                <div class="col-12 d-flex gap-4"><label class="form-check"><input type="checkbox" name="requiresApproval" value="true" class="form-check-input" /> Requires approval</label><label class="form-check"><input type="checkbox" name="isPublished" value="true" class="form-check-input" checked /> Published</label></div>
                <div class="col-12 text-end"><button class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add item</button></div>
            </div>
        </form>
    </div>

    <div class="accordion" id="catalogueItems">
        @foreach (var item in Model)
        {
            <div class="accordion-item mb-3 border rounded-3 overflow-hidden">
                <h2 class="accordion-header" id="heading-@item.Id"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#item-@item.Id"><i class="fas @item.Icon me-2 text-primary"></i>@item.Name <span class="catalog-badge ms-2">@item.Category</span>@if (!item.IsPublished) { <span class="badge bg-secondary ms-2">Hidden</span> }</button></h2>
                <div id="item-@item.Id" class="accordion-collapse collapse" data-bs-parent="#catalogueItems">
                    <div class="accordion-body">
                        <form asp-action="SaveItem" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="row g-3">
                                <div class="col-md-6"><label class="form-label">Name</label><input name="name" value="@item.Name" class="form-control" required /></div>
                                <div class="col-md-6"><label class="form-label">Category</label><input name="category" value="@item.Category" class="form-control" required /></div>
                                <div class="col-12"><label class="form-label">Summary</label><input name="summary" value="@item.Summary" class="form-control" required /></div>
                                <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="3">@item.Description</textarea></div>
                                <div class="col-md-3"><label class="form-label">Icon</label><input name="icon" value="@item.Icon" class="form-control" /></div>
                                <div class="col-md-3"><label class="form-label">Priority</label><select name="defaultPriority" class="form-select">@foreach (var p in Enum.GetValues<TicketPriority>()) { <option value="@p" selected="@(item.DefaultPriority == p)">@p</option> }</select></div>
                                <div class="col-md-3"><label class="form-label">Target minutes</label><input name="fulfillmentTargetMinutes" type="number" min="1" value="@item.FulfillmentTargetMinutes" class="form-control" /></div>
                                <div class="col-md-3"><label class="form-label">Owner</label><select name="ownerId" class="form-select"><option value="">Unassigned</option>@foreach (var owner in owners) { <option value="@owner.Id" selected="@(item.OwnerId == owner.Id)">@owner.FullName</option> }</select></div>
                                <div class="col-12 d-flex gap-4"><label class="form-check"><input type="checkbox" name="requiresApproval" value="true" class="form-check-input" checked="@item.RequiresApproval" /> Requires approval</label><label class="form-check"><input type="checkbox" name="isPublished" value="true" class="form-check-input" checked="@item.IsPublished" /> Published</label></div>
                                <div class="col-12 text-end"><button class="btn btn-primary">Save changes</button></div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
