@using IT_Service_Management_System.Models.Pm
@using IT_Service_Management_System.Services.Pm
@model Project
@{
    ViewData["Title"] = $"Plan — {Model.Reference}";
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var phases = ViewBag.Phases as List<ProjectPhase> ?? new List<ProjectPhase>();
    var tree = ViewBag.WbsTree as List<(WbsItem Item, int Depth)> ?? new List<(WbsItem, int)>();
    var counts = ViewBag.PhaseTaskCounts as Dictionary<int, (int Total, int Done)>
                 ?? new Dictionary<int, (int Total, int Done)>();
    var suggestions = ViewBag.Suggestions as List<WbsSuggestion> ?? new List<WbsSuggestion>();
    var users = ViewBag.Users as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var phaseOptions = ViewBag.PhaseOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<partial name="_PmStyles" />

<div class="pm">
    <div class="page-container">

        <partial name="_PmProjectHeader" />
        <partial name="_PmAlerts" />

        <div class="stats tight">
            <div class="stat">
                <div class="ic brand"><i class="fas fa-layer-group"></i></div>
                <div><h3>@phases.Count</h3><p>Phases</p></div>
            </div>
            <div class="stat">
                <div class="ic blue"><i class="fas fa-sitemap"></i></div>
                <div><h3>@tree.Count</h3><p>Work packages</p></div>
            </div>
            <div class="stat">
                <div class="ic purple"><i class="fas fa-hourglass"></i></div>
                <div><h3>@(((decimal)(ViewBag.TotalEstimatedHours ?? 0m)).ToString("N0"))</h3><p>Estimated hours</p></div>
            </div>
            <a asp-action="Milestones" asp-route-projectId="@Model.Id" class="stat">
                <div class="ic teal"><i class="fas fa-flag-checkered"></i></div>
                <div><h3><i class="fas fa-arrow-right" style="font-size:1rem;"></i></h3><p>Milestones</p></div>
            </a>
            <a asp-action="Deliverables" asp-route-projectId="@Model.Id" class="stat">
                <div class="ic amber"><i class="fas fa-box-open"></i></div>
                <div><h3><i class="fas fa-arrow-right" style="font-size:1rem;"></i></h3><p>Deliverables</p></div>
            </a>
            <a asp-action="Calendar" asp-route-projectId="@Model.Id" class="stat">
                <div class="ic slate"><i class="fas fa-calendar-days"></i></div>
                <div><h3><i class="fas fa-arrow-right" style="font-size:1rem;"></i></h3><p>Calendar</p></div>
            </a>
        </div>

        @if (suggestions.Count > 0 && canEdit)
        {
            <div class="insight">
                <h4><i class="fas fa-wand-magic-sparkles"></i> Suggested breakdown</h4>
                <p>
                    This project has no work breakdown yet. Based on
                    <strong>@suggestions.First().Source</strong>, a typical @Model.Category project looks like this:
                </p>
                <div style="margin:.6rem 0; display:flex; gap:.4rem; flex-wrap:wrap;">
                    @foreach (var s in suggestions.Where(x => x.ItemType != "Milestone"))
                    {
                        <span class="chip">@s.Name <span class="meta">@s.DurationDays d</span></span>
                    }
                </div>
                <form asp-action="ApplySuggestedWbs" method="post" style="margin-top:.6rem;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@Model.Id" />
                    <button type="submit" class="btn-outline-pm btn-sm"><i class="fas fa-plus"></i> Create these work packages</button>
                </form>
            </div>
        }

        @* ── PHASES ──────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-layer-group"></i> Phases</span>
                @if (canEdit)
                {
                    <button type="button" class="btn-ghost-pm btn-sm" onclick="pmToggle('phase-form')">
                        <i class="fas fa-plus"></i> Add phase
                    </button>
                }
            </div>
            <div class="card-body">
                @if (canEdit)
                {
                    <form asp-action="SavePhase" method="post" id="phase-form" style="display:none; margin-bottom:1.25rem; padding-bottom:1.25rem; border-bottom:1px solid var(--gray-200);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProjectId" value="@Model.Id" />
                        <input type="hidden" name="Id" value="0" />
                        <div class="form-grid three">
                            <div class="fg full">
                                <label class="lbl"><i class="fas fa-heading"></i> Phase name</label>
                                <input name="Name" class="inp" required placeholder="e.g. Design" />
                            </div>
                            <div class="fg"><label class="lbl">Start</label><input name="StartDate" type="date" class="inp" /></div>
                            <div class="fg"><label class="lbl">End</label><input name="EndDate" type="date" class="inp" /></div>
                            <div class="fg">
                                <label class="lbl">Status</label>
                                <select name="Status" class="inp">
                                    @foreach (var s in Enum.GetValues<PhaseStatus>())
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>
                            <div class="fg full">
                                <label class="lbl">Description</label>
                                <textarea name="Description" class="inp" rows="2"></textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn-pm btn-sm"><i class="fas fa-floppy-disk"></i> Save phase</button>
                    </form>
                }

                @if (phases.Count == 0)
                {
                    <p class="meta">No phases yet. Phases group tasks, milestones and budget lines along the timeline.</p>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:.75rem;">
                        @foreach (var ph in phases)
                        {
                            (int Total, int Done) c = counts.GetValueOrDefault(ph.Id);
                            <div style="border:1px solid var(--gray-200); border-radius:.7rem; padding:.9rem 1.1rem;">
                                <div style="display:flex; justify-content:space-between; gap:.75rem; flex-wrap:wrap; align-items:center;">
                                    <div style="min-width:0;">
                                        <strong style="color:var(--gray-800);">@ph.Sequence. @ph.Name</strong>
                                        <span class="badge-pm b-@(ph.Status == PhaseStatus.Completed ? "completed" : ph.Status == PhaseStatus.InProgress ? "active" : "draft")" style="margin-left:.4rem;">@ph.Status</span>
                                        <div class="meta" style="font-size:.78rem;">
                                            @(ph.StartDate?.ToString("d MMM yyyy") ?? "—") → @(ph.EndDate?.ToString("d MMM yyyy") ?? "—")
                                            · @c.Done/@c.Total task(s) complete
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(ph.Description))
                                        {
                                            <div class="meta" style="font-size:.8rem; margin-top:.25rem;">@ph.Description</div>
                                        }
                                    </div>
                                    <div style="display:flex; align-items:center; gap:.75rem;">
                                        <div style="min-width:110px;">
                                            <div class="progress-pm thin"><span style="width:@ph.ProgressPercent%"></span></div>
                                            <span class="meta" style="font-size:.7rem;">@ph.ProgressPercent%</span>
                                        </div>
                                        @if (canEdit)
                                        {
                                            <form asp-action="DeletePhase" method="post" class="inline-form"
                                                  onsubmit="return confirm('Remove this phase? Its tasks stay but become unphased.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="projectId" value="@Model.Id" />
                                                <input type="hidden" name="phaseId" value="@ph.Id" />
                                                <button type="submit" class="act del"><i class="fas fa-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── WBS ─────────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-sitemap"></i> Work Breakdown Structure</span>
                @if (canEdit)
                {
                    <button type="button" class="btn-ghost-pm btn-sm" onclick="pmToggle('wbs-form')">
                        <i class="fas fa-plus"></i> Add work package
                    </button>
                }
            </div>
            <div class="card-body">
                @if (canEdit)
                {
                    <form asp-action="SaveWbsItem" method="post" id="wbs-form" style="display:none; margin-bottom:1.25rem; padding-bottom:1.25rem; border-bottom:1px solid var(--gray-200);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProjectId" value="@Model.Id" />
                        <input type="hidden" name="Id" value="0" />
                        <div class="form-grid three">
                            <div class="fg full">
                                <label class="lbl"><i class="fas fa-heading"></i> Name</label>
                                <input name="Name" class="inp" required />
                            </div>
                            <div class="fg">
                                <label class="lbl">Parent package</label>
                                <select name="ParentId" class="inp">
                                    <option value="">— Top level —</option>
                                    @foreach (var (item, depth) in tree)
                                    {
                                        <option value="@item.Id">@(new string('—', depth)) @item.WbsCode @item.Name</option>
                                    }
                                </select>
                            </div>
                            @if (phaseOptions.Any())
                            {
                                <div class="fg">
                                    <label class="lbl">Phase</label>
                                    <select name="PhaseId" class="inp">
                                        <option value="">— None —</option>
                                        @foreach (var p in phaseOptions)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="fg">
                                <label class="lbl">Owner</label>
                                <select name="OwnerId" class="inp">
                                    <option value="">— None —</option>
                                    @foreach (var u in users)
                                    {
                                        <option value="@u.Id">@u.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="fg"><label class="lbl">Start</label><input name="StartDate" type="date" class="inp" /></div>
                            <div class="fg"><label class="lbl">End</label><input name="EndDate" type="date" class="inp" /></div>
                            <div class="fg"><label class="lbl">Estimated hours</label><input name="EstimatedHours" type="number" step="0.25" min="0" value="0" class="inp" /></div>
                            <div class="fg"><label class="lbl">Estimated cost</label><input name="EstimatedCost" type="number" step="0.01" min="0" value="0" class="inp" /></div>
                            <div class="fg"><label class="lbl">Progress %</label><input name="ProgressPercent" type="number" min="0" max="100" value="0" class="inp" /></div>
                        </div>
                        <p class="hint" style="margin-bottom:.6rem;">
                            Outline numbers and parent totals are recalculated automatically after every save.
                        </p>
                        <button type="submit" class="btn-pm btn-sm"><i class="fas fa-floppy-disk"></i> Save work package</button>
                    </form>
                }

                @if (tree.Count == 0)
                {
                    <div class="empty">
                        <i class="fas fa-sitemap"></i>
                        <h3>No breakdown yet</h3>
                        <p>Decompose the scope into work packages so effort and cost can be estimated bottom-up.</p>
                    </div>
                }
                else
                {
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>WBS</th><th>Work package</th><th>Owner</th><th>Dates</th>
                                <th class="num">Hours</th><th class="num">Cost</th><th style="min-width:100px;">Progress</th>
                                @if (canEdit) { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, depth) in tree)
                            {
                                <tr>
                                    <td class="ref">@item.WbsCode</td>
                                    <td style="padding-left:@(1.25 + depth * 1.25)rem;">
                                        @if (depth > 0) { <i class="fas fa-turn-up fa-rotate-90 meta" style="font-size:.7rem;"></i> }
                                        <strong style="color:var(--gray-800);">@item.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="meta" style="font-size:.75rem;">@item.Description</div>
                                        }
                                    </td>
                                    <td class="meta">@(item.Owner == null ? "—" : $"{item.Owner.FirstName} {item.Owner.LastName}")</td>
                                    <td class="meta" style="font-size:.75rem; white-space:nowrap;">
                                        @(item.StartDate?.ToString("d MMM yy") ?? "—") → @(item.EndDate?.ToString("d MMM yy") ?? "—")
                                    </td>
                                    <td class="num">@item.EstimatedHours.ToString("N1")</td>
                                    <td class="num money">@item.EstimatedCost.ToString("N0")</td>
                                    <td>
                                        <div class="progress-pm thin"><span style="width:@item.ProgressPercent%"></span></div>
                                        <span class="meta" style="font-size:.7rem;">@item.ProgressPercent%</span>
                                    </td>
                                    @if (canEdit)
                                    {
                                        <td style="text-align:right;">
                                            <form asp-action="DeleteWbsItem" method="post" class="inline-form"
                                                  onsubmit="return confirm('Remove this work package?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="projectId" value="@Model.Id" />
                                                <input type="hidden" name="itemId" value="@item.Id" />
                                                <button type="submit" class="act del"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function pmToggle(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
            if (el.style.display === 'block') el.querySelector('input, select, textarea')?.focus();
        }
    </script>
}
