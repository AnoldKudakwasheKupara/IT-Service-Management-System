@using IT_Service_Management_System.Models.Pm
@model List<Milestone>
@{
    var project = ViewBag.Project as Project;
    ViewData["Title"] = $"Milestones — {project?.Reference}";
    var canContribute = ViewBag.CanContribute as bool? ?? false;
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var users = ViewBag.Users as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var phaseOptions = ViewBag.PhaseOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var deliverableCounts = ViewBag.Deliverables as Dictionary<int, int> ?? new Dictionary<int, int>();
    var curStatus = ViewBag.Status as MilestoneStatus?;
}

<partial name="_PmStyles" />

<div class="pm">
    <div class="page-container">

        <partial name="_PmProjectHeader" />
        <partial name="_PmAlerts" />

        <div class="stats tight">
            <div class="stat">
                <div class="ic brand"><i class="fas fa-flag-checkered"></i></div>
                <div><h3>@Model.Count</h3><p>Milestones</p></div>
            </div>
            <div class="stat">
                <div class="ic green"><i class="fas fa-circle-check"></i></div>
                <div><h3>@Model.Count(m => m.Status == MilestoneStatus.Achieved)</h3><p>Achieved</p></div>
            </div>
            <div class="stat">
                <div class="ic red"><i class="fas fa-calendar-xmark"></i></div>
                <div><h3>@Model.Count(m => m.IsOverdue)</h3><p>Overdue</p></div>
            </div>
            <div class="stat">
                <div class="ic amber"><i class="fas fa-clock"></i></div>
                <div>
                    <h3>@(Model.Where(m => m.SlippageDays > 0).Select(m => m.SlippageDays).DefaultIfEmpty(0).Max())</h3>
                    <p>Worst slippage (days)</p>
                </div>
            </div>
            <a asp-action="Deliverables" asp-route-projectId="@project!.Id" class="stat">
                <div class="ic teal"><i class="fas fa-box-open"></i></div>
                <div><h3><i class="fas fa-arrow-right" style="font-size:1rem;"></i></h3><p>Deliverables</p></div>
            </a>
        </div>

        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-flag-checkered"></i> Milestones</span>
                <div style="display:flex; gap:.5rem; align-items:center;">
                    <form method="get" style="display:inline-flex; gap:.4rem;">
                        <input type="hidden" name="projectId" value="@project.Id" />
                        <select name="status" class="inp" style="width:auto; padding:.35rem .6rem; font-size:.8rem;" onchange="this.form.submit()">
                            <option value="">All statuses</option>
                            @foreach (var s in Enum.GetValues<MilestoneStatus>())
                            {
                                <option value="@s" selected="@(curStatus == s)">@s</option>
                            }
                        </select>
                    </form>
                    @if (canContribute)
                    {
                        <button type="button" class="btn-pm btn-sm" onclick="pmToggle('ms-form')"><i class="fas fa-plus"></i> New milestone</button>
                    }
                </div>
            </div>
            <div class="card-body">
                @if (canContribute)
                {
                    <form asp-action="SaveMilestone" method="post" id="ms-form" style="display:none; margin-bottom:1.25rem; padding-bottom:1.25rem; border-bottom:1px solid var(--gray-200);">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProjectId" value="@project.Id" />
                        <input type="hidden" name="Id" value="0" />
                        <div class="form-grid three">
                            <div class="fg full">
                                <label class="lbl"><i class="fas fa-heading"></i> Milestone name</label>
                                <input name="Name" class="inp" required placeholder="e.g. Go-live" />
                            </div>
                            <div class="fg">
                                <label class="lbl"><i class="far fa-calendar"></i> Due date</label>
                                <input name="DueDate" type="date" class="inp" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="fg">
                                <label class="lbl"><i class="fas fa-user"></i> Owner</label>
                                <select name="OwnerId" class="inp">
                                    <option value="">— None —</option>
                                    @foreach (var u in users)
                                    {
                                        <option value="@u.Id">@u.Name</option>
                                    }
                                </select>
                            </div>
                            @if (phaseOptions.Any())
                            {
                                <div class="fg">
                                    <label class="lbl"><i class="fas fa-layer-group"></i> Phase</label>
                                    <select name="PhaseId" class="inp">
                                        <option value="">— None —</option>
                                        @foreach (var p in phaseOptions)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                            <div class="fg full">
                                <label class="lbl"><i class="fas fa-align-left"></i> Description</label>
                                <textarea name="Description" class="inp" rows="2"></textarea>
                            </div>
                            <div class="fg full">
                                <label class="check">
                                    <input type="checkbox" name="RequiresClientApproval" value="true" />
                                    The client must sign this milestone off in the portal
                                </label>
                            </div>
                        </div>
                        <button type="submit" class="btn-pm btn-sm"><i class="fas fa-floppy-disk"></i> Save milestone</button>
                    </form>
                }

                @if (Model.Count == 0)
                {
                    <div class="empty">
                        <i class="fas fa-flag-checkered"></i>
                        <h3>No milestones</h3>
                        <p>Milestones mark the moments that matter — approvals, go-live, handover.</p>
                    </div>
                }
                else
                {
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Milestone</th><th>Owner</th><th>Due</th><th>Baseline</th>
                                <th class="num">Slippage</th><th>Status</th><th>Client sign-off</th><th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model)
                            {
                                <tr>
                                    <td>
                                        <i class="fas fa-diamond" style="font-size:.6rem; color:@(m.Status == MilestoneStatus.Achieved ? "var(--success)" : m.IsOverdue ? "var(--danger)" : "var(--pm-purple)");"></i>
                                        <strong style="color:var(--gray-800);">@m.Name</strong>
                                        @if (deliverableCounts.TryGetValue(m.Id, out var dc) && dc > 0)
                                        {
                                            <span class="chip" style="margin-left:.35rem;">@dc deliverable(s)</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(m.Description))
                                        {
                                            <div class="meta" style="font-size:.78rem;">@m.Description</div>
                                        }
                                    </td>
                                    <td class="meta">@(m.Owner == null ? "—" : $"{m.Owner.FirstName} {m.Owner.LastName}")</td>
                                    <td class="meta @(m.IsOverdue ? "overdue" : "")">@m.DueDate.ToString("d MMM yyyy")</td>
                                    <td class="meta">@(m.BaselineDate?.ToString("d MMM yyyy") ?? "—")</td>
                                    <td class="num @(m.SlippageDays > 0 ? "overdue" : "")">@(m.SlippageDays > 0 ? m.SlippageDays.ToString() : "—")</td>
                                    <td><span class="badge-pm b-@(m.Status == MilestoneStatus.Achieved ? "completed" : m.Status == MilestoneStatus.Missed ? "delayed" : m.Status == MilestoneStatus.AtRisk ? "onhold" : "planning")">@m.Status</span></td>
                                    <td>
                                        @if (m.RequiresClientApproval)
                                        {
                                            <span class="badge-pm b-@(m.ClientApproved ? "closed" : "pending")">
                                                @(m.ClientApproved ? $"Approved {m.ClientApprovedAt:d MMM}" : "Awaiting client")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="meta">Not required</span>
                                        }
                                    </td>
                                    <td style="text-align:right;">
                                        <div class="act-btns" style="align-items:center;">
                                            @if (canContribute)
                                            {
                                                <form asp-action="SetMilestoneStatus" method="post" style="display:inline-flex; gap:.3rem;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="projectId" value="@project.Id" />
                                                    <input type="hidden" name="milestoneId" value="@m.Id" />
                                                    <select name="status" class="inp" style="width:auto; padding:.25rem .45rem; font-size:.75rem;">
                                                        @foreach (var s in Enum.GetValues<MilestoneStatus>())
                                                        {
                                                            <option value="@s" selected="@(m.Status == s)">@s</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="act ok" title="Update"><i class="fas fa-check"></i></button>
                                                </form>
                                            }
                                            @if (canEdit)
                                            {
                                                <form asp-action="DeleteMilestone" method="post" class="inline-form"
                                                      onsubmit="return confirm('Remove this milestone?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="projectId" value="@project.Id" />
                                                    <input type="hidden" name="milestoneId" value="@m.Id" />
                                                    <button type="submit" class="act del"><i class="fas fa-trash"></i></button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function pmToggle(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
            if (el.style.display === 'block') el.querySelector('input, select, textarea')?.focus();
        }
    </script>
}
