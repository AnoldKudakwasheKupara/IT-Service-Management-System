@model IT_Service_Management_System.Models.Meeting
@using IT_Service_Management_System.Enums
@using IT_Service_Management_System.Models
@{
    ViewData["Title"] = "Edit Meeting - Meeting Minutes";
    var users = (ViewBag.Users as List<User>) ?? new List<User>();
}

<partial name="_MeetingStyles" />

<div class="mm narrow">
    <div class="page-container">
        <div class="page-header head-row">
            <div style="display:flex;align-items:center;gap:.9rem;">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-back"><i class="fas fa-arrow-left"></i></a>
                <div>
                    <h1 class="page-title"><i class="fas fa-pen me-2" style="color:var(--warning);"></i> Edit Meeting</h1>
                    <p class="page-sub">@Model.DisplayTitle</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-clipboard-list"></i> Meeting details</span></div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="meta" style="color:var(--danger);"></div>
                    <div class="form-grid">
                        <div class="fg">
                            <label class="lbl" asp-for="Date"><i class="fas fa-calendar-day"></i> Meeting date <span class="req">*</span></label>
                            <input asp-for="Date" type="date" class="inp" required />
                            <span asp-validation-for="Date" class="meta" style="color:var(--danger);"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="FacilitatorId"><i class="fas fa-user-tie"></i> Facilitator</label>
                            <select asp-for="FacilitatorId" class="inp">
                                <option value="">— Select —</option>
                                @foreach (var u in users) { <option value="@u.Id" selected="@(u.Id == Model.FacilitatorId)">@u.FullName</option> }
                            </select>
                        </div>
                        <div class="fg full">
                            <label class="lbl" asp-for="Title"><i class="fas fa-heading"></i> Title</label>
                            <input asp-for="Title" class="inp" />
                        </div>
                        <div class="fg">
                            <label class="lbl" asp-for="Status"><i class="fas fa-circle-check"></i> Status</label>
                            <select asp-for="Status" class="inp">
                                @foreach (MeetingStatus s in Enum.GetValues(typeof(MeetingStatus))) { <option value="@s" selected="@(s == Model.Status)">@s</option> }
                            </select>
                        </div>
                        <div class="fg full">
                            <label class="lbl" asp-for="Summary"><i class="fas fa-align-left"></i> Minutes / summary</label>
                            <textarea asp-for="Summary" rows="5" class="inp"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-primary-mm" style="flex:1;justify-content:center;"><i class="fas fa-save"></i> Save changes</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-ghost-mm" style="flex:1;justify-content:center;"><i class="fas fa-times"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
