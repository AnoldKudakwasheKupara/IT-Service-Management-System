@{
    ViewData["Title"] = "ISO Reports";
    var excel = new[]
    {
        ("Document Register", "fa-file-shield", "DocumentsXlsx"),
        ("CAPA Register", "fa-screwdriver-wrench", "CapaXlsx"),
        ("Risk Register", "fa-gauge-high", "RiskXlsx"),
        ("Audit Findings", "fa-magnifying-glass", "FindingsXlsx"),
        ("Training Records", "fa-graduation-cap", "TrainingXlsx"),
        ("Supplier Evaluations", "fa-truck-field", "SuppliersXlsx"),
    };
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-file-export me-2" style="color: var(--primary);"></i>
                    ISO Reports
                </h1>
                <p class="text-muted mt-2">Export IMS registers to Excel or generate PDF report packs</p>
            </div>
        </div>
    </div>

    <!-- PDF REPORT PACKS -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-file-pdf me-2" style="color: var(--danger);"></i>
            <span>Report Packs (PDF)</span>
        </div>
        <div class="card-body-custom">
            <a class="btn-pdf-report" asp-action="ExecutiveSummaryPdf">
                <i class="fas fa-file-pdf"></i> Executive Summary Pack
            </a>
            <p class="report-hint">
                <i class="fas fa-info-circle"></i>
                A one-page management overview: documents, CAPAs, top risks and open audit findings.
            </p>
        </div>
    </div>

    <!-- EXCEL EXPORTS -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-file-excel me-2" style="color: var(--success);"></i>
            <span>Register Exports (Excel)</span>
        </div>
        <div class="card-body-custom">
            <div class="excel-grid">
                @foreach (var (title, icon, action) in excel)
                {
                    <a class="excel-item" asp-action="@action">
                        <div class="excel-icon green">
                            <i class="fas @icon"></i>
                        </div>
                        <div class="excel-info">
                            <h3 class="excel-title">@title</h3>
                            <p class="excel-download"><i class="fas fa-download"></i> Download .xlsx</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== PDF REPORT BUTTON ===== */
    .btn-pdf-report {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        background: linear-gradient(100deg, #dc2626, var(--danger));
        color: white;
        border: none;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        font-family: inherit;
    }

        .btn-pdf-report:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

        .btn-pdf-report i {
            font-size: 1rem;
        }

    .report-hint {
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

        .report-hint i {
            color: var(--gray-400);
            font-size: 0.75rem;
        }

    /* ===== EXCEL GRID ===== */
    .excel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
    }

    /* ===== EXCEL ITEM ===== */
    .excel-item {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.9rem 1.1rem;
        background: white;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.9rem;
        text-decoration: none;
        color: inherit;
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .excel-item:hover {
            border-color: var(--success);
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
            text-decoration: none;
        }

    .excel-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }

        .excel-icon.green {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

    .excel-item:hover .excel-icon {
        transform: scale(1.05);
    }

    .excel-info {
        flex: 1;
        min-width: 0;
    }

    .excel-title {
        font-weight: 600;
        color: var(--gray-800);
        font-size: 0.9rem;
        margin: 0;
        transition: color 0.2s;
    }

    .excel-item:hover .excel-title {
        color: var(--success);
    }

    .excel-download {
        font-size: 0.75rem;
        color: var(--gray-500);
        margin: 0.05rem 0 0;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

        .excel-download i {
            font-size: 0.65rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .excel-grid {
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
        }

        .excel-item {
            padding: 0.7rem 0.9rem;
        }

        .excel-icon {
            width: 38px;
            height: 38px;
            font-size: 1rem;
        }

        .excel-title {
            font-size: 0.8rem;
        }

        .excel-download {
            font-size: 0.65rem;
        }

        .btn-pdf-report {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.5rem;
        }

        .excel-grid {
            grid-template-columns: 1fr;
        }

        .excel-item {
            padding: 0.6rem 0.8rem;
        }

        .excel-icon {
            width: 34px;
            height: 34px;
            font-size: 0.9rem;
        }

        .excel-title {
            font-size: 0.75rem;
        }

        .excel-download {
            font-size: 0.6rem;
        }

        .btn-pdf-report {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
        }

        .report-hint {
            font-size: 0.7rem;
        }
    }
</style>
