@using IT_Service_Management_System.Models.Ims
@model List<AuditProgramme>
@{
    ViewData["Title"] = "Audit Programmes";
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a class="btn-back" asp-action="Index">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-calendar me-2" style="color: var(--primary);"></i>
                        Audit Programmes
                    </h1>
                    <p class="text-muted mt-2">Annual audit plans (ISO 9.2)</p>
                </div>
            </div>
            @if (canEdit)
            {
                <a class="btn-create-ticket" asp-action="CreateProgramme">
                    <i class="fas fa-plus"></i> New Programme
                </a>
            }
        </div>
    </div>

    <!-- PROGRAMMES TABLE -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-list me-2"></i>
                <span>Programmes</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count</span> programmes
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-1"></i> Year</th>
                                <th><i class="fas fa-heading me-1"></i> Title</th>
                                <th><i class="fas fa-certificate me-1"></i> Standard</th>
                                <th><i class="fas fa-clipboard-check me-1"></i> Audits</th>
                                <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.OrderByDescending(x => x.Year))
                            {
                                <tr>
                                    <td class="programme-year">@p.Year</td>
                                    <td class="programme-title">@p.Title</td>
                                    <td class="meta-text">@p.Standard</td>
                                    <td>
                                        <span class="audit-count-badge @(p.Audits.Count > 0 ? "has-audits" : "")">
                                            <i class="fas fa-clipboard-check"></i>
                                            @p.Audits.Count
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-badge @(p.Status == AuditStatus.InProgress ? "badge-success" : p.Status == AuditStatus.Planned ? "badge-warning" : "badge-gray")">
                                            @p.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-calendar"></i>
                    <h3>No programmes yet</h3>
                    <p>Get started by creating your first audit programme.</p>
                    @if (canEdit)
                    {
                        <a asp-action="CreateProgramme" class="btn-create-ticket-sm">
                            <i class="fas fa-plus"></i> New Programme
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-create-ticket-sm {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .btn-create-ticket-sm:hover {
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.9rem 1.5rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== PROGRAMME SPECIFIC ===== */
    .programme-year {
        font-weight: 700;
        color: var(--gray-800);
        font-size: 1rem;
    }

    .programme-title {
        font-weight: 500;
        color: var(--gray-700);
    }

    .meta-text {
        color: var(--gray-500);
        font-size: 0.85rem;
    }

    .audit-count-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.15rem 0.6rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-200);
    }

        .audit-count-badge.has-audits {
            background: #dbeafe;
            color: var(--primary-dark);
            border-color: #bfdbfe;
        }

        .audit-count-badge i {
            font-size: 0.65rem;
        }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--gray-500);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--gray-300);
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--gray-600);
        }

        .empty-state p {
            margin-bottom: 1.5rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.6rem 0.8rem;
        }

        .tickets-table {
            font-size: 0.8rem;
        }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.5rem;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.4rem 0.5rem;
            font-size: 0.7rem;
        }

        .status-badge {
            font-size: 0.6rem;
            padding: 0.1rem 0.4rem;
        }

        .programme-year {
            font-size: 0.85rem;
        }

        .programme-title {
            font-size: 0.8rem;
        }

        .meta-text {
            font-size: 0.7rem;
        }

        .audit-count-badge {
            font-size: 0.65rem;
            padding: 0.1rem 0.4rem;
        }

        .btn-create-ticket-sm {
            font-size: 0.75rem;
            padding: 0.4rem 0.8rem;
        }
    }
</style>
