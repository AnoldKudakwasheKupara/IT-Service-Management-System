@using IT_Service_Management_System.Models.Ims
@model Audit
@{ ViewData["Title"] = "New Audit"; ViewData["IsEdit"] = false; }
<partial name="_ImsStyles" />
<div class="ims narrow"><div class="page-container">
    <div class="page-header"><div class="head-row"><div style="display:flex;gap:1rem;align-items:center;">
        <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
        <div><h1 class="page-title"><i class="fas fa-clipboard-check"></i> New Audit</h1></div>
    </div></div></div>
    <form method="post" asp-action="Create">@Html.AntiForgeryToken()
        <div class="card"><div class="card-body">
            <partial name="_Fields" model="Model" />
            <div class="form-actions"><button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Create Audit</button><a class="btn-ghost-ims" asp-action="Index">Cancel</a></div>
        </div></div>
    </form>
</div></div>
