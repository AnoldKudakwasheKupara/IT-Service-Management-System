@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model Audit
@{
    ViewData["Title"] = Model.Reference;
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
    var canFinding = (bool)(ViewBag.CanRaiseFinding ?? false);
    var users = ViewBag.Users as List<User> ?? new();
    var departments = ViewBag.Departments as List<Department> ?? new();
    string StatusClass(AuditStatus s) => s switch { AuditStatus.Completed or AuditStatus.Closed => "b-closed", AuditStatus.InProgress => "b-medium", AuditStatus.Cancelled => "b-critical", _ => "b-draft" };
    string FindClass(FindingType t) => t switch { FindingType.MajorNonConformance => "b-critical", FindingType.MinorNonConformance => "b-high", FindingType.OpportunityForImprovement => "b-medium", FindingType.Conformity => "b-closed", _ => "b-low" };
    string ChkClass(ChecklistResult r) => r switch { ChecklistResult.Conform => "b-closed", ChecklistResult.NonConform => "b-critical", ChecklistResult.NotApplicable => "b-draft", _ => "b-medium" };
}
<partial name="_ImsStyles" />
<div class="ims"><div class="page-container">
    <div class="page-header"><div class="head-row">
        <div style="display:flex;gap:1rem;align-items:center;">
            <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h1 class="page-title"><span class="docnum" style="font-size:1rem;">@Model.Reference</span> &nbsp;@Model.Title</h1>
                <p class="page-sub"><span class="badge-ims @StatusClass(Model.Status)">@Model.Status</span> <span class="meta">· @Model.Type · @Model.Standard</span></p>
            </div>
        </div>
        <div class="head-actions">@if (canEdit) { <a class="btn-ghost-ims" asp-action="Edit" asp-route-id="@Model.Id"><i class="fas fa-pen"></i> Edit</a> }</div>
    </div></div>

    <div class="card"><div class="card-body">
        <div class="dl">
            <div><div class="k">Lead Auditor</div><div class="v">@(Model.LeadAuditor?.FullName ?? "—")</div></div>
            <div><div class="k">Department</div><div class="v">@(Model.Department?.Name ?? "—")</div></div>
            <div><div class="k">Planned</div><div class="v">@(Model.PlannedStartDate?.ToString("dd MMM") ?? "—") – @(Model.PlannedEndDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
            <div><div class="k">Programme</div><div class="v">@(Model.AuditProgramme != null ? $"{Model.AuditProgramme.Year} — {Model.AuditProgramme.Title}" : "—")</div></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Scope)) { <div style="margin-top:1rem;"><div class="k" style="text-transform:uppercase;font-size:.72rem;color:var(--gray-400);">Scope</div><p style="color:var(--gray-700);">@Model.Scope</p></div> }
    </div></div>

    <div class="form-grid" style="align-items:start;">
        @* Team *@
        <div class="card"><div class="card-head"><span class="t"><i class="fas fa-users"></i> Audit Team</span></div><div class="card-body">
            @if (Model.TeamMembers.Any())
            {
                <div style="display:flex;flex-direction:column;gap:.4rem;">
                    @foreach (var t in Model.TeamMembers)
                    { <div style="display:flex;justify-content:space-between;"><span>@(t.User?.FullName ?? "—")</span><span class="badge-ims b-internal">@t.RoleOnTeam</span></div> }
                </div>
            }
            else { <p class="meta">No team members yet.</p> }
            @if (canEdit)
            {
                <form method="post" asp-action="AddTeamMember" asp-route-id="@Model.Id" style="margin-top:.75rem;display:flex;gap:.4rem;flex-wrap:wrap;">@Html.AntiForgeryToken()
                    <select class="inp" name="userId" style="flex:1;min-width:140px;">@foreach (var u in users) { <option value="@u.Id">@u.FullName</option> }</select>
                    <select class="inp" name="roleOnTeam" style="width:auto;" asp-items="Html.GetEnumSelectList<AuditTeamRole>()"></select>
                    <button class="btn-ghost-ims" type="submit"><i class="fas fa-plus"></i></button>
                </form>
            }
        </div></div>

        @* Checklist *@
        <div class="card"><div class="card-head"><span class="t"><i class="fas fa-list-check"></i> Checklist</span></div><div class="card-body" style="padding:0;">
            @if (Model.ChecklistItems.Any())
            {
                <table class="tbl"><thead><tr><th>Clause</th><th>Question</th><th>Result</th></tr></thead><tbody>
                    @foreach (var c in Model.ChecklistItems.OrderBy(c => c.Sequence))
                    {
                        <tr>
                            <td class="meta">@(c.ClauseReference ?? "—")</td>
                            <td>@c.Question</td>
                            <td>
                                @if (canEdit)
                                {
                                    <form method="post" asp-action="SetChecklistResult" asp-route-id="@Model.Id" style="display:flex;gap:.3rem;">@Html.AntiForgeryToken()
                                        <input type="hidden" name="itemId" value="@c.Id" />
                                        <select class="inp" name="result" style="width:auto;padding:.3rem;" onchange="this.form.submit()">
                                            @foreach (ChecklistResult r in Enum.GetValues(typeof(ChecklistResult))) { <option value="@r" selected="@(c.Result == r)">@r</option> }
                                        </select>
                                    </form>
                                }
                                else { <span class="badge-ims @ChkClass(c.Result)">@c.Result</span> }
                            </td>
                        </tr>
                    }
                </tbody></table>
            }
            else { <div class="empty" style="padding:1.5rem;"><i class="fas fa-list-check"></i><h3>No checklist items</h3></div> }
            @if (canEdit)
            {
                <form method="post" asp-action="AddChecklistItem" asp-route-id="@Model.Id" style="padding:1rem;border-top:1px solid var(--gray-200);display:flex;gap:.4rem;flex-wrap:wrap;">@Html.AntiForgeryToken()
                    <input class="inp" name="clauseReference" placeholder="Clause" style="width:90px;" />
                    <input class="inp" name="question" placeholder="Checklist question" style="flex:1;min-width:160px;" required />
                    <button class="btn-ghost-ims" type="submit"><i class="fas fa-plus"></i></button>
                </form>
            }
        </div></div>
    </div>

    @* Findings *@
    <div class="card"><div class="card-head"><span class="t"><i class="fas fa-magnifying-glass"></i> Findings</span></div><div class="card-body" style="padding:0;">
        @if (Model.Findings.Any())
        {
            <table class="tbl"><thead><tr><th>Ref</th><th>Type</th><th>Clause</th><th>Description</th><th>Status</th></tr></thead><tbody>
                @foreach (var f in Model.Findings)
                {
                    <tr>
                        <td><a asp-action="FindingDetails" asp-route-id="@f.Id"><span class="docnum">@f.Reference</span></a></td>
                        <td><span class="badge-ims @FindClass(f.Type)">@f.Type</span></td>
                        <td class="meta">@(f.ClauseReference ?? "—")</td>
                        <td>@f.Description</td>
                        <td class="meta">@f.Status</td>
                    </tr>
                }
            </tbody></table>
        }
        else { <div class="empty" style="padding:1.5rem;"><i class="fas fa-clipboard"></i><h3>No findings raised</h3></div> }
        @if (canFinding)
        {
            <form method="post" asp-action="AddFinding" asp-route-id="@Model.Id" style="padding:1rem;border-top:1px solid var(--gray-200);">@Html.AntiForgeryToken()
                <div class="form-grid">
                    <div class="fg"><label class="lbl">Type</label><select class="inp" name="Type" asp-items="Html.GetEnumSelectList<FindingType>()"></select></div>
                    <div class="fg"><label class="lbl">Clause</label><input class="inp" name="ClauseReference" placeholder="e.g. 8.5" /></div>
                    <div class="fg"><label class="lbl">Department</label><select class="inp" name="DepartmentId"><option value="">— None —</option>@foreach (var d in departments) { <option value="@d.Id">@d.Name</option> }</select></div>
                    <div class="fg"><label class="lbl">Assign To</label><select class="inp" name="AssignedToId"><option value="">— None —</option>@foreach (var u in users) { <option value="@u.Id">@u.FullName</option> }</select></div>
                    <div class="fg"><label class="lbl">Due Date</label><input class="inp" type="date" name="DueDate" /></div>
                    <div class="fg full"><label class="lbl">Description <span class="req">*</span></label><textarea class="inp" name="Description" rows="2" required></textarea></div>
                    <div class="fg full"><label class="lbl">Evidence</label><textarea class="inp" name="Evidence" rows="2"></textarea></div>
                </div>
                <div class="form-actions"><button class="btn-primary-ims" type="submit"><i class="fas fa-plus"></i> Raise Finding</button></div>
            </form>
        }
    </div></div>
</div></div>
