@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model Audit
@{
    ViewData["Title"] = Model.Reference;
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
    var canFinding = (bool)(ViewBag.CanRaiseFinding ?? false);
    var users = ViewBag.Users as List<User> ?? new();
    var departments = ViewBag.Departments as List<Department> ?? new();
    string StatusClass(AuditStatus s) => s switch { AuditStatus.Completed or AuditStatus.Closed => "badge-success", AuditStatus.InProgress => "badge-warning", AuditStatus.Cancelled => "badge-critical", _ => "badge-gray" };
    string FindClass(FindingType t) => t switch { FindingType.MajorNonConformance => "badge-critical", FindingType.MinorNonConformance => "badge-warning", FindingType.OpportunityForImprovement => "badge-primary", FindingType.Conformity => "badge-success", _ => "badge-gray" };
    string ChkClass(ChecklistResult r) => r switch { ChecklistResult.Conform => "badge-success", ChecklistResult.NonConform => "badge-critical", ChecklistResult.NotApplicable => "badge-gray", _ => "badge-warning" };
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a class="btn-back" asp-action="Index">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <span class="doc-number" style="font-size:1rem;font-weight:600;color:var(--primary);">@Model.Reference</span>
                        <span style="font-weight:700;color:var(--gray-800);">@Model.Title</span>
                    </h1>
                    <div class="page-subtitle">
                        <span class="status-badge @StatusClass(Model.Status)">@Model.Status</span>
                        <span class="meta-separator">·</span>
                        <span class="meta-text">@Model.Type · @Model.Standard</span>
                    </div>
                </div>
            </div>
            @if (canEdit)
            {
                <a class="btn-create-ticket" asp-action="Edit" asp-route-id="@Model.Id" style="background:var(--gray-100);color:var(--gray-700);">
                    <i class="fas fa-pen"></i> Edit
                </a>
            }
        </div>
    </div>

    <!-- OVERVIEW CARD -->
    <div class="data-card">
        <div class="card-body-custom">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">Lead Auditor</div>
                    <div class="detail-value">@(Model.LeadAuditor?.FullName ?? "—")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Department</div>
                    <div class="detail-value">@(Model.Department?.Name ?? "—")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Planned</div>
                    <div class="detail-value">@(Model.PlannedStartDate?.ToString("dd MMM") ?? "—") – @(Model.PlannedEndDate?.ToString("dd MMM yyyy") ?? "—")</div>
                </div>
                <div class="detail-item">
                    <div class="detail-label">Programme</div>
                    <div class="detail-value">@(Model.AuditProgramme != null ? $"{Model.AuditProgramme.Year} — {Model.AuditProgramme.Title}" : "—")</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Scope))
            {
                <div class="description-section">
                    <div class="detail-label">Scope</div>
                    <div class="description-text">@Model.Scope</div>
                </div>
            }
        </div>
    </div>

    <!-- TWO COLUMN GRID: Team & Checklist -->
    <div class="two-col-grid">
        <!-- AUDIT TEAM -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-users me-2" style="color: var(--primary);"></i>
                <span>Audit Team</span>
            </div>
            <div class="card-body-custom">
                @if (Model.TeamMembers.Any())
                {
                    <div class="team-list">
                        @foreach (var t in Model.TeamMembers)
                        {
                            <div class="team-member">
                                <span class="team-member-name">@(t.User?.FullName ?? "—")</span>
                                <span class="team-member-role">@t.RoleOnTeam</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-users"></i>
                        <span>No team members yet.</span>
                    </div>
                }

                @if (canEdit)
                {
                    <form method="post" asp-action="AddTeamMember" asp-route-id="@Model.Id" class="team-form">
                        @Html.AntiForgeryToken()
                        <div class="team-form-row">
                            <select class="form-control" name="userId" style="flex:1;min-width:140px;">
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </select>
                            <select class="form-control" name="roleOnTeam" style="width:auto;" asp-items="Html.GetEnumSelectList<AuditTeamRole>()"></select>
                            <button class="btn-add-team" type="submit">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <!-- CHECKLIST -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-list-check me-2" style="color: var(--primary);"></i>
                <span>Checklist</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.ChecklistItems.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-list-ol me-1"></i> Clause</th>
                                    <th><i class="fas fa-question me-1"></i> Question</th>
                                    <th><i class="fas fa-check me-1"></i> Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.ChecklistItems.OrderBy(c => c.Sequence))
                                {
                                    <tr>
                                        <td class="meta-text">@(c.ClauseReference ?? "—")</td>
                                        <td>@c.Question</td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <form method="post" asp-action="SetChecklistResult" asp-route-id="@Model.Id" style="display:flex;gap:0.3rem;align-items:center;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="itemId" value="@c.Id" />
                                                    <select class="form-control" name="result" style="width:auto;padding:0.3rem;font-size:0.75rem;" onchange="this.form.submit()">
                                                        @foreach (ChecklistResult r in Enum.GetValues(typeof(ChecklistResult)))
                                                        {
                                                            <option value="@r" selected="@(c.Result == r)">@r</option>
                                                        }
                                                    </select>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="status-badge @ChkClass(c.Result)">@c.Result</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-list-check"></i>
                        <span>No checklist items</span>
                    </div>
                }

                @if (canEdit)
                {
                    <form method="post" asp-action="AddChecklistItem" asp-route-id="@Model.Id" class="checklist-form">
                        @Html.AntiForgeryToken()
                        <div class="checklist-form-row">
                            <input class="form-control" name="clauseReference" placeholder="Clause" style="width:100px;" />
                            <input class="form-control" name="question" placeholder="Checklist question" style="flex:1;min-width:160px;" required />
                            <button class="btn-add-checklist" type="submit">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- FINDINGS -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-magnifying-glass me-2" style="color: var(--primary);"></i>
            <span>Findings</span>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Findings.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-hashtag me-1"></i> Ref</th>
                                <th><i class="fas fa-tag me-1"></i> Type</th>
                                <th><i class="fas fa-list-ol me-1"></i> Clause</th>
                                <th><i class="fas fa-align-left me-1"></i> Description</th>
                                <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.Findings)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="FindingDetails" asp-route-id="@f.Id" class="finding-link">
                                            <span class="doc-number">@f.Reference</span>
                                        </a>
                                    </td>
                                    <td><span class="status-badge @FindClass(f.Type)">@f.Type</span></td>
                                    <td class="meta-text">@(f.ClauseReference ?? "—")</td>
                                    <td class="finding-description">@f.Description</td>
                                    <td class="meta-text">@f.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-clipboard"></i>
                    <span>No findings raised</span>
                </div>
            }

            @if (canFinding)
            {
                <form method="post" asp-action="AddFinding" asp-route-id="@Model.Id" class="finding-form">
                    @Html.AntiForgeryToken()
                    <div class="finding-form-grid">
                        <div class="finding-form-group">
                            <label class="form-label-sm">Type</label>
                            <select class="form-control" name="Type" asp-items="Html.GetEnumSelectList<FindingType>()"></select>
                        </div>
                        <div class="finding-form-group">
                            <label class="form-label-sm">Clause</label>
                            <input class="form-control" name="ClauseReference" placeholder="e.g. 8.5" />
                        </div>
                        <div class="finding-form-group">
                            <label class="form-label-sm">Department</label>
                            <select class="form-control" name="DepartmentId">
                                <option value="">— None —</option>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="finding-form-group">
                            <label class="form-label-sm">Assign To</label>
                            <select class="form-control" name="AssignedToId">
                                <option value="">— None —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="finding-form-group">
                            <label class="form-label-sm">Due Date</label>
                            <input class="form-control" type="date" name="DueDate" />
                        </div>
                        <div class="finding-form-group full-width">
                            <label class="form-label-sm">Description <span class="required">*</span></label>
                            <textarea class="form-control" name="Description" rows="2" required placeholder="Describe the finding..."></textarea>
                        </div>
                        <div class="finding-form-group full-width">
                            <label class="form-label-sm">Evidence</label>
                            <textarea class="form-control" name="Evidence" rows="2" placeholder="Supporting evidence..."></textarea>
                        </div>
                    </div>
                    <div class="finding-form-actions">
                        <button class="btn-create-ticket-sm" type="submit">
                            <i class="fas fa-plus"></i> Raise Finding
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .doc-number {
        font-weight: 600;
        color: var(--primary);
        font-size: 1rem;
    }

    .page-subtitle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    .meta-separator {
        color: var(--gray-300);
    }

    .meta-text {
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-create-ticket-sm {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.4rem 1rem;
        border-radius: 0.5rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
        font-size: 0.8rem;
        font-family: inherit;
    }

        .btn-create-ticket-sm:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== DETAILS GRID ===== */
    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        gap: 1rem 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .detail-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-400);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .detail-value {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--gray-700);
    }

    .description-section {
        padding-top: 1rem;
        border-top: 1px solid var(--gray-200);
        margin-top: 1rem;
    }

    .description-text {
        font-size: 0.9rem;
        color: var(--gray-700);
        line-height: 1.6;
        margin-top: 0.3rem;
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* ===== TEAM ===== */
    .team-list {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .team-member {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.4rem 0.6rem;
        background: var(--gray-50);
        border-radius: 0.5rem;
        border: 1px solid var(--gray-200);
    }

    .team-member-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    .team-member-role {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-500);
        background: var(--gray-100);
        padding: 0.1rem 0.5rem;
        border-radius: 1rem;
        border: 1px solid var(--gray-200);
    }

    .team-form {
        margin-top: 0.75rem;
    }

    .team-form-row {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-add-team {
        background: var(--gray-100);
        color: var(--primary);
        border: 1px solid var(--gray-200);
        border-radius: 0.5rem;
        padding: 0.4rem 0.7rem;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.8rem;
    }

        .btn-add-team:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

    /* ===== CHECKLIST ===== */
    .checklist-form {
        padding: 1rem;
        border-top: 1px solid var(--gray-200);
    }

    .checklist-form-row {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .btn-add-checklist {
        background: var(--gray-100);
        color: var(--primary);
        border: 1px solid var(--gray-200);
        border-radius: 0.5rem;
        padding: 0.4rem 0.7rem;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.8rem;
    }

        .btn-add-checklist:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

    /* ===== FINDINGS ===== */
    .finding-link {
        text-decoration: none;
        transition: color 0.2s;
    }

        .finding-link:hover {
            text-decoration: none;
        }

            .finding-link:hover .doc-number {
                color: var(--primary-dark);
            }

    .finding-description {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--gray-600);
    }

    .finding-form {
        padding: 1rem;
        border-top: 1px solid var(--gray-200);
    }

    .finding-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem 1rem;
    }

    .finding-form-group.full-width {
        grid-column: 1 / -1;
    }

    .finding-form-group {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .form-label-sm {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

        .form-label-sm .required {
            color: var(--danger);
        }

    .finding-form-actions {
        margin-top: 1rem;
        display: flex;
        justify-content: flex-end;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-critical {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    .badge-primary {
        background: #e6f0ff;
        color: var(--info);
        border: 1px solid #cce4ff;
    }

    /* ===== EMPTY STATE MINI ===== */
    .empty-state-mini {
        text-align: center;
        padding: 1.5rem;
        color: var(--gray-500);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .empty-state-mini i {
            font-size: 1.5rem;
            color: var(--gray-300);
        }

        .empty-state-mini span {
            font-size: 0.9rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .two-col-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .details-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }

        .finding-form-grid {
            grid-template-columns: 1fr;
        }

        .finding-form-group.full-width {
            grid-column: 1;
        }

        .finding-form-actions {
            justify-content: stretch;
        }

            .finding-form-actions .btn-create-ticket-sm {
                width: 100%;
                justify-content: center;
            }

        .team-form-row {
