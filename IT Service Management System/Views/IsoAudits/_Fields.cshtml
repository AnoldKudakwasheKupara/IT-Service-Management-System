@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model Audit
@{
    var users = ViewBag.Users as List<User> ?? new();
    var departments = ViewBag.Departments as List<Department> ?? new();
    var programmes = ViewBag.Programmes as List<AuditProgramme> ?? new();
    var isEdit = (bool)(ViewData["IsEdit"] ?? false);
}
<div class="form-grid">
    <div class="fg full">
        <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
        <input class="inp" asp-for="Title" required />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-layer-group"></i> Type</label>
        <select class="inp" asp-for="Type" asp-items="Html.GetEnumSelectList<AuditType>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
        <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar"></i> Programme</label>
        <select class="inp" asp-for="AuditProgrammeId"><option value="">— None —</option>
            @foreach (var p in programmes) { <option value="@p.Id" selected="@(Model.AuditProgrammeId == p.Id)">@p.Year — @p.Title</option> }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-building"></i> Department / Area</label>
        <select class="inp" asp-for="DepartmentId"><option value="">— None —</option>
            @foreach (var d in departments) { <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option> }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-user-tie"></i> Lead Auditor</label>
        <select class="inp" asp-for="LeadAuditorId"><option value="">— None —</option>
            @foreach (var u in users) { <option value="@u.Id" selected="@(Model.LeadAuditorId == u.Id)">@u.FullName</option> }
        </select>
    </div>
    @if (isEdit)
    {
        <div class="fg">
            <label class="lbl"><i class="fas fa-flag"></i> Status</label>
            <select class="inp" asp-for="Status" asp-items="Html.GetEnumSelectList<AuditStatus>()"></select>
        </div>
    }
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-plus"></i> Planned Start</label>
        <input class="inp" type="date" asp-for="PlannedStartDate" />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-check"></i> Planned End</label>
        <input class="inp" type="date" asp-for="PlannedEndDate" />
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-crop"></i> Scope</label>
        <textarea class="inp" asp-for="Scope" rows="2"></textarea>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-bullseye"></i> Objectives</label>
        <textarea class="inp" asp-for="Objectives" rows="2"></textarea>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-ruler"></i> Criteria</label>
        <textarea class="inp" asp-for="Criteria" rows="2"></textarea>
    </div>
    @if (isEdit)
    {
        <div class="fg full">
            <label class="lbl"><i class="fas fa-file-lines"></i> Summary</label>
            <textarea class="inp" asp-for="Summary" rows="2"></textarea>
        </div>
        <div class="fg full">
            <label class="lbl"><i class="fas fa-flag-checkered"></i> Conclusion</label>
            <textarea class="inp" asp-for="Conclusion" rows="2"></textarea>
        </div>
    }
</div>
