@using IT_Service_Management_System.Models.Ims
@model AuditProgramme
@{ ViewData["Title"] = "New Audit Programme"; }
<partial name="_ImsStyles" />
<div class="ims narrow"><div class="page-container">
    <div class="page-header"><div class="head-row"><div style="display:flex;gap:1rem;align-items:center;">
        <a class="btn-back" asp-action="Programmes"><i class="fas fa-arrow-left"></i></a>
        <div><h1 class="page-title"><i class="fas fa-calendar-plus"></i> New Audit Programme</h1></div>
    </div></div></div>
    <form method="post" asp-action="CreateProgramme">@Html.AntiForgeryToken()
        <div class="card"><div class="card-body">
            <div class="form-grid">
                <div class="fg"><label class="lbl"><i class="fas fa-calendar"></i> Year <span class="req">*</span></label><input class="inp" type="number" asp-for="Year" required /></div>
                <div class="fg"><label class="lbl"><i class="fas fa-certificate"></i> Standard</label><select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select></div>
                <div class="fg full"><label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label><input class="inp" asp-for="Title" required /></div>
                <div class="fg full"><label class="lbl"><i class="fas fa-bullseye"></i> Objectives</label><textarea class="inp" asp-for="Objectives" rows="3"></textarea></div>
            </div>
            <div class="form-actions"><button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Create</button><a class="btn-ghost-ims" asp-action="Programmes">Cancel</a></div>
        </div></div>
    </form>
</div></div>
