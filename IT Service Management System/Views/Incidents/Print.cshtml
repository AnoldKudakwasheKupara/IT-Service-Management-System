@using IT_Service_Management_System.Models.Ims
@model Incident
@{
    Layout = null;
    string YesNo(bool? v) => v == true ? "Yes" : v == false ? "No" : "N/A";
    string Mark(bool b) => b ? "X" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Reference — Incident Investigation Report</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #1a1a1a; font-size: 12px; line-height: 1.45; margin: 0; padding: 24px; background: #fff; }
        .sheet { max-width: 900px; margin: 0 auto; }
        .doc-head { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 3px solid #2563eb; padding-bottom: 10px; margin-bottom: 4px; }
        .doc-head h1 { font-size: 18px; margin: 0; color: #1e293b; }
        .doc-head .meta { text-align: right; font-size: 11px; color: #475569; }
        .doc-head .ref { font-family: 'Consolas', monospace; font-weight: 700; color: #2563eb; font-size: 14px; }
        .toolbar { text-align: right; margin-bottom: 12px; }
        .toolbar button { font-size: 12px; padding: 6px 14px; border: 1px solid #2563eb; background: #2563eb; color: #fff; border-radius: 6px; cursor: pointer; }
        .sec { margin-top: 14px; }
        .sec-title { background: #eef2ff; border-left: 4px solid #2563eb; padding: 5px 10px; font-weight: 700; font-size: 12px; color: #1e293b; }
        table { width: 100%; border-collapse: collapse; margin-top: 4px; }
        th, td { border: 1px solid #cbd5e1; padding: 6px 8px; text-align: left; vertical-align: top; font-size: 11.5px; }
        th { background: #f1f5f9; font-weight: 600; }
        .kv td:nth-child(odd) { background: #f8fafc; font-weight: 600; width: 20%; }
        .narrative { white-space: pre-wrap; min-height: 40px; }
        .chk td { text-align: center; width: 6%; font-weight: 700; }
        .chk td.lbl { text-align: left; width: 44%; font-weight: 400; }
        .sign { height: 46px; }
        @@media print { .toolbar { display: none; } body { padding: 0; } .sec { page-break-inside: avoid; } }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="toolbar"><button onclick="window.print()">🖨 Print / Save as PDF</button></div>

        <div class="doc-head">
            <div>
                <h1>Incident Investigation Report</h1>
                <div style="font-size:11px;color:#475569;">Axis Solutions — Integrated Management System (ISO 9001 &amp; ISO/IEC 27001)</div>
            </div>
            <div class="meta">
                <div class="ref">@Model.Reference</div>
                <div>Status: @Model.Status</div>
                <div>Severity: @Model.Severity</div>
            </div>
        </div>
        <h2 style="font-size:14px;margin:8px 0;">@Model.Title</h2>

        <!-- A -->
        <div class="sec">
            <div class="sec-title">Section A — Incident Details</div>
            <table class="kv">
                <tr><td>Date of Incident</td><td>@(Model.DateOfIncident?.ToString("dd/MM/yyyy") ?? "")</td><td>Location</td><td>@Model.LocationOfIncident</td></tr>
                <tr><td>Time of Incident</td><td>@Model.TimeOfIncident</td><td>Function</td><td>@Model.Department?.Name</td></tr>
                <tr><td>Reported By</td><td>@Model.ReportedByName</td><td>Date Reported</td><td>@(Model.DateReported?.ToString("dd/MM/yyyy") ?? "")</td></tr>
            </table>
        </div>

        <!-- B -->
        <div class="sec">
            <div class="sec-title">Section B — Brief Description of Incident</div>
            <table><tr><td class="narrative">@Model.BriefDescription</td></tr></table>
        </div>

        <!-- C police -->
        <div class="sec">
            <div class="sec-title">Section C — Police Report</div>
            <table class="kv">
                <tr><td>Reported to Police?</td><td>@YesNo(Model.ReportedToPolice)</td><td>Case Number</td><td>@Model.CaseNumber</td></tr>
                <tr><td>Reported to Police at</td><td>@Model.ReportedToPoliceAt</td><td>Police details &amp; Tel</td><td>@Model.PoliceDetailsTel</td></tr>
                @{
                    var police = Model.Attachments.Where(a => a.Kind == IncidentAttachmentKind.PoliceReport).ToList();
                }
                <tr><td>Police report attached</td><td colspan="3">@(police.Any() ? string.Join(", ", police.Select(p => p.OriginalFileName)) : "—")</td></tr>
            </table>
        </div>

        @{
            var supporting = Model.Attachments.Where(a => a.Kind == IncidentAttachmentKind.Supporting).ToList();
        }
        @if (Model.Attachments.Any())
        {
            <div class="sec">
                <div class="sec-title">Attachments</div>
                <table>
                    <tr><th>File</th><th>Type</th><th>Uploaded</th></tr>
                    @foreach (var a in Model.Attachments)
                    {
                        var kindLabel = a.Kind == IncidentAttachmentKind.PoliceReport ? "Police Report"
                            : (string.IsNullOrEmpty(a.Category) ? "Supporting" : a.Category);
                        <tr><td>@a.OriginalFileName</td><td>@kindLabel</td><td>@a.UploadedAt.ToString("dd/MM/yyyy")</td></tr>
                    }
                </table>
            </div>
        }

        <!-- C team -->
        <div class="sec">
            <div class="sec-title">Section C — Investigation Team</div>
            <table>
                <tr><th>Name</th><th>Position / Title</th><th>Date of Investigation</th></tr>
                @if (!Model.Investigators.Any()) { <tr><td colspan="3">&nbsp;</td></tr> }
                @foreach (var m in Model.Investigators)
                {
                    <tr><td>@m.Name</td><td>@m.Position</td><td>@(m.InvestigationDate?.ToString("dd/MM/yyyy") ?? "")</td></tr>
                }
            </table>
        </div>

        <!-- D -->
        <div class="sec">
            <div class="sec-title">Section D — Detailed Description / Sequence of Events</div>
            <table><tr><td class="narrative">@Model.DetailedDescription</td></tr></table>
            <table class="kv" style="margin-top:6px;">
                <tr><td>Evidence — People</td><td>@Model.EvidencePeople</td><td>Evidence — Paper</td><td>@Model.EvidencePaper</td></tr>
                <tr><td>Evidence — Parts</td><td>@Model.EvidenceParts</td><td>Evidence — Positions</td><td>@Model.EvidencePositions</td></tr>
            </table>
        </div>

        <!-- E -->
        <div class="sec">
            <div class="sec-title">Section E — Classification</div>
            <table class="kv">
                <tr><td>Incident category</td><td colspan="3">@Model.Category</td></tr>
                <tr><td>Severity</td><td>@Model.Severity</td><td>Probability</td><td>@Model.Probability</td></tr>
                <tr><td>Status of investigation report</td><td colspan="3">@Model.ReportStatus</td></tr>
            </table>
        </div>

        <!-- F -->
        <div class="sec">
            <div class="sec-title">Section F — Supporting Documents</div>
            <table class="chk">
                <tr><td>@Mark(Model.DocPollutionReport)</td><td class="lbl">Pollution Report</td><td>@Mark(Model.DocSketchDiagram)</td><td class="lbl">Sketch Diagram</td></tr>
                <tr><td>@Mark(Model.DocWrittenStatements)</td><td class="lbl">Written Statements</td><td>@Mark(Model.DocMotorInsurance)</td><td class="lbl">Motor Insurance Details</td></tr>
                <tr><td>@Mark(Model.DocDeptOfLabour)</td><td class="lbl">Dept of Labour</td><td>@Mark(Model.DocDriversDetails)</td><td class="lbl">Driver's Details</td></tr>
                <tr><td>@Mark(Model.DocInternalAudit)</td><td class="lbl">Internal Audit</td><td>@Mark(Model.DocWorkmenCompensation)</td><td class="lbl">Workmen Compensation</td></tr>
                <tr><td>@Mark(Model.DocOther)</td><td class="lbl" colspan="3">Other: @Model.DocOtherText</td></tr>
            </table>
        </div>

        <!-- G -->
        <div class="sec">
            <div class="sec-title">Section G — Damage</div>
            <table>
                <tr><th>Type of Damage</th><th>Description</th><th>Damage Payer</th><th>Cost (USD)</th></tr>
                @if (!Model.Damages.Any()) { <tr><td colspan="4">&nbsp;</td></tr> }
                @foreach (var d in Model.Damages)
                {
                    <tr><td>@d.Type</td><td>@d.Description</td><td>@d.Payer</td><td>@d.Cost</td></tr>
                }
            </table>
        </div>

        <!-- H -->
        <div class="sec">
            <div class="sec-title">Section H — Preventability &amp; Claim</div>
            <table class="kv">
                <tr><td>Was the incident preventable?</td><td>@YesNo(Model.Preventable)</td><td>Notes</td><td>@Model.PreventableNotes</td></tr>
                <tr><td>Is the incident claimable?</td><td>@YesNo(Model.Claimable)</td><td>Claimed from insurance/party?</td><td>@YesNo(Model.ClaimedFromInsurance)</td></tr>
            </table>
        </div>

        <!-- I -->
        <div class="sec">
            <div class="sec-title">Section I — Critical Factors Identified</div>
            <table><tr><td class="narrative">@Model.CriticalFactors</td></tr></table>
        </div>

        <!-- J -->
        <div class="sec">
            <div class="sec-title">Section J — Root Cause Analysis</div>
            <table>
                <tr><th style="width:50%;">Immediate Cause(s)</th><th>Basic Cause(s)</th></tr>
                <tr><td class="narrative">@Model.ImmediateCause</td><td class="narrative">@Model.BasicCause</td></tr>
                <tr><th colspan="2">Root Cause</th></tr>
                <tr><td class="narrative" colspan="2">@Model.RootCause</td></tr>
            </table>
        </div>

        <!-- K -->
        <div class="sec">
            <div class="sec-title">Section K — Recommended Remedial Actions</div>
            <table>
                <tr><th>Action</th><th>Responsible Person</th><th>Planned Date</th><th>Status</th></tr>
                @if (!Model.Actions.Any()) { <tr><td colspan="4">&nbsp;</td></tr> }
                @foreach (var a in Model.Actions)
                {
                    <tr><td>@a.Description</td><td>@a.ResponsiblePerson</td><td>@(a.PlannedDate?.ToString("dd/MM/yyyy") ?? "")</td><td>@a.Status</td></tr>
                }
            </table>
        </div>

        <!-- L -->
        <div class="sec">
            <div class="sec-title">Section L — Lessons Learned</div>
            <table><tr><td class="narrative">@Model.LessonsLearned</td></tr></table>
        </div>

        <!-- M/N/O -->
        <div class="sec">
            <div class="sec-title">Section M — Department Manager / Team Leader Comments</div>
            <table><tr><td class="narrative sign">@Model.DeptManagerComments</td></tr>
                <tr><td>Date: @(Model.DeptManagerCommentDate?.ToString("dd/MM/yyyy") ?? "……………") &nbsp;&nbsp; Signature: ………………………</td></tr></table>
        </div>
        <div class="sec">
            <div class="sec-title">Section N — Quality Assurance Comments</div>
            <table><tr><td class="narrative sign">@Model.QaComments</td></tr>
                <tr><td>Date: @(Model.QaCommentDate?.ToString("dd/MM/yyyy") ?? "……………") &nbsp;&nbsp; Signature: ………………………</td></tr></table>
        </div>
        <div class="sec">
            <div class="sec-title">Section O — General Manager Comments (major incidents only)</div>
            <table><tr><td class="narrative sign">@Model.GmComments</td></tr>
                <tr><td>Date: @(Model.GmCommentDate?.ToString("dd/MM/yyyy") ?? "……………") &nbsp;&nbsp; Signature: ………………………</td></tr></table>
        </div>
    </div>
</body>
</html>
