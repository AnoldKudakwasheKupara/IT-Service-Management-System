@using IT_Service_Management_System.Models.Ims
@model List<Incident>
@{
    ViewData["Title"] = "Incident Register";
    var canManage = (bool)(ViewBag.CanManage ?? false);

    string SevBadge(IncidentSeverity s) => s switch
    {
        IncidentSeverity.Major => "b-red",
        IncidentSeverity.Serious => "b-amber",
        _ => "b-gray"
    };
    string StatusBadge(IncidentStatus s) => s switch
    {
        IncidentStatus.Closed => "b-green",
        IncidentStatus.ActionsPending => "b-amber",
        IncidentStatus.UnderInvestigation => "b-blue",
        _ => "b-gray"
    };
    string StatusText(IncidentStatus s) => s switch
    {
        IncidentStatus.UnderInvestigation => "Under Investigation",
        IncidentStatus.ActionsPending => "Actions Pending",
        _ => s.ToString()
    };
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-2" style="flex-wrap:wrap;gap:1rem;">
            <div>
                <h1 class="page-title"><i class="fas fa-triangle-exclamation me-2" style="color: var(--primary);"></i> Incident Register</h1>
                <p class="page-subtitle">Incident investigation reports across the management system (ISO 9001 / 27001 · Improvement).</p>
            </div>
            @if (canManage)
            {
                <a asp-action="Create" class="btn-primary-cta"><i class="fas fa-plus"></i> Log Incident</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="flash success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flash danger"><i class="fas fa-exclamation-circle"></i> @TempData["Error"]</div>
    }

    <!-- STATS -->
    <div class="stats-cards">
        <a class="stat-card" asp-action="Index">
            <div class="stat-icon" style="background: linear-gradient(135deg, #60a5fa, #3b82f6);"><i class="fas fa-layer-group"></i></div>
            <div class="stat-info"><h3>@ViewBag.Total</h3><p>Total Incidents</p></div>
        </a>
        <a class="stat-card" asp-action="Index" asp-route-status="@IncidentStatus.UnderInvestigation">
            <div class="stat-icon" style="background: linear-gradient(135deg, #38bdf8, #0ea5e9);"><i class="fas fa-magnifying-glass"></i></div>
            <div class="stat-info"><h3>@ViewBag.UnderInvestigation</h3><p>Under Investigation</p></div>
        </a>
        <a class="stat-card" asp-action="Index" asp-route-severity="@IncidentSeverity.Major">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f87171, #e53e3e);"><i class="fas fa-fire"></i></div>
            <div class="stat-info"><h3>@ViewBag.Major</h3><p>Open · Major</p></div>
        </a>
        <a class="stat-card" asp-action="Index" asp-route-status="@IncidentStatus.Closed">
            <div class="stat-icon" style="background: linear-gradient(135deg, #34d399, #2c9e6e);"><i class="fas fa-circle-check"></i></div>
            <div class="stat-info"><h3>@ViewBag.Closed</h3><p>Closed</p></div>
        </a>
    </div>

    <!-- FILTERS -->
    <div class="filters-card">
        <form method="get" asp-action="Index" class="filters-body">
            <div class="form-group">
                <label class="form-label"><i class="fas fa-search"></i> Search</label>
                <input type="text" name="q" value="@ViewBag.Q" class="form-control" placeholder="Title, reporter, category, location…" />
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fas fa-chart-simple"></i> Status</label>
                <select name="status" class="form-control">
                    <option value="">All statuses</option>
                    @foreach (IncidentStatus s in Enum.GetValues(typeof(IncidentStatus)))
                    {
                        <option value="@s" selected="@(ViewBag.Status as IncidentStatus? == s)">@StatusText(s)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fas fa-triangle-exclamation"></i> Severity</label>
                <select name="severity" class="form-control">
                    <option value="">All severities</option>
                    @foreach (IncidentSeverity s in Enum.GetValues(typeof(IncidentSeverity)))
                    {
                        <option value="@s" selected="@(ViewBag.Severity as IncidentSeverity? == s)">@s</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-primary-cta" style="flex:0;"><i class="fas fa-filter"></i> Apply</button>
            <a asp-action="Index" class="btn-soft"><i class="fas fa-undo-alt"></i> Clear</a>
        </form>
    </div>

    <!-- TABLE -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-list" style="color: var(--primary);"></i>
            <span>Incidents</span>
            <span class="header-tag">@Model.Count shown</span>
        </div>
        <div class="table-wrap">
            @if (Model.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Ref</th>
                            <th>Incident</th>
                            <th>Category</th>
                            <th>Severity</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th style="text-align:right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td><span class="ref-chip">@i.Reference</span></td>
                                <td>
                                    <a class="row-link" asp-action="Details" asp-route-id="@i.Id">@i.Title</a>
                                    <div style="font-size:0.72rem;color:var(--gray-400);">
                                        @(i.Department?.Name ?? "—")@(string.IsNullOrEmpty(i.ReportedByName) ? "" : $" · {i.ReportedByName}")
                                    </div>
                                </td>
                                <td>@(string.IsNullOrEmpty(i.Category) ? "—" : i.Category)</td>
                                <td><span class="badge-pill @SevBadge(i.Severity)">@i.Severity</span></td>
                                <td><span class="badge-pill @StatusBadge(i.Status)">@StatusText(i.Status)</span></td>
                                <td>@(i.DateOfIncident?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td style="text-align:right;">
                                    <a class="btn-soft btn-sm" asp-action="Details" asp-route-id="@i.Id"><i class="fas fa-eye"></i> Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-triangle-exclamation"></i>
                    <h3>No incidents found</h3>
                    <p>@(canManage ? "Log the first incident to start the register." : "No incidents match your filters.")</p>
                    @if (canManage)
                    {
                        <a asp-action="Create" class="btn-primary-cta" style="margin-top:1rem;display:inline-flex;"><i class="fas fa-plus"></i> Log Incident</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<partial name="_IncidentStyles" />
