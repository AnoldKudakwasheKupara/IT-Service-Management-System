    <span class="section-letter">E</span>
    <div class="section-title">
        <h3>Classification</h3>
    </div>
</div>

<div class="form-grid">
    <div class="form-group">
        <label asp-for="Category" class="form-label">
            <i class="fas fa-tag"></i> Incident category
        </label>
        <input asp-for="Category" class="form-control" placeholder="e.g. Customer dissatisfaction" />
        <span asp-validation-for="Category" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Severity" class="form-label">
            <i class="fas fa-triangle-exclamation"></i> Severity
        </label>
        <select asp-for="Severity" class="form-control" asp-items="Html.GetEnumSelectList<IncidentSeverity>()"></select>
        <span asp-validation-for="Severity" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Probability" class="form-label">
            <i class="fas fa-dice"></i> Probability of occurrence
        </label>
        <select asp-for="Probability" class="form-control" asp-items="Html.GetEnumSelectList<IncidentProbability>()"></select>
        <span asp-validation-for="Probability" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReportStatus" class="form-label">
            <i class="fas fa-clipboard-list"></i> Status of investigation report
        </label>
        <select asp-for="ReportStatus" class="form-control" asp-items="Html.GetEnumSelectList<InvestigationReportStatus>()"></select>
        <span asp-validation-for="ReportStatus" class="validation-error"></span>
    </div>
</div>

<!-- ===== SECTION F: Supporting Documents ===== -->
<div class="section-divider">
    <span class="section-letter">F</span>
    <div class="section-title">
        <h3>Supporting Documents</h3>
        <span>· tick each attached, then upload the file(s)</span>
    </div>
</div>

