            <div class="file-upload-wrapper small">
                <input type="file" name="catfile_other" id="catfile_other" class="file-input" multiple accept="@fileAccept" />
                <label for="catfile_other" class="file-upload-label tiny">
                    <i class="fas fa-paperclip"></i> Attach files
