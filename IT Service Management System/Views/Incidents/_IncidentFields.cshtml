        </label>
        <div class="doc-file" data-for="catfile_driver">
            <div class="file-upload-wrapper small">
                <input type="file" name="catfile_driver" id="catfile_driver" class="file-input" multiple accept="@fileAccept" />
                <label for="catfile_driver" class="file-upload-label tiny">
                    <i class="fas fa-paperclip"></i> Attach files
                </label>
                <span class="file-names-display" id="driverFiles"></span>
