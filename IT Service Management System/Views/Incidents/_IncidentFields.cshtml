@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model Incident
@{
    var departments = ViewBag.Departments as List<Department> ?? new();
    const string fileAccept = ".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.txt,.csv,.msg,.eml";

    // Lists files already attached under a given category (shown on Edit so the user sees what's on file).
    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> onFile = (label) =>
    {
        var items = (Model.Attachments ?? new List<IncidentAttachment>()).Where(a => a.Category == label).ToList();
        if (items.Count == 0) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        var names = string.Join(", ", items.Select(a => System.Net.WebUtility.HtmlEncode(a.OriginalFileName)));
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class='field-hint' style='display:block;margin-top:.25rem;'><i class='fas fa-paperclip' style='color:var(--success);'></i> On file: {names}</span>");
    };
    // Renders "Yes / No" tri-state radios bound to a nullable bool property.
    Func<string, bool?, Microsoft.AspNetCore.Html.IHtmlContent> yesNo = (name, val) =>
    {
        var yes = val == true ? "checked" : "";
        var no = val == false ? "checked" : "";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $@"<div class='radio-line'>
                 <label class='radio-opt'><input type='radio' name='{name}' value='true' {yes}/> Yes</label>
                 <label class='radio-opt'><input type='radio' name='{name}' value='false' {no}/> No</label>
                 <label class='radio-opt'><input type='radio' name='{name}' value='' {(val == null ? "checked" : "")}/> N/A</label>
               </div>");
    };
}

<div asp-validation-summary="ModelOnly" class="flash danger" style="display:block;"></div>

<!-- SECTION A -->
<div class="section-band"><div class="section-letter">A</div><h3>Incident Details <span>· reported by</span></h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="Title" class="form-label"><i class="fas fa-heading"></i> Incident Title <span class="required">*</span></label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Dees Pharmacy customer dissatisfaction" required />
        <span asp-validation-for="Title" class="validation-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="DateOfIncident" class="form-label"><i class="fas fa-calendar-day"></i> Date of Incident</label>
        <input asp-for="DateOfIncident" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="TimeOfIncident" class="form-label"><i class="fas fa-clock"></i> Time of Incident</label>
        <input asp-for="TimeOfIncident" class="form-control" placeholder="e.g. 10:57 AM" />
    </div>
    <div class="form-group">
        <label asp-for="LocationOfIncident" class="form-label"><i class="fas fa-location-dot"></i> Location</label>
        <input asp-for="LocationOfIncident" class="form-control" placeholder="Where it occurred / was reported" />
    </div>
    <div class="form-group">
        <label asp-for="DepartmentId" class="form-label"><i class="fas fa-sitemap"></i> Function / Department</label>
        <select asp-for="DepartmentId" class="form-control">
            <option value="">— Select —</option>
            @foreach (var d in departments)
            {
                <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
            }
        </select>
    </div>
    <div class="form-group">
        <label asp-for="ReportedByName" class="form-label"><i class="fas fa-user"></i> Reported By</label>
        <input asp-for="ReportedByName" class="form-control" placeholder="Name of reporter" />
    </div>
    <div class="form-group">
        <label asp-for="DateReported" class="form-label"><i class="fas fa-calendar-check"></i> Date Reported</label>
        <input asp-for="DateReported" type="date" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Standard" class="form-label"><i class="fas fa-certificate"></i> ISO Standard</label>
        <select asp-for="Standard" class="form-control" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
    </div>
</div>

<!-- SECTION B -->
<div class="section-band"><div class="section-letter">B</div><h3>Brief Description</h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="BriefDescription" class="form-label"><i class="fas fa-align-left"></i> Brief description of incident</label>
        <textarea asp-for="BriefDescription" class="form-control" rows="5" placeholder="A short account of what happened, as reported."></textarea>
    </div>
</div>

<!-- SECTION C (police) -->
<div class="section-band"><div class="section-letter">C</div><h3>Police Report <span>· if applicable</span></h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group">
        <label class="form-label"><i class="fas fa-building-shield"></i> Reported to Police?</label>
        @yesNo("ReportedToPolice", Model.ReportedToPolice)
        <span asp-validation-for="ReportedToPolice" class="validation-error"></span>
    </div>
    <div class="form-group">
        <label asp-for="ReportedToPoliceAt" class="form-label"><i class="fas fa-location-dot"></i> Reported to Police at</label>
        <input asp-for="ReportedToPoliceAt" class="form-control" placeholder="Station / N/A" />
    </div>
    <div class="form-group">
        <label asp-for="CaseNumber" class="form-label"><i class="fas fa-hashtag"></i> Case Number</label>
        <input asp-for="CaseNumber" class="form-control" placeholder="N/A" />
    </div>
    <div class="form-group span-2">
        <label asp-for="PoliceDetailsTel" class="form-label"><i class="fas fa-phone"></i> Police details &amp; Tel</label>
        <input asp-for="PoliceDetailsTel" class="form-control" placeholder="N/A" />
    </div>
    <div class="form-group" id="policeReportRow">
        <label class="form-label" for="policeReport"><i class="fas fa-file-arrow-up"></i> Police Report <span class="required" id="policeReportReq" style="display:none;">*</span></label>
        <input type="file" name="policeReport" id="policeReport" class="form-control"
               accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
        <span class="field-hint" id="policeReportHint">Required when the incident was reported to the police (max 25 MB).</span>
    </div>
</div>
<script>
    (function () {
        function sync() {
            var yes = document.querySelector('input[name="ReportedToPolice"][value="true"]');
            var on = yes && yes.checked;
            var req = document.getElementById('policeReportReq');
            var input = document.getElementById('policeReport');
            if (req) req.style.display = on ? 'inline' : 'none';
            if (input) input.required = !!on;
        }
        document.querySelectorAll('input[name="ReportedToPolice"]').forEach(function (r) {
            r.addEventListener('change', sync);
        });
        sync();
    })();
</script>

<!-- SECTION D -->
<div class="section-band"><div class="section-letter">D</div><h3>Detailed Description &amp; Evidence <span>· investigation</span></h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="DetailedDescription" class="form-label"><i class="fas fa-list-ol"></i> Detailed description / sequence of events</label>
        <textarea asp-for="DetailedDescription" class="form-control" rows="7" placeholder="Full narrative and the sequence of events, in order."></textarea>
    </div>
    <div class="form-group">
        <label asp-for="EvidencePeople" class="form-label"><i class="fas fa-users"></i> Evidence — People</label>
        <textarea asp-for="EvidencePeople" class="form-control" rows="2"></textarea>
        <input type="file" name="catfile_evpeople" class="form-control" multiple accept="@fileAccept" style="margin-top:0.4rem;" />
        @onFile("Evidence — People")
    </div>
    <div class="form-group">
        <label asp-for="EvidencePaper" class="form-label"><i class="fas fa-file-lines"></i> Evidence — Paper</label>
        <textarea asp-for="EvidencePaper" class="form-control" rows="2"></textarea>
        <input type="file" name="catfile_evpaper" class="form-control" multiple accept="@fileAccept" style="margin-top:0.4rem;" />
        @onFile("Evidence — Paper")
    </div>
    <div class="form-group">
        <label asp-for="EvidenceParts" class="form-label"><i class="fas fa-gears"></i> Evidence — Parts</label>
        <textarea asp-for="EvidenceParts" class="form-control" rows="2"></textarea>
        <input type="file" name="catfile_evparts" class="form-control" multiple accept="@fileAccept" style="margin-top:0.4rem;" />
        @onFile("Evidence — Parts")
    </div>
    <div class="form-group">
        <label asp-for="EvidencePositions" class="form-label"><i class="fas fa-location-crosshairs"></i> Evidence — Positions</label>
        <textarea asp-for="EvidencePositions" class="form-control" rows="2"></textarea>
        <input type="file" name="catfile_evpositions" class="form-control" multiple accept="@fileAccept" style="margin-top:0.4rem;" />
        @onFile("Evidence — Positions")
    </div>
</div>
<span class="field-hint" style="margin-top:0.5rem;display:block;">You can attach supporting files to any evidence line (optional).</span>

<!-- SECTION E -->
<div class="section-band"><div class="section-letter">E</div><h3>Classification</h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group">
        <label asp-for="Category" class="form-label"><i class="fas fa-tag"></i> Incident category</label>
        <input asp-for="Category" class="form-control" placeholder="e.g. Customer dissatisfaction" />
    </div>
    <div class="form-group">
        <label asp-for="Severity" class="form-label"><i class="fas fa-triangle-exclamation"></i> Severity</label>
        <select asp-for="Severity" class="form-control" asp-items="Html.GetEnumSelectList<IncidentSeverity>()"></select>
    </div>
    <div class="form-group">
        <label asp-for="Probability" class="form-label"><i class="fas fa-dice"></i> Probability of occurrence</label>
        <select asp-for="Probability" class="form-control" asp-items="Html.GetEnumSelectList<IncidentProbability>()"></select>
    </div>
    <div class="form-group">
        <label asp-for="ReportStatus" class="form-label"><i class="fas fa-clipboard-list"></i> Status of investigation report</label>
        <select asp-for="ReportStatus" class="form-control" asp-items="Html.GetEnumSelectList<InvestigationReportStatus>()"></select>
    </div>
</div>

<!-- SECTION F -->
<div class="section-band"><div class="section-letter">F</div><h3>Supporting Documents <span>· tick each attached, then upload the file(s)</span></h3><div class="rule"></div></div>
<div class="doc-grid">
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocPollutionReport" data-file="catfile_pollution" /> Pollution Report</label>
        <div class="doc-file" data-for="catfile_pollution">
            <input type="file" name="catfile_pollution" class="form-control" multiple accept="@fileAccept" />
            @onFile("Pollution Report")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocSketchDiagram" data-file="catfile_sketch" /> Sketch Diagram</label>
        <div class="doc-file" data-for="catfile_sketch">
            <input type="file" name="catfile_sketch" class="form-control" multiple accept="@fileAccept" />
            @onFile("Sketch Diagram")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocWrittenStatements" data-file="catfile_written" /> Written Statements</label>
        <div class="doc-file" data-for="catfile_written">
            <input type="file" name="catfile_written" class="form-control" multiple accept="@fileAccept" />
            @onFile("Written Statements")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocMotorInsurance" data-file="catfile_motor" /> Motor Insurance Details</label>
        <div class="doc-file" data-for="catfile_motor">
            <input type="file" name="catfile_motor" class="form-control" multiple accept="@fileAccept" />
            @onFile("Motor Insurance Details")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocDeptOfLabour" data-file="catfile_labour" /> Dept of Labour</label>
        <div class="doc-file" data-for="catfile_labour">
            <input type="file" name="catfile_labour" class="form-control" multiple accept="@fileAccept" />
            @onFile("Dept of Labour")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocDriversDetails" data-file="catfile_driver" /> Driver's Details</label>
        <div class="doc-file" data-for="catfile_driver">
            <input type="file" name="catfile_driver" class="form-control" multiple accept="@fileAccept" />
            @onFile("Driver's Details")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocInternalAudit" data-file="catfile_audit" /> Internal Audit</label>
        <div class="doc-file" data-for="catfile_audit">
            <input type="file" name="catfile_audit" class="form-control" multiple accept="@fileAccept" />
            @onFile("Internal Audit")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocWorkmenCompensation" data-file="catfile_workmen" /> Workmen Compensation</label>
        <div class="doc-file" data-for="catfile_workmen">
            <input type="file" name="catfile_workmen" class="form-control" multiple accept="@fileAccept" />
            @onFile("Workmen Compensation")
        </div>
    </div>
    <div class="doc-cell">
        <label class="check-item"><input type="checkbox" asp-for="DocOther" data-file="catfile_other" /> Other</label>
        <div class="doc-file" data-for="catfile_other">
            <input asp-for="DocOtherText" class="form-control" placeholder="Describe the other document…" style="margin-bottom:0.4rem;" />
            <input type="file" name="catfile_other" class="form-control" multiple accept="@fileAccept" />
            @onFile("Other Supporting Document")
        </div>
    </div>
</div>
<span class="field-hint" style="margin-top:0.5rem;display:block;">Each ticked document reveals a file box — attach one or more files (up to 25 MB each).</span>

<!-- SECTION H -->
<div class="section-band"><div class="section-letter">H</div><h3>Preventability &amp; Claim</h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group">
        <label class="form-label"><i class="fas fa-shield-halved"></i> Was the incident preventable?</label>
        @yesNo("Preventable", Model.Preventable)
    </div>
    <div class="form-group span-2">
        <label asp-for="PreventableNotes" class="form-label"><i class="fas fa-note-sticky"></i> Preventability notes</label>
        <input asp-for="PreventableNotes" class="form-control" placeholder="e.g. control of documents accessibility" />
    </div>
    <div class="form-group">
        <label class="form-label"><i class="fas fa-hand-holding-dollar"></i> Is the incident claimable?</label>
        @yesNo("Claimable", Model.Claimable)
    </div>
    <div class="form-group">
        <label class="form-label"><i class="fas fa-file-invoice-dollar"></i> Claimed from insurance / any party?</label>
        @yesNo("ClaimedFromInsurance", Model.ClaimedFromInsurance)
    </div>
    <div class="form-group">
        <label asp-for="ClaimNotes" class="form-label"><i class="fas fa-note-sticky"></i> Claim notes</label>
        <input asp-for="ClaimNotes" class="form-control" />
    </div>
</div>

<!-- SECTION I -->
<div class="section-band"><div class="section-letter">I</div><h3>Critical Factors Identified</h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="CriticalFactors" class="form-label"><i class="fas fa-list-check"></i> Critical factors (one per line)</label>
        <textarea asp-for="CriticalFactors" class="form-control" rows="5"></textarea>
    </div>
</div>

<!-- SECTION J -->
<div class="section-band"><div class="section-letter">J</div><h3>Root Cause Analysis</h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group">
        <label asp-for="ImmediateCause" class="form-label"><i class="fas fa-bolt"></i> Immediate cause(s)</label>
        <textarea asp-for="ImmediateCause" class="form-control" rows="4"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="BasicCause" class="form-label"><i class="fas fa-layer-group"></i> Basic cause(s)</label>
        <textarea asp-for="BasicCause" class="form-control" rows="4"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="RootCause" class="form-label"><i class="fas fa-seedling"></i> Root cause</label>
        <textarea asp-for="RootCause" class="form-control" rows="4"></textarea>
    </div>
</div>

<!-- SECTION L -->
<div class="section-band"><div class="section-letter">L</div><h3>Lessons Learned</h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="LessonsLearned" class="form-label"><i class="fas fa-lightbulb"></i> Lessons learned (one per line)</label>
        <textarea asp-for="LessonsLearned" class="form-control" rows="5"></textarea>
    </div>
</div>

<!-- SECTIONS M / N / O -->
<div class="section-band"><div class="section-letter">M</div><h3>Sign-off Comments</h3><div class="rule"></div></div>
<div class="form-grid">
    <div class="form-group span-2">
        <label asp-for="DeptManagerComments" class="form-label"><i class="fas fa-user-tie"></i> Department Manager / Team Leader comments</label>
        <textarea asp-for="DeptManagerComments" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="DeptManagerCommentDate" class="form-label"><i class="fas fa-calendar"></i> Date</label>
        <input asp-for="DeptManagerCommentDate" type="date" class="form-control" />
    </div>
    <div class="form-group span-2">
        <label asp-for="QaComments" class="form-label"><i class="fas fa-clipboard-check"></i> Quality Assurance comments</label>
        <textarea asp-for="QaComments" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="QaCommentDate" class="form-label"><i class="fas fa-calendar"></i> Date</label>
        <input asp-for="QaCommentDate" type="date" class="form-control" />
    </div>
    <div class="form-group span-2">
        <label asp-for="GmComments" class="form-label"><i class="fas fa-user-shield"></i> General Manager comments <span class="field-hint">(major incidents)</span></label>
        <textarea asp-for="GmComments" class="form-control" rows="3"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="GmCommentDate" class="form-label"><i class="fas fa-calendar"></i> Date</label>
        <input asp-for="GmCommentDate" type="date" class="form-control" />
    </div>
</div>

<script>
    // Section F: reveal a document's upload box when it is ticked; clear the file box when unticked.
    (function () {
        document.querySelectorAll('input[type=checkbox][data-file]').forEach(function (cb) {
            var box = document.querySelector('.doc-file[data-for="' + cb.getAttribute('data-file') + '"]');
            if (!box) return;
            function sync() {
                box.style.display = cb.checked ? 'block' : 'none';
                if (!cb.checked) { var f = box.querySelector('input[type=file]'); if (f) f.value = ''; }
            }
            cb.addEventListener('change', sync);
            sync();
        });
    })();
</script>
