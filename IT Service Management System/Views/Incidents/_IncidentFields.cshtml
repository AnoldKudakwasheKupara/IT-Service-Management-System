<span class="field-hint" style="margin-top:0.5rem;display:block;">
    <i class="fas fa-info-circle"></i> Each ticked document reveals a file box — attach one or more files (up to 25 MB each).
</span>

<script>
    // Section F: reveal a document's upload box when it is ticked; clear the file box when unticked.
    (function () {
        document.querySelectorAll('input[type=checkbox][data-file]').forEach(function (cb) {
            var box = document.querySelector('.doc-file[data-for="' + cb.getAttribute('data-file') + '"]');
            if (!box) return;
            function sync() {
                box.style.display = cb.checked ? 'block' : 'none';
                if (!cb.checked) {
                    var f = box.querySelector('input[type=file]');
                    if (f) f.value = '';
                    var display = box.querySelector('.file-names-display');
                    if (display) {
                        display.textContent = '';
                        display.style.display = 'none';
                    }
                }
            }
            cb.addEventListener('change', sync);
            sync();
        });

        // File name display for doc file inputs
        document.querySelectorAll('.doc-file .file-input').forEach(function(input) {
            var display = input.closest('.doc-file').querySelector('.file-names-display');
            if (display) {
                input.addEventListener('change', function() {
                    if (this.files.length > 0) {
                        var names = Array.from(this.files).map(f => f.name).join(', ');
                        display.textContent = this.files.length + ' file(s): ' + names;
                        display.style.display = 'block';
                    } else {
                        display.textContent = '';
                        display.style.display = 'none';
                    }
                });
            }
        });
    })();
</script>

<!-- ===== SECTION H: Preventability & Claim ===== -->
<div class="section-divider">
    <span class="section-letter">H</span>
    <div class="section-title">
        <h3>Preventability &amp; Claim</h3>
    </div>
</div>

<div class="form-grid">
    <div class="form-group">
        <label class="form-label">
            <i class="fas fa-shield-halved"></i> Was the incident preventable?
        </label>
        @yesNo("Preventable", Model.Preventable)
        <span asp-validation-for="Preventable" class="validation-error"></span>
    </div>

    <div class="form-group span-2">
        <label asp-for="PreventableNotes" class="form-label">
            <i class="fas fa-note-sticky"></i> Preventability notes
        </label>
        <input asp-for="PreventableNotes" class="form-control" placeholder="e.g. control of documents accessibility" />
        <span asp-validation-for="PreventableNotes" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label">
            <i class="fas fa-hand-holding-dollar"></i> Is the incident claimable?
        </label>
        @yesNo("Claimable", Model.Claimable)
        <span asp-validation-for="Claimable" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label class="form-label">
            <i class="fas fa-file-invoice-dollar"></i> Claimed from insurance / any party?
        </label>
        @yesNo("ClaimedFromInsurance", Model.ClaimedFromInsurance)
        <span asp-validation-for="ClaimedFromInsurance" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ClaimNotes" class="form-label">
            <i class="fas fa-note-sticky"></i> Claim notes
        </label>
        <input asp-for="ClaimNotes" class="form-control" placeholder="Additional claim details..." />
        <span asp-validation-for="ClaimNotes" class="validation-error"></span>
    </div>
</div>

<!-- ===== SECTION I: Critical Factors ===== -->
<div class="section-divider">
    <span class="section-letter">I</span>
    <div class="section-title">
        <h3>Critical Factors Identified</h3>
    </div>
</div>

<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="CriticalFactors" class="form-label">
            <i class="fas fa-list-check"></i> Critical factors (one per line)
        </label>
        <textarea asp-for="CriticalFactors" class="form-control" rows="4" placeholder="List the critical factors that contributed to the incident..."></textarea>
        <span asp-validation-for="CriticalFactors" class="validation-error"></span>
    </div>
</div>

<!-- ===== SECTION J: Root Cause Analysis ===== -->
<div class="section-divider">
    <span class="section-letter">J</span>
    <div class="section-title">
        <h3>Root Cause Analysis</h3>
    </div>
</div>

<div class="form-grid">
    <div class="form-group">
        <label asp-for="ImmediateCause" class="form-label">
            <i class="fas fa-bolt"></i> Immediate cause(s)
        </label>
        <textarea asp-for="ImmediateCause" class="form-control" rows="4" placeholder="What immediately caused the incident..."></textarea>
        <span asp-validation-for="ImmediateCause" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="BasicCause" class="form-label">
            <i class="fas fa-layer-group"></i> Basic cause(s)
        </label>
        <textarea asp-for="BasicCause" class="form-control" rows="4" placeholder="What are the basic underlying causes..."></textarea>
        <span asp-validation-for="BasicCause" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="RootCause" class="form-label">
            <i class="fas fa-seedling"></i> Root cause
        </label>
        <textarea asp-for="RootCause" class="form-control" rows="4" placeholder="What is the root cause of the incident..."></textarea>
        <span asp-validation-for="RootCause" class="validation-error"></span>
    </div>
</div>

<!-- ===== SECTION L: Lessons Learned ===== -->
<div class="section-divider">
    <span class="section-letter">L</span>
    <div class="section-title">
        <h3>Lessons Learned</h3>
    </div>
</div>

<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="LessonsLearned" class="form-label">
            <i class="fas fa-lightbulb"></i> Lessons learned (one per line)
        </label>
        <textarea asp-for="LessonsLearned" class="form-control" rows="4" placeholder="What lessons were learned from this incident..."></textarea>
        <span asp-validation-for="LessonsLearned" class="validation-error"></span>
    </div>
</div>

<!-- ===== SECTIONS M / N / O: Sign-off Comments ===== -->
<div class="section-divider">
    <span class="section-letter">M</span>
    <div class="section-title">
        <h3>Sign-off Comments</h3>
    </div>
</div>

<div class="alert-flash" style="background:var(--gray-50);border-color:var(--gray-200);color:var(--gray-600);">
    <i class="fas fa-shield-check"></i>
    Role-verified sign-offs are recorded from the incident details page after the report is saved.
</div>

