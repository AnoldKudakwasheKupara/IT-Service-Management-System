@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model Incident
@{
    var departments = ViewBag.Departments as List<Department> ?? new();
    const string fileAccept = ".pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.txt,.csv,.msg,.eml";
    var hasExistingPoliceReport = Model.Attachments?.Any(a => a.Kind == IncidentAttachmentKind.PoliceReport) == true;

    // Lists files already attached under a given category (shown on Edit so the user sees what's on file).
    Func<string, Microsoft.AspNetCore.Html.IHtmlContent> onFile = (label) =>
    {
        var items = (Model.Attachments ?? new List<IncidentAttachment>()).Where(a => a.Category == label).ToList();
        if (items.Count == 0) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        var names = string.Join(", ", items.Select(a => System.Net.WebUtility.HtmlEncode(a.OriginalFileName)));
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<span class='field-hint' style='display:block;margin-top:0.25rem;'><i class='fas fa-paperclip' style='color:var(--success);'></i> On file: {names}</span>");
    };

    // Renders "Yes / No" tri-state radios bound to a nullable bool property.
    Func<string, bool?, Microsoft.AspNetCore.Html.IHtmlContent> yesNo = (name, val) =>
    {
        var yes = val == true ? "checked" : "";
        var no = val == false ? "checked" : "";
        return new Microsoft.AspNetCore.Html.HtmlString(
            $@"<div class='radio-line'>
                 <label class='radio-opt'><input type='radio' name='{name}' value='true' {yes}/> Yes</label>
                 <label class='radio-opt'><input type='radio' name='{name}' value='false' {no}/> No</label>
                 <label class='radio-opt'><input type='radio' name='{name}' value='' {(val == null ? "checked" : "")}/> N/A</label>
               </div>");
    };
}

<!-- ===== VALIDATION SUMMARY ===== -->
<div asp-validation-summary="ModelOnly" class="alert-flash danger" style="display:block;margin-bottom:1.5rem;"></div>

<!-- ===== SECTION A: Incident Details ===== -->
<div class="section-divider">
    <span class="section-letter">A</span>
    <div class="section-title">
        <h3>Incident Details</h3>
        <span>· reported by</span>
    </div>
</div>

<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="Title" class="form-label">
            <i class="fas fa-heading"></i> Incident Title <span class="required">*</span>
        </label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Dees Pharmacy customer dissatisfaction" required />
        <span asp-validation-for="Title" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateOfIncident" class="form-label">
            <i class="fas fa-calendar-day"></i> Date of Incident
        </label>
        <input asp-for="DateOfIncident" type="date" class="form-control" />
        <span asp-validation-for="DateOfIncident" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="TimeOfIncident" class="form-label">
            <i class="fas fa-clock"></i> Time of Incident
        </label>
        <input asp-for="TimeOfIncident" class="form-control" placeholder="e.g. 10:57 AM" />
        <span asp-validation-for="TimeOfIncident" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="LocationOfIncident" class="form-label">
            <i class="fas fa-location-dot"></i> Location
        </label>
        <input asp-for="LocationOfIncident" class="form-control" placeholder="Where it occurred / was reported" />
        <span asp-validation-for="LocationOfIncident" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DepartmentId" class="form-label">
            <i class="fas fa-sitemap"></i> Function / Department
        </label>
        <select asp-for="DepartmentId" class="form-control">
            <option value="">— Select —</option>
            @foreach (var d in departments)
            {
                <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReportedByName" class="form-label">
            <i class="fas fa-user"></i> Reported By
        </label>
        <input asp-for="ReportedByName" class="form-control" placeholder="Name of reporter" />
        <span asp-validation-for="ReportedByName" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateReported" class="form-label">
            <i class="fas fa-calendar-check"></i> Date Reported
        </label>
        <input asp-for="DateReported" type="date" class="form-control" />
        <span asp-validation-for="DateReported" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Standard" class="form-label">
            <i class="fas fa-certificate"></i> ISO Standard
        </label>
        <select asp-for="Standard" class="form-control" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
        <span asp-validation-for="Standard" class="validation-error"></span>
    </div>
</div>

<!-- ===== SECTION B: Brief Description ===== -->
<div class="section-divider">
    <span class="section-letter">B</span>
    <div class="section-title">
        <h3>Brief Description</h3>
    </div>
</div>

<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="BriefDescription" class="form-label">
            <i class="fas fa-align-left"></i> Brief description of incident
        </label>
        <textarea asp-for="BriefDescription" class="form-control" rows="4" placeholder="A short account of what happened, as reported."></textarea>
        <span asp-validation-for="BriefDescription" class="validation-error"></span>
    </div>
</div>

<!-- ===== SECTION C: Police Report ===== -->
<div class="section-divider">
    <span class="section-letter">C</span>
    <div class="section-title">
        <h3>Police Report</h3>
        <span>· if applicable</span>
    </div>
</div>

<div class="form-grid">
    <div class="form-group">
        <label class="form-label">
            <i class="fas fa-building-shield"></i> Reported to Police?
        </label>
        @yesNo("ReportedToPolice", Model.ReportedToPolice)
        <span asp-validation-for="ReportedToPolice" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ReportedToPoliceAt" class="form-label">
            <i class="fas fa-location-dot"></i> Reported to Police at
        </label>
        <input asp-for="ReportedToPoliceAt" class="form-control" placeholder="Station / N/A" />
        <span asp-validation-for="ReportedToPoliceAt" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CaseNumber" class="form-label">
            <i class="fas fa-hashtag"></i> Case Number
        </label>
        <input asp-for="CaseNumber" class="form-control" placeholder="N/A" />
        <span asp-validation-for="CaseNumber" class="validation-error"></span>
    </div>

    <div class="form-group span-2">
        <label asp-for="PoliceDetailsTel" class="form-label">
            <i class="fas fa-phone"></i> Police details &amp; Tel
        </label>
        <input asp-for="PoliceDetailsTel" class="form-control" placeholder="N/A" />
        <span asp-validation-for="PoliceDetailsTel" class="validation-error"></span>
    </div>

    <div class="form-group" id="policeReportRow">
        <label class="form-label" for="policeReport">
            <i class="fas fa-file-arrow-up"></i> Police Report
            <span class="required" id="policeReportReq" style="display:none;">*</span>
        </label>
        <div class="file-upload-wrapper">
            <input type="file" name="policeReport" id="policeReport" class="file-input"
                   accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
            <label for="policeReport" class="file-upload-label small">
                <i class="fas fa-cloud-upload-alt"></i>
                <span>Choose police report file</span>
                <span class="file-hint">PDF, DOC, DOCX, PNG, JPG (max 25 MB)</span>
            </label>
            <span id="policeReportFileName" class="file-names-display"></span>
        </div>
        <span class="field-hint" id="policeReportHint">Required when the incident was reported to the police (max 25 MB).</span>
    </div>
</div>

<script>
    (function () {
        // Police report required toggle
        function syncPolice() {
            var yes = document.querySelector('input[name="ReportedToPolice"][value="true"]');
            var on = yes && yes.checked;
            var hasExisting = @(hasExistingPoliceReport ? "true" : "false");
            var req = document.getElementById('policeReportReq');
            var input = document.getElementById('policeReport');
            var hint = document.getElementById('policeReportHint');
            if (req) req.style.display = on && !hasExisting ? 'inline' : 'none';
            if (input) input.required = !!on && !hasExisting;
            if (hint) hint.style.display = on && !hasExisting ? 'block' : 'none';
        }
        document.querySelectorAll('input[name="ReportedToPolice"]').forEach(function (r) {
            r.addEventListener('change', syncPolice);
        });
        syncPolice();

        // File name display
        var policeInput = document.getElementById('policeReport');
        var policeDisplay = document.getElementById('policeReportFileName');
        if (policeInput && policeDisplay) {
            policeInput.addEventListener('change', function () {
                if (this.files.length > 0) {
                    policeDisplay.textContent = this.files[0].name;
                    policeDisplay.style.display = 'block';
                } else {
                    policeDisplay.textContent = '';
                    policeDisplay.style.display = 'none';
                }
            });
        }
    })();
</script>

<!-- ===== SECTION D: Detailed Description & Evidence ===== -->
<div class="section-divider">
    <span class="section-letter">D</span>
    <div class="section-title">
        <h3>Detailed Description &amp; Evidence</h3>
        <span>· investigation</span>
    </div>
</div>

<div class="form-grid">
    <div class="form-group full-width">
        <label asp-for="DetailedDescription" class="form-label">
            <i class="fas fa-list-ol"></i> Detailed description / sequence of events
        </label>
        <textarea asp-for="DetailedDescription" class="form-control" rows="6" placeholder="Full narrative and the sequence of events, in order."></textarea>
        <span asp-validation-for="DetailedDescription" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="EvidencePeople" class="form-label">
            <i class="fas fa-users"></i> Evidence — People
        </label>
        <textarea asp-for="EvidencePeople" class="form-control" rows="2" placeholder="List of people involved or providing evidence..."></textarea>
        <div class="file-upload-wrapper small">
            <input type="file" name="catfile_evpeople" id="catfile_evpeople" class="file-input" multiple accept="@fileAccept" />
            <label for="catfile_evpeople" class="file-upload-label tiny">
                <i class="fas fa-paperclip"></i> Attach files
            </label>
            <span class="file-names-display" id="evpeopleFiles"></span>
        </div>
        @onFile("Evidence — People")
        <span asp-validation-for="EvidencePeople" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="EvidencePaper" class="form-label">
            <i class="fas fa-file-lines"></i> Evidence — Paper
        </label>
        <textarea asp-for="EvidencePaper" class="form-control" rows="2" placeholder="Physical or digital paper evidence..."></textarea>
        <div class="file-upload-wrapper small">
            <input type="file" name="catfile_evpaper" id="catfile_evpaper" class="file-input" multiple accept="@fileAccept" />
            <label for="catfile_evpaper" class="file-upload-label tiny">
                <i class="fas fa-paperclip"></i> Attach files
            </label>
            <span class="file-names-display" id="evpaperFiles"></span>
        </div>
        @onFile("Evidence — Paper")
        <span asp-validation-for="EvidencePaper" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="EvidenceParts" class="form-label">
            <i class="fas fa-gears"></i> Evidence — Parts
        </label>
        <textarea asp-for="EvidenceParts" class="form-control" rows="2" placeholder="Parts or components evidence..."></textarea>
        <div class="file-upload-wrapper small">
            <input type="file" name="catfile_evparts" id="catfile_evparts" class="file-input" multiple accept="@fileAccept" />
            <label for="catfile_evparts" class="file-upload-label tiny">
                <i class="fas fa-paperclip"></i> Attach files
            </label>
            <span class="file-names-display" id="evpartsFiles"></span>
        </div>
        @onFile("Evidence — Parts")
        <span asp-validation-for="EvidenceParts" class="validation-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="EvidencePositions" class="form-label">
            <i class="fas fa-location-crosshairs"></i> Evidence — Positions
        </label>
        <textarea asp-for="EvidencePositions" class="form-control" rows="2" placeholder="Positions or locations evidence..."></textarea>
        <div class="file-upload-wrapper small">
            <input type="file" name="catfile_evpositions" id="catfile_evpositions" class="file-input" multiple accept="@fileAccept" />
            <label for="catfile_evpositions" class="file-upload-label tiny">
                <i class="fas fa-paperclip"></i> Attach files
            </label>
            <span class="file-names-display" id="evpositionsFiles"></span>
        </div>
        @onFile("Evidence — Positions")
        <span asp-validation-for="EvidencePositions" class="validation-error"></span>
    </div>
</div>

<span class="field-hint" style="margin-top:0.5rem;display:block;">
    <i class="fas fa-info-circle"></i> You can attach supporting files to any evidence line (optional).
</span>

<script>
    // File name display for evidence category file inputs
    document.querySelectorAll('.file-upload-wrapper.small .file-input').forEach(function(input) {
        var displayId = input.id + 'Files';
        var display = document.getElementById(displayId);
        if (display) {
            input.addEventListener('change', function() {
                if (this.files.length > 0) {
                    var names = Array.from(this.files).map(f => f.name).join(', ');
                    display.textContent = this.files.length + ' file(s): ' + names;
                    display.style.display = 'block';
                } else {
                    display.textContent = '';
                    display.style.display = 'none';
                }
            });
        }
    });
</script>

<!-- ===== SECTION E: Classification ===== -->
