@using IT_Service_Management_System.Models.Ims
@model Incident
@{
    ViewData["Title"] = $"Edit {Model.Reference}";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="btn-back" asp-action="Details" asp-route-id="@Model.Id">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-pen-to-square me-2" style="color: var(--primary);"></i>
                    Edit <span class="doc-number">@Model.Reference</span>
                </h1>
                <p class="text-muted mt-2">@Model.Title</p>
            </div>
        </div>
    </div>

    <!-- FORM CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-file-pen me-2" style="color: var(--primary);"></i>
            <span>Incident Investigation Report</span>
            <span class="header-tag">@Model.Reference</span>
        </div>

        <div class="card-body-custom">
            <form method="post" asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- Form Fields -->
                <partial name="_IncidentFields" model="Model" />

                <!-- Form Actions -->
                <div class="form-actions">
                    <button type="submit" class="btn-create-ticket">
                        <i class="fas fa-save"></i>
                        Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-cancel">
                        <i class="fas fa-times"></i>
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_IncidentStyles" />

<style>
    /* ===== ADDITIONAL STYLES ===== */
    .header-tag {
        font-size: 0.65rem;
        font-weight: 500;
        color: var(--gray-500);
        background: var(--gray-100);
        padding: 0.15rem 0.6rem;
        border-radius: 1rem;
        border: 1px solid var(--gray-200);
        margin-left: auto;
        white-space: nowrap;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .card-header-custom {
            flex-wrap: wrap;
        }

        .header-tag {
            margin-left: 0;
            width: 100%;
            text-align: center;
        }
    }

    @@media (max-width: 576px) {
        .header-tag {
            font-size: 0.55rem;
            padding: 0.1rem 0.4rem;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
