@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
    ViewData["AuthIcon"] = "fa-key";
    ViewData["AuthTitle"] = "Reset your password";
    ViewData["AuthSubtitle"] = "Enter your work email and we'll send you a link to set a new password.";
}

@if (ViewBag.Message != null)
{
    <div class="auth-alert is-info" role="status">
        <i class="fas fa-circle-info"></i>
        <span>@ViewBag.Message</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="auth-alert is-error" role="alert">
        <i class="fas fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="auth-alert is-success" role="status">
        <i class="fas fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<form method="post" data-auth-form>
    @Html.AntiForgeryToken()

    <div class="auth-field">
        <label class="auth-label" for="email">Email address</label>
        <div class="auth-input-wrap">
            <input type="email" id="email" name="email" class="auth-input"
                   placeholder="name@company.com" required autocomplete="email"
                   autofocus aria-describedby="emailHint" />
            <i class="fas fa-envelope lead-icon"></i>
        </div>
        <p id="emailHint" class="field-hint">
            <i class="fas fa-circle-info"></i>
            We'll send the reset link here. It expires in 24 hours.
        </p>
    </div>

    <button type="submit" class="auth-btn" data-busy="Sending…">
        <i class="fas fa-paper-plane"></i> Send reset link
    </button>
</form>

<div class="auth-links">
    Remembered it? <a asp-controller="Account" asp-action="Login">Back to sign in</a>
</div>

<style>
    .field-hint {
        margin: .5rem 0 0;
        font-size: .8rem;
        color: var(--gray-500);
        line-height: 1.5;
    }

        .field-hint i { color: var(--gray-400); margin-right: .15rem; }
</style>
