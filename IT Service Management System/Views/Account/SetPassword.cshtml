@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set password";
    ViewData["AuthIcon"] = "fa-lock";
    ViewData["AuthTitle"] = ViewBag.TokenError != null ? "Link no longer valid" : "Set a new password";
    ViewData["AuthSubtitle"] = ViewBag.TokenError != null
        ? "This password link can't be used to set a password."
        : "Choose a strong password you don't use anywhere else.";

    var token = Context.Request.Query["token"];
}

@if (ViewBag.TokenError != null)
{
    <div class="auth-alert is-error" role="alert">
        <i class="fas fa-triangle-exclamation"></i>
        <span>@ViewBag.TokenError</span>
    </div>

    <a class="auth-btn" asp-controller="Account" asp-action="ForgotPassword">
        <i class="fas fa-rotate-right"></i> Request a new link
    </a>

    <div class="auth-links">
        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </div>
}
else
{
    @if (ViewBag.Error != null)
    {
        <div class="auth-alert is-error" role="alert">
            <i class="fas fa-circle-exclamation"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <form method="post" id="setPasswordForm" data-auth-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="token" value="@token" />

        <div class="auth-field">
            <label class="auth-label" for="password">New password</label>
            <div class="auth-input-wrap">
                <input type="password" id="password" name="password" class="auth-input"
                       placeholder="Enter a new password" required autocomplete="new-password" autofocus />
                <i class="fas fa-lock lead-icon"></i>
                <button type="button" class="auth-toggle" data-toggle-password="password" aria-label="Show password">
                    <i class="far fa-eye-slash"></i>
                </button>
            </div>

            <div class="pw-strength" id="passwordStrength" aria-hidden="true">
                <div class="pw-bar"><div class="pw-bar-fill" id="strengthBarFill"></div></div>
                <span class="pw-strength-text" id="strengthText"></span>
            </div>

            <ul class="pw-reqs" id="passwordRequirements" aria-label="Password requirements">
                <li id="reqLength"><i class="fas fa-circle"></i> At least 8 characters</li>
                <li id="reqUpper"><i class="fas fa-circle"></i> An uppercase letter</li>
                <li id="reqLower"><i class="fas fa-circle"></i> A lowercase letter</li>
                <li id="reqNumber"><i class="fas fa-circle"></i> A number</li>
                <li id="reqSpecial"><i class="fas fa-circle"></i> A special character (!@@#$%^&amp;*)</li>
            </ul>
        </div>

        <div class="auth-field">
            <label class="auth-label" for="confirmPassword">Confirm password</label>
            <div class="auth-input-wrap">
                <input type="password" id="confirmPassword" name="confirmPassword" class="auth-input"
                       placeholder="Re-enter the new password" required autocomplete="new-password" />
                <i class="fas fa-rotate-right lead-icon"></i>
                <button type="button" class="auth-toggle" data-toggle-password="confirmPassword" aria-label="Show password">
                    <i class="far fa-eye-slash"></i>
                </button>
            </div>
            <p id="passwordMatchError" class="pw-mismatch" role="alert" hidden>
                <i class="fas fa-circle-xmark"></i> Passwords do not match
            </p>
        </div>

        <button type="submit" class="auth-btn" data-busy="Saving…">
            <i class="fas fa-circle-check"></i> Set password
        </button>
    </form>

    <div class="auth-links">
        <a asp-controller="Account" asp-action="Login">Back to sign in</a>
    </div>
}

<style>
    .pw-strength { margin-top: .7rem; display: flex; align-items: center; gap: .65rem; }

    .pw-bar {
        flex: 1; height: 5px; border-radius: 999px;
        background: var(--gray-200); overflow: hidden;
    }

    .pw-bar-fill {
        height: 100%; width: 0; border-radius: 999px;
        background: var(--danger);
        transition: width .25s ease, background-color .25s ease;
    }

    .pw-strength-text {
        font-size: .74rem; font-weight: 600; color: var(--gray-500);
        min-width: 4.5rem; text-align: right;
    }

    .pw-reqs {
        list-style: none; margin: .85rem 0 0; padding: .8rem .9rem;
        background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: .7rem;
        display: grid; gap: .4rem;
    }

        .pw-reqs li {
            display: flex; align-items: center; gap: .55rem;
            font-size: .78rem; color: var(--gray-500);
            transition: color .18s ease;
        }

            .pw-reqs li i { font-size: .45rem; transition: all .18s ease; }

            .pw-reqs li.valid { color: var(--success); }

                .pw-reqs li.valid i { font-size: .75rem; }

    .pw-mismatch {
        margin: .5rem 0 0; font-size: .78rem; color: var(--danger);
        display: flex; align-items: center; gap: .35rem;
    }

        .pw-mismatch[hidden] { display: none; }
</style>

@section Scripts {
    <script>
        (function () {
            var pw = document.getElementById('password');
            if (!pw) return;   // token-error branch renders no form

            var confirm = document.getElementById('confirmPassword');
            var mismatch = document.getElementById('passwordMatchError');
            var fill = document.getElementById('strengthBarFill');
            var text = document.getElementById('strengthText');
            var submit = document.querySelector('#setPasswordForm button[type=submit]');

            var rules = [
                { el: document.getElementById('reqLength'), test: function (v) { return v.length >= 8; } },
                { el: document.getElementById('reqUpper'), test: function (v) { return /[A-Z]/.test(v); } },
                { el: document.getElementById('reqLower'), test: function (v) { return /[a-z]/.test(v); } },
                { el: document.getElementById('reqNumber'), test: function (v) { return /[0-9]/.test(v); } },
                { el: document.getElementById('reqSpecial'), test: function (v) { return /[^A-Za-z0-9]/.test(v); } }
            ];

            var LEVELS = [
                { pct: 0, color: 'var(--danger)', label: '' },
                { pct: 20, color: 'var(--danger)', label: 'Very weak' },
                { pct: 40, color: '#e67e22', label: 'Weak' },
                { pct: 60, color: 'var(--warning)', label: 'Fair' },
                { pct: 80, color: '#3d9970', label: 'Good' },
                { pct: 100, color: 'var(--success)', label: 'Strong' }
            ];

            function evaluate() {
                var v = pw.value;
                var met = 0;

                rules.forEach(function (r) {
                    var ok = r.test(v);
                    if (ok) met++;
                    if (r.el) r.el.classList.toggle('valid', ok);
                    if (r.el) r.el.querySelector('i').className = ok ? 'fas fa-circle-check' : 'fas fa-circle';
                });

                var level = LEVELS[v.length === 0 ? 0 : met];
                fill.style.width = level.pct + '%';
                fill.style.backgroundColor = level.color;
                text.textContent = level.label;
                text.style.color = v.length === 0 ? 'var(--gray-500)' : level.color;

                return met === rules.length;
            }

            function checkMatch() {
                var differ = confirm.value.length > 0 && pw.value !== confirm.value;
                mismatch.hidden = !differ;
                confirm.style.borderColor = differ ? 'var(--danger)' : '';
                return !differ;
            }

            pw.addEventListener('input', function () { evaluate(); if (confirm.value) checkMatch(); });
            confirm.addEventListener('input', checkMatch);

            // Stop a submit that would only bounce back from the server.
            document.getElementById('setPasswordForm').addEventListener('submit', function (e) {
                var strong = evaluate();
                var matches = checkMatch();
                if (!strong || !matches) {
                    e.preventDefault();
                    e.stopImmediatePropagation();   // keeps the shared spinner from firing
                    (!strong ? pw : confirm).focus();
                    if (submit) { submit.disabled = false; }
                }
            });
        })();
    </script>
}
