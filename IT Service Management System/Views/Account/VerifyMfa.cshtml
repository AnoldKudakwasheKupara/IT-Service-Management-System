@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify sign-in";
    ViewData["AuthIcon"] = "fa-shield-halved";
    ViewData["AuthTitle"] = "Verify it's you";

    var masked = ViewBag.MaskedEmail as string ?? "your email";
    var method = ViewBag.Method as string ?? "Email";
    var isAuth = method == "Authenticator";
    var hasRecovery = ViewBag.HasRecovery as bool? ?? false;

    ViewData["AuthSubtitle"] = isAuth
        ? "Enter the current code from your authenticator app to finish signing in."
        : $"We sent a 6-digit code to {masked}. Enter it below to finish signing in.";
}

@if (ViewBag.Error != null)
{
    <div class="auth-alert is-error" role="alert">
        <i class="fas fa-circle-exclamation"></i>
        <span>@ViewBag.Error</span>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="auth-alert is-success" role="status">
        <i class="fas fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (ViewBag.DevOtp != null)
{
    <div class="auth-alert is-dev" role="status">
        <i class="fas fa-flask"></i>
        <span>
            Development mode — email delivery is bypassed. Your code is
            <strong class="dev-code">@ViewBag.DevOtp</strong>
        </span>
    </div>
}

<form method="post" asp-action="VerifyMfa" data-auth-form>
    @Html.AntiForgeryToken()

    <div class="auth-field">
        <label class="auth-label" for="code">
            @(isAuth ? "Authenticator code" : "Verification code")
        </label>
        <input type="text" id="code" name="code" class="auth-input code-input" maxlength="9"
               inputmode="numeric" autocomplete="one-time-code" placeholder="••••••"
               autofocus required aria-describedby="codeHint" />
        <p id="codeHint" class="field-hint">
            @if (hasRecovery)
            {
                <text>Lost your device? You can enter one of your recovery codes here instead.</text>
            }
            else
            {
                <text>The code expires shortly after it is issued.</text>
            }
        </p>
    </div>

    <button type="submit" class="auth-btn" data-busy="Verifying…">
        <i class="fas fa-check"></i> Verify &amp; sign in
    </button>
</form>

<div class="auth-links">
    @if (!isAuth)
    {
        <text>
            Didn't get a code?
            <form method="post" asp-action="ResendMfa" class="auth-inline-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="auth-linkbtn">Resend code</button>
            </form>
            &middot;
        </text>
    }
    <a asp-action="Login">Cancel</a>
</div>

<style>
    /* One-time code: wide tracking so the digits read as a code, not a word. */
    .code-input {
        padding-left: 1rem;
        text-align: center;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: .55rem;
        text-indent: .55rem; /* keeps the glyphs optically centred despite tracking */
    }

    .field-hint {
        margin: .5rem 0 0;
        font-size: .8rem;
        color: var(--gray-500);
        line-height: 1.5;
    }

    .dev-code { letter-spacing: 2px; }
</style>
