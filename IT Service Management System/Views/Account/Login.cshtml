@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    ViewData["AuthIcon"] = "fa-right-to-bracket";
    ViewData["AuthTitle"] = "Sign in";
    ViewData["AuthSubtitle"] = "Use your work account to continue to Axis IT Operations.";

    // Set when this device previously ticked "remember me".
    var rememberedEmail = ViewBag.RememberedEmail as string;
}

@if (ViewBag.Error != null)
{
    <div class="auth-alert is-error" role="alert">
        <i class="fas fa-circle-exclamation"></i>
        <span>@ViewBag.Error</span>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="auth-alert is-success" role="status">
        <i class="fas fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<form method="post" data-auth-form>
    @Html.AntiForgeryToken()

    <div class="auth-field">
        <label class="auth-label" for="email">Email address</label>
        <div class="auth-input-wrap">
            <input type="email" id="email" name="email" class="auth-input"
                   placeholder="name@company.com" required autocomplete="email"
                   value="@rememberedEmail" autofocus />
            <i class="fas fa-envelope lead-icon"></i>
        </div>
    </div>

    <div class="auth-field">
        <label class="auth-label" for="password">Password</label>
        <div class="auth-input-wrap">
            <input type="password" id="password" name="password" class="auth-input"
                   placeholder="Enter your password" required autocomplete="current-password" />
            <i class="fas fa-lock lead-icon"></i>
            <button type="button" class="auth-toggle" data-toggle-password="password" aria-label="Show password">
                <i class="far fa-eye-slash"></i>
            </button>
        </div>
    </div>

    <div class="auth-row">
        <label class="auth-check">
            <input type="checkbox" name="rememberMe" value="true"
                   checked="@(rememberedEmail != null)" />
            <span>Remember me</span>
        </label>
        <a class="auth-row-link" asp-controller="Account" asp-action="ForgotPassword">Forgot password?</a>
    </div>

    <button type="submit" class="auth-btn" data-busy="Signing in…">
        <i class="fas fa-right-to-bracket"></i> Sign in
    </button>
</form>

<style>
    .auth-row {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; margin: .25rem 0 1.25rem;
    }

    .auth-check {
        display: inline-flex; align-items: center; gap: .55rem;
        font-size: .86rem; color: var(--gray-600);
        cursor: pointer; user-select: none; margin: 0;
    }

        .auth-check input {
            width: 1.05rem; height: 1.05rem;
            accent-color: var(--primary);
            cursor: pointer;
        }

    .auth-row-link {
        font-size: .86rem; font-weight: 600;
        color: var(--primary); text-decoration: none; white-space: nowrap;
    }

        .auth-row-link:hover { text-decoration: underline; }
</style>
