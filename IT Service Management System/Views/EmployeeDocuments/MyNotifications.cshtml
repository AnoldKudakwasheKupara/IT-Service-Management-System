@model List<IT_Service_Management_System.Models.Efm.DocumentNotification>
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "My Notifications - Axis IT Operations";
    var paging = ViewBag.Paging as IT_Service_Management_System.Helpers.PagingInfo;
    var unread = ViewBag.UnreadCount as int? ?? 0;
    string Icon(DocumentNotificationType t) => t switch
    {
        DocumentNotificationType.DocumentApproved => "fa-circle-check",
        DocumentNotificationType.DocumentRejected => "fa-circle-xmark",
        DocumentNotificationType.DocumentExpiring => "fa-hourglass-half",
        DocumentNotificationType.DocumentExpired => "fa-triangle-exclamation",
        DocumentNotificationType.DocumentRequested => "fa-file-circle-question",
        DocumentNotificationType.DocumentRequestCancelled => "fa-ban",
        _ => "fa-circle-info"
    };
    string IconColor(DocumentNotificationType t) => t switch
    {
        DocumentNotificationType.DocumentApproved => "success",
        DocumentNotificationType.DocumentRejected => "danger",
        DocumentNotificationType.DocumentExpiring => "warning",
        DocumentNotificationType.DocumentExpired => "danger",
        DocumentNotificationType.DocumentRequested => "warning",
        DocumentNotificationType.DocumentRequestCancelled => "danger",
        _ => "primary"
    };
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-bell me-2" style="color: var(--primary);"></i>
                    My Notifications
                </h1>
                <p class="text-muted mt-2">
                    Updates about your documents — approvals, rejections and expiry reminders.
                    @if (unread > 0)
                    {
                        <span class="unread-badge">
                            <i class="fas fa-circle"></i>
                            @unread unread
                        </span>
                    }
                </p>
            </div>
            @if (unread > 0)
            {
                <form asp-action="MarkMyNotificationsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn-mark-read">
                        <i class="fas fa-check-double"></i>
                        Mark all read (@unread)
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--primary-light), var(--primary));">
                <i class="fas fa-inbox"></i>
            </div>
            <div class="stat-info">
                <h3>@(paging?.TotalCount ?? Model.Count)</h3>
                <p>Total Notifications</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f5b042, #e6a017);">
                <i class="fas fa-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@unread</h3>
                <p>Unread</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #2c9e6e, #227a55);">
                <i class="fas fa-circle-check"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(n => n.IsRead)</h3>
                <p>Read</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>@(Model.Any() ? Model.Max(n => n.CreatedAt).ToString("MMM dd") : "—")</h3>
                <p>Latest</p>
            </div>
        </div>
    </div>

    <!-- FILTERS CARD -->
    <div class="filters-card mb-4">
        <div class="filters-header">
            <i class="fas fa-filter"></i>
            <span>Filter Notifications</span>
        </div>
        <form method="get" asp-action="Index" class="filters-body">
            <div class="filter-group" style="flex: 1.5;">
                <label>Search</label>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="@ViewBag.Search" placeholder="Search by title or message..." class="search-input">
                </div>
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select name="status" class="filter-select">
                    <option value="">All Status</option>
                    <option value="unread" selected="@(ViewBag.Status == "unread")">Unread</option>
                    <option value="read" selected="@(ViewBag.Status == "read")">Read</option>
                </select>
            </div>
            <div class="filter-group">
                <label>Type</label>
                <select name="type" class="filter-select">
                    <option value="">All Types</option>
                    <option value="DocumentApproved">Approved</option>
                    <option value="DocumentRejected">Rejected</option>
                    <option value="DocumentExpiring">Expiring Soon</option>
                    <option value="DocumentExpired">Expired</option>
                </select>
            </div>
            <button type="submit" class="btn-clear-filters" style="background:var(--primary,#3b82f6);color:#fff;border:none;">
                <i class="fas fa-search"></i>
                Apply
            </button>
            <a asp-action="Index" class="btn-clear-filters" style="text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                <i class="fas fa-undo-alt"></i>
                Clear
            </a>
        </form>
    </div>

    <!-- NOTIFICATIONS CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-inbox me-2"></i>
                <span>Notifications</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span id="visibleCount">@(paging?.TotalCount ?? Model.Count)</span> notification(s)
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="notification-list" id="notificationList">
                @foreach (var n in Model)
                {
                    var iconColor = IconColor(n.Type);
                    var icon = Icon(n.Type);
                    var isUnread = !n.IsRead;

                    <div class="notification-item @(isUnread ? "unread" : "read")"
                         data-title="@n.Title"
                         data-message="@n.Message"
                         data-type="@n.Type"
                         data-read="@n.IsRead">

                        <div class="notification-icon" style="background: @(isUnread ? "var(--primary-light)" : "var(--gray-100)");">
                            <i class="fas @icon" style="color: var(--@iconColor);"></i>
                        </div>

                        <div class="notification-content">
                            <div class="notification-header">
                                <span class="notification-title">@n.Title</span>
                                <div class="notification-meta">
                                    @if (isUnread)
                                    {
                                        <span class="unread-indicator">
                                            <i class="fas fa-circle"></i>
                                            New
                                        </span>
                                    }
                                    <span class="notification-time">
                                        <i class="far fa-clock"></i>
                                        @n.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                    </span>
                                </div>
                            </div>
                            <div class="notification-message">@n.Message</div>
                        </div>

                        @if (n.EmployeeDocumentId != null)
                        {
                            <div class="notification-action">
                                <a asp-action="Details" asp-route-id="@n.EmployeeDocumentId" class="action-btn btn-view">
                                    <i class="fas fa-folder-open"></i>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-bell-slash"></i>
                <h3>No notifications</h3>
                <p>Updates about your documents will show up here.</p>
                <a asp-action="Index" class="btn-create-ticket-sm">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        }

        @if (paging != null)
        {
            <div class="pagination-wrapper">
                @await Html.PartialAsync("_Pagination", paging)
            </div>
        }
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== UNREAD BADGE ===== */
    .unread-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        background: #fff5e6;
        color: var(--warning);
        border: 1px solid #ffe0b3;
        margin-left: 0.5rem;
    }

        .unread-badge i {
            font-size: 0.5rem;
            color: var(--warning);
        }

    /* ===== MARK READ BUTTON ===== */
    .btn-mark-read {
        background: white;
        color: var(--primary);
        padding: 0.625rem 1.25rem;
        border-radius: 0.75rem;
        border: 1.5px solid var(--primary);
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Inter', sans-serif;
    }

        .btn-mark-read:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, var(--primary-light), var(--primary));
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== FILTERS CARD ===== */
    .filters-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .filters-header {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .filters-body {
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .filter-group {
        flex: 1;
        min-width: 180px;
    }

        .filter-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--gray-600);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .filter-select {
        width: 100%;
        padding: 0.625rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
        background: white;
        cursor: pointer;
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59,130,246, 0.1);
        }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper i {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            font-size: 0.875rem;
        }

    .search-input {
        width: 100%;
        padding: 0.625rem 0.75rem 0.625rem 2rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
    }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59,130,246, 0.1);
        }

    .btn-clear-filters {
        background: white;
        color: var(--gray-600);
        padding: 0.625rem 1rem;
        border-radius: 0.5rem;
        border: 1.5px solid var(--gray-200);
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
    }

        .btn-clear-filters:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== NOTIFICATION LIST ===== */
    .notification-list {
        padding: 0.5rem 0;
    }

    .notification-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-100);
        transition: all 0.2s ease;
        position: relative;
    }

        .notification-item:hover {
            background: var(--gray-50);
        }

        .notification-item.unread {
            background: linear-gradient(90deg, #f0f7ff, transparent);
            border-left: 3px solid var(--primary);
        }

            .notification-item.unread:hover {
                background: linear-gradient(90deg, #e6f0ff, var(--gray-50));
            }

        .notification-item.read {
            background: white;
            border-left: 3px solid transparent;
        }

            .notification-item.read:hover {
                background: var(--gray-50);
                border-left-color: var(--gray-200);
            }

    /* ===== NOTIFICATION ICON ===== */
    .notification-icon {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.2s ease;
        margin-top: 2px;
    }

        .notification-icon i {
            font-size: 1.1rem;
        }

    .notification-item.unread .notification-icon {
        background: var(--primary-light);
    }

    .notification-item.read .notification-icon {
        background: var(--gray-100);
    }

    /* ===== NOTIFICATION CONTENT ===== */
    .notification-content {
        flex: 1;
        min-width: 0;
    }

    .notification-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.3rem;
    }

    .notification-title {
        font-weight: 600;
        color: var(--gray-800);
        font-size: 0.95rem;
    }

    .notification-item.unread .notification-title {
        color: var(--gray-900);
    }

    .notification-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        flex-shrink: 0;
    }

    .unread-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--primary);
        background: #dbeafe;
        padding: 0.1rem 0.5rem;
        border-radius: 1rem;
        border: 1px solid #bfdbfe;
    }

        .unread-indicator i {
            font-size: 0.35rem;
            color: var(--primary);
        }

    .notification-time {
        font-size: 0.7rem;
        color: var(--gray-400);
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .notification-time i {
            font-size: 0.65rem;
        }

    .notification-message {
        font-size: 0.85rem;
        color: var(--gray-600);
        line-height: 1.5;
        word-wrap: break-word;
    }

    .notification-item.unread .notification-message {
        color: var(--gray-700);
    }

    /* ===== NOTIFICATION ACTION ===== */
    .notification-action {
        flex-shrink: 0;
        margin-top: 2px;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.875rem;
        border: none;
        cursor: pointer;
    }

    .btn-view {
        background: var(--gray-100);
        color: var(--info);
    }

        .btn-view:hover {
            background: var(--info);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--gray-500);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--gray-300);
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--gray-600);
        }

        .empty-state p {
            margin-bottom: 1.5rem;
        }

    .btn-create-ticket-sm {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .btn-create-ticket-sm:hover {
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

    /* ===== PAGINATION ===== */
    .pagination-wrapper {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--gray-200);
        background: var(--gray-50);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .stats-cards {
            grid-template-columns: 1fr 1fr;
        }

        .filters-body {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group {
            min-width: 100%;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .notification-item {
            flex-wrap: wrap;
            padding: 0.75rem 1rem;
        }

        .notification-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .notification-meta {
            width: 100%;
            justify-content: flex-start;
        }

        .notification-action {
            width: 100%;
            text-align: right;
        }

        .page-header .d-flex {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-mark-read {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 576px) {
        .stats-cards {
            grid-template-columns: 1fr;
        }

        .notification-icon {
            width: 32px;
            height: 32px;
        }

            .notification-icon i {
                font-size: 0.9rem;
            }

        .notification-title {
            font-size: 0.85rem;
        }

        .notification-message {
            font-size: 0.8rem;
        }

        .notification-time {
            font-size: 0.65rem;
        }
    }

    /* ===== ANIMATIONS ===== */
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .notification-item {
        animation: slideIn 0.3s ease;
    }

        .notification-item:nth-child(2) {
            animation-delay: 0.05s;
        }

        .notification-item:nth-child(3) {
            animation-delay: 0.1s;
        }

        .notification-item:nth-child(4) {
            animation-delay: 0.15s;
        }

        .notification-item:nth-child(5) {
            animation-delay: 0.2s;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Client-side filtering
        const searchInput = document.querySelector('input[name="q"]');
        const statusFilter = document.querySelector('select[name="status"]');
        const typeFilter = document.querySelector('select[name="type"]');
        const notificationList = document.getElementById('notificationList');
        const items = notificationList ? notificationList.querySelectorAll('.notification-item') : [];
        const visibleCountSpan = document.getElementById('visibleCount');

        function filterNotifications() {
            const searchValue = searchInput ? searchInput.value.toLowerCase() : '';
            const statusValue = statusFilter ? statusFilter.value : '';
            const typeValue = typeFilter ? typeFilter.value : '';

            let visibleCount = 0;

            items.forEach(item => {
                const title = item.getAttribute('data-title')?.toLowerCase() || '';
                const message = item.getAttribute('data-message')?.toLowerCase() || '';
                const type = item.getAttribute('data-type') || '';
                const isRead = item.getAttribute('data-read') === 'True';

                let show = true;

                if (searchValue && !title.includes(searchValue) && !message.includes(searchValue)) {
                    show = false;
                }

                if (statusValue) {
                    if (statusValue === 'unread' && isRead) show = false;
                    if (statusValue === 'read' && !isRead) show = false;
                }

                if (typeValue && type !== typeValue) {
                    show = false;
                }

                if (show) {
                    item.style.display = 'flex';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            if (visibleCountSpan) {
                visibleCountSpan.textContent = visibleCount;
            }

            // Show no results message
            const emptyState = document.querySelector('.empty-state:not(.original)');
            const container = notificationList ? notificationList.parentNode : null;

            if (visibleCount === 0 && items.length > 0) {
                if (!emptyState && container) {
                    const noResultsDiv = document.createElement('div');
                    noResultsDiv.className = 'empty-state';
                    noResultsDiv.innerHTML = `
                        <i class="fas fa-search"></i>
                        <h3>No matching notifications found</h3>
                        <p>Try adjusting your filters or search terms</p>
                    `;
                    container.appendChild(noResultsDiv);
                    if (notificationList) notificationList.style.display = 'none';
                }
            } else {
                if (emptyState) emptyState.remove();
                if (notificationList) notificationList.style.display = '';
            }
        }

        // Attach event listeners
        if (searchInput) {
            searchInput.addEventListener('keyup', filterNotifications);
        }
        if (statusFilter) {
            statusFilter.addEventListener('change', filterNotifications);
        }
        if (typeFilter) {
            typeFilter.addEventListener('change', filterNotifications);
        }

        // Initialize
        filterNotifications();
    });
</script>