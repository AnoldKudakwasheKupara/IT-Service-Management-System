<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Client-side filtering
        const searchInput = document.querySelector('input[name="q"]');
        const statusFilter = document.querySelector('select[name="status"]');
        const departmentFilter = document.querySelector('select[name="departmentId"]');
        const table = document.getElementById('complianceTable');
        const rows = table ? table.querySelectorAll('tbody tr') : [];
        const visibleCountSpan = document.getElementById('visibleCount');

        function filterCompliance() {
            const searchValue = searchInput ? searchInput.value.toLowerCase() : '';
            const statusValue = statusFilter ? statusFilter.value : '';
            const departmentValue = departmentFilter ? departmentFilter.value : '';

            let visibleCount = 0;

            rows.forEach(row => {
                const name = row.getAttribute('data-name')?.toLowerCase() || '';
                const department = row.getAttribute('data-department') || '';
                const percent = parseInt(row.getAttribute('data-percent')) || 0;

                let show = true;

                if (searchValue && !name.includes(searchValue) && !department.toLowerCase().includes(searchValue)) {
                    show = false;
                }

                if (departmentValue && department !== departmentValue) {
                    show = false;
                }

                if (statusValue) {
                    if (statusValue === 'complete' && percent < 100) show = false;
                    if (statusValue === 'incomplete' && percent >= 100) show = false;
                    if (statusValue === 'critical' && percent >= 75) show = false;
                }

                if (show) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCountSpan) {
                visibleCountSpan.textContent = visibleCount;
            }

            // Show no results message
            const emptyState = document.querySelector('.empty-state:not(.original)');
            const tbody = table ? table.querySelector('tbody') : null;

            if (visibleCount === 0 && rows.length > 0) {
                if (!emptyState && tbody) {
                    const noResultsDiv = document.createElement('div');
                    noResultsDiv.className = 'empty-state';
                    noResultsDiv.innerHTML = `
                        <i class="fas fa-search"></i>
                        <h3>No matching employees found</h3>
                        <p>Try adjusting your filters or search terms</p>
                    `;
                    tbody.parentNode.appendChild(noResultsDiv);
                    if (table) table.style.display = 'none';
                }
            } else {
                if (emptyState) emptyState.remove();
                if (table) table.style.display = '';
            }
        }

        // Attach event listeners
        if (searchInput) {
            searchInput.addEventListener('keyup', filterCompliance);
        }
        if (statusFilter) {
            statusFilter.addEventListener('change', filterCompliance);
        }
        if (departmentFilter) {
            departmentFilter.addEventListener('change', filterCompliance);
        }

        // Initialize
        filterCompliance();
    });
</script>