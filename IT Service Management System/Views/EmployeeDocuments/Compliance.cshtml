@model List<IT_Service_Management_System.ViewModels.Efm.ComplianceRow>
@{
    ViewData["Title"] = "File Completeness - Axis IT Operations";
    var avg = Model.Any() ? (int)Math.Round(Model.Average(r => r.Percent)) : 100;
    var incomplete = Model.Count(r => r.Percent < 100);
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h1 class="page-title"><i class="fas fa-clipboard-check me-2" style="color:var(--primary);"></i>File Completeness</h1>
                <p class="text-muted mt-2">Required-document compliance across all employees · avg <strong>@avg%</strong> · @incomplete incomplete</p>
            </div>
            <div class="d-flex gap-2">
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown"><i class="fas fa-download"></i> Export</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-action="ComplianceExport"><i class="fas fa-file-csv me-2"></i>CSV</a></li>
                        <li><a class="dropdown-item" asp-action="ComplianceExportExcel"><i class="fas fa-file-excel me-2"></i>Excel (.xlsx)</a></li>
                        <li><a class="dropdown-item" asp-action="ComplianceExportPdf"><i class="fas fa-file-pdf me-2"></i>PDF</a></li>
                    </ul>
                </div>
                <a asp-action="Dashboard" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Dashboard</a>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div class="stat-info"><h3>@Model.Count</h3><p>Employees</p></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#2c9e6e,#227a55);"><i class="fas fa-circle-check"></i></div>
            <div class="stat-info"><h3>@Model.Count(r => r.Percent == 100)</h3><p>Fully Complete</p></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#f5b042,#e6a017);"><i class="fas fa-triangle-exclamation"></i></div>
            <div class="stat-info"><h3>@incomplete</h3><p>Incomplete</p></div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:linear-gradient(135deg,#3b82f6,#2563eb);"><i class="fas fa-percent"></i></div>
            <div class="stat-info"><h3>@avg%</h3><p>Average</p></div>
        </div>
    </div>

    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-list me-2"></i><span>File Completeness</span></div>
            <div class="record-count"><i class="fas fa-chart-simple"></i> <span>@Model.Count</span> employee(s)</div>
        </div>
        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="data-table">
                    <thead><tr>
                        <th><i class="fas fa-user me-1"></i> Employee</th><th><i class="fas fa-building me-1"></i> Department</th>
                        <th style="width:240px;"><i class="fas fa-clipboard-check me-1"></i> Completeness</th><th><i class="fas fa-triangle-exclamation me-1"></i> Missing</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var cls = r.Percent == 100 ? "bg-success" : r.Percent >= 75 ? "bg-warning" : "bg-danger";
                            var initials = r.EmployeeName.Length > 0 ? string.Concat(r.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])) : "U";
                            <tr>
                                <td class="creator-cell">
                                    <div class="list-avatar-cell">
                                        <div class="list-avatar">@initials</div>
                                        <a asp-action="File" asp-route-id="@r.EmployeeId" style="text-decoration:none;font-weight:600;color:var(--gray-800);">@r.EmployeeName</a>
                                    </div>
                                </td>
                                <td>@(r.Department ?? "—")</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:7px;"><div class="progress-bar @cls" style="width:@r.Percent%"></div></div>
                                        <span class="status-badge @(r.Percent == 100 ? "badge-green" : r.Percent >= 75 ? "badge-amber" : "badge-red")">@r.Percent%</span>
                                    </div>
                                </td>
                                <td style="font-size:0.8rem;color:var(--gray-600);">@(string.IsNullOrEmpty(r.Missing) ? "—" : r.Missing)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><i class="fas fa-clipboard-check"></i><h3>Nothing to report</h3><p>No employees to evaluate.</p></div>
            }
        </div>
    </div>
</div>
