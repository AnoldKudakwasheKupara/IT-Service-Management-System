@model List<IT_Service_Management_System.Models.Efm.DocumentApproval>
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "Document Approvals - Axis IT Operations";
    var history = ViewBag.History == true;
    var paging = ViewBag.Paging as IT_Service_Management_System.Helpers.PagingInfo;
    var pending = ViewBag.PendingCount as int? ?? 0;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-clipboard-check me-2" style="color: var(--primary);"></i>
                    Document Approvals
                </h1>
                <p class="text-muted mt-2">Review employee-submitted documents. Approve to file them, or reject with a reason.</p>
            </div>
            <div class="approval-toggle-group">
                <a asp-action="Approvals" class="toggle-btn @(history ? "toggle-btn-outline" : "toggle-btn-primary")">
                    <i class="fas fa-hourglass-half"></i>
                    Pending
                    <span class="toggle-badge">@pending</span>
                </a>
                <a asp-action="Approvals" asp-route-history="true" class="toggle-btn @(history ? "toggle-btn-primary" : "toggle-btn-outline")">
                    <i class="fas fa-clock-rotate-left"></i>
                    History
                </a>
            </div>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--primary-light), var(--primary));">
                <i class="fas fa-file-lines"></i>
            </div>
            <div class="stat-info">
                <h3>@(paging?.TotalCount ?? Model.Count)</h3>
                <p>Total Approvals</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f5b042, #e6a017);">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="stat-info">
                <h3>@pending</h3>
                <p>Pending Review</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #2c9e6e, #227a55);">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(a => a.Status == ApprovalStatus.Approved)</h3>
                <p>Approved</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #e53e3e, #c53030);">
                <i class="fas fa-xmark-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count(a => a.Status == ApprovalStatus.Rejected)</h3>
                <p>Rejected</p>
            </div>
        </div>
    </div>

    <!-- FILTERS CARD -->
    <div class="filters-card mb-4">
        <div class="filters-header">
            <i class="fas fa-filter"></i>
            <span>Filter Approvals</span>
        </div>
        <form method="get" asp-action="Approvals" class="filters-body">
            <input type="hidden" name="history" value="@history.ToString().ToLower()" />
            <div class="filter-group" style="flex: 2;">
                <label>Search</label>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="@ViewBag.Search" placeholder="Search by document or employee..." class="search-input">
                </div>
            </div>
            <div class="filter-group">
                <label>Category</label>
                <select name="category" class="filter-select">
                    <option value="">All Categories</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (SelectList)ViewBag.Categories)
                        {
                            <option value="@cat.Value">@cat.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Level</label>
                <select name="level" class="filter-select">
                    <option value="">All Levels</option>
                    <option value="1">Level 1</option>
                    <option value="2">Level 2</option>
                    <option value="3">Level 3</option>
                    <option value="4">Level 4</option>
                </select>
            </div>
            <button type="submit" class="btn-clear-filters" style="background:var(--primary,#b11d23);color:#fff;border:none;">
                <i class="fas fa-search"></i>
                Apply
            </button>
            <a asp-action="Approvals" asp-route-history="@history.ToString().ToLower()" class="btn-clear-filters" style="text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                <i class="fas fa-undo-alt"></i>
                Clear
            </a>
        </form>
    </div>

    <!-- MAIN DATA CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-file-lines me-2"></i>
                <span>@(history ? "Decisions" : "Awaiting Decision")</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span id="visibleCount">@(paging?.TotalCount ?? Model.Count)</span>
                @(history ? "decisions" : "pending")
            </div>
        </div>

        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="data-table tickets-table" id="approvalsTable">
                    <thead>
                        <tr>
                            <th><i class="fas fa-file me-1"></i> Document</th>
                            <th><i class="fas fa-user me-1"></i> Employee</th>
                            <th><i class="fas fa-tag me-1"></i> Category</th>
                            <th><i class="fas fa-layer-group me-1"></i> Level</th>
                            <th><i class="fas fa-calendar me-1"></i> Submitted</th>
                            <th style="text-align:right;">@(history ? "Decision" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var d = a.Document!;
                            var initials = d.Employee != null ?
                                ((d.Employee.FirstName?.Substring(0, 1) ?? "U") + (d.Employee.LastName?.Substring(0, 1) ?? "")) : "U";

                            <tr data-title="@d.Title" data-employee="@(d.Employee?.FullName ?? "")" data-category="@(d.Category?.Name ?? "")" data-level="@a.Level">
                                <td>
                                    <div class="document-info">
                                        <i class="fas fa-file-lines document-icon"></i>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@d.Id" class="document-link">
                                                @d.Title
                                            </a>
                                            <span class="document-version">@(d.CurrentVersion?.FileName ?? "—")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="employee-info">
                                        <div class="employee-avatar">@initials</div>
                                        <span class="employee-name">@d.Employee?.FullName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="category-badge">@(d.Category?.Name ?? "—")</span>
                                </td>
                                <td>
                                    <span class="level-badge level-@a.Level">
                                        <i class="fas fa-layer-group"></i>
                                        Level @a.Level
                                    </span>
                                </td>
                                <td class="date-cell">
                                    <i class="far fa-calendar-alt"></i>
                                    @a.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                @if (history)
                                {
                                    <td style="text-align:right;">
                                        <div class="decision-info">
                                            @if (a.Status == ApprovalStatus.Approved)
                                            {
                                                <span class="status-badge status-resolved">
                                                    <i class="fas fa-check-circle"></i> Approved
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-closed">
                                                    <i class="fas fa-times-circle"></i> Rejected
                                                </span>
                                            }
                                            <div class="decision-meta">
                                                <span>@a.DecidedByName</span>
                                                <span>·</span>
                                                <span>@a.DecidedAt?.ToString("MMM dd, yyyy")</span>
                                                @if (!string.IsNullOrWhiteSpace(a.Comments))
                                                {
                                                    <div class="decision-comment">
                                                        <i class="fas fa-quote-left"></i>
                                                        @a.Comments
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td style="text-align:right;">
                                        <div class="action-buttons">
                                            <a class="action-btn btn-preview" asp-action="Preview" asp-route-id="@d.Id" target="_blank" title="Preview Document">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <form asp-action="Approve" method="post" style="display:inline;" onsubmit="return confirm('Approve this document?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="approvalId" value="@a.Id" />
                                                <button class="action-btn btn-approve" title="Approve">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            <button class="action-btn btn-reject" title="Reject"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                    onclick="setReject(@a.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(d.Title))')">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-clipboard-check"></i>
                    <h3>@(history ? "No history yet" : "All caught up")</h3>
                    <p>@(history ? "No approval decisions have been recorded yet." : "Nothing is waiting for approval.")</p>
                    @if (!history)
                    {
                        <a asp-action="Dashboard" class="btn-create-ticket-sm">
                            <i class="fas fa-arrow-left"></i> Back to Dashboard
                        </a>
                    }
                </div>
            }
        </div>

        @if (paging != null)
        {
            <div class="pagination-wrapper">
                @await Html.PartialAsync("_Pagination", paging)
            </div>
        }
    </div>
</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content custom-modal">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="approvalId" id="rejectApprovalId" />

                <div class="modal-header-custom">
                    <div class="modal-title-custom">
                        <i class="fas fa-times-circle me-2" style="color: var(--danger);"></i>
                        Reject Document
                    </div>
                    <button type="button" class="modal-close" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="modal-body-custom">
                    <p class="modal-info-text">
                        Rejecting <strong id="rejectTitle"></strong>. The employee will be notified by email with your reason.
                    </p>
                    <div class="modal-form-group">
                        <label class="modal-label">
                            Reason <span class="text-danger">*</span>
                        </label>
                        <textarea name="comments" class="modal-textarea" rows="3" required maxlength="1000" placeholder="Explain what needs to change…"></textarea>
                    </div>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn-modal-reject">
                        <i class="fas fa-times"></i>
                        Reject &amp; Notify
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== TOGGLE BUTTONS ===== */
    .approval-toggle-group {
        display: inline-flex;
        background: white;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .toggle-btn {
        padding: 0.625rem 1.25rem;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        border: none;
    }

    .toggle-btn-primary {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
    }

        .toggle-btn-primary:hover {
            color: white;
            text-decoration: none;
            filter: brightness(1.05);
        }

    .toggle-btn-outline {
        background: transparent;
        color: var(--gray-600);
    }

        .toggle-btn-outline:hover {
            background: var(--gray-50);
            color: var(--gray-700);
            text-decoration: none;
        }

    .toggle-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.2);
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.05rem 0.5rem;
        border-radius: 1rem;
        min-width: 24px;
    }

    .toggle-btn-outline .toggle-badge {
        background: var(--gray-100);
        color: var(--gray-600);
    }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== FILTERS CARD ===== */
    .filters-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .filters-header {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .filters-body {
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .filter-group {
        flex: 1;
        min-width: 180px;
    }

        .filter-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--gray-600);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .filter-select {
        width: 100%;
        padding: 0.625rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
        background: white;
        cursor: pointer;
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
        }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper i {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            font-size: 0.875rem;
        }

    .search-input {
        width: 100%;
        padding: 0.625rem 0.75rem 0.625rem 2rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
    }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
        }

    .btn-clear-filters {
        background: white;
        color: var(--gray-600);
        padding: 0.625rem 1rem;
        border-radius: 0.5rem;
        border: 1.5px solid var(--gray-200);
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
    }

        .btn-clear-filters:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    .table-responsive {
        overflow-x: auto;
    }

    /* ===== TABLE STYLES ===== */
    .data-table.tickets-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table.tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .data-table.tickets-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .data-table.tickets-table td {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .data-table.tickets-table tbody tr {
            transition: background-color 0.2s;
        }

            .data-table.tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

    /* ===== DOCUMENT INFO ===== */
    .document-info {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .document-icon {
        font-size: 1.1rem;
        color: var(--primary);
        margin-top: 0.1rem;
    }

    .document-link {
        font-weight: 600;
        color: var(--gray-800);
        text-decoration: none;
        transition: color 0.2s;
        display: block;
    }

        .document-link:hover {
            color: var(--primary);
            text-decoration: underline;
        }

    .document-version {
        font-size: 0.7rem;
        color: var(--gray-500);
        display: block;
        margin-top: 0.05rem;
    }

    /* ===== EMPLOYEE INFO ===== */
    .employee-info {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .employee-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: white;
        font-weight: 700;
        font-size: 0.7rem;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        flex-shrink: 0;
    }

    .employee-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    /* ===== CATEGORY BADGE ===== */
    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #fdf3f3;
        color: var(--primary-dark);
        border: 1px solid #f4ced0;
        padding: 0.2rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.72rem;
        font-weight: 600;
    }

    /* ===== LEVEL BADGE ===== */
    .level-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.72rem;
        font-weight: 600;
    }

    .level-1 {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .level-2 {
        background: #fceaeb;
        color: var(--info);
        border: 1px solid #f4ced0;
    }

    .level-3 {
        background: #fff5e6;
        color: var(--warning);
        border: 1px solid #ffe0b3;
    }

    .level-4 {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-resolved {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .status-closed {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    /* ===== DECISION INFO ===== */
    .decision-info {
        display: flex;
