@model List<IT_Service_Management_System.Models.Efm.DocumentApproval>
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "Document Approvals - Axis IT Operations";
    var history = ViewBag.History == true;
    var paging = ViewBag.Paging as IT_Service_Management_System.Helpers.PagingInfo;
    var pending = ViewBag.PendingCount as int? ?? 0;
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h1 class="page-title"><i class="fas fa-clipboard-check me-2" style="color:var(--primary);"></i>Document Approvals</h1>
                <p class="text-muted mt-2">Review employee-submitted documents. Approve to file them, or reject with a reason.</p>
            </div>
            <div class="btn-group">
                <a asp-action="Approvals" class="btn @(history ? "btn-outline-primary" : "btn-primary")">
                    <i class="fas fa-hourglass-half"></i> Pending <span class="badge bg-light text-dark ms-1">@pending</span>
                </a>
                <a asp-action="Approvals" asp-route-history="true" class="btn @(history ? "btn-primary" : "btn-outline-primary")">
                    <i class="fas fa-clock-rotate-left"></i> History
                </a>
            </div>
        </div>
    </div>

    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-file-lines me-2"></i><span>@(history ? "Decided" : "Awaiting decision")</span></div>
            <span class="record-count">@(paging?.TotalCount ?? Model.Count)</span>
        </div>
        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-file me-1"></i> Document</th><th><i class="fas fa-user me-1"></i> Employee</th>
                            <th><i class="fas fa-tag me-1"></i> Category</th><th><i class="fas fa-layer-group me-1"></i> Level</th>
                            <th><i class="fas fa-calendar me-1"></i> Submitted</th><th style="text-align:right;">@(history ? "Decision" : "Actions")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            var d = a.Document!;
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@d.Id" class="fw-semibold" style="text-decoration:none;color:var(--gray-800);">@d.Title</a>
                                    <div class="text-muted" style="font-size:0.72rem;">@(d.CurrentVersion?.FileName ?? "—")</div>
                                </td>
                                <td class="creator-cell">
                                    <div class="list-avatar-cell">
                                        <div class="list-avatar">@((d.Employee?.FirstName?.Substring(0,1) ?? "U") + (d.Employee?.LastName?.Substring(0,1) ?? ""))</div>
                                        <span>@d.Employee?.FullName</span>
                                    </div>
                                </td>
                                <td>@d.Category?.Name</td>
                                <td><span class="status-badge badge-gray">Level @a.Level</span></td>
                                <td class="date-cell"><i class="far fa-calendar-alt"></i> @a.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                @if (history)
                                {
                                    <td style="text-align:right;">
                                        @if (a.Status == ApprovalStatus.Approved) { <span class="status-badge badge-green"><i class="fas fa-check"></i> Approved</span> }
                                        else { <span class="status-badge badge-red"><i class="fas fa-xmark"></i> Rejected</span> }
                                        <div class="text-muted" style="font-size:0.72rem;">
                                            @a.DecidedByName · @a.DecidedAt?.ToString("MMM dd, yyyy")
                                            @if (!string.IsNullOrWhiteSpace(a.Comments)) { <text><br />“@a.Comments”</text> }
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <div class="action-buttons" style="justify-content:flex-end;">
                                            <a class="action-btn btn-view" asp-action="Preview" asp-route-id="@d.Id" target="_blank" title="Preview"><i class="fas fa-eye"></i></a>
                                            <form asp-action="Approve" method="post" style="display:inline;" onsubmit="return confirm('Approve this document?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="approvalId" value="@a.Id" />
                                                <button class="action-btn btn-approve" title="Approve"><i class="fas fa-check"></i></button>
                                            </form>
                                            <button class="action-btn btn-delete" title="Reject"
                                                    data-bs-toggle="modal" data-bs-target="#rejectModal"
                                                    onclick="setReject(@a.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(d.Title))')">
                                                <i class="fas fa-xmark"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-clipboard-check"></i>
                    <h3>@(history ? "No history yet" : "All caught up")</h3>
                    <p>@(history ? "No approval decisions have been recorded yet." : "Nothing is waiting for approval.")</p>
                </div>
            }
        </div>
        @if (paging != null) { <partial name="_Pagination" model="paging" /> }
    </div>
</div>

<!-- Reject modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="approvalId" id="rejectApprovalId" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-xmark me-2 text-danger"></i>Reject Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" style="font-size:0.85rem;">Rejecting <strong id="rejectTitle"></strong>. The employee is notified by email with your reason.</p>
                    <label class="form-label fw-semibold">Reason <span class="text-danger">*</span></label>
                    <textarea name="comments" class="form-control" rows="3" required maxlength="1000" placeholder="Explain what needs to change…"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger"><i class="fas fa-xmark"></i> Reject &amp; Notify</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setReject(id, title) {
        document.getElementById('rejectApprovalId').value = id;
        document.getElementById('rejectTitle').textContent = title;
    }
</script>
