<script>
    function setReject(id, title) {
        document.getElementById('rejectApprovalId').value = id;
        document.getElementById('rejectTitle').textContent = title;
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Client-side filtering
        const searchInput = document.querySelector('input[name="q"]');
        const categoryFilter = document.querySelector('select[name="category"]');
        const levelFilter = document.querySelector('select[name="level"]');
        const table = document.getElementById('approvalsTable');
        const rows = table ? table.querySelectorAll('tbody tr') : [];
        const visibleCountSpan = document.getElementById('visibleCount');

        function filterApprovals() {
            const searchValue = searchInput ? searchInput.value.toLowerCase() : '';
            const categoryValue = categoryFilter ? categoryFilter.value : '';
            const levelValue = levelFilter ? levelFilter.value : '';

            let visibleCount = 0;

            rows.forEach(row => {
                const title = row.getAttribute('data-title')?.toLowerCase() || '';
                const employee = row.getAttribute('data-employee')?.toLowerCase() || '';
                const category = row.getAttribute('data-category') || '';
                const level = row.getAttribute('data-level') || '';

                let show = true;

                if (searchValue && !title.includes(searchValue) && !employee.includes(searchValue)) {
                    show = false;
                }

                if (categoryValue && category !== categoryValue) {
                    show = false;
                }

                if (levelValue && level !== levelValue) {
                    show = false;
                }

                if (show) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCountSpan) {
                visibleCountSpan.textContent = visibleCount;
            }

            // Show no results message
            const emptyState = document.querySelector('.empty-state:not(.original)');
            const tbody = table ? table.querySelector('tbody') : null;

            if (visibleCount === 0 && rows.length > 0) {
                if (!emptyState && tbody) {
                    const noResultsDiv = document.createElement('div');
                    noResultsDiv.className = 'empty-state';
                    noResultsDiv.innerHTML = `
                        <i class="fas fa-search"></i>
                        <h3>No matching approvals found</h3>
                        <p>Try adjusting your filters or search terms</p>
                    `;
                    tbody.parentNode.appendChild(noResultsDiv);
                    if (table) table.style.display = 'none';
                }
            } else {
                if (emptyState) emptyState.remove();
                if (table) table.style.display = '';
            }
        }

        // Attach event listeners
        if (searchInput) {
            searchInput.addEventListener('keyup', filterApprovals);
        }
        if (categoryFilter) {
            categoryFilter.addEventListener('change', filterApprovals);
        }
        if (levelFilter) {
            levelFilter.addEventListener('change', filterApprovals);
        }

        // Initialize
        filterApprovals();
    });
</script>