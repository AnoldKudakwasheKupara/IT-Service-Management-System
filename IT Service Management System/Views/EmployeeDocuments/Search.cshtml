@model IT_Service_Management_System.ViewModels.Efm.DocumentSearchVm
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "Search Documents - Axis IT Operations";
    var paging = ViewBag.Paging as IT_Service_Management_System.Helpers.PagingInfo;
    var returnUrl = Url.Action("Search", new { q = Model.Q, folderId = Model.FolderId, categoryId = Model.CategoryId, status = Model.Status, expiry = Model.Expiry, archived = Model.Archived });
    string StatusBadge(DocumentStatus s) => s switch {
        DocumentStatus.Active or DocumentStatus.Approved => "badge-green",
        DocumentStatus.PendingApproval => "badge-amber",
        DocumentStatus.Rejected or DocumentStatus.Expired => "badge-red",
        _ => "badge-gray" };
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h1 class="page-title"><i class="fas fa-magnifying-glass me-2" style="color:var(--primary);"></i>Search Documents</h1>
                <p class="text-muted mt-2">Full-text search across every employee file — name, number, department, category, tags, keywords, OCR content</p>
            </div>
            <a asp-action="Index" class="btn-create"><i class="fas fa-users me-1"></i> Employee Files</a>
        </div>
        <div class="btn-group mt-2">
            <a asp-action="Search" asp-route-q="@Model.Q" asp-route-folderId="@Model.FolderId" asp-route-categoryId="@Model.CategoryId"
               class="btn btn-sm @(Model.Archived ? "btn-outline-primary" : "btn-primary")"><i class="fas fa-folder-open"></i> Active files</a>
            <a asp-action="Search" asp-route-archived="true" asp-route-q="@Model.Q" asp-route-folderId="@Model.FolderId" asp-route-categoryId="@Model.CategoryId"
               class="btn btn-sm @(Model.Archived ? "btn-primary" : "btn-outline-primary")"><i class="fas fa-box-archive"></i> Archived</a>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters-card">
        <div class="filters-header"><i class="fas fa-filter"></i><span>Filter Documents</span></div>
        <form method="get" asp-action="Search" class="filters-body">
            <input type="hidden" name="archived" value="@Model.Archived.ToString().ToLower()" />
            <div class="filter-group" style="flex:2;min-width:240px;">
                <label>Search</label>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="@Model.Q" class="search-input" placeholder="Documents, employees, tags, content…" autofocus />
                </div>
            </div>
            <div class="filter-group">
                <label>Folder</label>
                <select name="folderId" class="filter-select">
                    <option value="">All folders</option>
                    @foreach (var f in Model.Folders) { <option value="@f.Id" selected="@(Model.FolderId == f.Id)">@f.Name</option> }
                </select>
            </div>
            <div class="filter-group">
                <label>Category</label>
                <select name="categoryId" class="filter-select">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option> }
                </select>
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select name="status" class="filter-select">
                    <option value="">Any status</option>
                    @foreach (var st in Enum.GetValues<DocumentStatus>()) { <option value="@st" selected="@(Model.Status == st)">@st</option> }
                </select>
            </div>
            <div class="filter-group">
                <label>Expiry</label>
                <select name="expiry" class="filter-select">
                    <option value="">Any expiry</option>
                    <option value="expiring" selected="@(Model.Expiry == "expiring")">Expiring ≤30d</option>
                    <option value="expired" selected="@(Model.Expiry == "expired")">Expired</option>
                </select>
            </div>
            <div class="filter-group">
                <label>From</label>
                <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="filter-select" />
            </div>
            <div class="filter-group">
                <label>To</label>
                <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="filter-select" />
            </div>
            <button type="submit" class="btn-clear-filters" style="background:var(--primary);color:#fff;border:none;"><i class="fas fa-search"></i> Search</button>
            <a asp-action="Search" asp-route-archived="@Model.Archived.ToString().ToLower()" class="btn-clear-filters"><i class="fas fa-undo-alt"></i> Clear</a>
        </form>
    </div>

    <!-- Results -->
    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-file-lines me-2"></i><span>Results</span></div>
            <div class="record-count"><i class="fas fa-chart-simple"></i> <span>@(paging?.TotalCount ?? Model.Results.Count)</span> match(es)</div>
        </div>
        <div class="table-responsive">
            @if (Model.Results.Any())
            {
                <table class="data-table">
                    <thead><tr>
                        <th><i class="fas fa-user me-1"></i> Employee</th><th><i class="fas fa-file me-1"></i> Document</th>
                        <th><i class="fas fa-tag me-1"></i> Category</th><th><i class="fas fa-folder me-1"></i> Folder</th>
                        <th><i class="fas fa-chart-simple me-1"></i> Status</th><th><i class="fas fa-hourglass-half me-1"></i> Expiry</th>
                        <th><i class="fas fa-calendar me-1"></i> Uploaded</th><th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var d in Model.Results)
                        {
                            <tr>
                                <td class="creator-cell">
                                    <div class="list-avatar-cell">
                                        <div class="list-avatar">@((d.Employee?.FirstName?.Substring(0,1) ?? "U") + (d.Employee?.LastName?.Substring(0,1) ?? ""))</div>
                                        <span>@d.Employee?.FullName</span>
                                    </div>
                                </td>
                                <td><a asp-action="Details" asp-route-id="@d.Id" class="fw-semibold" style="text-decoration:none;color:var(--gray-800);">@d.Title</a></td>
                                <td>@d.Category?.Name</td>
                                <td>@d.Folder?.Name</td>
                                <td><span class="status-badge @StatusBadge(d.Status)">@d.Status</span></td>
                                <td>
                                    @if (d.ExpiryDate == null) { <span class="text-muted">—</span> }
                                    else if (d.IsExpired) { <span class="status-badge badge-red">Expired</span> }
                                    else if (d.DaysUntilExpiry <= 30) { <span class="status-badge badge-amber">@d.ExpiryDate?.ToString("MMM dd")</span> }
                                    else { <span class="date-cell">@d.ExpiryDate?.ToString("MMM dd, yyyy")</span> }
                                </td>
                                <td class="date-cell"><i class="far fa-calendar-alt"></i> @d.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="action-buttons" style="justify-content:flex-end;">
                                        <a class="action-btn btn-view" asp-action="Preview" asp-route-id="@d.Id" target="_blank" title="Preview"><i class="fas fa-eye"></i></a>
                                        <a class="action-btn btn-download" asp-action="Download" asp-route-id="@d.Id" title="Download"><i class="fas fa-download"></i></a>
                                        @if (Model.Archived)
                                        {
                                            <form asp-action="Restore" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button class="action-btn btn-approve" title="Restore from archive"><i class="fas fa-box-open"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Archive" method="post" style="display:inline;" onsubmit="return confirm('Archive this document?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@d.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button class="action-btn btn-edit" title="Archive"><i class="fas fa-box-archive"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-magnifying-glass"></i>
                    <h3>No documents found</h3>
                    <p>Try adjusting your search terms or filters.</p>
                </div>
            }
        </div>
        @if (paging != null)
        {
            <partial name="_Pagination" model="paging" />
        }
    </div>
</div>
