@model IT_Service_Management_System.ViewModels.Efm.DocumentAuditVm
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "Document Audit Trail - Axis IT Operations";
    var paging = ViewBag.Paging as IT_Service_Management_System.Helpers.PagingInfo;
    string Browser(string? ua)
    {
        if (string.IsNullOrEmpty(ua)) return "—";
        return ua.Contains("Edg") ? "Edge" : ua.Contains("Chrome") ? "Chrome" : ua.Contains("Firefox") ? "Firefox"
            : ua.Contains("Safari") ? "Safari" : "Other";
    }
    string ActionClass(DocumentAuditAction a) => a switch {
        DocumentAuditAction.Uploaded or DocumentAuditAction.VersionUploaded or DocumentAuditAction.Approved or DocumentAuditAction.Restored => "badge-green",
        DocumentAuditAction.Deleted or DocumentAuditAction.Rejected => "badge-red",
        DocumentAuditAction.VersionRestored or DocumentAuditAction.Archived => "badge-amber",
        _ => "badge-gray" };
    // preserve current filters for the export link
    var exportRoute = new Dictionary<string, string?> {
        ["q"] = Model.Q, ["action"] = Model.Action?.ToString(),
        ["employeeId"] = Model.EmployeeId?.ToString(), ["documentId"] = Model.DocumentId?.ToString(),
        ["from"] = Model.From?.ToString("yyyy-MM-dd"), ["to"] = Model.To?.ToString("yyyy-MM-dd")
    };
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h1 class="page-title"><i class="fas fa-clipboard-list me-2" style="color:var(--primary);"></i>Document Audit Trail</h1>
                <p class="text-muted mt-2">
                    Every view, download, upload, version and delete — with user, IP and browser
                    @if (Model.EmployeeName != null) { <text>· <strong>@Model.EmployeeName</strong></text> }
                    @if (Model.DocumentTitle != null) { <text>· <strong>@Model.DocumentTitle</strong></text> }
                </p>
            </div>
            <div class="d-flex gap-2">
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown"><i class="fas fa-download"></i> Export</button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-action="AuditExport" asp-all-route-data="exportRoute"><i class="fas fa-file-csv me-2"></i>CSV</a></li>
                        <li><a class="dropdown-item" asp-action="AuditExportExcel" asp-all-route-data="exportRoute"><i class="fas fa-file-excel me-2"></i>Excel (.xlsx)</a></li>
                        <li><a class="dropdown-item" asp-action="AuditExportPdf" asp-all-route-data="exportRoute"><i class="fas fa-file-pdf me-2"></i>PDF</a></li>
                    </ul>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
        </div>
    </div>

    <div class="filters-card">
        <div class="filters-header"><i class="fas fa-filter"></i><span>Filter Activity</span></div>
        <form method="get" asp-action="Audit" class="filters-body">
            @if (Model.EmployeeId.HasValue) { <input type="hidden" name="employeeId" value="@Model.EmployeeId" /> }
            @if (Model.DocumentId.HasValue) { <input type="hidden" name="documentId" value="@Model.DocumentId" /> }
            <div class="filter-group">
                <label>Search</label>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="@Model.Q" class="search-input" placeholder="User, details, IP…" />
                </div>
            </div>
            <div class="filter-group">
                <label>Action</label>
                <select name="action" class="filter-select">
                    <option value="">Any action</option>
                    @foreach (var a in Enum.GetValues<DocumentAuditAction>())
                    {
                        <option value="@a" selected="@(Model.Action == a)">@a</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>From</label>
                <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="filter-select" />
            </div>
            <div class="filter-group">
                <label>To</label>
                <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="filter-select" />
            </div>
            <button type="submit" class="btn-clear-filters" style="background:var(--primary);color:#fff;border:none;"><i class="fas fa-search"></i> Filter</button>
            <a asp-action="Audit" class="btn-clear-filters"><i class="fas fa-undo-alt"></i> Clear</a>
        </form>
    </div>

    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-list me-2"></i><span>Activity</span></div>
            <span class="record-count">@(paging?.TotalCount ?? Model.Rows.Count) event(s)</span>
        </div>
        <div class="table-responsive">
            @if (Model.Rows.Any())
            {
                <table class="data-table">
                    <thead><tr>
                        <th><i class="fas fa-clock me-1"></i> When</th><th><i class="fas fa-bolt me-1"></i> Action</th>
                        <th><i class="fas fa-user me-1"></i> By</th><th><i class="fas fa-user-tie me-1"></i> Employee</th>
                        <th><i class="fas fa-file me-1"></i> Document</th><th><i class="fas fa-network-wired me-1"></i> IP</th>
                        <th><i class="fas fa-window-maximize me-1"></i> Browser</th><th><i class="fas fa-circle-info me-1"></i> Details</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td style="white-space:nowrap;">@r.Timestamp.ToString("MMM dd, yyyy HH:mm")</td>
                                <td><span class="status-badge @ActionClass(r.Action)">@r.Action</span></td>
                                <td>@(r.PerformedByName ?? "—")</td>
                                <td>@(r.EmployeeName ?? "—")</td>
                                <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                    @if (r.EmployeeDocumentId != null) { <a asp-action="Details" asp-route-id="@r.EmployeeDocumentId" style="text-decoration:none;">@(r.DocumentTitle ?? $"#{r.EmployeeDocumentId}")</a> }
                                    else { <text>—</text> }
                                </td>
                                <td>@(r.IpAddress ?? "—")</td>
                                <td>@Browser(r.UserAgent)</td>
                                <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@r.Details">@r.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-clipboard-list"></i>
                    <h3>No audit events</h3>
                    <p>No activity matches your filters.</p>
                </div>
            }
        </div>
        @if (paging != null) { <partial name="_Pagination" model="paging" /> }
    </div>
</div>
