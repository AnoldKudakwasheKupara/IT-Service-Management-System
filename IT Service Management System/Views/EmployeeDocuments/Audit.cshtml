@model IT_Service_Management_System.ViewModels.Efm.DocumentAuditVm
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "Document Audit Trail - Axis IT Operations";
    var paging = ViewBag.Paging as IT_Service_Management_System.Helpers.PagingInfo;

    string Browser(string? ua)
    {
        if (string.IsNullOrEmpty(ua)) return "—";
        return ua.Contains("Edg") ? "Edge" : ua.Contains("Chrome") ? "Chrome" : ua.Contains("Firefox") ? "Firefox"
            : ua.Contains("Safari") ? "Safari" : "Other";
    }

    string ActionClass(DocumentAuditAction a) => a switch
    {
        DocumentAuditAction.Uploaded or DocumentAuditAction.VersionUploaded or DocumentAuditAction.Approved or DocumentAuditAction.Restored => "badge-success",
        DocumentAuditAction.Deleted or DocumentAuditAction.Rejected => "badge-danger",
        DocumentAuditAction.VersionRestored or DocumentAuditAction.Archived => "badge-warning",
        _ => "badge-default"
    };

    string ActionIcon(DocumentAuditAction a) => a switch
    {
        DocumentAuditAction.Uploaded => "fa-cloud-upload-alt",
        DocumentAuditAction.VersionUploaded => "fa-upload",
        DocumentAuditAction.Downloaded => "fa-download",
        DocumentAuditAction.Viewed => "fa-eye",
        DocumentAuditAction.Deleted => "fa-trash",
        DocumentAuditAction.Approved => "fa-check-circle",
        DocumentAuditAction.Rejected => "fa-times-circle",
        DocumentAuditAction.Restored => "fa-undo",
        DocumentAuditAction.VersionRestored => "fa-history",
        DocumentAuditAction.Archived => "fa-archive",
        _ => "fa-circle"
    };

    // Preserve current filters for the export link
    var exportRoute = new Dictionary<string, string?>
    {
        ["q"] = Model.Q,
        ["action"] = Model.Action?.ToString(),
        ["employeeId"] = Model.EmployeeId?.ToString(),
        ["documentId"] = Model.DocumentId?.ToString(),
        ["from"] = Model.From?.ToString("yyyy-MM-dd"),
        ["to"] = Model.To?.ToString("yyyy-MM-dd")
    };
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-clipboard-list me-2" style="color: var(--primary);"></i>
                    Document Audit Trail
                </h1>
                <p class="text-muted mt-2">
                    <i class="fas fa-history me-1"></i>
                    Every view, download, upload, version and delete — with user, IP and browser
                    @if (Model.EmployeeName != null)
                    {
                        <span class="filter-indicator">
                            <i class="fas fa-user"></i>
                            <strong>@Model.EmployeeName</strong>
                        </span>
                    }
                    @if (Model.DocumentTitle != null)
                    {
                        <span class="filter-indicator">
                            <i class="fas fa-file"></i>
                            <strong>@Model.DocumentTitle</strong>
                        </span>
                    }
                </p>
            </div>
            <div class="d-flex gap-2">
                <div class="btn-group-export">
                    <button type="button" class="btn-export dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-download"></i>
                        Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-action="AuditExport" asp-all-route-data="exportRoute">
                                <i class="fas fa-file-csv me-2"></i>CSV
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-action="AuditExportExcel" asp-all-route-data="exportRoute">
                                <i class="fas fa-file-excel me-2"></i>Excel (.xlsx)
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-action="AuditExportPdf" asp-all-route-data="exportRoute">
                                <i class="fas fa-file-pdf me-2"></i>PDF
                            </a>
                        </li>
                    </ul>
                </div>
                <a asp-action="Index" class="btn-back" title="Back to Dashboard">
                    <i class="fas fa-arrow-left"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--primary-light), var(--primary));">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>@(paging?.TotalCount ?? Model.Rows.Count)</h3>
                <p>Total Events</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #2c9e6e, #227a55);">
                <i class="fas fa-cloud-upload-alt"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Rows.Count(r => r.Action == DocumentAuditAction.Uploaded || r.Action == DocumentAuditAction.VersionUploaded)</h3>
                <p>Uploads</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #b11d23, #8f171c);">
                <i class="fas fa-eye"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Rows.Count(r => r.Action == DocumentAuditAction.Viewed)</h3>
                <p>Views</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                <i class="fas fa-download"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Rows.Count(r => r.Action == DocumentAuditAction.Downloaded)</h3>
                <p>Downloads</p>
            </div>
        </div>
    </div>

    <!-- FILTERS CARD -->
    <div class="filters-card mb-4">
        <div class="filters-header">
            <i class="fas fa-filter"></i>
            <span>Filter Activity</span>
            @if (Model.EmployeeId.HasValue || Model.DocumentId.HasValue || !string.IsNullOrEmpty(Model.Q) || Model.Action.HasValue || Model.From.HasValue || Model.To.HasValue)
            {
                <span class="active-filters-badge">
                    <i class="fas fa-check-circle"></i>
                    Filters Active
                </span>
            }
        </div>
        <form method="get" asp-action="Audit" class="filters-body">
            @if (Model.EmployeeId.HasValue)
            {
                <input type="hidden" name="employeeId" value="@Model.EmployeeId" />
            }
            @if (Model.DocumentId.HasValue)
            {
                <input type="hidden" name="documentId" value="@Model.DocumentId" />
            }

            <div class="filter-group" style="flex: 1.5;">
                <label>
                    <i class="fas fa-search"></i>
                    Search
                </label>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="@Model.Q" class="search-input" placeholder="User name, details, IP address..." />
                </div>
            </div>
            <div class="filter-group">
                <label>
                    <i class="fas fa-bolt"></i>
                    Action
                </label>
                <select name="action" class="filter-select">
                    <option value="">Any action</option>
                    @foreach (var a in Enum.GetValues<DocumentAuditAction>())
                    {
                        <option value="@a" selected="@(Model.Action == a)">@a</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>
                    <i class="fas fa-calendar-day"></i>
                    From
                </label>
                <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="filter-select" />
            </div>
            <div class="filter-group">
                <label>
                    <i class="fas fa-calendar-day"></i>
                    To
                </label>
                <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="filter-select" />
            </div>
            <button type="submit" class="btn-clear-filters" style="background:var(--primary);color:#fff;border:none;">
                <i class="fas fa-search"></i>
                Apply Filters
            </button>
            <a asp-action="Audit" class="btn-clear-filters" style="text-decoration:none;display:inline-flex;align-items:center;gap:0.4rem;">
                <i class="fas fa-undo-alt"></i>
                Clear All
            </a>
        </form>
    </div>

    <!-- MAIN DATA CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-list me-2"></i>
                <span>Activity Log</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span id="visibleCount">@(paging?.TotalCount ?? Model.Rows.Count)</span> event(s)
            </div>
        </div>

        <div class="table-responsive">
            @if (Model.Rows.Any())
            {
                <table class="data-table tickets-table" id="auditTable">
                    <thead>
                        <tr>
                            <th style="min-width: 160px;"><i class="fas fa-clock me-1"></i> When</th>
                            <th><i class="fas fa-bolt me-1"></i> Action</th>
                            <th><i class="fas fa-user me-1"></i> By</th>
                            <th><i class="fas fa-user-tie me-1"></i> Employee</th>
                            <th><i class="fas fa-file me-1"></i> Document</th>
                            <th><i class="fas fa-network-wired me-1"></i> IP</th>
                            <th><i class="fas fa-window-maximize me-1"></i> Browser</th>
                            <th><i class="fas fa-circle-info me-1"></i> Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            var badgeClass = ActionClass(r.Action);
                            var icon = ActionIcon(r.Action);

                            <tr>
                                <td class="timestamp-cell">
                                    <i class="far fa-calendar-alt"></i>
                                    <span>@r.Timestamp.ToString("MMM dd, yyyy")</span>
                                    <span class="time">@r.Timestamp.ToString("HH:mm")</span>
                                </td>
                                <td>
                                    <span class="action-badge @badgeClass">
                                        <i class="fas @icon"></i>
                                        @r.Action
                                    </span>
                                </td>
                                <td class="performer-cell">
                                    @if (!string.IsNullOrEmpty(r.PerformedByName))
                                    {
                                        <div class="performer-info">
                                            <div class="performer-avatar">@(r.PerformedByName.Split(' ').Select(p => p[0]).Aggregate("", (a, b) => a + b).Substring(0, Math.Min(2, r.PerformedByName.Split(' ').Select(p => p[0]).Aggregate("", (a, b) => a + b).Length)))</div>
                                            <span>@r.PerformedByName</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="employee-cell">
                                    @if (!string.IsNullOrEmpty(r.EmployeeName))
                                    {
                                        <a asp-action="File" asp-route-id="@r.EmployeeId" class="employee-link">
                                            @r.EmployeeName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="document-cell">
                                    @if (r.EmployeeDocumentId != null)
                                    {
                                        <a asp-action="Details" asp-route-id="@r.EmployeeDocumentId" class="document-link" title="@(r.DocumentTitle ?? $"Document #{r.EmployeeDocumentId}")">
                                            <i class="fas fa-file-alt"></i>
                                            <span>@(r.DocumentTitle ?? $"#{r.EmployeeDocumentId}")</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="ip-cell">
                                    @if (!string.IsNullOrEmpty(r.IpAddress))
                                    {
                                        <code class="ip-address">@r.IpAddress</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="browser-badge">
                                        <i class="fab fa-@(Browser(r.UserAgent).ToLower())"></i>
                                        @Browser(r.UserAgent)
                                    </span>
                                </td>
                                <td class="details-cell" title="@r.Details">
                                    @if (!string.IsNullOrEmpty(r.Details))
                                    {
                                        <span class="details-text">@r.Details</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-clipboard-list"></i>
                    <h3>No audit events found</h3>
                    <p>No activity matches your current filters.</p>
                    <a asp-action="Audit" class="btn-create-ticket-sm">
                        <i class="fas fa-undo-alt"></i> Clear Filters
                    </a>
                </div>
            }
        </div>

        @if (paging != null)
        {
            @await Html.PartialAsync("_Pagination", paging)
        }
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1600px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== FILTER INDICATORS ===== */
    .filter-indicator {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--gray-100);
        padding: 0.15rem 0.6rem;
        border-radius: 1rem;
        font-size: 0.8rem;
        color: var(--gray-600);
        margin-left: 0.5rem;
    }

        .filter-indicator i {
            color: var(--primary);
            font-size: 0.7rem;
        }

        .filter-indicator strong {
            color: var(--gray-700);
        }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, var(--primary-light), var(--primary));
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== EXPORT BUTTON ===== */
    .btn-group-export {
        position: relative;
        display: inline-block;
    }

    .btn-export {
        background: white;
        color: var(--gray-600);
        padding: 0.625rem 1.25rem;
        border-radius: 0.75rem;
        border: 1.5px solid var(--gray-200);
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.875rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Inter', sans-serif;
    }

        .btn-export:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
        }

    .dropdown-menu {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: 0.75rem;
        box-shadow: var(--shadow-md);
        padding: 0.5rem;
        min-width: 180px;
    }

    .dropdown-item {
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        color: var(--gray-700);
        text-decoration: none;
        display: flex;
        align-items: center;
        transition: all 0.2s;
        font-size: 0.875rem;
    }

        .dropdown-item:hover {
            background: var(--gray-50);
            color: var(--primary);
        }

        .dropdown-item i {
            width: 20px;
            text-align: center;
        }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== FILTERS CARD ===== */
    .filters-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .filters-header {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .active-filters-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.1rem 0.5rem;
        border-radius: 1rem;
        background: #e6f5e9;
        color: var(--success);
        margin-left: 0.5rem;
    }

    .filters-body {
        padding: 1.5rem;
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: flex-end;
    }

    .filter-group {
        flex: 1;
        min-width: 180px;
    }

        .filter-group label {
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--gray-600);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

            .filter-group label i {
                color: var(--primary);
                margin-right: 0.25rem;
            }

    .filter-select {
        width: 100%;
        padding: 0.625rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
        background: white;
        cursor: pointer;
        color: var(--gray-700);
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
        }

        .filter-select[type="date"] {
            cursor: pointer;
        }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper i {
            position: absolute;
            left: 0.75rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray-400);
            font-size: 0.875rem;
        }

    .search-input {
        width: 100%;
        padding: 0.625rem 0.75rem 0.625rem 2rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
        color: var(--gray-700);
    }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
        }

    .btn-clear-filters {
        background: white;
        color: var(--gray-600);
        padding: 0.625rem 1rem;
        border-radius: 0.5rem;
        border: 1.5px solid var(--gray-200);
        cursor: pointer;
        transition: all 0.2s;
        font-size: 0.875rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        text-decoration: none;
    }

        .btn-clear-filters:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    .table-responsive {
        overflow-x: auto;
    }

    /* ===== TABLE STYLES ===== */
    .data-table.tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .data-table.tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .data-table.tickets-table th {
            padding: 0.875rem 1.25rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .data-table.tickets-table td {
            padding: 0.875rem 1.25rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .data-table.tickets-table tbody tr {
            transition: background-color 0.2s;
        }

            .data-table.tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

    /* ===== TIMESTAMP ===== */
    .timestamp-cell {
        white-space: nowrap;
    }

        .timestamp-cell i {
            color: var(--gray-400);
            margin-right: 0.4rem;
            font-size: 0.75rem;
        }

