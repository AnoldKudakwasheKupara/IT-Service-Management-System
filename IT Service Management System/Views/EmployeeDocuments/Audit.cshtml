<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Client-side filtering
        const searchInput = document.querySelector('input[name="q"]');
        const actionFilter = document.querySelector('select[name="action"]');
        const fromDate = document.querySelector('input[name="from"]');
        const toDate = document.querySelector('input[name="to"]');
        const table = document.getElementById('auditTable');
        const rows = table ? table.querySelectorAll('tbody tr') : [];
        const visibleCountSpan = document.getElementById('visibleCount');

        function filterAudit() {
            const searchValue = searchInput ? searchInput.value.toLowerCase() : '';
            const actionValue = actionFilter ? actionFilter.value : '';
            const fromValue = fromDate ? fromDate.value : '';
            const toValue = toDate ? toDate.value : '';

            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                let show = true;

                if (searchValue && !text.includes(searchValue)) {
                    show = false;
                }

                if (actionValue) {
                    const actionText = row.querySelector('.action-badge')?.textContent.trim() || '';
                    if (actionText !== actionValue) {
                        show = false;
                    }
                }

                // Date filtering
                if (fromValue || toValue) {
                    const timestampCell = row.querySelector('.timestamp-cell');
                    if (timestampCell) {
                        const dateText = timestampCell.textContent.trim();
                        const dateMatch = dateText.match(/(\w{3}\s+\d{2},\s+\d{4})/);
                        if (dateMatch) {
                            const date = new Date(dateMatch[1]);
                            if (fromValue) {
                                const fromDateObj = new Date(fromValue);
                                if (date < fromDateObj) show = false;
                            }
                            if (toValue && show) {
                                const toDateObj = new Date(toValue);
                                toDateObj.setDate(toDateObj.getDate() + 1);
                                if (date > toDateObj) show = false;
                            }
                        }
                    }
                }

                if (show) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCountSpan) {
                visibleCountSpan.textContent = visibleCount;
            }

            // Show no results message
            const emptyState = document.querySelector('.empty-state:not(.original)');
            const tbody = table ? table.querySelector('tbody') : null;

            if (visibleCount === 0 && rows.length > 0) {
                if (!emptyState && tbody) {
                    const noResultsDiv = document.createElement('div');
                    noResultsDiv.className = 'empty-state';
                    noResultsDiv.innerHTML = `
                        <i class="fas fa-search"></i>
                        <h3>No matching events found</h3>
                        <p>Try adjusting your filters or search terms</p>
                        <a asp-action="Audit" class="btn-create-ticket-sm">
                            <i class="fas fa-undo-alt"></i> Clear Filters
                        </a>
                    `;
                    tbody.parentNode.appendChild(noResultsDiv);
                    if (table) table.style.display = 'none';
                }
            } else {
                if (emptyState) emptyState.remove();
                if (table) table.style.display = '';
            }
        }

        // Attach event listeners
        if (searchInput) {
            searchInput.addEventListener('keyup', filterAudit);
        }
        if (actionFilter) {
            actionFilter.addEventListener('change', filterAudit);
        }
        if (fromDate) {
            fromDate.addEventListener('change', filterAudit);
        }
        if (toDate) {
            toDate.addEventListener('change', filterAudit);
        }

        // Initialize
        filterAudit();
    });
</script>