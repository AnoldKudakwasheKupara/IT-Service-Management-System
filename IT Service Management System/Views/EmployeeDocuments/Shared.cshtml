@model IT_Service_Management_System.Models.Efm.DocumentShare
@{
    Layout = null;
    var needPw = ViewBag.NeedPassword == true;
    var token = ViewBag.Token as string;
    var pw = ViewBag.Password as string;
    var ct = Model.Document?.CurrentVersion?.ContentType ?? "";
    var canFrame = ct.StartsWith("application/pdf") || ct.StartsWith("image/") || ct.StartsWith("text/");
    string qp = Uri.EscapeDataString(pw ?? "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shared Document — Axis IT Operations</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
            /* ===== ROOT VARIABLES (from Dashboard) ===== */
            :root {
                --primary-dark: #2563eb;
                --primary: #3b82f6;
                --primary-light: #60a5fa;
                --success: #2c9e6e;
                --warning: #f5b042;
                --danger: #e53e3e;
                --info: #3b82f6;
                --gray-50: #f8fafc;
                --gray-100: #f1f5f9;
                --gray-200: #e2e8f0;
                --gray-300: #cbd5e1;
                --gray-400: #94a3b8;
                --gray-500: #64748b;
                --gray-600: #475569;
                --gray-700: #334155;
                --gray-800: #1e293b;
                --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
                --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
                --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
                --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            }

            /* ===== BODY ===== */
            body {
                background: var(--gray-50);
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 2rem 1rem;
                margin: 0;
            }

            /* ===== WRAPPER ===== */
            .share-wrapper {
                max-width: 960px;
                width: 100%;
                margin: 0 auto;
            }

            /* ===== BRAND HEADER ===== */
            .brand-header {
                text-align: center;
                margin-bottom: 2rem;
            }

            .brand {
                display: inline-flex;
                align-items: center;
                gap: 0.75rem;
                font-size: 1.25rem;
                font-weight: 700;
                color: var(--primary-dark);
                text-decoration: none;
                background: white;
                padding: 0.5rem 1.5rem;
                border-radius: 2rem;
                box-shadow: var(--shadow-sm);
                border: 1px solid var(--gray-200);
                transition: all 0.2s;
            }

                .brand:hover {
                    box-shadow: var(--shadow-md);
                    transform: translateY(-2px);
                    color: var(--primary-dark);
                    text-decoration: none;
                }

                .brand i {
                    color: var(--primary);
                    font-size: 1.1rem;
                }

            /* ===== MAIN CARD ===== */
            .share-card {
                background: white;
                border-radius: 1rem;
                overflow: hidden;
                box-shadow: var(--shadow-md);
                border: 1px solid var(--gray-200);
            }

            /* ===== CARD HEADER ===== */
            .share-card-header {
                background: linear-gradient(135deg, var(--primary-dark), var(--primary));
                color: white;
                padding: 1.5rem 2rem;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-between;
                gap: 0.75rem;
            }

                .share-card-header .header-title {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                }

                    .share-card-header .header-title i {
                        font-size: 1.25rem;
                        opacity: 0.9;
                    }

                .share-card-header h5 {
                    font-weight: 600;
                    margin: 0;
                    font-size: 1.125rem;
                }

                .share-card-header .header-meta {
                    font-size: 0.75rem;
                    opacity: 0.85;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                    .share-card-header .header-meta i {
                        font-size: 0.7rem;
                    }

            /* ===== CARD BODY ===== */
            .share-card-body {
                padding: 2rem;
            }

            /* ===== ALERT / FLASH ===== */
            .alert-share {
                padding: 0.75rem 1rem;
                border-radius: 0.5rem;
                font-size: 0.875rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 1.5rem;
            }

                .alert-share.error {
                    background: #fee;
                    color: var(--danger);
                    border-left: 4px solid var(--danger);
                }

                .alert-share.success {
                    background: #e6f5e9;
                    color: var(--success);
                    border-left: 4px solid var(--success);
                }

            /* ===== PASSWORD FORM ===== */
            .password-prompt {
                max-width: 420px;
            }

                .password-prompt .prompt-icon {
                    text-align: center;
                    margin-bottom: 1.25rem;
                }

                    .password-prompt .prompt-icon i {
                        font-size: 3rem;
                        color: var(--primary);
                        background: #e6f0ff;
                        padding: 1rem;
                        border-radius: 50%;
                    }

                .password-prompt p {
                    color: var(--gray-600);
                    margin-bottom: 1.25rem;
                    font-size: 0.95rem;
                }

                .password-prompt .input-group-custom {
                    display: flex;
                    gap: 0.5rem;
                }

                    .password-prompt .input-group-custom input {
                        flex: 1;
                        padding: 0.625rem 1rem;
                        border: 1.5px solid var(--gray-200);
                        border-radius: 0.5rem;
                        font-size: 0.875rem;
                        font-family: 'Inter', sans-serif;
                        transition: all 0.2s;
                    }

                        .password-prompt .input-group-custom input:focus {
                            outline: none;
                            border-color: var(--primary);
                            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
                        }

                    .password-prompt .input-group-custom button {
                        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
                        color: white;
                        padding: 0.625rem 1.5rem;
                        border: none;
                        border-radius: 0.5rem;
                        font-weight: 600;
                        font-size: 0.875rem;
                        cursor: pointer;
                        transition: all 0.2s;
                        display: inline-flex;
                        align-items: center;
                        gap: 0.5rem;
                        white-space: nowrap;
                    }

                        .password-prompt .input-group-custom button:hover {
                            transform: translateY(-2px);
                            box-shadow: var(--shadow-md);
                        }

            /* ===== DOCUMENT CONTENT ===== */
            .document-toolbar {
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: 0.75rem;
                margin-bottom: 1.25rem;
                flex-wrap: wrap;
            }

                .document-toolbar .file-info {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    font-size: 0.8rem;
                    color: var(--gray-500);
                    margin-right: auto;
                }

                    .document-toolbar .file-info i {
                        color: var(--primary);
                        font-size: 1rem;
                    }

            .btn-download {
                background: linear-gradient(100deg, var(--primary-dark), var(--primary));
                color: white;
                padding: 0.625rem 1.25rem;
                border-radius: 0.5rem;
                font-weight: 600;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 0.875rem;
                transition: all 0.2s;
                border: none;
                cursor: pointer;
            }

                .btn-download:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                    color: white;
                    text-decoration: none;
                }

                .btn-download i {
                    font-size: 0.9rem;
                }

            /* ===== IFRAME ===== */
            .preview-frame {
                width: 100%;
                height: 70vh;
                min-height: 400px;
                border: 1.5px solid var(--gray-200);
                border-radius: 0.75rem;
                background: var(--gray-50);
                transition: border-color 0.2s;
            }

                .preview-frame:hover {
                    border-color: var(--primary-light);
                }

            .preview-unavailable {
                text-align: center;
                padding: 4rem 2rem;
                color: var(--gray-500);
            }

                .preview-unavailable i {
                    font-size: 3.5rem;
                    color: var(--gray-300);
                    margin-bottom: 1rem;
                    display: block;
                }

                .preview-unavailable h5 {
                    color: var(--gray-600);
                    margin-bottom: 0.5rem;
                }

                .preview-unavailable p {
                    font-size: 0.875rem;
                }

            /* ===== FOOTER ===== */
            .share-footer {
                text-align: center;
                margin-top: 1.5rem;
                font-size: 0.75rem;
                color: var(--gray-400);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
            }

                .share-footer i {
                    font-size: 0.65rem;
                    opacity: 0.6;
                }

            /* ===== RESPONSIVE ===== */
            @@media (max-width: 768px) {
                .share-card-header {
                    flex-direction: column;
                    align-items: flex-start;
                    padding: 1.25rem 1.5rem;
                }

                    .share-card-header .header-meta {
                        font-size: 0.7rem;
                    }

                .share-card-body {
                    padding: 1.5rem;
                }

                .password-prompt .input-group-custom {
                    flex-direction: column;
                }

                    .password-prompt .input-group-custom button {
                        width: 100%;
                        justify-content: center;
                    }

                .document-toolbar {
                    flex-direction: column;
                    align-items: stretch;
                }

                    .document-toolbar .file-info {
                        margin-right: 0;
                        justify-content: center;
                    }

                .btn-download {
                    justify-content: center;
                }

                .preview-frame {
                    height: 50vh;
                    min-height: 300px;
                }

                .brand {
                    font-size: 1rem;
                    padding: 0.4rem 1rem;
                }
            }

            @@media (max-width: 480px) {
                .share-card-header .header-title h5 {
                    font-size: 1rem;
                }

                .share-card-body {
                    padding: 1rem;
                }

                .preview-frame {
                    height: 40vh;
                    min-height: 250px;
                }

                .preview-unavailable {
                    padding: 2rem 1rem;
                }

                    .preview-unavailable i {
                        font-size: 2.5rem;
                    }
            }
    </style>
</head>
<body>
    <div class="share-wrapper">
        <!-- BRAND HEADER -->
        <div class="brand-header">
            <a href="#" class="brand">
                <i class="fas fa-shield-halved"></i>
                Axis IT Operations
            </a>
        </div>

        <!-- MAIN CARD -->
        <div class="share-card">
            <!-- CARD HEADER -->
            <div class="share-card-header">
                <div class="header-title">
                    <i class="fas fa-file-shield"></i>
                    <h5>@(Model.Document?.Title ?? "Shared Document")</h5>
                </div>
                <div class="header-meta">
                    <i class="fas fa-lock"></i>
                    <span>Shared securely · Read only</span>
                    @if (Model.ExpiresAt != null)
                    {
                        <i class="fas fa-clock ms-2"></i>
                        <span>Expires @Model.ExpiresAt:MMM dd, yyyy</span>
                    }
                </div>
            </div>

            <!-- CARD BODY -->
            <div class="share-card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert-share error">
                        <i class="fas fa-circle-exclamation"></i>
                        @ViewBag.Error
                    </div>
                }

                @if (needPw)
                {
                    <!-- PASSWORD PROTECTED -->
                    <div class="password-prompt">
                        <div class="prompt-icon">
                            <i class="fas fa-lock"></i>
                        </div>
                        <p>This document is password protected. Please enter the password to view it.</p>
                        <form method="get" asp-action="Shared" class="input-group-custom">
                            <input type="hidden" name="token" value="@token" />
                            <input type="password" name="password" placeholder="Enter password" required autofocus />
                            <button type="submit">
                                <i class="fas fa-unlock"></i> Open
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <!-- DOCUMENT VIEW -->
                    <div class="document-toolbar">
                        <div class="file-info">
                            <i class="fas fa-file-alt"></i>
                            <span>@(Model.Document?.Title ?? "Document")</span>
                            @if (!string.IsNullOrEmpty(ct))
                            {
                                <span class="badge" style="background:var(--gray-100);color:var(--gray-600);font-weight:500;font-size:0.65rem;padding:0.2rem 0.5rem;">
                                    @ct.Split('/').Last()
                                </span>
                            }
                        </div>
                        <a class="btn-download" href="@Url.Action("Shared", new { token, password = pw, dl = true })">
                            <i class="fas fa-download"></i> Download
                        </a>
                    </div>

                    @if (canFrame)
                    {
                        <iframe src="@Url.Action("Shared", new { token, password = pw, inline = true })"
                                class="preview-frame"
                                title="Document preview">
                        </iframe>
                    }
                    else
                    {
                        <div class="preview-unavailable">
                            <i class="fas fa-file"></i>
                            <h5>Preview Not Available</h5>
                            <p>Preview isn't available for this file type.</p>
                            <a class="btn-download" href="@Url.Action("Shared", new { token, password = pw, dl = true })" style="display:inline-flex;margin-top:0.5rem;">
                                <i class="fas fa-download"></i> Download File
                            </a>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- FOOTER -->
        <div class="share-footer">
            <i class="fas fa-shield-alt"></i>
            <span>This is a secure, access-logged share link</span>
            <i class="fas fa-circle" style="font-size:0.25rem;opacity:0.3;"></i>
            <span>@DateTime.Now.Year Axis IT Operations</span>
        </div>
    </div>
</body>
</html>