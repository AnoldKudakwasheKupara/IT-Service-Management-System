@model IT_Service_Management_System.Models.Efm.EmployeeDocument
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = $"{Model.Title} - Document";
    string Size(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0.#} KB" : $"{b} B";
    var ct = Model.CurrentVersion?.ContentType ?? "";
    var canFrame = ct.StartsWith("application/pdf") || ct.StartsWith("image/") || ct.StartsWith("text/");
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-3">
            <a asp-action="File" asp-route-id="@Model.EmployeeId" asp-route-folderId="@Model.FolderId" class="btn-back"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h1 class="page-title" style="font-size:1.4rem;"><i class="fas fa-file-lines me-2" style="color:var(--primary);"></i>@Model.Title</h1>
                <p class="text-muted mt-1" style="font-size:0.85rem;">
                    @Model.Employee?.FullName · @Model.Folder?.Name · @Model.Category?.Name
                </p>
            </div>
            @{ var isStaff = ViewBag.IsStaff == true; }
            <div class="ms-auto d-flex gap-2">
                @if (isStaff)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Timeline" asp-route-id="@Model.EmployeeId"><i class="fas fa-timeline"></i> Timeline</a>
                    <a class="btn btn-outline-secondary btn-sm" asp-action="Audit" asp-route-documentId="@Model.Id"><i class="fas fa-clipboard-list"></i> History</a>
                    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#shareModal"><i class="fas fa-share-nodes"></i> Share</button>
                    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#versionModal"><i class="fas fa-upload"></i> New Version</button>
                }
                <a class="btn btn-outline-primary btn-sm" asp-action="Preview" asp-route-id="@Model.Id" target="_blank"><i class="fas fa-eye"></i> Preview</a>
                <a class="btn btn-primary btn-sm" asp-action="Download" asp-route-id="@Model.Id"><i class="fas fa-download"></i> Download</a>
            </div>
        </div>
    </div>

    @if (TempData["ShareLink"] != null)
    {
        <div class="alert alert-info d-flex align-items-center gap-2 flex-wrap">
            <i class="fas fa-link"></i>
            <input type="text" class="form-control form-control-sm" readonly value="@TempData["ShareLink"]" onclick="this.select()" style="max-width:520px;" />
            <button class="btn btn-sm btn-outline-primary" onclick="navigator.clipboard.writeText('@TempData["ShareLink"]');toastr.success('Link copied');return false;"><i class="fas fa-copy"></i> Copy</button>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="data-card">
                <div class="card-header-custom"><div><i class="fas fa-eye me-2"></i><span>Preview</span></div></div>
                <div style="padding:0;height:70vh;background:var(--gray-100);">
                    @if (canFrame)
                    {
                        <iframe src="@Url.Action("Preview", new { id = Model.Id })" style="width:100%;height:100%;border:0;"></iframe>
                    }
                    else
                    {
                        <div class="text-center text-muted d-flex flex-column align-items-center justify-content-center" style="height:100%;">
                            <i class="fas fa-file fa-3x mb-3"></i>
                            <p>Inline preview isn't available for this file type.</p>
                            <a class="btn btn-primary btn-sm" asp-action="Download" asp-route-id="@Model.Id"><i class="fas fa-download"></i> Download to view</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="data-card" style="margin-bottom:1rem;">
                <div class="card-header-custom"><div><i class="fas fa-circle-info me-2"></i><span>Details</span></div></div>
                <div style="padding:1rem 1.25rem;">
                    <dl class="efm-dl">
                        <dt>Status</dt><dd><span class="pill">@Model.Status</span></dd>
                        <dt>Confidentiality</dt><dd>@Model.ConfidentialityLevel</dd>
                        <dt>Document #</dt><dd>@(Model.DocumentNumber ?? "—")</dd>
                        <dt>Issue date</dt><dd>@(Model.IssueDate?.ToString("MMM dd, yyyy") ?? "—")</dd>
                        <dt>Expiry date</dt>
                        <dd>
                            @if (Model.ExpiryDate == null) { <text>—</text> }
                            else if (Model.IsExpired) { <span class="pill red">Expired @Model.ExpiryDate?.ToString("MMM dd, yyyy")</span> }
                            else { <span class="pill @(Model.DaysUntilExpiry <= 30 ? "amber" : "")">@Model.ExpiryDate?.ToString("MMM dd, yyyy") (@Model.DaysUntilExpiry d)</span> }
                        </dd>
                        <dt>Tags</dt>
                        <dd>
                            @if (Model.Tags.Any()) { foreach (var t in Model.Tags) { <span class="pill">@t.Tag?.Name</span> } }
                            else { <text>—</text> }
                        </dd>
                        <dt>Size</dt><dd>@Size(Model.CurrentVersion?.FileSizeBytes ?? 0)</dd>
                        <dt>Uploaded by</dt><dd>@(Model.CreatedByName ?? "—")</dd>
                        <dt>Created</dt><dd>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                        <dt>Views</dt><dd>@Model.ViewCount</dd>
                        @if (!string.IsNullOrEmpty(Model.Description)) { <dt>Description</dt><dd>@Model.Description</dd> }
                    </dl>
                </div>
            </div>

            @if (isStaff)
            {
                var shares = ViewBag.Shares as List<IT_Service_Management_System.Models.Efm.DocumentShare> ?? new();
                <div class="data-card" style="margin-bottom:1rem;">
                    <div class="card-header-custom"><div><i class="fas fa-share-nodes me-2"></i><span>Share Links</span></div><button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#shareModal"><i class="fas fa-plus"></i></button></div>
                    <div style="padding:0.25rem 0;">
                        @if (shares.Any())
                        {
                            foreach (var sh in shares)
                            {
                                <div class="d-flex align-items-center gap-2 px-3 py-2" style="border-bottom:1px solid var(--gray-100);font-size:0.8rem;">
                                    <i class="fas @(sh.PasswordHash != null ? "fa-lock" : "fa-link")" style="color:var(--primary);"></i>
                                    <div class="flex-grow-1">
                                        <div>@(sh.ExpiresAt != null ? $"Expires {sh.ExpiresAt:MMM dd, yyyy}" : "No expiry")@(sh.MaxDownloads != null ? $" · max {sh.MaxDownloads}" : "")</div>
                                        <div class="text-muted" style="font-size:0.7rem;">@sh.DownloadCount download(s) · by @sh.CreatedByName</div>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Shared", new { token = sh.Token })" target="_blank" title="Open"><i class="fas fa-up-right-from-square"></i></a>
                                    <form asp-action="RevokeShare" method="post" style="display:inline;" onsubmit="return confirm('Revoke this link?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="shareId" value="@sh.Id" />
                                        <input type="hidden" name="documentId" value="@Model.Id" />
                                        <button class="btn btn-sm btn-outline-danger" title="Revoke"><i class="fas fa-ban"></i></button>
                                    </form>
                                </div>
                            }
                        }
                        else { <div class="text-muted px-3 py-2" style="font-size:0.8rem;">No active share links.</div> }
                    </div>
                </div>
            }

            <div class="data-card">
                <div class="card-header-custom"><div><i class="fas fa-code-branch me-2"></i><span>Versions</span></div><span class="record-count">@Model.Versions.Count</span></div>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead><tr><th>Ver</th><th>File</th><th>Size</th><th>Uploaded</th><th>Note</th><th style="text-align:right;">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var v in Model.Versions.OrderByDescending(v => v.VersionNumber))
                            {
                                <tr>
                                    <td>v@(v.VersionNumber) @(v.IsCurrent ? Html.Raw("<span class='pill' style='background:var(--primary-light);color:var(--primary-dark);'>current</span>") : null)</td>
                                    <td style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@v.FileName">@v.FileName</td>
                                    <td>@Size(v.FileSizeBytes)</td>
                                    <td>@v.UploadedAt.ToString("MMM dd, yyyy")<div class="text-muted" style="font-size:0.7rem;">@v.UploadedByName</div></td>
                                    <td style="max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@v.ChangeNote">@(v.ChangeNote ?? "—")</td>
                                    <td style="text-align:right;white-space:nowrap;">
                                        @if (isStaff)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" asp-action="DownloadVersion" asp-route-versionId="@v.Id" title="Download this version"><i class="fas fa-download"></i></a>
                                            @if (!v.IsCurrent)
                                            {
                                                <form asp-action="RestoreVersion" method="post" style="display:inline;" onsubmit="return confirm('Restore v@(v.VersionNumber) as the current version?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="documentId" value="@Model.Id" />
                                                    <input type="hidden" name="versionId" value="@v.Id" />
                                                    <button class="btn btn-sm btn-outline-secondary" title="Restore this version"><i class="fas fa-rotate-left"></i></button>
                                                </form>
                                            }
                                        }
                                        else { <text>—</text> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create share link modal -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CreateShare" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-share-nodes me-2"></i>Create Secure Share Link</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" style="font-size:0.85rem;">Creates a read-only, access-logged link. Optionally add an expiry, a password and a download limit.</p>
                    <div class="row g-3">
                        <div class="col-md-4"><label class="form-label fw-semibold">Expires (days)</label><input type="number" name="expiresDays" class="form-control" min="1" max="365" placeholder="Never" /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold">Max downloads</label><input type="number" name="maxDownloads" class="form-control" min="1" placeholder="Unlimited" /></div>
                        <div class="col-md-4"><label class="form-label fw-semibold">Password</label><input type="text" name="password" class="form-control" placeholder="Optional" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-share-nodes"></i> Create Link</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upload new version modal -->
<div class="modal fade" id="versionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="UploadVersion" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-upload me-2"></i>Upload New Version</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" style="font-size:0.85rem;">This creates a new version and makes it current. The current version (v@(Model.CurrentVersion?.VersionNumber)) is kept in history.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">File</label>
                        <input type="file" name="file" class="form-control" required />
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Change note <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="changeNote" class="form-control" maxlength="500" placeholder="What changed in this version?" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Upload Version</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .efm-dl { display:grid; grid-template-columns:120px 1fr; row-gap:0.55rem; column-gap:0.5rem; margin:0; font-size:0.85rem; }
    .efm-dl dt { color:var(--gray-500); font-weight:600; }
    .efm-dl dd { margin:0; color:var(--gray-800); }
    .pill { display:inline-flex; align-items:center; gap:0.25rem; font-size:0.7rem; font-weight:600; padding:0.1rem 0.5rem; border-radius:1rem; background:var(--gray-100); color:var(--gray-600); margin:0 0.2rem 0.2rem 0; }
    .pill.amber { background:#fffbeb; color:#92400e; } .pill.red { background:#fef2f2; color:#b91c1c; }
</style>
