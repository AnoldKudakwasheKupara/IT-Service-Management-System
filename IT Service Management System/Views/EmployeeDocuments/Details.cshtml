@model IT_Service_Management_System.Models.Efm.EmployeeDocument
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = $"{Model.Title} - Document";
    string Size(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0.#} KB" : $"{b} B";
    var ct = Model.CurrentVersion?.ContentType ?? "";
    var canFrame = ct.StartsWith("application/pdf") || ct.StartsWith("image/") || ct.StartsWith("text/");
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-3">
            <a asp-action="File" asp-route-id="@Model.EmployeeId" asp-route-folderId="@Model.FolderId" class="btn-back"><i class="fas fa-arrow-left"></i></a>
            <div>
                <h1 class="page-title" style="font-size:1.4rem;"><i class="fas fa-file-lines me-2" style="color:var(--primary);"></i>@Model.Title</h1>
                <p class="text-muted mt-1" style="font-size:0.85rem;">
                    @Model.Employee?.FullName · @Model.Folder?.Name · @Model.Category?.Name
                </p>
            </div>
            <div class="ms-auto d-flex gap-2">
                <a class="btn btn-outline-primary btn-sm" asp-action="Preview" asp-route-id="@Model.Id" target="_blank"><i class="fas fa-eye"></i> Preview</a>
                <a class="btn btn-primary btn-sm" asp-action="Download" asp-route-id="@Model.Id"><i class="fas fa-download"></i> Download</a>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="data-card">
                <div class="card-header-custom"><div><i class="fas fa-eye me-2"></i><span>Preview</span></div></div>
                <div style="padding:0;height:70vh;background:var(--gray-100);">
                    @if (canFrame)
                    {
                        <iframe src="@Url.Action("Preview", new { id = Model.Id })" style="width:100%;height:100%;border:0;"></iframe>
                    }
                    else
                    {
                        <div class="text-center text-muted d-flex flex-column align-items-center justify-content-center" style="height:100%;">
                            <i class="fas fa-file fa-3x mb-3"></i>
                            <p>Inline preview isn't available for this file type.</p>
                            <a class="btn btn-primary btn-sm" asp-action="Download" asp-route-id="@Model.Id"><i class="fas fa-download"></i> Download to view</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="data-card" style="margin-bottom:1rem;">
                <div class="card-header-custom"><div><i class="fas fa-circle-info me-2"></i><span>Details</span></div></div>
                <div style="padding:1rem 1.25rem;">
                    <dl class="efm-dl">
                        <dt>Status</dt><dd><span class="pill">@Model.Status</span></dd>
                        <dt>Confidentiality</dt><dd>@Model.ConfidentialityLevel</dd>
                        <dt>Document #</dt><dd>@(Model.DocumentNumber ?? "—")</dd>
                        <dt>Issue date</dt><dd>@(Model.IssueDate?.ToString("MMM dd, yyyy") ?? "—")</dd>
                        <dt>Expiry date</dt>
                        <dd>
                            @if (Model.ExpiryDate == null) { <text>—</text> }
                            else if (Model.IsExpired) { <span class="pill red">Expired @Model.ExpiryDate?.ToString("MMM dd, yyyy")</span> }
                            else { <span class="pill @(Model.DaysUntilExpiry <= 30 ? "amber" : "")">@Model.ExpiryDate?.ToString("MMM dd, yyyy") (@Model.DaysUntilExpiry d)</span> }
                        </dd>
                        <dt>Tags</dt>
                        <dd>
                            @if (Model.Tags.Any()) { foreach (var t in Model.Tags) { <span class="pill">@t.Tag?.Name</span> } }
                            else { <text>—</text> }
                        </dd>
                        <dt>Size</dt><dd>@Size(Model.CurrentVersion?.FileSizeBytes ?? 0)</dd>
                        <dt>Uploaded by</dt><dd>@(Model.CreatedByName ?? "—")</dd>
                        <dt>Created</dt><dd>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                        <dt>Views</dt><dd>@Model.ViewCount</dd>
                        @if (!string.IsNullOrEmpty(Model.Description)) { <dt>Description</dt><dd>@Model.Description</dd> }
                    </dl>
                </div>
            </div>

            <div class="data-card">
                <div class="card-header-custom"><div><i class="fas fa-code-branch me-2"></i><span>Versions</span></div><span class="record-count">@Model.Versions.Count</span></div>
                <div class="table-responsive">
                    <table class="data-table">
                        <thead><tr><th>Ver</th><th>File</th><th>Size</th><th>Uploaded</th></tr></thead>
                        <tbody>
                            @foreach (var v in Model.Versions.OrderByDescending(v => v.VersionNumber))
                            {
                                <tr>
                                    <td>v@(v.VersionNumber) @(v.IsCurrent ? Html.Raw("<span class='pill' style='background:var(--primary-light);color:var(--primary-dark);'>current</span>") : null)</td>
                                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@v.FileName</td>
                                    <td>@Size(v.FileSizeBytes)</td>
                                    <td>@v.UploadedAt.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .efm-dl { display:grid; grid-template-columns:120px 1fr; row-gap:0.55rem; column-gap:0.5rem; margin:0; font-size:0.85rem; }
    .efm-dl dt { color:var(--gray-500); font-weight:600; }
    .efm-dl dd { margin:0; color:var(--gray-800); }
    .pill { display:inline-flex; align-items:center; gap:0.25rem; font-size:0.7rem; font-weight:600; padding:0.1rem 0.5rem; border-radius:1rem; background:var(--gray-100); color:var(--gray-600); margin:0 0.2rem 0.2rem 0; }
    .pill.amber { background:#fffbeb; color:#92400e; } .pill.red { background:#fef2f2; color:#b91c1c; }
</style>
