@model IT_Service_Management_System.Models.Efm.EmployeeDocument
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = $"{Model.Title} - Document";
    string Size(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0.#} KB" : $"{b} B";
    var ct = Model.CurrentVersion?.ContentType ?? "";
    var canFrame = ct.StartsWith("application/pdf") || ct.StartsWith("image/") || ct.StartsWith("text/");
    var isStaff = ViewBag.IsStaff == true;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
            <a asp-action="File" asp-route-id="@Model.EmployeeId" asp-route-folderId="@Model.FolderId" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-file-lines me-2" style="color: var(--primary);"></i>
                    @Model.Title
                </h1>
                <p class="text-muted mt-1" style="font-size:0.85rem;">
                    <i class="fas fa-user me-1"></i> @Model.Employee?.FullName
                    <span class="mx-2">·</span>
                    <i class="fas fa-folder me-1"></i> @Model.Folder?.Name
                    <span class="mx-2">·</span>
                    <i class="fas fa-tag me-1"></i> @Model.Category?.Name
                </p>
            </div>
            <div class="ms-auto d-flex gap-2 flex-wrap">
                <!-- Status Badge -->
                <span class="ticket-status-badge @(Model.Status == DocumentStatus.Active || Model.Status == DocumentStatus.Approved ? "active" : Model.Status == DocumentStatus.PendingApproval ? "pending" : "closed")">
                    <i class="fas @(Model.Status == DocumentStatus.Active || Model.Status == DocumentStatus.Approved ? "fa-check-circle" : Model.Status == DocumentStatus.PendingApproval ? "fa-clock" : "fa-ban")"></i>
                    @Model.Status
                </span>

                @if (isStaff)
                {
                    <a class="action-btn btn-timeline" asp-action="Timeline" asp-route-id="@Model.EmployeeId" title="Timeline">
                        <i class="fas fa-timeline"></i>
                    </a>
                    <a class="action-btn btn-history" asp-action="Audit" asp-route-documentId="@Model.Id" title="History">
                        <i class="fas fa-clipboard-list"></i>
                    </a>
                    <button class="action-btn btn-share" data-bs-toggle="modal" data-bs-target="#shareModal" title="Share">
                        <i class="fas fa-share-nodes"></i>
                    </button>
                    <button class="action-btn btn-version" data-bs-toggle="modal" data-bs-target="#versionModal" title="New Version">
                        <i class="fas fa-upload"></i>
                    </button>
                    @if (Model.IsArchived)
                    {
                        <form asp-action="Restore" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="action-btn btn-restore" title="Restore">
                                <i class="fas fa-box-open"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Archive" method="post" style="display:inline;" onsubmit="return confirm('Archive this document?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="action-btn btn-archive" title="Archive">
                                <i class="fas fa-box-archive"></i>
                            </button>
                        </form>
                    }
                }
                <a class="action-btn btn-preview" asp-action="Preview" asp-route-id="@Model.Id" target="_blank" title="Preview">
                    <i class="fas fa-eye"></i>
                </a>
                <a class="btn-download-primary" asp-action="Download" asp-route-id="@Model.Id">
                    <i class="fas fa-download"></i> Download
                </a>
            </div>
        </div>
    </div>

    <!-- SHARE LINK ALERT -->
    @if (TempData["ShareLink"] != null)
    {
        <div class="share-alert">
            <i class="fas fa-link"></i>
            <input type="text" class="share-link-input" readonly value="@TempData["ShareLink"]" onclick="this.select()" />
            <button class="btn-copy-link" onclick="navigator.clipboard.writeText('@TempData["ShareLink"]');showNotification('Link copied to clipboard', 'success');return false;">
                <i class="fas fa-copy"></i> Copy
            </button>
        </div>
    }

    <!-- ARCHIVED ALERT -->
    @if (Model.IsArchived)
    {
        <div class="archived-alert">
            <i class="fas fa-box-archive"></i>
            <span>This document is <strong>archived</strong>@(Model.ArchivedAt != null ? $" since {Model.ArchivedAt:MMM dd, yyyy}" : "").</span>
        </div>
    }

    <!-- MAIN CONTENT -->
    <div class="row g-3">
        <!-- PREVIEW COLUMN -->
        <div class="col-lg-7">
            <div class="data-card">
                <div class="card-header-custom">
                    <div>
                        <i class="fas fa-eye me-2"></i>
                        <span>Preview</span>
                    </div>
                    <div class="ticket-count">
                        <i class="fas fa-file"></i>
                        <span>@Model.CurrentVersion?.FileName</span>
                    </div>
                </div>
                <div class="preview-container">
                    @if (canFrame)
                    {
                        <iframe src="@Url.Action("Preview", new { id = Model.Id })" class="preview-iframe"></iframe>
                    }
                    else
                    {
                        <div class="preview-placeholder">
                            <i class="fas fa-file fa-4x"></i>
                            <p>Inline preview isn't available for this file type.</p>
                            <a class="btn-download-primary" asp-action="Download" asp-route-id="@Model.Id">
                                <i class="fas fa-download"></i> Download to view
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SIDEBAR COLUMN -->
        <div class="col-lg-5">
            <!-- DETAILS CARD -->
            <div class="data-card" style="margin-bottom:1.5rem;">
                <div class="card-header-custom">
                    <div>
                        <i class="fas fa-circle-info me-2"></i>
                        <span>Document Details</span>
                    </div>
                </div>
                <div class="card-body-custom">
                    <dl class="detail-grid">
                        <dt><i class="fas fa-flag"></i> Status</dt>
                        <dd>
                            <span class="status-badge @(Model.Status == DocumentStatus.Active || Model.Status == DocumentStatus.Approved ? "status-open" : Model.Status == DocumentStatus.PendingApproval ? "status-progress" : "status-closed")">
                                @Model.Status
                            </span>
                        </dd>
                        <dt><i class="fas fa-lock"></i> Confidentiality</dt>
                        <dd>@Model.ConfidentialityLevel</dd>
                        <dt><i class="fas fa-hashtag"></i> Document #</dt>
                        <dd>@(Model.DocumentNumber ?? "—")</dd>
                        <dt><i class="fas fa-calendar-plus"></i> Issue date</dt>
                        <dd>@(Model.IssueDate?.ToString("MMM dd, yyyy") ?? "—")</dd>
                        <dt><i class="fas fa-calendar-times"></i> Expiry date</dt>
                        <dd>
                            @if (Model.ExpiryDate == null)
                            {
                                <text>—</text>
                            }
                            else if (Model.IsExpired)
                            {
                                <span class="expiry-badge expired">
                                    <i class="fas fa-exclamation-triangle"></i>
                                    Expired @Model.ExpiryDate?.ToString("MMM dd, yyyy")
                                </span>
                            }
                            else
                            {
                                <span class="expiry-badge @(Model.DaysUntilExpiry <= 30 ? "warning" : "")">
                                    @Model.ExpiryDate?.ToString("MMM dd, yyyy")
                                    <span class="days-until">(@Model.DaysUntilExpiry days)</span>
                                </span>
                            }
                        </dd>
                        <dt><i class="fas fa-tags"></i> Tags</dt>
                        <dd>
                            @if (Model.Tags.Any())
                            {
                                foreach (var t in Model.Tags)
                                {
                                    <span class="tag-badge">@t.Tag?.Name</span>
                                }
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </dd>
                        <dt><i class="fas fa-weight-scale"></i> Size</dt>
                        <dd>@Size(Model.CurrentVersion?.FileSizeBytes ?? 0)</dd>
                        <dt><i class="fas fa-user"></i> Uploaded by</dt>
                        <dd>@(Model.CreatedByName ?? "—")</dd>
                        <dt><i class="fas fa-clock"></i> Created</dt>
                        <dd>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</dd>
                        <dt><i class="fas fa-eye"></i> Views</dt>
                        <dd>@Model.ViewCount</dd>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <dt><i class="fas fa-align-left"></i> Description</dt>
                            <dd>@Model.Description</dd>
                        }
                    </dl>
                </div>
            </div>

            <!-- SHARE LINKS CARD -->
            @if (isStaff)
            {
                var shares = ViewBag.Shares as List<IT_Service_Management_System.Models.Efm.DocumentShare> ?? new();
                <div class="data-card" style="margin-bottom:1.5rem;">
                    <div class="card-header-custom">
                        <div>
                            <i class="fas fa-share-nodes me-2"></i>
                            <span>Share Links</span>
                        </div>
                        <button class="action-btn btn-share" data-bs-toggle="modal" data-bs-target="#shareModal" title="Create Share Link">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <div class="share-list">
                        @if (shares.Any())
                        {
                            foreach (var sh in shares)
                            {
                                <div class="share-item">
                                    <div class="share-icon">
                                        <i class="fas @(sh.PasswordHash != null ? "fa-lock" : "fa-link")"></i>
                                    </div>
                                    <div class="share-info">
                                        <div class="share-details">
                                            @if (sh.ExpiresAt != null)
                                            {
                                                <span>Expires <strong>@sh.ExpiresAt?.ToString("MMM dd, yyyy")</strong></span>
                                            }
                                            else
                                            {
                                                <span>No expiry</span>
                                            }
                                            @if (sh.MaxDownloads != null)
                                            {
                                                <span class="mx-1">·</span>
                                                <span>max <strong>@sh.MaxDownloads</strong> downloads</span>
                                            }
                                        </div>
                                        <div class="share-meta">
                                            <i class="fas fa-download"></i> @sh.DownloadCount download(s)
                                            <span class="mx-1">·</span>
                                            <i class="fas fa-user"></i> @sh.CreatedByName
                                        </div>
                                    </div>
                                    <div class="share-actions">
                                        <a class="action-btn btn-view" href="@Url.Action("Shared", new { token = sh.Token })" target="_blank" title="Open">
                                            <i class="fas fa-up-right-from-square"></i>
                                        </a>
                                        <form asp-action="RevokeShare" method="post" style="display:inline;" onsubmit="return confirm('Revoke this link?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="shareId" value="@sh.Id" />
                                            <input type="hidden" name="documentId" value="@Model.Id" />
                                            <button class="action-btn btn-delete" title="Revoke">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-share">
                                <i class="fas fa-link"></i>
                                <p>No active share links.</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- VERSIONS CARD -->
            <div class="data-card" style="margin-bottom:1.5rem;">
                <div class="card-header-custom">
                    <div>
                        <i class="fas fa-code-branch me-2"></i>
                        <span>Versions</span>
                    </div>
                    <div class="ticket-count">
                        <i class="fas fa-files"></i>
                        <span>@Model.Versions.Count</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="data-table tickets-table version-table">
                        <thead>
                            <tr>
                                <th>Version</th>
                                <th>File</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th style="text-align:right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Versions.OrderByDescending(v => v.VersionNumber))
                            {
                                <tr>
                                    <td>
                                        <span class="version-badge">v@(v.VersionNumber)</span>
                                        @if (v.IsCurrent)
                                        {
                                            <span class="current-badge">Current</span>
                                        }
                                    </td>
                                    <td class="version-filename" title="@v.FileName">@v.FileName</td>
                                    <td class="version-size">@Size(v.FileSizeBytes)</td>
                                    <td>
                                        <div class="version-date">@v.UploadedAt.ToString("MMM dd, yyyy")</div>
                                        <div class="version-uploader">@v.UploadedByName</div>
                                        @if (!string.IsNullOrEmpty(v.ChangeNote))
                                        {
                                            <div class="version-note" title="@v.ChangeNote">@v.ChangeNote</div>
                                        }
                                    </td>
                                    <td style="text-align:right;white-space:nowrap;">
                                        <div class="action-buttons">
                                            @if (isStaff)
                                            {
                                                <a class="action-btn btn-download" asp-action="DownloadVersion" asp-route-versionId="@v.Id" title="Download this version">
                                                    <i class="fas fa-download"></i>
                                                </a>
                                                @if (!v.IsCurrent)
                                                {
                                                    <form asp-action="RestoreVersion" method="post" style="display:inline;" onsubmit="return confirm('Restore v@(v.VersionNumber) as the current version?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="documentId" value="@Model.Id" />
                                                        <input type="hidden" name="versionId" value="@v.Id" />
                                                        <button class="action-btn btn-restore-version" title="Restore this version">
                                                            <i class="fas fa-rotate-left"></i>
                                                        </button>
                                                    </form>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- APPROVALS CARD -->
            @if (Model.Approvals.Any())
            {
                <div class="data-card" style="margin-bottom:1.5rem;">
                    <div class="card-header-custom">
                        <div>
                            <i class="fas fa-clipboard-check me-2"></i>
                            <span>Approvals</span>
                        </div>
                        <div class="ticket-count">
                            <i class="fas fa-check-circle"></i>
                            <span>@Model.Approvals.Count(a => a.Status == ApprovalStatus.Approved)/@Model.Approvals.Count</span>
                        </div>
                    </div>
                    <div class="approval-list">
                        @foreach (var a in Model.Approvals.OrderBy(a => a.Level))
                        {
                            <div class="approval-item">
                                <span class="level-badge">Level @a.Level</span>
                                @if (a.Status == ApprovalStatus.Approved)
                                {
                                    <span class="status-badge status-open">
                                        <i class="fas fa-check"></i> Approved
                                    </span>
                                }
                                else if (a.Status == ApprovalStatus.Rejected)
                                {
                                    <span class="status-badge status-closed">
                                        <i class="fas fa-times"></i> Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-progress">
                                        <i class="fas fa-hourglass-half"></i> Pending
                                    </span>
                                }
                                <div class="approval-meta">
                                    @if (a.DecidedAt != null)
                                    {
                                        <span><i class="fas fa-user"></i> @a.DecidedByName</span>
                                        <span class="mx-1">·</span>
                                        <span><i class="fas fa-calendar"></i> @a.DecidedAt?.ToString("MMM dd, yyyy")</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.Comments))
                                    {
                                        <div class="approval-comment">“@a.Comments”</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- COMMENTS CARD -->
            @if (isStaff)
            {
                <div class="data-card">
                    <div class="card-header-custom">
                        <div>
                            <i class="fas fa-comments me-2"></i>
                            <span>Comments</span>
                        </div>
                        <div class="ticket-count">
                            <i class="fas fa-comment"></i>
                            <span>@Model.Comments.Count</span>
                        </div>
                    </div>
                    <div class="comments-container">
                        @if (Model.Comments.Any())
                        {
                            foreach (var c in Model.Comments.OrderByDescending(c => c.CreatedAt))
                            {
                                <div class="comment-item">
                                    <div class="comment-header">
                                        <strong>@(c.AuthorName ?? "Unknown")</strong>
                                        <span class="comment-time">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <div class="comment-body">@c.Body</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-comments">
                                <i class="fas fa-comment-slash"></i>
                                <p>No comments yet. Start the conversation below.</p>
                            </div>
                        }
                    </div>
                    <div class="comment-form">
                        <form asp-action="AddComment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="documentId" value="@Model.Id" />
                            <div class="comment-input-group">
                                <textarea name="body" class="comment-textarea" rows="2" maxlength="2000" required placeholder="Add a comment for colleagues…"></textarea>
                                <button class="btn-send-comment" type="submit">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- SHARE MODAL -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CreateShare" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-share-nodes me-2" style="color: var(--primary);"></i>
                        Create Secure Share Link
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="modal-hint">Creates a read-only, access-logged link. Optionally add an expiry, a password and a download limit.</p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="modal-label">Expires (days)</label>
                            <input type="number" name="expiresDays" class="modal-input" min="1" max="365" placeholder="Never" />
                        </div>
                        <div class="col-md-4">
                            <label class="modal-label">Max downloads</label>
                            <input type="number" name="maxDownloads" class="modal-input" min="1" placeholder="Unlimited" />
                        </div>
                        <div class="col-md-4">
                            <label class="modal-label">Password</label>
                            <input type="text" name="password" class="modal-input" placeholder="Optional" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-modal-primary">
                        <i class="fas fa-share-nodes"></i> Create Link
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- VERSION MODAL -->
<div class="modal fade" id="versionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="UploadVersion" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-upload me-2" style="color: var(--primary);"></i>
                        Upload New Version
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="modal-hint">
                        This creates a new version and makes it current. The current version (v@(Model.CurrentVersion?.VersionNumber)) is kept in history.
                    </p>
                    <div class="mb-3">
                        <label class="modal-label">File</label>
                        <input type="file" name="file" class="modal-input-file" required />
                    </div>
                    <div class="mb-1">
                        <label class="modal-label">Change note <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="changeNote" class="modal-input" maxlength="500" placeholder="What changed in this version?" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-modal-primary">
                        <i class="fas fa-upload"></i> Upload Version
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== STATUS BADGE ===== */
    .ticket-status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .ticket-status-badge.active {
            background: #e6f5e9;
            color: var(--success);
        }

        .ticket-status-badge.pending {
            background: #fff5e6;
            color: var(--warning);
        }

        .ticket-status-badge.closed {
            background: var(--gray-100);
            color: var(--gray-500);
        }

    /* ===== ACTION BUTTONS ===== */
    .action-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
