@model IT_Service_Management_System.ViewModels.Efm.EmployeeFileBrowserVm
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "My Documents - Axis IT Operations";
    string Size(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0.#} KB" : $"{b} B";
    string StatusPill(DocumentStatus s) => s switch {
        DocumentStatus.PendingApproval => "badge-amber", DocumentStatus.Rejected or DocumentStatus.Expired => "badge-red",
        DocumentStatus.Approved or DocumentStatus.Active => "badge-green", _ => "badge-gray" };
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
            <div>
                <h1 class="page-title"><i class="fas fa-folder me-2" style="color:var(--primary);"></i>My Documents</h1>
                <p class="text-muted mt-2">Your personal documents. New uploads are sent to HR for approval.</p>
            </div>
            <button class="btn-create" data-bs-toggle="modal" data-bs-target="#myUploadModal"><i class="fas fa-cloud-arrow-up"></i> Upload Document</button>
        </div>
    </div>

    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-file-lines me-2"></i><span>Documents</span></div>
            <span class="record-count">@Model.TotalDocuments</span>
        </div>
        <div class="table-responsive">
            @if (Model.Documents.Any())
            {
                <table class="data-table">
                    <thead><tr>
                        <th><i class="fas fa-file me-1"></i> Document</th><th><i class="fas fa-tag me-1"></i> Category</th>
                        <th><i class="fas fa-folder me-1"></i> Folder</th><th><i class="fas fa-chart-simple me-1"></i> Status</th>
                        <th><i class="fas fa-calendar me-1"></i> Uploaded</th><th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var d in Model.Documents)
                        {
                            <tr>
                                <td><strong>@d.Title</strong> <span class="text-muted" style="font-size:0.72rem;">@Size(d.CurrentVersion?.FileSizeBytes ?? 0)</span></td>
                                <td>@d.Category?.Name</td>
                                <td>@d.Folder?.Name</td>
                                <td><span class="status-badge @StatusPill(d.Status)">@(d.Status == DocumentStatus.PendingApproval ? "Pending Approval" : d.Status.ToString())</span></td>
                                <td class="date-cell"><i class="far fa-calendar-alt"></i> @d.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="action-buttons" style="justify-content:flex-end;">
                                        <a class="action-btn btn-view" asp-action="Preview" asp-route-id="@d.Id" target="_blank" title="Preview"><i class="fas fa-eye"></i></a>
                                        <a class="action-btn btn-download" asp-action="Download" asp-route-id="@d.Id" title="Download"><i class="fas fa-download"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-folder-open"></i>
                    <h3>No documents yet</h3>
                    <p>Upload a document — it will be sent to HR for approval.</p>
                    <button class="btn-create btn-create-sm" data-bs-toggle="modal" data-bs-target="#myUploadModal"><i class="fas fa-cloud-arrow-up"></i> Upload your first document</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="myUploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="MyUpload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-cloud-arrow-up me-2"></i>Upload Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Folder</label>
                            <select name="folderId" class="form-select" required>
                                @foreach (var f in Model.Folders) { <option value="@f.Id">@f.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="categoryId" class="form-select" required>
                                @foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <input type="text" name="description" class="form-control" maxlength="500" placeholder="Optional" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Files</label>
                            <input type="file" name="files" class="form-control" multiple required />
                            <div class="form-text">Up to 50&nbsp;MB per file. Uploads are reviewed by HR before approval.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-upload"></i> Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>
