</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Modal file list display
        const fileInput = document.getElementById('modalFileInput');
        const fileList = document.getElementById('modalFileList');

        if (fileInput && fileList) {
            fileInput.addEventListener('change', function() {
                fileList.innerHTML = '';
                const files = Array.from(this.files);

                if (files.length === 0) {
                    return;
                }

                files.forEach((file, index) => {
                    const fileItem = document.createElement('span');
                    fileItem.className = 'file-item';
                    const fileSize = formatFileSize(file.size);
                    fileItem.innerHTML = `
                        <i class="fas fa-file"></i>
                        ${file.name} (${fileSize})
                        <span class="remove-file" data-index="${index}">
                            <i class="fas fa-times"></i>
                        </span>
                    `;
                    fileList.appendChild(fileItem);
                });

                // Remove file functionality
                document.querySelectorAll('.remove-file').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const index = parseInt(this.getAttribute('data-index'));
                        const dt = new DataTransfer();
                        const files = Array.from(fileInput.files);
                        files.splice(index, 1);
                        files.forEach(f => dt.items.add(f));
                        fileInput.files = dt.files;
                        fileInput.dispatchEvent(new Event('change'));
                    });
                });
            });
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        // Fulfill-request modal: carry the clicked request into the hidden field + label
        const fulfillModal = document.getElementById('fulfillModal');
        if (fulfillModal) {
            fulfillModal.addEventListener('show.bs.modal', function(event) {
                const btn = event.relatedTarget;
                if (!btn) return;
                document.getElementById('fulfillRequestId').value = btn.getAttribute('data-request-id');
                document.getElementById('fulfillRequestTitle').value = btn.getAttribute('data-request-title');
            });

            const fulfillInput = document.getElementById('fulfillFileInput');
            const fulfillList = document.getElementById('fulfillFileList');
            if (fulfillInput && fulfillList) {
                fulfillInput.addEventListener('change', function() {
                    fulfillList.innerHTML = '';
                    Array.from(this.files).forEach(file => {
                        const item = document.createElement('span');
                        item.className = 'file-item';
                        item.innerHTML = `<i class="fas fa-file"></i> ${file.name} (${formatFileSize(file.size)})`;
                        fulfillList.appendChild(item);
                    });
                });
            }
        }

        // Drag and drop visual feedback
        const dropZone = document.querySelector('.file-drop-zone');
        if (dropZone) {
            dropZone.addEventListener('dragover', function(e) {
                e.preventDefault();
                this.style.borderColor = 'var(--primary)';
                this.style.background = 'var(--gray-100)';
            });

            dropZone.addEventListener('dragleave', function(e) {
                e.preventDefault();
                this.style.borderColor = 'var(--gray-300)';
                this.style.background = 'var(--gray-50)';
            });

            dropZone.addEventListener('drop', function(e) {
                e.preventDefault();
                this.style.borderColor = 'var(--gray-300)';
                this.style.background = 'var(--gray-50)';
            });
        }

        // Client-side filtering
        const searchInput = document.querySelector('input[name="q"]');
        const categoryFilter = document.querySelector('select[name="categoryId"]');
        const folderFilter = document.querySelector('select[name="folderId"]');
        const statusFilter = document.querySelector('select[name="status"]');
        const table = document.getElementById('documentsTable');
        const rows = table ? table.querySelectorAll('tbody tr') : [];
        const visibleCountSpan = document.getElementById('visibleCount');

        function filterDocuments() {
            const searchValue = searchInput ? searchInput.value.toLowerCase() : '';
            const categoryValue = categoryFilter ? categoryFilter.value : '';
            const folderValue = folderFilter ? folderFilter.value : '';
            const statusValue = statusFilter ? statusFilter.value : '';

            let visibleCount = 0;

            rows.forEach(row => {
                const title = row.getAttribute('data-title')?.toLowerCase() || '';
                const category = row.getAttribute('data-category') || '';
                const folder = row.getAttribute('data-folder') || '';
                const status = row.getAttribute('data-status') || '';

                let show = true;

                if (searchValue && !title.includes(searchValue) && !category.toLowerCase().includes(searchValue)) {
                    show = false;
                }

                if (categoryValue && category !== categoryValue) {
                    show = false;
                }

                if (folderValue && folder !== folderValue) {
                    show = false;
                }

                if (statusValue && status !== statusValue) {
                    show = false;
                }

                if (show) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCountSpan) {
                visibleCountSpan.textContent = visibleCount;
            }

            // Show no results message
            const emptyState = document.querySelector('.empty-state:not(.original)');
            const tbody = table ? table.querySelector('tbody') : null;

            if (visibleCount === 0 && rows.length > 0) {
                if (!emptyState && tbody) {
                    const noResultsDiv = document.createElement('div');
                    noResultsDiv.className = 'empty-state';
                    noResultsDiv.innerHTML = `
                        <i class="fas fa-search"></i>
                        <h3>No matching documents found</h3>
                        <p>Try adjusting your filters or search terms</p>
                    `;
                    tbody.parentNode.appendChild(noResultsDiv);
                    if (table) table.style.display = 'none';
                }
            } else {
                if (emptyState) emptyState.remove();
                if (table) table.style.display = '';
            }
        }

        // Attach event listeners
        if (searchInput) {
            searchInput.addEventListener('keyup', filterDocuments);
        }
        if (categoryFilter) {
            categoryFilter.addEventListener('change', filterDocuments);
        }
        if (folderFilter) {
            folderFilter.addEventListener('change', filterDocuments);
        }
        if (statusFilter) {
            statusFilter.addEventListener('change', filterDocuments);
        }

        // Initialize
        filterDocuments();
    });
</script>