@model IT_Service_Management_System.ViewModels.Efm.EmployeeFileBrowserVm
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = $"{Model.Employee.FullName} - Digital File";
    var sel = Model.SelectedFolderId;
    var currentUrl = Url.Action("File", new { id = Model.Employee.Id, folderId = sel });
    string Size(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0.#} KB" : $"{b} B";
    string Icon(string? name)
    {
        var e = System.IO.Path.GetExtension(name ?? "").ToLowerInvariant();
        return e switch
        {
            ".pdf" => "fa-file-pdf",
            ".doc" or ".docx" => "fa-file-word",
            ".xls" or ".xlsx" or ".csv" => "fa-file-excel",
            ".ppt" or ".pptx" => "fa-file-powerpoint",
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".bmp" or ".tif" or ".tiff" or ".webp" => "fa-file-image",
            ".zip" or ".rar" or ".7z" => "fa-file-zipper",
            ".txt" => "fa-file-lines",
            _ => "fa-file"
        };
    }
}

<div class="page-container efm-browser">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title" style="font-size:1.5rem;">
                        <i class="fas fa-folder-tree me-2" style="color:var(--primary);"></i>
                        @Model.Employee.FullName
                    </h1>
                    <p class="text-muted mt-1" style="font-size:0.85rem;">
                        <i class="fas fa-envelope me-1"></i> @Model.Employee.Email
                        <span class="mx-2">·</span>
                        <i class="fas fa-building me-1"></i> @(Model.Employee.Department?.Name ?? "No department")
                        <span class="mx-2">·</span>
                        <i class="fas fa-user-tag me-1"></i> @Model.Employee.Role
                        <span class="mx-2">·</span>
                        <i class="fas fa-file-alt me-1"></i> <strong>@Model.TotalDocuments</strong> document(s)
                    </p>
                </div>
            </div>
            <button class="btn-create-ticket" data-bs-toggle="modal" data-bs-target="#uploadModal">
                <i class="fas fa-cloud-arrow-up"></i> Upload Documents
            </button>
        </div>

        <!-- BREADCRUMB -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb" style="font-size:0.85rem; margin:0;">
                <li class="breadcrumb-item"><a asp-action="Index" style="color:var(--primary);text-decoration:none;">Employees</a></li>
                <li class="breadcrumb-item"><a asp-action="File" asp-route-id="@Model.Employee.Id" style="color:var(--primary);text-decoration:none;">@Model.Employee.FullName</a></li>
                <li class="breadcrumb-item active" style="color:var(--gray-600);">
                    @(sel == null ? "All Documents" : Model.Folders.FirstOrDefault(f => f.Id == sel)?.Name)
                </li>
            </ol>
        </nav>
    </div>

    <!-- FILE COMPLETENESS -->
    @{
        var comp = ViewBag.Completeness as IT_Service_Management_System.Services.Efm.CompletenessResult;
    }
    @if (comp != null && comp.RequiredCount > 0)
    {
        <div class="completeness-card mb-4">
            <div class="d-flex align-items-center justify-content-between mb-2" style="font-size:0.85rem;">
                <span>
                    <i class="fas fa-clipboard-check me-1" style="color:var(--primary);"></i>
                    File completeness — <strong>@comp.PresentCount / @comp.RequiredCount</strong> required documents present
                </span>
                <strong class="@(comp.Percent == 100 ? "text-success" : comp.Percent >= 75 ? "text-warning" : "text-danger")">
                    @comp.Percent%
                </strong>
            </div>
            <div class="progress" style="height:8px; background:var(--gray-200); border-radius:0.5rem; overflow:hidden;">
                <div class="progress-bar @(comp.Percent == 100 ? "bg-success" : comp.Percent >= 75 ? "bg-warning" : "bg-danger")"
                     style="width:@comp.Percent%; transition: width 0.6s ease;">
                </div>
            </div>
            @if (comp.MissingCategories.Any())
            {
                <div class="mt-2" style="font-size:0.78rem; color:var(--gray-500);">
                    <i class="fas fa-triangle-exclamation" style="color:#f59e0b;"></i>
                    Missing: @string.Join(", ", comp.MissingCategories)
                </div>
            }
        </div>
    }

    <!-- MAIN GRID -->
    <div class="efm-grid">
        <!-- FOLDER RAIL -->
        <aside class="efm-folders">
            <div class="folders-header">
                <i class="fas fa-folder-open me-1"></i>
                <span>Folders</span>
            </div>
            <a asp-action="File" asp-route-id="@Model.Employee.Id" class="efm-folder @(sel == null ? "active" : "")">
                <i class="fas fa-layer-group"></i>
                <span>All Documents</span>
                <span class="efm-count">@Model.TotalDocuments</span>
            </a>
            @foreach (var f in Model.Folders)
            {
                var n = Model.FolderCounts.TryGetValue(f.Id, out var c) ? c : 0;
                <a asp-action="File" asp-route-id="@Model.Employee.Id" asp-route-folderId="@f.Id"
                   class="efm-folder @(sel == f.Id ? "active" : "")">
                    <i class="fas @(f.Icon ?? "fa-folder")"></i>
                    <span>@f.Name</span>
                    <span class="efm-count @(n > 0 ? "on" : "")">@n</span>
                </a>
            }
        </aside>

        <!-- DOCUMENTS SECTION -->
        <section class="efm-docs">
            @if (Model.Documents.Any())
            {
                <!-- Bulk Selection Header -->
                <div class="bulk-header">
                    <label class="bulk-select-all">
                        <input type="checkbox" id="bulkSelectAll" onchange="bulkToggleAll(this)" />
                        Select all
                    </label>
                    <span id="bulkSelectedText" class="bulk-selected-text"></span>
                </div>

                <!-- Document Cards -->
                <div class="efm-cards">
                    @foreach (var d in Model.Documents)
                    {
                        var expTracked = d.Category?.IsExpiryTracked ?? false;
                        <div class="efm-card">
                            <input type="checkbox" class="bulk-check" value="@d.Id" onchange="bulkSync()" title="Select" />

                            <div class="efm-card-icon">
                                <i class="fas @Icon(d.CurrentVersion?.FileName)"></i>
                            </div>

                            <div class="efm-card-body">
                                <a asp-action="Details" asp-route-id="@d.Id" class="efm-card-title" title="@d.Title">
                                    @d.Title
                                </a>

                                <div class="efm-card-meta">
                                    <span class="category-badge">@d.Category?.Name</span>

                                    @if (d.ConfidentialityLevel >= ConfidentialityLevel.Confidential)
                                    {
                                        <span class="confidentiality-badge confidential">
                                            <i class="fas fa-lock"></i> @d.ConfidentialityLevel
                                        </span>
                                    }

                                    @if (d.ExpiryDate != null)
                                    {
                                        var overdue = d.IsExpired;
                                        var soon = !overdue && d.DaysUntilExpiry <= 30;
                                        <span class="expiry-badge @(overdue ? "expired" : soon ? "expiring-soon" : "")">
                                            <i class="fas fa-hourglass-half"></i>
                                            @(overdue ? "Expired" : $"Exp {d.ExpiryDate:MMM dd, yyyy}")
                                        </span>
                                    }
                                </div>

                                <div class="efm-card-sub">
                                    @Size(d.CurrentVersion?.FileSizeBytes ?? 0) · @d.CreatedAt.ToString("MMM dd, yyyy")
                                </div>
                            </div>

                            <div class="efm-card-actions">
                                <button class="action-btn btn-view" title="Preview" onclick="efmPreview(@d.Id, '@d.CurrentVersion?.ContentType')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <a class="action-btn btn-download" title="Download" asp-action="Download" asp-route-id="@d.Id">
                                    <i class="fas fa-download"></i>
                                </a>
                                <form asp-action="Archive" method="post" style="display:inline;" onsubmit="return confirm('Archive this document?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />
                                    <button class="action-btn btn-archive" title="Archive">
                                        <i class="fas fa-box-archive"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@d.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete this document?');">
                                    @Html.AntiForgeryToken()
                                    <button class="action-btn btn-delete" title="Delete">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-folder-open"></i>
                    <h3>No documents here</h3>
                    <p>This folder is empty. Upload your first document to get started.</p>
                    <button class="btn-create-ticket-sm" data-bs-toggle="modal" data-bs-target="#uploadModal">
                        <i class="fas fa-cloud-arrow-up"></i> Upload
                    </button>
                </div>
            }
        </section>
    </div>
</div>

<!-- BULK ACTION BAR -->
<form id="bulkForm" asp-action="Bulk" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="employeeId" value="@Model.Employee.Id" />
    <input type="hidden" name="returnUrl" value="@currentUrl" />
    <input type="hidden" name="op" id="bulkOp" />
    <div id="bulkIds"></div>
    <div id="bulkBar" class="bulk-bar">
        <span class="bulk-count"><strong id="bulkCount">0</strong> selected</span>
        <button type="button" class="btn-bulk" onclick="bulkSubmit('download')">
            <i class="fas fa-download"></i> Download
        </button>
        <div class="bulk-inline">
            <select name="targetFolderId" class="bulk-select">
                @foreach (var f in Model.Folders)
                {
                    <option value="@f.Id">@f.Name</option>
                }
            </select>
            <button type="button" class="btn-bulk" onclick="bulkSubmit('move')">
                <i class="fas fa-folder-tree"></i> Move
            </button>
        </div>
        <div class="bulk-inline">
            <input type="text" name="tags" class="bulk-input" placeholder="tag1, tag2" />
            <button type="button" class="btn-bulk" onclick="bulkSubmit('tag')">
                <i class="fas fa-tags"></i> Tag
            </button>
        </div>
        <button type="button" class="btn-bulk" onclick="bulkSubmit('archive', 'Archive the selected documents?')">
            <i class="fas fa-box-archive"></i> Archive
        </button>
        <button type="button" class="btn-bulk btn-bulk-danger" onclick="bulkSubmit('delete', 'Delete the selected documents?')">
            <i class="fas fa-trash-alt"></i> Delete
        </button>
        <button type="button" class="btn-bulk-close" onclick="bulkClear()">
            <i class="fas fa-times"></i>
        </button>
    </div>
</form>

<!-- UPLOAD MODAL -->
<div class="modal fade" id="uploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-cloud-arrow-up me-2" style="color:var(--primary);"></i>
                    Upload Documents — @Model.Employee.FullName
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="efmUploadForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="EmployeeId" value="@Model.Employee.Id" />

                    <!-- Drop Zone -->
                    <div id="efmDrop" class="efm-drop">
                        <i class="fas fa-cloud-arrow-up"></i>
                        <p><strong>Drag &amp; drop files here</strong> or <span class="efm-browse">browse</span></p>
                        <small class="text-muted">PDF, Word, Excel, PowerPoint, images, TXT, ZIP — up to 50&nbsp;MB each</small>
                        <input type="file" id="efmFiles" name="files" multiple hidden />
                    </div>

                    <!-- File Queue -->
                    <ul id="efmQueue" class="efm-queue"></ul>

                    <!-- Scan Status -->
                    <div id="efmScanStatus" class="efm-scan-status" style="display:none;"></div>

                    <!-- Form Fields -->
                    <div class="upload-form-grid">
                        <div class="upload-field">
                            <label class="field-label">Folder</label>
                            <select name="FolderId" class="filter-select" required>
                                @foreach (var f in Model.Folders)
                                {
                                    <option value="@f.Id" selected="@(sel == f.Id)">@f.Name</option>
                                }
                            </select>
                        </div>
                        <div class="upload-field">
                            <label class="field-label">Category</label>
                            <select name="CategoryId" class="filter-select" required>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="upload-field">
                            <label class="field-label">Confidentiality</label>
                            <select name="Confidentiality" class="filter-select">
                                <option value="0">Public</option>
                                <option value="1">Internal</option>
                                <option value="2" selected>Confidential</option>
                                <option value="3">Restricted</option>
                            </select>
                        </div>
                        <div class="upload-field">
                            <label class="field-label">Document Number</label>
                            <input type="text" name="DocumentNumber" class="search-input" placeholder="Optional" />
                        </div>
                        <div class="upload-field">
                            <label class="field-label">Issue Date</label>
                            <input type="date" name="IssueDate" class="search-input" />
                        </div>
                        <div class="upload-field">
                            <label class="field-label">Expiry Date</label>
                            <input type="date" name="ExpiryDate" class="search-input" />
                        </div>
                        <div class="upload-field full-width">
                            <label class="field-label">Tags <span class="text-muted fw-normal">(comma separated)</span></label>
                            <input type="text" name="TagsCsv" class="search-input" placeholder="e.g. 2026, signed, original" />
                        </div>
                        <div class="upload-field full-width">
                            <label class="field-label">Description</label>
                            <textarea name="Description" class="search-input" rows="2" placeholder="Optional notes" style="resize:vertical;"></textarea>
                        </div>
                    </div>

                    <!-- Progress -->
                    <div id="efmProgressWrap" class="upload-progress" style="display:none;">
                        <div class="progress">
                            <div id="efmProgress" class="progress-bar" style="width:0%"></div>
                        </div>
                        <small id="efmProgressText" class="text-muted"></small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="efmUploadBtn" class="btn-modal-upload">
                    <i class="fas fa-upload"></i> Upload
                </button>
            </div>
        </div>
    </div>
</div>

<!-- PREVIEW MODAL -->
<div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="height:85vh;">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-eye me-2" style="color:var(--primary);"></i>Preview</h5>
                <a id="previewOpen" href="#" target="_blank" class="btn-modal-preview-open">
                    <i class="fas fa-up-right-from-square"></i> Open in tab
                </a>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" style="overflow:hidden;">
                <iframe id="previewFrame" src="" style="width:100%;height:100%;border:0;"></iframe>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        font-size: 0.875rem;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-create-ticket-sm {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
    }

        .btn-create-ticket-sm:hover {
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

    /* ===== BREADCRUMB ===== */
    .breadcrumb {
        padding: 0.75rem 0;
        margin: 0;
        background: transparent;
        border-bottom: 1px solid var(--gray-200);
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
        color: var(--gray-400);
    }

    /* ===== COMPLETENESS CARD ===== */
    .completeness-card {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: 1rem;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--shadow-sm);
    }

    .progress-bar {
        transition: width 0.6s ease;
    }

    .bg-success {
        background: var(--success) !important;
    }

    .bg-warning {
        background: var(--warning) !important;
    }

    .bg-danger {
        background: var(--danger) !important;
    }

    .text-success {
        color: var(--success) !important;
    }

    .text-warning {
        color: var(--warning) !important;
    }

    .text-danger {
        color: var(--danger) !important;
    }

    /* ===== MAIN GRID ===== */
    .efm-grid {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 1.5rem;
        align-items: start;
    }

    /* ===== FOLDERS RAIL ===== */
    .efm-folders {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: 1rem;
        padding: 0.75rem;
        position: sticky;
        top: 1rem;
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
        box-shadow: var(--shadow-sm);
    }

    .folders-header {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray-500);
        padding: 0.5rem 0.5rem 0.75rem 0.5rem;
        border-bottom: 1px solid var(--gray-200);
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .efm-folder {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 0.7rem;
        border-radius: 0.6rem;
        color: var(--gray-700);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.15s;
        margin-bottom: 0.1rem;
    }

        .efm-folder span:first-of-type {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .efm-folder i {
            width: 18px;
            text-align: center;
            color: var(--gray-400);
            flex-shrink: 0;
        }

        .efm-folder:hover {
            background: var(--gray-50);
            color: var(--primary-dark);
            text-decoration: none;
        }

        .efm-folder.active {
            background: #dbeafe;
            color: var(--primary-dark);
            font-weight: 600;
        }

            .efm-folder.active i {
                color: var(--primary);
            }

    .efm-count {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--gray-400);
        background: var(--gray-100);
        border-radius: 1rem;
        padding: 0.05rem 0.45rem;
        flex-shrink: 0;
    }

        .efm-count.on {
            background: var(--primary);
            color: white;
        }

    /* ===== BULK HEADER ===== */
    .bulk-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem 0;
        margin-bottom: 0.75rem;
        font-size: 0.82rem;
        color: var(--gray-600);
    }

    .bulk-select-all {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
    }

        .bulk-select-all input[type="checkbox"] {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: var(--primary);
        }

    .bulk-selected-text {
        color: var(--gray-500);
        font-size: 0.78rem;
    }

    /* ===== DOCUMENT CARDS ===== */
    .efm-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
    }

    .efm-card {
        position: relative;
