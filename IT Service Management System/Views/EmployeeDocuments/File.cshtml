</style>

<script>
    (function () {
        const drop = document.getElementById('efmDrop');
        const input = document.getElementById('efmFiles');
        const queue = document.getElementById('efmQueue');
        const form = document.getElementById('efmUploadForm');
        const btn = document.getElementById('efmUploadBtn');
        let files = [];

        function render() {
            queue.innerHTML = '';
            files.forEach((f, i) => {
                const li = document.createElement('li');
                li.innerHTML = `
                    <i class="fas fa-file"></i>
                    <span>${f.name}</span>
                    <span class="text-muted">${(f.size/1024).toFixed(0)} KB</span>
                    <i class="fas fa-times rm" data-i="${i}"></i>
                `;
                queue.appendChild(li);
            });
            queue.querySelectorAll('.rm').forEach(x => x.addEventListener('click', e => {
                files.splice(+e.target.dataset.i,1);
                scannedFor = null;
                render();
                maybeScan();
            }));
        }

        function add(list){ for (const f of list) files.push(f); render(); maybeScan(); }

        // OCR pre-scan
        const scanStatus = document.getElementById('efmScanStatus');
        let scannedFor = null;

        function maybeScan() {
            if (files.length !== 1) {
                scanStatus.style.display = 'none';
                return;
            }
            const f = files[0];
            const ok = f.type.startsWith('image/') || f.type === 'application/pdf';
            if (!ok || scannedFor === f) return;
            scannedFor = f;

            scanStatus.style.display = 'block';
            scanStatus.className = 'efm-scan-status text-muted';
            scanStatus.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Scanning document for details…';

            const fd = new FormData();
            fd.append('file', f);
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch('@Url.Action("ScanDocument")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: fd
            })
            .then(r => r.json())
            .then(d => {
                if (!d.ok) {
                    scanStatus.style.display = d.enabled === false ? 'none' : 'block';
                    scanStatus.className = 'efm-scan-status text-muted';
                    scanStatus.innerHTML = d.enabled === false ? '' : '<i class="fas fa-circle-info"></i> ' + (d.message || 'No details found.');
                    return;
                }
                const set = (name, val) => {
                    const el = form.querySelector(`[name="${name}"]`);
                    if (el && val && !el.value) el.value = val;
                };
                let filled = [];
                if (d.documentNumber) { set('DocumentNumber', d.documentNumber); filled.push('document #'); }
                else if (d.idNumber) { set('DocumentNumber', d.idNumber); filled.push('ID #'); }
                if (d.issueDate) { set('IssueDate', d.issueDate); filled.push('issue date'); }
                if (d.expiryDate) { set('ExpiryDate', d.expiryDate); filled.push('expiry date'); }
                scanStatus.className = 'efm-scan-status text-success';
                scanStatus.innerHTML = filled.length
                    ? '<i class="fas fa-wand-magic-sparkles"></i> Pre-filled: ' + filled.join(', ') + '. Please review.'
                    : '<i class="fas fa-circle-info"></i> Scanned — no matching fields detected.';
            })
            .catch(() => { scanStatus.style.display = 'none'; });
        }

        // Drop zone events
        drop.addEventListener('click', () => input.click());
        document.querySelector('.efm-browse')?.addEventListener('click', e => { e.stopPropagation(); input.click(); });
        input.addEventListener('change', () => add(input.files));
        ['dragover','dragenter'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('drag'); }));
        ['dragleave','drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('drag'); }));
        drop.addEventListener('drop', e => { if (e.dataTransfer.files.length) add(e.dataTransfer.files); });

        // Upload button
        btn.addEventListener('click', function () {
            if (!files.length) {
                showNotification('Please add at least one file.', 'warning');
                return;
            }
            const fd = new FormData(form);
            files.forEach(f => fd.append('files', f));
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

            const wrap = document.getElementById('efmProgressWrap');
            const bar = document.getElementById('efmProgress');
            const txt = document.getElementById('efmProgressText');
            wrap.style.display = 'block';
            btn.disabled = true;

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '@Url.Action("Upload")', true);
            xhr.setRequestHeader('RequestVerificationToken', token);
            xhr.upload.onprogress = e => {
                if (e.lengthComputable) {
                    const pct = Math.round(e.loaded / e.total * 100);
                    bar.style.width = pct + '%';
                    txt.textContent = 'Uploading… ' + pct + '%';
                }
            };
            xhr.onload = function () {
                btn.disabled = false;
                if (xhr.status >= 200 && xhr.status < 300) {
                    txt.textContent = 'Done. Refreshing…';
                    setTimeout(() => window.location.reload(), 600);
                } else {
                    let m = 'Upload failed.';
                    try { m = JSON.parse(xhr.responseText).message || m; } catch {}
                    showNotification(m, 'error');
                    wrap.style.display = 'none';
                }
            };
            xhr.onerror = function () {
                btn.disabled = false;
                showNotification('Network error during upload.', 'error');
            };
            xhr.send(fd);
        });

        // Notification helper
        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = 'notification-toast';
            const colors = {
                success: '#2c9e6e',
                error: '#e53e3e',
                warning: '#f5b042'
            };
            notification.style.cssText = `
                position: fixed;
                top: 1rem;
                right: 1rem;
                background: ${colors[type] || colors.success};
                color: white;
                padding: 1rem 1.5rem;
                border-radius: 0.75rem;
                box-shadow: var(--shadow-lg);
                z-index: 1050;
                animation: slideIn 0.3s ease;
                font-size: 0.875rem;
            `;
            notification.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i> ${message}`;
            document.body.appendChild(notification);

            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => notification.remove(), 300);
            }, 3000);
        }
    })();

    // Preview function
    function efmPreview(id, ctype) {
        const url = '@Url.Action("Preview")/' + id;
        document.getElementById('previewFrame').src = url;
        document.getElementById('previewOpen').href = url;
        new bootstrap.Modal(document.getElementById('previewModal')).show();
    }

    // ── bulk selection ──────────────────────────────────────────────────────────
    function bulkChecks() { return Array.from(document.querySelectorAll('.bulk-check')); }
    function bulkSelected() { return bulkChecks().filter(c => c.checked); }

    function bulkSync() {
        const sel = bulkSelected();
        const bar = document.getElementById('bulkBar');
        document.getElementById('bulkCount').textContent = sel.length;
        document.getElementById('bulkSelectedText').textContent = sel.length ? `(${sel.length} selected)` : '';
        bar.classList.toggle('show', sel.length > 0);
        const all = document.getElementById('bulkSelectAll');
        if (all) all.checked = sel.length > 0 && sel.length === bulkChecks().length;
    }

    function bulkToggleAll(cb) {
        bulkChecks().forEach(c => c.checked = cb.checked);
        bulkSync();
    }

    function bulkClear() {
        bulkChecks().forEach(c => c.checked = false);
        const a = document.getElementById('bulkSelectAll');
        if (a) a.checked = false;
        bulkSync();
    }

    function bulkSubmit(op, confirmMsg) {
        const sel = bulkSelected();
        if (!sel.length) {
            showNotification('Select at least one document.', 'warning');
            return;
        }
        if (confirmMsg && !confirm(confirmMsg)) return;
        const container = document.getElementById('bulkIds');
        container.innerHTML = '';
        sel.forEach(c => {
            const i = document.createElement('input');
            i.type = 'hidden';
            i.name = 'ids';
            i.value = c.value;
            container.appendChild(i);
        });
        document.getElementById('bulkOp').value = op;
        document.getElementById('bulkForm').submit();
    }
</script>