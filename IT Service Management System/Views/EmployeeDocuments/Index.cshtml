@model IEnumerable<IT_Service_Management_System.Models.User>
@{
    ViewData["Title"] = "Employee File Management - Axis IT Operations";
    var counts = ViewBag.DocCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var q = ViewBag.Search as string;
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-folder-tree me-2" style="color: var(--primary);"></i>
                    Employee File Management
                </h1>
                <p class="text-muted mt-2">Open an employee's digital personnel file to manage their documents</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Dashboard" class="btn btn-outline-primary"><i class="fas fa-chart-pie"></i> Dashboard</a>
                <a asp-action="Notifications" class="btn btn-outline-primary"><i class="fas fa-bell"></i> Notifications</a>
                <a asp-action="Audit" class="btn btn-outline-primary"><i class="fas fa-clipboard-list"></i> Audit</a>
                <a asp-action="Search" class="btn btn-primary"><i class="fas fa-magnifying-glass"></i> Search</a>
            </div>
        </div>
    </div>

    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-users me-2"></i><span>Employees</span></div>
            <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 m-0">
                <div style="position:relative;">
                    <i class="fas fa-search" style="position:absolute;left:0.75rem;top:50%;transform:translateY(-50%);color:var(--gray-400);"></i>
                    <input type="text" name="q" value="@q" placeholder="Search name or email..." class="form-control" style="padding-left:2.25rem;min-width:240px;" />
                </div>
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
                @if (!string.IsNullOrEmpty(q)) { <a asp-action="Index" class="btn btn-outline-secondary"><i class="fas fa-times"></i></a> }
            </form>
        </div>
        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="data-table">
                    <thead><tr>
                        <th><i class="fas fa-user me-1"></i> Employee</th><th><i class="fas fa-envelope me-1"></i> Email</th>
                        <th><i class="fas fa-building me-1"></i> Department</th><th><i class="fas fa-user-tag me-1"></i> Role</th>
                        <th style="text-align:center;"><i class="fas fa-file me-1"></i> Documents</th><th style="text-align:right;"><i class="fas fa-cog me-1"></i> Action</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            var n = counts.TryGetValue(u.Id, out var c) ? c : 0;
                            <tr>
                                <td class="creator-cell">
                                    <div class="list-avatar-cell">
                                        <div class="list-avatar">@((u.FirstName.Substring(0,1) + (u.LastName.Length>0 ? u.LastName.Substring(0,1) : "")))</div>
                                        <strong>@u.FullName</strong>
                                    </div>
                                </td>
                                <td>@u.Email</td>
                                <td>@(u.Department?.Name ?? "—")</td>
                                <td>@u.Role</td>
                                <td style="text-align:center;"><span class="status-badge @(n>0 ? "badge-blue" : "badge-gray")"><i class="fas fa-file"></i> @n</span></td>
                                <td style="text-align:right;">
                                    <a asp-action="File" asp-route-id="@u.Id" class="btn-create btn-create-sm"><i class="fas fa-folder-open"></i> Open File</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><i class="fas fa-user-slash"></i><h3>No employees found</h3><p>Try a different search.</p></div>
            }
        </div>
    </div>
</div>
