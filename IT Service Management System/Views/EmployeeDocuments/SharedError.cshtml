@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Link Unavailable — Axis IT Operations</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
            /* ===== ROOT VARIABLES (from Dashboard) ===== */
            :root {
                --primary-dark: #8f171c;
                --primary: #b11d23;
                --primary-light: #d9565d;
                --success: #2c9e6e;
                --warning: #f5b042;
                --danger: #e53e3e;
                --info: #b11d23;
                --gray-50: #f8fafc;
                --gray-100: #f1f5f9;
                --gray-200: #e2e8f0;
                --gray-300: #cbd5e1;
                --gray-400: #94a3b8;
                --gray-500: #64748b;
                --gray-600: #475569;
                --gray-700: #334155;
                --gray-800: #1e293b;
                --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
                --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
                --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
                --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
            }

            /* ===== BASE ===== */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: var(--gray-50);
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 1.5rem;
            }

            /* ===== ERROR CARD ===== */
            .error-container {
                max-width: 520px;
                width: 100%;
                margin: 0 auto;
            }

            .error-card {
                background: white;
                border-radius: 1rem;
                box-shadow: var(--shadow-lg);
                border: 1px solid var(--gray-200);
                padding: 3rem 2.5rem;
                text-align: center;
                transition: all 0.3s ease;
            }

                .error-card:hover {
                    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.15);
                }

            /* ===== ICON ===== */
            .error-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 80px;
                height: 80px;
                border-radius: 2rem;
                background: #fee;
                margin-bottom: 1.5rem;
            }

                .error-icon i {
                    font-size: 2.5rem;
                    color: var(--danger);
                }

            /* ===== TYPOGRAPHY ===== */
            .error-title {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--gray-800);
                margin-bottom: 0.5rem;
            }

            .error-message {
                font-size: 1rem;
                color: var(--gray-500);
                line-height: 1.6;
                margin-bottom: 2rem;
            }

            /* ===== BUTTON ===== */
            .btn-back-home {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                background: linear-gradient(100deg, var(--primary-dark), var(--primary));
                color: white;
                padding: 0.75rem 1.75rem;
                border-radius: 0.75rem;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.3s ease;
                box-shadow: var(--shadow-sm);
                border: none;
                cursor: pointer;
                font-size: 0.875rem;
            }

                .btn-back-home:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                    color: white;
                    text-decoration: none;
                }

                .btn-back-home i {
                    font-size: 0.875rem;
                }

            /* ===== FOOTER ===== */
            .error-footer {
                margin-top: 2rem;
                font-size: 0.75rem;
                color: var(--gray-400);
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
            }

                .error-footer i {
                    font-size: 0.7rem;
                    color: var(--primary);
                }

                .error-footer .separator {
                    color: var(--gray-300);
                }

            /* ===== RESPONSIVE ===== */
            @@media (max-width: 576px) {
                .error-card {
                    padding: 2rem 1.5rem;
                }

                .error-icon {
                    width: 64px;
                    height: 64px;
                    border-radius: 1.5rem;
                }

                    .error-icon i {
                        font-size: 2rem;
                    }

                .error-title {
                    font-size: 1.25rem;
                }

                .btn-back-home {
                    padding: 0.625rem 1.25rem;
                    font-size: 0.8125rem;
                }
            }
    </style>
</head>
<body>
    <div class="error-container">
        <!-- MAIN ERROR CARD -->
        <div class="error-card">
            <!-- Icon -->
            <div class="error-icon">
                <i class="fas fa-link-slash"></i>
            </div>

            <!-- Title -->
            <h1 class="error-title">Link Unavailable</h1>

            <!-- Message -->
            <p class="error-message">
                @(ViewBag.Error ?? "This share link is not available. It may have expired or been removed.")
            </p>

            <!-- Action Button -->
            <a href="/" class="btn-back-home">
                <i class="fas fa-arrow-left"></i>
                Return to Dashboard
            </a>
        </div>

        <!-- Footer -->
        <div class="error-footer">
            <i class="fas fa-shield-halved"></i>
            <span>Axis IT Operations</span>
            <span class="separator">·</span>
            <span>Secure Portal</span>
        </div>
    </div>
</body>
</html>