@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Link Unavailable — Axis IT Operations</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>body{background:#f1f5f9;font-family:'Segoe UI',Arial,sans-serif;}</style>
</head>
<body>
    <div style="max-width:520px;margin:6rem auto;padding:0 1rem;text-align:center;">
        <div style="background:#fff;border-radius:1rem;box-shadow:0 10px 30px rgba(0,0,0,.08);padding:3rem 2rem;">
            <i class="fas fa-link-slash fa-3x mb-3" style="color:#e53e3e;"></i>
            <h4>Link Unavailable</h4>
            <p class="text-muted">@(ViewBag.Error ?? "This share link is not available.")</p>
        </div>
        <p class="text-muted mt-3" style="font-size:.8rem;"><i class="fas fa-shield-halved"></i> Axis IT Operations</p>
    </div>
</body>
</html>
