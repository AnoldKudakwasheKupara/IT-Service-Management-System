@model List<IT_Service_Management_System.Models.Efm.EmployeeDocument>
@{
    var emp = ViewBag.Employee as IT_Service_Management_System.Models.User;
    ViewData["Title"] = $"{emp?.FullName} — Timeline";
    var byYear = Model.GroupBy(d => (d.IssueDate ?? d.CreatedAt).Year).OrderByDescending(g => g.Key);
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <a asp-action="Files" asp-route-id="@emp?.Id" class="btn-back">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-timeline me-2" style="color: var(--primary);"></i>
                        @emp?.FullName — Timeline
                    </h1>
                    <p class="text-muted mt-2">@Model.Count document(s) in chronological order</p>
                </div>
            </div>
            <a asp-action="Create" asp-route-employeeId="@emp?.Id" class="btn-create-ticket">
                <i class="fas fa-plus-circle me-2"></i>
                Add Document
            </a>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--primary-light), var(--primary));">
                <i class="fas fa-file-alt"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.Count</h3>
                <p>Total Documents</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #2c9e6e, #227a55);">
                <i class="fas fa-folder-open"></i>
            </div>
            <div class="stat-info">
                <h3>@(Model.Select(d => d.Folder?.Name).Distinct().Count())</h3>
                <p>Folders Used</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f5b042, #e6a017);">
                <i class="fas fa-tag"></i>
            </div>
            <div class="stat-info">
                <h3>@(Model.Select(d => d.Category?.Name).Distinct().Count())</h3>
                <p>Categories</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-info">
                <h3>@(byYear.Any() ? byYear.First().Key : 0)</h3>
                <p>Latest Year</p>
            </div>
        </div>
    </div>

    <!-- TIMELINE CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-timeline me-2"></i>
                <span>Document Timeline</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count</span> documents
            </div>
        </div>

        <div class="card-body-custom">
            @if (Model.Any())
            {
                <div class="timeline-container">
                    @foreach (var year in byYear)
                    {
                        <div class="tl-year">
                            <span class="tl-year-badge">@year.Key</span>
                        </div>
                        <div class="tl-group">
                            @foreach (var d in year.OrderByDescending(x => x.IssueDate ?? x.CreatedAt))
                            {
                                <div class="tl-item">
                                    <div class="tl-dot @(d.Folder?.Icon?.Contains("important") == true ? "tl-dot-important" : "")">
                                        <i class="fas @(d.Folder?.Icon ?? "fa-file")"></i>
                                    </div>
                                    <div class="tl-body">
                                        <div class="tl-content">
                                            <a asp-action="Details" asp-route-id="@d.Id" class="tl-title">
                                                @d.Title
                                            </a>
                                            <div class="tl-meta">
                                                <span class="tl-meta-item">
                                                    <i class="fas fa-tag"></i>
                                                    @(d.Category?.Name ?? "Uncategorized")
                                                </span>
                                                <span class="tl-meta-separator">·</span>
                                                <span class="tl-meta-item">
                                                    <i class="fas fa-folder"></i>
                                                    @(d.Folder?.Name ?? "Unfiled")
                                                </span>
                                                <span class="tl-meta-separator">·</span>
                                                <span class="tl-meta-item">
                                                    <i class="fas fa-calendar-alt"></i>
                                                    @((d.IssueDate ?? d.CreatedAt).ToString("MMM dd, yyyy"))
                                                </span>
                                                @if (d.ExpiryDate.HasValue && d.ExpiryDate.Value < DateTime.Now)
                                                {
                                                    <span class="tl-expired-badge">
                                                        <i class="fas fa-exclamation-triangle"></i> Expired
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        <div class="tl-actions">
                                            <a asp-action="Details" asp-route-id="@d.Id" class="action-btn btn-view" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@d.Id" class="action-btn btn-edit" title="Edit Document">
                                                <i class="fas fa-pencil-alt"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@d.Id" class="action-btn btn-delete" title="Delete Document">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-timeline"></i>
                    <h3>No documents found</h3>
                    <p>Nothing has been filed for @(emp?.FullName ?? "this employee") yet.</p>
                    <a asp-action="Create" asp-route-employeeId="@emp?.Id" class="btn-create-ticket-sm">
                        <i class="fas fa-plus-circle"></i> Add Document
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        white-space: nowrap;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-create-ticket-sm {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .btn-create-ticket-sm:hover {
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TIMELINE STYLES ===== */
    .timeline-container {
        padding: 0.5rem 0;
    }

    /* Year Badge */
    .tl-year {
        display: flex;
        align-items: center;
        margin: 1.5rem 0 0.75rem 0;
        position: relative;
    }

        .tl-year:first-child {
            margin-top: 0;
        }

    .tl-year-badge {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.3rem 1rem;
        border-radius: 2rem;
        font-weight: 700;
        font-size: 0.875rem;
        letter-spacing: 0.5px;
        box-shadow: var(--shadow-sm);
    }

    /* Timeline Group */
    .tl-group {
        border-left: 3px solid var(--gray-200);
        margin-left: 0.75rem;
        padding-left: 1.75rem;
        position: relative;
    }

    /* Timeline Item */
    .tl-item {
        position: relative;
        padding: 0.75rem 0;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        transition: all 0.2s;
        border-radius: 0.5rem;
        padding-left: 0.5rem;
    }

        .tl-item:hover {
            background: var(--gray-50);
        }

    /* Timeline Dot */
    .tl-dot {
        position: absolute;
        left: -2.6rem;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 2px solid var(--gray-200);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        transition: all 0.2s;
        flex-shrink: 0;
        top: 0.75rem;
    }

    .tl-item:hover .tl-dot {
        background: var(--primary);
        border-color: var(--primary);
        color: white;
        transform: scale(1.1);
    }

    .tl-dot-important {
        background: #fee;
        border-color: var(--danger);
        color: var(--danger);
    }

    .tl-item:hover .tl-dot-important {
        background: var(--danger);
        border-color: var(--danger);
        color: white;
    }

    /* Timeline Body */
    .tl-body {
        flex: 1;
        padding-left: 0.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .tl-content {
        flex: 1;
        min-width: 200px;
    }

    .tl-title {
        font-weight: 600;
        color: var(--gray-800);
        text-decoration: none;
        font-size: 0.95rem;
        display: inline-block;
        transition: color 0.2s;
    }

        .tl-title:hover {
            color: var(--primary);
            text-decoration: none;
        }

    .tl-meta {
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        font-size: 0.78rem;
        color: var(--gray-500);
    }

    .tl-meta-item {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .tl-meta-item i {
            font-size: 0.65rem;
            color: var(--gray-400);
        }

    .tl-meta-separator {
        color: var(--gray-300);
    }

    /* Expired Badge */
    .tl-expired-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--danger);
        background: #fee;
        padding: 0.1rem 0.5rem;
        border-radius: 1rem;
        border: 1px solid #fed7d7;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

        .tl-expired-badge i {
            font-size: 0.6rem;
        }

    /* Timeline Actions */
    .tl-actions {
        display: flex;
        gap: 0.25rem;
        flex-shrink: 0;
    }

    /* ===== ACTION BUTTONS ===== */
    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
    }

    .btn-view {
        background: var(--gray-100);
        color: var(--info);
    }

        .btn-view:hover {
            background: var(--info);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-edit {
        background: var(--gray-100);
        color: var(--warning);
    }

        .btn-edit:hover {
            background: var(--warning);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-delete {
        background: var(--gray-100);
        color: var(--danger);
    }

        .btn-delete:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--gray-500);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--gray-300);
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--gray-600);
        }

        .empty-state p {
            margin-bottom: 1.5rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .stats-cards {
            grid-template-columns: 1fr 1fr;
        }

        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .tl-body {
            flex-direction: column;
            align-items: flex-start;
        }

        .tl-actions {
            align-self: flex-start;
            margin-top: 0.25rem;
        }

        .tl-group {
            margin-left: 0.5rem;
            padding-left: 1.5rem;
        }

        .tl-dot {
            left: -2.3rem;
            width: 28px;
            height: 28px;
            font-size: 0.65rem;
        }
    }

    @@media (max-width: 576px) {
        .stats-cards {
            grid-template-columns: 1fr;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .tl-item {
            padding-left: 0.25rem;
        }

        .tl-meta {
            font-size: 0.7rem;
            gap: 0.25rem;
        }

        .tl-meta-separator {
            display: none;
        }

        .tl-meta-item {
            display: inline-block;
        }

            .tl-meta-item:not(:last-child)::after {
                content: "·";
                margin: 0 0.25rem;
                color: var(--gray-300);
            }
    }
</style>