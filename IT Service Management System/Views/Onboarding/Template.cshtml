@using IT_Service_Management_System.Models.Hr
@{
    var t = ViewBag.Template as OnboardingTemplate;
    ViewData["Title"] = t?.Name ?? "Template";
    var tasks = (t?.Tasks ?? new List<OnboardingTaskTemplate>()).OrderBy(x => x.DisplayOrder).ToList();

    string Spaced(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(?<=[a-z])(?=[A-Z])", " ");
    string Offset(int d) => d == 0 ? "Day one" : d < 0 ? $"{-d} day(s) before" : $"Day {d}";
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-list-check"></i> @t!.Name</h1>
                    <p class="page-sub">
                        @(t.AppliesTo.HasValue ? Spaced(t.AppliesTo.Value.ToString()) : "Everyone")
                        · @tasks.Count step(s), @tasks.Count(x => x.IsStatutory) required by law
                    </p>
                </div>
                <div class="head-actions">
                    <a asp-action="Templates" class="btn-back"><i class="fas fa-arrow-left"></i> Templates</a>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        <div class="notice">
            <i class="fas fa-circle-info"></i>
            <div>
                Changes here affect future programmes only. Somebody halfway through their onboarding
                keeps the steps they were given — what a joiner was actually asked to do is the record.
            </div>
        </div>

        <div class="card flush">
            <table class="tbl">
                <thead>
                    <tr><th>#</th><th>Step</th><th>Category</th><th>Owner</th><th>Due</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td class="num sm">@task.DisplayOrder</td>
                            <td>
                                <div class="strong-link">@task.Title</div>
                                @if (task.Detail != null) { <div class="sub">@task.Detail</div> }
                                @if (task.IsStatutory)
                                {
                                    <div class="sub red">
                                        <i class="fas fa-scale-balanced"></i> @(task.Authority ?? "Required by law")
                                    </div>
                                }
                            </td>
                            <td class="sub">@Spaced(task.Category.ToString())</td>
                            <td class="sub">@Spaced(task.Owner.ToString())</td>
                            <td class="sub">@Offset(task.DueDayOffset)</td>
                            <td class="act">
                                @if (!task.IsStatutory)
                                {
                                    <form asp-action="DeleteTemplateTask" method="post"
                                          onsubmit="return confirm('Remove this step from the template?');">
                                        <input type="hidden" name="id" value="@task.Id" />
                                        <button type="submit" class="del"><i class="fas fa-trash"></i></button>
                                    </form>
                                }
                                else
                                {
                                    <i class="fas fa-lock muted" title="Required by law — cannot be removed"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card">
            <div class="card-head"><h2 class="section-title">Add a step</h2></div>
            <div class="card-body">
                <form asp-action="AddTemplateTask" method="post">
                    <input type="hidden" name="templateId" value="@t.Id" />
                    <div class="form-grid">
                        <div class="fg">
                            <label class="req">Step</label>
                            <input name="title" class="inp" required />
                        </div>
                        <div class="fg">
                            <label>Due (days from start)</label>
                            <input type="number" name="dueDayOffset" class="inp" value="0" />
                            <span class="hint">
                                Negative for anything that must happen before day one — a contract signed
                                on the first morning is a contract signed late.
                            </span>
                        </div>
                        <div class="fg">
                            <label>Category</label>
                            <select name="category" class="inp">
                                @foreach (OnboardingCategory c in Enum.GetValues<OnboardingCategory>())
                                {
                                    <option value="@c">@Spaced(c.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label>Owner</label>
                            <select name="owner" class="inp">
                                @foreach (OnboardingOwner o in Enum.GetValues<OnboardingOwner>())
                                {
                                    <option value="@o">@Spaced(o.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="fg full">
                            <label>Detail</label>
                            <input name="detail" class="inp" />
                        </div>
                        <div class="fg">
                            <label class="check">
                                <input type="checkbox" name="isStatutory" value="true" /> Required by law
                            </label>
                        </div>
                        <div class="fg">
                            <label>Provision</label>
                            <input name="authority" class="inp"
                                   placeholder="e.g. NSSA Act [Chapter 17:04]" />
                            <span class="hint">
                                Required for a statutory step, so the requirement can be checked rather
                                than taken on trust.
                            </span>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn-hr"><i class="fas fa-plus"></i> Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
