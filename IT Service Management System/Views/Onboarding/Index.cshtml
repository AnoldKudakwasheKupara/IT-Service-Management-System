@using IT_Service_Management_System.Models.Hr
@using IT_Service_Management_System.Services.Hr
@{
    ViewData["Title"] = "Onboarding";
    var programmes = ViewBag.Programmes as List<OnboardingProgramme> ?? new List<OnboardingProgramme>();
    var overview = ViewBag.Overview as OnboardingService.OnboardingOverview;
    var unstarted = ViewBag.Unstarted as List<Employee> ?? new List<Employee>();
    var includeComplete = ViewBag.IncludeComplete as bool? ?? false;

    string Spaced(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(?<=[a-z])(?=[A-Z])", " ");
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-door-open"></i> Onboarding</h1>
                    <p class="page-sub">
                        Some of this is policy and some of it is law. NSSA registration, written
                        particulars, the code of conduct and a safety induction are not optional, so
                        those steps carry the provision they come from and cannot be closed without evidence.
                    </p>
                </div>
                <div class="head-actions">
                    <a asp-action="Templates" class="btn-ghost-hr"><i class="fas fa-list-check"></i> Templates</a>
                    <a asp-action="Start" class="btn-hr"><i class="fas fa-plus"></i> Start a programme</a>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        @if (overview != null)
        {
            <div class="stats">
                <div class="stat"><div class="num">@overview.InProgress</div><div class="lbl">In progress</div></div>
                <div class="stat"><div class="num blue">@overview.StartingSoon</div><div class="lbl">Starting within 14 days</div></div>
                <div class="stat"><div class="num red">@overview.OverdueStatutory</div><div class="lbl">Overdue — required by law</div></div>
                <div class="stat"><div class="num amber">@overview.OverdueOther</div><div class="lbl">Overdue — other</div></div>
            </div>

            @if (overview.OverdueStatutory > 0)
            {
                <div class="notice warn">
                    <i class="fas fa-triangle-exclamation"></i>
                    <div>
                        <strong>@overview.OverdueStatutory statutory step(s) are past their due date.</strong>
                        An unregistered employee or a missed safety induction is a different kind of
                        problem from an unissued laptop. These are the ones to clear first.
                    </div>
                </div>
            }
        }

        @if (unstarted.Count > 0)
        {
            <div class="card flush">
                <div class="card-head">
                    <h2 class="section-title">Hired recently with no programme</h2>
                </div>
                <table class="tbl">
                    <thead><tr><th>Employee</th><th>Post</th><th>Started</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var e in unstarted)
                        {
                            <tr>
                                <td>
                                    <div class="strong-link">@e.DisplayName</div>
                                    <div class="sub">@e.EmployeeNumber</div>
                                </td>
                                <td>@e.JobTitle</td>
                                <td class="@(e.HireDate < DateTime.Today.AddDays(-7) ? "overdue" : "")">
                                    @e.HireDate?.ToString("d MMM yyyy")
                                </td>
                                <td class="act">
                                    <a asp-action="Start" asp-route-employeeId="@e.Id" class="btn-outline-hr btn-sm">
                                        <i class="fas fa-play"></i> Start
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <form method="get" class="toolbar">
            <label class="check">
                <input type="checkbox" name="includeComplete" value="true" checked="@includeComplete" />
                Include completed
            </label>
            <button type="submit" class="btn-outline-hr"><i class="fas fa-filter"></i> Apply</button>
        </form>

        <div class="card flush">
            <div class="card-head"><h2 class="section-title">Programmes</h2></div>
            @if (programmes.Count == 0)
            {
                <div class="empty"><i class="fas fa-door-open"></i><p>Nothing running.</p></div>
            }
            else
            {
                <table class="tbl">
                    <thead>
                        <tr><th>Employee</th><th>Started</th><th>Progress</th><th>Outstanding</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in programmes)
                        {
                            <tr>
                                <td>
                                    <div class="strong-link">@p.Employee?.DisplayName</div>
                                    <div class="sub">@p.Reference · @p.Employee?.JobTitle</div>
                                </td>
                                <td>@p.StartDate.ToString("d MMM yyyy")</td>
                                <td>
                                    <span class="num sm @(p.PercentComplete == 100 ? "green" : p.PercentComplete >= 50 ? "amber" : "red")">
                                        @p.PercentComplete%
                                    </span>
                                    <div class="sub">@p.Done of @p.Total</div>
                                </td>
                                <td>
                                    @if (p.OutstandingStatutory.Count > 0)
                                    {
                                        <div class="sub red">@p.OutstandingStatutory.Count required by law</div>
                                    }
                                    @if (p.Overdue.Count > 0)
                                    {
                                        <div class="sub">@p.Overdue.Count overdue</div>
                                    }
                                    @if (p.OutstandingStatutory.Count == 0 && p.Overdue.Count == 0)
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge-hr @(p.Status == OnboardingStatus.Complete ? "b-active"
                                                            : p.Status == OnboardingStatus.InProgress ? "b-probation" : "b-neutral")">
                                        @Spaced(p.Status.ToString())
                                    </span>
                                </td>
                                <td class="act">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="view"><i class="fas fa-folder-open"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
