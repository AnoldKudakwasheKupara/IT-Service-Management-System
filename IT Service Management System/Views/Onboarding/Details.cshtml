@using IT_Service_Management_System.Models.Hr
@{
    var p = ViewBag.Programme as OnboardingProgramme;
    ViewData["Title"] = $"Onboarding — {p?.Employee?.DisplayName}";
    var isHr = ViewBag.IsHr as bool? ?? false;
    var tasks = (p?.Tasks ?? new List<OnboardingTask>()).OrderBy(t => t.DisplayOrder).ToList();

    string Spaced(string s) => System.Text.RegularExpressions.Regex.Replace(s, "(?<=[a-z])(?=[A-Z])", " ");

    string CategoryIcon(OnboardingCategory c) => c switch
    {
        OnboardingCategory.Contract => "fa-file-signature",
        OnboardingCategory.StatutoryRegistration => "fa-landmark",
        OnboardingCategory.Payroll => "fa-money-check-dollar",
        OnboardingCategory.Induction => "fa-handshake",
        OnboardingCategory.Safety => "fa-helmet-safety",
        OnboardingCategory.Equipment => "fa-laptop",
        OnboardingCategory.SystemAccess => "fa-key",
        OnboardingCategory.Training => "fa-graduation-cap",
        _ => "fa-clipboard"
    };
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-door-open"></i> @p!.Employee?.DisplayName</h1>
                    <p class="page-sub">
                        @p.Reference · @p.Employee?.JobTitle
                        · started @p.StartDate.ToString("d MMM yyyy")
                        @if (p.Buddy != null) { <text> · buddy: @p.Buddy.DisplayName</text> }
                        @if (p.Template != null) { <text> · @p.Template.Name</text> }
                    </p>
                </div>
                <div class="head-actions">
                    <span class="num sm @(p.PercentComplete == 100 ? "green" : p.PercentComplete >= 50 ? "amber" : "red")">
                        @p.PercentComplete%
                    </span>
                    <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left"></i> Onboarding</a>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        @if (p.OutstandingStatutory.Count > 0)
        {
            <div class="notice warn">
                <i class="fas fa-scale-balanced"></i>
                <div>
                    <strong>@p.OutstandingStatutory.Count step(s) required by law are outstanding:</strong>
                    @string.Join("; ", p.OutstandingStatutory.Select(t => t.Title)).
                </div>
            </div>
        }

        <div class="card flush">
            <div class="card-head"><h2 class="section-title">Steps</h2></div>
            <table class="tbl">
                <thead>
                    <tr><th></th><th>Step</th><th>Owner</th><th>Due</th><th>Evidence</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in tasks)
                    {
                        <tr class="@(t.IsComplete ? "muted" : "")">
                            <td>
                                <i class="fas @CategoryIcon(t.Category)" title="@Spaced(t.Category.ToString())"></i>
                            </td>
                            <td>
                                <div class="strong-link">
                                    @if (t.IsComplete) { <i class="fas fa-circle-check green"></i> }
                                    @t.Title
                                </div>
                                @if (t.Detail != null) { <div class="sub">@t.Detail</div> }
                                @if (t.IsStatutory)
                                {
                                    <div class="sub red">
                                        <i class="fas fa-scale-balanced"></i>
                                        Required by @(t.Authority ?? "law")
                                    </div>
                                }
                            </td>
                            <td class="sub">@Spaced(t.Owner.ToString())</td>
                            <td class="@(t.IsOverdue ? "overdue" : "")">
                                @t.DueDate.ToString("d MMM yyyy")
                                @if (t.IsOverdue) { <div class="sub">overdue</div> }
                            </td>
                            <td class="sub">
                                @if (t.IsComplete)
                                {
                                    <div>@t.Evidence</div>
                                    <div class="muted">
                                        @t.CompletedBy?.FullName · @t.CompletedAt?.ToString("d MMM yyyy")
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                @if (!t.IsComplete)
                                {
                                    <form asp-action="Complete" method="post" class="inline-form">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input name="evidence" class="inp"
                                               placeholder="@(t.IsStatutory ? "Required — what was done or issued" : "Note (optional)")"
                                               required="@t.IsStatutory" />
                                        <button type="submit" class="btn-success-hr btn-sm">
                                            <i class="fas fa-check"></i> Done
                                        </button>
                                    </form>
                                }
                                else if (isHr)
                                {
                                    <form asp-action="Reopen" method="post" class="inline-form">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input name="reason" class="inp" placeholder="Why reopen" required />
                                        <button type="submit" class="btn-ghost-hr btn-sm">
                                            <i class="fas fa-rotate-left"></i> Reopen
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (isHr)
        {
            <div class="card">
                <div class="card-head"><h2 class="section-title">Add a step to this programme</h2></div>
                <div class="card-body">
                    <p class="hint" style="margin-top:0;">
                        Added here, this affects only @p.Employee?.DisplayName. To change what every
                        future joiner gets, edit the template instead.
                    </p>
                    <form asp-action="AddTask" method="post">
                        <input type="hidden" name="programmeId" value="@p.Id" />
                        <div class="form-grid">
                            <div class="fg">
                                <label class="req">Step</label>
                                <input name="title" class="inp" required />
                            </div>
                            <div class="fg">
                                <label>Due</label>
                                <input type="date" name="dueDate" class="inp"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="fg">
                                <label>Category</label>
                                <select name="category" class="inp">
                                    @foreach (OnboardingCategory c in Enum.GetValues<OnboardingCategory>())
                                    {
                                        <option value="@c">@Spaced(c.ToString())</option>
                                    }
                                </select>
                            </div>
                            <div class="fg">
                                <label>Owner</label>
                                <select name="owner" class="inp">
                                    @foreach (OnboardingOwner o in Enum.GetValues<OnboardingOwner>())
                                    {
                                        <option value="@o">@Spaced(o.ToString())</option>
                                    }
                                </select>
                            </div>
                            <div class="fg full">
                                <label>Detail</label>
                                <input name="detail" class="inp" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn-outline-hr"><i class="fas fa-plus"></i> Add</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
