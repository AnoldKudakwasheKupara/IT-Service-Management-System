@model IT_Service_Management_System.ViewModels.Security.SecurityDashboardVM
@{
    ViewData["Title"] = "Security Dashboard - Axis IT Operations";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-shield-halved me-2" style="color: var(--primary);"></i>
                    Security Dashboard
                </h1>
                <p class="text-muted mt-2">
                    Account protection, sessions &amp; security events &middot;
                    @Model.GeneratedAt.ToString("dddd, MMM dd yyyy 'at' h:mm tt")
                </p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn-create-ticket" asp-controller="Configuration" asp-action="Index" style="background: var(--gray-100); color: var(--gray-700);">
                    <i class="fas fa-sliders"></i>
                    Configuration
                </a>
                <a class="btn-create-ticket" asp-controller="AuditLogs" asp-action="Index" style="background: var(--gray-100); color: var(--gray-700);">
                    <i class="fas fa-clipboard-list"></i>
                    Audit Logs
                </a>
            </div>
        </div>
    </div>

    <!-- FLASH MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon danger">
                <i class="fas fa-user-xmark"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.FailedLogins24h</div>
                <div class="kpi-label">Failed Logins (24h)</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-clock-rotate-left"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.FailedLogins7d</div>
                <div class="kpi-label">Failed Logins (7d)</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon danger">
                <i class="fas fa-lock"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.LockedUsersCount</div>
                <div class="kpi-label">Locked Accounts</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-desktop"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.ActiveSessionsCount</div>
                <div class="kpi-label">Active Sessions</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-key"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.ExpiredPasswordsCount</div>
                <div class="kpi-label">Expired Passwords</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-user-slash"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.DisabledAccountsCount</div>
                <div class="kpi-label">Disabled Accounts</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-mobile-screen-button"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.MfaEnabledCount</div>
                <div class="kpi-label">MFA Enabled</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon violet">
                <i class="fas fa-users"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalUsers</div>
                <div class="kpi-label">Total Users</div>
            </div>
        </div>
    </div>

    <!-- LOCKED ACCOUNTS -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-lock me-2"></i>
                <span>Locked Accounts</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.LockedUsers.Count</span> locked
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.LockedUsers.Any())
            {
                <div class="table-responsive">
                    <table class="data-table tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-user me-1"></i> User</th>
                                <th><i class="fas fa-envelope me-1"></i> Email</th>
                                <th><i class="fas fa-user-tag me-1"></i> Role</th>
                                <th><i class="fas fa-clock me-1"></i> Locked Until</th>
                                <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.LockedUsers)
                            {
                                <tr>
                                    <td><span class="user-name">@u.FullName</span></td>
                                    <td class="user-email">@u.Email</td>
                                    <td><span class="role-badge role-@u.Role.ToString().ToLower()">@u.Role</span></td>
                                    <td><span class="status-badge status-danger">@u.LockoutEnd?.ToString("MMM dd, h:mm tt")</span></td>
                                    <td style="text-align:right;">
                                        <form asp-action="UnlockUser" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="action-btn btn-unlock" title="Unlock Account">
                                                <i class="fas fa-unlock"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-check-circle" style="color:var(--success);"></i>
                    <span>No locked accounts — all clear!</span>
                </div>
            }
        </div>
    </div>

    <!-- ACTIVE SESSIONS -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-desktop me-2"></i>
                <span>Active Sessions</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.ActiveSessions.Count</span> active
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.ActiveSessions.Any())
            {
                <div class="table-responsive">
                    <table class="data-table tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-user me-1"></i> User</th>
                                <th><i class="fas fa-laptop me-1"></i> Device</th>
                                <th><i class="fas fa-globe me-1"></i> IP</th>
                                <th><i class="fas fa-sign-in-alt me-1"></i> Signed In</th>
                                <th><i class="fas fa-clock me-1"></i> Last Active</th>
                                <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.ActiveSessions)
                            {
                                <tr>
                                    <td><span class="user-name">@(s.User != null ? s.User.FullName : $"User #{s.UserId}")</span></td>
                                    <td class="session-device">@(string.IsNullOrEmpty(s.Device) ? "—" : s.Device)</td>
                                    <td class="session-ip">@s.IpAddress</td>
                                    <td class="session-date">@s.CreatedAt.ToString("MMM dd, h:mm tt")</td>
                                    <td class="session-date">@s.LastSeenAt.ToString("MMM dd, h:mm tt")</td>
                                    <td style="text-align:right;">
                                        <form asp-action="RevokeSession" method="post" style="display:inline;"
                                              onsubmit="return confirm('Revoke this session?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="action-btn btn-revoke" title="Revoke Session">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No active sessions</span>
                </div>
            }
        </div>
    </div>

    <!-- TWO COLUMN GRID -->
    <div class="two-col-grid mt-4">
        <!-- Most-Targeted Accounts -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-crosshairs me-2"></i>
                <span>Most-Targeted Accounts (7d failed logins)</span>
            </div>
            <div class="card-body-custom">
                @if (Model.TopFailedLoginTargets.Any())
                {
                    var m1 = Max(Model.TopFailedLoginTargets);
                    <div class="bars">
                        @foreach (var t in Model.TopFailedLoginTargets)
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@t.Name">@t.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill danger" style="width:@(t.Count * 100 / m1)%"></div>
                                </div>
                                <div class="bar-value">@t.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-check-circle" style="color:var(--success);"></i>
                        <span>No failed logins in the last 7 days</span>
                    </div>
                }
            </div>
        </div>

        <!-- Disabled Accounts -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-user-slash me-2"></i>
                <span>Disabled / Inactive Accounts</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.DisabledAccounts.Any())
                {
                    <div class="table-responsive">
                        <table class="data-table tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-1"></i> User</th>
                                    <th><i class="fas fa-envelope me-1"></i> Email</th>
                                    <th><i class="fas fa-user-tag me-1"></i> Role</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.DisabledAccounts)
                                {
                                    <tr>
                                        <td><span class="user-name">@u.FullName</span></td>
                                        <td class="user-email">@u.Email</td>
                                        <td><span class="role-badge role-@u.Role.ToString().ToLower()">@u.Role</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-check-circle" style="color:var(--success);"></i>
                        <span>All accounts are active</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- EXPIRED PASSWORDS -->
    @if (Model.PasswordExpiryDays > 0)
    {
        <div class="data-card mt-4">
            <div class="card-header-custom">
                <div>
                    <i class="fas fa-key me-2"></i>
                    <span>Expired Passwords</span>
                </div>
                <div class="ticket-count">
                    <i class="fas fa-chart-simple"></i>
                    <span>@Model.ExpiredPasswordUsers.Count</span> expired (policy: @Model.PasswordExpiryDays days)
                </div>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.ExpiredPasswordUsers.Any())
                {
                    <div class="table-responsive">
                        <table class="data-table tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-1"></i> User</th>
                                    <th><i class="fas fa-envelope me-1"></i> Email</th>
                                    <th><i class="fas fa-calendar me-1"></i> Last Changed</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.ExpiredPasswordUsers)
                                {
                                    <tr>
                                        <td><span class="user-name">@u.FullName</span></td>
                                        <td class="user-email">@u.Email</td>
                                        <td class="session-date">@((u.PasswordChangedAt ?? u.CreatedAt).ToString("MMM dd, yyyy"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-check-circle" style="color:var(--success);"></i>
                        <span>No expired passwords</span>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="data-card mt-4">
            <div class="card-body-custom" style="font-size:0.85rem;color:var(--gray-500);">
                <i class="fas fa-info-circle" style="color:var(--info);"></i>
                Password expiry is currently disabled.
                Set an expiry window in <a asp-controller="Configuration" asp-action="Index" class="cfg-link">Configuration</a> to track expired passwords.
            </div>
        </div>
    }

    <!-- RECENT SECURITY EVENTS -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-clock-rotate-left me-2"></i>
                <span>Recent Security Events</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.RecentSecurityEvents.Count</span> events
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.RecentSecurityEvents.Any())
            {
                <div class="table-responsive">
                    <table class="data-table tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-clock me-1"></i> When</th>
                                <th><i class="fas fa-code me-1"></i> Action</th>
                                <th><i class="fas fa-user me-1"></i> By</th>
                                <th><i class="fas fa-info-circle me-1"></i> Details</th>
                                <th><i class="fas fa-globe me-1"></i> IP / Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.RecentSecurityEvents)
                            {
                                var cls = e.Action.Contains("Failed") || e.Action.Contains("Locked") || e.Action.Contains("Blocked") ? "danger"
                                    : e.Action.Contains("Login") || e.Action.Contains("Set Password") || e.Action.Contains("Verified") ? "success"
                                    : e.Action.Contains("Changed") || e.Action.Contains("Updated") ? "warning" : "default";
                                <tr>
                                    <td class="audit-date">@e.Timestamp.ToString("MMM dd, h:mm tt")</td>
                                    <td><span class="audit-pill @cls">@e.Action</span></td>
                                    <td class="audit-user">@e.UserName</td>
                                    <td class="audit-details" title="@e.Details">@e.Details</td>
                                    <td class="audit-location">
                                        @e.IpAddress
                                        @if (!string.IsNullOrEmpty(e.Location))
                                        {
                                            <span class="location-badge">
                                                <i class="fas fa-map-pin"></i> @e.Location
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No security events recorded yet</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== FLASH MESSAGES ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

        .alert-flash.success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .alert-flash i {
            font-size: 1.1rem;
        }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== KPI CARDS ===== */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .kpi-card {
        background: white;
        border-radius: 1rem;
        padding: 1.1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: all 0.3s ease;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

        .kpi-icon.primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
        }

        .kpi-icon.success {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

        .kpi-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .kpi-icon.warning {
            background: linear-gradient(135deg, #f5b042, #e6a017);
        }

        .kpi-icon.violet {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

        .kpi-icon.slate {
            background: linear-gradient(135deg, var(--gray-500), var(--gray-600));
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--gray-800);
        line-height: 1.2;
    }

    .kpi-label {
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-top: 0.05rem;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

        .data-card.mt-4 {
            margin-top: 1.5rem;
        }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .ticket-count {
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 0.75rem 1.2rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.65rem 1.2rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== USER STYLES ===== */
    .user-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    .user-email {
        color: var(--gray-500);
        font-size: 0.8rem;
    }

    /* ===== ROLE BADGES ===== */
    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .role-admin {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .role-manager {
        background: #fff5e6;
        color: var(--warning);
        border: 1px solid #ffe0b3;
    }

    .role-staff {
        background: #fceaeb;
        color: var(--info);
