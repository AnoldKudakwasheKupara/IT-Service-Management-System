@model IT_Service_Management_System.Models.User
@using IT_Service_Management_System.Models
@{
    ViewData["Title"] = "Two-Factor Authentication - Axis IT Operations";
    var remaining = ViewBag.RecoveryRemaining as int? ?? 0;
    var isAuth = Model.MfaMethod == MfaMethod.Authenticator;
    var isEmail = Model.MfaMethod == MfaMethod.Email;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-shield-halved me-2" style="color: var(--primary);"></i>
                    Two-Factor Authentication
                </h1>
                <p class="text-muted mt-2">Add a second step at sign-in. Choose the method you prefer.</p>
            </div>
            @if (Model.MfaEnabled)
            {
                <span class="status-badge badge-success">
                    <i class="fas fa-circle-check"></i> Enabled · @Model.MfaMethod
                </span>
            }
            else
            {
                <span class="status-badge badge-gray">
                    <i class="fas fa-circle-xmark"></i> Not enabled
                </span>
            }
        </div>
    </div>

    <!-- TWO COLUMN GRID: Methods -->
    <div class="two-col-grid">
        <!-- Authenticator App -->
        <div class="data-card">
            <div class="card-header-custom">
                <div>
                    <i class="fas fa-mobile-screen-button me-2" style="color: var(--primary);"></i>
                    <span>Authenticator app</span>
                </div>
                @if (isAuth)
                {
                    <span class="status-badge badge-success">Active</span>
                }
            </div>
            <div class="card-body-custom">
                <p class="method-description">
                    Use Google Authenticator, Microsoft Authenticator, Authy or any TOTP app to generate a
                    6-digit code — no email needed. Recommended.
                </p>
                <a asp-action="SetupAuthenticator" class="btn-method-setup">
                    <i class="fas fa-qrcode"></i> @(isAuth ? "Reconfigure" : "Set up authenticator")
                </a>
            </div>
        </div>

        <!-- Email Verification -->
        <div class="data-card">
            <div class="card-header-custom">
                <div>
                    <i class="fas fa-envelope me-2" style="color: var(--primary);"></i>
                    <span>Email verification</span>
                </div>
                @if (isEmail)
                {
                    <span class="status-badge badge-success">Active</span>
                }
            </div>
            <div class="card-body-custom">
                <p class="method-description">
                    Receive a one-time code by email (<span class="email-highlight">@Model.Email</span>) each time you sign in.
                </p>
                <form asp-action="EnableEmail" method="post">
                    @Html.AntiForgeryToken()
                    <button class="btn-method-setup" @(isEmail ? "disabled" : "")>
                        <i class="fas fa-envelope-circle-check"></i> @(isEmail ? "Currently active" : "Use email codes")
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- RECOVERY & OPTIONS -->
    @if (Model.MfaEnabled)
    {
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-key me-2" style="color: var(--primary);"></i>
                <span>Recovery &amp; options</span>
            </div>
            <div class="card-body-custom">
                <div class="recovery-options">
                    <span class="status-badge @(remaining > 2 ? "badge-primary" : "badge-warning")">
                        <i class="fas fa-life-ring"></i> @remaining recovery code(s) left
                    </span>
                    <form asp-action="RegenerateRecoveryCodes" method="post" class="inline-form" onsubmit="return confirm('Generate new recovery codes? Your existing codes will stop working.');">
                        @Html.AntiForgeryToken()
                        <button class="btn-recovery" type="submit">
                            <i class="fas fa-rotate"></i> Regenerate recovery codes
                        </button>
                    </form>
                    <form asp-action="Disable" method="post" class="inline-form" onsubmit="return confirm('Turn off two-factor authentication for your account?');">
                        @Html.AntiForgeryToken()
                        <button class="btn-disable" type="submit">
                            <i class="fas fa-shield-slash"></i> Turn off 2FA
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        height: 100%;
        transition: all 0.3s ease;
    }

        .data-card:hover {
            box-shadow: var(--shadow-md);
        }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    .badge-primary {
        background: #fceaeb;
        color: var(--info);
        border: 1px solid #f4ced0;
    }

    /* ===== METHOD DESCRIPTION ===== */
    .method-description {
        font-size: 0.88rem;
        color: var(--gray-500);
        line-height: 1.6;
        margin: 0 0 1.25rem 0;
    }

    .email-highlight {
        font-weight: 600;
        color: var(--gray-700);
    }

    /* ===== METHOD SETUP BUTTON ===== */
    .btn-method-setup {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        border: none;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        font-family: inherit;
    }

        .btn-method-setup:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

        .btn-method-setup:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
            box-shadow: var(--shadow-sm) !important;
        }

    /* ===== RECOVERY OPTIONS ===== */
    .recovery-options {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1rem;
    }

    .inline-form {
        display: inline;
        margin: 0;
    }

    .btn-recovery {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 1rem;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
    }

        .btn-recovery:hover {
            background: var(--gray-200);
            border-color: var(--gray-300);
            transform: translateY(-1px);
        }

    .btn-disable {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 1rem;
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
    }

        .btn-disable:hover {
            background: var(--danger);
            color: white;
            border-color: var(--danger);
            transform: translateY(-1px);
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .two-col-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        .page-header .d-flex.align-items-center {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .recovery-options {
            flex-direction: column;
            align-items: stretch;
        }

            .recovery-options .status-badge {
                align-self: flex-start;
            }

        .btn-recovery,
        .btn-disable {
            width: 100%;
            justify-content: center;
        }

        .btn-method-setup {
            width: 100%;
            justify-content: center;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.25rem;
        }

        .status-badge {
            font-size: 0.6rem;
            padding: 0.15rem 0.5rem;
        }

        .method-description {
            font-size: 0.8rem;
        }

        .btn-method-setup {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
        }

        .btn-recovery,
        .btn-disable {
            font-size: 0.7rem;
            padding: 0.3rem 0.8rem;
        }
    }
</style>
