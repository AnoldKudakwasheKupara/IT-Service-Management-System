@model List<string>
@{
    ViewData["Title"] = "Recovery Codes - Axis IT Operations";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-life-ring me-2" style="color: var(--primary);"></i>
                    Your recovery codes
                </h1>
                <p class="text-muted mt-2">
                    Save these now — each code works once if you lose access to your second factor.
                    This is the only time they're shown.
                </p>
            </div>
        </div>
    </div>

    <!-- WARNING ALERT -->
    <div class="alert-flash warning">
        <i class="fas fa-triangle-exclamation"></i>
        <span>Store them in a password manager or print them. Anyone with a code can sign in as you.</span>
    </div>

    <!-- CODES CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-key me-2" style="color: var(--primary);"></i>
                <span>Recovery codes</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count</span> codes
            </div>
        </div>
        <div class="card-body-custom">
            <div class="codes-grid" id="codes">
                @foreach (var c in Model)
                {
                    <code class="code-item">@c</code>
                }
            </div>
            <div class="codes-actions">
                <button class="btn-codes-action" onclick="copyCodes()">
                    <i class="fas fa-copy"></i> Copy all
                </button>
                <button class="btn-codes-action" onclick="window.print()">
                    <i class="fas fa-print"></i> Print
                </button>
                <a asp-action="Index" class="btn-saved">
                    <i class="fas fa-check"></i> I've saved them
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function copyCodes() {
        var text = Array.from(document.querySelectorAll('#codes .code-item')).map(function (c) {
            return c.textContent.trim();
        }).join('\n');
        navigator.clipboard.writeText(text).then(function () {
            if (window.toastr) {
                toastr.success('Recovery codes copied.');
            } else {
                alert('Recovery codes copied to clipboard.');
            }
        }).catch(function () {
            // Fallback for browsers without clipboard API
            var textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            if (window.toastr) {
                toastr.success('Recovery codes copied.');
            } else {
                alert('Recovery codes copied to clipboard.');
            }
        });
    }
</script>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

        .alert-flash.warning {
            background: #fffbeb;
            border-color: #fde68a;
            color: #92400e;
        }

        .alert-flash i {
            font-size: 1.1rem;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== CODES GRID ===== */
    .codes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }

    .code-item {
        background: var(--gray-50);
        padding: 0.5rem 0.75rem;
        border-radius: 0.5rem;
        font-size: 1rem;
        letter-spacing: 1px;
        text-align: center;
        font-family: 'Courier New', monospace;
        font-weight: 700;
        color: var(--gray-800);
        border: 1px solid var(--gray-200);
        transition: all 0.2s ease;
        user-select: all;
    }

        .code-item:hover {
            border-color: var(--primary);
            background: var(--gray-50);
        }

    /* ===== CODES ACTIONS ===== */
    .codes-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        padding-top: 1.25rem;
        border-top: 1px solid var(--gray-200);
    }

    .btn-codes-action {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 1rem;
        background: white;
        color: var(--gray-600);
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
        text-decoration: none;
    }

        .btn-codes-action:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
            color: var(--gray-700);
            text-decoration: none;
            transform: translateY(-1px);
        }

    .btn-saved {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1.5rem;
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        font-family: inherit;
        margin-left: auto;
    }

        .btn-saved:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .btn-codes-action,
        .btn-saved {
            display: none !important;
        }

        .card-header-custom {
            background: white !important;
        }

        .code-item {
            border: 1px solid var(--gray-300) !important;
            background: white !important;
        }

        .data-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
        }

        .alert-flash {
            border: 1px solid var(--gray-300) !important;
            background: white !important;
        }
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .codes-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 0.5rem;
        }

        .code-item {
            font-size: 0.85rem;
            padding: 0.4rem 0.6rem;
        }

        .codes-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-codes-action,
        .btn-saved {
            width: 100%;
            justify-content: center;
        }

        .btn-saved {
            margin-left: 0;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.25rem;
        }

        .codes-grid {
            grid-template-columns: 1fr 1fr;
            gap: 0.4rem;
        }

        .code-item {
            font-size: 0.75rem;
            padding: 0.3rem 0.5rem;
        }

        .btn-codes-action {
            font-size: 0.75rem;
            padding: 0.35rem 0.8rem;
        }

        .btn-saved {
            font-size: 0.8rem;
            padding: 0.4rem 1rem;
        }

        .alert-flash {
            font-size: 0.8rem;
            padding: 0.7rem 1rem;
        }
    }
</style>
