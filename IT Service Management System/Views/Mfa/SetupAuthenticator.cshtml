@{
    ViewData["Title"] = "Set up Authenticator - Axis IT Operations";
    var secret = ViewBag.Secret as string ?? "";
    var uri = ViewBag.OtpAuthUri as string ?? "";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title" style="font-size:1.5rem;">
                    <i class="fas fa-qrcode me-2" style="color: var(--primary);"></i>
                    Set up authenticator app
                </h1>
                <p class="text-muted mt-1" style="font-size:0.85rem;">Scan the code, then confirm to finish enrollment.</p>
            </div>
        </div>
    </div>

    <!-- ERROR ALERT -->
    @if (ViewBag.Error != null)
    {
        <div class="alert-flash danger">
            <i class="fas fa-circle-exclamation"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <!-- TWO COLUMN GRID -->
    <div class="two-col-grid">
        <!-- Step 1 - Scan -->
        <div class="data-card">
            <div class="card-header-custom" style="border-left: 4px solid var(--primary);">
                <div>
                    <span class="step-number-badge">1</span>
                    <span>Scan</span>
                </div>
            </div>
            <div class="card-body-custom" style="text-align:center;">
                <p class="step-description">Open your authenticator app and scan this QR code:</p>
                <div id="qr" class="qr-container"></div>
                <input type="hidden" id="otpUri" value="@uri" />
                <p class="manual-key-label">Can't scan? Enter this key manually:</p>
                <code class="manual-key">@secret</code>
            </div>
        </div>

        <!-- Step 2 - Confirm -->
        <div class="data-card">
            <div class="card-header-custom" style="border-left: 4px solid var(--primary);">
                <div>
                    <span class="step-number-badge">2</span>
                    <span>Confirm</span>
                </div>
            </div>
            <div class="card-body-custom">
                <p class="step-description">Enter the current 6-digit code from your app to activate:</p>
                <form asp-action="EnableAuthenticator" method="post">
                    @Html.AntiForgeryToken()
                    <input type="text" name="code" class="form-control code-input"
                           maxlength="6" inputmode="numeric" pattern="[0-9]*"
                           autocomplete="one-time-code" placeholder="000000" autofocus required />
                    <button type="submit" class="btn-verify" style="width:100%;justify-content:center;margin-top:1rem;">
                        <i class="fas fa-check"></i> Verify &amp; enable
                    </button>
                </form>
                <p class="security-note">
                    <i class="fas fa-circle-info"></i>
                    You'll get one-time recovery codes after this — keep them somewhere safe in case you lose your device.
                </p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    (function () {
    var uri = document.getElementById('otpUri').value;
    var holder = document.getElementById('qr');
    if (window.QRCode && uri) {
    new QRCode(holder, { text: uri, width: 190, height: 190, correctLevel: QRCode.CorrectLevel.M });
    } else {
    holder.innerHTML = '<span class="qr-fallback">QR unavailable — use the manual key below.</span>';
    }
    })();
</script>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
    --primary-dark: #8f171c;
    --primary: #b11d23;
    --primary-light: #d9565d;
    --success: #2c9e6e;
    --warning: #f5b042;
    --danger: #e53e3e;
    --info: #b11d23;
    --violet: #8b5cf6;
    --gray-50: #f8fafc;
    --gray-100: #f1f5f9;
    --gray-200: #e2e8f0;
    --gray-300: #cbd5e1;
    --gray-400: #94a3b8;
    --gray-500: #64748b;
    --gray-600: #475569;
    --gray-700: #334155;
    --gray-800: #1e293b;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
    max-width: 1200px;
    margin: 0 auto;
    }

    .page-header {
    margin-bottom: 2rem;
    }

    .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gray-800);
    margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: white;
    border-radius: 0.75rem;
    color: var(--gray-600);
    text-decoration: none;
    transition: all 0.2s;
    border: 1px solid var(--gray-200);
    flex-shrink: 0;
    }

    .btn-back:hover {
    background: var(--gray-50);
    color: var(--primary);
    transform: translateX(-2px);
    text-decoration: none;
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    }

    /* ===== DATA CARD ===== */
    .data-card {
    background: white;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--gray-200);
    height: 100%;
    transition: all 0.3s ease;
    }

    .data-card:hover {
    box-shadow: var(--shadow-md);
    }

    .card-header-custom {
    background: var(--gray-50);
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--gray-200);
    font-weight: 600;
    color: var(--gray-700);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    }

    .card-body-custom {
    padding: 1.5rem;
    }

    /* ===== STEP NUMBER BADGE ===== */
    .step-number-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-dark));
    color: white;
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-right: 0.25rem;
    }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
    padding: 0.9rem 1.2rem;
    border-radius: 0.75rem;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid transparent;
    }

    .alert-flash.danger {
    background: #fef2f2;
    border-color: #fecaca;
    color: #b91c1c;
    }

    .alert-flash i {
    font-size: 1.1rem;
    }

    /* ===== STEP DESCRIPTION ===== */
    .step-description {
    font-size: 0.85rem;
    color: var(--gray-500);
    margin: 0 0 1rem 0;
    }

    /* ===== QR CODE ===== */
    .qr-container {
    display: inline-block;
    padding: 0.75rem;
    background: white;
    border: 1px solid var(--gray-200);
    border-radius: 0.75rem;
    margin-bottom: 0.5rem;
    }

    .qr-container canvas,
    .qr-container img {
    display: block;
    margin: 0 auto;
    }

    .qr-fallback {
    font-size: 0.8rem;
    color: var(--gray-400);
    }

    /* ===== MANUAL KEY ===== */
    .manual-key-label {
    font-size: 0.8rem;
    color: var(--gray-400);
    margin: 0.5rem 0 0.3rem 0;
    }

    .manual-key {
    display: inline-block;
    background: var(--gray-100);
    padding: 0.4rem 0.7rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    letter-spacing: 1px;
    word-break: break-all;
    font-family: 'Courier New', monospace;
    font-weight: 600;
    color: var(--gray-700);
    border: 1px solid var(--gray-200);
    }

    /* ===== CODE INPUT ===== */
    .code-input {
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--gray-200);
    border-radius: 0.6rem;
    font-size: 1.5rem;
    font-weight: 700;
    font-family: 'Courier New', monospace;
    background: white;
    transition: all 0.2s ease;
    width: 100%;
    text-align: center;
    letter-spacing: 0.5rem;
    color: var(--gray-800);
    }

    .code-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
    }

    .code-input::placeholder {
    color: var(--gray-300);
    letter-spacing: 0.3rem;
    font-weight: 400;
    }

    /* ===== VERIFY BUTTON ===== */
    .btn-verify {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    background: linear-gradient(100deg, var(--primary-dark), var(--primary));
    color: white;
    border: none;
    border-radius: 0.75rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    font-family: inherit;
    }

    .btn-verify:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: white;
    text-decoration: none;
    }

    /* ===== SECURITY NOTE ===== */
    .security-note {
    font-size: 0.78rem;
    color: var(--gray-400);
    margin-top: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    }

    .security-note i {
    margin-top: 0.1rem;
    color: var(--gray-400);
    font-size: 0.75rem;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
    .two-col-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    }
    }

    @@media (max-width: 768px) {
    .page-header .d-flex.align-items-center {
    flex-wrap: wrap;
    }

    .page-title {
    font-size: 1.25rem !important;
    }

    .card-body-custom {
    padding: 1rem;
    }

    .btn-back {
    width: 34px;
    height: 34px;
    font-size: 0.8rem;
    }

    .code-input {
    font-size: 1.25rem;
    padding: 0.6rem 0.8rem;
    letter-spacing: 0.3rem;
    }

    .btn-verify {
    width: 100%;
    justify-content: center;
    }

    .step-number-badge {
    width: 24px;
    height: 24px;
    font-size: 0.75rem;
    }
    }

    @@media (max-width: 576px) {
    .page-title {
    font-size: 1.1rem !important;
    }

    .manual-key {
    font-size: 0.8rem;
    padding: 0.3rem 0.5rem;
    }

    .code-input {
    font-size: 1.1rem;
    padding: 0.5rem 0.6rem;
    letter-spacing: 0.2rem;
    }

    .step-description {
    font-size: 0.8rem;
    }

    .security-note {
    font-size: 0.7rem;
    }

    .btn-verify {
    font-size: 0.8rem;
    padding: 0.6rem 1rem;
    }
    }
</style>
