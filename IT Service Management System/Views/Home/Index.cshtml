@{
    ViewData["Title"] = "Dashboard - Axis IT Helpdesk";

    var totalTickets = ViewBag.TotalTickets ?? 0;
    var openTickets = ViewBag.OpenTickets ?? 0;
    var inProgressTickets = ViewBag.InProgressTickets ?? 0;
    var resolvedTickets = ViewBag.ResolvedTickets ?? 0;
    var closedTickets = ViewBag.ClosedTickets ?? 0;
    var highPriorityTickets = ViewBag.HighPriorityTickets ?? 0;
    var criticalPriorityTickets = ViewBag.CriticalPriorityTickets ?? 0;

    var totalUsers = ViewBag.TotalUsers ?? 0;
    var totalDepartments = ViewBag.TotalDepartments ?? 0;
    var expiringCertificates = ViewBag.ExpiringCertificates ?? 0;
    var totalAssets = ViewBag.TotalAssets ?? 0;

    var completed = resolvedTickets + closedTickets;
    var active = openTickets + inProgressTickets;
    var mediumTickets = totalTickets - criticalPriorityTickets - highPriorityTickets - resolvedTickets - closedTickets;
    if (mediumTickets < 0) { mediumTickets = 0; }

    // Bar widths are percentages of the total, guarded against a zero denominator.
    int Pct(int part) => totalTickets > 0 ? part * 100 / totalTickets : 0;
}

<div class="report-shell">

    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-gauge-high"></i> Dashboard</div>
            <h1>Welcome back, @(Context.Session.GetString("UserName") ?? "there")</h1>
            <p class="report-lede">Here's what's happening across the helpdesk today.</p>
            <div class="report-meta">
                <span><i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                <span class="dot"></span>
                <span>@totalDepartments departments</span>
            </div>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-chart-pie"></i> Reports
            </a>
            <a class="report-btn primary" asp-controller="Tickets" asp-action="Create">
                <i class="fas fa-plus"></i> New ticket
            </a>
        </div>
    </div>

    @* Six figures, three-up so the row does not end ragged. Each opens the
       screen it summarises - the open and in-progress counts deep-link into
       the ticket queue already filtered - and the tones follow meaning, so a
       quiet day reads green and only what needs attention is amber or rose. *@
    <h2 class="sr-only">Key figures</h2>
    <div class="stat-grid is-3col">
        <a class="bento-card is-compact tone-slate" asp-controller="Tickets" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-ticket-alt" aria-hidden="true"></i> Tickets</span>
            <h3 class="bento-title">Total tickets</h3>
            <div class="bento-figure">
                <span class="bento-stat">@totalTickets</span>
                <span class="bento-stat-label">@completed resolved or closed</span>
            </div>
            <span class="bento-cta">Open the queue <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card is-compact @(openTickets > 0 ? "tone-amber" : "tone-green")"
           asp-controller="Tickets" asp-action="Index" asp-route-status="Open">
            <span class="bento-badge"><i class="fas fa-folder-open" aria-hidden="true"></i> Queue</span>
            <h3 class="bento-title">Open tickets</h3>
            <div class="bento-figure">
                <span class="bento-stat">@openTickets</span>
                <span class="bento-stat-label">@(openTickets > 0 ? "action needed" : "all clear")</span>
            </div>
            <span class="bento-cta">See them <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card is-compact tone-violet"
           asp-controller="Tickets" asp-action="Index" asp-route-status="InProgress">
            <span class="bento-badge"><i class="fas fa-spinner" aria-hidden="true"></i> Working</span>
            <h3 class="bento-title">In progress</h3>
            <div class="bento-figure">
                <span class="bento-stat">@inProgressTickets</span>
                <span class="bento-stat-label">@active active in total</span>
            </div>
            <span class="bento-cta">See them <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card is-compact tone-teal" asp-controller="Users" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-users" aria-hidden="true"></i> People</span>
            <h3 class="bento-title">Users</h3>
            <div class="bento-figure">
                <span class="bento-stat">@totalUsers</span>
                <span class="bento-stat-label">across @totalDepartments departments</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card is-compact tone-violet" asp-controller="Assets" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-laptop-code" aria-hidden="true"></i> Estate</span>
            <h3 class="bento-title">Assets tracked</h3>
            <div class="bento-figure">
                <span class="bento-stat">@totalAssets</span>
                <span class="bento-stat-label">in the asset register</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card is-compact @(expiringCertificates > 0 ? "tone-rose" : "tone-green")"
           asp-controller="SSLCertificates" asp-action="ExpiringSoon">
            <span class="bento-badge"><i class="fas fa-shield-halved" aria-hidden="true"></i> Risk</span>
            <h3 class="bento-title">Certificates expiring</h3>
            <div class="bento-figure">
                <span class="bento-stat">@expiringCertificates</span>
                <span class="bento-stat-label">within 30 days</span>
            </div>
            <span class="bento-cta">Review <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
    </div>

    <div class="report-grid">

        <div class="panel">
            <div class="panel-header">
                <i class="fas fa-ticket-alt"></i>
                <span>Ticket overview</span>
                <a class="report-btn" asp-controller="Tickets" asp-action="Index">
                    <i class="fas fa-list"></i> View all
                </a>
            </div>
            <div class="panel-body">
                <div class="bars">
                    <div class="bar-row">
                        <div class="bar-label">Open</div>
                        <div class="bar-track"><div class="bar-fill amber" style="width:@Pct(openTickets)%"></div></div>
                        <div class="bar-value">@openTickets</div>
                    </div>
                    <div class="bar-row">
                        <div class="bar-label">In progress</div>
                        <div class="bar-track"><div class="bar-fill violet" style="width:@Pct(inProgressTickets)%"></div></div>
                        <div class="bar-value">@inProgressTickets</div>
                    </div>
                    <div class="bar-row">
                        <div class="bar-label">Resolved</div>
                        <div class="bar-track"><div class="bar-fill green" style="width:@Pct(resolvedTickets)%"></div></div>
                        <div class="bar-value">@resolvedTickets</div>
                    </div>
                    <div class="bar-row">
                        <div class="bar-label">Closed</div>
                        @* Slate, not the brand crimson the bare .bar-fill gives:
                           a closed ticket is a benign state, not an alert. *@
                        <div class="bar-track"><div class="bar-fill slate" style="width:@Pct(closedTickets)%"></div></div>
                        <div class="bar-value">@closedTickets</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <i class="fas fa-flag"></i>
                <span>Priority &amp; status</span>
            </div>
            <div class="panel-body">
                <div class="bars">
                    <div class="bar-row">
                        <div class="bar-label">Critical</div>
                        <div class="bar-track"><div class="bar-fill red" style="width:@Pct(criticalPriorityTickets)%"></div></div>
                        <div class="bar-value">@criticalPriorityTickets</div>
                    </div>
                    <div class="bar-row">
                        <div class="bar-label">High</div>
                        <div class="bar-track"><div class="bar-fill amber" style="width:@Pct(highPriorityTickets)%"></div></div>
                        <div class="bar-value">@highPriorityTickets</div>
                    </div>
                    <div class="bar-row">
                        <div class="bar-label">Medium</div>
                        <div class="bar-track"><div class="bar-fill green" style="width:@Pct(mediumTickets)%"></div></div>
                        <div class="bar-value">@mediumTickets</div>
                    </div>
                </div>
                <div class="summary-grid" style="margin-top:1.25rem;">
                    <div class="summary-item">
                        <span class="summary-label">Active</span>
                        <span class="summary-value">@active</span>
                    </div>
                    <div class="summary-item">
                        <span class="summary-label">Completed</span>
                        <span class="summary-value">@completed</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-header">
                <i class="fas fa-clock-rotate-left"></i>
                <span>Recent activity</span>
                <span class="status-badge status-resolved">Live</span>
            </div>
            <div class="panel-body flush">
                @if (ViewBag.RecentActivities != null && ViewBag.RecentActivities.Count > 0)
                {
                    <ul class="feed">
                        @foreach (var activity in ViewBag.RecentActivities)
                        {
                            <li class="feed-item">
                                <span class="feed-icon @activity.Type"><i class="fas @activity.Icon"></i></span>
                                <span class="feed-body">
                                    <span class="feed-text">@activity.Message</span>
                                    <span class="feed-time">@activity.TimeAgo</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-mini">
                        <i class="fas fa-inbox"></i>
                        <span>No recent activity</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="report-section-head">
        <h2>Jump to</h2>
        <span class="rule"></span>
    </div>
    <div class="report-bento is-3col">

        @* Six tiles across three columns: a 2x2 hero beside two stacked
           singles, then a row of three. Fills the grid exactly, so there is
           no hole to explain. *@

        <a class="bento-card is-hero span-2 tall-2" asp-controller="SSLCertificates" asp-action="ExpiringSoon">
            <span class="bento-badge"><i class="fas fa-shield-halved" aria-hidden="true"></i> Expiring soon</span>
            <h3 class="bento-title">Certificates that need renewing</h3>
            <p class="bento-desc">
                The certificates closest to lapsing, in the order they will go.
                A lapse takes the service down with it.
            </p>
            <div class="bento-figure">
                <span class="bento-stat">@expiringCertificates</span>
                <span class="bento-stat-label">expiring within the next 30 days</span>
            </div>
            <span class="bento-cta">Review certificates <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card tone-ink" asp-controller="Assets" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-laptop" aria-hidden="true"></i> Estate</span>
            <h3 class="bento-title">Asset register</h3>
            <p class="bento-desc">Everything tracked across the estate, and who is holding it.</p>
            <div class="bento-figure">
                <span class="bento-stat">@totalAssets</span>
                <span class="bento-stat-label">assets tracked</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card tone-violet" asp-controller="AuditLogs" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-history" aria-hidden="true"></i> Trail</span>
            <h3 class="bento-title">Audit logs</h3>
            <p class="bento-desc">Every change recorded across the system, with who made it.</p>
            <span class="bento-cta">Open <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card tone-teal" asp-controller="Activity" asp-action="Create">
            <span class="bento-badge"><i class="fas fa-stopwatch" aria-hidden="true"></i> Log</span>
            <h3 class="bento-title">Log activity</h3>
            <p class="bento-desc">Record time spent against a category of work.</p>
            <span class="bento-cta">Start logging <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card tone-green" asp-controller="Assets" asp-action="Create">
            <span class="bento-badge"><i class="fas fa-box" aria-hidden="true"></i> Add</span>
            <h3 class="bento-title">Add an asset</h3>
            <p class="bento-desc">Register new hardware into the estate.</p>
            <span class="bento-cta">New asset <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

        <a class="bento-card tone-amber" asp-controller="PaymentSchedule" asp-action="Create">
            <span class="bento-badge"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i> Spend</span>
            <h3 class="bento-title">Payment schedule</h3>
            <p class="bento-desc">Set up a new recurring service payment obligation.</p>
            <span class="bento-cta">New schedule <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>

    </div>
</div>
