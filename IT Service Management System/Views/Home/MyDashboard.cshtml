@{
    ViewData["Title"] = "My Dashboard - Axis IT Operations";
    var name = Context.Session.GetString("UserName") ?? "there";
    var myTotal = ViewBag.MyTotalTickets ?? 0;
    var myOpen = ViewBag.MyOpenTickets ?? 0;
    var myResolved = ViewBag.MyResolvedTickets ?? 0;
    var actHours = ViewBag.MyActivityHours ?? 0;
    var actCount = ViewBag.MyActivityCount ?? 0;
    var recent = ViewBag.MyRecentTickets as List<IT_Service_Management_System.Models.Ticket> ?? new List<IT_Service_Management_System.Models.Ticket>();
}

<div class="report-shell">

    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-gauge-high"></i> My workspace</div>
            <h1>Welcome back, @name</h1>
            <p class="report-lede">Your tickets and logged time at a glance.</p>
            <div class="report-meta">
                <span><i class="fas fa-calendar me-1"></i>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Activity" asp-action="Create">
                <i class="fas fa-clock"></i> Log activity
            </a>
            <a class="report-btn primary" asp-controller="Tickets" asp-action="Create">
                <i class="fas fa-plus"></i> Create ticket
            </a>
        </div>
    </div>

    @* The same tiles as the rest of the app, kept to four so the row stays
       even: hours logged and the entry count were two cards saying one thing,
       and are now one figure with its count underneath. This dashboard stays
       deliberately minimal - no quick-action mosaic like the admin one, since
       an ordinary user has only their own tickets and time to act on. *@
    <div class="stat-grid">
        <a class="bento-card is-compact @(myOpen > 0 ? "tone-amber" : "tone-green")"
           asp-controller="Tickets" asp-action="Index" asp-route-status="Open">
            <span class="bento-badge"><i class="fas fa-folder-open"></i> Waiting</span>
            <h3 class="bento-title">My open tickets</h3>
            <div class="bento-figure">
                <span class="bento-stat">@myOpen</span>
                <span class="bento-stat-label">@(myOpen > 0 ? "still being worked" : "nothing outstanding")</span>
            </div>
            <span class="bento-cta">See them <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card is-compact tone-slate" asp-controller="Tickets" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-ticket-alt"></i> Tickets</span>
            <h3 class="bento-title">My total tickets</h3>
            <div class="bento-figure">
                <span class="bento-stat">@myTotal</span>
                <span class="bento-stat-label">raised by you</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card is-compact tone-green" asp-controller="Tickets" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-circle-check"></i> Done</span>
            <h3 class="bento-title">Resolved or closed</h3>
            <div class="bento-figure">
                <span class="bento-stat">@myResolved</span>
                <span class="bento-stat-label">of your @myTotal</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card is-compact tone-teal" asp-controller="Activity" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-clock"></i> Work</span>
            <h3 class="bento-title">Activity logged</h3>
            <div class="bento-figure">
                <span class="bento-stat">@actHours h</span>
                <span class="bento-stat-label">across @actCount entr@(actCount == 1 ? "y" : "ies")</span>
            </div>
            <span class="bento-cta">Open tracker <i class="fas fa-arrow-right"></i></span>
        </a>
    </div>

    <div class="panel">
        <div class="panel-header">
            <i class="fas fa-clock-rotate-left"></i>
            <span>My recent tickets</span>
            <a class="report-btn" asp-controller="Tickets" asp-action="Index">
                <i class="fas fa-list"></i> View all
            </a>
        </div>
        <div class="panel-body flush">
            @if (recent.Any())
            {
                <div class="table-responsive">
                    <table class="report-table">
                        <thead>
                            <tr><th>Title</th><th>Status</th><th>Priority</th><th>Created</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var t in recent)
                            {
                                var priority = t.Priority.ToString();
                                <tr>
                                    <td><span class="ticket-title-text">@t.Title</span></td>
                                    <td><span class="status-badge">@t.Status</span></td>
                                    <td>
                                        <span class="priority-badge @(priority == "High" ? "priority-high" : priority == "Medium" ? "priority-medium" : "priority-low")">
                                            @priority
                                        </span>
                                    </td>
                                    <td><span class="ticket-date">@t.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-mini">
                    <i class="fas fa-inbox"></i>
                    <span>You haven't created any tickets yet.</span>
                    <a class="report-btn" asp-controller="Tickets" asp-action="Create">
                        <i class="fas fa-plus"></i> Create your first ticket
                    </a>
                </div>
            }
        </div>
    </div>
</div>
