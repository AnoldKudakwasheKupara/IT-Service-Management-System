@model IT_Service_Management_System.Models.Ticket

@{
    ViewData["Title"] = $"{Model.Reference} - Axis IT Helpdesk";
    var isClosed = Model.Status.ToString() == "Closed";
    var isStaff = (bool)(ViewBag.IsStaff ?? false);
    var agents = ViewBag.Agents as List<IT_Service_Management_System.Models.User> ?? new List<IT_Service_Management_System.Models.User>();
    var viewerId = Context.Session.GetInt32("UserId");
}

@functions {
    string DayLabel(DateTime d)
    {
        var today = DateTime.Today;
        if (d.Date == today) return "Today";
        if (d.Date == today.AddDays(-1)) return "Yesterday";
        return d.ToString("MMMM dd, yyyy");
    }
    string Initials(IT_Service_Management_System.Models.User? u)
    {
        if (u == null) return "?";
        var f = string.IsNullOrEmpty(u.FirstName) ? "" : u.FirstName.Substring(0, 1);
        var l = string.IsNullOrEmpty(u.LastName) ? "" : u.LastName.Substring(0, 1);
        var s = (f + l).ToUpperInvariant();
        return string.IsNullOrEmpty(s) ? "?" : s;
    }
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-ticket-alt me-2" style="color: var(--primary);"></i>
                    Ticket Details
                </h1>
                <p class="text-muted mt-2">View and manage ticket information</p>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="ticket-flash"><i class="fas fa-check-circle"></i> @TempData["Success"]</div>
    }

    <!-- Main Ticket Card -->
    <div class="ticket-details-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-ticket-alt me-2"></i>
                <span>@Model.Reference</span>
            </div>
            <div class="ticket-status-badge @(isClosed ? "closed" : "active")">
                @if (isClosed)
                {
                    <i class="fas fa-ban"></i>
                    <span>Closed</span>
                }
                else
                {
                    <i class="fas fa-circle"></i>
                    <span>Active</span>
                }
            </div>
        </div>

        <div class="card-body-custom">
            <!-- Ticket Header with Title and Status -->
            <div class="ticket-header">
                <div class="ticket-title-section">
                    <h2 class="ticket-title">@Model.Title</h2>
                    <div class="ticket-badges">
                        @{
                            var status = Model.Status.ToString();
                            if (status == "Open")
                            {
                                <span class="status-badge status-open">
                                    <i class="fas fa-circle"></i> Open
                                </span>
                            }
                            else if (status == "InProgress")
                            {
                                <span class="status-badge status-progress">
                                    <i class="fas fa-spinner fa-pulse"></i> In Progress
                                </span>
                            }
                            else if (status == "Resolved")
                            {
                                <span class="status-badge status-resolved">
                                    <i class="fas fa-check-circle"></i> Resolved
                                </span>
                            }
                            else if (status == "OnHold")
                            {
                                <span class="status-badge" style="background:#fef3c7;color:#92400e;">
                                    <i class="fas fa-pause-circle"></i> On Hold
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-closed">
                                    <i class="fas fa-ban"></i> Closed
                                </span>
                            }
                        }
                        @if (Model.IsEscalated && Model.IsOpen)
                        {
                            <span class="status-badge" style="background:#fee2e2;color:#b91c1c;">
                                <i class="fas fa-angles-up"></i> Escalated
                            </span>
                        }

                        @{
                            var priority = Model.Priority.ToString();
                            if (priority == "Critical")
                            {
                                <span class="priority-badge priority-critical">
                                    <i class="fas fa-exclamation-circle"></i> Critical
                                </span>
                            }
                            else if (priority == "High")
                            {
                                <span class="priority-badge priority-high">
                                    <i class="fas fa-arrow-up"></i> High
                                </span>
                            }
                            else if (priority == "Medium")
                            {
                                <span class="priority-badge priority-medium">
                                    <i class="fas fa-minus"></i> Medium
                                </span>
                            }
                            else
                            {
                                <span class="priority-badge priority-low">
                                    <i class="fas fa-arrow-down"></i> Low
                                </span>
                            }
                        }
                    </div>
                </div>
                <div class="ticket-meta">
                    <div class="meta-item">
                        <i class="fas fa-user"></i>
                        <div>
                            <label>Created by</label>
                            <span>@Model.CreatedBy?.FirstName @Model.CreatedBy?.LastName</span>
                        </div>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-calendar"></i>
                        <div>
                            <label>Created</label>
                            <span>@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' HH:mm")</span>
                        </div>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-user-gear"></i>
                        <div>
                            <label>Assigned to</label>
                            <span>@(Model.AssignedTo != null ? $"{Model.AssignedTo.FirstName} {Model.AssignedTo.LastName}" : "Unassigned")</span>
                        </div>
                    </div>
                    @if (Model.DueAt != null)
                    {
                        <div class="meta-item">
                            <i class="fas @(Model.IsSlaBreached ? "fa-triangle-exclamation" : "fa-stopwatch")" style="color:@(Model.IsSlaBreached ? "var(--danger)" : "var(--primary)");"></i>
                            <div>
                                <label>SLA (@Model.Priority)</label>
                                <span style="color:@(Model.IsSlaBreached ? "var(--danger)" : "inherit");font-weight:@(Model.IsSlaBreached ? "700" : "500");">
                                    @IT_Service_Management_System.Helpers.TicketSla.Describe(Model.DueAt, Model.IsOpen)
                                </span>
                            </div>
                        </div>
                    }
                    @if (Model.UpdatedAt != null)
                    {
                        <div class="meta-item">
                            <i class="fas fa-clock-rotate-left"></i>
                            <div>
                                <label>Last updated</label>
                                <span>@Model.UpdatedAt.Value.ToString("MMM dd, yyyy 'at' HH:mm")</span>
                            </div>
                        </div>
                    }
            </div>

            <!-- Description Section -->
            <div class="description-section">
                <h3 class="section-title">
                    <i class="fas fa-align-left"></i>
                    Description
                </h3>
                <div class="description-content">
                    @Model.Description
                </div>
            </div>

            @if (Model.SlaEvents.Any() || Model.SlaPolicy != null)
            {
                <div class="description-section">
                    <h3 class="section-title"><i class="fas fa-stopwatch"></i>Proactive SLA</h3>
                    @if (Model.SlaPolicy != null)
                    {
                        <p class="text-muted mb-3">Policy: <strong>@Model.SlaPolicy.Name</strong> · Warning at @Model.SlaPolicy.WarningThresholdPercent% · Calendar: @(Model.SlaPolicy.Calendar?.Name ?? (Model.SlaPolicy.BusinessHoursOnly ? "Default business hours" : "24×7"))</p>
                    }
                    @if (Model.SlaEvents.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var slaEvent in Model.SlaEvents.OrderByDescending(e => e.OccurredAt))
                            {
                                var breach = slaEvent.Type.ToString().Contains("Breached");
                                <div class="list-group-item px-0 d-flex justify-content-between gap-3">
                                    <span class="@(breach ? "text-danger fw-semibold" : "text-warning-emphasis")"><i class="fas @(breach ? "fa-triangle-exclamation" : "fa-bell") me-2"></i>@slaEvent.Message</span>
                                    <small class="text-muted text-nowrap">@slaEvent.OccurredAt.ToString("dd MMM HH:mm")</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Staff toolbar -->
            @if (isStaff && !isClosed)
            {
                <div class="staff-toolbar">
                    <div class="staff-toolbar-row">
                        <span class="toolbar-label"><i class="fas fa-bolt"></i> Set status</span>
                        <form asp-action="ChangeStatus" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button name="status" value="InProgress" class="status-btn progress"><i class="fas fa-spinner"></i> In Progress</button>
                        </form>
                        <form asp-action="ChangeStatus" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button name="status" value="Resolved" class="status-btn resolved"><i class="fas fa-check-circle"></i> Resolved</button>
                        </form>
                        <a asp-action="Close" asp-route-id="@Model.Id" class="status-btn closed"><i class="fas fa-lock"></i> Close</a>
                    </div>
                    <div class="staff-toolbar-row">
                        <span class="toolbar-label"><i class="fas fa-stopwatch"></i> SLA</span>
                        @if (Model.IsOnHold)
                        {
                            <form asp-action="Resume" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="status-btn progress"><i class="fas fa-play"></i> Resume</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Hold" method="post" class="inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="status-btn" style="background:#fef3c7;color:#92400e;"><i class="fas fa-pause"></i> Put on hold</button>
                            </form>
                        }
                        <form asp-action="Escalate" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="status-btn" style="background:#fee2e2;color:#b91c1c;">
                                <i class="fas fa-angles-up"></i> @(Model.IsEscalated ? "Escalate again" : "Escalate")
                            </button>
                        </form>
                    </div>
                    <div class="staff-toolbar-row">
                        <span class="toolbar-label"><i class="fas fa-user-gear"></i> Assign</span>
                        <form asp-action="Assign" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="assignedToId" class="assign-select">
                                <option value="">— Unassigned —</option>
                                @foreach (var ag in agents)
                                {
                                    <option value="@ag.Id" selected="@(Model.AssignedToId == ag.Id)">@ag.FirstName @ag.LastName</option>
                                }
                            </select>
                            <button type="submit" class="status-btn assign"><i class="fas fa-paper-plane"></i> Update</button>
                        </form>
                    </div>
                </div>
            }
            else if (isClosed)
            {
                <div class="closed-alert">
                    <i class="fas fa-lock"></i>
                    <div style="flex:1;">
                        <strong>This ticket is closed</strong>
                        <p>Reopen it to continue the conversation.</p>
                    </div>
                    <form asp-action="Reopen" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="status-btn progress"><i class="fas fa-rotate-left"></i> Reopen</button>
                    </form>
                </div>
            }
        </div>
    </div>

    <!-- Attachments Section -->
    @{
        var isOwnerView = Model.CreatedById == viewerId;
    }
    @if (isOwnerView && !Model.IsOpen)
    {
        <div class="csat-card">
            <div class="card-header-custom">
                <i class="fas fa-star me-2"></i>
                <span>Your Feedback</span>
            </div>
            <div class="card-body-custom">
                @if (Model.SatisfactionRating == null)
                {
                    <p style="margin-bottom:0.75rem;color:var(--gray-600);">How satisfied were you with how this ticket was handled?</p>
                    <form asp-action="RateSatisfaction" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="csat-stars" id="csatStars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <button type="button" class="csat-star" data-v="@i" aria-label="@i stars"><i class="fas fa-star"></i></button>
                            }
                        </div>
                        <input type="hidden" name="rating" id="csatRating" value="" required />
                        <textarea name="comment" class="reply-textarea" rows="2" placeholder="Any comments? (optional)" style="margin-top:0.75rem;"></textarea>
                        <button type="submit" class="btn-send-reply" style="margin-top:0.6rem;">
                            <i class="fas fa-paper-plane"></i> Submit Feedback
                        </button>
                    </form>
                }
                else
                {
                    <div class="csat-result">
                        <div class="csat-stars-static">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fas fa-star @(i <= Model.SatisfactionRating ? "filled" : "")"></i>
                            }
                        </div>
                        <span style="font-weight:600;color:var(--gray-700);">You rated this @Model.SatisfactionRating / 5</span>
                        @if (!string.IsNullOrEmpty(Model.SatisfactionComment))
                        {
                            <p class="csat-comment">“@Model.SatisfactionComment”</p>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <style>
        /* Internal notes */
        .internal-message .message-content { background:#fffbeb !important; border-left:3px solid var(--warning,#f59e0b) !important; }
        .internal-badge { margin-left:auto; font-size:0.62rem; font-weight:700; text-transform:uppercase; letter-spacing:0.4px;
            color:#92400e; background:#fef3c7; border:1px solid #fde68a; padding:0.1rem 0.5rem; border-radius:1rem; display:inline-flex; align-items:center; gap:0.3rem; }
        .internal-note-toggle { display:inline-flex; align-items:center; gap:0.35rem; margin-left:0.75rem; font-size:0.78rem; color:#92400e; cursor:pointer; }
        .internal-note-toggle input { accent-color:var(--warning,#f59e0b); }
        /* CSAT */
        .csat-card { background:#fff; border-radius:1rem; overflow:hidden; box-shadow:var(--shadow-sm); border:1px solid var(--gray-200); margin-bottom:1.5rem; }
        .csat-stars { display:flex; gap:0.25rem; }
        .csat-star { background:none; border:none; cursor:pointer; font-size:1.6rem; color:var(--gray-300,#cbd5e1); transition:color 0.15s; padding:0; }
        .csat-star.on, .csat-star:hover, .csat-star.on ~ .csat-star { color:#f59e0b; }
        .csat-stars:hover .csat-star { color:var(--gray-300,#cbd5e1); }
        .csat-stars .csat-star:hover, .csat-stars .csat-star:hover ~ .csat-star { color:#f59e0b; }
        .csat-stars-static .fa-star { color:var(--gray-300,#cbd5e1); font-size:1.3rem; }
        .csat-stars-static .fa-star.filled { color:#f59e0b; }
        .csat-result { display:flex; flex-direction:column; gap:0.4rem; }
        .csat-comment { font-style:italic; color:var(--gray-500); margin:0.25rem 0 0; }
    </style>
    <script>
        (function () {
            var stars = document.querySelectorAll('#csatStars .csat-star');
            var input = document.getElementById('csatRating');
            stars.forEach(function (s) {
                s.addEventListener('click', function () {
                    var v = parseInt(this.getAttribute('data-v'));
                    if (input) input.value = v;
                    stars.forEach(function (x) {
                        x.classList.toggle('on', parseInt(x.getAttribute('data-v')) <= v);
                    });
                });
            });
        })();
    </script>

    <div class="attachments-card">
        <div class="card-header-custom">
            <i class="fas fa-paperclip me-2"></i>
            <span>Attachments</span>
            <span class="attachment-count">@(Model.Attachments?.Count() ?? 0) files</span>
        </div>
        <div class="card-body-custom">
            @if (Model.Attachments != null && Model.Attachments.Any())
            {
                <div class="attachments-grid">
                    @foreach (var file in Model.Attachments)
                    {
                        <div class="attachment-item">
                            <i class="fas fa-file-alt"></i>
                            <div class="attachment-info">
                                <a href="@file.FilePath" target="_blank" class="attachment-link">@file.FileName</a>
                                <span class="attachment-meta">Uploaded @file.UploadedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-attachments">
                    <i class="fas fa-paperclip"></i>
                    <p>No attachments</p>
                </div>
            }
        </div>
    </div>

    <!-- Conversation Section -->
    <div class="conversation-card">
        <div class="card-header-custom">
            <i class="fas fa-comments me-2"></i>
            <span>Conversation</span>
            <span class="message-count">@(Model.Messages?.Count() ?? 0) messages</span>
        </div>
        
        <div class="chat-container" id="chatBox">
            @if (Model.Messages != null && Model.Messages.Any())
            {
                var ordered = Model.Messages.OrderBy(m => m.SentAt).ToList();
                DateTime? prevDay = null;
                int prevSender = -1;
                bool prevInternal = false;
                DateTime prevAt = DateTime.MinValue;

                foreach (var msg in ordered)
                {
                    var isMine = viewerId != null && msg.SenderId == viewerId;
                    var newDay = prevDay == null || msg.SentAt.Date != prevDay.Value.Date;
                    if (newDay)
                    {
                        <div class="chat-day"><span>@DayLabel(msg.SentAt)</span></div>
                    }
                    var grouped = !newDay && msg.SenderId == prevSender && msg.IsInternal == prevInternal
                                  && (msg.SentAt - prevAt).TotalMinutes < 5;
                    var rowClasses = (isMine ? "mine" : "theirs") + (msg.IsInternal ? " internal" : "") + (grouped ? " grouped" : "");
                    var senderName = $"{msg.Sender?.FirstName} {msg.Sender?.LastName}".Trim();

                    <div class="chat-row @rowClasses" data-key="@(isMine ? "me" : $"u:{senderName}")">
                        @if (!isMine)
                        {
                            <div class="chat-avatar" title="@senderName">@Initials(msg.Sender)</div>
                        }
                        <div class="chat-col">
                            @if (!grouped)
                            {
                                <div class="chat-name">
                                    @(isMine ? "You" : senderName)
                                    @if (msg.IsInternal)
                                    {
                                        <span class="chat-internal-tag"><i class="fas fa-user-shield"></i> Internal</span>
                                    }
                                </div>
                            }
                            <div class="chat-bubble">
                                <span class="chat-text">@msg.Message</span>
                                @if (msg.Attachments != null && msg.Attachments.Any())
                                {
                                    <span class="chat-attach">
                                        @foreach (var file in msg.Attachments)
                                        {
                                            <a href="@file.FilePath" target="_blank" class="chat-attach-link"><i class="fas fa-paperclip"></i> @file.FileName</a>
                                        }
                                    </span>
                                }
                                <span class="chat-time">@msg.SentAt.ToString("HH:mm")</span>
                            </div>
                        </div>
                    </div>

                    prevDay = msg.SentAt;
                    prevSender = msg.SenderId;
                    prevInternal = msg.IsInternal;
                    prevAt = msg.SentAt;
                }
            }
            else
            {
                <div class="empty-conversation">
                    <i class="fas fa-comments"></i>
                    <p>No messages yet</p>
                    <span>Start the conversation below</span>
                </div>
            }
        </div>

        <!-- Composer -->
        @if (!isClosed)
        {
            var isStaffView = (bool?)ViewBag.IsStaff ?? false;
            var canned = ViewBag.CannedResponses as List<IT_Service_Management_System.Models.CannedResponse>
                ?? new List<IT_Service_Management_System.Models.CannedResponse>();
            <form id="chatForm" class="composer" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="ticketId" value="@Model.Id" />

                @if (isStaffView && canned.Any())
                {
                    <select id="cannedSelect" class="composer-canned">
                        <option value="">＋ Insert a canned reply…</option>
                        @foreach (var c in canned)
                        {
                            <option value="@c.Body">@c.Title</option>
                        }
                    </select>
                }

                <div class="composer-bar">
                    <label for="fileInput" class="composer-attach" title="Attach files">
                        <i class="fas fa-paperclip"></i>
                    </label>
                    <input type="file" id="fileInput" multiple hidden />
                    <textarea id="messageInput" class="composer-input" rows="1" placeholder="Type a message…"></textarea>
                    <button type="button" onclick="sendMessage()" class="composer-send" title="Send">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>

                <div class="composer-meta">
                    <span id="fileNameDisplay" class="file-name-display"></span>
                    @if (isStaffView)
                    {
                        <label class="internal-note-toggle" title="Visible to staff only — not shown to the requester and not emailed">
                            <input type="checkbox" id="isInternalCheck" />
                            <i class="fas fa-user-shield"></i> Internal note
                        </label>
                    }
                    <span class="composer-hint"><kbd>Enter</kbd> to send · <kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line</span>
                </div>
            </form>
        }
    </div>
</div>

<style>
    /* Ticket Details Page Styles */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    .page-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
    }

    .btn-back:hover {
        background: var(--gray-50);
        color: var(--primary);
        transform: translateX(-2px);
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* Cards */
    .ticket-details-card, .attachments-card, .conversation-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* Ticket Status Badge */
    .ticket-status-badge {
        margin-left: auto;
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .ticket-status-badge.active {
        background: #e6f5e9;
        color: var(--success);
    }

    .ticket-status-badge.closed {
        background: var(--gray-100);
        color: var(--gray-500);
    }

    /* Ticket Header */
    .ticket-header {
        border-bottom: 1px solid var(--gray-200);
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .ticket-title-section {
        margin-bottom: 1rem;
    }

    .ticket-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0 0 0.75rem 0;
    }

    .ticket-badges {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .status-badge, .priority-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .status-open { background: #fff5e6; color: var(--warning); border: 1px solid #ffe0b3; }
    .status-progress { background: #fceaeb; color: var(--info); border: 1px solid #f4ced0; }
    .status-resolved { background: #e6f5e9; color: var(--success); border: 1px solid #c6e0c9; }
    .status-closed { background: var(--gray-100); color: var(--gray-500); border: 1px solid var(--gray-300); }
    .priority-critical { background: #fee; color: var(--danger); border: 1px solid #fed7d7; }
    .priority-high { background: #fff5f5; color: #e67e22; border: 1px solid #ffe0d4; }
    .priority-medium { background: var(--gray-100); color: var(--warning); border: 1px solid var(--gray-300); }
    .priority-low { background: var(--gray-100); color: var(--gray-500); border: 1px solid var(--gray-300); }

    /* Meta Items */
    .ticket-meta {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.75rem;
    }

    .meta-item i {
        width: 24px;
        color: var(--primary);
    }

    .meta-item label {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray-500);
        display: block;
        margin-bottom: 0.125rem;
    }

    .meta-item span {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--gray-700);
    }

    /* Description Section */
    .description-section {
        margin-bottom: 1.5rem;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--gray-700);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .description-content {
        background: var(--gray-50);
        padding: 1rem;
        border-radius: 0.75rem;
        line-height: 1.6;
        color: var(--gray-700);
    }

    /* Close Ticket Section */
    .close-ticket-section {
        background: #fff5f5;
        border: 1px solid #fed7d7;
        border-radius: 0.75rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .btn-close-ticket {
        background: linear-gradient(100deg, var(--danger), #c53030);
        color: white;
        padding: 0.625rem 1.25rem;
        border-radius: 0.5rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
    }

    .btn-close-ticket:hover {
        transform: translateY(-1px);
        box-shadow: var(--shadow-md);
    }

    .close-hint {
        font-size: 0.75rem;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .closed-alert {
        background: var(--gray-50);
        border-left: 3px solid var(--gray-500);
        padding: 1rem;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .closed-alert i {
        font-size: 1.5rem;
        color: var(--gray-500);
    }

    /* Attachments */
    .attachments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 0.75rem;
    }

    .attachment-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: var(--gray-50);
        border-radius: 0.5rem;
        transition: all 0.2s;
    }

    .attachment-item:hover {
        background: var(--gray-100);
    }

    .attachment-item i {
        font-size: 1.25rem;
        color: var(--primary);
    }

    .attachment-info {
        flex: 1;
    }

    .attachment-link {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
        display: block;
        font-size: 0.875rem;
    }

    .attachment-link:hover {
        text-decoration: underline;
    }

    .attachment-meta {
        font-size: 0.7rem;
        color: var(--gray-500);
    }

    .empty-attachments {
        text-align: center;
        padding: 2rem;
        color: var(--gray-400);
    }

    /* ===== Chat / Conversation ===== */
    .chat-container {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        max-height: 60vh;
        overflow-y: auto;
        padding: 1.25rem 1.25rem 1.5rem;
        background:
            radial-gradient(circle at 15% 15%, rgba(177, 29, 35,0.05), transparent 55%),
            var(--gray-50);
        scroll-behavior: smooth;
    }

    /* Day divider */
    .chat-day {
        text-align: center;
        margin: 0.85rem 0 0.5rem;
    }
    .chat-day span {
        display: inline-block;
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--gray-500);
        background: var(--gray-200);
        padding: 0.2rem 0.75rem;
        border-radius: 2rem;
    }

    /* Message row */
    .chat-row {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;
        max-width: 78%;
        margin-top: 0.6rem;
        animation: chatIn 0.22s ease;
    }
    .chat-row.grouped { margin-top: 0.12rem; }
    .chat-row.theirs { align-self: flex-start; }
    .chat-row.mine { align-self: flex-end; flex-direction: row-reverse; }

    .chat-avatar {
        width: 30px; height: 30px;
        flex-shrink: 0;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        display: flex; align-items: center; justify-content: center;
    }
    .chat-row.grouped .chat-avatar { visibility: hidden; }

    .chat-col { display: flex; flex-direction: column; min-width: 0; }
    .chat-row.mine .chat-col { align-items: flex-end; }

    .chat-name {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--gray-500);
        margin: 0 0.5rem 0.2rem;
        display: flex; align-items: center; gap: 0.4rem;
    }

    .chat-bubble {
        position: relative;
        padding: 0.55rem 0.8rem 0.5rem;
        border-radius: 1.1rem;
        font-size: 0.9rem;
        line-height: 1.45;
        color: var(--gray-800);
        background: #fff;
        border: 1px solid var(--gray-200);
        box-shadow: var(--shadow-sm);
        word-wrap: break-word;
        overflow-wrap: anywhere;
    }
    .chat-row.theirs .chat-bubble { border-bottom-left-radius: 0.35rem; }
    .chat-row.mine .chat-bubble {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border: none;
        color: #fff;
        border-bottom-right-radius: 0.35rem;
    }
    .chat-row.grouped.theirs .chat-bubble { border-bottom-left-radius: 1.1rem; }
    .chat-row.grouped.mine .chat-bubble { border-bottom-right-radius: 1.1rem; }

    /* Internal note */
    .chat-row.internal .chat-bubble {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #78350f;
    }
    .chat-internal-tag {
        font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;
        color: #92400e; background: #fef3c7; border: 1px solid #fde68a;
        padding: 0.05rem 0.4rem; border-radius: 1rem;
        display: inline-flex; align-items: center; gap: 0.25rem;
    }

    .chat-text { white-space: pre-wrap; }

    .chat-time {
        display: block;
        text-align: right;
        font-size: 0.62rem;
        margin-top: 0.2rem;
        color: var(--gray-400);
    }
    .chat-row.mine .chat-time { color: rgba(255,255,255,0.8); }

    .chat-attach {
        display: flex; flex-direction: column; gap: 0.2rem;
        margin-top: 0.4rem;
    }
    .chat-attach-link {
        font-size: 0.72rem; text-decoration: none;
        color: inherit; opacity: 0.9;
        display: inline-flex; align-items: center; gap: 0.3rem;
    }
    .chat-attach-link:hover { text-decoration: underline; }

    @@keyframes chatIn {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .empty-conversation {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--gray-400);
        margin: auto;
    }
    .empty-conversation i { font-size: 2.5rem; margin-bottom: 0.5rem; display: block; }
    .empty-conversation p { font-weight: 600; color: var(--gray-500); margin: 0.25rem 0 0.15rem; }

    /* ===== Composer ===== */
    .composer {
        border-top: 1px solid var(--gray-200);
        padding: 1rem 1.25rem 1.25rem;
        background: #fff;
    }
    .composer-canned {
        width: 100%;
        margin-bottom: 0.6rem;
        padding: 0.5rem 0.7rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.6rem;
        font-size: 0.8rem;
        color: var(--gray-600);
        background: var(--gray-50);
        cursor: pointer;
    }
    .composer-bar {
        display: flex;
        align-items: flex-end;
        gap: 0.4rem;
        background: var(--gray-50);
        border: 1.5px solid var(--gray-200);
        border-radius: 1.4rem;
        padding: 0.3rem 0.35rem 0.3rem 0.5rem;
        transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .composer-bar:focus-within {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(177, 29, 35,0.12);
        background: #fff;
    }
    .composer-attach {
        flex-shrink: 0;
        width: 38px; height: 38px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: var(--gray-500);
        cursor: pointer;
        transition: all 0.15s;
    }
    .composer-attach:hover { background: var(--gray-200); color: var(--primary); }
    .composer-input {
        flex: 1;
        border: none;
        background: transparent;
        resize: none;
        outline: none;
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
        line-height: 1.4;
        color: var(--gray-800);
        padding: 0.5rem 0.25rem;
        max-height: 140px;
    }
    .composer-send {
        flex-shrink: 0;
        width: 40px; height: 40px;
        border-radius: 50%;
        border: none;
        cursor: pointer;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: #fff;
        font-size: 0.95rem;
        display: flex; align-items: center; justify-content: center;
        transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
    }
    .composer-send:hover { transform: scale(1.06); box-shadow: var(--shadow-md); }
    .composer-send:disabled { opacity: 0.6; cursor: default; transform: none; }
    .composer-meta {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        margin-top: 0.5rem;
        padding: 0 0.4rem;
        flex-wrap: wrap;
    }
    .file-name-display { font-size: 0.72rem; color: var(--primary); font-weight: 500; }
    .composer-hint { font-size: 0.68rem; color: var(--gray-400); margin-left: auto; }
    .composer-hint kbd {
        background: var(--gray-100); border: 1px solid var(--gray-300);
        border-radius: 0.3rem; padding: 0 0.3rem; font-size: 0.64rem; color: var(--gray-600);
    }

    /* Flash banner */
    .ticket-flash {
        background: #f0fdf4; border-left: 4px solid var(--success); color: #166534;
        padding: 0.8rem 1rem; border-radius: 0.6rem; margin-bottom: 1rem;
        display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 500;
    }

    /* Staff toolbar */
    .staff-toolbar {
        background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: 0.75rem;
        padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem;
    }
    .staff-toolbar-row { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .toolbar-label { font-size: 0.75rem; font-weight: 700; color: var(--gray-600); min-width: 90px; }
    .toolbar-label i { color: var(--primary); margin-right: 0.25rem; }
    .inline-form { display: inline; margin: 0; }
    .status-btn {
        border: none; cursor: pointer; padding: 0.45rem 0.9rem; border-radius: 0.5rem;
        font-size: 0.8rem; font-weight: 600; color: white; display: inline-flex; align-items: center;
        gap: 0.4rem; text-decoration: none; transition: all 0.15s;
    }
    .status-btn:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); color: white; }
    .status-btn.progress { background: var(--info); }
    .status-btn.resolved { background: var(--success); }
    .status-btn.closed { background: var(--gray-600); }
    .status-btn.assign { background: var(--primary-dark); }
    .assign-select {
        padding: 0.45rem 0.7rem; border: 1.5px solid var(--gray-200); border-radius: 0.5rem;
        font-size: 0.8rem; font-family: inherit; background: white; min-width: 180px;
    }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<script>
    const ticketId = document.getElementById("ticketId")?.value;
    const tid = ticketId ? Number(ticketId) : null;
    const chatBox = document.getElementById("chatBox");
    let connection;

    function nowHM() {
        const d = new Date();
        return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
    }
    function initialsOf(name) {
        return (name || '?').trim().split(/\s+/).map(p => p[0] || '').join('').substring(0, 2).toUpperCase() || '?';
    }
    function chatEscape(text) {
        const div = document.createElement('div');
        div.textContent = text ?? '';
        return div.innerHTML;
    }

    // Append a message bubble — used for both our own sends and live receives.
    function appendChatMessage(opts) {
        if (!chatBox) return;
        const empty = chatBox.querySelector('.empty-conversation');
        if (empty) empty.remove();

        const key = opts.mine ? 'me' : ('u:' + (opts.name || '').trim());
        const last = chatBox.querySelector('.chat-row:last-of-type');
        const grouped = !!last && last.getAttribute('data-key') === key
            && last.classList.contains('internal') === !!opts.internal;

        const row = document.createElement('div');
        row.className = 'chat-row ' + (opts.mine ? 'mine' : 'theirs')
            + (opts.internal ? ' internal' : '') + (grouped ? ' grouped' : '');
        row.setAttribute('data-key', key);

        const avatar = opts.mine ? '' : `<div class="chat-avatar">${chatEscape(initialsOf(opts.name))}</div>`;
        const tag = opts.internal
            ? ' <span class="chat-internal-tag"><i class="fas fa-user-shield"></i> Internal</span>' : '';
        const name = grouped ? ''
            : `<div class="chat-name">${opts.mine ? 'You' : chatEscape(opts.name)}${tag}</div>`;

        row.innerHTML = `${avatar}<div class="chat-col">${name}`
            + `<div class="chat-bubble"><span class="chat-text">${chatEscape(opts.text)}</span>`
            + `<span class="chat-time">${chatEscape(opts.time || nowHM())}</span></div></div>`;

        chatBox.appendChild(row);
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    // ── Real-time (SignalR) ──────────────────────────────────────────────
    if (tid && window.signalR) {
        connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub")
            .withAutomaticReconnect()
            .build();

        connection.start()
            .then(() => connection.invoke("JoinTicketGroup", tid))
            .catch(err => console.error("SignalR connection error:", err));

        // Broadcast from the other side only (the hub excludes the sender).
        connection.on("ReceiveMessage", function (user, message) {
            appendChatMessage({ mine: false, name: user, text: message, time: nowHM(), internal: false });
        });
    }

    // ── Composer behaviour ───────────────────────────────────────────────
    const messageInput = document.getElementById('messageInput');
    const fileInput = document.getElementById('fileInput');
    const fileNameDisplay = document.getElementById('fileNameDisplay');

    if (fileInput) {
        fileInput.addEventListener('change', function () {
            fileNameDisplay.textContent = this.files.length ? `${this.files.length} file(s) attached` : '';
        });
    }

    if (messageInput) {
        // Enter sends, Shift+Enter inserts a newline.
        messageInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
        // Auto-grow to fit content.
        messageInput.addEventListener('input', function () {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 140) + 'px';
        });
    }

    // Insert a canned reply into the message box.
    const cannedSelect = document.getElementById('cannedSelect');
    if (cannedSelect) {
        cannedSelect.addEventListener('change', function () {
            if (!this.value || !messageInput) return;
            messageInput.value = messageInput.value
                ? (messageInput.value.trimEnd() + "\n\n" + this.value) : this.value;
            messageInput.dispatchEvent(new Event('input'));
            messageInput.focus();
            this.value = "";
        });
    }

    function sendMessage() {
        if (!messageInput) return;
        const message = messageInput.value.trim();
        if (!message) { showNotification('Please enter a message', 'warning'); return; }

        const internalCheck = document.getElementById("isInternalCheck");
        const isInternal = internalCheck ? internalCheck.checked : false;

        const formData = new FormData();
        formData.append("ticketId", ticketId);
        formData.append("message", message);
        formData.append("isInternal", isInternal);
        if (fileInput) {
            for (let i = 0; i < fileInput.files.length; i++) formData.append("files", fileInput.files[i]);
        }

        const sendBtn = document.querySelector('.composer-send');
        if (sendBtn) { sendBtn.disabled = true; sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>'; }

        fetch("/Tickets/AddReply", {
            method: "POST",
            body: formData,
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value }
        })
        .then(response => { if (!response.ok) throw new Error('Network response was not ok'); return response.json(); })
        .then(data => {
            if (!data.success) { showNotification(data.message || 'Failed to send message', 'error'); return; }

            appendChatMessage({ mine: true, name: 'You', text: message, time: nowHM(), internal: data.isInternal });

            // Internal notes stay staff-only — never broadcast them over SignalR.
            if (connection && !data.isInternal) {
                connection.invoke("SendMessage", tid, data.senderName || 'Someone', message).catch(() => {});
            }

            messageInput.value = "";
            messageInput.style.height = 'auto';
            if (fileInput) fileInput.value = "";
            if (fileNameDisplay) fileNameDisplay.textContent = "";
            if (internalCheck) internalCheck.checked = false;
            showNotification(data.isInternal ? 'Internal note saved (staff only).' : 'Reply sent — the other party has been emailed.', 'success');
        })
        .catch(error => { console.error('Error:', error); showNotification('Failed to send message. Please try again.', 'error'); })
        .finally(() => {
            if (sendBtn) { sendBtn.disabled = false; sendBtn.innerHTML = '<i class="fas fa-paper-plane"></i>'; }
        });
    }

    function confirmCloseTicket() {
        if (confirm('Are you sure you want to close this ticket?\n\nClosing the ticket will prevent any further replies.')) {
            document.getElementById('closeTicketForm').submit();
        }
    }

    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.className = 'notification-toast';
        const colors = { success: '#2c9e6e', error: '#e53e3e', warning: '#f5b042' };
        notification.style.cssText = `
            position: fixed; top: 1rem; right: 1rem;
            background: ${colors[type] || colors.success};
            color: white; padding: 1rem 1.5rem; border-radius: 0.75rem;
            box-shadow: var(--shadow-lg); z-index: 1050;
            animation: slideIn 0.3s ease; font-size: 0.875rem;`;
        notification.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i> ${message}`;
        document.body.appendChild(notification);
        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }

    // Auto-scroll to the latest message on load.
    if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
