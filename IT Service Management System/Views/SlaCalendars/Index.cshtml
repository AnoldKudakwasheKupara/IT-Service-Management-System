@model List<IT_Service_Management_System.Models.Itsm.SlaCalendar>
@{
    ViewData["Title"] = "SLA Calendars";
    var days = Enum.GetValues<DayOfWeek>();
}
<div class="container-fluid" style="max-width:1400px">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div><h1 class="h2 mb-1"><i class="fas fa-calendar-check text-primary me-2"></i>SLA Calendars</h1><p class="text-muted mb-0">Configure working hours, working days and public holidays.</p></div>
        <a asp-controller="SlaPolicies" asp-action="Index" class="btn btn-outline-primary">Back to SLA policies</a>
    </div>
    <div class="card border-0 shadow-sm mb-4"><div class="card-body">
        <h2 class="h5">New calendar</h2>
        <form asp-action="Save" method="post" class="row g-3">
            <input type="hidden" name="id" value="0" />
            <div class="col-md-4"><label class="form-label">Name</label><input name="name" class="form-control" required /></div>
            <div class="col-md-2"><label class="form-label">Start</label><input name="workDayStart" type="time" value="08:00" class="form-control" required /></div>
            <div class="col-md-2"><label class="form-label">End</label><input name="workDayEnd" type="time" value="17:00" class="form-control" required /></div>
            <div class="col-md-4 d-flex align-items-end"><label class="form-check mb-2"><input name="isDefault" value="true" type="checkbox" class="form-check-input" /> Default calendar</label></div>
            <div class="col-12"><label class="form-label d-block">Working days</label>@foreach (var day in days) { var selected = day is not DayOfWeek.Saturday and not DayOfWeek.Sunday; <label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="workingDays" value="@((int)day)" checked="@selected" /> @day</label> }</div>
            <div class="col-12 text-end"><button class="btn btn-primary">Create calendar</button></div>
        </form>
    </div></div>

    @foreach (var calendar in Model)
    {
        <div class="card border-0 shadow-sm mb-4"><div class="card-header bg-white d-flex justify-content-between"><strong>@calendar.Name</strong><span>@if (calendar.IsDefault) { <span class="badge bg-primary">Default</span> } @calendar.WorkHoursLabel</span></div><div class="card-body">
            <form asp-action="Save" method="post" class="row g-3 mb-4">
                <input type="hidden" name="id" value="@calendar.Id" />
                <div class="col-md-4"><label class="form-label">Name</label><input name="name" value="@calendar.Name" class="form-control" required /></div>
                <div class="col-md-2"><label class="form-label">Start</label><input name="workDayStart" type="time" value="@calendar.WorkDayStart.ToString("hh\\:mm")" class="form-control" /></div>
                <div class="col-md-2"><label class="form-label">End</label><input name="workDayEnd" type="time" value="@calendar.WorkDayEnd.ToString("hh\\:mm")" class="form-control" /></div>
                <div class="col-md-4 d-flex align-items-end"><label class="form-check mb-2"><input name="isDefault" value="true" type="checkbox" class="form-check-input" checked="@calendar.IsDefault" /> Default calendar</label></div>
                <div class="col-12">@foreach (var day in days) { <label class="form-check form-check-inline"><input class="form-check-input" type="checkbox" name="workingDays" value="@((int)day)" checked="@calendar.IsWorkingDay(day)" /> @day</label> }</div>
                <div class="col-12 text-end"><button class="btn btn-primary btn-sm">Save calendar</button></div>
            </form>
            <hr />
            <div class="row"><div class="col-lg-5"><h3 class="h6">Add holiday</h3><form asp-action="AddHoliday" method="post" class="row g-2"><input type="hidden" name="calendarId" value="@calendar.Id" /><div class="col-5"><input name="name" class="form-control" placeholder="Holiday name" required /></div><div class="col-4"><input name="date" type="date" class="form-control" required /></div><div class="col-3"><button class="btn btn-outline-primary w-100">Add</button></div></form></div>
            <div class="col-lg-7"><h3 class="h6">Holidays</h3><div class="d-flex flex-wrap gap-2">@foreach (var holiday in calendar.Holidays.OrderBy(h => h.Date)) { <form asp-action="DeleteHoliday" method="post"><input type="hidden" name="id" value="@holiday.Id" /><button class="btn btn-sm btn-light border" title="Remove">@holiday.Date.ToString("dd MMM yyyy") · @holiday.Name <i class="fas fa-times ms-1 text-danger"></i></button></form> } @if (!calendar.Holidays.Any()) { <span class="text-muted">No holidays configured.</span> }</div></div></div>
        </div></div>
    }
</div>
