@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model NonConformance
@{
    ViewData["Title"] = "Raise Non-Conformance";
    var departments = ViewBag.Departments as List<Department> ?? new();
    var users = ViewBag.Users as List<User> ?? new();
}
<partial name="_ImsStyles" />

<div class="ims narrow">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-bug"></i> Raise Non-Conformance</h1>
                        <p class="page-sub">Record a detected non-conformity for investigation and resolution.</p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    <div class="form-grid">
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
                            <input class="inp" asp-for="Title" required />
                            <span asp-validation-for="Title" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-triangle-exclamation"></i> Severity</label>
                            <select class="inp" asp-for="Severity" asp-items="Html.GetEnumSelectList<NcSeverity>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-diagram-project"></i> Source</label>
                            <select class="inp" asp-for="Source" asp-items="Html.GetEnumSelectList<CapaSource>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
                            <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-building"></i> Department</label>
                            <select class="inp" asp-for="DepartmentId">
                                <option value="">— None —</option>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-user"></i> Raised By</label>
                            <select class="inp" asp-for="RaisedById">
                                <option value="">— Me —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" selected="@(Model.RaisedById == u.Id)">@u.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-user-gear"></i> Assigned To</label>
                            <select class="inp" asp-for="AssignedToId">
                                <option value="">— None —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" selected="@(Model.AssignedToId == u.Id)">@u.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-calendar-day"></i> Detected Date</label>
                            <input class="inp" type="date" asp-for="DetectedDate" />
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-align-left"></i> Description <span class="req">*</span></label>
                            <textarea class="inp" asp-for="Description" rows="4" required></textarea>
                            <span asp-validation-for="Description" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-paperclip"></i> Evidence</label>
                            <textarea class="inp" asp-for="Evidence" rows="2" placeholder="References to evidence supporting the non-conformity"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Raise Non-Conformance</button>
                        <a class="btn-ghost-ims" asp-action="Index">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
