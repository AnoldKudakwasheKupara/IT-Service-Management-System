@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<NonConformance>
@{
    ViewData["Title"] = "Non-Conformance Register";
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
    var status = ViewBag.Status as NcStatus?;

    Func<NcSeverity, string> sevClass = s => s switch
    {
        NcSeverity.Minor => "b-low",
        NcSeverity.Major => "b-high",
        NcSeverity.Critical => "b-critical",
        _ => "b-medium"
    };
    Func<NcStatus, string> statusClass = s => s switch
    {
        NcStatus.Closed => "b-closed",
        NcStatus.Open => "b-open",
        _ => "b-medium"
    };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-bug"></i> Non-Conformance Register</h1>
                    <p class="page-sub">Recorded non-conformities &amp; their resolution — ISO 9001 cl. 10.2 / ISO 27001 cl. 10.1</p>
                </div>
                <div class="head-actions">
                    @if (canEdit)
                    {
                        <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Raise Non-Conformance</a>
                    }
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-bug"></i></div><div><h3>@ViewBag.Total</h3><p>Total</p></div></div>
            <div class="stat"><div class="ic amber"><i class="fas fa-folder-open"></i></div><div><h3>@ViewBag.Open</h3><p>Open</p></div></div>
            <div class="stat"><div class="ic purple"><i class="fas fa-magnifying-glass"></i></div><div><h3>@ViewBag.UnderInvestigation</h3><p>Under Investigation</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.Closed</h3><p>Closed</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <select class="inp" name="status" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (NcStatus s in Enum.GetValues(typeof(NcStatus)))
                {
                    <option value="@s" selected="@(status == s)">@s</option>
                }
            </select>
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-magnifying-glass"></i> Filter</button>
        </form>

        <div class="card">
            <div class="card-body" style="padding:0;">
                @if (Model.Any())
                {
                    <table class="tbl">
                        <thead>
                            <tr><th>Reference</th><th>Title</th><th>Severity</th><th>Source</th><th>Department</th><th>Detected</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var n in Model)
                            {
                                <tr>
                                    <td><span class="docnum">@n.Reference</span></td>
                                    <td><a asp-action="Details" asp-route-id="@n.Id">@n.Title</a></td>
                                    <td><span class="badge-ims @sevClass(n.Severity)">@n.Severity</span></td>
                                    <td class="meta">@n.Source</td>
                                    <td class="meta">@(n.Department?.Name ?? "—")</td>
                                    <td class="meta">@n.DetectedDate.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge-ims @statusClass(n.Status)">@n.Status</span></td>
                                    <td>
                                        <div class="act-btns">
                                            <a class="act view" asp-action="Details" asp-route-id="@n.Id" title="Open"><i class="fas fa-eye"></i></a>
                                            @if (canEdit)
                                            {
                                                <a class="act edit" asp-action="Edit" asp-route-id="@n.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-bug"></i>
                        <h3>No non-conformances recorded</h3>
                        @if (canEdit)
                        {
                            <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Raise the first one</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
