@using IT_Service_Management_System.Models.Ims
@model List<IsoDocumentAcknowledgement>
@{
    var doc = ViewBag.Document as IsoDocument;
    ViewData["Title"] = "Acknowledgement Report";
    var total = Model.Count;
    var done = Model.Count(a => a.Status == AcknowledgementStatus.Acknowledged);
    var pct = total == 0 ? 0 : (int)Math.Round(done * 100.0 / total);
    var byDept = Model.GroupBy(a => a.User?.Department?.Name ?? "—")
        .Select(g => new { Dept = g.Key, Total = g.Count(), Done = g.Count(a => a.Status == AcknowledgementStatus.Acknowledged) })
        .OrderByDescending(g => g.Total).ToList();
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="btn-back" asp-action="Details" asp-route-id="@doc?.Id">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-chart-pie me-2" style="color: var(--primary);"></i>
                    Acknowledgement Report
                </h1>
                <p class="text-muted mt-2">
                    <span class="doc-number">@doc?.DocumentNumber</span> · @doc?.Title
                </p>
            </div>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-info">
                <h3>@total</h3>
                <p>Recipients</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fas fa-circle-check"></i>
            </div>
            <div class="stat-info">
                <h3>@done</h3>
                <p>Acknowledged</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="stat-info">
                <h3>@(total - done)</h3>
                <p>Pending</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon info">
                <i class="fas fa-percent"></i>
            </div>
            <div class="stat-info">
                <h3>@pct%</h3>
                <p>Completion</p>
            </div>
        </div>
    </div>

    <!-- BY DEPARTMENT -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-building me-2" style="color: var(--primary);"></i>
            <span>By Department</span>
        </div>
        <div class="card-body-custom">
            @foreach (var d in byDept)
            {
                var dpct = d.Total == 0 ? 0 : (int)Math.Round(d.Done * 100.0 / d.Total);
                <div class="department-progress">
                    <div class="department-progress-header">
                        <span class="department-name">@d.Dept</span>
                        <span class="department-stats">@d.Done / @d.Total (@dpct%)</span>
                    </div>
                    <div class="progress-bar-track">
                        <div class="progress-bar-fill success" style="width: @dpct%;"></div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ACKNOWLEDGEMENTS TABLE -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-list me-2"></i>
                <span>Acknowledgements</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count</span> records
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            <div class="table-responsive">
                <table class="tickets-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-user me-1"></i> Employee</th>
                            <th><i class="fas fa-building me-1"></i> Department</th>
                            <th><i class="fas fa-tag me-1"></i> Status</th>
                            <th><i class="fas fa-calendar me-1"></i> Signed</th>
                            <th><i class="fas fa-pen me-1"></i> Signature</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.OrderByDescending(x => x.AcknowledgedAt ?? x.AssignedAt))
                        {
                            var statusClass = a.Status == AcknowledgementStatus.Acknowledged ? "badge-success" :
                                             a.Status == AcknowledgementStatus.Opened ? "badge-warning" : "badge-gray";
                            <tr>
                                <td class="employee-name">@(a.User?.FullName ?? "—")</td>
                                <td class="meta-text">@(a.User?.Department?.Name ?? "—")</td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        @if (a.Status == AcknowledgementStatus.Acknowledged)
                                        {
                                            <i class="fas fa-check-circle"></i>
                                        }
                                        else if (a.Status == AcknowledgementStatus.Opened)
                                        {
                                            <i class="fas fa-eye"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-clock"></i>
                                        }
                                        @a.Status
                                    </span>
                                </td>
                                <td class="meta-text">@(a.AcknowledgedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                                <td class="meta-text">@(a.SignatureName ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    .doc-number {
        font-weight: 600;
        color: var(--primary);
        font-size: 0.95rem;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

        .stat-icon.primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
        }

        .stat-icon.success {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

        .stat-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .stat-icon.warning {
            background: linear-gradient(135deg, #f5b042, #e6a017);
        }

        .stat-icon.info {
            background: linear-gradient(135deg, #06b6d4, #0891b2);
        }

        .stat-icon.violet {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.25rem 1.5rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== DEPARTMENT PROGRESS ===== */
    .department-progress {
        margin-bottom: 0.75rem;
    }

        .department-progress:last-child {
            margin-bottom: 0;
        }

    .department-progress-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
        margin-bottom: 0.2rem;
    }

    .department-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    .department-stats {
        font-weight: 500;
        color: var(--gray-500);
    }

    .progress-bar-track {
        width: 100%;
        height: 8px;
        background: var(--gray-100);
        border-radius: 1rem;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 1rem;
        transition: width 0.6s ease;
        min-width: 4px;
    }

        .progress-bar-fill.success {
            background: linear-gradient(90deg, #6ee7b7, var(--success));
        }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 0.75rem 1.2rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.65rem 1.2rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== ACKNOWLEDGEMENT SPECIFIC ===== */
    .employee-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    .meta-text {
        color: var(--gray-500);
        font-size: 0.85rem;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .stats-cards {
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.5rem 0.8rem;
        }

        .tickets-table {
            font-size: 0.8rem;
        }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }

        .department-progress-header {
            font-size: 0.8rem;
        }

        .status-badge {
            font-size: 0.6rem;
            padding: 0.15rem 0.5rem;
        }

        .meta-text {
            font-size: 0.75rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.25rem;
        }

        .stats-cards {
            grid-template-columns: 1fr;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.4rem 0.5rem;
            font-size: 0.7rem;
        }

        .status-badge {
            font-size: 0.55rem;
            padding: 0.1rem 0.35rem;
        }

        .doc-number {
            font-size: 0.85rem;
        }

        .employee-name {
            font-size: 0.8rem;
        }

        .department-stats {
            font-size: 0.7rem;
        }

        .department-name {
            font-size: 0.75rem;
        }
    }
</style>
