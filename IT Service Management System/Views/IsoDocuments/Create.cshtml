@using IT_Service_Management_System.Models.Ims
@model IsoDocument
@{
    ViewData["Title"] = "New Document";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="btn-back" asp-action="Index" asp-route-type="@Model.Type">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-file-circle-plus me-2" style="color: var(--primary);"></i>
                    New Controlled Document
                </h1>
                <p class="text-muted mt-2">Create a draft — it enters the approval workflow once submitted.</p>
            </div>
        </div>
    </div>

    <!-- FORM -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-file-circle-plus me-2" style="color: var(--primary);"></i>
            <span>Document Details</span>
        </div>

        <div class="card-body-custom">
            <form method="post" asp-action="Create" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="alert-flash danger" style="display:block;margin-bottom:1.5rem;"></div>

                <!-- Form Fields -->
                <partial name="_Fields" model="Model" />

                <!-- File Upload -->
                <div class="form-group full-width" style="margin-top:0.5rem;">
                    <label class="form-label">
                        <i class="fas fa-paperclip"></i> Attach File (optional)
                    </label>
                    <div class="file-upload-wrapper">
                        <input type="file" name="file" id="fileInput" class="file-input" />
                        <label for="fileInput" class="file-upload-label">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <span>Choose a file</span>
                            <span class="file-hint">PDF, Office, text or image up to 25 MB. Becomes version 0.1.</span>
                        </label>
                        <span id="fileNameDisplay" class="file-name-display"></span>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="form-actions">
                    <button type="submit" class="btn-create-ticket">
                        <i class="fas fa-save"></i>
                        Create Draft
                    </button>
                    <a asp-action="Index" asp-route-type="@Model.Type" class="btn-cancel">
                        <i class="fas fa-times"></i>
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const fileInput = document.getElementById('fileInput');
        const fileNameDisplay = document.getElementById('fileNameDisplay');

        if (fileInput) {
            fileInput.addEventListener('change', function() {
                if (this.files.length > 0) {
                    fileNameDisplay.textContent = this.files[0].name;
                    fileNameDisplay.style.display = 'inline-block';
                } else {
                    fileNameDisplay.textContent = '';
                    fileNameDisplay.style.display = 'none';
                }
            });
        }
    });
</script>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

        .alert-flash.danger {
            background: #fef2f2;
            border-color: #fecaca;
            color: #b91c1c;
        }

            .alert-flash.danger:empty {
                display: none;
            }

        .alert-flash i {
            font-size: 1.1rem;
        }

    /* ===== FORM ACTIONS ===== */
    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--gray-200);
        flex-wrap: wrap;
    }

    /* ===== PRIMARY BUTTON ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
        flex: 1;
        justify-content: center;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== CANCEL BUTTON ===== */
    .btn-cancel {
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--gray-600);
        background: white;
        border: 1.5px solid var(--gray-200);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
        font-family: inherit;
        flex: 1;
    }

        .btn-cancel:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
            color: var(--gray-700);
            text-decoration: none;
        }

    /* ===== FILE UPLOAD ===== */
    .file-upload-wrapper {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .file-input {
        position: absolute;
        opacity: 0;
        width: 0.1px;
        height: 0.1px;
        pointer-events: none;
    }

    .file-upload-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.5rem 1rem;
        border: 2px dashed var(--gray-200);
        border-radius: 0.6rem;
        background: var(--gray-50);
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
    }

        .file-upload-label:hover {
            border-color: var(--primary);
            background: var(--gray-50);
        }

        .file-upload-label i {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 0.5rem;
        }

        .file-upload-label span {
            font-size: 0.875rem;
            color: var(--gray-600);
        }

        .file-upload-label .file-hint {
            font-size: 0.7rem;
            color: var(--gray-400);
            margin-top: 0.25rem;
        }

    .file-name-display {
        display: none;
        padding: 0.4rem 0.75rem;
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
        border-radius: 0.5rem;
        font-size: 0.85rem;
        font-weight: 500;
        word-break: break-all;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .card-body-custom {
            padding: 1.5rem;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions .btn-create-ticket,
            .form-actions .btn-cancel {
                flex: none;
                width: 100%;
                padding: 0.65rem 1.5rem;
            }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }

        .file-upload-label {
            padding: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.25rem;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .btn-create-ticket,
        .btn-cancel {
            font-size: 0.8rem;
            padding: 0.55rem 1.25rem;
        }

        .file-upload-label i {
            font-size: 1.5rem;
        }

        .file-upload-label span {
            font-size: 0.8rem;
        }

        .file-name-display {
            font-size: 0.75rem;
        }
    }
</style>
