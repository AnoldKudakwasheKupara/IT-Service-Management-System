@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@using IT_Service_Management_System.Services.Ims
@model IsoDocument
@{
    ViewData["Title"] = Model.DocumentNumber;
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var canApprove = (bool)(ViewBag.CanApprove ?? false);
    int ackTotal = ViewBag.AckTotal ?? 0;
    int ackDone = ViewBag.AckDone ?? 0;
    int ackPct = ackTotal == 0 ? 0 : (int)Math.Round(ackDone * 100.0 / ackTotal);
    var departments = ViewBag.Departments as List<Department> ?? new();
    var users = ViewBag.Users as List<User> ?? new();

    var steps = new[] { "Draft", "Department Review", "Quality Review", "Management Approval", "Published", "Archived" };
    int current = Model.Status switch
    {
        DocumentStatus.Draft or DocumentStatus.Rejected or DocumentStatus.Revision => 0,
        DocumentStatus.DepartmentReview => 1,
        DocumentStatus.QualityReview => 2,
        DocumentStatus.ManagementApproval => 3,
        DocumentStatus.Published or DocumentStatus.UnderReview => 4,
        _ => 5
    };
    var pendingStage = IsoDocumentService.StageForCurrent(Model);
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a class="btn-back" asp-action="Index" asp-route-type="@Model.Type">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <span class="doc-number" style="font-size:1rem;font-weight:600;color:var(--primary);">@Model.DocumentNumber</span>
                        <span style="font-weight:700;color:var(--gray-800);">@Model.Title</span>
                    </h1>
                    <div class="page-subtitle">
                        <span class="status-badge @ImsBadges.DocStatusClass(Model.Status)">@ImsBadges.DocStatusLabel(Model.Status)</span>
                        <span class="status-badge @ImsBadges.ClassificationClass(Model.Classification)">@Model.Classification</span>
                        <span class="meta-separator">·</span>
                        <span class="meta-text">@Model.Type · v@Model.CurrentVersion</span>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (Model.CurrentVersionId != null)
                {
                    <a class="btn-create-ticket" asp-action="Download" asp-route-versionId="@Model.CurrentVersionId" style="background:var(--gray-100);color:var(--gray-700);">
                        <i class="fas fa-download"></i> Current File
                    </a>
                }
                @if (canManage && Model.Status != DocumentStatus.Archived)
                {
                    <a class="btn-create-ticket" asp-action="Edit" asp-route-id="@Model.Id" style="background:var(--gray-100);color:var(--gray-700);">
                        <i class="fas fa-pen"></i> Edit
                    </a>
                }
                <a class="btn-create-ticket" asp-action="AckReport" asp-route-id="@Model.Id" style="background:var(--gray-100);color:var(--gray-700);">
                    <i class="fas fa-chart-pie"></i> Ack Report
                </a>
                <a class="btn-create-ticket" asp-controller="Ecie" asp-action="Graph" asp-route-id="@Model.Id" style="background:var(--gray-100);color:var(--gray-700);">
                    <i class="fas fa-diagram-project"></i> Evidence Map
                </a>
            </div>
        </div>
    </div>

    <!-- WORKFLOW STEPPER -->
    <div class="data-card">
        <div class="card-body-custom">
            <div class="workflow-stepper">
                @for (int i = 0; i < steps.Length; i++)
                {
                    var cls = i < current ? "completed" : (i == current ? "active" : "");
                    <div class="step @cls">
                        <span class="step-number">
                            <i class="fas @(i < current ? "fa-check" : "fa-circle")"></i>
                        </span>
                        <span class="step-label">@steps[i]</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- WORKFLOW ACTIONS -->
    @if (canManage || canApprove)
    {
        <div class="data-card">
            <div class="card-header-custom" style="border-left:4px solid var(--primary);">
                <i class="fas fa-bolt me-2" style="color:var(--primary);"></i>
                <span>Workflow Actions</span>
            </div>
            <div class="card-body-custom">
                <div class="workflow-actions-row">
                    @if (canManage && Model.Status is DocumentStatus.Draft or DocumentStatus.Revision or DocumentStatus.Rejected)
                    {
                        <form method="post" asp-action="Submit" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button class="btn-primary" type="submit">
                                <i class="fas fa-paper-plane"></i> Submit for Review
                            </button>
                        </form>
                    }
                    @if (Model.Status == DocumentStatus.Published)
                    {
                        <form method="post" asp-action="Revise" asp-route-id="@Model.Id">
                            @Html.AntiForgeryToken()
                            <button class="btn-outline" type="submit">
                                <i class="fas fa-code-branch"></i> Open for Revision
                            </button>
                        </form>
                        <form method="post" asp-action="Archive" asp-route-id="@Model.Id" onsubmit="return confirm('Archive this document?');">
                            @Html.AntiForgeryToken()
                            <button class="btn-danger" type="submit">
                                <i class="fas fa-box-archive"></i> Archive
                            </button>
                        </form>
                    }
                </div>

                @if (pendingStage != null && canApprove)
                {
                    <form method="post" asp-action="Decision" asp-route-id="@Model.Id" class="decision-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="stage" value="@pendingStage" />
                        <div class="form-group">
                            <label class="form-label-sm">
                                <i class="fas fa-gavel"></i> @ImsBadges.DocStatusLabel(Model.Status) — record decision
                            </label>
                            <textarea class="form-control" name="comments" rows="2" placeholder="Reviewer comments (optional)"></textarea>
                        </div>
                        <div class="decision-buttons">
                            <button class="btn-success" type="submit" name="decision" value="Approved">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button class="btn-outline" type="submit" name="decision" value="ReturnedForChanges">
                                <i class="fas fa-rotate-left"></i> Return for Changes
                            </button>
                            <button class="btn-danger" type="submit" name="decision" value="Rejected">
                                <i class="fas fa-xmark"></i> Reject
                            </button>
                        </div>
                        <span class="decision-hint">
                            <i class="fas fa-info-circle"></i>
                            Approving the Management Approval stage publishes the document and distributes it for acknowledgement.
                        </span>
                    </form>
                }
            </div>
        </div>
    }

    <!-- TWO COLUMN GRID: Metadata & Acknowledgement -->
    <div class="two-col-grid">
        <!-- METADATA CARD -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-circle-info me-2" style="color:var(--primary);"></i>
                <span>Details</span>
            </div>
            <div class="card-body-custom">
                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Category</div>
                        <div class="detail-value">@(Model.Category?.Name ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Department</div>
                        <div class="detail-value">@(Model.Department?.Name ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Owner</div>
                        <div class="detail-value">@(Model.Owner?.FullName ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Approver</div>
                        <div class="detail-value">@(Model.Approver?.FullName ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">ISO Standard</div>
                        <div class="detail-value">@IsoStandards.Label(Model.Standard)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">ISO Clause</div>
                        <div class="detail-value">@(Model.IsoClause ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Issue Date</div>
                        <div class="detail-value">@(Model.IssueDate?.ToString("dd MMM yyyy") ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Effective Date</div>
                        <div class="detail-value">@(Model.EffectiveDate?.ToString("dd MMM yyyy") ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Review Frequency</div>
                        <div class="detail-value">@Model.ReviewFrequency</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Next Review</div>
                        <div class="detail-value @(Model.IsReviewDue ? "text-danger" : "")">
                            @(Model.ReviewDate?.ToString("dd MMM yyyy") ?? "—")
                            @if (Model.IsReviewDue)
                            {
                                <span class="status-badge badge-overdue" style="margin-left:0.5rem;">
                                    <i class="fas fa-exclamation-circle"></i> Due
                                </span>
                            }
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Expiry</div>
                        <div class="detail-value @(Model.IsExpired ? "text-danger" : "")">
                            @(Model.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")
                            @if (Model.IsExpired)
                            {
                                <span class="status-badge badge-overdue" style="margin-left:0.5rem;">
                                    <i class="fas fa-exclamation-circle"></i> Expired
                                </span>
                            }
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Created</div>
                        <div class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Summary))
                {
                    <div class="description-section">
                        <div class="detail-label">Summary</div>
                        <div class="description-text">@Model.Summary</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Keywords))
                {
                    <div class="keywords-section">
                        <i class="fas fa-tags" style="color:var(--gray-400);font-size:0.7rem;"></i>
                        <span class="keywords-text">@Model.Keywords</span>
                    </div>
                }
            </div>
        </div>

        <!-- ACKNOWLEDGEMENT CARD -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-user-check me-2" style="color:var(--primary);"></i>
                <span>Acknowledgement</span>
            </div>
            <div class="card-body-custom">
                <div class="acknowledgement-stats">
                    <span class="ack-label">Completion</span>
                    <strong class="ack-percentage">@ackPct%</strong>
                </div>
                <div class="progress-bar-track">
                    <div class="progress-bar-fill success" style="width: @ackPct%;"></div>
                </div>
                <div class="ack-hint">
                    @ackDone of @ackTotal acknowledged · @(ackTotal - ackDone) pending
                </div>

                @if (canManage)
                {
                    <form method="post" asp-action="AddDistribution" asp-route-id="@Model.Id" class="distribution-form">
                        @Html.AntiForgeryToken()
                        <div class="distribution-form-header">
                            <label class="form-label-sm">
                                <i class="fas fa-share-nodes"></i> Add distribution target
                            </label>
                        </div>
                        <div class="distribution-form-row">
                            <select class="form-control" name="targetType" style="width:auto;flex-shrink:0;" onchange="imsDistToggle(this.value)">
                                <option value="AllStaff">All Staff</option>
                                <option value="Department">Department</option>
                                <option value="Role">Role</option>
                                <option value="User">User</option>
                            </select>
                            <select class="form-control" name="departmentId" id="dist-dept" style="width:auto;display:none;">
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            </select>
                            <select class="form-control" name="userId" id="dist-user" style="width:auto;display:none;">
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </select>
                            <input class="form-control" name="roleName" id="dist-role" style="width:auto;display:none;" placeholder="Role e.g. Employee" />
                            <button class="btn-add-distribution" type="submit">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </form>

                    @if (Model.Distributions.Any())
                    {
                        <div class="distribution-list">
                            @foreach (var dist in Model.Distributions)
                            {
                                var label = dist.TargetType switch
                                {
                                    DistributionTargetType.AllStaff => "All Staff",
                                    DistributionTargetType.Department => "Dept: " + (dist.Department?.Name ?? "?"),
                                    DistributionTargetType.Role => "Role: " + dist.RoleName,
                                    _ => "User: " + (dist.User?.FullName ?? "?")
                                };
                                <div class="distribution-item">
                                    <span class="status-badge badge-internal">@label</span>
                                    <form method="post" asp-action="RemoveDistribution" asp-route-id="@Model.Id">
                                        <input type="hidden" name="distributionId" value="@dist.Id" />
                                        @Html.AntiForgeryToken()
                                        <button class="btn-remove-distribution" type="submit">
                                            <i class="fas fa-xmark"></i>
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- VERSION HISTORY -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-code-branch me-2" style="color:var(--primary);"></i>
            <span>Version History</span>
        </div>
        <div class="card-body-custom" style="padding:0;">
            <div class="table-responsive">
                <table class="tickets-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-code-branch me-1"></i> Version</th>
                            <th><i class="fas fa-sticky-note me-1"></i> Notes</th>
                            <th><i class="fas fa-user me-1"></i> By</th>
                            <th><i class="fas fa-calendar me-1"></i> When</th>
                            <th><i class="fas fa-tag me-1"></i> Status</th>
                            <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Versions.OrderByDescending(v => v.Id))
                        {
                            <tr>
                                <td>
                                    <span class="version-number">v@v.VersionNumber</span>
                                    @if (v.IsCurrent)
                                    {
                                        <span class="status-badge badge-current">Current</span>
                                    }
                                </td>
                                <td class="version-notes">@(v.RevisionNotes ?? "—")</td>
                                <td class="meta-text">@(v.CreatedBy?.FullName ?? "—")</td>
                                <td class="meta-text">@v.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <span class="status-badge @ImsBadges.DocStatusClass(v.Status)">@ImsBadges.DocStatusLabel(v.Status)</span>
                                </td>
                                <td style="text-align:right;">
                                    <div class="action-buttons">
                                        @if (v.HasFile)
                                        {
                                            <a class="action-btn btn-view" asp-action="Download" asp-route-versionId="@v.Id" title="Download">
                                                <i class="fas fa-download"></i>
                                            </a>
                                        }
                                        @if (canManage && !v.IsCurrent)
                                        {
                                            <form method="post" asp-action="RestoreVersion" asp-route-id="@Model.Id" onsubmit="return confirm('Restore this version?');" style="display:inline;">
                                                <input type="hidden" name="versionId" value="@v.Id" />
                                                @Html.AntiForgeryToken()
                                                <button class="action-btn btn-restore" title="Restore" type="submit">
                                                    <i class="fas fa-clock-rotate-left"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (canManage && Model.Status != DocumentStatus.Archived)
            {
                <form method="post" asp-action="AddVersion" asp-route-id="@Model.Id" enctype="multipart/form-data" class="add-version-form">
                    @Html.AntiForgeryToken()
                    <div class="add-version-row">
                        <input class="form-control" type="file" name="file" style="width:auto;flex-shrink:0;" />
                        <input class="form-control" type="text" name="notes" placeholder="Revision notes" style="flex:1;min-width:200px;" />
                        <label class="version-major-check">
                            <input type="checkbox" name="major" value="true" /> Major version
                        </label>
                        <button class="btn-add-version" type="submit">
                            <i class="fas fa-plus"></i> Add Version
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <!-- TWO COLUMN GRID: Approval History & Reviews -->
    <div class="two-col-grid">
        <!-- APPROVAL HISTORY -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-stamp me-2" style="color:var(--primary);"></i>
                <span>Approval History</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.Approvals.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-layer-group me-1"></i> Stage</th>
                                    <th><i class="fas fa-gavel me-1"></i> Decision</th>
                                    <th><i class="fas fa-user me-1"></i> By</th>
                                    <th><i class="fas fa-calendar me-1"></i> When</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Approvals.OrderBy(a => a.Sequence).ThenBy(a => a.Id))
                                {
                                    var decisionClass = a.Decision == ApprovalDecision.Approved ? "badge-success" :
                                                       a.Decision == ApprovalDecision.Pending ? "badge-gray" : "badge-critical";
                                    <tr>
                                        <td class="approval-stage">@a.Stage</td>
                                        <td>
                                            <span class="status-badge @decisionClass">@a.Decision</span>
                                        </td>
                                        <td class="meta-text">@(a.Approver?.FullName ?? "—")</td>
                                        <td class="meta-text">@(a.DecisionAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-stamp"></i>
                        <span>Not yet in workflow</span>
                    </div>
                }
            </div>
        </div>

        <!-- REVIEWS -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-calendar-check me-2" style="color:var(--primary);"></i>
                <span>Reviews</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.Reviews.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-calendar me-1"></i> Scheduled</th>
                                    <th><i class="fas fa-flag me-1"></i> Outcome</th>
                                    <th><i class="fas fa-user me-1"></i> By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Reviews.OrderByDescending(r => r.ScheduledDate))
                                {
                                    <tr>
                                        <td class="@(r.IsOverdue ? "date-overdue" : "meta-text")">
                                            @r.ScheduledDate.ToString("dd MMM yyyy")
                                            @if (r.IsOverdue)
                                            {
                                                <span class="overdue-badge"><i class="fas fa-exclamation-circle"></i></span>
                                            }
                                        </td>
                                        <td class="meta-text">@r.Outcome</td>
                                        <td class="meta-text">@(r.Reviewer?.FullName ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-calendar"></i>
                        <span>No reviews</span>
                    </div>
                }

                @if (canManage)
                {
                    <form method="post" asp-action="ScheduleReview" asp-route-id="@Model.Id" class="schedule-review-form">
                        @Html.AntiForgeryToken()
                        <div class="schedule-review-row">
                            <input class="form-control" type="date" name="scheduledDate" required style="width:auto;flex-shrink:0;" />
                            <button class="btn-schedule-review" type="submit">
                                <i class="fas fa-calendar-plus"></i> Schedule Review
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function imsDistToggle(v) {
        document.getElementById('dist-dept').style.display = v === 'Department' ? '' : 'none';
        document.getElementById('dist-user').style.display = v === 'User' ? '' : 'none';
        document.getElementById('dist-role').style.display = v === 'Role' ? '' : 'none';
    }
</script>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .doc-number {
        font-weight: 600;
        color: var(--primary);
        font-size: 1rem;
    }

    .page-subtitle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    .meta-separator {
        color: var(--gray-300);
    }

    .meta-text {
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

