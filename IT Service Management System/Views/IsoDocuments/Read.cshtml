@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model IsoDocument
@{
    ViewData["Title"] = "Read & Acknowledge";
    var ack = ViewBag.Ack as IsoDocumentAcknowledgement;
    var done = ack != null && ack.Status == AcknowledgementStatus.Acknowledged;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="btn-back" asp-action="MyDocuments">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-book-open me-2" style="color: var(--primary);"></i>
                    @Model.Title
                </h1>
                <p class="text-muted mt-2">
                    <span class="doc-number">@Model.DocumentNumber</span> · v@Model.CurrentVersion ·
                    <span class="status-badge @ImsBadges.ClassificationClass(Model.Classification)">@Model.Classification</span>
                </p>
            </div>
        </div>
    </div>

    <!-- DOCUMENT CARD -->
    <div class="data-card">
        <div class="card-body-custom">
            @if (!string.IsNullOrWhiteSpace(Model.Summary))
            {
                <p class="document-summary">@Model.Summary</p>
            }

            @if (Model.CurrentVersionId != null)
            {
                <a class="btn-download-doc" asp-action="Download" asp-route-versionId="@Model.CurrentVersionId">
                    <i class="fas fa-download"></i> Open / Download the document
                </a>
            }
            else
            {
                <p class="no-file-message">No file is attached to this document.</p>
            }
        </div>
    </div>

    <!-- ACKNOWLEDGEMENT STATUS / FORM -->
    @if (done)
    {
        <div class="data-card">
            <div class="card-body-custom" style="text-align:center;">
                <i class="fas fa-circle-check" style="font-size:3rem;color:var(--success);"></i>
                <h3 style="margin:0.5rem 0;color:var(--gray-800);">You acknowledged this document</h3>
                <p class="ack-details">
                    Signed by <strong>@ack!.SignatureName</strong> on @ack.AcknowledgedAt?.ToString("dd MMM yyyy HH:mm")
                </p>
            </div>
        </div>
    }
    else if (ack != null)
    {
        <div class="data-card">
            <div class="card-header-custom" style="border-left:4px solid var(--primary);">
                <i class="fas fa-signature me-2" style="color:var(--primary);"></i>
                <span>Acknowledgement &amp; Electronic Signature</span>
            </div>
            <div class="card-body-custom">
                <form method="post" asp-action="Acknowledge" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()

                    <div class="acknowledgement-checkbox">
                        <input type="checkbox" name="accept" value="true" required id="acceptCheck" />
                        <label for="acceptCheck">
                            I confirm that I have read, understood and will comply with this document.
                        </label>
                    </div>

                    <div class="form-group signature-group">
                        <label class="form-label" for="signatureName">
                            <i class="fas fa-pen-nib"></i> Type your full name as your electronic signature <span class="required">*</span>
                        </label>
                        <input class="form-control" name="signatureName" id="signatureName" required placeholder="Full name" />
                    </div>

                    <div class="form-actions">
                        <button class="btn-create-ticket" type="submit">
                            <i class="fas fa-check"></i> Acknowledge &amp; Sign
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="data-card">
            <div class="card-body-custom">
                <p class="not-assigned-message">This document is not assigned to you for acknowledgement.</p>
            </div>
        </div>
    }
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    .doc-number {
        font-weight: 600;
        color: var(--primary);
        font-size: 0.95rem;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-critical {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    .badge-primary {
        background: #e6f0ff;
        color: var(--info);
        border: 1px solid #cce4ff;
    }

    /* ===== DOCUMENT SUMMARY ===== */
    .document-summary {
        color: var(--gray-700);
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0 0 1rem 0;
    }

    /* ===== DOWNLOAD BUTTON ===== */
    .btn-download-doc {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.5rem;
        background: var(--gray-100);
        color: var(--gray-700);
        border: 1.5px solid var(--gray-200);
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        transition: all 0.2s;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-download-doc:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
            color: var(--gray-700);
            text-decoration: none;
        }

    .no-file-message {
        color: var(--gray-500);
        font-style: italic;
        margin: 0;
    }

    /* ===== ACKNOWLEDGEMENT CHECKBOX ===== */
    .acknowledgement-checkbox {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

        .acknowledgement-checkbox input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--primary);
            margin-top: 0.1rem;
            cursor: pointer;
            flex-shrink: 0;
        }

        .acknowledgement-checkbox label {
            font-size: 0.95rem;
            color: var(--gray-700);
            cursor: pointer;
            line-height: 1.4;
        }

    /* ===== SIGNATURE GROUP ===== */
    .signature-group {
        margin-top: 1rem;
    }

    .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--gray-600);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 0.3rem;
    }

        .form-label .required {
            color: var(--danger);
            font-weight: 700;
            margin-left: 0.15rem;
        }

        .form-label i {
            font-size: 0.7rem;
            color: var(--gray-400);
            width: 16px;
            text-align: center;
        }

    .form-control {
        padding: 0.55rem 0.75rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.6rem;
        font-size: 0.875rem;
        font-weight: 400;
        font-family: inherit;
        background: white;
        transition: all 0.2s ease;
        width: 100%;
        color: var(--gray-800);
    }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .form-control::placeholder {
            color: var(--gray-400);
            font-size: 0.8rem;
        }

    /* ===== FORM ACTIONS ===== */
    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--gray-200);
        flex-wrap: wrap;
    }

    /* ===== PRIMARY BUTTON ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== ACK DETAILS ===== */
    .ack-details {
        font-size: 0.9rem;
        color: var(--gray-500);
        margin: 0;
    }

        .ack-details strong {
            color: var(--gray-700);
        }

    .not-assigned-message {
        color: var(--gray-500);
        font-style: italic;
        margin: 0;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }

        .btn-create-ticket,
        .btn-download-doc {
            width: 100%;
            justify-content: center;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions .btn-create-ticket {
                flex: none;
                width: 100%;
                padding: 0.65rem 1.5rem;
            }

        .acknowledgement-checkbox label {
            font-size: 0.85rem;
        }

        .document-summary {
            font-size: 0.85rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.1rem;
        }

        .doc-number {
            font-size: 0.85rem;
        }

        .btn-create-ticket {
            font-size: 0.8rem;
            padding: 0.55rem 1.25rem;
        }

        .btn-download-doc {
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
        }

        .form-control {
            font-size: 0.8rem;
            padding: 0.5rem 0.65rem;
        }

        .form-label {
            font-size: 0.7rem;
        }

        .ack-details {
            font-size: 0.8rem;
        }
    }
</style>
