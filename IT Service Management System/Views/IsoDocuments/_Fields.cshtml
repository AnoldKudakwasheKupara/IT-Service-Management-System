@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model IsoDocument
@{
    var categories = ViewBag.Categories as List<IsoDocumentCategory> ?? new();
    var departments = ViewBag.Departments as List<Department> ?? new();
    var users = ViewBag.Users as List<User> ?? new();
    var clauses = ViewBag.Clauses as List<IsoClause> ?? new();
}
<div class="form-grid">
    <div class="fg">
        <label class="lbl"><i class="fas fa-hashtag"></i> Document Number</label>
        <input class="inp" asp-for="DocumentNumber" placeholder="Auto-generated if left blank" />
        <span class="hint">Leave blank to auto-number (e.g. QMS-POL-0001).</span>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
        <input class="inp" asp-for="Title" required />
        <span asp-validation-for="Title" class="hint" style="color:var(--danger)"></span>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-layer-group"></i> Type</label>
        <select class="inp" asp-for="Type" asp-items="Html.GetEnumSelectList<DocumentType>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-folder"></i> Category</label>
        <select class="inp" asp-for="CategoryId">
            <option value="">— None —</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name (@c.Code)</option>
            }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-building"></i> Department</label>
        <select class="inp" asp-for="DepartmentId">
            <option value="">— None —</option>
            @foreach (var d in departments)
            {
                <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
            }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-user-tie"></i> Owner</label>
        <select class="inp" asp-for="OwnerId">
            <option value="">— None —</option>
            @foreach (var u in users)
            {
                <option value="@u.Id" selected="@(Model.OwnerId == u.Id)">@u.FullName</option>
            }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-user-check"></i> Approver</label>
        <select class="inp" asp-for="ApproverId">
            <option value="">— None —</option>
            @foreach (var u in users)
            {
                <option value="@u.Id" selected="@(Model.ApproverId == u.Id)">@u.FullName</option>
            }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
        <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-list-ol"></i> ISO Clause</label>
        <input class="inp" asp-for="IsoClause" list="clauseList" placeholder="e.g. 7.5" />
        <datalist id="clauseList">
            @foreach (var c in clauses)
            {
                <option value="@c.ClauseNumber">@c.Display</option>
            }
        </datalist>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-shield-halved"></i> Classification</label>
        <select class="inp" asp-for="Classification" asp-items="Html.GetEnumSelectList<DocumentClassification>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-repeat"></i> Review Frequency</label>
        <select class="inp" asp-for="ReviewFrequency" asp-items="Html.GetEnumSelectList<ReviewFrequency>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-plus"></i> Issue Date</label>
        <input class="inp" type="date" asp-for="IssueDate" />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-check"></i> Effective Date</label>
        <input class="inp" type="date" asp-for="EffectiveDate" />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-day"></i> Next Review Date</label>
        <input class="inp" type="date" asp-for="ReviewDate" />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-xmark"></i> Expiry Date</label>
        <input class="inp" type="date" asp-for="ExpiryDate" />
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-tags"></i> Keywords</label>
        <input class="inp" asp-for="Keywords" placeholder="Comma-separated keywords for search" />
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-align-left"></i> Summary</label>
        <textarea class="inp" asp-for="Summary" rows="3" placeholder="Purpose and scope of this document"></textarea>
    </div>
</div>
