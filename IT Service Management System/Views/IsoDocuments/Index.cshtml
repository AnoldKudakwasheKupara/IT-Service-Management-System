@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<IsoDocument>
@{
    var type = ViewBag.Type as DocumentType?;
    var title = type switch
    {
        DocumentType.Policy => "Policies",
        DocumentType.Procedure => "Procedures",
        DocumentType.WorkInstruction => "Work Instructions",
        DocumentType.Form => "Forms",
        DocumentType.Record => "Records",
        _ => "Document Control"
    };
    ViewData["Title"] = title;
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
    var categories = ViewBag.Categories as List<IsoDocumentCategory> ?? new();
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-file-shield"></i> @title</h1>
                    <p class="page-sub">Controlled documents — ISO 9001/27001 clause 7.5</p>
                </div>
                <div class="head-actions">
                    @if (canEdit)
                    {
                        <a class="btn-primary-ims" asp-action="Create" asp-route-type="@type"><i class="fas fa-plus"></i> New Document</a>
                    }
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-file-lines"></i></div><div><h3>@ViewBag.Total</h3><p>Total</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.Published</h3><p>Published</p></div></div>
            <div class="stat"><div class="ic amber"><i class="fas fa-pen-ruler"></i></div><div><h3>@ViewBag.InWorkflow</h3><p>In Workflow</p></div></div>
            <div class="stat"><div class="ic red"><i class="fas fa-clock-rotate-left"></i></div><div><h3>@ViewBag.DueReview</h3><p>Due for Review</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <input type="hidden" name="type" value="@type" />
            <input class="inp" type="text" name="q" value="@ViewBag.Query" placeholder="Search title, number, keywords…" />
            <select class="inp" name="status" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (DocumentStatus s in Enum.GetValues(typeof(DocumentStatus)))
                {
                    <option value="@s" selected="@(ViewBag.Status as DocumentStatus? == s)">@ImsBadges.DocStatusLabel(s)</option>
                }
            </select>
            <select class="inp" name="categoryId" onchange="this.form.submit()">
                <option value="">All categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id" selected="@(ViewBag.CategoryId as int? == c.Id)">@c.Name</option>
                }
            </select>
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-magnifying-glass"></i> Filter</button>
        </form>

        <div class="card">
            <div class="card-body" style="padding:0;">
                @if (Model.Any())
                {
                    <table class="tbl">
                        <thead>
                            <tr><th>Document No.</th><th>Title</th><th>Type</th><th>Category</th><th>Ver</th><th>Status</th><th>Class.</th><th>Review</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model)
                            {
                                <tr>
                                    <td><span class="docnum">@d.DocumentNumber</span></td>
                                    <td><a asp-action="Details" asp-route-id="@d.Id">@d.Title</a></td>
                                    <td class="meta">@d.Type</td>
                                    <td class="meta">@(d.Category?.Name ?? "—")</td>
                                    <td class="meta">v@d.CurrentVersion</td>
                                    <td><span class="badge-ims @ImsBadges.DocStatusClass(d.Status)">@ImsBadges.DocStatusLabel(d.Status)</span></td>
                                    <td><span class="badge-ims @ImsBadges.ClassificationClass(d.Classification)">@d.Classification</span></td>
                                    <td class="@(d.IsReviewDue ? "overdue" : "meta")">@(d.ReviewDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>
                                        <div class="act-btns">
                                            <a class="act view" asp-action="Details" asp-route-id="@d.Id" title="Open"><i class="fas fa-eye"></i></a>
                                            @if (canEdit)
                                            {
                                                <a class="act edit" asp-action="Edit" asp-route-id="@d.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-folder-open"></i>
                        <h3>No documents found</h3>
                        @if (canEdit)
                        {
                            <a class="btn-primary-ims" asp-action="Create" asp-route-type="@type"><i class="fas fa-plus"></i> Create the first one</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
