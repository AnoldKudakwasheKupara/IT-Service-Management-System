@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<Objective>
@{
    ViewData["Title"] = "Objectives & KPIs";
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
    var departments = ViewBag.Departments as List<Department> ?? new();

    Func<ObjectiveStatus, string> statusClass = s => s switch
    {
        ObjectiveStatus.Achieved or ObjectiveStatus.OnTrack => "b-published",
        ObjectiveStatus.AtRisk or ObjectiveStatus.NotAchieved => "b-critical",
        ObjectiveStatus.Active => "b-medium",
        _ => "b-draft"
    };
    Func<ObjectiveStatus, string> barClass = s => s switch
    {
        ObjectiveStatus.AtRisk or ObjectiveStatus.NotAchieved => "amber",
        _ => "green"
    };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-bullseye"></i> Objectives &amp; KPIs</h1>
                    <p class="page-sub">Measurable quality &amp; security objectives — ISO 9001/27001 clause 6.2</p>
                </div>
                <div class="head-actions">
                    @if (canEdit)
                    {
                        <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> New Objective</a>
                    }
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-bullseye"></i></div><div><h3>@ViewBag.Total</h3><p>Total</p></div></div>
            <div class="stat"><div class="ic teal"><i class="fas fa-play"></i></div><div><h3>@ViewBag.Active</h3><p>Active</p></div></div>
            <div class="stat"><div class="ic red"><i class="fas fa-triangle-exclamation"></i></div><div><h3>@ViewBag.AtRisk</h3><p>At Risk</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.Achieved</h3><p>Achieved</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <input class="inp" type="text" name="q" value="@ViewBag.Query" placeholder="Search objectives…" />
            <select class="inp" name="status" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (ObjectiveStatus s in Enum.GetValues(typeof(ObjectiveStatus)))
                {
                    <option value="@s" selected="@(ViewBag.Status as ObjectiveStatus? == s)">@s</option>
                }
            </select>
            <select class="inp" name="departmentId" onchange="this.form.submit()">
                <option value="">All departments</option>
                @foreach (var d in departments)
                {
                    <option value="@d.Id" selected="@(ViewBag.DepartmentId as int? == d.Id)">@d.Name</option>
                }
            </select>
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-magnifying-glass"></i> Filter</button>
        </form>

        <div class="card">
            <div class="card-body" style="padding:0;">
                @if (Model.Any())
                {
                    <table class="tbl">
                        <thead>
                            <tr><th>Ref</th><th>Objective</th><th>Owner</th><th>Target</th><th>Current</th><th style="min-width:160px;">Progress</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                var pct = o.ProgressPercent ?? 0;
                                <tr>
                                    <td><span class="docnum">@o.Reference</span></td>
                                    <td><a asp-action="Details" asp-route-id="@o.Id">@o.Title</a><div class="meta">@(o.Department?.Name ?? "—")</div></td>
                                    <td class="meta">@(o.Owner?.FullName ?? "—")</td>
                                    <td class="meta">@(o.TargetValue?.ToString("0.##") ?? "—") @o.Unit</td>
                                    <td class="meta">@(o.CurrentValue?.ToString("0.##") ?? "—") @o.Unit</td>
                                    <td>
                                        <div class="progress-ims @barClass(o.Status)"><span style="width:@pct%"></span></div>
                                        <div class="meta" style="margin-top:.2rem;">@pct%</div>
                                    </td>
                                    <td><span class="badge-ims @statusClass(o.Status)">@o.Status</span></td>
                                    <td>
                                        <div class="act-btns">
                                            <a class="act view" asp-action="Details" asp-route-id="@o.Id" title="Open"><i class="fas fa-eye"></i></a>
                                            @if (canEdit)
                                            {
                                                <a class="act edit" asp-action="Edit" asp-route-id="@o.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-bullseye"></i>
                        <h3>No objectives found</h3>
                        @if (canEdit)
                        {
                            <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Create the first one</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
