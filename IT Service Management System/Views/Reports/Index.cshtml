@model IT_Service_Management_System.ViewModels.Reports.ReportsDashboardVM
@{
    ViewData["Title"] = "Reports - Axis IT Operations";
    string Money(decimal v) => v.ToString("C0", new System.Globalization.CultureInfo("en-US"));
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-chart-pie me-2" style="color: var(--primary);"></i>
                    Reports &amp; Analytics
                </h1>
                <p class="text-muted mt-2">
                    System-wide overview &middot; generated
                    @Model.GeneratedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                </p>
            </div>
            <button class="btn-create-ticket" onclick="window.print()" style="background: var(--gray-100); color: var(--gray-700);">
                <i class="fas fa-print"></i>
                Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalTickets</div>
                <div class="kpi-label">Total Tickets <span class="kpi-sub">(@Model.OpenTickets open)</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon violet">
                <i class="fas fa-laptop-code"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalAssets</div>
                <div class="kpi-label">Assets <span class="kpi-sub">(@Model.AssetsIssued issued)</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-box-open"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.AssetsInStock</div>
                <div class="kpi-label">Assets In Stock</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-tools"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.AssetsInRepair</div>
                <div class="kpi-label">Assets In Repair</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-coins"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalAssetValue)</div>
                <div class="kpi-label">Total Asset Value</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-users"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalUsers</div>
                <div class="kpi-label">Users <span class="kpi-sub">(@Model.ActiveUsers active)</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-clock"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalActivityHours h</div>
                <div class="kpi-label">Activity Logged <span class="kpi-sub">(@Model.TotalActivities)</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon danger">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalOutstanding)</div>
                <div class="kpi-label">Outstanding <span class="kpi-sub">(@Model.OverduePayments overdue)</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.CertsExpiringSoon</div>
                <div class="kpi-label">Certs Expiring ≤30d <span class="kpi-sub">(@Model.CertsExpired expired)</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-wrench"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.MaintenanceRecords</div>
                <div class="kpi-label">Maintenance Records</div>
            </div>
        </div>
    </div>

    <!-- DETAILED REPORTS SECTION -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <i class="fas fa-folder-open me-2"></i>
            <span>Detailed Reports</span>
        </div>
        <div class="card-body-custom">
            <div class="report-cards-grid">
                <!-- Tickets Report -->
                <a class="report-card-link" asp-action="Tickets">
                    <div class="report-card-item">
                        <div class="report-icon icon-ticket">
                            <i class="fas fa-ticket-alt"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Tickets Report</h3>
                            <p class="report-description">Status, priority, categories, top requesters &amp; resolution rate</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- SLA Compliance -->
                <a class="report-card-link" asp-action="SlaCompliance">
                    <div class="report-card-item">
                        <div class="report-icon icon-ticket">
                            <i class="fas fa-gauge-high"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">SLA Compliance</h3>
                            <p class="report-description">Response &amp; resolution attainment, MTTR, breaches by priority</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- Agent Performance -->
                <a class="report-card-link" asp-action="AgentPerformance">
                    <div class="report-card-item">
                        <div class="report-icon icon-user">
                            <i class="fas fa-user-gear"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Agent Performance</h3>
                            <p class="report-description">Per-agent workload, resolution time, SLA breaches &amp; CSAT</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- ITIL Overview -->
                <a class="report-card-link" asp-action="ItilOverview">
                    <div class="report-card-item">
                        <div class="report-icon icon-asset">
                            <i class="fas fa-sitemap"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">ITIL Overview</h3>
                            <p class="report-description">Problems, changes, change success rate &amp; CMDB health</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- Ticket Trends -->
                <a class="report-card-link" asp-action="TicketTrends">
                    <div class="report-card-item">
                        <div class="report-icon icon-activity">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Ticket Trends</h3>
                            <p class="report-description">Created vs resolved volume over the last 12 months</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- Assets Report -->
                <a class="report-card-link" asp-action="Assets">
                    <div class="report-card-item">
                        <div class="report-icon icon-asset">
                            <i class="fas fa-laptop-code"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Assets Report</h3>
                            <p class="report-description">Status, condition, value, holders &amp; recent activity</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- Users Report -->
                <a class="report-card-link" asp-action="Users">
                    <div class="report-card-item">
                        <div class="report-icon icon-user">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Users &amp; Departments</h3>
                            <p class="report-description">Roles, departments, active users &amp; asset assignments</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- Activity Report -->
                <a class="report-card-link" asp-action="Activity">
                    <div class="report-card-item">
                        <div class="report-icon icon-activity">
                            <i class="fas fa-tasks"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Activity Report</h3>
                            <p class="report-description">Hours logged by category &amp; by user, ongoing vs completed</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- Payments Report -->
                <a class="report-card-link" asp-action="Payments">
                    <div class="report-card-item">
                        <div class="report-icon icon-payment">
                            <i class="fas fa-file-invoice-dollar"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Payments Report</h3>
                            <p class="report-description">Paid, outstanding &amp; overdue amounts, upcoming dues</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- SSL Certificates -->
                <a class="report-card-link" asp-action="Certificates">
                    <div class="report-card-item">
                        <div class="report-icon icon-cert">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">SSL Certificates</h3>
                            <p class="report-description">Expiry buckets &amp; certificates needing attention</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>

                <!-- Maintenance Report -->
                <a class="report-card-link" asp-action="Maintenance">
                    <div class="report-card-item">
                        <div class="report-icon icon-maintenance">
                            <i class="fas fa-wrench"></i>
                        </div>
                        <div class="report-content">
                            <h3 class="report-title-item">Maintenance Report</h3>
                            <p class="report-description">By type, recent work &amp; upcoming scheduled maintenance</p>
                        </div>
                        <i class="fas fa-chevron-right report-arrow"></i>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== KPI CARDS ===== */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .kpi-card {
        background: white;
        border-radius: 1rem;
        padding: 1.1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: all 0.3s ease;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

        .kpi-icon.primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
        }

        .kpi-icon.success {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

        .kpi-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .kpi-icon.warning {
            background: linear-gradient(135deg, #f5b042, #e6a017);
        }

        .kpi-icon.violet {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

        .kpi-icon.slate {
            background: linear-gradient(135deg, var(--gray-500), var(--gray-600));
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--gray-800);
        line-height: 1.2;
    }

    .kpi-label {
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-top: 0.05rem;
    }

    .kpi-sub {
        font-weight: 400;
        color: var(--gray-400);
        text-transform: none;
        letter-spacing: 0;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

        .data-card.mt-4 {
            margin-top: 1.5rem;
        }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== REPORT CARDS GRID ===== */
    .report-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1rem;
    }

    .report-card-link {
        text-decoration: none;
        display: block;
        transition: all 0.2s;
    }

        .report-card-link:hover {
            text-decoration: none;
        }

    .report-card-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: white;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.9rem;
        transition: all 0.25s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .report-card-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.03), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

    .report-card-link:hover .report-card-item {
        border-color: var(--primary);
        box-shadow: var(--shadow-md);
        transform: translateY(-3px);
    }

        .report-card-link:hover .report-card-item::before {
            opacity: 1;
        }

    .report-card-link:hover .report-arrow {
        transform: translateX(4px);
        color: var(--primary);
    }

    /* ===== REPORT ICONS ===== */
    .report-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: white;
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
    }

    .report-card-link:hover .report-icon {
        transform: scale(1.05);
    }

    .icon-ticket {
        background: linear-gradient(135deg, var(--primary-light), var(--primary));
    }

    .icon-asset {
        background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    }

    .icon-user {
        background: linear-gradient(135deg, #2c9e6e, #227a55);
    }

    .icon-activity {
        background: linear-gradient(135deg, #06b6d4, #0891b2);
    }

    .icon-payment {
        background: linear-gradient(135deg, #f5b042, #e6a017);
    }

    .icon-cert {
        background: linear-gradient(135deg, #ef4444, #dc2626);
    }

    .icon-maintenance {
        background: linear-gradient(135deg, var(--gray-500), var(--gray-600));
    }

    /* ===== REPORT CONTENT ===== */
    .report-content {
        flex: 1;
        min-width: 0;
        position: relative;
        z-index: 1;
    }

    .report-title-item {
        font-weight: 700;
        color: var(--gray-800);
        font-size: 0.95rem;
        margin: 0 0 0.2rem 0;
        transition: color 0.2s;
    }

    .report-card-link:hover .report-title-item {
        color: var(--primary);
    }

    .report-description {
        font-size: 0.78rem;
        color: var(--gray-500);
        margin: 0;
        line-height: 1.4;
    }

    .report-arrow {
        flex-shrink: 0;
        color: var(--gray-300);
        transition: all 0.25s ease;
        position: relative;
        z-index: 1;
        font-size: 0.9rem;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .kpi-card {
            padding: 0.9rem 1rem;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            font-size: 0.9rem;
        }

        .kpi-value {
            font-size: 1.1rem;
        }

        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .report-cards-grid {
            grid-template-columns: 1fr;
        }

        .report-card-item {
            padding: 0.9rem 1rem;
        }
    }

    @@media (max-width: 576px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .report-icon {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        .report-title-item {
            font-size: 0.85rem;
        }

        .report-description {
            font-size: 0.7rem;
        }

        .kpi-sub {
            display: block;
            font-size: 0.6rem;
        }
    }
</style>