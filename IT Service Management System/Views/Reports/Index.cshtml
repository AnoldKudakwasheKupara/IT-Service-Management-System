@model IT_Service_Management_System.ViewModels.Reports.ReportsDashboardVM
@{
    ViewData["Title"] = "Reports - Axis IT Operations";
    string Money(decimal v) => v.ToString("C0", new System.Globalization.CultureInfo("en-US"));

    // The hub reads as four domains rather than one undifferentiated wall of
    // figures, so a reader looking for "what do we owe" isn't scanning past
    // certificate counts to find it.
    var resolvedPct = Model.TotalTickets == 0
        ? 0
        : (int)System.Math.Round(100.0 * (Model.ResolvedTickets + Model.ClosedTickets) / Model.TotalTickets);
}

<div class="report-shell">

    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1>Reports &amp; Analytics</h1>
            <p class="report-lede">
                A system-wide read on the helpdesk, the asset estate, spend and compliance.
                Open any report below for the full breakdown.
            </p>
            <div class="report-meta">
                <span><i class="fas fa-clock me-1"></i>Generated @Model.GeneratedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                <span class="dot"></span>
                <span>@Model.TotalDepartments departments</span>
            </div>
        </div>
        <div class="report-actions">
            <button type="button" class="report-btn" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    @* ---------- Service desk ---------- *@
    <div class="report-section-head">
        <h2>Service desk</h2>
        <span class="rule"></span>
    </div>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon primary"><i class="fas fa-ticket-alt"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalTickets</div>
                <div class="kpi-label">Total tickets<span class="kpi-sub">@Model.OpenTickets currently open</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success"><i class="fas fa-circle-check"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@resolvedPct%</div>
                <div class="kpi-label">Resolution rate<span class="kpi-sub">@(Model.ResolvedTickets + Model.ClosedTickets) resolved or closed</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon teal"><i class="fas fa-clock"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalActivityHours h</div>
                <div class="kpi-label">Activity logged<span class="kpi-sub">across @Model.TotalActivities entries</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate"><i class="fas fa-users"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalUsers</div>
                <div class="kpi-label">Users<span class="kpi-sub">@Model.ActiveUsers active</span></div>
            </div>
        </div>
    </div>

    @* ---------- Asset estate ---------- *@
    <div class="report-section-head">
        <h2>Asset estate</h2>
        <span class="rule"></span>
    </div>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon violet"><i class="fas fa-laptop-code"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalAssets</div>
                <div class="kpi-label">Assets tracked<span class="kpi-sub">@Model.AssetsIssued issued to staff</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success"><i class="fas fa-box-open"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.AssetsInStock</div>
                <div class="kpi-label">In stock<span class="kpi-sub">available to issue</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning"><i class="fas fa-screwdriver-wrench"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.AssetsInRepair</div>
                <div class="kpi-label">In repair<span class="kpi-sub">@Model.MaintenanceRecords maintenance records</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate"><i class="fas fa-coins"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalAssetValue)</div>
                <div class="kpi-label">Total asset value<span class="kpi-sub">at recorded purchase cost</span></div>
            </div>
        </div>
    </div>

    @* ---------- Spend & risk ---------- *@
    <div class="report-section-head">
        <h2>Spend &amp; risk</h2>
        <span class="rule"></span>
    </div>
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon @(Model.TotalOutstanding > 0 ? "danger" : "success")"><i class="fas fa-file-invoice-dollar"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalOutstanding)</div>
                <div class="kpi-label">Outstanding<span class="kpi-sub">@Model.OverduePayments payment@(Model.OverduePayments == 1 ? "" : "s") overdue</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success"><i class="fas fa-circle-dollar-to-slot"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalPaid)</div>
                <div class="kpi-label">Settled to date<span class="kpi-sub">across all payment schedules</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon @(Model.CertsExpiringSoon > 0 ? "warning" : "success")"><i class="fas fa-shield-halved"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.CertsExpiringSoon</div>
                <div class="kpi-label">Certificates expiring<span class="kpi-sub">within the next 30 days</span></div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon @(Model.CertsExpired > 0 ? "danger" : "slate")"><i class="fas fa-triangle-exclamation"></i></div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.CertsExpired</div>
                <div class="kpi-label">Certificates expired<span class="kpi-sub">needing renewal now</span></div>
            </div>
        </div>
    </div>

    @* ---------- Report directory ---------- *@
    <div class="report-section-head">
        <h2>Detailed reports</h2>
        <span class="rule"></span>
    </div>
    <div class="report-cards-grid">

        <a class="report-card-link" asp-action="Tickets">
            <div class="report-card-item">
                <div class="report-icon icon-ticket"><i class="fas fa-ticket-alt"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Tickets</h3>
                    <p class="report-description">Status, priority, categories, top requesters and resolution rate.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="SlaCompliance">
            <div class="report-card-item">
                <div class="report-icon icon-ticket"><i class="fas fa-gauge-high"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">SLA Compliance</h3>
                    <p class="report-description">Response and resolution attainment, MTTR, breaches by priority.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="AgentPerformance">
            <div class="report-card-item">
                <div class="report-icon icon-user"><i class="fas fa-user-gear"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Agent Performance</h3>
                    <p class="report-description">Per-agent workload, resolution time, SLA breaches and CSAT.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="TicketTrends">
            <div class="report-card-item">
                <div class="report-icon icon-ticket"><i class="fas fa-chart-line"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Ticket Trends</h3>
                    <p class="report-description">Created versus resolved volume over the last twelve months.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="Assets">
            <div class="report-card-item">
                <div class="report-icon icon-asset"><i class="fas fa-laptop-code"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Assets</h3>
                    <p class="report-description">Status, condition, value, holders and recent asset activity.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="Maintenance">
            <div class="report-card-item">
                <div class="report-icon icon-maintenance"><i class="fas fa-wrench"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Maintenance</h3>
                    <p class="report-description">Work by type, recent jobs and upcoming scheduled maintenance.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="Certificates">
            <div class="report-card-item">
                <div class="report-icon icon-cert"><i class="fas fa-shield-halved"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">SSL Certificates</h3>
                    <p class="report-description">Expiry buckets and the certificates needing attention first.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="Payments">
            <div class="report-card-item">
                <div class="report-icon icon-payment"><i class="fas fa-file-invoice-dollar"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Payments</h3>
                    <p class="report-description">Paid, outstanding and overdue amounts, plus upcoming dues.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="Activity">
            <div class="report-card-item">
                <div class="report-icon icon-activity"><i class="fas fa-list-check"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Activity</h3>
                    <p class="report-description">Hours logged by category and by user, ongoing versus completed.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

        <a class="report-card-link" asp-action="Users">
            <div class="report-card-item">
                <div class="report-icon icon-user"><i class="fas fa-users"></i></div>
                <div class="report-content">
                    <h3 class="report-title-item">Users &amp; Departments</h3>
                    <p class="report-description">Roles, departments, active users and asset assignments.</p>
                </div>
                <i class="fas fa-chevron-right report-arrow"></i>
            </div>
        </a>

    </div>
</div>
