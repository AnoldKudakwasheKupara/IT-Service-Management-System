@model IT_Service_Management_System.ViewModels.Reports.ReportsDashboardVM
@{
    ViewData["Title"] = "Reports - Axis IT Operations";
    string Money(decimal v) => v.ToString("C0", new System.Globalization.CultureInfo("en-US"));

    // The hub reads as four domains rather than one undifferentiated wall of
    // figures, so a reader looking for "what do we owe" isn't scanning past
    // certificate counts to find it.
    var resolvedPct = Model.TotalTickets == 0
        ? 0
        : (int)System.Math.Round(100.0 * (Model.ResolvedTickets + Model.ClosedTickets) / Model.TotalTickets);
}

<div class="report-shell">

    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1>Reports &amp; Analytics</h1>
            <p class="report-lede">
                A system-wide read on the helpdesk, the asset estate, spend and compliance.
                Open any report below for the full breakdown.
            </p>
            <div class="report-meta">
                <span><i class="fas fa-clock me-1"></i>Generated @Model.GeneratedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</span>
                <span class="dot"></span>
                <span>@Model.TotalDepartments departments</span>
            </div>
        </div>
        <div class="report-actions">
            <button type="button" class="report-btn" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    @* ---------- Service desk ---------- *@
    @* Each figure links to the report it was drawn from, so the number is a
       way in rather than a dead end. Tones follow meaning, not decoration:
       a count that wants attention goes amber or rose, a healthy one green. *@
    <div class="report-section-head">
        <h2>Service desk</h2>
        <span class="rule"></span>
    </div>
    <div class="stat-grid">
        <a class="stat-tile tone-slate" asp-action="Tickets">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-ticket-alt"></i></span>
            <span class="stat-tile-value">@Model.TotalTickets</span>
            <span class="stat-tile-label">Total tickets</span>
            <span class="stat-tile-sub">@Model.OpenTickets currently open</span>
        </a>
        <a class="stat-tile tone-green" asp-action="Tickets">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-circle-check"></i></span>
            <span class="stat-tile-value">@resolvedPct%</span>
            <span class="stat-tile-label">Resolution rate</span>
            <span class="stat-tile-sub">@(Model.ResolvedTickets + Model.ClosedTickets) resolved or closed</span>
        </a>
        <a class="stat-tile tone-teal" asp-action="Activity">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-clock"></i></span>
            <span class="stat-tile-value">@Model.TotalActivityHours h</span>
            <span class="stat-tile-label">Activity logged</span>
            <span class="stat-tile-sub">across @Model.TotalActivities entries</span>
        </a>
        <a class="stat-tile tone-violet" asp-action="Users">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-users"></i></span>
            <span class="stat-tile-value">@Model.TotalUsers</span>
            <span class="stat-tile-label">Users</span>
            <span class="stat-tile-sub">@Model.ActiveUsers active</span>
        </a>
    </div>

    @* ---------- Asset estate ---------- *@
    <div class="report-section-head">
        <h2>Asset estate</h2>
        <span class="rule"></span>
    </div>
    <div class="stat-grid">
        <a class="stat-tile tone-violet" asp-action="Assets">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-laptop-code"></i></span>
            <span class="stat-tile-value">@Model.TotalAssets</span>
            <span class="stat-tile-label">Assets tracked</span>
            <span class="stat-tile-sub">@Model.AssetsIssued issued to staff</span>
        </a>
        <a class="stat-tile tone-green" asp-action="Assets">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-box-open"></i></span>
            <span class="stat-tile-value">@Model.AssetsInStock</span>
            <span class="stat-tile-label">In stock</span>
            <span class="stat-tile-sub">available to issue</span>
        </a>
        <a class="stat-tile @(Model.AssetsInRepair > 0 ? "tone-amber" : "tone-slate")" asp-action="Maintenance">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-screwdriver-wrench"></i></span>
            <span class="stat-tile-value">@Model.AssetsInRepair</span>
            <span class="stat-tile-label">In repair</span>
            <span class="stat-tile-sub">@Model.MaintenanceRecords maintenance records</span>
        </a>
        <a class="stat-tile tone-teal" asp-action="Assets">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-coins"></i></span>
            <span class="stat-tile-value">@Money(Model.TotalAssetValue)</span>
            <span class="stat-tile-label">Total asset value</span>
            <span class="stat-tile-sub">at recorded purchase cost</span>
        </a>
    </div>

    @* ---------- Spend & risk ---------- *@
    <div class="report-section-head">
        <h2>Spend &amp; risk</h2>
        <span class="rule"></span>
    </div>
    <div class="stat-grid">
        <a class="stat-tile @(Model.TotalOutstanding > 0 ? "tone-rose" : "tone-green")" asp-action="Payments">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-file-invoice-dollar"></i></span>
            <span class="stat-tile-value">@Money(Model.TotalOutstanding)</span>
            <span class="stat-tile-label">Outstanding</span>
            <span class="stat-tile-sub">@Model.OverduePayments payment@(Model.OverduePayments == 1 ? "" : "s") overdue</span>
        </a>
        <a class="stat-tile tone-green" asp-action="Payments">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-circle-dollar-to-slot"></i></span>
            <span class="stat-tile-value">@Money(Model.TotalPaid)</span>
            <span class="stat-tile-label">Settled to date</span>
            <span class="stat-tile-sub">across all payment schedules</span>
        </a>
        <a class="stat-tile @(Model.CertsExpiringSoon > 0 ? "tone-amber" : "tone-green")" asp-action="Certificates">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-shield-halved"></i></span>
            <span class="stat-tile-value">@Model.CertsExpiringSoon</span>
            <span class="stat-tile-label">Certificates expiring</span>
            <span class="stat-tile-sub">within the next 30 days</span>
        </a>
        <a class="stat-tile @(Model.CertsExpired > 0 ? "tone-rose" : "tone-green")" asp-action="Certificates">
            <i class="fas fa-arrow-right stat-tile-go" aria-hidden="true"></i>
            <span class="stat-tile-icon"><i class="fas fa-triangle-exclamation"></i></span>
            <span class="stat-tile-value">@Model.CertsExpired</span>
            <span class="stat-tile-label">Certificates expired</span>
            <span class="stat-tile-sub">needing renewal now</span>
        </a>
    </div>

    @* ---------- Report directory ---------- *@
    <div class="report-section-head">
        <h2>Detailed reports</h2>
        <span class="rule"></span>
    </div>
    <div class="report-bento">

        @* The mosaic is ordered by how much of the estate each report speaks
           for, and sized to match: tickets take the hero tile, the risk-facing
           reports get the tall and dark tiles so they read first. *@

        <a class="bento-card is-hero span-2 tall-2" asp-action="Tickets">
            <span class="bento-badge"><i class="fas fa-ticket-alt"></i> Service desk</span>
            <h3 class="bento-title">Everything the helpdesk handled</h3>
            <p class="bento-desc">
                Status, priority and category breakdowns, your top requesters,
                and the resolution rate behind them.
            </p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.TotalTickets</span>
                <span class="bento-stat-label">tickets &middot; @Model.OpenTickets open &middot; @resolvedPct% resolved</span>
            </div>
            <span class="bento-cta">View ticket report <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-ink" asp-action="SlaCompliance">
            <span class="bento-badge"><i class="fas fa-gauge-high"></i> SLA</span>
            <h3 class="bento-title">SLA compliance</h3>
            <p class="bento-desc">Response and resolution attainment, MTTR and breaches by priority.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.SlaBreachedOpen</span>
                <span class="bento-stat-label">open past target</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-rose tall-2" asp-action="Certificates">
            <span class="bento-badge"><i class="fas fa-shield-halved"></i> Risk</span>
            <h3 class="bento-title">SSL certificates</h3>
            <p class="bento-desc">
                Expiry buckets and the certificates that need renewing first,
                before a lapse takes a service down.
            </p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.CertsExpiringSoon</span>
                <span class="bento-stat-label">expiring in 30 days &middot; @Model.CertsExpired already expired</span>
            </div>
            <span class="bento-cta">Review certificates <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-teal" asp-action="AgentPerformance">
            <span class="bento-badge"><i class="fas fa-user-gear"></i> People</span>
            <h3 class="bento-title">Agent performance</h3>
            <p class="bento-desc">Workload, resolution time, SLA breaches and CSAT per agent.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.SupportAgents</span>
                <span class="bento-stat-label">agents on the desk</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-plain span-2" asp-action="TicketTrends">
            <span class="bento-badge"><i class="fas fa-chart-line"></i> Trend</span>
            <h3 class="bento-title">Ticket trends</h3>
            <p class="bento-desc">Created against resolved volume over the last twelve months.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.TicketsLast30Days</span>
                <span class="bento-stat-label">raised in the last 30 days</span>
            </div>
            <span class="bento-cta">See the curve <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-violet" asp-action="Assets">
            <span class="bento-badge"><i class="fas fa-laptop-code"></i> Estate</span>
            <h3 class="bento-title">Assets</h3>
            <p class="bento-desc">Status, condition, value, holders and recent movement.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.TotalAssets</span>
                <span class="bento-stat-label">tracked &middot; @Model.AssetsIssued issued</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-amber" asp-action="Payments">
            <span class="bento-badge"><i class="fas fa-file-invoice-dollar"></i> Spend</span>
            <h3 class="bento-title">Payments</h3>
            <p class="bento-desc">Paid, outstanding and overdue amounts, plus what falls due next.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Money(Model.TotalOutstanding)</span>
                <span class="bento-stat-label">outstanding &middot; @Model.OverduePayments overdue</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-plain" asp-action="Maintenance">
            <span class="bento-badge"><i class="fas fa-wrench"></i> Upkeep</span>
            <h3 class="bento-title">Maintenance</h3>
            <p class="bento-desc">Work by type, recent jobs and what is scheduled next.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.MaintenanceUpcoming</span>
                <span class="bento-stat-label">due in 30 days &middot; @Model.MaintenanceRecords logged</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-green" asp-action="Activity">
            <span class="bento-badge"><i class="fas fa-list-check"></i> Work</span>
            <h3 class="bento-title">Activity</h3>
            <p class="bento-desc">Hours logged by category and by person, ongoing against completed.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.TotalActivityHours h</span>
                <span class="bento-stat-label">across @Model.TotalActivities entries</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

        <a class="bento-card tone-teal span-2" asp-action="Users">
            <span class="bento-badge"><i class="fas fa-users"></i> Directory</span>
            <h3 class="bento-title">Users &amp; departments</h3>
            <p class="bento-desc">Roles, departments, active accounts and who is holding what.</p>
            <div class="bento-figure">
                <span class="bento-stat">@Model.TotalUsers</span>
                <span class="bento-stat-label">users &middot; @Model.ActiveUsers active &middot; @Model.TotalDepartments departments</span>
            </div>
            <span class="bento-cta">Open <i class="fas fa-arrow-right"></i></span>
        </a>

    </div>
</div>
