@model IT_Service_Management_System.ViewModels.Reports.HrReportVM
@{
    ViewData["Title"] = "HR Report - Axis IT Operations";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
    var role = Context.Session.GetString("UserRole");
    var isFullAccess = role == "Admin" || role == "SystemsAdmin";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-user-friends me-2" style="color: var(--primary);"></i>
                    HR Report
                </h1>
                <p class="text-muted mt-2">Exit clearances, interviews &amp; talent analytics</p>
            </div>
            <div class="d-flex gap-2">
                @if (isFullAccess)
                {
                    <a class="btn-create-ticket" asp-action="Index" style="background: var(--gray-100); color: var(--gray-700);">
                        <i class="fas fa-arrow-left"></i>
                        All Reports
                    </a>
                }
                <button class="btn-create-ticket" onclick="window.print()">
                    <i class="fas fa-print"></i>
                    Print
                </button>
            </div>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-file-signature"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalClearances</div>
                <div class="kpi-label">Exit Clearances</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-spinner"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.ClearancesInProgress</div>
                <div class="kpi-label">In Progress</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.ClearancesCompleted</div>
                <div class="kpi-label">Completed</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon violet">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.ExitInterviews</div>
                <div class="kpi-label">Exit Interviews</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-user-friends"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.EngagementInterviews</div>
                <div class="kpi-label">Engagement Interviews</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-user-tie"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TalentRecords</div>
                <div class="kpi-label">Talent Records</div>
            </div>
        </div>
    </div>

    <!-- TWO COLUMN GRID: By Status & By Stage -->
    <div class="two-col-grid">
        <!-- Clearances by Status -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-layer-group me-2"></i>
                <span>Clearances by Status</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ClearancesByStatus.Any())
                {
                    var m1 = Max(Model.ClearancesByStatus);
                    <div class="bars">
                        @foreach (var s in Model.ClearancesByStatus.OrderByDescending(x => x.Count))
                        {
                            var cls = s.Name == "Completed" ? "success" :
                                     s.Name == "Rejected" ? "danger" : "warning";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(s.Count * 100 / m1)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No clearances yet</span>
                    </div>
                }
            </div>
        </div>

        <!-- Clearances by Stage -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-stairs me-2"></i>
                <span>Clearances by Current Stage</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ClearancesByStage.Any())
                {
                    var m2 = Max(Model.ClearancesByStage);
                    <div class="bars">
                        @foreach (var s in Model.ClearancesByStage.OrderByDescending(x => x.Count))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill violet" style="width:@(s.Count * 100 / m2)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No clearances yet</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RECENT EXIT CLEARANCES -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-clock-rotate-left me-2"></i>
                <span>Recent Exit Clearances</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.RecentClearances.Count</span> recent records
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.RecentClearances.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Employee</th>
                                <th><i class="fas fa-stairs me-1"></i> Current Stage</th>
                                <th><i class="fas fa-tag me-1"></i> Status</th>
                                <th><i class="fas fa-calendar me-1"></i> Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.RecentClearances.OrderByDescending(x => x.CreatedDate))
                            {
                                var statusClass = c.Status.ToString() == "Completed" ? "status-completed" :
                                                 c.Status.ToString() == "Rejected" ? "status-rejected" : "status-inprogress";
                                <tr>
                                    <td><span class="employee-name">@(c.Employee != null ? $"{c.Employee.FirstName} {c.Employee.LastName}" : "—")</span></td>
                                    <td><span class="stage-badge">@c.CurrentStage</span></td>
                                    <td><span class="status-badge @statusClass">@c.Status</span></td>
                                    <td class="clearance-date">@c.CreatedDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No exit clearances recorded yet</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== KPI CARDS ===== */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .kpi-card {
        background: white;
        border-radius: 1rem;
        padding: 1.1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: all 0.3s ease;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

        .kpi-icon.primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
        }

        .kpi-icon.success {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

        .kpi-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .kpi-icon.warning {
            background: linear-gradient(135deg, #f5b042, #e6a017);
        }

        .kpi-icon.violet {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

        .kpi-icon.slate {
            background: linear-gradient(135deg, var(--gray-500), var(--gray-600));
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--gray-800);
        line-height: 1.2;
    }

    .kpi-label {
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-top: 0.05rem;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

        .data-card.mt-4 {
            margin-top: 1.5rem;
        }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.25rem 1.5rem;
    }

    .ticket-count {
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    /* ===== BARS ===== */
    .bars {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .bar-label {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--gray-600);
        min-width: 70px;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bar-track {
        flex: 1;
        height: 8px;
        background: var(--gray-100);
        border-radius: 1rem;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        border-radius: 1rem;
        transition: width 0.6s ease;
        min-width: 4px;
    }

        .bar-fill.success {
            background: linear-gradient(90deg, #6ee7b7, var(--success));
        }

        .bar-fill.danger {
            background: linear-gradient(90deg, #fca5a5, var(--danger));
        }

        .bar-fill.warning {
            background: linear-gradient(90deg, #fcd34d, var(--warning));
        }

        .bar-fill.violet {
            background: linear-gradient(90deg, #a78bfa, #7c3aed);
        }

        .bar-fill.primary {
            background: linear-gradient(90deg, var(--primary-light), var(--primary));
        }

    .bar-value {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--gray-600);
        min-width: 30px;
        text-align: right;
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 0.75rem 1.2rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.65rem 1.2rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== HR SPECIFIC ===== */
    .employee-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    .clearance-date {
        font-size: 0.78rem;
        color: var(--gray-500);
        white-space: nowrap;
    }

    /* ===== STAGE BADGE ===== */
    .stage-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .status-completed {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .status-inprogress {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .status-rejected {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    /* ===== EMPTY STATE MINI ===== */
    .empty-state-mini {
        text-align: center;
        padding: 1.5rem;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .empty-state-mini i {
            font-size: 1.2rem;
            color: var(--gray-400);
        }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .btn-create-ticket {
            display: none !important;
        }

        .data-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
            page-break-inside: avoid;
        }

        .kpi-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
        }

        .bar-fill {
            background: var(--gray-600) !important;
        }
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .two-col-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }

    @@media (max-width: 768px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .kpi-card {
            padding: 0.9rem 1rem;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            font-size: 0.9rem;
        }

        .kpi-value {
            font-size: 1.1rem;
        }

        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .tickets-table td,
        .tickets-table th {
            padding: 0.5rem 0.8rem;
        }

        .bar-label {
            min-width: 50px;
            max-width: 70px;
            font-size: 0.7rem;
        }

        .bar-value {
            font-size: 0.7rem;
            min-width: 25px;
        }
    }

    @@media (max-width: 576px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .tickets-table {
            font-size: 0.75rem;
        }

            .tickets-table td,
            .tickets-table th {
                padding: 0.4rem 0.5rem;
            }

        .status-badge,
        .stage-badge {
            font-size: 0.6rem;
            padding: 0.1rem 0.4rem;
        }

        .bar-label {
            min-width: 40px;
            max-width: 60px;
            font-size: 0.65rem;
        }

        .bar-value {
            font-size: 0.65rem;
            min-width: 20px;
        }
    }
</style>