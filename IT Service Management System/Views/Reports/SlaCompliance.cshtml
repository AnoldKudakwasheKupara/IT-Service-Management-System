@model IT_Service_Management_System.ViewModels.Reports.SlaComplianceVM
@{
    ViewData["Title"] = "SLA Compliance - Reports";

    string BadgeFor(double pct) => pct >= 90 ? "badge-green" : pct >= 75 ? "badge-amber" : "badge-red";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Reports" asp-action="Index" class="btn-back" title="Back to Reports">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-stopwatch me-2" style="color: var(--primary);"></i>
                        SLA Compliance
                    </h1>
                    <p class="text-muted mt-2">Response &amp; resolution performance against SLA targets.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #3b82f6, #2563eb);">
                <i class="fas fa-reply"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.ResponseCompliance%</h3>
                <p>Response Compliance</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #2c9e6e, #227a55);">
                <i class="fas fa-check-double"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.ResolutionCompliance%</h3>
                <p>Resolution Compliance</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f5b042, #e6a017);">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.AvgResponseHours h</h3>
                <p>Avg Response</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.AvgResolutionHours h</h3>
                <p>MTTR (Avg Resolution)</p>
            </div>
        </div>
    </div>

    <!-- SUMMARY CARD -->
    <div class="data-card mb-4">
        <div class="card-header-custom">
            <div><i class="fas fa-list-check me-2"></i><span>Measurement Summary</span></div>
            <div class="record-count"><i class="fas fa-chart-simple"></i> <span>@Model.MeasuredTickets</span> measured tickets</div>
        </div>
        <div class="summary-grid">
            <div class="summary-item"><span class="summary-label">Measured</span><span class="summary-value">@Model.MeasuredTickets</span></div>
            <div class="summary-item"><span class="summary-label">Response Met</span><span class="summary-value text-green">@Model.ResponseMet</span></div>
            <div class="summary-item"><span class="summary-label">Response Breached</span><span class="summary-value text-red">@Model.ResponseBreached</span></div>
            <div class="summary-item"><span class="summary-label">Resolution Met</span><span class="summary-value text-green">@Model.ResolutionMet</span></div>
            <div class="summary-item"><span class="summary-label">Resolution Breached</span><span class="summary-value text-red">@Model.ResolutionBreached</span></div>
            <div class="summary-item"><span class="summary-label">Open &amp; Breaching</span><span class="summary-value text-amber">@Model.OpenBreaching</span></div>
        </div>
    </div>

    <!-- BY PRIORITY -->
    <div class="data-card mb-4">
        <div class="card-header-custom">
            <div><i class="fas fa-flag me-2"></i><span>Compliance by Priority</span></div>
            <div class="record-count"><i class="fas fa-chart-simple"></i> <span>@Model.ByPriority.Count</span> priorities</div>
        </div>
        <div class="table-responsive">
            @if (Model.ByPriority.Any())
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-flag me-1"></i> Priority</th>
                            <th><i class="fas fa-hashtag me-1"></i> Total</th>
                            <th><i class="fas fa-check me-1"></i> Met</th>
                            <th><i class="fas fa-triangle-exclamation me-1"></i> Breached</th>
                            <th><i class="fas fa-percent me-1"></i> Compliance</th>
                            <th><i class="fas fa-hourglass-half me-1"></i> Avg Resolution</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.ByPriority)
                        {
                            <tr>
                                <td><span class="status-badge badge-blue">@r.Priority</span></td>
                                <td>@r.Total</td>
                                <td class="text-green">@r.Met</td>
                                <td class="text-red">@r.Breached</td>
                                <td><span class="status-badge @BadgeFor(r.Compliance)">@r.Compliance%</span></td>
                                <td>@r.AvgResolutionHours h</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state"><i class="fas fa-flag"></i><h3>No measured tickets</h3><p>SLA data appears once tickets have due dates.</p></div>
            }
        </div>
    </div>

    <!-- BREACHES BY CATEGORY -->
    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-tags me-2"></i><span>Breaches by Category</span></div>
            <div class="record-count"><i class="fas fa-chart-simple"></i> <span>@Model.BreachesByCategory.Count</span> categories</div>
        </div>
        <div class="card-body-custom">
            @if (Model.BreachesByCategory.Any())
            {
                var m = Max(Model.BreachesByCategory);
                <div class="bars">
                    @foreach (var s in Model.BreachesByCategory)
                    {
                        <div class="bar-row">
                            <div class="bar-label" title="@s.Name">@s.Name</div>
                            <div class="bar-track"><div class="bar-fill red" style="width: @(s.Count * 100 / m)%"></div></div>
                            <div class="bar-value">@s.Count</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-sm"><i class="fas fa-check-circle"></i><p>No resolution breaches — nice work.</p></div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_ReportExtras")
