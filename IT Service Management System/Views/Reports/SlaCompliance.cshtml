@model IT_Service_Management_System.ViewModels.Reports.SlaComplianceVM
@{
    ViewData["Title"] = "SLA Compliance - Reports";

    string BadgeFor(double pct) => pct >= 90 ? "badge-success" : pct >= 75 ? "badge-warning" : "badge-critical";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-stopwatch"></i> SLA Compliance</h1>
            <p class="report-lede">Response &amp; resolution performance against SLA targets.</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    @* Attainment and averages, in the same tile as the rest of the reporting.
       These are computed rates rather than a set of records, so they are shown
       rather than linked - there is no list that "94% response compliance"
       could open. The rate tones use the same 90/75 lines as BadgeFor() below,
       so the strip and the by-priority table cannot disagree; with nothing
       measured yet the tiles say so instead of painting 0% amber. *@
    @{
        var respMeasured = Model.ResponseMet + Model.ResponseBreached > 0;
        var resMeasured = Model.ResolutionMet + Model.ResolutionBreached > 0;
        string RateTone(double pct, bool measured) =>
            !measured ? "tone-slate" : pct >= 90 ? "tone-green" : pct >= 75 ? "tone-amber" : "tone-rose";
    }
    <h2 class="sr-only">Key figures</h2>
    <div class="stat-grid">
        <div class="bento-card is-compact is-static @RateTone(Model.ResponseCompliance, respMeasured)">
            <span class="bento-badge"><i class="fas fa-reply" aria-hidden="true"></i> Response</span>
            <h3 class="bento-title">Response compliance</h3>
            <div class="bento-figure">
                <span class="bento-stat">@(respMeasured ? $"{Model.ResponseCompliance}%" : "—")</span>
                <span class="bento-stat-label">@(respMeasured ? "answered inside target" : "no measured tickets yet")</span>
            </div>
        </div>
        <div class="bento-card is-compact is-static @RateTone(Model.ResolutionCompliance, resMeasured)">
            <span class="bento-badge"><i class="fas fa-check-double" aria-hidden="true"></i> Resolution</span>
            <h3 class="bento-title">Resolution compliance</h3>
            <div class="bento-figure">
                <span class="bento-stat">@(resMeasured ? $"{Model.ResolutionCompliance}%" : "—")</span>
                <span class="bento-stat-label">@(resMeasured ? "resolved inside target" : "no measured tickets yet")</span>
            </div>
        </div>
        <div class="bento-card is-compact is-static tone-teal">
            <span class="bento-badge"><i class="fas fa-clock" aria-hidden="true"></i> Speed</span>
            <h3 class="bento-title">Average response</h3>
            <div class="bento-figure">
                <span class="bento-stat">@(respMeasured ? $"{Model.AvgResponseHours} h" : "—")</span>
                <span class="bento-stat-label">@(respMeasured ? "to a first reply" : "nothing measured yet")</span>
            </div>
        </div>
        <div class="bento-card is-compact is-static tone-violet">
            <span class="bento-badge"><i class="fas fa-hourglass-half" aria-hidden="true"></i> MTTR</span>
            <h3 class="bento-title">Average resolution</h3>
            <div class="bento-figure">
                <span class="bento-stat">@(resMeasured ? $"{Model.AvgResolutionHours} h" : "—")</span>
                <span class="bento-stat-label">@(resMeasured ? "from raised to resolved" : "nothing measured yet")</span>
            </div>
        </div>
    </div>


    <!-- SUMMARY GRID -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-list-check me-2" style="color: var(--primary);"></i>
                <span>Measurement Summary</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.MeasuredTickets</span> measured tickets
            </div>
        </div>
        <div class="card-body-custom">
            <div class="summary-grid">
                <div class="summary-item">
                    <span class="summary-label">Measured</span>
                    <span class="summary-value">@Model.MeasuredTickets</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Response Met</span>
                    <span class="summary-value text-green">@Model.ResponseMet</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Response Breached</span>
                    <span class="summary-value text-red">@Model.ResponseBreached</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Resolution Met</span>
                    <span class="summary-value text-green">@Model.ResolutionMet</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Resolution Breached</span>
                    <span class="summary-value text-red">@Model.ResolutionBreached</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Open &amp; Breaching</span>
                    <span class="summary-value text-amber">@Model.OpenBreaching</span>
                </div>
            </div>
        </div>
    </div>

    <!-- COMPLIANCE BY PRIORITY -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-flag me-2" style="color: var(--primary);"></i>
                <span>Compliance by Priority</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.ByPriority.Count</span> priorities
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.ByPriority.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-flag me-1"></i> Priority</th>
                                <th><i class="fas fa-hashtag me-1"></i> Total</th>
                                <th><i class="fas fa-check me-1"></i> Met</th>
                                <th><i class="fas fa-triangle-exclamation me-1"></i> Breached</th>
                                <th><i class="fas fa-percent me-1"></i> Compliance</th>
                                <th><i class="fas fa-hourglass-half me-1"></i> Avg Resolution</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.ByPriority.OrderByDescending(x => x.Total))
                            {
                                var priorityBadge = r.Priority.ToString() == "Critical" ? "badge-critical" :
                                                   r.Priority.ToString() == "High" ? "badge-warning" :
                                                   r.Priority.ToString() == "Medium" ? "badge-primary" : "badge-gray";
                                <tr>
                                    <td><span class="status-badge @priorityBadge">@r.Priority</span></td>
                                    <td>@r.Total</td>
                                    <td class="text-green">@r.Met</td>
                                    <td class="text-red">@r.Breached</td>
                                    <td><span class="status-badge @BadgeFor(r.Compliance)">@r.Compliance%</span></td>
                                    <td>@r.AvgResolutionHours h</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-flag"></i>
                    <span>No measured tickets</span>
                    <span style="font-size:0.8rem;color:var(--gray-400);">SLA data appears once tickets have due dates.</span>
                </div>
            }
        </div>
    </div>

    <!-- BREACHES BY CATEGORY -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-tags me-2" style="color: var(--primary);"></i>
                <span>Breaches by Category</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.BreachesByCategory.Count</span> categories
            </div>
        </div>
        <div class="card-body-custom">
            @if (Model.BreachesByCategory.Any())
            {
                var m = Max(Model.BreachesByCategory);
                <div class="bars">
                    @foreach (var s in Model.BreachesByCategory.OrderByDescending(x => x.Count))
                    {
                        <div class="bar-row">
                            <div class="bar-label" title="@s.Name">@s.Name</div>
                            <div class="bar-track">
                                <div class="bar-fill danger" style="width: @(s.Count * 100 / m)%"></div>
                            </div>
                            <div class="bar-value">@s.Count</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-mini success">
                    <i class="fas fa-check-circle" style="color:var(--success);"></i>
                    <span style="font-weight:600;color:var(--success);">No resolution breaches — nice work.</span>
                </div>
            }
        </div>
    </div>
</div>
