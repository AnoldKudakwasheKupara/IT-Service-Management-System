@model IT_Service_Management_System.ViewModels.Reports.CertificatesReportVM
@{
    ViewData["Title"] = "SSL Certificates Report - Axis IT Operations";
    var now = DateTime.Now;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-shield-alt"></i> SSL Certificates</h1>
            <p class="report-lede">Certificate expiry health</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    @* The figures are the same tile used on the hub and the dashboards. Each
       one opens the records behind it, so the report is a way into the data
       rather than a dead end, and the tones follow meaning: amber and rose
       want attention, green is healthy, slate is a neutral total. *@
    <h2 class="sr-only">Key figures</h2>
    <div class="stat-grid is-auto">
        <a class="bento-card is-compact tone-slate" asp-controller="SSLCertificates" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-certificate" aria-hidden="true"></i> Tracked</span>
            <h3 class="bento-title">Total certificates</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Total</span>
                <span class="bento-stat-label">in the register</span>
            </div>
            <span class="bento-cta">Open tracker <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact @(Model.Expired > 0 ? "tone-rose" : "tone-green")" asp-controller="SSLCertificates" asp-action="Expired">
            <span class="bento-badge"><i class="fas fa-ban" aria-hidden="true"></i> Lapsed</span>
            <h3 class="bento-title">Expired</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Expired</span>
                <span class="bento-stat-label">needing renewal now</span>
            </div>
            <span class="bento-cta">Review <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact @(Model.Within30 > 0 ? "tone-amber" : "tone-green")" asp-controller="SSLCertificates" asp-action="ExpiringSoon">
            <span class="bento-badge"><i class="fas fa-clock" aria-hidden="true"></i> Urgent</span>
            <h3 class="bento-title">Expiring within 30 days</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Within30</span>
                <span class="bento-stat-label">renew inside the month</span>
            </div>
            <span class="bento-cta">Review <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact tone-violet" asp-controller="SSLCertificates" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-calendar-days" aria-hidden="true"></i> Soon</span>
            <h3 class="bento-title">Expiring in 31&ndash;90 days</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Within90</span>
                <span class="bento-stat-label">time to plan the renewal</span>
            </div>
            <span class="bento-cta">Open tracker <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact tone-green" asp-controller="SSLCertificates" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-shield-halved" aria-hidden="true"></i> Healthy</span>
            <h3 class="bento-title">Healthy</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Healthy</span>
                <span class="bento-stat-label">more than 90 days left</span>
            </div>
            <span class="bento-cta">Open tracker <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
    </div>


    <!-- ATTENTION CERTIFICATES -->
    <div class="data-card">
        <div class="card-header-custom" style="border-left: 4px solid var(--danger);">
            <div>
                <i class="fas fa-triangle-exclamation me-2" style="color: var(--danger);"></i>
                <span style="color: var(--danger);">Needs Attention</span>
                <span style="font-weight: 400; color: var(--gray-500); font-size: 0.8rem; margin-left: 0.5rem;">
                    (expired or expiring within 30 days)
                </span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Attention.Count</span> certificates need attention
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Attention.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-server me-1"></i> System</th>
                                <th><i class="fas fa-link me-1"></i> URL</th>
                                <th><i class="fas fa-calendar me-1"></i> Expiry Date</th>
                                <th><i class="fas fa-clock me-1"></i> Days</th>
                                <th><i class="fas fa-tag me-1"></i> Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Attention.OrderBy(x => x.ExpiryDate))
                            {
                                var days = (c.ExpiryDate - now).Days;
                                var expired = c.ExpiryDate < now;
                                var rowClass = expired ? "cert-expired" : "cert-expiring";
                                <tr class="@rowClass">
                                    <td><span class="system-name">@c.SystemName</span></td>
                                    <td class="cert-url" title="@c.URL">@c.URL</td>
                                    <td class="cert-date @(expired ? "expired" : "expiring")">@c.ExpiryDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <span class="days-badge @(expired ? "days-expired" : "days-expiring")">
                                            <i class="fas @(expired ? "fa-arrow-down" : "fa-clock")"></i>
                                            @(expired ? $"{Math.Abs(days)} days ago" : $"{days} days left")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-badge @(expired ? "status-expired" : "status-expiring")">
                                            @(expired ? "Expired" : "Expiring")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini success">
                    <i class="fas fa-check-circle" style="color: var(--success); font-size: 1.5rem;"></i>
                    <span style="font-size: 1rem; font-weight: 500; color: var(--success);">All certificates are healthy 🎉</span>
                </div>
            }
        </div>
    </div>

    <!-- HEALTHY CERTIFICATES SUMMARY -->
    @if (Model.Healthy > 0)
    {
        <div class="data-card mt-4">
            <div class="card-header-custom" style="border-left: 4px solid var(--success);">
                <div>
                    <i class="fas fa-check-circle me-2" style="color: var(--success);"></i>
                    <span style="color: var(--success);">Healthy Certificates</span>
                    <span style="font-weight: 400; color: var(--gray-500); font-size: 0.8rem; margin-left: 0.5rem;">
                        (expiring after 90+ days)
                    </span>
                </div>
                <div class="ticket-count">
                    <i class="fas fa-chart-simple"></i>
                    <span>@Model.Healthy</span> healthy certificates
                </div>
            </div>
            <div class="card-body-custom" style="padding: 1rem 1.5rem;">
                <div class="healthy-summary">
                    <div class="healthy-icon">
                        <i class="fas fa-shield-halved" style="color: var(--success); font-size: 2rem;"></i>
                    </div>
                    <div class="healthy-text">
                        <p style="margin: 0; color: var(--gray-600); font-size: 0.9rem;">
                            All <strong>@Model.Healthy</strong> certificates are valid for more than 90 days.
                            No action required at this time.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
