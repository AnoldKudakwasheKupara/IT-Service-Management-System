@model IT_Service_Management_System.ViewModels.Reports.UsersReportVM
@{
    ViewData["Title"] = "Users & Departments Report - Axis IT Operations";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-users"></i> Users &amp; Departments</h1>
            <p class="report-lede">Workforce composition and asset allocation</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    @* The figures are the same tile used on the hub and the dashboards. Each
       one opens the records behind it, so the report is a way into the data
       rather than a dead end, and the tones follow meaning: amber and rose
       want attention, green is healthy, slate is a neutral total. *@
    <h2 class="sr-only">Key figures</h2>
    <div class="stat-grid">
        <a class="bento-card is-compact tone-slate" asp-controller="Users" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-users" aria-hidden="true"></i> Directory</span>
            <h3 class="bento-title">Total users</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Total</span>
                <span class="bento-stat-label">account@(Model.Total == 1 ? "" : "s") on the system</span>
            </div>
            <span class="bento-cta">Open users <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact tone-green" asp-controller="Users" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-user-check" aria-hidden="true"></i> Active</span>
            <h3 class="bento-title">Active</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Active</span>
                <span class="bento-stat-label">able to sign in</span>
            </div>
            <span class="bento-cta">Open users <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact @(Model.Inactive > 0 ? "tone-amber" : "tone-green")" asp-controller="Users" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-user-slash" aria-hidden="true"></i> Dormant</span>
            <h3 class="bento-title">Inactive</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Inactive</span>
                <span class="bento-stat-label">cannot sign in</span>
            </div>
            <span class="bento-cta">Open users <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact tone-violet" asp-controller="Departments" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-building" aria-hidden="true"></i> Structure</span>
            <h3 class="bento-title">Departments represented</h3>
            <div class="bento-figure">
                @* ByDepartment carries an "Unassigned" bucket for users with no department;
                   that is not a department represented, so it is excluded here to match
                   the Departments list this tile opens. *@
                <span class="bento-stat">@Model.ByDepartment.Count(d => d.Name != "Unassigned")</span>
                <span class="bento-stat-label">with at least one user</span>
            </div>
            <span class="bento-cta">Open departments <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
    </div>


    <!-- TWO COLUMN GRID: By Role & By Department -->
    <div class="two-col-grid">
        <!-- By Role -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-user-tag me-2"></i>
                <span>By Role</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByRole.Any())
                {
                    var m1 = Max(Model.ByRole);
                    <div class="bars">
                        @foreach (var s in Model.ByRole.OrderByDescending(x => x.Count))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill primary" style="width:@(s.Count * 100 / m1)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No role data available</span>
                    </div>
                }
            </div>
        </div>

        <!-- By Department -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-building me-2"></i>
                <span>By Department</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByDepartment.Any())
                {
                    var m2 = Max(Model.ByDepartment);
                    <div class="bars">
                        @foreach (var s in Model.ByDepartment.OrderByDescending(x => x.Count))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill success" style="width:@(s.Count * 100 / m2)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No department data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ASSETS PER USER -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-laptop me-2"></i>
                <span>Assets per User</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.AssetsPerUser.Count</span> users with assets
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.AssetsPerUser.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-user me-1"></i> User</th>
                                <th style="text-align:right;"><i class="fas fa-laptop me-1"></i> Assets Held</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model.AssetsPerUser.OrderByDescending(x => x.Count).Take(10))
                            {
                                <tr>
                                    <td><span class="user-name">@u.Name</span></td>
                                    <td style="text-align:right;">
                                        <span class="asset-count-badge">@u.Count</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.AssetsPerUser.Count > 10)
                {
                    <div class="asset-note">
                        <i class="fas fa-info-circle"></i>
                        Showing top 10 of @Model.AssetsPerUser.Count users with assets
                    </div>
                }
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No assets currently assigned to users</span>
                </div>
            }
        </div>
    </div>
</div>
