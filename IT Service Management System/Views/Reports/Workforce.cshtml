@using IT_Service_Management_System.ViewModels.Hr
@model HrAnalyticsVm
@{
    ViewData["Title"] = "Workforce Analytics";

    var maxStarters = Math.Max(1, Model.StartersByMonth.Concat(Model.LeaversByMonth).Select(m => m.Value).DefaultIfEmpty(0).Max());
    var maxDept = Math.Max(1, Model.HeadcountByDepartment.Values.DefaultIfEmpty(0).Max());
    var maxReason = Math.Max(1, Model.ReasonsForLeaving.Values.DefaultIfEmpty(0).Max());

    string BandColour(string band) => band switch
    {
        "good" => "linear-gradient(90deg,#34d399,#059669)",
        "fair" => "linear-gradient(90deg,#fbbf24,#f59e0b)",
        _ => "linear-gradient(90deg,#f87171,#dc2626)"
    };
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div style="display:flex; gap:.9rem; align-items:flex-start;">
                    <a asp-action="Hr" class="btn-back"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-chart-line"></i> Workforce Analytics</h1>
                        <p class="page-sub">
                            Headcount, turnover, tenure and what the interviews have been telling you
                        </p>
                    </div>
                </div>
                <div class="head-actions">
                    <a asp-controller="Employees" asp-action="Index" class="btn-ghost-hr">
                        <i class="fas fa-address-book"></i> Register
                    </a>
                    <button type="button" class="btn-outline-hr" onclick="window.print()">
                        <i class="fas fa-print"></i> Print
                    </button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <form method="get" class="toolbar">
                    <div class="fg">
                        <label class="lbl">From</label>
                        <input type="date" name="from" class="inp" value="@Model.From.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="fg">
                        <label class="lbl">To</label>
                        <input type="date" name="to" class="inp" value="@Model.To.ToString("yyyy-MM-dd")" />
                    </div>
                    <button type="submit" class="btn-hr"><i class="fas fa-magnifying-glass"></i> Apply</button>
                    <a asp-action="Workforce" class="btn-ghost-hr">Last 12 months</a>
                    <span class="meta" style="margin-left:auto;">
                        @Model.From.ToString("d MMM yyyy") – @Model.To.ToString("d MMM yyyy")
                    </span>
                </form>
            </div>
        </div>

        @* ── HEADLINE ────────────────────────────────────────────────────── *@
        <div class="stats">
            <div class="stat">
                <div class="ic brand"><i class="fas fa-users"></i></div>
                <div><h3>@Model.Headcount</h3><p>Headcount today</p></div>
            </div>
            <div class="stat">
                <div class="ic green"><i class="fas fa-user-plus"></i></div>
                <div>
                    <h3>@Model.StartedInPeriod</h3>
                    <p>Starters</p>
                    <span class="sub">net @(Model.NetChange >= 0 ? "+" : "")@Model.NetChange</span>
                </div>
            </div>
            <div class="stat">
                <div class="ic red"><i class="fas fa-user-minus"></i></div>
                <div><h3>@Model.LeftInPeriod</h3><p>Leavers</p></div>
            </div>
            <div class="stat">
                <div class="ic amber"><i class="fas fa-arrows-rotate"></i></div>
                <div>
                    <h3>@Model.TurnoverPercent%</h3>
                    <p>Turnover</p>
                    <span class="sub">@Model.VoluntaryTurnoverPercent% voluntary</span>
                </div>
            </div>
            <div class="stat">
                <div class="ic teal"><i class="fas fa-hourglass-half"></i></div>
                <div>
                    <h3>@Model.AverageTenureYears yrs</h3>
                    <p>Average tenure</p>
                    <span class="sub">leavers averaged @Model.AverageLeaverTenureYears yrs</span>
                </div>
            </div>
            <div class="stat">
                <div class="ic purple"><i class="fas fa-person-walking-arrow-right"></i></div>
                <div>
                    <h3>@Model.FirstYearLeavers</h3>
                    <p>Left within a year</p>
                </div>
            </div>
        </div>

        @if (Model.FirstYearLeavers > 0 && Model.LeftInPeriod > 0
             && Model.FirstYearLeavers * 100.0 / Model.LeftInPeriod >= 30)
        {
            <div class="notice warn">
                <h4><i class="fas fa-triangle-exclamation"></i> Early attrition is high</h4>
                <p>
                    @Model.FirstYearLeavers of @Model.LeftInPeriod leavers
                    (@((int)Math.Round(Model.FirstYearLeavers * 100.0 / Model.LeftInPeriod))%)
                    left inside their first year. That usually points at hiring or onboarding
                    rather than at retention.
                </p>
            </div>
        }

        @* ── DATA QUALITY ────────────────────────────────────────────────── *@
        @if (Model.WithoutManager > 0 || Model.MissingEmergencyContact > 0
             || Model.ProbationDue > 0 || Model.ContractsExpiring > 0)
        {
            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-list-check"></i> Needs attention</span></div>
                <div class="card-body">
                    <div class="dl">
                        @if (Model.ProbationDue > 0)
                        {
                            <div><div class="k">Probations ending within 30 days</div><div class="v">@Model.ProbationDue</div></div>
                        }
                        @if (Model.ContractsExpiring > 0)
                        {
                            <div><div class="k">Contracts expiring within 60 days</div><div class="v">@Model.ContractsExpiring</div></div>
                        }
                        @if (Model.WithoutManager > 0)
                        {
                            <div><div class="k">Employees with no manager set</div><div class="v">@Model.WithoutManager</div></div>
                        }
                        @if (Model.MissingEmergencyContact > 0)
                        {
                            <div><div class="k">No emergency contact on record</div><div class="v">@Model.MissingEmergencyContact</div></div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ── MOVEMENT ────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-chart-column"></i> Starters and leavers by month</span>
            </div>
            <div class="card-body">
                @if (Model.StartersByMonth.Count == 0)
                {
                    <p class="meta">No movement recorded in this period.</p>
                }
                else
                {
                    <div style="display:flex; align-items:flex-end; gap:.5rem; height:190px; padding-top:.5rem;">
                        @for (var i = 0; i < Model.StartersByMonth.Count; i++)
                        {
                            var starters = Model.StartersByMonth[i];
                            var leavers = i < Model.LeaversByMonth.Count ? Model.LeaversByMonth[i].Value : 0;
                            <div style="flex:1; display:flex; flex-direction:column; justify-content:flex-end; align-items:center; gap:.3rem; height:100%;">
                                <div style="display:flex; gap:2px; align-items:flex-end; width:100%; justify-content:center; height:100%;">
                                    <div title="@starters.Value starter(s)"
                                         style="width:45%; max-width:20px; min-height:2px; border-radius:4px 4px 0 0;
                                                background:linear-gradient(180deg,#34d399,#059669);
                                                height:@(starters.Value * 100 / maxStarters)%"></div>
                                    <div title="@leavers leaver(s)"
                                         style="width:45%; max-width:20px; min-height:2px; border-radius:4px 4px 0 0;
                                                background:linear-gradient(180deg,#f87171,#dc2626);
                                                height:@(leavers * 100 / maxStarters)%"></div>
                                </div>
                                <span style="font-size:.62rem; color:var(--gray-500); white-space:nowrap;">@starters.Label</span>
                            </div>
                        }
                    </div>
                    <div style="display:flex; gap:1.25rem; margin-top:.75rem; font-size:.78rem; color:var(--gray-600);">
                        <span><i class="fas fa-square" style="color:#059669;"></i> Starters</span>
                        <span><i class="fas fa-square" style="color:#dc2626;"></i> Leavers</span>
                    </div>
                }
            </div>
        </div>

        <div class="grid-2">
            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-building"></i> Headcount by department</span></div>
                <div class="card-body">
                    @if (Model.HeadcountByDepartment.Count == 0)
                    {
                        <p class="meta">Nobody on the register yet.</p>
                    }
                    @foreach (var d in Model.HeadcountByDepartment)
                    {
                        <div style="display:grid; grid-template-columns:150px 1fr auto; gap:.75rem; align-items:center; margin-bottom:.6rem; font-size:.82rem;">
                            <span style="color:var(--gray-700); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@d.Key</span>
                            <span style="height:14px; background:var(--gray-100); border-radius:999px; overflow:hidden;">
                                <i style="display:block; height:100%; border-radius:999px;
                                          background:linear-gradient(90deg,var(--primary),var(--primary-dark));
                                          width:@(d.Value * 100 / maxDept)%"></i>
                            </span>
                            <strong>@d.Value</strong>
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-hourglass"></i> Tenure profile</span></div>
                <div class="card-body">
                    @{ var maxTenure = Math.Max(1, Model.TenureBands.Values.DefaultIfEmpty(0).Max()); }
                    @foreach (var b in Model.TenureBands)
                    {
                        <div style="display:grid; grid-template-columns:130px 1fr auto; gap:.75rem; align-items:center; margin-bottom:.6rem; font-size:.82rem;">
                            <span style="color:var(--gray-700);">@b.Key</span>
                            <span style="height:14px; background:var(--gray-100); border-radius:999px; overflow:hidden;">
                                <i style="display:block; height:100%; border-radius:999px;
                                          background:linear-gradient(90deg,#60a5fa,#2563eb);
                                          width:@(b.Value * 100 / maxTenure)%"></i>
                            </span>
                            <strong>@b.Value</strong>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── WHY PEOPLE LEAVE ────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-door-open"></i> Why people left</span>
                <span class="meta">
                    @Model.ExitInterviewsHeld interview(s) · @Model.ExitInterviewCoveragePercent% of leavers interviewed
                </span>
            </div>
            <div class="card-body">
                @if (Model.ExitInterviewsHeld == 0)
                {
                    <div class="empty">
                        <i class="fas fa-door-open"></i>
                        <h3>No exit interviews in this period</h3>
                        <p>Reasons for leaving cannot be analysed until interviews are being recorded.</p>
                    </div>
                }
                else
                {
                    @if (Model.ExitInterviewCoveragePercent < 60)
                    {
                        <div class="notice warn">
                            <p>
                                <i class="fas fa-triangle-exclamation"></i>
                                Only @Model.ExitInterviewCoveragePercent% of leavers were interviewed. Read the
                                figures below as indicative rather than representative.
                            </p>
                        </div>
                    }

                    <div class="grid-2">
                        <div>
                            <h4 style="font-size:.85rem; color:var(--gray-700); margin-bottom:.75rem;">Primary reason given</h4>
                            @if (Model.ReasonsForLeaving.Count == 0)
                            {
                                <p class="meta">No reason was recorded on any interview.</p>
                            }
                            @foreach (var r in Model.ReasonsForLeaving)
                            {
                                <div style="display:grid; grid-template-columns:1fr auto; gap:.75rem; align-items:center; margin-bottom:.5rem; font-size:.82rem;">
                                    <span>
                                        <span style="display:block; color:var(--gray-700); margin-bottom:.2rem;">@r.Key</span>
                                        <span style="display:block; height:12px; background:var(--gray-100); border-radius:999px; overflow:hidden;">
                                            <i style="display:block; height:100%; border-radius:999px;
                                                      background:linear-gradient(90deg,#f87171,#dc2626);
                                                      width:@(r.Value * 100 / maxReason)%"></i>
                                        </span>
                                    </span>
                                    <strong>@r.Value</strong>
                                </div>
                            }
                        </div>

                        <div>
                            <h4 style="font-size:.85rem; color:var(--gray-700); margin-bottom:.75rem;">
                                How leavers rated us — weakest first
                            </h4>
                            @foreach (var d in Model.ExitRatings)
                            {
                                <div style="display:grid; grid-template-columns:1fr auto; gap:.75rem; align-items:center; margin-bottom:.5rem; font-size:.82rem;">
                                    <span>
                                        <span style="display:block; color:var(--gray-700); margin-bottom:.2rem;">@d.Name</span>
                                        <span style="display:block; height:12px; background:var(--gray-100); border-radius:999px; overflow:hidden;">
                                            <i style="display:block; height:100%; border-radius:999px; background:@BandColour(d.Band); width:@d.Percent%"></i>
                                        </span>
                                    </span>
                                    <strong title="@d.Responses response(s)">@d.Average.ToString("0.0")</strong>
                                </div>
                            }

                            <div class="dl" style="margin-top:1rem;">
                                <div><div class="k">Would return</div><div class="v">@Model.WouldReturnPercent%</div></div>
                                <div><div class="k">Would recommend us</div><div class="v">@Model.WouldRecommendPercent%</div></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ── ENGAGEMENT ──────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-user-friends"></i> What people still here are saying</span>
                <span class="meta">@Model.StayInterviewsHeld stay interview(s)</span>
            </div>
            <div class="card-body">
                @if (Model.StayInterviewsHeld == 0)
                {
                    <div class="empty">
                        <i class="fas fa-user-friends"></i>
                        <h3>No stay interviews in this period</h3>
                        <p>These are the conversations that surface a problem while it is still fixable.</p>
                    </div>
                }
                else
                {
                    <div class="grid-2">
                        <div>
                            <h4 style="font-size:.85rem; color:var(--gray-700); margin-bottom:.75rem;">Overall engagement</h4>
                            @{ var maxStatus = Math.Max(1, Model.EngagementStatusBreakdown.Values.DefaultIfEmpty(0).Max()); }
                            @foreach (var s in Model.EngagementStatusBreakdown)
                            {
                                <div style="display:grid; grid-template-columns:1fr auto; gap:.75rem; align-items:center; margin-bottom:.5rem; font-size:.82rem;">
                                    <span>
                                        <span style="display:block; color:var(--gray-700); margin-bottom:.2rem;">@s.Key</span>
                                        <span style="display:block; height:12px; background:var(--gray-100); border-radius:999px; overflow:hidden;">
                                            <i style="display:block; height:100%; border-radius:999px;
                                                      background:linear-gradient(90deg,var(--primary),var(--primary-dark));
                                                      width:@(s.Value * 100 / maxStatus)%"></i>
                                        </span>
                                    </span>
                                    <strong>@s.Value</strong>
                                </div>
                            }
                        </div>

                        <div>
                            <h4 style="font-size:.85rem; color:var(--gray-700); margin-bottom:.75rem;">
                                Rated dimensions — weakest first
                            </h4>
                            @foreach (var d in Model.EngagementRatings)
                            {
                                <div style="display:grid; grid-template-columns:1fr auto; gap:.75rem; align-items:center; margin-bottom:.45rem; font-size:.8rem;">
                                    <span>
                                        <span style="display:block; color:var(--gray-700); margin-bottom:.2rem;">@d.Name</span>
                                        <span style="display:block; height:11px; background:var(--gray-100); border-radius:999px; overflow:hidden;">
                                            <i style="display:block; height:100%; border-radius:999px; background:@BandColour(d.Band); width:@d.Percent%"></i>
                                        </span>
                                    </span>
                                    <strong title="@d.Responses response(s)">@d.Percent%</strong>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ── TALENT ──────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-chart-line"></i> Talent</span>
                <span class="meta">@Model.TalentAssessments assessment(s)</span>
            </div>
            <div class="card-body">
                @if (Model.TalentAssessments == 0)
                {
                    <p class="meta">No talent assessments recorded.</p>
                }
                else
                {
                    <div class="grid-2">
                        <div>
                            <h4 style="font-size:.85rem; color:var(--gray-700); margin-bottom:.6rem;">9-box distribution</h4>
                            @foreach (var b in Model.NineBoxDistribution.Take(9))
                            {
                                <div style="display:flex; justify-content:space-between; padding:.3rem 0; border-bottom:1px solid var(--gray-100); font-size:.82rem;">
                                    <span>@b.Key</span><strong>@b.Value</strong>
                                </div>
                            }
                        </div>
                        <div>
                            <h4 style="font-size:.85rem; color:var(--gray-700); margin-bottom:.6rem;">Flight risk</h4>
                            @foreach (var r in Model.FlightRisk)
                            {
                                <div style="display:flex; justify-content:space-between; padding:.3rem 0; border-bottom:1px solid var(--gray-100); font-size:.82rem;">
                                    <span>@r.Key</span><strong>@r.Value</strong>
                                </div>
                            }
                            <h4 style="font-size:.85rem; color:var(--gray-700); margin:1rem 0 .6rem;">Readiness</h4>
                            @foreach (var r in Model.Readiness)
                            {
                                <div style="display:flex; justify-content:space-between; padding:.3rem 0; border-bottom:1px solid var(--gray-100); font-size:.82rem;">
                                    <span>@r.Key</span><strong>@r.Value</strong>
                                </div>
                            }
                        </div>
                    </div>

                    @if (Model.FlightRiskWatchlist.Count > 0)
                    {
                        <h4 style="font-size:.85rem; color:var(--gray-700); margin:1.5rem 0 .6rem;">
                            <i class="fas fa-triangle-exclamation" style="color:var(--warning);"></i>
                            Rated a high flight risk
                        </h4>
                        <table class="tbl">
                            <thead><tr><th>Employee</th><th>Job title</th><th>Department</th><th>9-box</th><th>Assessed</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var f in Model.FlightRiskWatchlist)
                                {
                                    <tr>
                                        <td>
                                            @if (f.EmployeeId.HasValue)
                                            {
                                                <a asp-controller="Employees" asp-action="Details" asp-route-id="@f.EmployeeId" class="strong-link">@f.Name</a>
                                            }
                                            else
                                            {
                                                <span>@f.Name</span>
                                                <span class="chip muted" title="Not yet linked to the employee register">unlinked</span>
                                            }
                                        </td>
                                        <td class="meta">@f.JobTitle</td>
                                        <td class="meta">@f.Department</td>
                                        <td class="meta">@(string.IsNullOrWhiteSpace(f.NineBox) ? "—" : f.NineBox)</td>
                                        <td class="meta">@f.AssessedOn.ToString("d MMM yyyy")</td>
                                        <td style="text-align:right;">
                                            <a asp-controller="TalentIdentification" asp-action="Details" asp-route-id="@f.AssessmentId" class="act view">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>

    </div>
</div>
