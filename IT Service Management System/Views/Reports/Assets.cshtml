@model IT_Service_Management_System.ViewModels.Reports.AssetsReportVM
@{
    ViewData["Title"] = "Assets Report - Axis IT Operations";
    string Money(decimal v) => v.ToString("C0", new System.Globalization.CultureInfo("en-US"));
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-laptop-code me-2" style="color: var(--primary);"></i>
                    Assets Report
                </h1>
                <p class="text-muted mt-2">Inventory status, value and movement</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn-create-ticket" asp-action="Index" style="background: var(--gray-100); color: var(--gray-700);">
                    <i class="fas fa-arrow-left"></i>
                    All Reports
                </a>
                <button class="btn-create-ticket" onclick="window.print()">
                    <i class="fas fa-print"></i>
                    Print
                </button>
            </div>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-boxes-stacked"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Total</div>
                <div class="kpi-label">Total Assets</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-coins"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalValue)</div>
                <div class="kpi-label">Total Purchase Value</div>
            </div>
        </div>
        @foreach (var s in Model.ByStatus.Take(3))
        {
            var iconColor = s.Name == "Issued" ? "warning" :
                           s.Name == "In Repair" ? "violet" :
                           s.Name == "Stolen" ? "danger" :
                           s.Name == "Retired" ? "slate" : "success";
            <div class="kpi-card">
                <div class="kpi-icon @iconColor">
                    <i class="fas fa-tag"></i>
                </div>
                <div class="kpi-body">
                    <div class="kpi-value">@s.Count</div>
                    <div class="kpi-label">@s.Name</div>
                </div>
            </div>
        }
    </div>

    <!-- TWO COLUMN GRID: By Status & By Condition -->
    <div class="two-col-grid">
        <!-- By Status -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-layer-group me-2"></i>
                <span>By Status</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByStatus.Any())
                {
                    var m1 = Max(Model.ByStatus);
                    <div class="bars">
                        @foreach (var s in Model.ByStatus.OrderByDescending(x => x.Count))
                        {
                            var cls = s.Name == "Issued" ? "warning" :
                                     s.Name == "Stolen" ? "danger" :
                                     s.Name == "Retired" ? "slate" :
                                     s.Name == "In Repair" ? "violet" : "success";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(s.Count * 100 / m1)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No status data available</span>
                    </div>
                }
            </div>
        </div>

        <!-- By Condition -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-chart-line me-2"></i>
                <span>By Condition</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByCondition.Any())
                {
                    var m2 = Max(Model.ByCondition);
                    <div class="bars">
                        @foreach (var s in Model.ByCondition.OrderByDescending(x => x.Count))
                        {
                            var cls = s.Name == "Excellent" ? "success" :
                                     s.Name == "Good" ? "primary" :
                                     s.Name == "Fair" ? "warning" :
                                     s.Name == "Poor" ? "danger" : "slate";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(s.Count * 100 / m2)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No condition data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TWO COLUMN GRID: By Holder & By Event Type -->
    <div class="two-col-grid mt-4">
        <!-- Assets by Holder -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-user-tag me-2"></i>
                <span>Assets by Holder</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.ByHolder.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-1"></i> Holder</th>
                                    <th style="text-align:right;"><i class="fas fa-boxes-stacked me-1"></i> Assets</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.ByHolder.OrderByDescending(x => x.Count))
                                {
                                    <tr>
                                        <td><span class="holder-name">@h.Name</span></td>
                                        <td style="text-align:right;">
                                            <span class="asset-count-badge">@h.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No assets currently assigned</span>
                    </div>
                }
            </div>
        </div>

        <!-- Actions Recorded -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-bolt me-2"></i>
                <span>Actions Recorded (by type)</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByEventType.Any())
                {
                    var m3 = Max(Model.ByEventType);
                    <div class="bars">
                        @foreach (var s in Model.ByEventType.OrderByDescending(x => x.Count))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill violet" style="width:@(s.Count * 100 / m3)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No actions recorded</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RECENT ASSET ACTIVITY -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-clock-rotate-left me-2"></i>
                <span>Recent Asset Activity</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.RecentActivity.Count</span> recent activities
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.RecentActivity.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-1"></i> Date &amp; Time</th>
                                <th><i class="fas fa-laptop me-1"></i> Asset</th>
                                <th><i class="fas fa-bolt me-1"></i> Action</th>
                                <th><i class="fas fa-user me-1"></i> User</th>
                                <th><i class="fas fa-chart-line me-1"></i> Condition</th>
                                <th><i class="fas fa-user-cog me-1"></i> By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.RecentActivity.OrderByDescending(x => x.Date))
                            {
                                var eventClass = h.EventType == "Issued" ? "event-issued" :
                                                h.EventType == "Returned" ? "event-returned" :
                                                h.EventType == "Repaired" ? "event-repaired" :
                                                h.EventType == "Disposed" ? "event-disposed" : "event-default";
                                <tr>
                                    <td class="activity-date">@h.Date.ToString("MMM dd, yyyy 'at' h:mm tt")</td>
                                    <td><span class="asset-name">@(h.Asset?.ItemName ?? "—")</span></td>
                                    <td><span class="event-badge @eventClass">@h.EventType</span></td>
                                    <td class="activity-user">@(h.User != null ? $"{h.User.FirstName} {h.User.LastName}" : "—")</td>
                                    <td><span class="condition-badge">@h.Condition</span></td>
                                    <td class="activity-performed">@h.PerformedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No asset activity recorded yet</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== KPI CARDS ===== */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .kpi-card {
        background: white;
        border-radius: 1rem;
        padding: 1.1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.9rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: all 0.3s ease;
    }

        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

        .kpi-icon.primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
        }

        .kpi-icon.success {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

        .kpi-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .kpi-icon.warning {
            background: linear-gradient(135deg, #f5b042, #e6a017);
        }

        .kpi-icon.violet {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

        .kpi-icon.slate {
            background: linear-gradient(135deg, var(--gray-500), var(--gray-600));
        }

    .kpi-body {
        flex: 1;
        min-width: 0;
    }

    .kpi-value {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--gray-800);
        line-height: 1.2;
    }

    .kpi-label {
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--gray-500);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-top: 0.05rem;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

        .data-card.mt-4 {
            margin-top: 1.5rem;
        }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.25rem 1.5rem;
    }

    .ticket-count {
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    /* ===== BARS ===== */
    .bars {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .bar-label {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--gray-600);
        min-width: 70px;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bar-track {
        flex: 1;
        height: 8px;
        background: var(--gray-100);
        border-radius: 1rem;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        border-radius: 1rem;
        transition: width 0.6s ease;
        min-width: 4px;
    }

        .bar-fill.success {
            background: linear-gradient(90deg, #6ee7b7, var(--success));
        }

        .bar-fill.danger {
            background: linear-gradient(90deg, #fca5a5, var(--danger));
        }

        .bar-fill.warning {
            background: linear-gradient(90deg, #fcd34d, var(--warning));
        }

        .bar-fill.violet {
            background: linear-gradient(90deg, #a78bfa, #7c3aed);
        }

        .bar-fill.slate {
            background: linear-gradient(90deg, #94a3b8, var(--gray-600));
        }

        .bar-fill.primary {
            background: linear-gradient(90deg, var(--primary-light), var(--primary));
        }

    .bar-value {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--gray-600);
        min-width: 30px;
        text-align: right;
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 0.75rem 1.2rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.65rem 1.2rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== ASSET SPECIFIC ===== */
    .holder-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    .asset-name {
        font-weight: 500;
        color: var(--gray-700);
    }

    .activity-date {
        font-size: 0.78rem;
        color: var(--gray-500);
        white-space: nowrap;
    }

    .activity-user {
        color: var(--gray-600);
    }

    .activity-performed {
        color: var(--gray-500);
        font-size: 0.8rem;
    }

    /* ===== ASSET COUNT BADGE ===== */
    .asset-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--primary-dark);
        background: #f8dcde;
        border: 1px solid #f0c3c5;
    }

    /* ===== EVENT BADGES ===== */
    .event-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .event-issued {
        background: #fceaeb;
        color: var(--info);
        border: 1px solid #f4ced0;
    }

    .event-returned {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .event-repaired {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .event-disposed {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .event-default {
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
    }

    /* ===== CONDITION BADGE ===== */
    .condition-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
    }

    /* ===== EMPTY STATE MINI ===== */
    .empty-state-mini {
        text-align: center;
        padding: 1.5rem;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .empty-state-mini i {
            font-size: 1.2rem;
            color: var(--gray-400);
        }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .btn-create-ticket {
            display: none !important;
        }

        .data-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
            page-break-inside: avoid;
        }

        .kpi-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
        }

        .bar-fill {
            background: var(--gray-600) !important;
        }
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .two-col-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }

    @@media (max-width: 768px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .kpi-card {
            padding: 0.9rem 1rem;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            font-size: 0.9rem;
        }

        .kpi-value {
            font-size: 1.1rem;
        }

        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .tickets-table td,
        .tickets-table th {
            padding: 0.5rem 0.8rem;
        }

        .bar-label {
            min-width: 50px;
            max-width: 70px;
            font-size: 0.7rem;
        }

        .bar-value {
            font-size: 0.7rem;
            min-width: 25px;
        }

        .activity-date {
            font-size: 0.7rem;
        }
    }

    @@media (max-width: 576px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .tickets-table {
            font-size: 0.75rem;
        }

            .tickets-table td,
            .tickets-table th {
                padding: 0.4rem 0.5rem;
            }

        .event-badge,
        .condition-badge {
            font-size: 0.6rem;
            padding: 0.1rem 0.4rem;
        }

        .bar-label {
            min-width: 40px;
            max-width: 60px;
            font-size: 0.65rem;
        }

        .bar-value {
            font-size: 0.65rem;
            min-width: 20px;
        }

        .activity-date {
            font-size: 0.6rem;
        }

        .activity-performed {
            font-size: 0.65rem;
        }
    }
</style>