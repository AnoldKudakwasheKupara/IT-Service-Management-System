@model IT_Service_Management_System.ViewModels.Reports.AssetsReportVM
@{
    ViewData["Title"] = "Assets Report - Axis IT Operations";
    string Money(decimal v) => v.ToString("C0", new System.Globalization.CultureInfo("en-US"));
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-laptop-code"></i> Assets Report</h1>
            <p class="report-lede">Inventory status, value and movement</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    @* The figures are the same tile used on the hub and the dashboards. Each
       one opens the records behind it, so the report is a way into the data
       rather than a dead end, and the tones follow meaning: amber and rose
       want attention, green is healthy, slate is a neutral total. *@
    <h2 class="sr-only">Key figures</h2>
    <div class="stat-grid is-auto">
        <a class="bento-card is-compact tone-slate" asp-controller="Assets" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-boxes-stacked" aria-hidden="true"></i> Estate</span>
            <h3 class="bento-title">Total assets</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Total</span>
                <span class="bento-stat-label">in the register</span>
            </div>
            <span class="bento-cta">Open register <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        <a class="bento-card is-compact tone-teal" asp-controller="Assets" asp-action="Index">
            <span class="bento-badge"><i class="fas fa-coins" aria-hidden="true"></i> Value</span>
            <h3 class="bento-title">Total purchase value</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Money(Model.TotalValue)</span>
                <span class="bento-stat-label">at recorded cost</span>
            </div>
            <span class="bento-cta">Open register <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
        </a>
        @foreach (var s in Model.ByStatus.Take(3))
        {
            @* Same meaning-led tones as the hub: in repair wants attention, a stolen
               asset is a problem, issued is simply in service, retired is history. *@
            var tone = s.Name == "Issued" ? "tone-violet" :
                       s.Name == "In Repair" ? "tone-amber" :
                       s.Name == "Stolen" ? "tone-rose" :
                       s.Name == "Retired" ? "tone-slate" : "tone-green";
            <a class="bento-card is-compact @tone" asp-controller="Assets" asp-action="Index">
                <span class="bento-badge"><i class="fas fa-tag" aria-hidden="true"></i> Status</span>
                <h3 class="bento-title">@s.Name</h3>
                <div class="bento-figure">
                    <span class="bento-stat">@s.Count</span>
                    <span class="bento-stat-label">of @Model.Total asset@(Model.Total == 1 ? "" : "s")</span>
                </div>
                <span class="bento-cta">Open register <i class="fas fa-arrow-right" aria-hidden="true"></i></span>
            </a>
        }
    </div>


    <!-- TWO COLUMN GRID: By Status & By Condition -->
    <div class="two-col-grid">
        <!-- By Status -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-layer-group me-2"></i>
                <span>By Status</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByStatus.Any())
                {
                    var m1 = Max(Model.ByStatus);
                    <div class="bars">
                        @foreach (var s in Model.ByStatus.OrderByDescending(x => x.Count))
                        {
                            var cls = s.Name == "Issued" ? "warning" :
                                     s.Name == "Stolen" ? "danger" :
                                     s.Name == "Retired" ? "slate" :
                                     s.Name == "In Repair" ? "violet" : "success";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(s.Count * 100 / m1)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No status data available</span>
                    </div>
                }
            </div>
        </div>

        <!-- By Condition -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-chart-line me-2"></i>
                <span>By Condition</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByCondition.Any())
                {
                    var m2 = Max(Model.ByCondition);
                    <div class="bars">
                        @foreach (var s in Model.ByCondition.OrderByDescending(x => x.Count))
                        {
                            var cls = s.Name == "Excellent" ? "success" :
                                     s.Name == "Good" ? "primary" :
                                     s.Name == "Fair" ? "warning" :
                                     s.Name == "Poor" ? "danger" : "slate";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(s.Count * 100 / m2)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No condition data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TWO COLUMN GRID: By Holder & By Event Type -->
    <div class="two-col-grid mt-4">
        <!-- Assets by Holder -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-user-tag me-2"></i>
                <span>Assets by Holder</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.ByHolder.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-1"></i> Holder</th>
                                    <th style="text-align:right;"><i class="fas fa-boxes-stacked me-1"></i> Assets</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model.ByHolder.OrderByDescending(x => x.Count))
                                {
                                    <tr>
                                        <td><span class="holder-name">@h.Name</span></td>
                                        <td style="text-align:right;">
                                            <span class="asset-count-badge">@h.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No assets currently assigned</span>
                    </div>
                }
            </div>
        </div>

        <!-- Actions Recorded -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-bolt me-2"></i>
                <span>Actions Recorded (by type)</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByEventType.Any())
                {
                    var m3 = Max(Model.ByEventType);
                    <div class="bars">
                        @foreach (var s in Model.ByEventType.OrderByDescending(x => x.Count))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill violet" style="width:@(s.Count * 100 / m3)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No actions recorded</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RECENT ASSET ACTIVITY -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-clock-rotate-left me-2"></i>
                <span>Recent Asset Activity</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.RecentActivity.Count</span> recent activities
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.RecentActivity.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-1"></i> Date &amp; Time</th>
                                <th><i class="fas fa-laptop me-1"></i> Asset</th>
                                <th><i class="fas fa-bolt me-1"></i> Action</th>
                                <th><i class="fas fa-user me-1"></i> User</th>
                                <th><i class="fas fa-chart-line me-1"></i> Condition</th>
                                <th><i class="fas fa-user-cog me-1"></i> By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.RecentActivity.OrderByDescending(x => x.Date))
                            {
                                var eventClass = h.EventType == "Issued" ? "event-issued" :
                                                h.EventType == "Returned" ? "event-returned" :
                                                h.EventType == "Repaired" ? "event-repaired" :
                                                h.EventType == "Disposed" ? "event-disposed" : "event-default";
                                <tr>
                                    <td class="activity-date">@h.Date.ToString("MMM dd, yyyy 'at' h:mm tt")</td>
                                    <td><span class="asset-name">@(h.Asset?.ItemName ?? "—")</span></td>
                                    <td><span class="event-badge @eventClass">@h.EventType</span></td>
                                    <td class="activity-user">@(h.User != null ? $"{h.User.FirstName} {h.User.LastName}" : "—")</td>
                                    <td><span class="condition-badge">@h.Condition</span></td>
                                    <td class="activity-performed">@h.PerformedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No asset activity recorded yet</span>
                </div>
            }
        </div>
    </div>
</div>
