@model IT_Service_Management_System.ViewModels.Reports.ItilOverviewVM
@using IT_Service_Management_System.Models.Itsm
@{
    ViewData["Title"] = "ITIL Overview - Reports";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Reports" asp-action="Index" class="btn-back" title="Back to Reports">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-diagram-project me-2" style="color: var(--primary);"></i>
                        ITIL Overview
                    </h1>
                    <p class="text-muted mt-2">Problems, changes and the configuration management database at a glance.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-icon danger">
                <i class="fas fa-bug"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.OpenProblems</h3>
                <p>Open Problems</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.KnownErrors</h3>
                <p>Known Errors</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon violet">
                <i class="fas fa-clipboard-check"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.ChangesAwaitingApproval</h3>
                <p>Awaiting Approval</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fas fa-circle-check"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.ChangeSuccessRate%</h3>
                <p>Change Success Rate</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="fas fa-server"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.TotalCis</h3>
                <p>Configuration Items</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon slate">
                <i class="fas fa-fire"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.CriticalCis</h3>
                <p>Critical CIs</p>
            </div>
        </div>
    </div>

    <!-- DISTRIBUTION BARS -->
    <div class="report-grid">
        @{
            void BarCard(string title, string icon, List<IT_Service_Management_System.ViewModels.Reports.NameCount> data, string colour)
            {
                <div class="data-card">
                    <div class="card-header-custom">
                        <div>
                            <i class="fas @icon me-2" style="color: var(--primary);"></i>
                            <span>@title</span>
                        </div>
                        <div class="ticket-count">
                            <i class="fas fa-chart-simple"></i>
                            <span>@data.Count</span>
                        </div>
                    </div>
                    <div class="card-body-custom">
                        @if (data.Any())
                        {
                            var m = Max(data);
                            <div class="bars">
                                @foreach (var s in data.OrderByDescending(x => x.Count))
                                {
                                    <div class="bar-row">
                                        <div class="bar-label" title="@s.Name">@s.Name</div>
                                        <div class="bar-track">
                                            <div class="bar-fill @colour" style="width: @(s.Count * 100 / m)%"></div>
                                        </div>
                                        <div class="bar-value">@s.Count</div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state-mini">
                                <i class="fas fa-inbox"></i>
                                <span>No data</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        @{
            BarCard("Problems by Status", "fa-bug", Model.ProblemsByStatus, "danger");
        }
        @{
            BarCard("Changes by Status", "fa-arrows-rotate", Model.ChangesByStatus, "violet");
        }
        @{
            BarCard("Changes by Type", "fa-shapes", Model.ChangesByType, "success");
        }
        @{
            BarCard("Changes by Risk", "fa-gauge-high", Model.ChangesByRisk, "warning");
        }
        @{
            BarCard("CIs by Status", "fa-server", Model.CisByStatus, "primary");
        }
        @{
            BarCard("CIs by Criticality", "fa-fire", Model.CisByCriticality, "danger");
        }
    </div>

    <!-- RECENT PROBLEMS + UPCOMING CHANGES -->
    <div class="report-grid">
        <!-- Recent Problems -->
        <div class="data-card">
            <div class="card-header-custom">
                <div>
                    <i class="fas fa-bug me-2" style="color: var(--primary);"></i>
                    <span>Recent Problems</span>
                </div>
                <div class="ticket-count">
                    <i class="fas fa-chart-simple"></i>
                    <span>@Model.RecentProblems.Count</span>
                </div>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.RecentProblems.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-hashtag me-1"></i> Ref</th>
                                    <th><i class="fas fa-heading me-1"></i> Title</th>
                                    <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.RecentProblems.OrderByDescending(x => x.CreatedAt))
                                {
                                    <tr>
                                        <td>
                                            <a class="ref-link" href="/Problems/Details/@p.Id">
                                                PRB-@p.Id.ToString("D5")
                                            </a>
                                        </td>
                                        <td>@p.Title</td>
                                        <td>
                                            @{
                                                var stClass = p.Status switch
                                                {
                                                    ProblemStatus.New => "badge-primary",
                                                    ProblemStatus.Investigating => "badge-warning",
                                                    ProblemStatus.RootCauseIdentified => "badge-warning",
                                                    ProblemStatus.KnownError => "badge-warning",
                                                    ProblemStatus.Resolved => "badge-success",
                                                    ProblemStatus.Closed => "badge-success",
                                                    _ => "badge-gray"
                                                };
                                            }
                                            <span class="status-badge @stClass">@p.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-bug"></i>
                        <span>No problems logged</span>
                        <span style="font-size:0.8rem;color:var(--gray-400);">Recorded problems will appear here.</span>
                    </div>
                }
            </div>
        </div>

        <!-- Upcoming Changes -->
        <div class="data-card">
            <div class="card-header-custom">
                <div>
                    <i class="fas fa-calendar-check me-2" style="color: var(--primary);"></i>
                    <span>Upcoming Changes</span>
                </div>
                <div class="ticket-count">
                    <i class="fas fa-chart-simple"></i>
                    <span>@Model.UpcomingChanges.Count</span>
                </div>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.UpcomingChanges.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-hashtag me-1"></i> Ref</th>
                                    <th><i class="fas fa-heading me-1"></i> Title</th>
                                    <th><i class="fas fa-calendar me-1"></i> Scheduled</th>
                                    <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.UpcomingChanges.OrderBy(x => x.ScheduledStart))
                                {
                                    <tr>
                                        <td>
                                            <a class="ref-link" href="/Changes/Details/@c.Id">
                                                CHG-@c.Id.ToString("D5")
                                            </a>
                                        </td>
                                        <td>@c.Title</td>
                                        <td class="date-cell">
                                            <i class="far fa-calendar-alt"></i>
                                            @(c.ScheduledStart?.ToString("MMM dd, yyyy") ?? "—")
                                        </td>
                                        <td>
                                            @{
                                                var chClass = c.Status switch
                                                {
                                                    ChangeStatus.Draft => "badge-gray",
                                                    ChangeStatus.SubmittedForApproval => "badge-warning",
                                                    ChangeStatus.Approved => "badge-primary",
                                                    ChangeStatus.Scheduled => "badge-primary",
                                                    ChangeStatus.InProgress => "badge-warning",
                                                    ChangeStatus.Implemented => "badge-success",
                                                    ChangeStatus.Closed => "badge-success",
                                                    ChangeStatus.Rejected => "badge-critical",
                                                    ChangeStatus.Failed => "badge-critical",
                                                    ChangeStatus.Cancelled => "badge-critical",
                                                    _ => "badge-gray"
                                                };
                                            }
                                            <span class="status-badge @chClass">@c.Status</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-calendar-check"></i>
                        <span>No upcoming changes</span>
                        <span style="font-size:0.8rem;color:var(--gray-400);">Scheduled changes will appear here.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

        .stat-icon.primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
        }

        .stat-icon.success {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

        .stat-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .stat-icon.warning {
            background: linear-gradient(135deg, #f5b042, #e6a017);
        }

        .stat-icon.violet {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

        .stat-icon.slate {
            background: linear-gradient(135deg, var(--gray-500), var(--gray-600));
        }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ===== REPORT GRID ===== */
    .report-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.25rem 1.5rem;
    }

    .ticket-count {
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== BARS ===== */
    .bars {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .bar-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .bar-label {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--gray-600);
        min-width: 70px;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .bar-track {
        flex: 1;
        height: 8px;
        background: var(--gray-100);
        border-radius: 1rem;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        border-radius: 1rem;
        transition: width 0.6s ease;
        min-width: 4px;
    }

        .bar-fill.primary {
            background: linear-gradient(90deg, var(--primary-light), var(--primary));
        }

        .bar-fill.success {
            background: linear-gradient(90deg, #6ee7b7, var(--success));
        }

        .bar-fill.danger {
            background: linear-gradient(90deg, #fca5a5, var(--danger));
        }

        .bar-fill.warning {
            background: linear-gradient(90deg, #fcd34d, var(--warning));
        }

        .bar-fill.violet {
            background: linear-gradient(90deg, #a78bfa, #7c3aed);
        }

        .bar-fill.slate {
            background: linear-gradient(90deg, #94a3b8, var(--gray-600));
        }

    .bar-value {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--gray-600);
        min-width: 30px;
        text-align: right;
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 0.75rem 1.2rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.65rem 1.2rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== REFERENCE LINK ===== */
    .ref-link {
        color: var(--primary-dark);
        font-weight: 700;
        text-decoration: none;
        font-size: 0.8rem;
        letter-spacing: 0.3px;
        transition: color 0.2s ease;
    }

        .ref-link:hover {
            color: var(--primary);
            text-decoration: underline;
        }

    /* ===== DATE CELL ===== */
    .date-cell {
        color: var(--gray-500);
        font-size: 0.8rem;
        white-space: nowrap;
    }

        .date-cell i {
            margin-right: 0.3rem;
            color: var(--gray-400);
        }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-critical {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    .badge-primary {
        background: #e6f0ff;
        color: var(--info);
        border: 1px solid #cce4ff;
    }

    /* ===== EMPTY STATE MINI ===== */
    .empty-state-mini {
        text-align: center;
        padding: 1.5rem;
        color: var(--gray-500);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
    }

        .empty-state-mini i {
            font-size: 1.5rem;
            color: var(--gray-300);
        }

        .empty-state-mini span {
            font-size: 0.9rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .report-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }

    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .stats-cards {
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.5rem 0.8rem;
        }

        .tickets-table {
            font-size: 0.8rem;
        }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }

        .bar-label {
            min-width: 50px;
            max-width: 70px;
            font-size: 0.7rem;
        }

        .bar-value {
            font-size: 0.7rem;
            min-width: 25px;
        }

        .status-badge {
            font-size: 0.6rem;
            padding: 0.15rem 0.5rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.25rem;
        }

        .stats-cards {
            grid-template-columns: 1fr;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.4rem 0.5rem;
            font-size: 0.7rem;
        }

        .tickets-table th {
            font-size: 0.6rem;
            padding: 0.4rem 0.5rem;
        }

        .status-badge {
            font-size: 0.55rem;
            padding: 0.1rem 0.35rem;
        }

        .ref-link {
            font-size: 0.7rem;
        }

        .date-cell {
            font-size: 0.7rem;
        }

        .bar-label {
            min-width: 40px;
            max-width: 60px;
            font-size: 0.65rem;
        }

        .bar-value {
            font-size: 0.65rem;
            min-width: 20px;
        }

        .empty-state-mini i {
            font-size: 1.2rem;
        }

        .empty-state-mini span {
            font-size: 0.8rem;
        }
    }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .btn-back {
            display: none !important;
        }

        .data-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
            page-break-inside: avoid;
        }

        .stat-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
        }

        .bar-fill {
            background: var(--gray-600) !important;
        }

        .tickets-table tbody tr:hover {
            background-color: transparent !important;
        }
    }
</style>

@await Html.PartialAsync("_ReportExtras")
