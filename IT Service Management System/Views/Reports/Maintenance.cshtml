@model IT_Service_Management_System.ViewModels.Reports.MaintenanceReportVM
@{
    ViewData["Title"] = "Maintenance Report - Axis IT Operations";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-wrench"></i> Maintenance Report</h1>
            <p class="report-lede">Maintenance activity and upcoming schedule</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-clipboard-list"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Total</div>
                <div class="kpi-label">Total Records</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-calendar-day"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.UpcomingCount</div>
                <div class="kpi-label">Upcoming Scheduled</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon violet">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.ByType.Count</div>
                <div class="kpi-label">Maintenance Types</div>
            </div>
        </div>
    </div>

    <!-- BY TYPE CHART -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-layer-group me-2"></i>
            <span>By Type</span>
        </div>
        <div class="card-body-custom">
            @if (Model.ByType.Any())
            {
                var m1 = Max(Model.ByType);
                <div class="bars">
                    @foreach (var s in Model.ByType.OrderByDescending(x => x.Count))
                    {
                        var cls = s.Name == "Preventive" ? "success" :
                                 s.Name == "Corrective" ? "danger" :
                                 s.Name == "Predictive" ? "violet" : "primary";
                        <div class="bar-row">
                            <div class="bar-label" title="@s.Name">@s.Name</div>
                            <div class="bar-track">
                                <div class="bar-fill @cls" style="width:@(s.Count * 100 / m1)%"></div>
                            </div>
                            <div class="bar-value">@s.Count</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No maintenance records yet</span>
                </div>
            }
        </div>
    </div>

    <!-- RECENT MAINTENANCE -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-clock-rotate-left me-2"></i>
                <span>Recent Maintenance</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Recent.Count</span> recent records
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Recent.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-1"></i> Date</th>
                                <th><i class="fas fa-laptop me-1"></i> Asset</th>
                                <th><i class="fas fa-tag me-1"></i> Type</th>
                                <th><i class="fas fa-exclamation-triangle me-1"></i> Problem</th>
                                <th><i class="fas fa-user me-1"></i> By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Recent)
                            {
                                var typeClass = r.MaintenanceType.ToString() == "Preventive" ? "type-preventive" :
                                               r.MaintenanceType.ToString() == "Corrective" ? "type-corrective" :
                                               r.MaintenanceType.ToString() == "Predictive" ? "type-predictive" : "type-default";
                                <tr>
                                    <td class="maintenance-date">@r.MaintenanceDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="asset-name">@(r.AssetName ?? "—")</span></td>
                                    <td><span class="type-badge @typeClass">@r.MaintenanceType</span></td>
                                    <td class="problem-description" title="@(r.ProblemDescription ?? "—")">@(r.ProblemDescription ?? "—")</td>
                                    <td class="technician-name">@(r.EmployeeName ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No maintenance records yet</span>
                </div>
            }
        </div>
    </div>

    <!-- UPCOMING MAINTENANCE -->
    <div class="data-card mt-4">
        <div class="card-header-custom" style="border-left: 4px solid var(--warning);">
            <div>
                <i class="fas fa-calendar-day me-2" style="color: var(--warning);"></i>
                <span>Upcoming Scheduled Maintenance</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Upcoming.Count</span> upcoming
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Upcoming.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-1"></i> Next Date</th>
                                <th><i class="fas fa-laptop me-1"></i> Asset</th>
                                <th><i class="fas fa-tag me-1"></i> Type</th>
                                <th><i class="fas fa-sticky-note me-1"></i> Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Upcoming.OrderBy(x => x.NextMaintenanceDate))
                            {
                                var typeClass = r.MaintenanceType.ToString() == "Preventive" ? "type-preventive" :
                                               r.MaintenanceType.ToString() == "Corrective" ? "type-corrective" :
                                               r.MaintenanceType.ToString() == "Predictive" ? "type-predictive" : "type-default";
                                var daysUntil = (r.NextMaintenanceDate - DateTime.Now)?.Days ?? 0;
                                var urgencyClass = daysUntil <= 7 ? "upcoming-urgent" :
                                                  daysUntil <= 30 ? "upcoming-soon" : "upcoming-normal";
                                <tr class="@urgencyClass">
                                    <td class="upcoming-date">
                                        <span class="date-highlight">@r.NextMaintenanceDate?.ToString("MMM dd, yyyy")</span>
                                        @if (daysUntil <= 7)
                                        {
                                            <span class="urgency-badge urgent">
                                                <i class="fas fa-clock"></i> @daysUntil days
                                            </span>
                                        }
                                        else if (daysUntil <= 30)
                                        {
                                            <span class="urgency-badge soon">
                                                <i class="fas fa-clock"></i> @daysUntil days
                                            </span>
                                        }
                                    </td>
                                    <td><span class="asset-name">@(r.AssetName ?? "—")</span></td>
                                    <td><span class="type-badge @typeClass">@r.MaintenanceType</span></td>
                                    <td class="notes-description" title="@(r.Comments ?? "—")">@(r.Comments ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini success">
                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                    <span>No upcoming maintenance scheduled</span>
                </div>
            }
        </div>
    </div>
</div>
