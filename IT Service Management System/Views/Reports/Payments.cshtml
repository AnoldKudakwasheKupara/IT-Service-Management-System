@model IT_Service_Management_System.ViewModels.Reports.PaymentsReportVM
@{
    ViewData["Title"] = "Payments Report - Axis IT Operations";
    string Money(decimal v) => v.ToString("C", new System.Globalization.CultureInfo("en-US"));
    decimal MaxA(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameAmount> l) => l.Any() ? l.Max(x => x.Amount) : 1m;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-file-invoice-dollar"></i> Payments Report</h1>
            <p class="report-lede">Service payment obligations and status</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-coins"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalAmount)</div>
                <div class="kpi-label">Total Billed</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalPaid)</div>
                <div class="kpi-label">Paid</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalOutstanding)</div>
                <div class="kpi-label">Outstanding</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon danger">
                <i class="fas fa-triangle-exclamation"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Money(Model.TotalOverdue)</div>
                <div class="kpi-label">Overdue</div>
            </div>
        </div>
    </div>

    <!-- TWO COLUMN GRID: Amount by Status & Count by Status -->
    <div class="two-col-grid">
        <!-- Amount by Status -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-chart-bar me-2"></i>
                <span>Amount by Status</span>
            </div>
            <div class="card-body-custom">
                @if (Model.AmountByStatus.Any())
                {
                    var m1 = MaxA(Model.AmountByStatus);
                    <div class="bars">
                        @foreach (var s in Model.AmountByStatus.OrderByDescending(x => x.Amount))
                        {
                            var cls = s.Name == "Paid" ? "success" :
                                     s.Name == "Overdue" ? "danger" : "warning";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(Math.Round(s.Amount * 100 / m1))%"></div>
                                </div>
                                <div class="bar-value">@s.Amount.ToString("N0")</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No payments recorded</span>
                    </div>
                }
            </div>
        </div>

        <!-- Count by Status -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-list-ol me-2"></i>
                <span>Count by Status</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.CountByStatus.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-tag me-1"></i> Status</th>
                                    <th style="text-align:right;"><i class="fas fa-file-invoice me-1"></i> Payments</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.CountByStatus.OrderByDescending(x => x.Count))
                                {
                                    var cls = c.Name == "Paid" ? "status-paid" :
                                             c.Name == "Overdue" ? "status-overdue" : "status-pending";
                                    <tr>
                                        <td><span class="status-badge @cls">@c.Name</span></td>
                                        <td style="text-align:right;">
                                            <span class="payment-count-badge">@c.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- OVERDUE PAYMENTS -->
    <div class="data-card mt-4">
        <div class="card-header-custom" style="border-left: 4px solid var(--danger);">
            <div>
                <i class="fas fa-triangle-exclamation me-2" style="color: var(--danger);"></i>
                <span style="color: var(--danger);">Overdue Payments</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Overdue.Count</span> overdue
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Overdue.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-concierge-bell me-1"></i> Service</th>
                                <th><i class="fas fa-dollar-sign me-1"></i> Amount</th>
                                <th><i class="fas fa-calendar me-1"></i> Due Date</th>
                                <th><i class="fas fa-tag me-1"></i> Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Overdue.OrderBy(x => x.DueDate))
                            {
                                <tr class="overdue-row">
                                    <td><span class="service-name">@p.ServiceName</span></td>
                                    <td><span class="amount-highlight danger">@Money(p.Amount)</span></td>
                                    <td class="overdue-date">@p.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="status-badge status-overdue">@(string.IsNullOrEmpty(p.Status) ? "Pending" : p.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini success">
                    <i class="fas fa-check-circle" style="color: var(--success);"></i>
                    <span>No overdue payments — all caught up! 🎉</span>
                </div>
            }
        </div>
    </div>

    <!-- UPCOMING PAYMENTS -->
    <div class="data-card mt-4">
        <div class="card-header-custom" style="border-left: 4px solid var(--warning);">
            <div>
                <i class="fas fa-calendar-day me-2" style="color: var(--warning);"></i>
                <span>Upcoming Payments (next 30 days)</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Upcoming.Count</span> upcoming
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Upcoming.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-concierge-bell me-1"></i> Service</th>
                                <th><i class="fas fa-dollar-sign me-1"></i> Amount</th>
                                <th><i class="fas fa-calendar me-1"></i> Due Date</th>
                                <th><i class="fas fa-tag me-1"></i> Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Upcoming.OrderBy(x => x.DueDate))
                            {
                                <tr>
                                    <td><span class="service-name">@p.ServiceName</span></td>
                                    <td><span class="amount-highlight">@Money(p.Amount)</span></td>
                                    <td class="upcoming-date">@p.DueDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="status-badge status-pending">@(string.IsNullOrEmpty(p.Status) ? "Pending" : p.Status)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No payments due in the next 30 days</span>
                </div>
            }
        </div>
    </div>
</div>
