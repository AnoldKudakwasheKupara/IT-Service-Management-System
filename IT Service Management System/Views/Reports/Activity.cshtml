@model IT_Service_Management_System.ViewModels.Reports.ActivityReportVM
@{
    ViewData["Title"] = "Activity Report - Axis IT Operations";
    decimal MaxA(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameAmount> l) => l.Any() ? l.Max(x => x.Amount) : 1m;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-tasks me-2" style="color: var(--primary);"></i>
                    Activity Report
                </h1>
                <p class="text-muted mt-2">Time logged across the team</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn-create-ticket" asp-action="Index" style="background: var(--gray-100); color: var(--gray-700);">
                    <i class="fas fa-arrow-left"></i>
                    All Reports
                </a>
                <button class="btn-create-ticket" onclick="window.print()">
                    <i class="fas fa-print"></i>
                    Print
                </button>
            </div>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-list-check"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Total</div>
                <div class="kpi-label">Total Activities</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-clock"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.TotalHours h</div>
                <div class="kpi-label">Total Hours Logged</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-play-circle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Ongoing</div>
                <div class="kpi-label">Ongoing</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Completed</div>
                <div class="kpi-label">Completed</div>
            </div>
        </div>
    </div>

    <!-- TWO COLUMN GRID: Hours by Category & Activities by Category -->
    <div class="two-col-grid">
        <!-- Hours by Category -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-tags me-2"></i>
                <span>Hours by Category</span>
            </div>
            <div class="card-body-custom">
                @if (Model.HoursByCategory.Any())
                {
                    var m1 = MaxA(Model.HoursByCategory);
                    <div class="bars">
                        @foreach (var s in Model.HoursByCategory.OrderByDescending(x => x.Amount))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill primary" style="width:@(Math.Round(s.Amount * 100 / m1))%"></div>
                                </div>
                                <div class="bar-value">@s.Amount h</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No completed activities yet</span>
                    </div>
                }
            </div>
        </div>

        <!-- Activities by Category -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-folder me-2"></i>
                <span>Activities by Category</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.ByCategory.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-tag me-1"></i> Category</th>
                                    <th style="text-align:right;"><i class="fas fa-list-check me-1"></i> Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.ByCategory.OrderByDescending(x => x.Count))
                                {
                                    <tr>
                                        <td><span class="category-name">@c.Name</span></td>
                                        <td style="text-align:right;">
                                            <span class="activity-count-badge">@c.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- HOURS BY USER -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-user-clock me-2"></i>
                <span>Hours by User</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.HoursByUser.Count</span> users (top 10)
            </div>
        </div>
        <div class="card-body-custom">
            @if (Model.HoursByUser.Any())
            {
                var m2 = MaxA(Model.HoursByUser);
                <div class="bars">
                    @foreach (var s in Model.HoursByUser.Take(10).OrderByDescending(x => x.Amount))
                    {
                        <div class="bar-row">
                            <div class="bar-label" title="@s.Name">@s.Name</div>
                            <div class="bar-track">
                                <div class="bar-fill success" style="width:@(Math.Round(s.Amount * 100 / m2))%"></div>
                            </div>
                            <div class="bar-value">@s.Amount h</div>
                        </div>
                    }
                </div>
                @if (Model.HoursByUser.Count > 10)
                {
                    <div class="activity-note">
                        <i class="fas fa-info-circle"></i>
                        Showing top 10 of @Model.HoursByUser.Count users
                    </div>
                }
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No completed activities yet</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== NOTE: This page uses the global Dashboard styles ===== */
    /* All styles are already defined in the shared stylesheets.
           This page only needs minimal local overrides if any. */

    /* ===== LOCAL OVERRIDES (if needed) ===== */
    /* The .activity-note class is specific to this page */
    .activity-note {
        padding: 0.75rem 0.5rem;
        font-size: 0.8rem;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        border-top: 1px solid var(--gray-200);
    }

        .activity-note i {
            color: var(--info);
            font-size: 0.9rem;
        }

    /* ===== RESPONSIVE OVERRIDES ===== */
    @@media (max-width: 992px) {
        .two-col-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }

    @@media (max-width: 768px) {
        .kpi-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .kpi-card {
            padding: 0.9rem 1rem;
        }

        .kpi-icon {
            width: 38px;
            height: 38px;
            font-size: 0.9rem;
        }

        .kpi-value {
            font-size: 1.1rem;
        }

        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .tickets-table td,
        .tickets-table th {
            padding: 0.5rem 0.8rem;
        }

        .bar-label {
            min-width: 50px;
            max-width: 70px;
            font-size: 0.7rem;
        }

        .bar-value {
            font-size: 0.7rem;
            min-width: 35px;
        }
    }

    @@media (max-width: 576px) {
        .kpi-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .tickets-table {
            font-size: 0.75rem;
        }

            .tickets-table td,
            .tickets-table th {
                padding: 0.4rem 0.5rem;
            }

        .bar-label {
            min-width: 40px;
            max-width: 60px;
            font-size: 0.65rem;
        }

        .bar-value {
            font-size: 0.65rem;
            min-width: 30px;
        }

        .activity-count-badge {
            font-size: 0.7rem;
            min-width: 28px;
            padding: 0.1rem 0.4rem;
        }

        .activity-note {
            font-size: 0.7rem;
        }
    }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .btn-create-ticket {
            display: none !important;
        }

        .data-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
            page-break-inside: avoid;
        }

        .kpi-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
        }

        .bar-fill {
            background: var(--gray-600) !important;
        }
    }
</style>
