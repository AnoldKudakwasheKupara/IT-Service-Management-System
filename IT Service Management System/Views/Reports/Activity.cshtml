@model IT_Service_Management_System.ViewModels.Reports.ActivityReportVM
@{
    ViewData["Title"] = "Activity Report - Axis IT Operations";
    decimal MaxA(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameAmount> l) => l.Any() ? l.Max(x => x.Amount) : 1m;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-tasks"></i> Activity Report</h1>
            <p class="report-lede">Time logged across the team</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    @* The figures are the same tile used on the hub and the dashboards. Each
       one is shown rather than linked: this report is itself the only
       admin-wide view of logged time, since /Activity shows the signed-in
       user's own entries for today. The tones follow meaning: amber wants
       attention, green is healthy, slate is a neutral total. *@
    <h2 class="sr-only">Key figures</h2>
    <div class="stat-grid">
        <div class="bento-card is-compact is-static tone-slate">
            <span class="bento-badge"><i class="fas fa-list-check" aria-hidden="true"></i> Entries</span>
            <h3 class="bento-title">Total activities</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Total</span>
                <span class="bento-stat-label">logged in total</span>
            </div>
        </div>
        <div class="bento-card is-compact is-static tone-teal">
            <span class="bento-badge"><i class="fas fa-clock" aria-hidden="true"></i> Time</span>
            <h3 class="bento-title">Total hours logged</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.TotalHours h</span>
                <span class="bento-stat-label">across completed entries</span>
            </div>
        </div>
        <div class="bento-card is-compact is-static @(Model.Ongoing > 0 ? "tone-amber" : "tone-green")">
            <span class="bento-badge"><i class="fas fa-spinner" aria-hidden="true"></i> Running</span>
            <h3 class="bento-title">Ongoing</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Ongoing</span>
                <span class="bento-stat-label">no end time yet</span>
            </div>
        </div>
        <div class="bento-card is-compact is-static tone-green">
            <span class="bento-badge"><i class="fas fa-check-circle" aria-hidden="true"></i> Done</span>
            <h3 class="bento-title">Completed</h3>
            <div class="bento-figure">
                <span class="bento-stat">@Model.Completed</span>
                <span class="bento-stat-label">with an end time recorded</span>
            </div>
        </div>
    </div>


    <!-- TWO COLUMN GRID: Hours by Category & Activities by Category -->
    <div class="two-col-grid">
        <!-- Hours by Category -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-tags me-2"></i>
                <span>Hours by Category</span>
            </div>
            <div class="card-body-custom">
                @if (Model.HoursByCategory.Any())
                {
                    var m1 = MaxA(Model.HoursByCategory);
                    <div class="bars">
                        @foreach (var s in Model.HoursByCategory.OrderByDescending(x => x.Amount))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill primary" style="width:@(Math.Round(s.Amount * 100 / m1))%"></div>
                                </div>
                                <div class="bar-value">@s.Amount h</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No completed activities yet</span>
                    </div>
                }
            </div>
        </div>

        <!-- Activities by Category -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-folder me-2"></i>
                <span>Activities by Category</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.ByCategory.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-tag me-1"></i> Category</th>
                                    <th style="text-align:right;"><i class="fas fa-list-check me-1"></i> Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.ByCategory.OrderByDescending(x => x.Count))
                                {
                                    <tr>
                                        <td><span class="category-name">@c.Name</span></td>
                                        <td style="text-align:right;">
                                            <span class="activity-count-badge">@c.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- HOURS BY USER -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-user-clock me-2"></i>
                <span>Hours by User</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.HoursByUser.Count</span> users (top 10)
            </div>
        </div>
        <div class="card-body-custom">
            @if (Model.HoursByUser.Any())
            {
                var m2 = MaxA(Model.HoursByUser);
                <div class="bars">
                    @foreach (var s in Model.HoursByUser.Take(10).OrderByDescending(x => x.Amount))
                    {
                        <div class="bar-row">
                            <div class="bar-label" title="@s.Name">@s.Name</div>
                            <div class="bar-track">
                                <div class="bar-fill success" style="width:@(Math.Round(s.Amount * 100 / m2))%"></div>
                            </div>
                            <div class="bar-value">@s.Amount h</div>
                        </div>
                    }
                </div>
                @if (Model.HoursByUser.Count > 10)
                {
                    <div class="activity-note">
                        <i class="fas fa-info-circle"></i>
                        Showing top 10 of @Model.HoursByUser.Count users
                    </div>
                }
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No completed activities yet</span>
                </div>
            }
        </div>
    </div>
</div>
