@model IT_Service_Management_System.ViewModels.Reports.TicketsReportVM
@{
    ViewData["Title"] = "Tickets Report - Axis IT Operations";
    int Max(IEnumerable<IT_Service_Management_System.ViewModels.Reports.NameCount> l) => l.Any() ? l.Max(x => x.Count) : 1;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-ticket-alt"></i> Tickets Report</h1>
            <p class="report-lede">Helpdesk ticket breakdown and trends</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon primary">
                <i class="fas fa-ticket-alt"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Total</div>
                <div class="kpi-label">Total Tickets</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon warning">
                <i class="fas fa-folder-open"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Open</div>
                <div class="kpi-label">Open</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon violet">
                <i class="fas fa-spinner"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.InProgress</div>
                <div class="kpi-label">In Progress</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Resolved</div>
                <div class="kpi-label">Resolved</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon slate">
                <i class="fas fa-lock"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.Closed</div>
                <div class="kpi-label">Closed</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon success">
                <i class="fas fa-percent"></i>
            </div>
            <div class="kpi-body">
                <div class="kpi-value">@Model.ResolutionRate%</div>
                <div class="kpi-label">Resolution Rate</div>
            </div>
        </div>
    </div>

    <!-- TWO COLUMN GRID: By Status & By Priority -->
    <div class="two-col-grid">
        <!-- By Status -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-layer-group me-2"></i>
                <span>By Status</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByStatus.Any())
                {
                    var m1 = Max(Model.ByStatus);
                    <div class="bars">
                        @foreach (var s in Model.ByStatus.OrderByDescending(x => x.Count))
                        {
                            var cls = s.Name == "Open" ? "warning" :
                                     s.Name == "InProgress" ? "violet" :
                                     s.Name == "Resolved" ? "success" : "slate";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(s.Count * 100 / m1)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No status data available</span>
                    </div>
                }
            </div>
        </div>

        <!-- By Priority -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-flag me-2"></i>
                <span>By Priority</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByPriority.Any())
                {
                    var m2 = Max(Model.ByPriority);
                    <div class="bars">
                        @foreach (var s in Model.ByPriority.OrderByDescending(x => x.Count))
                        {
                            var cls = s.Name == "Critical" ? "danger" :
                                     s.Name == "High" ? "danger" :
                                     s.Name == "Medium" ? "warning" : "success";
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill @cls" style="width:@(s.Count * 100 / m2)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No priority data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TWO COLUMN GRID: By Category & Top Requesters -->
    <div class="two-col-grid mt-4">
        <!-- By Category -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-tags me-2"></i>
                <span>By Category</span>
            </div>
            <div class="card-body-custom">
                @if (Model.ByCategory.Any())
                {
                    var m3 = Max(Model.ByCategory);
                    <div class="bars">
                        @foreach (var s in Model.ByCategory.OrderByDescending(x => x.Count))
                        {
                            <div class="bar-row">
                                <div class="bar-label" title="@s.Name">@s.Name</div>
                                <div class="bar-track">
                                    <div class="bar-fill primary" style="width:@(s.Count * 100 / m3)%"></div>
                                </div>
                                <div class="bar-value">@s.Count</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No category data available</span>
                    </div>
                }
            </div>
        </div>

        <!-- Top Requesters -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-user-friends me-2"></i>
                <span>Top Requesters</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.TopRequesters.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-1"></i> User</th>
                                    <th style="text-align:right;"><i class="fas fa-ticket-alt me-1"></i> Tickets</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.TopRequesters.OrderByDescending(x => x.Count))
                                {
                                    <tr>
                                        <td><span class="user-name">@r.Name</span></td>
                                        <td style="text-align:right;">
                                            <span class="ticket-count-badge">@r.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-info-circle"></i>
                        <span>No requester data available</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RECENT TICKETS -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-clock-rotate-left me-2"></i>
                <span>Recent Tickets</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Recent.Count</span> recent tickets
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Recent.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-heading me-1"></i> Title</th>
                                <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                                <th><i class="fas fa-flag me-1"></i> Priority</th>
                                <th><i class="fas fa-user me-1"></i> Requester</th>
                                <th><i class="fas fa-calendar me-1"></i> Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Recent)
                            {
                                var statusClass = t.Status.ToString() == "Open" ? "status-open" :
                                                 t.Status.ToString() == "InProgress" ? "status-progress" :
                                                 t.Status.ToString() == "Resolved" ? "status-resolved" : "status-closed";
                                var priorityClass = t.Priority.ToString() == "Critical" ? "priority-critical" :
                                                   t.Priority.ToString() == "High" ? "priority-high" :
                                                   t.Priority.ToString() == "Medium" ? "priority-medium" : "priority-low";
                                <tr>
                                    <td><span class="ticket-title-text">@t.Title</span></td>
                                    <td><span class="status-badge @statusClass">@t.Status</span></td>
                                    <td><span class="priority-badge @priorityClass">@t.Priority</span></td>
                                    <td class="requester-name">@(t.CreatedBy != null ? $"{t.CreatedBy.FirstName} {t.CreatedBy.LastName}" : "—")</td>
                                    <td class="ticket-date">@t.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-info-circle"></i>
                    <span>No tickets recorded yet</span>
                </div>
            }
        </div>
    </div>
</div>
