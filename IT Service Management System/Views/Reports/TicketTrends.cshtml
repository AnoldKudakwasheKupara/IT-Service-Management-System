@model IT_Service_Management_System.ViewModels.Reports.TicketTrendsVM
@{
    ViewData["Title"] = "Ticket Trends - Reports";
    var peak = Model.PeakValue <= 0 ? 1 : Model.PeakValue;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a asp-controller="Reports" asp-action="Index" class="btn-back" title="Back to Reports">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <i class="fas fa-chart-column me-2" style="color: var(--primary);"></i>
                        Ticket Trends (12 months)
                    </h1>
                    <p class="text-muted mt-2">Created vs resolved tickets over the last twelve months.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="fas fa-ticket"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.TotalCreated</h3>
                <p>Total Created</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.TotalResolved</h3>
                <p>Total Resolved</p>
            </div>
        </div>
    </div>

    <!-- CHART -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-chart-column me-2" style="color: var(--primary);"></i>
                <span>Monthly Volume</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Months.Count</span> months
            </div>
        </div>
        <div class="card-body-custom" style="padding-bottom:0;">
            @if (Model.Months.Any())
            {
                <div class="vbar-chart">
                    @foreach (var p in Model.Months)
                    {
                        <div class="vbar-month">
                            <div class="vbar-pair">
                                <div class="vbar created" style="height: @(p.Created * 100 / peak)%" title="@p.Created created"></div>
                                <div class="vbar resolved" style="height: @(p.Resolved * 100 / peak)%" title="@p.Resolved resolved"></div>
                            </div>
                            <div class="vbar-label">@p.Label</div>
                        </div>
                    }
                </div>
                <div class="chart-legend">
                    <span class="legend-item">
                        <span class="legend-swatch created"></span> Created
                    </span>
                    <span class="legend-item">
                        <span class="legend-swatch resolved"></span> Resolved
                    </span>
                </div>
            }
            else
            {
                <div class="empty-state-mini" style="padding:2rem;">
                    <i class="fas fa-chart-column"></i>
                    <span>No data available</span>
                    <span style="font-size:0.8rem;color:var(--gray-400);">Ticket trend data will appear here.</span>
                </div>
            }
        </div>
    </div>

    <!-- DATA TABLE -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-table me-2" style="color: var(--primary);"></i>
                <span>Monthly Breakdown</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Months.Count</span> months
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Months.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-1"></i> Month</th>
                                <th style="text-align:right;"><i class="fas fa-ticket me-1"></i> Created</th>
                                <th style="text-align:right;"><i class="fas fa-check me-1"></i> Resolved</th>
                                <th style="text-align:right;"><i class="fas fa-chart-line me-1"></i> Delta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Months)
                            {
                                var delta = p.Created - p.Resolved;
                                var deltaClass = delta > 0 ? "text-red" : delta < 0 ? "text-green" : "text-gray";
                                var deltaIcon = delta > 0 ? "fa-arrow-up" : delta < 0 ? "fa-arrow-down" : "fa-minus";
                                <tr>
                                    <td><span class="month-label">@p.Label</span></td>
                                    <td style="text-align:right;" class="created-count">@p.Created</td>
                                    <td style="text-align:right;" class="resolved-count">@p.Resolved</td>
                                    <td style="text-align:right;" class="@deltaClass">
                                        <i class="fas @deltaIcon" style="font-size:0.65rem;"></i>
                                        @Math.Abs(delta)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-table"></i>
                    <span>No data available</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

        .stat-icon.primary {
            background: linear-gradient(135deg, var(--primary-light), var(--primary));
        }

        .stat-icon.success {
            background: linear-gradient(135deg, #2c9e6e, #227a55);
        }

        .stat-icon.danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
        }

        .stat-icon.warning {
            background: linear-gradient(135deg, #f5b042, #e6a017);
        }

        .stat-icon.violet {
            background: linear-gradient(135deg, #8b5cf6, #7c3aed);
        }

        .stat-icon.slate {
            background: linear-gradient(135deg, var(--gray-500), var(--gray-600));
        }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

        .data-card.mt-4 {
            margin-top: 1.5rem;
        }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .card-body-custom {
        padding: 1.25rem 1.5rem;
    }

    .ticket-count {
        font-size: 0.8rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== VERTICAL BAR CHART ===== */
    .vbar-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 260px;
        padding: 1.5rem 1.5rem 0;
        overflow-x: auto;
    }

    .vbar-month {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        flex: 1;
        min-width: 44px;
        height: 100%;
    }

    .vbar-pair {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        flex: 1;
        width: 100%;
        justify-content: center;
        height: 100%;
        padding-bottom: 0.25rem;
    }

    .vbar {
        width: 14px;
        border-radius: 4px 4px 0 0;
        min-height: 2px;
        transition: height 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .vbar.created {
            background: linear-gradient(180deg, var(--primary-light), var(--primary));
        }

        .vbar.resolved {
            background: linear-gradient(180deg, #48bb78, #2c9e6e);
        }

    .vbar-label {
        font-size: 0.68rem;
        color: var(--gray-500);
        font-weight: 600;
        white-space: nowrap;
    }

    /* ===== CHART LEGEND ===== */
    .chart-legend {
        display: flex;
        gap: 1.25rem;
        padding: 0.75rem 1.5rem 1.25rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8rem;
        color: var(--gray-600);
        font-weight: 500;
    }

    .legend-swatch {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        flex-shrink: 0;
    }

        .legend-swatch.created {
            background: var(--primary);
        }

        .legend-swatch.resolved {
            background: #2c9e6e;
        }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 0.75rem 1.2rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.65rem 1.2rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== MONTH SPECIFIC ===== */
    .month-label {
        font-weight: 600;
        color: var(--gray-700);
    }

    .created-count {
        font-weight: 500;
        color: var(--gray-700);
    }

    .resolved-count {
        font-weight: 600;
        color: var(--success);
    }

    .text-green {
        color: var(--success);
    }

    .text-red {
        color: var(--danger);
    }

    .text-gray {
        color: var(--gray-400);
    }

    /* ===== EMPTY STATE MINI ===== */
    .empty-state-mini {
        text-align: center;
        padding: 1.5rem;
        color: var(--gray-500);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
    }

        .empty-state-mini i {
            font-size: 1.5rem;
            color: var(--gray-300);
        }

        .empty-state-mini span {
            font-size: 0.9rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .stats-cards {
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .vbar-chart {
            height: 200px;
            gap: 0.5rem;
            padding: 1rem 1rem 0;
        }

        .vbar {
            width: 10px;
        }

        .vbar-label {
            font-size: 0.6rem;
        }

        .chart-legend {
            padding: 0.5rem 1rem 1rem;
            gap: 0.75rem;
        }

        .legend-item {
            font-size: 0.7rem;
        }

        .legend-swatch {
            width: 10px;
            height: 10px;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.5rem 0.8rem;
        }

        .tickets-table {
            font-size: 0.8rem;
        }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.25rem;
        }

        .stats-cards {
            grid-template-columns: 1fr;
        }

        .vbar-chart {
            height: 160px;
            gap: 0.35rem;
            padding: 0.75rem 0.75rem 0;
        }

        .vbar {
            width: 8px;
        }

        .vbar-label {
            font-size: 0.55rem;
        }

        .chart-legend {
            gap: 0.5rem;
            padding: 0.25rem 0.75rem 0.75rem;
        }

        .legend-item {
            font-size: 0.65rem;
        }

        .legend-swatch {
            width: 8px;
            height: 8px;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.4rem 0.5rem;
            font-size: 0.7rem;
        }

        .tickets-table th {
            font-size: 0.6rem;
            padding: 0.4rem 0.5rem;
        }

        .empty-state-mini i {
            font-size: 1.2rem;
        }

        .empty-state-mini span {
            font-size: 0.8rem;
        }
    }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .btn-back {
            display: none !important;
        }

        .data-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
            page-break-inside: avoid;
        }

        .stat-card {
            box-shadow: none !important;
            border: 1px solid var(--gray-300) !important;
        }

        .vbar {
            transition: none !important;
        }

        .tickets-table tbody tr:hover {
            background-color: transparent !important;
        }

        .vbar.created {
            background: var(--gray-600) !important;
        }

        .vbar.resolved {
            background: var(--gray-400) !important;
        }

        .legend-swatch.created {
            background: var(--gray-600) !important;
        }

        .legend-swatch.resolved {
            background: var(--gray-400) !important;
        }
    }
</style>

@await Html.PartialAsync("_ReportExtras")
