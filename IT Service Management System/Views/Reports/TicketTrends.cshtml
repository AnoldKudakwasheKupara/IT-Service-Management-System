@model IT_Service_Management_System.ViewModels.Reports.TicketTrendsVM
@{
    ViewData["Title"] = "Ticket Trends - Reports";
    var peak = Model.PeakValue <= 0 ? 1 : Model.PeakValue;
}

<div class="report-shell">
    <div class="report-masthead">
        <div>
            <div class="report-eyebrow"><i class="fas fa-chart-pie"></i> Reports</div>
            <h1><i class="fas fa-chart-column"></i> Ticket Trends (12 months)</h1>
            <p class="report-lede">Created vs resolved tickets over the last twelve months.</p>
        </div>
        <div class="report-actions">
            <a class="report-btn" asp-controller="Reports" asp-action="Index">
                <i class="fas fa-arrow-left"></i> All reports
            </a>
            <button type="button" class="report-btn primary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="fas fa-ticket"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.TotalCreated</h3>
                <p>Total Created</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.TotalResolved</h3>
                <p>Total Resolved</p>
            </div>
        </div>
    </div>

    <!-- CHART -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-chart-column me-2" style="color: var(--primary);"></i>
                <span>Monthly Volume</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Months.Count</span> months
            </div>
        </div>
        <div class="card-body-custom" style="padding-bottom:0;">
            @if (Model.Months.Any())
            {
                <div class="vbar-chart">
                    @foreach (var p in Model.Months)
                    {
                        <div class="vbar-month">
                            <div class="vbar-pair">
                                <div class="vbar created" style="height: @(p.Created * 100 / peak)%" title="@p.Created created"></div>
                                <div class="vbar resolved" style="height: @(p.Resolved * 100 / peak)%" title="@p.Resolved resolved"></div>
                            </div>
                            <div class="vbar-label">@p.Label</div>
                        </div>
                    }
                </div>
                <div class="chart-legend">
                    <span class="legend-item">
                        <span class="legend-swatch created"></span> Created
                    </span>
                    <span class="legend-item">
                        <span class="legend-swatch resolved"></span> Resolved
                    </span>
                </div>
            }
            else
            {
                <div class="empty-state-mini" style="padding:2rem;">
                    <i class="fas fa-chart-column"></i>
                    <span>No data available</span>
                    <span style="font-size:0.8rem;color:var(--gray-400);">Ticket trend data will appear here.</span>
                </div>
            }
        </div>
    </div>

    <!-- DATA TABLE -->
    <div class="data-card mt-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-table me-2" style="color: var(--primary);"></i>
                <span>Monthly Breakdown</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Months.Count</span> months
            </div>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Months.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-calendar me-1"></i> Month</th>
                                <th style="text-align:right;"><i class="fas fa-ticket me-1"></i> Created</th>
                                <th style="text-align:right;"><i class="fas fa-check me-1"></i> Resolved</th>
                                <th style="text-align:right;"><i class="fas fa-chart-line me-1"></i> Delta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Months)
                            {
                                var delta = p.Created - p.Resolved;
                                var deltaClass = delta > 0 ? "text-red" : delta < 0 ? "text-green" : "text-gray";
                                var deltaIcon = delta > 0 ? "fa-arrow-up" : delta < 0 ? "fa-arrow-down" : "fa-minus";
                                <tr>
                                    <td><span class="month-label">@p.Label</span></td>
                                    <td style="text-align:right;" class="created-count">@p.Created</td>
                                    <td style="text-align:right;" class="resolved-count">@p.Resolved</td>
                                    <td style="text-align:right;" class="@deltaClass">
                                        <i class="fas @deltaIcon" style="font-size:0.65rem;"></i>
                                        @Math.Abs(delta)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-table"></i>
                    <span>No data available</span>
                </div>
            }
        </div>
    </div>
</div>
