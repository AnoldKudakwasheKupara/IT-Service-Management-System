@* Shared extras for ITSM report pages. Core classes (page-container, stats-cards,
   stat-card, data-card, data-table, status-badge, badge-*, btn-back, empty-state)
   are global in wwwroot/css/site.css. This adds only chart / layout helpers. *@
<style>
    .table-responsive { overflow-x: auto; }
    .card-body-custom { padding: 1.25rem 1.5rem; }

    .text-green { color: var(--success); font-weight: 700; }
    .text-red { color: var(--danger); font-weight: 700; }
    .text-amber { color: #b45309; font-weight: 700; }

    /* Summary grid */
    .summary-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1px; background: var(--gray-200);
    }
    .summary-item {
        background: white; padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.25rem;
    }
    .summary-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--gray-500); font-weight: 600; }
    .summary-value { font-size: 1.4rem; font-weight: 700; color: var(--gray-800); }

    /* Horizontal bars (distributions) */
    .bars { display: flex; flex-direction: column; gap: 0.6rem; }
    .bar-row { display: grid; grid-template-columns: 150px 1fr 44px; align-items: center; gap: 0.75rem; }
    .bar-label { font-size: 0.8rem; color: var(--gray-600); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
    .bar-track { height: 10px; background: var(--gray-100); border-radius: 1rem; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 1rem; background: linear-gradient(90deg, var(--primary), var(--primary-light)); min-width: 2px; transition: width 0.8s ease; }
    .bar-fill.green { background: linear-gradient(90deg, #2c9e6e, #48bb78); }
    .bar-fill.amber { background: linear-gradient(90deg, #f5b042, #fcd9a3); }
    .bar-fill.red { background: linear-gradient(90deg, #e53e3e, #fca5a5); }
    .bar-fill.violet { background: linear-gradient(90deg, #6366f1, #a5b4fc); }
    .bar-value { font-size: 0.8rem; font-weight: 700; color: var(--gray-700); text-align: right; }

    .empty-state-sm { text-align: center; padding: 1.5rem; color: var(--gray-400); font-size: 0.875rem; }
    .empty-state-sm i { font-size: 1.5rem; display: block; margin-bottom: 0.5rem; color: var(--gray-300); }
    .empty-state-sm p { margin: 0; }

    /* Report grid for small cards */
    .report-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem; }

    /* Avatar for agent lists */
    .list-avatar {
        width: 32px; height: 32px; border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: white; font-weight: 600; font-size: 0.72rem; display: inline-flex;
        align-items: center; justify-content: center; text-transform: uppercase; flex-shrink: 0;
    }
    .agent-cell { display: flex; align-items: center; gap: 0.6rem; }
    .agent-cell span { font-weight: 500; color: var(--gray-800); }

    .csat-star { color: #f5b042; font-size: 0.7rem; }
    .ref-link { color: var(--primary-dark); font-weight: 700; text-decoration: none; font-size: 0.8rem; letter-spacing: 0.3px; }
    .ref-link:hover { text-decoration: underline; }
    .date-cell { color: var(--gray-500); font-size: 0.8rem; white-space: nowrap; }
    .date-cell i { margin-right: 0.3rem; color: var(--gray-400); }

    /* Vertical bar chart (ticket trends) */
    .vbar-chart {
        display: flex; align-items: flex-end; gap: 0.75rem; height: 260px;
        padding: 1.5rem 1.5rem 0; overflow-x: auto;
    }
    .vbar-month { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; flex: 1; min-width: 44px; height: 100%; }
    .vbar-pair { display: flex; align-items: flex-end; gap: 3px; flex: 1; width: 100%; justify-content: center; }
    .vbar {
        width: 14px; border-radius: 4px 4px 0 0; min-height: 2px; transition: height 0.8s ease;
        position: relative;
    }
    .vbar.created { background: linear-gradient(180deg, var(--primary-light), var(--primary)); }
    .vbar.resolved { background: linear-gradient(180deg, #48bb78, #2c9e6e); }
    .vbar-label { font-size: 0.68rem; color: var(--gray-500); font-weight: 600; white-space: nowrap; }

    .chart-legend { display: flex; gap: 1.25rem; padding: 0 1.5rem 1.25rem; flex-wrap: wrap; }
    .legend-item { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; color: var(--gray-600); font-weight: 500; }
    .legend-swatch { width: 14px; height: 14px; border-radius: 4px; }
    .legend-swatch.created { background: var(--primary); }
    .legend-swatch.resolved { background: #2c9e6e; }

    @@media (max-width: 820px) {
        .report-grid { grid-template-columns: 1fr; }
        .bar-row { grid-template-columns: 110px 1fr 40px; }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.bar-fill').forEach(function (bar, i) {
            var w = bar.style.width;
            bar.style.width = '0%';
            setTimeout(function () { bar.style.width = w; }, 100 + i * 40);
        });
        document.querySelectorAll('.vbar').forEach(function (bar, i) {
            var h = bar.style.height;
            bar.style.height = '0%';
            setTimeout(function () { bar.style.height = h; }, 120 + i * 25);
        });
    });
</script>
