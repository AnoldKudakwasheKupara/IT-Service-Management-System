@* Shared extras for ITSM report pages. Core classes (page-container, stats-cards,
   stat-card, data-card, data-table, status-badge, badge-*, btn-back, empty-state)
   are global in wwwroot/css/site.css. This adds only chart / layout helpers. *@

<style>
    /* ===== TABLE HELPERS ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .card-body-custom {
        padding: 1.25rem 1.5rem;
    }

    /* ===== TEXT COLORS ===== */
    .text-green {
        color: var(--success);
        font-weight: 700;
    }

    .text-red {
        color: var(--danger);
        font-weight: 700;
    }

    .text-amber {
        color: #b45309;
        font-weight: 700;
    }

    /* ===== SUMMARY GRID ===== */
    .summary-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1px;
        background: var(--gray-200);
        border-radius: 0.75rem;
        overflow: hidden;
        border: 1px solid var(--gray-200);
    }

    .summary-item {
        background: white;
        padding: 1rem 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        transition: background-color 0.2s ease;
    }

        .summary-item:hover {
            background: var(--gray-50);
        }

    .summary-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray-500);
        font-weight: 600;
    }

    .summary-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--gray-800);
        line-height: 1.2;
    }

    /* ===== HORIZONTAL BARS ===== */
    .bars {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .bar-row {
        display: grid;
        grid-template-columns: 150px 1fr 44px;
        align-items: center;
        gap: 0.75rem;
    }

    .bar-label {
        font-size: 0.8rem;
        color: var(--gray-600);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 500;
    }

    .bar-track {
        height: 10px;
        background: var(--gray-100);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.04);
    }

    .bar-fill {
        height: 100%;
        border-radius: 1rem;
        background: linear-gradient(90deg, var(--primary), var(--primary-light));
        min-width: 2px;
        transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .bar-fill.green {
            background: linear-gradient(90deg, #2c9e6e, #48bb78);
        }

        .bar-fill.amber {
            background: linear-gradient(90deg, #f5b042, #fcd9a3);
        }

        .bar-fill.red {
            background: linear-gradient(90deg, #e53e3e, #fca5a5);
        }

        .bar-fill.violet {
            background: linear-gradient(90deg, #6366f1, #a5b4fc);
        }

        .bar-fill.teal {
            background: linear-gradient(90deg, #0d9488, #5eead4);
        }

    .bar-value {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--gray-700);
        text-align: right;
    }

    /* ===== EMPTY STATE SMALL ===== */
    .empty-state-sm {
        text-align: center;
        padding: 1.5rem;
        color: var(--gray-400);
        font-size: 0.875rem;
    }

        .empty-state-sm i {
            font-size: 1.5rem;
            display: block;
            margin-bottom: 0.5rem;
            color: var(--gray-300);
        }

        .empty-state-sm p {
            margin: 0;
        }

    /* ===== REPORT GRID ===== */
    .report-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 1.5rem;
    }

    /* ===== AVATAR ===== */
    .list-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        color: white;
        font-weight: 600;
        font-size: 0.72rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

        .list-avatar:hover {
            transform: scale(1.05);
        }

    .agent-cell {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

        .agent-cell span {
            font-weight: 500;
            color: var(--gray-800);
        }

    /* ===== CSAT STAR ===== */
    .csat-star {
        color: #f5b042;
        font-size: 0.7rem;
    }

    /* ===== REFERENCE LINK ===== */
    .ref-link {
        color: var(--primary-dark);
        font-weight: 700;
        text-decoration: none;
        font-size: 0.8rem;
        letter-spacing: 0.3px;
        transition: color 0.2s ease;
    }

        .ref-link:hover {
            color: var(--primary);
            text-decoration: underline;
        }

    /* ===== DATE CELL ===== */
    .date-cell {
        color: var(--gray-500);
        font-size: 0.8rem;
        white-space: nowrap;
    }

        .date-cell i {
            margin-right: 0.3rem;
            color: var(--gray-400);
        }

    /* ===== VERTICAL BAR CHART ===== */
    .vbar-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 260px;
        padding: 1.5rem 1.5rem 0;
        overflow-x: auto;
    }

    .vbar-month {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        flex: 1;
        min-width: 44px;
        height: 100%;
    }

    .vbar-pair {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        flex: 1;
        width: 100%;
        justify-content: center;
        height: 100%;
        padding-bottom: 0.25rem;
    }

    .vbar {
        width: 14px;
        border-radius: 4px 4px 0 0;
        min-height: 2px;
        transition: height 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .vbar.created {
            background: linear-gradient(180deg, var(--primary-light), var(--primary));
        }

        .vbar.resolved {
            background: linear-gradient(180deg, #48bb78, #2c9e6e);
        }

    .vbar-label {
        font-size: 0.68rem;
        color: var(--gray-500);
        font-weight: 600;
        white-space: nowrap;
    }

    /* ===== CHART LEGEND ===== */
    .chart-legend {
        display: flex;
        gap: 1.25rem;
        padding: 0 1.5rem 1.25rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.8rem;
        color: var(--gray-600);
        font-weight: 500;
    }

    .legend-swatch {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        flex-shrink: 0;
    }

        .legend-swatch.created {
            background: var(--primary);
        }

        .legend-swatch.resolved {
            background: #2c9e6e;
        }

        .legend-swatch.amber {
            background: var(--warning);
        }

        .legend-swatch.violet {
            background: var(--violet);
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 820px) {
        .report-grid {
            grid-template-columns: 1fr;
        }

        .bar-row {
            grid-template-columns: 110px 1fr 40px;
            gap: 0.5rem;
        }

        .bar-label {
            font-size: 0.72rem;
        }

        .bar-value {
            font-size: 0.72rem;
        }

        .vbar-chart {
            height: 200px;
            gap: 0.5rem;
            padding: 1rem 1rem 0;
        }

        .vbar {
            width: 10px;
        }

        .vbar-label {
            font-size: 0.6rem;
        }

        .summary-grid {
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        }

        .summary-value {
            font-size: 1.2rem;
        }
    }

    @@media (max-width: 576px) {
        .bar-row {
            grid-template-columns: 80px 1fr 34px;
            gap: 0.4rem;
        }

        .bar-label {
            font-size: 0.65rem;
        }

        .bar-value {
            font-size: 0.65rem;
        }

        .bar-track {
            height: 8px;
        }

        .vbar-chart {
            height: 160px;
            gap: 0.35rem;
            padding: 0.75rem 0.75rem 0;
        }

        .vbar {
            width: 8px;
        }

        .vbar-label {
            font-size: 0.55rem;
        }

        .chart-legend {
            gap: 0.75rem;
            padding: 0 0.75rem 0.75rem;
        }

        .legend-item {
            font-size: 0.7rem;
        }

        .legend-swatch {
            width: 10px;
            height: 10px;
        }

        .summary-grid {
            grid-template-columns: 1fr 1fr;
            gap: 1px;
        }

        .summary-item {
            padding: 0.75rem 1rem;
        }

        .summary-value {
            font-size: 1.1rem;
        }

        .summary-label {
            font-size: 0.6rem;
        }

        .empty-state-sm {
            padding: 1rem;
            font-size: 0.8rem;
        }

            .empty-state-sm i {
                font-size: 1.2rem;
            }
    }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .vbar-chart {
            height: 200px;
        }

        .vbar {
            transition: none !important;
        }

        .bar-fill {
            transition: none !important;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Animate horizontal bars
        document.querySelectorAll('.bar-fill').forEach(function (bar, i) {
            var w = bar.style.width;
            bar.style.width = '0%';
            setTimeout(function () {
                bar.style.width = w;
            }, 100 + i * 40);
        });

        // Animate vertical bars
        document.querySelectorAll('.vbar').forEach(function (bar, i) {
            var h = bar.style.height;
            bar.style.height = '0%';
            setTimeout(function () {
                bar.style.height = h;
            }, 120 + i * 25);
        });

        // Intersection Observer for bars (staggered animation on scroll)
        if ('IntersectionObserver' in window) {
            var barObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        var bar = entry.target;
                        var w = bar.getAttribute('data-width');
                        if (w) {
                            bar.style.width = w;
                            bar.removeAttribute('data-width');
                        }
                        barObserver.unobserve(bar);
                    }
                });
            }, { threshold: 0.3 });

            document.querySelectorAll('.bar-fill:not([style*="width"])').forEach(function (bar) {
                var computedStyle = window.getComputedStyle(bar);
                var width = computedStyle.width;
                if (width && width !== '0px' && width !== 'auto') {
                    bar.style.width = '0%';
                    bar.setAttribute('data-width', width);
                    barObserver.observe(bar);
                }
            });

            var vbarObserver = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        var bar = entry.target;
                        var h = bar.getAttribute('data-height');
                        if (h) {
                            bar.style.height = h;
                            bar.removeAttribute('data-height');
                        }
                        vbarObserver.unobserve(bar);
                    }
                });
            }, { threshold: 0.3 });

            document.querySelectorAll('.vbar:not([style*="height"])').forEach(function (bar) {
                var computedStyle = window.getComputedStyle(bar);
                var height = computedStyle.height;
                if (height && height !== '0px' && height !== 'auto') {
                    bar.style.height = '0%';
                    bar.setAttribute('data-height', height);
                    vbarObserver.observe(bar);
                }
            });
        }
    });
</script>
