@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<Competency>
@{
    ViewData["Title"] = "Competency Matrix";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var users = ViewBag.Users as List<User> ?? new();
    var categories = ViewBag.Categories as List<string> ?? new();
    var category = ViewBag.Category as string;

    Func<CompetencyLevel, string> levelClass = l => l switch
    {
        CompetencyLevel.Expert => "b-published",
        CompetencyLevel.Advanced => "b-high",
        CompetencyLevel.Intermediate => "b-medium",
        CompetencyLevel.Basic => "b-internal",
        _ => "b-low"
    };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-table-cells"></i> Competency Matrix</h1>
                        <p class="page-sub">Skills assessed against employees — level vs. required level (ISO cl. 7.2)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-list-check"></i></div><div><h3>@ViewBag.CompetencyCount</h3><p>Competencies</p></div></div>
            <div class="stat"><div class="ic teal"><i class="fas fa-user-check"></i></div><div><h3>@ViewBag.AssessmentCount</h3><p>Assessments</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.MeetingCount</h3><p>Meeting Requirement</p></div></div>
            <div class="stat"><div class="ic red"><i class="fas fa-circle-exclamation"></i></div><div><h3>@ViewBag.GapCount</h3><p>Competency Gaps</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <select class="inp" name="category" onchange="this.form.submit()">
                <option value="">All categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat" selected="@(category == cat)">@cat</option>
                }
            </select>
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-filter"></i> Filter</button>
        </form>

        @if (canManage)
        {
            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-plus"></i> Add Competency</span></div>
                <div class="card-body">
                    <form method="post" asp-action="AddCompetency">
                        @Html.AntiForgeryToken()
                        <div class="form-grid three">
                            <div class="fg">
                                <label class="lbl"><i class="fas fa-tag"></i> Name <span class="req">*</span></label>
                                <input class="inp" name="Name" required placeholder="e.g. Incident Response" />
                            </div>
                            <div class="fg">
                                <label class="lbl"><i class="fas fa-folder"></i> Category</label>
                                <input class="inp" name="Category" list="catList" placeholder="e.g. Security" />
                                <datalist id="catList">
                                    @foreach (var cat in categories) { <option value="@cat"></option> }
                                </datalist>
                            </div>
                            <div class="fg">
                                <label class="lbl"><i class="fas fa-align-left"></i> Description</label>
                                <input class="inp" name="Description" placeholder="Optional" />
                            </div>
                        </div>
                        <div class="form-actions">
                            <button class="btn-primary-ims" type="submit"><i class="fas fa-plus"></i> Add Competency</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (Model.Any())
        {
            foreach (var c in Model)
            {
                var assessments = c.Assessments.OrderBy(a => a.User != null ? a.User.FirstName : "").ToList();
                <div class="card">
                    <div class="card-head">
                        <span class="t"><i class="fas fa-list-check"></i> @c.Name
                            @if (!string.IsNullOrWhiteSpace(c.Category)) { <span class="badge-ims b-internal">@c.Category</span> }
                            @if (!c.IsActive) { <span class="badge-ims b-archived">Inactive</span> }
                        </span>
                        <span class="meta">@assessments.Count assessed</span>
                    </div>
                    <div class="card-body" style="padding:0;">
                        @if (!string.IsNullOrWhiteSpace(c.Description))
                        {
                            <p class="meta" style="padding:.85rem 1.25rem 0;margin:0;">@c.Description</p>
                        }
                        @if (assessments.Any())
                        {
                            <table class="tbl">
                                <thead><tr><th>Employee</th><th>Current Level</th><th>Required</th><th>Status</th><th>Assessed</th><th>By</th><th>Expiry</th></tr></thead>
                                <tbody>
                                    @foreach (var a in assessments)
                                    {
                                        <tr>
                                            <td>@(a.User?.FullName ?? $"User #{a.UserId}")</td>
                                            <td><span class="badge-ims @levelClass(a.Level)">@a.Level</span></td>
                                            <td><span class="badge-ims b-low">@a.RequiredLevel</span></td>
                                            <td>
                                                @if (a.MeetsRequirement)
                                                {
                                                    <span class="badge-ims b-published"><i class="fas fa-check"></i> Meets</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-ims b-rejected"><i class="fas fa-xmark"></i> Gap</span>
                                                }
                                            </td>
                                            <td class="meta">@(a.AssessedDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                            <td class="meta">@(a.AssessedBy?.FullName ?? "—")</td>
                                            <td class="@(a.ExpiryDate.HasValue && a.ExpiryDate.Value.Date < DateTime.Now.Date ? "overdue" : "meta")">@(a.ExpiryDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="empty" style="padding:1.5rem;"><i class="fas fa-user-slash"></i><h3>No one assessed yet</h3></div>
                        }

                        @if (canManage)
                        {
                            <form method="post" asp-action="AssessUser" style="padding:1rem;border-top:1px solid var(--gray-200);">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="CompetencyId" value="@c.Id" />
                                <label class="lbl" style="margin-bottom:.6rem;"><i class="fas fa-user-check"></i> Assess an Employee</label>
                                <div class="form-grid three">
                                    <div class="fg">
                                        <label class="lbl">Employee <span class="req">*</span></label>
                                        <select class="inp" name="UserId" required>
                                            <option value="">— Select employee —</option>
                                            @foreach (var u in users) { <option value="@u.Id">@u.FullName</option> }
                                        </select>
                                    </div>
                                    <div class="fg">
                                        <label class="lbl">Assessed Level</label>
                                        <select class="inp" name="Level" asp-items="Html.GetEnumSelectList<CompetencyLevel>()"></select>
                                    </div>
                                    <div class="fg">
                                        <label class="lbl">Required Level</label>
                                        <select class="inp" name="RequiredLevel" asp-items="Html.GetEnumSelectList<CompetencyLevel>()"></select>
                                    </div>
                                    <div class="fg">
                                        <label class="lbl">Assessed Date</label>
                                        <input class="inp" type="date" name="AssessedDate" />
                                    </div>
                                    <div class="fg">
                                        <label class="lbl">Revalidation / Expiry</label>
                                        <input class="inp" type="date" name="ExpiryDate" />
                                    </div>
                                    <div class="fg">
                                        <label class="lbl">Notes</label>
                                        <input class="inp" name="Notes" placeholder="Optional" />
                                    </div>
                                </div>
                                <div class="form-actions">
                                    <button class="btn-ghost-ims" type="submit"><i class="fas fa-check"></i> Record Assessment</button>
                                </div>
                                <span class="hint">Re-assessing an existing employee updates their record.</span>
                            </form>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card"><div class="card-body">
                <div class="empty">
                    <i class="fas fa-table-cells"></i>
                    <h3>No competencies defined</h3>
                    @if (!canManage) { <p class="meta">Ask a Quality Manager to define the competency matrix.</p> }
                </div>
            </div></div>
        }
    </div>
</div>
