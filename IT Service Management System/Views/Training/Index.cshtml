@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<TrainingCourse>
@{
    ViewData["Title"] = "Training & Competency";
    var type = ViewBag.Type as TrainingType?;
    var canManage = (bool)(ViewBag.CanManage ?? false);
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-graduation-cap"></i> Training &amp; Competency</h1>
                    <p class="page-sub">Training register and competency matrix — ISO 9001/27001 clause 7.2</p>
                </div>
                <div class="head-actions">
                    <a class="btn-outline-ims" asp-action="Competency"><i class="fas fa-table-cells"></i> Competency Matrix</a>
                    @if (canManage)
                    {
                        <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> New Course</a>
                    }
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-graduation-cap"></i></div><div><h3>@ViewBag.CourseCount</h3><p>Courses</p></div></div>
            <div class="stat"><div class="ic teal"><i class="fas fa-clipboard-user"></i></div><div><h3>@ViewBag.RecordCount</h3><p>Training Records</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.CompletionPct%</h3><p>Completion Rate</p></div></div>
            <div class="stat"><div class="ic red"><i class="fas fa-triangle-exclamation"></i></div><div><h3>@ViewBag.ExpiringCerts</h3><p>Expiring Certificates</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <input class="inp" type="text" name="q" value="@ViewBag.Query" placeholder="Search title, provider…" />
            <select class="inp" name="type" onchange="this.form.submit()">
                <option value="">All types</option>
                @foreach (TrainingType t in Enum.GetValues(typeof(TrainingType)))
                {
                    <option value="@t" selected="@(type == t)">@t</option>
                }
            </select>
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-magnifying-glass"></i> Filter</button>
        </form>

        <div class="card">
            <div class="card-body" style="padding:0;">
                @if (Model.Any())
                {
                    <table class="tbl">
                        <thead>
                            <tr><th>Ref</th><th>Title</th><th>Type</th><th>Standard</th><th>Provider</th><th>Hours</th><th>Records</th><th>Linked Doc</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                var expiring = c.Records.Count(r => r.IsCertificateExpired || r.IsCertificateExpiringSoon);
                                <tr>
                                    <td><span class="docnum">@c.Reference</span></td>
                                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.Title</a></td>
                                    <td class="meta">@c.Type</td>
                                    <td class="meta">@IsoStandards.Label(c.Standard)</td>
                                    <td class="meta">@(c.Provider ?? "—")</td>
                                    <td class="meta">@c.DurationHours.ToString("0.#")</td>
                                    <td>
                                        <span class="badge-ims b-internal">@c.Records.Count</span>
                                        @if (expiring > 0)
                                        {
                                            <span class="badge-ims b-overdue"><i class="fas fa-triangle-exclamation"></i> @expiring</span>
                                        }
                                    </td>
                                    <td class="meta">@(c.LinkedDocument?.DocumentNumber ?? "—")</td>
                                    <td>
                                        <div class="act-btns">
                                            <a class="act view" asp-action="Details" asp-route-id="@c.Id" title="Open"><i class="fas fa-eye"></i></a>
                                            @if (canManage)
                                            {
                                                <a class="act edit" asp-action="Edit" asp-route-id="@c.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-graduation-cap"></i>
                        <h3>No training courses found</h3>
                        @if (canManage)
                        {
                            <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Create the first one</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
