@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model TrainingCourse
@{
    ViewData["Title"] = "New Training Course";
    var documents = ViewBag.Documents as List<IsoDocument> ?? new();
}
<partial name="_ImsStyles" />

<div class="ims narrow">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-graduation-cap"></i> New Training Course</h1>
                        <p class="page-sub">Define a course or programme — attendance is recorded per employee.</p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    <div class="form-grid">
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
                            <input class="inp" asp-for="Title" required />
                            <span asp-validation-for="Title" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-layer-group"></i> Type</label>
                            <select class="inp" asp-for="Type" asp-items="Html.GetEnumSelectList<TrainingType>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
                            <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-building"></i> Provider</label>
                            <input class="inp" asp-for="Provider" placeholder="Internal or external provider" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-clock"></i> Duration (hours)</label>
                            <input class="inp" type="number" step="0.5" min="0" asp-for="DurationHours" />
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-link"></i> Linked Policy / Document</label>
                            <select class="inp" asp-for="LinkedDocumentId">
                                <option value="">— None —</option>
                                @foreach (var d in documents)
                                {
                                    <option value="@d.Id" selected="@(Model.LinkedDocumentId == d.Id)">@d.DocumentNumber — @d.Title</option>
                                }
                            </select>
                            <span class="hint">Link the controlled document this training covers (optional).</span>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-align-left"></i> Description</label>
                            <textarea class="inp" asp-for="Description" rows="3" placeholder="Objectives and scope of the training"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Create Course</button>
                        <a class="btn-ghost-ims" asp-action="Index">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
