@model IT_Service_Management_System.Models.CannedResponse

@{
    ViewData["Title"] = "Delete Canned Response - Axis IT Helpdesk";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-trash-alt me-2" style="color: var(--danger);"></i>
                    Delete Canned Response
                </h1>
                <p class="text-muted mt-2">This action cannot be undone</p>
            </div>
        </div>
    </div>

    <!-- CONFIRMATION CARD -->
    <div class="data-card">
        <div class="card-header-custom" style="border-left: 4px solid var(--danger);">
            <i class="fas fa-exclamation-triangle me-2" style="color: var(--danger);"></i>
            <span style="color: var(--danger);">Confirm Deletion</span>
        </div>

        <div class="card-body-custom">
            <!-- Warning Banner -->
            <div class="warning-banner">
                <i class="fas fa-exclamation-circle"></i>
                <span>Are you sure you want to permanently delete this canned response?</span>
            </div>

            <!-- Details -->
            <div class="detail-row">
                <span class="detail-label"><i class="fas fa-heading"></i> Title</span>
                <span class="detail-value">@Model.Title</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="fas fa-align-left"></i> Body</span>
                <div class="body-preview">@Model.Body</div>
            </div>

            <!-- Form Actions -->
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-delete-confirm">
                    <i class="fas fa-trash-alt"></i>
                    Delete
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-body-custom {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    /* ===== WARNING BANNER ===== */
    .warning-banner {
        background: #fef2f2;
        border-left: 4px solid var(--danger);
        border-radius: 0.5rem;
        padding: 0.9rem 1rem;
        color: #991b1b;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
    }

        .warning-banner i {
            font-size: 1.1rem;
            color: var(--danger);
            flex-shrink: 0;
        }

    /* ===== DETAIL ROW ===== */
    .detail-row {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .detail-label {
        font-weight: 600;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--gray-400);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .detail-label i {
            font-size: 0.65rem;
            color: var(--gray-400);
            width: 16px;
            text-align: center;
        }

    .detail-value {
        font-size: 0.95rem;
        color: var(--gray-800);
        font-weight: 600;
        padding: 0.25rem 0;
    }

    .body-preview {
        font-weight: 400;
        white-space: pre-wrap;
        color: var(--gray-600);
        background: var(--gray-50);
        border: 1px solid var(--gray-200);
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        line-height: 1.6;
        max-height: 200px;
        overflow-y: auto;
    }

    /* ===== FORM ACTIONS ===== */
    .form-actions {
        display: flex;
        gap: 1rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--gray-200);
        flex-wrap: wrap;
    }

    /* ===== DELETE BUTTON ===== */
    .btn-delete-confirm {
        background: linear-gradient(100deg, #dc2626, var(--danger));
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
        flex: 1;
        justify-content: center;
        box-shadow: var(--shadow-sm);
    }

        .btn-delete-confirm:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    /* ===== CANCEL BUTTON ===== */
    .btn-cancel {
        background: white;
        color: var(--gray-600);
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s;
        border: 1.5px solid var(--gray-200);
        font-size: 0.875rem;
        font-family: inherit;
        cursor: pointer;
        flex: 1;
        justify-content: center;
    }

        .btn-cancel:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
            color: var(--gray-700);
            text-decoration: none;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .card-body-custom {
            padding: 1.25rem;
        }

        .form-actions {
            flex-direction: column;
        }

            .form-actions .btn-delete-confirm,
            .form-actions .btn-cancel {
                flex: none;
                width: 100%;
                padding: 0.65rem 1.5rem;
            }

        .btn-back {
            width: 34px;
            height: 34px;
            font-size: 0.8rem;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.25rem;
        }

        .card-body-custom {
            padding: 1rem;
        }

        .btn-delete-confirm,
        .btn-cancel {
            font-size: 0.8rem;
            padding: 0.55rem 1.25rem;
        }

        .detail-value {
            font-size: 0.85rem;
        }

        .body-preview {
            font-size: 0.8rem;
            padding: 0.5rem 0.75rem;
            max-height: 150px;
        }

        .warning-banner {
            font-size: 0.8rem;
            padding: 0.75rem;
        }
    }
</style>

