@model IEnumerable<IT_Service_Management_System.Models.CannedResponse>

@{
    ViewData["Title"] = "Canned Replies - Axis IT Helpdesk";
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-reply-all me-2" style="color: var(--primary);"></i>
                    Canned Replies
                </h1>
                <p class="text-muted mt-2">Reusable reply snippets staff can insert into ticket conversations</p>
            </div>
            <a asp-action="Create" class="btn-create-ticket">
                <i class="fas fa-plus-circle me-2"></i>
                New Canned Response
            </a>
        </div>
    </div>

    <!-- MAIN CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-list me-2"></i>
                <span>Canned Response List</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count()</span> response(s) found
            </div>
        </div>

        <div class="table-responsive">
            @if (Model != null && Model.Any())
            {
                <table class="data-table tickets-table" id="cannedTable">
                    <thead>
                        <tr>
                            <th><i class="fas fa-heading me-1"></i> Title</th>
                            <th><i class="fas fa-align-left me-1"></i> Body Preview</th>
                            <th><i class="fas fa-calendar me-1"></i> Created</th>
                            <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(x => x.CreatedAt))
                        {
                            var preview = item.Body?.Length > 80 ? item.Body.Substring(0, 80) + "..." : item.Body ?? "-";
                            <tr>
                                <td>
                                    <div class="canned-title-cell">
                                        <div class="canned-icon">
                                            <i class="fas fa-reply"></i>
                                        </div>
                                        <div>
                                            <strong>@item.Title</strong>
                                        </div>
                                    </div>
                                </td>
                                <td class="body-preview-cell" title="@item.Body">@preview</td>
                                <td class="created-date">
                                    <i class="far fa-calendar-alt"></i>
                                    @item.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="action-buttons">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Edit Canned Response">
                                        <i class="fas fa-pencil-alt"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Delete Canned Response">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-reply-all"></i>
                    <h3>No canned responses yet</h3>
                    <p>Get started by adding your first reusable reply snippet</p>
                    <a asp-action="Create" class="btn-create-ticket-sm">
                        <i class="fas fa-plus-circle"></i> New Canned Response
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-create-ticket-sm {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .btn-create-ticket-sm:hover {
            transform: translateY(-2px);
            color: white;
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.9rem 1.5rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* ===== CANNED RESPONSE SPECIFIC ===== */
    .canned-title-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .canned-icon {
        width: 36px;
        height: 36px;
        background: linear-gradient(135deg, var(--primary), var(--primary-light));
        border-radius: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .canned-title-cell strong {
        color: var(--gray-800);
        font-size: 0.95rem;
    }

    .body-preview-cell {
        max-width: 480px;
        color: var(--gray-500);
        font-size: 0.85rem;
        cursor: help;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .created-date {
        color: var(--gray-500);
        font-size: 0.85rem;
        white-space: nowrap;
    }

        .created-date i {
            color: var(--gray-400);
            margin-right: 0.25rem;
        }

    /* ===== ACTION BUTTONS ===== */
    .action-buttons {
        display: flex;
        gap: 0.25rem;
        justify-content: flex-end;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        background: transparent;
    }

    .btn-edit {
        background: var(--gray-100);
        color: var(--warning);
    }

        .btn-edit:hover {
            background: var(--warning);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-delete {
        background: var(--gray-100);
        color: var(--danger);
    }

        .btn-delete:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--gray-500);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--gray-300);
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--gray-600);
        }

        .empty-state p {
            margin-bottom: 1.5rem;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.6rem 0.8rem;
        }

        .tickets-table {
            font-size: 0.8rem;
        }

        .action-btn {
            width: 30px;
            height: 30px;
            font-size: 0.7rem;
        }

        .canned-icon {
            width: 30px;
            height: 30px;
            font-size: 0.75rem;
        }

        .canned-title-cell strong {
            font-size: 0.85rem;
        }

        .body-preview-cell {
            max-width: 120px;
        }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.4rem 0.5rem;
            font-size: 0.7rem;
        }

        .body-preview-cell {
            max-width: 60px;
        }

        .created-date {
            font-size: 0.7rem;
        }

        .action-btn {
            width: 28px;
            height: 28px;
            font-size: 0.65rem;
        }

        .canned-icon {
            width: 26px;
            height: 26px;
            font-size: 0.65rem;
            border-radius: 0.5rem;
        }

        .canned-title-cell strong {
            font-size: 0.75rem;
        }

        .empty-state i {
            font-size: 3rem;
        }

        .empty-state h3 {
            font-size: 1rem;
        }
    }
</style>

