@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<Capa>
@{
    ViewData["Title"] = "CAPA";
    var canCreate = (bool)(ViewBag.CanCreate ?? false);
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-screwdriver-wrench"></i> Corrective &amp; Preventive Actions</h1>
                    <p class="page-sub">ISO 9001/27001 clause 10.2 — CAPA register</p>
                </div>
                <div class="head-actions">
                    @if (canCreate)
                    {
                        <a class="btn-outline-ims" asp-action="Create" asp-route-type="Preventive"><i class="fas fa-shield"></i> New Preventive</a>
                        <a class="btn-primary-ims" asp-action="Create" asp-route-type="Corrective"><i class="fas fa-plus"></i> New CAPA</a>
                    }
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-list"></i></div><div><h3>@ViewBag.Total</h3><p>Total</p></div></div>
            <div class="stat"><div class="ic amber"><i class="fas fa-folder-open"></i></div><div><h3>@ViewBag.Open</h3><p>Open</p></div></div>
            <div class="stat"><div class="ic red"><i class="fas fa-clock"></i></div><div><h3>@ViewBag.Overdue</h3><p>Overdue</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.Closed</h3><p>Closed</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <select class="inp" name="type" onchange="this.form.submit()">
                <option value="">All types</option>
                @foreach (CapaType t in Enum.GetValues(typeof(CapaType)))
                { <option value="@t" selected="@(ViewBag.Type as CapaType? == t)">@t</option> }
            </select>
            <select class="inp" name="status" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (CapaStatus s in Enum.GetValues(typeof(CapaStatus)))
                { <option value="@s" selected="@(ViewBag.Status as CapaStatus? == s)">@s</option> }
            </select>
        </form>

        <div class="card"><div class="card-body" style="padding:0;">
            @if (Model.Any())
            {
                <table class="tbl">
                    <thead><tr><th>Ref</th><th>Title</th><th>Type</th><th>Source</th><th>Responsible</th><th>Due</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td><span class="docnum">@c.Reference</span></td>
                                <td><a asp-action="Details" asp-route-id="@c.Id">@c.Title</a></td>
                                <td class="meta">@c.Type</td>
                                <td class="meta">@c.Source</td>
                                <td class="meta">@(c.Responsible?.FullName ?? "—")</td>
                                <td class="@(c.IsOverdue ? "overdue" : "meta")">@(c.DueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td><span class="badge-ims @ImsBadges.CapaStatusClass(c.Status)">@c.Status</span></td>
                                <td><a class="act view" asp-action="Details" asp-route-id="@c.Id"><i class="fas fa-eye"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else { <div class="empty"><i class="fas fa-clipboard-check"></i><h3>No CAPAs found</h3></div> }
        </div></div>
    </div>
</div>
