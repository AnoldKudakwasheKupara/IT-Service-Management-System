@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model Capa
@{
    var users = ViewBag.Users as List<User> ?? new();
    var departments = ViewBag.Departments as List<Department> ?? new();
    var ncs = ViewBag.NonConformances as List<NonConformance> ?? new();
    var isEdit = (bool)(ViewData["IsEdit"] ?? false);
}
<div class="form-grid">
    <div class="fg full">
        <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
        <input class="inp" asp-for="Title" required />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-layer-group"></i> Type</label>
        <select class="inp" asp-for="Type" asp-items="Html.GetEnumSelectList<CapaType>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-diagram-project"></i> Source</label>
        <select class="inp" asp-for="Source" asp-items="Html.GetEnumSelectList<CapaSource>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-hashtag"></i> Source Reference</label>
        <input class="inp" asp-for="SourceReference" placeholder="e.g. AUD-00003 / complaint no." />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
        <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-user"></i> Responsible Person</label>
        <select class="inp" asp-for="ResponsibleId"><option value="">— None —</option>
            @foreach (var u in users) { <option value="@u.Id" selected="@(Model.ResponsibleId == u.Id)">@u.FullName</option> }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-building"></i> Department</label>
        <select class="inp" asp-for="DepartmentId"><option value="">— None —</option>
            @foreach (var d in departments) { <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option> }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-day"></i> Due Date</label>
        <input class="inp" type="date" asp-for="DueDate" />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-bug"></i> Linked Non-Conformance</label>
        <select class="inp" asp-for="NonConformanceId"><option value="">— None —</option>
            @foreach (var n in ncs) { <option value="@n.Id" selected="@(Model.NonConformanceId == n.Id)">@n.Reference — @n.Title</option> }
        </select>
    </div>
    @if (isEdit)
    {
        <div class="fg">
            <label class="lbl"><i class="fas fa-flag"></i> Status</label>
            <select class="inp" asp-for="Status" asp-items="Html.GetEnumSelectList<CapaStatus>()"></select>
        </div>
    }
    <div class="fg full">
        <label class="lbl"><i class="fas fa-align-left"></i> Description <span class="req">*</span></label>
        <textarea class="inp" asp-for="Description" rows="2" required></textarea>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-hand"></i> Containment / Immediate Action</label>
        <textarea class="inp" asp-for="Containment" rows="2"></textarea>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-wrench"></i> Correction</label>
        <textarea class="inp" asp-for="Correction" rows="2"></textarea>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-magnifying-glass-chart"></i> Root Cause</label>
        <textarea class="inp" asp-for="RootCause" rows="2"></textarea>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-screwdriver-wrench"></i> Corrective Action</label>
        <textarea class="inp" asp-for="CorrectiveAction" rows="2"></textarea>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-shield"></i> Preventive Action</label>
        <textarea class="inp" asp-for="PreventiveAction" rows="2"></textarea>
    </div>
    @if (isEdit)
    {
        <div class="fg full">
            <label class="lbl"><i class="fas fa-clipboard-check"></i> Effectiveness Review</label>
            <textarea class="inp" asp-for="EffectivenessReview" rows="2"></textarea>
        </div>
        <div class="fg">
            <label class="lbl"><i class="fas fa-calendar-check"></i> Effectiveness Review Date</label>
            <input class="inp" type="date" asp-for="EffectivenessReviewDate" />
        </div>
    }
</div>
