@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<ComplianceObligation>
@{
    ViewData["Title"] = "Compliance Register";
    var canEdit = (bool)(ViewBag.CanEdit ?? false);

    Func<ComplianceStatus, string> statusClass = s => s switch
    {
        ComplianceStatus.Compliant => "b-published",
        ComplianceStatus.NonCompliant => "b-critical",
        ComplianceStatus.PartiallyCompliant or ComplianceStatus.UnderReview => "b-medium",
        _ => "b-draft"
    };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-scale-balanced"></i> Compliance Register</h1>
                    <p class="page-sub">Legal, regulatory &amp; contractual obligations — ISO 9001 cl. 9.1.2 / ISO 27001 A.18</p>
                </div>
                <div class="head-actions">
                    @if (canEdit)
                    {
                        <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> New Obligation</a>
                    }
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-scale-balanced"></i></div><div><h3>@ViewBag.Total</h3><p>Total</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.Compliant</h3><p>Compliant</p></div></div>
            <div class="stat"><div class="ic red"><i class="fas fa-circle-xmark"></i></div><div><h3>@ViewBag.NonCompliant</h3><p>Non-Compliant</p></div></div>
            <div class="stat"><div class="ic amber"><i class="fas fa-clock-rotate-left"></i></div><div><h3>@ViewBag.ReviewDue</h3><p>Review Due</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <input class="inp" type="text" name="q" value="@ViewBag.Query" placeholder="Search title, authority, reference…" />
            <select class="inp" name="type" onchange="this.form.submit()">
                <option value="">All types</option>
                @foreach (ComplianceType t in Enum.GetValues(typeof(ComplianceType)))
                {
                    <option value="@t" selected="@(ViewBag.Type as ComplianceType? == t)">@t</option>
                }
            </select>
            <select class="inp" name="status" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (ComplianceStatus s in Enum.GetValues(typeof(ComplianceStatus)))
                {
                    <option value="@s" selected="@(ViewBag.Status as ComplianceStatus? == s)">@s</option>
                }
            </select>
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-magnifying-glass"></i> Filter</button>
        </form>

        <div class="card">
            <div class="card-body" style="padding:0;">
                @if (Model.Any())
                {
                    <table class="tbl">
                        <thead>
                            <tr><th>Ref</th><th>Obligation</th><th>Type</th><th>Authority</th><th>Owner</th><th>Status</th><th>Next Review</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                <tr>
                                    <td><span class="docnum">@o.Reference</span></td>
                                    <td><a asp-action="Details" asp-route-id="@o.Id">@o.Title</a></td>
                                    <td class="meta">@o.Type</td>
                                    <td class="meta">@(o.Authority ?? "—")</td>
                                    <td class="meta">@(o.Owner?.FullName ?? "—")</td>
                                    <td><span class="badge-ims @statusClass(o.Status)">@o.Status</span></td>
                                    <td class="@(o.IsReviewDue ? "overdue" : "meta")">@(o.NextReviewDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>
                                        <div class="act-btns">
                                            <a class="act view" asp-action="Details" asp-route-id="@o.Id" title="Open"><i class="fas fa-eye"></i></a>
                                            @if (canEdit)
                                            {
                                                <a class="act edit" asp-action="Edit" asp-route-id="@o.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-scale-balanced"></i>
                        <h3>No obligations found</h3>
                        @if (canEdit)
                        {
                            <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Create the first one</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
