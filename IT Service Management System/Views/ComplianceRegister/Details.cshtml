@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model ComplianceObligation
@{
    ViewData["Title"] = Model.Reference;
    var canManage = (bool)(ViewBag.CanManage ?? false);

    string statusClass = Model.Status switch
    {
        ComplianceStatus.Compliant => "b-published",
        ComplianceStatus.NonCompliant => "b-critical",
        ComplianceStatus.PartiallyCompliant or ComplianceStatus.UnderReview => "b-medium",
        _ => "b-draft"
    };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><span class="docnum" style="font-size:1rem;">@Model.Reference</span> &nbsp;@Model.Title</h1>
                        <p class="page-sub">
                            <span class="badge-ims @statusClass">@Model.Status</span>
                            <span class="meta">· @Model.Type · @IsoStandards.Label(Model.Standard)</span>
                            @if (Model.IsReviewDue)
                            {
                                <span class="badge-ims b-overdue"><i class="fas fa-clock-rotate-left"></i> Review due</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="head-actions">
                    @if (canManage)
                    {
                        <a class="btn-ghost-ims" asp-action="Edit" asp-route-id="@Model.Id"><i class="fas fa-pen"></i> Edit</a>
                        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" onsubmit="return confirm('Delete this obligation?');">
                            @Html.AntiForgeryToken()
                            <button class="btn-danger-ims" type="submit"><i class="fas fa-trash"></i> Delete</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="card"><div class="card-body" style="color:var(--success);"><i class="fas fa-circle-check"></i> @TempData["Success"]</div></div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="card"><div class="card-body overdue"><i class="fas fa-triangle-exclamation"></i> @TempData["Error"]</div></div>
        }

        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-circle-info"></i> Obligation Details</span></div>
            <div class="card-body">
                <div class="dl">
                    <div><div class="k">Type</div><div class="v">@Model.Type</div></div>
                    <div><div class="k">ISO Standard</div><div class="v">@IsoStandards.Label(Model.Standard)</div></div>
                    <div><div class="k">Issuing Authority</div><div class="v">@(Model.Authority ?? "—")</div></div>
                    <div><div class="k">Legal / Reg. Reference</div><div class="v">@(Model.LegalReference ?? "—")</div></div>
                    <div><div class="k">Owner</div><div class="v">@(Model.Owner?.FullName ?? "—")</div></div>
                    <div><div class="k">Department</div><div class="v">@(Model.Department?.Name ?? "—")</div></div>
                    <div><div class="k">Status</div><div class="v"><span class="badge-ims @statusClass">@Model.Status</span></div></div>
                    <div><div class="k">Last Assessed</div><div class="v">@(Model.LastAssessedDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
                    <div><div class="k">Next Review</div><div class="v @(Model.IsReviewDue ? "overdue" : "")">@(Model.NextReviewDate?.ToString("dd MMM yyyy") ?? "—")</div></div>
                    <div><div class="k">Created</div><div class="v">@Model.CreatedAt.ToString("dd MMM yyyy")</div></div>
                    <div><div class="k">Created By</div><div class="v">@(Model.CreatedBy?.FullName ?? "—")</div></div>
                </div>
            </div>
        </div>

        <div class="form-grid" style="align-items:start;">
            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-align-left"></i> Description</span></div>
                <div class="card-body">
                    <p style="color:var(--gray-700);margin:0;">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</p>
                </div>
            </div>
            <div class="card">
                <div class="card-head"><span class="t"><i class="fas fa-list-check"></i> Requirement</span></div>
                <div class="card-body">
                    <p style="color:var(--gray-700);margin:0;">@(string.IsNullOrWhiteSpace(Model.Requirement) ? "—" : Model.Requirement)</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-folder-open"></i> Evidence / Notes</span></div>
            <div class="card-body">
                <p style="color:var(--gray-700);margin:0;">@(string.IsNullOrWhiteSpace(Model.EvidenceNotes) ? "—" : Model.EvidenceNotes)</p>
            </div>
        </div>
    </div>
</div>
