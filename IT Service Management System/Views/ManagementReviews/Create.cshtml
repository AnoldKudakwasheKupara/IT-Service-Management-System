@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model ManagementReview
@{
    ViewData["Title"] = "New Management Review";
    var users = ViewBag.Users as List<User> ?? new();
}
<partial name="_ImsStyles" />

<div class="ims narrow">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Index"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-people-group"></i> New Management Review</h1>
                        <p class="page-sub">Schedule a review meeting — inputs can be gathered from live data once created.</p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-body">
                    <div class="form-grid">
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
                            <input class="inp" asp-for="Title" required placeholder="e.g. Q3 2026 Management Review" />
                            <span asp-validation-for="Title" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
                            <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-flag"></i> Status</label>
                            <select class="inp" asp-for="Status" asp-items="Html.GetEnumSelectList<ReviewMeetingStatus>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-calendar-day"></i> Meeting Date</label>
                            <input class="inp" type="datetime-local" asp-for="MeetingDate" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-location-dot"></i> Location</label>
                            <input class="inp" asp-for="Location" placeholder="e.g. Boardroom / Teams" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-user-tie"></i> Chairperson</label>
                            <select class="inp" asp-for="ChairId">
                                <option value="">— None —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-list"></i> Agenda</label>
                            <textarea class="inp" asp-for="AgendaNotes" rows="3" placeholder="Agenda items for the meeting"></textarea>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-gavel"></i> Decisions</label>
                            <textarea class="inp" asp-for="Decisions" rows="3" placeholder="Decisions taken (can be completed after the meeting)"></textarea>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-flag-checkered"></i> Conclusions</label>
                            <textarea class="inp" asp-for="Conclusions" rows="3" placeholder="Overall conclusions on the suitability, adequacy and effectiveness of the system"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Create Review</button>
                        <a class="btn-ghost-ims" asp-action="Index">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
