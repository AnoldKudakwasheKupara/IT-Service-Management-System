@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model ManagementReview
@{
    ViewData["Title"] = Model.Reference;
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var users = ViewBag.Users as List<User> ?? new();

    string StatusClass(ReviewMeetingStatus s) => s switch
    {
        ReviewMeetingStatus.Held or ReviewMeetingStatus.Closed => "badge-success",
        ReviewMeetingStatus.Cancelled => "badge-critical",
        ReviewMeetingStatus.Scheduled => "badge-warning",
        _ => "badge-gray"
    };
    string ActionClass(ManagementReviewAction a)
    {
        if (a.Status == ReviewActionStatus.Completed) return "badge-success";
        if (a.Status == ReviewActionStatus.Cancelled) return "badge-gray";
        if (a.IsOverdue || a.Status == ReviewActionStatus.Overdue) return "badge-critical";
        if (a.Status == ReviewActionStatus.Open) return "badge-warning";
        return "badge-primary";
    }
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <a class="btn-back" asp-action="Index">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="page-title">
                        <span class="doc-number" style="font-size:1rem;font-weight:600;color:var(--primary);">@Model.Reference</span>
                        <span style="font-weight:700;color:var(--gray-800);">@Model.Title</span>
                    </h1>
                    <div class="page-subtitle">
                        <span class="status-badge @StatusClass(Model.Status)">@Model.Status</span>
                        <span class="meta-separator">·</span>
                        <span class="meta-text">@IsoStandards.Label(Model.Standard) · @Model.MeetingDate.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                </div>
            </div>
            @if (canManage)
            {
                <div class="d-flex gap-2">
                    <form method="post" asp-action="GatherInputs" asp-route-id="@Model.Id" onsubmit="return confirm('Regenerate all review inputs from current live data? Existing gathered inputs will be replaced.');" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button class="btn-create-ticket" type="submit" style="background:var(--gray-100);color:var(--gray-700);">
                            <i class="fas fa-arrows-rotate"></i> Gather Inputs
                        </button>
                    </form>
                    <a class="btn-create-ticket" asp-action="Edit" asp-route-id="@Model.Id" style="background:var(--gray-100);color:var(--gray-700);">
                        <i class="fas fa-pen"></i> Edit
                    </a>
                    <a class="btn-danger" asp-action="Delete" asp-route-id="@Model.Id" title="Delete management review">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-flash danger">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <!-- TWO COLUMN GRID: Meeting Details & Attendees -->
    <div class="two-col-grid">
        <!-- MEETING DETAILS -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-circle-info me-2" style="color:var(--primary);"></i>
                <span>Meeting Details</span>
            </div>
            <div class="card-body-custom">
                <div class="details-grid">
                    <div class="detail-item">
                        <div class="detail-label">Reference</div>
                        <div class="detail-value">@Model.Reference</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Status</div>
                        <div class="detail-value">
                            <span class="status-badge @StatusClass(Model.Status)">@Model.Status</span>
                        </div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">ISO Standard</div>
                        <div class="detail-value">@IsoStandards.Label(Model.Standard)</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Meeting Date</div>
                        <div class="detail-value">@Model.MeetingDate.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Location</div>
                        <div class="detail-value">@(Model.Location ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Chairperson</div>
                        <div class="detail-value">@(Model.Chair?.FullName ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Created By</div>
                        <div class="detail-value">@(Model.CreatedBy?.FullName ?? "—")</div>
                    </div>
                    <div class="detail-item">
                        <div class="detail-label">Created</div>
                        <div class="detail-value">@Model.CreatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.AgendaNotes))
                {
                    <div class="narrative-section">
                        <div class="narrative-label">Agenda</div>
                        <div class="narrative-text">@Model.AgendaNotes</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Decisions))
                {
                    <div class="narrative-section">
                        <div class="narrative-label">Decisions</div>
                        <div class="narrative-text">@Model.Decisions</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Conclusions))
                {
                    <div class="narrative-section">
                        <div class="narrative-label">Conclusions</div>
                        <div class="narrative-text">@Model.Conclusions</div>
                    </div>
                }
            </div>
        </div>

        <!-- ATTENDEES -->
        <div class="data-card">
            <div class="card-header-custom">
                <i class="fas fa-users me-2" style="color:var(--primary);"></i>
                <span>Attendees</span>
            </div>
            <div class="card-body-custom" style="padding:0;">
                @if (Model.Attendees.Any())
                {
                    <div class="table-responsive">
                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th><i class="fas fa-user me-1"></i> Attendee</th>
                                    <th><i class="fas fa-tag me-1"></i> Role</th>
                                    <th><i class="fas fa-check me-1"></i> Present</th>
                                    @if (canManage)
                                    {
                                        <th style="text-align:right;"><i class="fas fa-cog me-1"></i></th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.Attendees)
                                {
                                    <tr>
                                        <td class="attendee-name">@(a.User?.FullName ?? "—")</td>
                                        <td class="meta-text">@(a.Role ?? "—")</td>
                                        <td>
                                            @if (a.Present)
                                            {
                                                <span class="status-badge badge-success"><i class="fas fa-check-circle"></i> Present</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge badge-gray"><i class="fas fa-circle"></i> Absent</span>
                                            }
                                        </td>
                                        @if (canManage)
                                        {
                                            <td style="text-align:right;">
                                                <form method="post" asp-action="RemoveAttendee" asp-route-id="@Model.Id" style="display:inline;">
                                                    <input type="hidden" name="attendeeId" value="@a.Id" />
                                                    @Html.AntiForgeryToken()
                                                    <button class="action-btn btn-delete" type="submit" title="Remove">
                                                        <i class="fas fa-xmark"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state-mini">
                        <i class="fas fa-users"></i>
                        <span>No attendees recorded</span>
                    </div>
                }

                @if (canManage)
                {
                    <form method="post" asp-action="AddAttendee" asp-route-id="@Model.Id" class="add-attendee-form">
                        @Html.AntiForgeryToken()
                        <div class="add-attendee-row">
                            <select class="form-control" name="UserId" style="flex:1;min-width:160px;">
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id">@u.FullName</option>
                                }
                            </select>
                            <input class="form-control" name="Role" placeholder="Role (optional)" style="width:auto;" />
                            <label class="present-check">
                                <input type="checkbox" name="Present" value="true" checked /> Present
                            </label>
                            <button class="btn-add-attendee" type="submit">
                                <i class="fas fa-user-plus"></i> Add
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- REVIEW INPUTS -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-layer-group me-2" style="color:var(--primary);"></i>
            <span>Review Inputs (clause 9.3)</span>
            @if (canManage)
            {
                <form method="post" asp-action="GatherInputs" asp-route-id="@Model.Id" onsubmit="return confirm('Regenerate all review inputs from current live data?');" style="display:inline;margin-left:auto;">
                    @Html.AntiForgeryToken()
                    <button class="btn-regenerate" type="submit">
                        <i class="fas fa-arrows-rotate"></i> Regenerate
                    </button>
                </form>
            }
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Inputs.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th style="width:60px;"><i class="fas fa-hashtag me-1"></i> #</th>
                                <th><i class="fas fa-tag me-1"></i> Category</th>
                                <th><i class="fas fa-align-left me-1"></i> Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inp in Model.Inputs.OrderBy(i => i.Sequence))
                            {
                                <tr>
                                    <td class="meta-text" style="text-align:center;">@inp.Sequence</td>
                                    <td><span class="input-category">@inp.Category</span></td>
                                    <td class="input-summary">@inp.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini" style="padding:2rem;">
                    <i class="fas fa-layer-group"></i>
                    <span>No inputs gathered yet</span>
                    @if (canManage)
                    {
                        <form method="post" asp-action="GatherInputs" asp-route-id="@Model.Id" style="margin-top:0.5rem;">
                            @Html.AntiForgeryToken()
                            <button class="btn-gather-inputs" type="submit">
                                <i class="fas fa-arrows-rotate"></i> Gather Inputs from Live Data
                            </button>
                        </form>
                    }
                </div>
            }
        </div>
    </div>

    <!-- ACTION TRACKING -->
    <div class="data-card">
        <div class="card-header-custom">
            <i class="fas fa-list-check me-2" style="color:var(--primary);"></i>
            <span>Action Tracking</span>
        </div>
        <div class="card-body-custom" style="padding:0;">
            @if (Model.Actions.Any())
            {
                <div class="table-responsive">
                    <table class="tickets-table">
                        <thead>
                            <tr>
                                <th><i class="fas fa-hashtag me-1"></i> Reference</th>
                                <th><i class="fas fa-align-left me-1"></i> Description</th>
                                <th><i class="fas fa-user me-1"></i> Assigned To</th>
                                <th><i class="fas fa-calendar me-1"></i> Due</th>
                                <th><i class="fas fa-tag me-1"></i> Status</th>
                                @if (canManage)
                                {
                                    <th style="text-align:right;"><i class="fas fa-cog me-1"></i></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Actions.OrderBy(a => a.Status == ReviewActionStatus.Completed).ThenBy(a => a.DueDate))
                            {
                                var rowClass = a.IsOverdue && a.Status != ReviewActionStatus.Completed ? "row-overdue" : "";
                                <tr class="@rowClass">
                                    <td><span class="doc-number">@a.Reference</span></td>
                                    <td class="action-description">@a.Description</td>
                                    <td class="meta-text">@(a.AssignedTo?.FullName ?? "—")</td>
                                    <td class="@(a.IsOverdue && a.Status != ReviewActionStatus.Completed ? "date-overdue" : "meta-text")">
                                        @(a.DueDate?.ToString("dd MMM yyyy") ?? "—")
                                        @if (a.IsOverdue && a.Status != ReviewActionStatus.Completed)
                                        {
                                            <span class="overdue-badge"><i class="fas fa-exclamation-circle"></i></span>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge @ActionClass(a)">
                                            @if (a.IsOverdue && a.Status != ReviewActionStatus.Completed && a.Status != ReviewActionStatus.Overdue)
                                            {
                                                <i class="fas fa-clock"></i>
                                                <text>Overdue</text>
                                            }
                                            else
                                            {
                                                @a.Status
                                            }
                                        </span>
                                    </td>
                                    @if (canManage)
                                    {
                                        <td style="text-align:right;">
                                            @if (a.Status != ReviewActionStatus.Completed && a.Status != ReviewActionStatus.Cancelled)
                                            {
                                                <form method="post" asp-action="CompleteAction" asp-route-id="@Model.Id" style="display:inline;">
                                                    <input type="hidden" name="actionId" value="@a.Id" />
                                                    @Html.AntiForgeryToken()
                                                    <button class="action-btn btn-complete" type="submit" title="Mark complete">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state-mini">
                    <i class="fas fa-list-check"></i>
                    <span>No actions raised</span>
                </div>
            }

            @if (canManage)
            {
                <form method="post" asp-action="AddAction" asp-route-id="@Model.Id" class="add-action-form">
                    @Html.AntiForgeryToken()
                    <div class="add-action-row">
                        <input class="form-control" name="Description" placeholder="Action description" required style="flex:1;min-width:220px;" />
                        <select class="form-control" name="AssignedToId" style="width:auto;">
                            <option value="">— Assign to —</option>
                            @foreach (var u in users)
                            {
                                <option value="@u.Id">@u.FullName</option>
                            }
                        </select>
                        <input class="form-control" type="date" name="DueDate" style="width:auto;" />
                        <button class="btn-add-action" type="submit">
                            <i class="fas fa-plus"></i> Add
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .doc-number {
        font-weight: 600;
        color: var(--primary);
        font-size: 1rem;
    }

    .page-subtitle {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.3rem;
    }

    .meta-separator {
        color: var(--gray-300);
    }

    .meta-text {
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    .btn-danger {
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        background: linear-gradient(100deg, #dc2626, var(--danger));
        color: white;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        font-family: inherit;
    }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .btn-regenerate,
    .btn-gather-inputs {
        padding: 0.3rem 0.8rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.75rem;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
    }

        .btn-regenerate:hover,
        .btn-gather-inputs:hover {
            background: var(--gray-200);
            border-color: var(--gray-300);
        }

    .btn-add-attendee,
    .btn-add-action {
        padding: 0.4rem 0.8rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.8rem;
        background: var(--gray-100);
        color: var(--primary);
        border: 1px solid var(--gray-200);
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

        .btn-add-attendee:hover,
        .btn-add-action:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        background: transparent;
    }

    .btn-delete {
        background: var(--gray-100);
        color: var(--danger);
    }

        .btn-delete:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
        }

    .btn-complete {
        background: var(--gray-100);
        color: var(--success);
    }

        .btn-complete:hover {
            background: var(--success);
            color: white;
            transform: translateY(-2px);
        }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

        .alert-flash.success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .alert-flash.danger {
            background: #fef2f2;
            border-color: #fecaca;
            color: #b91c1c;
        }

        .alert-flash i {
            font-size: 1.1rem;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    /* ===== TWO COLUMN GRID ===== */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    /* ===== DETAILS GRID ===== */
    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem 1.5rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .detail-label {
        font-size: 0.65rem;
        font-weight: 600;
        color: var(--gray-400);
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .detail-value {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--gray-700);
    }

    /* ===== NARRATIVE ===== */
    .narrative-section {
        padding-top: 0.75rem;
        border-top: 1px solid var(--gray-200);
        margin-top: 0.75rem;
    }

        .narrative-section:last-child {
            margin-bottom: 0;
        }

    .narrative-label {
        font-size: 0.65rem;
