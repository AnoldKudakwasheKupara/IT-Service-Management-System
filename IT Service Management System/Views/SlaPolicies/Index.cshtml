@model List<IT_Service_Management_System.Models.Itsm.SlaPolicy>
@using IT_Service_Management_System.Models.Itsm
@using static IT_Service_Management_System.Models.Ticket
@{
    ViewData["Title"] = "SLA Policies - Axis IT Helpdesk";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();

    string Duration(int minutes)
    {
        if (minutes >= 1440)
        {
            var d = minutes / 1440.0;
            return $"{(d % 1 == 0 ? d.ToString("0") : d.ToString("0.#"))} day{(d == 1 ? "" : "s")}";
        }
        if (minutes >= 60)
        {
            var h = minutes / 60.0;
            return $"{(h % 1 == 0 ? h.ToString("0") : h.ToString("0.#"))} hr{(h == 1 ? "" : "s")}";
        }
        return $"{minutes} min";
    }
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-stopwatch me-2" style="color: var(--primary);"></i>
                    SLA Policies
                </h1>
                <p class="text-muted mt-2">Configure response &amp; resolution targets per priority and category.</p>
            </div>
            <button class="btn-create" onclick="openSla()">
                <i class="fas fa-plus"></i> New Policy
            </button>
        </div>
    </div>

    <!-- POLICIES CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-stopwatch me-2"></i>
                <span>Policies</span>
            </div>
            <div class="record-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count</span> policies
            </div>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-file-signature me-1"></i> Name</th>
                        <th><i class="fas fa-flag me-1"></i> Priority</th>
                        <th><i class="fas fa-tag me-1"></i> Category</th>
                        <th><i class="fas fa-reply me-1"></i> Response target</th>
                        <th><i class="fas fa-check-double me-1"></i> Resolution target</th>
                        <th><i class="fas fa-business-time me-1"></i> Business hours</th>
                        <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                        <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="@(p.IsActive ? "" : "inactive-row")">
                            <td><strong>@p.Name</strong></td>
                            <td><span class="status-badge badge-blue">@(p.Priority?.ToString() ?? "Any")</span></td>
                            <td>@(p.Category ?? "Any")</td>
                            <td>@Duration(p.ResponseMinutes)</td>
                            <td>@Duration(p.ResolutionMinutes)</td>
                            <td>
                                @if (p.BusinessHoursOnly)
                                {
                                    <span class="status-badge badge-amber">Business hrs</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-gray">24×7</span>
                                }
                            </td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="status-badge badge-green">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-gray">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="action-btn btn-edit" title="Edit Policy"
                                            onclick="openSla(@p.Id, '@Html.Raw(Encode(p.Name))', '@(p.Priority?.ToString() ?? "")', '@Html.Raw(Encode(p.Category ?? ""))', @p.ResponseMinutes, @p.ResolutionMinutes, @p.BusinessHoursOnly.ToString().ToLower(), @p.IsActive.ToString().ToLower())">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <form asp-action="Toggle" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="action-btn @(p.IsActive ? "btn-toggle-on" : "btn-toggle-off")"
                                                title="@(p.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas @(p.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete the policy &quot;@p.Name&quot;? This cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="action-btn btn-delete" title="Delete Policy">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-stopwatch"></i>
                <h3>No SLA policies yet</h3>
                <p>Create your first policy to start tracking response and resolution targets.</p>
            </div>
        }
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="slaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="slaId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-stopwatch me-2" style="color: var(--primary);"></i>
                        <span id="slaModalTitle">New Policy</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                            <input type="text" name="name" id="slaName" class="form-control" required maxlength="120" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Priority</label>
                            <select name="priority" id="slaPriority" class="form-control form-select">
                                <option value="">Any priority</option>
                                @foreach (var val in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="category" id="slaCategory" class="form-control form-select">
                                <option value="">Any category</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Response target (minutes) <span class="text-danger">*</span></label>
                            <input type="number" name="responseMinutes" id="slaResponse" class="form-control" min="1" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Resolution target (minutes) <span class="text-danger">*</span></label>
                            <input type="number" name="resolutionMinutes" id="slaResolution" class="form-control" min="1" required />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="businessHoursOnly" id="slaBusiness" value="true" />
                                <label class="form-check-label" for="slaBusiness">
                                    <i class="fas fa-business-time text-muted me-1"></i> Business hours only (else 24×7)
                                </label>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" name="isActive" id="slaActive" value="true" checked />
                                <label class="form-check-label" for="slaActive">
                                    <i class="fas fa-check-circle text-success me-1"></i> Active
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-modal-save">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    static string Encode(string? s) =>
        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(s ?? "");
}

<script>
    function openSla(id, name, priority, category, response, resolution, business, active) {
        document.getElementById('slaId').value = id || 0;
        document.getElementById('slaName').value = name || '';
        document.getElementById('slaPriority').value = priority || '';
        document.getElementById('slaCategory').value = category || '';
        document.getElementById('slaResponse').value = response || '';
        document.getElementById('slaResolution').value = resolution || '';
        document.getElementById('slaBusiness').checked = !!business;
        document.getElementById('slaActive').checked = id ? !!active : true;
        document.getElementById('slaModalTitle').textContent = id ? 'Edit Policy' : 'New Policy';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('slaModal')).show();
    }
</script>

<style>
    /* Page-specific extras — core classes (page-container, data-card, data-table,
       status-badge, badge-*, action-btn, btn-create, empty-state) are global in site.css. */
    .table-responsive { overflow-x: auto; }
    .data-table tbody tr.inactive-row { opacity: 0.6; }
    .data-table tbody tr.inactive-row:hover { opacity: 0.8; }

    .btn-toggle-on { background: var(--gray-100); color: var(--success); }
    .btn-toggle-on:hover { background: var(--success); color: white; transform: translateY(-2px); }
    .btn-toggle-off { background: var(--gray-100); color: var(--gray-500); }
    .btn-toggle-off:hover { background: var(--gray-500); color: white; transform: translateY(-2px); }

    .modal-content { border-radius: 1rem; border: 1px solid var(--gray-200); box-shadow: var(--shadow-lg); }
    .modal-header { background: var(--gray-50); border-bottom: 1px solid var(--gray-200); padding: 1.25rem 1.5rem; border-radius: 1rem 1rem 0 0; }
    .modal-header .modal-title { font-weight: 700; color: var(--gray-800); font-size: 1.1rem; }
    .modal-body { padding: 1.5rem; }
    .modal-footer { background: var(--gray-50); border-top: 1px solid var(--gray-200); padding: 1rem 1.5rem; border-radius: 0 0 1rem 1rem; gap: 0.5rem; }
    .modal-footer .btn-modal-cancel {
        padding: 0.5rem 1.25rem; border-radius: 0.5rem; background: white; color: var(--gray-600);
        border: 1.5px solid var(--gray-200); font-weight: 600; font-size: 0.875rem; cursor: pointer;
    }
    .modal-footer .btn-modal-cancel:hover { background: var(--gray-50); border-color: var(--gray-300); }
    .modal-footer .btn-modal-save {
        padding: 0.5rem 1.25rem; border-radius: 0.5rem;
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white; border: none; font-weight: 600; font-size: 0.875rem; cursor: pointer;
        display: inline-flex; align-items: center; gap: 0.5rem;
    }
    .modal-footer .btn-modal-save:hover { transform: translateY(-1px); box-shadow: var(--shadow-md); }
    .modal-body .form-label { font-size: 0.8rem; color: var(--gray-600); margin-bottom: 0.25rem; }
    .modal-body .form-control, .modal-body .form-select {
        border: 1.5px solid var(--gray-200); border-radius: 0.5rem; padding: 0.5rem 0.75rem; font-size: 0.875rem;
    }
    .modal-body .form-control:focus, .modal-body .form-select:focus {
        border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59,130,246,0.1); outline: none;
    }
    .modal-body .form-check-input { accent-color: var(--primary); width: 1.1rem; height: 1.1rem; margin-top: 0.1rem; }
    .modal-body .form-check-label { font-size: 0.875rem; color: var(--gray-700); cursor: pointer; }
    .modal-body .text-danger { color: var(--danger) !important; }

    @@media (max-width: 768px) {
        .data-table th, .data-table td { padding: 0.6rem 0.8rem; }
        .page-title { font-size: 1.5rem; }
    }
</style>
