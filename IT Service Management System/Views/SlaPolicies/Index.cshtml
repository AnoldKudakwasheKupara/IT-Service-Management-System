@model List<IT_Service_Management_System.Models.Itsm.SlaPolicy>
@using IT_Service_Management_System.Models.Itsm
@using static IT_Service_Management_System.Models.Ticket
@{
    ViewData["Title"] = "SLA Policies - Axis IT Helpdesk";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var calendars = ViewBag.Calendars as List<SlaCalendar> ?? new List<SlaCalendar>();

    string Duration(int minutes)
    {
        if (minutes >= 1440)
        {
            var d = minutes / 1440.0;
            return $"{(d % 1 == 0 ? d.ToString("0") : d.ToString("0.#"))} day{(d == 1 ? "" : "s")}";
        }
        if (minutes >= 60)
        {
            var h = minutes / 60.0;
            return $"{(h % 1 == 0 ? h.ToString("0") : h.ToString("0.#"))} hr{(h == 1 ? "" : "s")}";
        }
        return $"{minutes} min";
    }
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-stopwatch me-2" style="color: var(--primary);"></i>
                    SLA Policies
                </h1>
                <p class="text-muted mt-2">Configure response &amp; resolution targets per priority and category.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="SlaCalendars" asp-action="Index" class="btn btn-outline-primary"><i class="fas fa-calendar-check me-1"></i>Calendars</a>
                <button class="btn-create-ticket" onclick="openSla()"><i class="fas fa-plus"></i> New Policy</button>
            </div>
        </div>
    </div>

    <!-- POLICIES CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-stopwatch me-2"></i>
                <span>Policies</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count</span> policies
            </div>
        </div>
        <div class="table-responsive">
            <table class="tickets-table">
                <thead>
                    <tr>
                        <th><i class="fas fa-file-signature me-1"></i> Name</th>
                        <th><i class="fas fa-flag me-1"></i> Priority</th>
                        <th><i class="fas fa-tag me-1"></i> Category</th>
                        <th><i class="fas fa-reply me-1"></i> Response target</th>
                        <th><i class="fas fa-check-double me-1"></i> Resolution target</th>
                        <th><i class="fas fa-business-time me-1"></i> Business hours</th>
                        <th><i class="fas fa-calendar me-1"></i> Calendar</th>
                        <th><i class="fas fa-bell me-1"></i> Warning</th>
                        <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                        <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.OrderByDescending(x => x.CreatedAt))
                    {
                        <tr class="@(p.IsActive ? "" : "inactive-row")">
                            <td><strong class="policy-name">@p.Name</strong></td>
                            <td>
                                @if (p.Priority.HasValue)
                                {
                                    var prioClass = p.Priority.Value switch
                                    {
                                        TicketPriority.Critical => "badge-critical",
                                        TicketPriority.High => "badge-warning",
                                        TicketPriority.Medium => "badge-primary",
                                        _ => "badge-gray"
                                    };
                                    <span class="status-badge @prioClass">@p.Priority.Value</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-gray">Any</span>
                                }
                            </td>
                            <td class="category-cell">@(p.Category ?? "Any")</td>
                            <td class="duration-cell">@Duration(p.ResponseMinutes)</td>
                            <td class="duration-cell">@Duration(p.ResolutionMinutes)</td>
                            <td>
                                @if (p.BusinessHoursOnly)
                                {
                                    <span class="status-badge badge-warning"><i class="fas fa-business-time"></i> Business hrs</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-gray">24×7</span>
                                }
                            </td>
                            <td>@(p.Calendar?.Name ?? (p.BusinessHoursOnly ? "Default" : "—"))</td>
                            <td><span class="status-badge badge-primary">@p.WarningThresholdPercent%</span></td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="status-badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge badge-gray">Inactive</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <div class="action-buttons">
                                    <button class="action-btn btn-edit" title="Edit Policy"
                                            onclick="openSla(@p.Id, '@Html.Raw(Encode(p.Name))', '@(p.Priority?.ToString() ?? "")', '@Html.Raw(Encode(p.Category ?? ""))', @p.ResponseMinutes, @p.ResolutionMinutes, @p.BusinessHoursOnly.ToString().ToLower(), @p.IsActive.ToString().ToLower(), '@(p.SlaCalendarId?.ToString() ?? "")', @p.WarningThresholdPercent)">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <form asp-action="Toggle" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="action-btn @(p.IsActive ? "btn-toggle-on" : "btn-toggle-off")"
                                                title="@(p.IsActive ? "Deactivate" : "Activate")">
                                            <i class="fas @(p.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                        </button>
                                    </form>
                                    <form asp-action="Delete" method="post" style="display:inline;"
                                          onsubmit="return confirm('Delete the policy &quot;@p.Name&quot;? This cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="action-btn btn-delete" title="Delete Policy">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-stopwatch"></i>
                <h3>No SLA policies yet</h3>
                <p>Create your first policy to start tracking response and resolution targets.</p>
            </div>
        }
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="slaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="slaId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-stopwatch me-2" style="color: var(--primary);"></i>
                        <span id="slaModalTitle">New Policy</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Name <span class="required">*</span></label>
                            <input type="text" name="name" id="slaName" class="form-control" required maxlength="120" placeholder="e.g. Critical SLA" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Priority</label>
                            <select name="priority" id="slaPriority" class="form-control form-select">
                                <option value="">Any priority</option>
                                @foreach (var val in Enum.GetValues<TicketPriority>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category</label>
                            <select name="category" id="slaCategory" class="form-control form-select">
                                <option value="">Any category</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Response target (minutes) <span class="required">*</span></label>
                            <input type="number" name="responseMinutes" id="slaResponse" class="form-control" min="1" required placeholder="e.g. 60" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Resolution target (minutes) <span class="required">*</span></label>
                            <input type="number" name="resolutionMinutes" id="slaResolution" class="form-control" min="1" required placeholder="e.g. 480" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Business calendar</label>
                            <select name="slaCalendarId" id="slaCalendar" class="form-control form-select">
                                <option value="">Default Mon–Fri 08:00–17:00</option>
                                @foreach (var calendar in calendars)
                                {
                                    <option value="@calendar.Id">@calendar.Name (@calendar.WorkHoursLabel)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Warning threshold (%)</label>
                            <input type="number" name="warningThresholdPercent" id="slaWarning" class="form-control" min="1" max="99" value="75" required />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="businessHoursOnly" id="slaBusiness" value="true" />
                                <label class="form-check-label" for="slaBusiness">
                                    <i class="fas fa-business-time text-muted me-1"></i> Business hours only (else 24×7)
                                </label>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" name="isActive" id="slaActive" value="true" checked />
                                <label class="form-check-label" for="slaActive">
                                    <i class="fas fa-check-circle text-success me-1"></i> Active
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-modal-save">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    static string Encode(string? s) =>
        System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(s ?? "");
}

<script>
    function openSla(id, name, priority, category, response, resolution, business, active, calendarId, warning) {
        document.getElementById('slaId').value = id || 0;
        document.getElementById('slaName').value = name || '';
        document.getElementById('slaPriority').value = priority || '';
        document.getElementById('slaCategory').value = category || '';
        document.getElementById('slaResponse').value = response || '';
        document.getElementById('slaResolution').value = resolution || '';
        document.getElementById('slaBusiness').checked = !!business;
        document.getElementById('slaActive').checked = id ? !!active : true;
        document.getElementById('slaCalendar').value = calendarId || '';
        document.getElementById('slaWarning').value = warning || 75;
        document.getElementById('slaModalTitle').textContent = id ? 'Edit Policy' : 'New Policy';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('slaModal')).show();
    }
</script>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --violet: #8b5cf6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.6rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.9rem 1.5rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

            .tickets-table tbody tr.inactive-row {
                opacity: 0.6;
            }

                .tickets-table tbody tr.inactive-row:hover {
                    opacity: 0.8;
                }

    /* ===== POLICY SPECIFIC ===== */
    .policy-name {
        color: var(--gray-800);
        font-size: 0.95rem;
    }

    .category-cell {
        color: var(--gray-600);
        font-size: 0.85rem;
    }

    .duration-cell {
        font-weight: 600;
        color: var(--gray-700);
        font-size: 0.85rem;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-success {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .badge-warning {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .badge-critical {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .badge-gray {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    .badge-primary {
        background: #e6f0ff;
        color: var(--info);
        border: 1px solid #cce4ff;
    }

    /* ===== ACTION BUTTONS ===== */
    .action-buttons {
        display: flex;
        gap: 0.25rem;
        justify-content: flex-end;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
        background: transparent;
    }

    .btn-edit {
        background: var(--gray-100);
        color: var(--warning);
    }

        .btn-edit:hover {
            background: var(--warning);
            color: white;
            transform: translateY(-2px);
        }

    .btn-toggle-on {
        background: var(--gray-100);
        color: var(--success);
    }

        .btn-toggle-on:hover {
            background: var(--success);
            color: white;
            transform: translateY(-2px);
        }

    .btn-toggle-off {
        background: var(--gray-100);
        color: var(--gray-500);
    }

        .btn-toggle-off:hover {
            background: var(--gray-500);
            color: white;
            transform: translateY(-2px);
        }

    .btn-delete {
        background: var(--gray-100);
        color: var(--danger);
    }

        .btn-delete:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
        }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--gray-500);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--gray-300);
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--gray-600);
        }

        .empty-state p {
            margin-bottom: 1.5rem;
        }

    /* ===== MODAL STYLES ===== */
    .modal-content {
        border-radius: 1rem;
        border: 1px solid var(--gray-200);
        box-shadow: var(--shadow-lg);
    }

    .modal-header {
        background: var(--gray-50);
        border-bottom: 1px solid var(--gray-200);
        padding: 1.25rem 1.5rem;
        border-radius: 1rem 1rem 0 0;
    }

        .modal-header .modal-title {
            font-weight: 700;
            color: var(--gray-800);
            font-size: 1.1rem;
        }

            .modal-header .modal-title i {
                color: var(--primary);
            }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-footer {
        background: var(--gray-50);
        border-top: 1px solid var(--gray-200);
        padding: 1rem 1.5rem;
        border-radius: 0 0 1rem 1rem;
        gap: 0.5rem;
    }

        .modal-footer .btn-modal-cancel {
            padding: 0.5rem 1.25rem;
            border-radius: 0.5rem;
            background: white;
            color: var(--gray-600);
            border: 1.5px solid var(--gray-200);
            font-weight: 600;
            font-size: 0.875rem;
            transition: all 0.2s;
            cursor: pointer;
        }

            .modal-footer .btn-modal-cancel:hover {
                background: var(--gray-50);
                border-color: var(--gray-300);
            }

        .modal-footer .btn-modal-save {
            padding: 0.5rem 1.25rem;
            border-radius: 0.5rem;
            background: linear-gradient(100deg, var(--primary-dark), var(--primary));
            color: white;
            border: none;
            font-weight: 600;
            font-size: 0.875rem;
            transition: all 0.2s;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

            .modal-footer .btn-modal-save:hover {
                transform: translateY(-1px);
                box-shadow: var(--shadow-md);
            }

    .modal-body .form-label {
        font-size: 0.8rem;
        color: var(--gray-600);
        margin-bottom: 0.25rem;
        font-weight: 600;
    }

        .modal-body .form-label .required {
            color: var(--danger);
            font-weight: 700;
            margin-left: 0.15rem;
        }

    .modal-body .form-control,
    .modal-body .form-select {
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .modal-body .form-control:focus,
        .modal-body .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            outline: none;
        }

        .modal-body .form-control::placeholder {
            color: var(--gray-400);
        }

    .modal-body .form-check-input {
        accent-color: var(--primary);
        width: 1.1rem;
        height: 1.1rem;
        margin-top: 0.1rem;
        cursor: pointer;
    }

    .modal-body .form-check-label {
        font-size: 0.875rem;
        color: var(--gray-700);
        cursor: pointer;
    }

    .modal-body .text-danger {
        color: var(--danger) !important;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.6rem 0.8rem;
        }

        .tickets-table {
            font-size: 0.8rem;
        }

        .action-btn {
            width: 30px;
            height: 30px;
            font-size: 0.7rem;
        }

        .modal-dialog {
            margin: 1rem;
        }

        .duration-cell {
            font-size: 0.75rem;
        }
    }

    @@media (max-width: 576px) {
        .tickets-table th,
        .tickets-table td {
            padding: 0.4rem 0.5rem;
            font-size: 0.7rem;
        }

        .status-badge {
            font-size: 0.6rem;
            padding: 0.1rem 0.4rem;
        }

        .policy-name {
            font-size: 0.8rem;
        }

        .category-cell {
            font-size: 0.75rem;
        }

        .duration-cell {
            font-size: 0.7rem;
        }

        .modal-body {
            padding: 1rem;
        }

