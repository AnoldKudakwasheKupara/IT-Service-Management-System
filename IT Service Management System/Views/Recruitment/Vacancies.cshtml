@using IT_Service_Management_System.Models.Hr
@{
    ViewData["Title"] = "Vacancies";
    var vacancies = ViewBag.Vacancies as List<Vacancy> ?? new List<Vacancy>();
    var counts = ViewBag.Counts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var openOnly = ViewBag.OpenOnly as bool? ?? true;

    string Spaced(string v) => System.Text.RegularExpressions.Regex.Replace(v, "(?<=[a-z])(?=[A-Z])", " ");
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-bullhorn"></i> Vacancies</h1>
                    <p class="page-sub">Everything advertised, and what became of it.</p>
                </div>
                <div class="head-actions">
                    <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left"></i> Recruitment</a>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        <form method="get" class="toolbar">
            <label class="check">
                <input type="checkbox" name="openOnly" value="true" checked="@openOnly" /> Hide filled and cancelled
            </label>
            <button type="submit" class="btn-outline-hr"><i class="fas fa-filter"></i> Apply</button>
        </form>

        <div class="card flush">
            @if (vacancies.Count == 0)
            {
                <div class="empty"><i class="fas fa-bullhorn"></i><p>Nothing advertised.</p></div>
            }
            else
            {
                <table class="tbl">
                    <thead>
                        <tr><th>Ref</th><th>Vacancy</th><th>Open</th><th>Closes</th><th>Applications</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in vacancies)
                        {
                            <tr>
                                <td class="ref">@v.Reference</td>
                                <td>
                                    <div class="strong-link">@v.Title</div>
                                    <div class="sub">
                                        @v.Requisition?.Reference
                                        @if (v.Requisition != null) { <text>· @v.Requisition.Positions position(s)</text> }
                                    </div>
                                </td>
                                <td>@v.OpenDate.ToString("d MMM yyyy")</td>
                                <td class="@(v.DaysRemaining < 0 ? "overdue" : v.DaysRemaining <= 3 ? "warn" : "")">
                                    @v.CloseDate.ToString("d MMM yyyy")
                                </td>
                                <td class="num sm">@counts.GetValueOrDefault(v.Id)</td>
                                <td><span class="badge-hr b-neutral">@Spaced(v.Status.ToString())</span></td>
                                <td class="act">
                                    <a asp-action="Applications" asp-route-id="@v.Id" class="view" title="Applications">
                                        <i class="fas fa-users"></i>
                                    </a>
                                    <a asp-action="Criteria" asp-route-id="@v.Id" class="edit" title="Selection criteria">
                                        <i class="fas fa-list-check"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
