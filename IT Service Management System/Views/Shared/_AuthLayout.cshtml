@*
    Shared shell for the unauthenticated pages (sign in, verify, forgot/set password).

    These pages sit outside _Layout (no sidebar or topbar), and each used to carry its own
    <head>, font/CSS links and several hundred lines of near-identical styling. This layout
    holds that once: a split screen with the brand panel on the left and the form on the
    right, collapsing to a compact banner on small screens.

    A page supplies only its form. Optional bits:
      ViewData["AuthIcon"]     Font Awesome icon for the form heading   (default fa-right-to-bracket)
      ViewData["AuthTitle"]    Heading                                  (default "Sign in")
      ViewData["AuthSubtitle"] Supporting line under the heading
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Axis IT Operations | @ViewData["Title"]</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --primary: #b11d23;
            --primary-dark: #8f171c;
            --primary-deep: #5e0f13;
            --ink: #0f1113;
            --success: #2c9e6e;
            --danger: #e53e3e;
            --warning: #f5b042;
            --gray-50: #f8fafc;
            --gray-100: #f1f5f9;
            --gray-200: #e2e8f0;
            --gray-300: #cbd5e1;
            --gray-400: #94a3b8;
            --gray-500: #64748b;
            --gray-600: #475569;
            --gray-700: #334155;
            --gray-800: #1e293b;
        }

        * { box-sizing: border-box; }

        html, body { height: 100%; }

        body {
            margin: 0;
            font-family: 'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
            color: var(--gray-800);
            background: #fff;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Shell ─────────────────────────────────────────────────────────── */
        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.05fr 1fr;
        }

        /* ── Brand panel ───────────────────────────────────────────────────── */
        .auth-brand {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3.5rem 3.25rem;
            color: #fff;
            background:
                radial-gradient(120% 90% at 15% 5%, rgba(255,255,255,.14) 0%, rgba(255,255,255,0) 55%),
                linear-gradient(155deg, var(--ink) 0%, var(--primary-deep) 55%, var(--primary-dark) 100%);
        }

            /* Restrained dot grid — texture without noise. */
            .auth-brand::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255,255,255,.13) 1px, transparent 1px);
                background-size: 26px 26px;
                mask-image: radial-gradient(120% 80% at 20% 10%, #000 0%, transparent 70%);
                -webkit-mask-image: radial-gradient(120% 80% at 20% 10%, #000 0%, transparent 70%);
                pointer-events: none;
            }

            .auth-brand > * { position: relative; z-index: 1; }

        .auth-logo {
            display: inline-flex;
            align-items: center;
            gap: .85rem;
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -.01em;
        }

            .auth-logo .mark {
                width: 46px; height: 46px;
                display: inline-flex; align-items: center; justify-content: center;
                border-radius: .85rem;
                background: rgba(255,255,255,.12);
                border: 1px solid rgba(255,255,255,.18);
                font-size: 1.25rem;
            }

        .auth-pitch h1 {
            font-size: clamp(1.9rem, 2.6vw, 2.6rem);
            font-weight: 700;
            line-height: 1.18;
            letter-spacing: -.02em;
            margin: 0 0 1rem;
            max-width: 15ch;
        }

        .auth-pitch p {
            margin: 0 0 2.25rem;
            color: rgba(255,255,255,.72);
            font-size: 1rem;
            line-height: 1.6;
            max-width: 46ch;
        }

        .auth-points { list-style: none; margin: 0; padding: 0; display: grid; gap: .9rem; }

            .auth-points li {
                display: flex; align-items: flex-start; gap: .75rem;
                color: rgba(255,255,255,.9); font-size: .93rem;
            }

            .auth-points i {
                margin-top: .15rem;
                width: 22px; height: 22px; flex-shrink: 0;
                display: inline-flex; align-items: center; justify-content: center;
                border-radius: 50%;
                background: rgba(255,255,255,.14);
                font-size: .68rem;
            }

        .auth-brand-foot {
            display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
            color: rgba(255,255,255,.55); font-size: .78rem;
        }

            .auth-brand-foot span { display: inline-flex; align-items: center; gap: .4rem; }

        /* ── Form side ─────────────────────────────────────────────────────── */
        .auth-main {
            display: flex; align-items: center; justify-content: center;
            padding: 3rem 2rem;
            background: #fff;
        }

        .auth-panel { width: 100%; max-width: 27rem; }

        .auth-head { margin-bottom: 1.75rem; }

            .auth-head .auth-icon {
                width: 48px; height: 48px; margin-bottom: 1.1rem;
                display: inline-flex; align-items: center; justify-content: center;
                border-radius: .9rem; font-size: 1.15rem;
                color: var(--primary);
                background: #fdf3f3;
                border: 1px solid #f6dcdd;
            }

            .auth-head h2 {
                font-size: 1.6rem; font-weight: 700; letter-spacing: -.02em;
                color: var(--gray-800); margin: 0 0 .4rem;
            }

            .auth-head p { margin: 0; color: var(--gray-500); font-size: .93rem; line-height: 1.55; }

        /* ── Fields ────────────────────────────────────────────────────────── */
        .auth-field { margin-bottom: 1.15rem; }

        .auth-label {
            display: block; margin-bottom: .45rem;
            font-size: .82rem; font-weight: 600; color: var(--gray-700);
        }

        .auth-input-wrap { position: relative; display: flex; align-items: center; }

            .auth-input-wrap > .lead-icon {
                position: absolute; left: .95rem;
                color: var(--gray-400); font-size: .9rem; pointer-events: none;
                transition: color .18s ease;
            }

        .auth-input {
            width: 100%;
            padding: .8rem 1rem .8rem 2.65rem;
            font-size: .95rem;
            font-family: inherit;
            color: var(--gray-800);
            background: var(--gray-50);
            border: 1.5px solid var(--gray-200);
            border-radius: .7rem;
            transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
        }

            .auth-input::placeholder { color: var(--gray-400); }

            .auth-input:hover { background: #fff; }

            .auth-input:focus {
                outline: none;
                background: #fff;
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(177,29,35,.12);
            }

            .auth-input:focus ~ .lead-icon,
            .auth-input-wrap:focus-within > .lead-icon { color: var(--primary); }

        .auth-toggle {
            position: absolute; right: .5rem;
            background: none; border: none; cursor: pointer;
            color: var(--gray-400); padding: .45rem .55rem; border-radius: .5rem;
            font-size: .9rem; line-height: 1;
        }

            .auth-toggle:hover { color: var(--gray-600); background: var(--gray-100); }

        /* ── Buttons ───────────────────────────────────────────────────────── */
        .auth-btn {
            width: 100%;
            margin-top: .35rem;
            padding: .85rem 1.25rem;
            font-size: .95rem; font-weight: 600; font-family: inherit;
            color: #fff; cursor: pointer;
            border: none; border-radius: .7rem;
            background: linear-gradient(100deg, var(--primary-dark), var(--primary));
            display: inline-flex; align-items: center; justify-content: center; gap: .55rem;
            transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
        }

            .auth-btn:hover:not(:disabled) {
                transform: translateY(-1px);
                box-shadow: 0 8px 20px rgba(177,29,35,.28);
                color: #fff;
            }

            .auth-btn:active:not(:disabled) { transform: translateY(0); }

            .auth-btn:disabled { opacity: .55; cursor: not-allowed; }

        .auth-btn-ghost {
            background: #fff; color: var(--gray-700);
            border: 1.5px solid var(--gray-200);
        }

            .auth-btn-ghost:hover:not(:disabled) { background: var(--gray-50); color: var(--gray-800); box-shadow: none; }

        /* ── Alerts ────────────────────────────────────────────────────────── */
        .auth-alert {
            display: flex; align-items: flex-start; gap: .65rem;
            padding: .8rem 1rem; margin-bottom: 1.25rem;
            border-radius: .7rem; font-size: .86rem; line-height: 1.5;
        }

            .auth-alert i { margin-top: .1rem; }

            .auth-alert.is-error { background: #fef2f2; border: 1px solid #fecaca; color: #b3261e; }
            .auth-alert.is-success { background: #ecfdf5; border: 1px solid #bbf7d0; color: #1f6e4a; }
            .auth-alert.is-info { background: #f8fafc; border: 1px solid var(--gray-200); color: var(--gray-600); }
            .auth-alert.is-dev { background: #fffbeb; border: 1px solid #fde68a; color: #92400e; }

        /* ── Links / footer ────────────────────────────────────────────────── */
        .auth-links {
            margin-top: 1.5rem; padding-top: 1.25rem;
            border-top: 1px solid var(--gray-100);
            text-align: center; font-size: .875rem; color: var(--gray-500);
        }

            .auth-links a { color: var(--primary); font-weight: 600; text-decoration: none; }
            .auth-links a:hover { text-decoration: underline; }

        .auth-inline-form { display: inline; }

        .auth-linkbtn {
            background: none; border: none; padding: 0;
            color: var(--primary); font-weight: 600; font-size: inherit;
            font-family: inherit; cursor: pointer;
        }

            .auth-linkbtn:hover { text-decoration: underline; }

        /* ── Accessibility ─────────────────────────────────────────────────── */
        a:focus-visible, button:focus-visible, input:focus-visible {
            outline: 3px solid var(--primary);
            outline-offset: 2px;
            border-radius: 6px;
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
        }

        /* ── Responsive: brand panel becomes a banner ──────────────────────── */
        @@media (max-width: 980px) {
            /* auto/1fr stops the grid stretching the banner to share the viewport
               height — it should be exactly as tall as the logo it contains. */
            .auth-shell { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }

            .auth-brand {
                padding: 1.15rem 1.5rem;
                flex-direction: row; align-items: center; justify-content: space-between;
                gap: 1rem;
            }

                .auth-brand .mark { width: 38px; height: 38px; font-size: 1.05rem; }

                .auth-logo { font-size: 1rem; }

            .auth-pitch, .auth-brand-foot { display: none; }

            .auth-main { padding: 2.25rem 1.25rem 3rem; align-items: flex-start; }
        }

        @@media (max-width: 420px) {
            .auth-main { padding: 1.75rem 1rem 2.5rem; }
            .auth-head h2 { font-size: 1.4rem; }
        }
    </style>
</head>
<body>
    <div class="auth-shell">
        <aside class="auth-brand">
            <div class="auth-logo">
                <span class="mark"><i class="fas fa-headset"></i></span>
                <span>Axis IT Operations</span>
            </div>

            <div class="auth-pitch">
                <h1>Every request, asset and control in one place.</h1>
                <p>
                    The service desk, asset register and ISO 9001 / 27001 management system your
                    teams rely on — with a full audit trail behind every action.
                </p>
                <ul class="auth-points">
                    <li><i class="fas fa-check"></i><span>Service desk, assets, CMDB and change in one workspace</span></li>
                    <li><i class="fas fa-check"></i><span>ISO 9001 &amp; 27001 document control, audits, CAPA and risk</span></li>
                    <li><i class="fas fa-check"></i><span>Two-factor sign-in and a complete, exportable audit log</span></li>
                </ul>
            </div>

            <div class="auth-brand-foot">
                <span><i class="fas fa-lock"></i> Encrypted connection</span>
                <span><i class="fas fa-shield-halved"></i> Two-factor protected</span>
            </div>
        </aside>

        <main class="auth-main">
            <div class="auth-panel">
                <div class="auth-head">
                    <div class="auth-icon"><i class="fas @(ViewData["AuthIcon"] ?? "fa-right-to-bracket")"></i></div>
                    <h2>@(ViewData["AuthTitle"] ?? "Sign in")</h2>
                    @if (ViewData["AuthSubtitle"] != null)
                    {
                        <p>@ViewData["AuthSubtitle"]</p>
                    }
                </div>

                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        // Reveal/hide password fields. Any button with data-toggle-password="<inputId>".
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-toggle-password'));
                if (!input) return;
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.innerHTML = '<i class="far ' + (show ? 'fa-eye' : 'fa-eye-slash') + '"></i>';
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
            });
        });

        // Show progress on submit so a slow sign-in doesn't look unresponsive.
        document.querySelectorAll('form[data-auth-form]').forEach(function (form) {
            form.addEventListener('submit', function () {
                if (typeof form.checkValidity === 'function' && !form.checkValidity()) return;
                var btn = form.querySelector('button[type=submit]');
                if (!btn || btn.disabled) return;
                setTimeout(function () {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ' + (btn.dataset.busy || 'Please wait…');
                }, 0);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
