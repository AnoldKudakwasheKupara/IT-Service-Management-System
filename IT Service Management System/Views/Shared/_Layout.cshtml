    <!-- jQuery + Toastr (global notifications) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script>
        // Global Toastr configuration + helper.
        toastr.options = {
            closeButton: true,
            progressBar: true,
            newestOnTop: true,
            positionClass: "toast-top-right",
            timeOut: 4000,
            extendedTimeOut: 1500,
            preventDuplicates: true
        };
        // Convenience global so any page/script can raise a toast.
        window.notify = function (type, message, title) {
            if (!message) return;
            (toastr[type] || toastr.info)(message, title || "");
        };
    </script>

    @* Bridge server-side TempData/ViewBag messages to Toastr on page load *@
    @{
        var _toastSuccess = TempData["Success"] as string ?? ViewBag.Success as string;
        var _toastError = TempData["Error"] as string ?? ViewBag.Error as string;
        var _toastInfo = TempData["Info"] as string ?? ViewBag.Info as string;
        var _toastWarning = TempData["Warning"] as string ?? ViewBag.Warning as string;
    }
    @if (_toastSuccess != null || _toastError != null || _toastInfo != null || _toastWarning != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                @if (_toastSuccess != null) { <text>toastr.success(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastSuccess)));</text> }
                @if (_toastError != null) { <text>toastr.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastError)));</text> }
                @if (_toastInfo != null) { <text>toastr.info(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastInfo)));</text> }
                @if (_toastWarning != null) { <text>toastr.warning(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastWarning)));</text> }
            });
        </script>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables: turn shared .data-table tables into sortable/searchable tables paginated at 10/page -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <style>
        .dataTables_wrapper { padding: 0.9rem 1.1rem; }
        .dataTables_wrapper .dataTables_filter input { border:1.5px solid var(--gray-200); border-radius:0.5rem; padding:0.35rem 0.6rem; font-size:0.85rem; }
        .dataTables_wrapper .dataTables_filter label, .dataTables_wrapper .dataTables_info { font-size:0.82rem; color:var(--gray-500); }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current { background:var(--primary) !important; border-color:var(--primary) !important; color:#fff !important; border-radius:0.5rem; }
        .dataTables_wrapper .dataTables_paginate .paginate_button { border-radius:0.5rem; }
        table.data-table.dataTable { width:100% !important; }
    </style>
    <script>
        $(function () {
            if (!$.fn || !$.fn.DataTable) return;
            $('table.data-table').each(function () {
                var $t = $(this);
                if ($.fn.DataTable.isDataTable($t)) return;
                // Skip tables that are already server-paginated (they render a .pager in their card).
                if ($t.closest('.data-card, .page-container').find('.pager').length) return;
                var $rows = $t.find('tbody > tr');
                if ($rows.length === 0) return;
                // Skip a lone empty-state placeholder row (<td colspan>…</td>).
                if ($rows.length === 1 && $rows.find('td[colspan]').length) return;
                // Header/body column mismatch would throw — guard.
                var cols = $t.find('thead > tr:first > th').length;
                if (cols === 0) return;
                try {
                    $t.DataTable({
                        pageLength: 10,
                        lengthChange: false,
                        order: [],
                        autoWidth: false,
                        language: {
                            search: '', searchPlaceholder: 'Search…',
                            info: 'Showing _START_–_END_ of _TOTAL_',
                            infoEmpty: 'No records', infoFiltered: '(of _MAX_)',
                            zeroRecords: 'No matching records', emptyTable: 'No records',
                            paginate: { previous: '‹', next: '›' }
                        }
                    });
                } catch (e) { /* leave the table static if DataTables can't handle its shape */ }
            });
        });
    </script>

    <script>
        // Sidebar toggle with overlay
        function toggleSidebar() {
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("sidebarOverlay");
        sidebar.classList.toggle("active");
        if (sidebar.classList.contains("active")) {
        overlay.classList.add("active");
        document.body.style.overflow = "hidden";
        } else {
        overlay.classList.remove("active");
        document.body.style.overflow = "";
        }
        }

        function closeSidebar() {
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("sidebarOverlay");
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        document.body.style.overflow = "";
        }

        // Close sidebar on resize to desktop
        window.addEventListener('resize', function() {
        if (window.innerWidth > 992) {
        const sidebar = document.getElementById("sidebar");
        const overlay = document.getElementById("sidebarOverlay");
        if (sidebar.classList.contains("active")) {
        sidebar.classList.remove("active");
        overlay.classList.remove("active");
        document.body.style.overflow = "";
        }
        }
        });

        // Topbar shadow on scroll
        document.addEventListener("DOMContentLoaded", function() {
        const mainContent = document.querySelector('.content');
        const topbar = document.querySelector('.topbar');
        if (mainContent && topbar) {
        mainContent.addEventListener('scroll', function() {
        if (mainContent.scrollTop > 10) {
        topbar.style.boxShadow = '0 4px 20px rgba(0,0,0,0.06)';
        topbar.style.background = 'rgba(255,255,255,0.85)';
        } else {
        topbar.style.boxShadow = 'none';
        topbar.style.background = 'rgba(255,255,255,0.75)';
        }
        });
        }

        // Active nav item highlight enhancement
        const navItems = document.querySelectorAll('.nav-item');
        navItems.forEach(item => {
        item.addEventListener('click', function(e) {
        if (!e.ctrlKey && !e.metaKey) {
        this.style.transition = 'all 0.15s';
        this.style.transform = 'translateX(2px)';
        setTimeout(() => {
        this.style.transform = '';
        }, 120);
        }
        });
        });
        });

        // Collapsible sidebar groups (accordion) built over the flat nav structure.
        (function () {
            var nav = document.getElementById('sidebarNav');
            if (!nav) return;
            var KEY = 'sidebarGroups';
            var state = {};
            try { state = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { }
            nav.querySelectorAll('.nav-group').forEach(function (g) {
                var label = g.textContent.trim();
                var items = [];
                var el = g.nextElementSibling;
                while (el && !el.classList.contains('nav-group')) {
                    if (el.classList && el.classList.contains('nav-item')) items.push(el);
                    el = el.nextElementSibling;
                }
                if (!items.length) return;

                var chev = document.createElement('i');
                chev.className = 'fas fa-chevron-down nav-chevron';
                chev.setAttribute('aria-hidden', 'true');
                g.appendChild(chev);
                g.classList.add('nav-group-toggle');
                g.setAttribute('role', 'button');
                g.setAttribute('tabindex', '0');

                var hasActive = items.some(function (i) { return i.classList.contains('active'); });
                // Core and the current page's group start open; others follow saved state (default collapsed).
                var open = (hasActive || label.toLowerCase() === 'core') ? true
                         : (label in state ? state[label] : false);

                function apply(o) {
                    g.setAttribute('aria-expanded', o ? 'true' : 'false');
                    g.classList.toggle('collapsed', !o);
                    items.forEach(function (i) { i.style.display = o ? '' : 'none'; });
                }
                apply(open);

                function toggle() {
                    open = !open;
                    apply(open);
                    state[label] = open;
                    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) { }
                }
                g.addEventListener('click', toggle);
                g.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
                });
            });
        })();

        // Global search / command palette (Ctrl+K). The index is harvested from the
        // sidebar links, so it automatically reflects the current user's permissions.
        (function () {
            var overlay = document.getElementById('cmdkOverlay');
            var input = document.getElementById('cmdkInput');
            var resultsEl = document.getElementById('cmdkResults');
            var trigger = document.getElementById('globalSearchBtn');
            var nav = document.getElementById('sidebarNav');
            if (!overlay || !input || !resultsEl || !nav) return;

            // Build the destination index: { label, href, icon, group }.
            var items = [];
            var group = '';
            nav.querySelectorAll('.nav-group, .nav-item').forEach(function (el) {
                if (el.classList.contains('nav-group')) {
                    var gc = el.cloneNode(true);
                    gc.querySelectorAll('i').forEach(function (n) { n.remove(); });
                    group = gc.textContent.replace(/\s+/g, ' ').trim();
                    return;
                }
                var href = el.getAttribute('href');
                if (!href) return;
                var icon = el.querySelector('i');
                var lc = el.cloneNode(true);
                lc.querySelectorAll('i, .nav-badge').forEach(function (n) { n.remove(); });
                var label = lc.textContent.replace(/\s+/g, ' ').trim();
                if (label) items.push({ label: label, href: href, group: group, icon: icon ? icon.className : 'fas fa-link' });
            });

            var selected = 0;
            var visible = [];

            // Synonyms so people can search for what they call things, not just the menu
            // wording: "helpdesk" finds Tickets, "policy" finds Document Control, "2fa"
            // finds Two-Factor Auth. Matched against the destination's href.
            var ALIASES = {
                '/Tickets': 'helpdesk incident issue support ticket queue',
                '/MyWork': 'my queue assigned to me todo tasks',
                '/ServiceCatalog': 'service request catalogue order new request',
                '/Activity': 'timesheet worklog activity log',
                '/Problems': 'problem root cause known error itil',
                '/Changes': 'change request cab release itil',
                '/Cmdb': 'configuration item asset ci dependency itil',
                '/SlaPolicies': 'sla target response resolution breach',
                '/Incidents': 'major incident outage p1',
                '/Assets': 'hardware equipment inventory device',
                '/SSLCertificates': 'ssl tls certificate expiry',
                '/Users': 'people staff employee account role',
                '/Departments': 'department team org unit',
                '/AuditLogs': 'audit trail history who did what',
                '/Security': 'security dashboard threats sessions lockout',
                '/Configuration': 'settings config options preferences',
                '/Backup': 'backup restore disaster recovery',
                '/MeetingMinutes': 'meeting minutes agenda action items',
                '/ExitClearance': 'offboarding exit leaver clearance',
                '/ExitInterview': 'exit interview leaver feedback',
                '/EmployeeDocuments': 'hr files employee documents personnel folder',
                '/Ecie': 'ai assistant ask intelligence compliance question',
                '/Ims': 'iso dashboard integrated management compliance overview',
                '/IsoDocuments': 'policy procedure work instruction form record document control iso',
                '/IsoAudits': 'internal audit finding programme iso 9001 27001',
                '/Capa': 'corrective preventive action capa car',
                '/NonConformances': 'non conformance nc defect',
                '/Risk': 'risk register heat map threat treatment',
                '/Suppliers': 'vendor supplier evaluation procurement',
                '/Training': 'training competency course certificate skills',
                '/ManagementReviews': 'management review iso 9.3',
                '/Objectives': 'objective kpi target goal',
                '/ComplianceRegister': 'compliance obligation legal regulatory',
                '/Improvements': 'improvement kaizen suggestion opportunity',
                '/Evidence': 'evidence repository proof attachment',
                '/IsoReports': 'iso report export excel pdf',
                '/Notifications': 'notifications alerts bell inbox',
                '/Mfa': '2fa two factor authenticator otp security',
                '/Reports': 'report analytics metrics dashboard export'
            };

            function aliasFor(item) {
                if (item._alias !== undefined) return item._alias;
                var found = '';
                for (var key in ALIASES) {
                    if (item.href.indexOf(key) === 0) { found = ALIASES[key]; break; }
                }
                item._alias = found;
                return found;
            }

            function rank(item, q) {
                var l = item.label.toLowerCase(), g = item.group.toLowerCase();
                if (l.indexOf(q) === 0) return 0;                          // label starts with
                if (l.split(' ').some(function (w) { return w.indexOf(q) === 0; })) return 1;  // word starts with
                if (l.indexOf(q) >= 0) return 2;                           // label contains
                var a = aliasFor(item);
                if (a && a.split(' ').some(function (w) { return w.indexOf(q) === 0; })) return 3;  // synonym
                if (g.indexOf(q) >= 0) return 4;                           // group contains
                if (a && a.indexOf(q) >= 0) return 5;                      // synonym substring
                return -1;
            }

            function render() {
                var q = input.value.trim().toLowerCase();
                visible = !q ? items.slice() : items
                    .map(function (i) { return { i: i, r: rank(i, q) }; })
                    .filter(function (x) { return x.r >= 0; })
                    .sort(function (a, b) { return a.r - b.r; })
                    .map(function (x) { return x.i; });
                visible = visible.slice(0, 14);
                if (selected >= visible.length) selected = 0;

                if (!visible.length) {
                    resultsEl.innerHTML = '<div class="cmdk-empty">No matching pages.</div>';
                    return;
                }
                resultsEl.innerHTML = '';
                visible.forEach(function (item, idx) {
                    var a = document.createElement('a');
                    a.className = 'cmdk-item' + (idx === selected ? ' selected' : '');
                    a.href = item.href;
                    a.setAttribute('role', 'option');
                    a.setAttribute('aria-selected', idx === selected ? 'true' : 'false');

                    var ic = document.createElement('i');
                    ic.className = item.icon;
                    ic.setAttribute('aria-hidden', 'true');
                    a.appendChild(ic);

                    var span = document.createElement('span');
                    span.textContent = item.label;
                    a.appendChild(span);

                    if (item.group) {
                        var chip = document.createElement('span');
                        chip.className = 'cmdk-item-group';
                        chip.textContent = item.group;
                        a.appendChild(chip);
                    }

                    a.addEventListener('mousemove', function () {
                        if (selected !== idx) { selected = idx; paintSelection(); }
                    });
                    resultsEl.appendChild(a);
                });
            }

            function paintSelection() {
                resultsEl.querySelectorAll('.cmdk-item').forEach(function (el, idx) {
                    el.classList.toggle('selected', idx === selected);
                    el.setAttribute('aria-selected', idx === selected ? 'true' : 'false');
                });
                var sel = resultsEl.querySelector('.cmdk-item.selected');
                if (sel) sel.scrollIntoView({ block: 'nearest' });
            }

            function openPalette() {
                overlay.hidden = false;
                input.value = '';
                selected = 0;
                render();
                input.focus();
            }

            function closePalette() {
                overlay.hidden = true;
                if (trigger) trigger.focus();
            }

            if (trigger) trigger.addEventListener('click', openPalette);

            overlay.addEventListener('mousedown', function (e) {
                if (e.target === overlay) closePalette();
            });

            input.addEventListener('input', function () { selected = 0; render(); });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown') { e.preventDefault(); if (visible.length) { selected = (selected + 1) % visible.length; paintSelection(); } }
                else if (e.key === 'ArrowUp') { e.preventDefault(); if (visible.length) { selected = (selected - 1 + visible.length) % visible.length; paintSelection(); } }
                else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (visible[selected]) window.location.href = visible[selected].href;
                }
            });

            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')) {
                    e.preventDefault();
                    overlay.hidden ? openPalette() : closePalette();
                } else if (e.key === 'Escape' && !overlay.hidden) {
                    closePalette();
                }
            });
        })();
    </script>

    <!-- Real-time notifications (SignalR): live bell badge + toasts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (function () {
            var badge = document.getElementById('efmBellBadge');
            if (!badge || typeof signalR === 'undefined') return;   // only for authenticated pages

            function bumpBadge() {
                var n = (parseInt(badge.getAttribute('data-count')) || 0) + 1;
                badge.setAttribute('data-count', n);
                badge.textContent = n > 99 ? '99+' : n;
                badge.style.display = 'inline-flex';
            }

            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/notifications')
                .withAutomaticReconnect()
                .build();

            connection.on('notification', function (notice) {
                bumpBadge();
                if (window.toastr) {
                    var t = (toastr[notice.level] || toastr.info)(
                        (notice.message || ''), (notice.title || 'Notification'),
                        { timeOut: 6000, closeButton: true, progressBar: true });
                    if (notice.url && t) {
                        t.css('cursor', 'pointer');
                        t.on('click', function () { window.location.href = notice.url; });
                    }
                }
            });

            connection.start().catch(function () { /* hub unavailable — bell still works via page loads */ });
        })();
    </script>

    @* Unobtrusive client-side validation, loaded once for every page so any form with
       asp-for / asp-validation-for validates in the browser instead of round-tripping. *@
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

    <script>
        // Double-submit guard: once a POST form is genuinely being submitted, disable its
        // button and show a spinner so an impatient double-click can't create duplicate
        // records. Opt a form out with data-no-submit-guard.
        (function () {
            document.addEventListener('submit', function (e) {
                // Anything that cancelled the submit (failed validation, a declined
                // confirm()) has already set this by the time the event reaches document.
                if (e.defaultPrevented) return;

                var form = e.target;
                if (!form || form.tagName !== 'FORM') return;
                if ((form.getAttribute('method') || 'get').toLowerCase() !== 'post') return;
                if (form.hasAttribute('data-no-submit-guard')) return;

                var btn = e.submitter || form.querySelector('button[type=submit], input[type=submit]');
                if (!btn || btn.disabled) return;

                // Defer so the browser still serialises the button's own name/value.
                setTimeout(function () {
                    btn.disabled = true;
                    btn.setAttribute('aria-busy', 'true');
                    var icon = btn.querySelector('i');
                    if (icon) {
                        icon.dataset.prevClass = icon.className;
                        icon.className = 'fas fa-spinner fa-spin';
                    }
                    // Safety net: if the page never navigates (download, blocked request),
                    // give the control back rather than leaving it dead.
                    setTimeout(function () {
                        btn.disabled = false;
                        btn.removeAttribute('aria-busy');
                        if (icon && icon.dataset.prevClass) icon.className = icon.dataset.prevClass;
                    }, 10000);
                }, 0);
            }, false);
        })();
    </script>

    @RenderSection("Scripts", required: false)

