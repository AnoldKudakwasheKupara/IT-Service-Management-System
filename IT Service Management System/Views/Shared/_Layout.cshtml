<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Axis IT Operations</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Toastr notifications -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" />

    <!-- DataTables (Bootstrap 5 styling) — interactive sort / search / pagination -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />

    <!-- Shared design system (tokens, accessibility, utilities) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            /* Design tokens now live in wwwroot/css/site.css (single source of truth). */

            body {
                margin: 0;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                background: var(--bg-main);
                color: var(--text-primary);
                font-feature-settings: 'cv02', 'cv03', 'cv04', 'cv11';
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: var(--border-light);
                border-radius: 10px;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: var(--primary);
                }

            /* ============================================================
                               LAYOUT
                               ============================================================ */
            .app-layout {
                display: flex;
                height: 100vh;
                width: 100%;
                overflow: hidden;
            }

            /* ============================================================
                               SIDEBAR — premium dark
                               ============================================================ */
            .sidebar {
                width: 280px;
                background: var(--sidebar-bg);
                color: var(--text-light);
                display: flex;
                flex-direction: column;
                transition: var(--transition-smooth);
                z-index: 20;
                box-shadow: 4px 0 20px rgba(0, 0, 0, 0.08);
                overflow: hidden;
                flex-shrink: 0;
            }

            /* Only the menu scrolls; the brand header stays pinned. */
            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                scrollbar-width: thin;
                padding-bottom: 1rem;
            }

                .sidebar-nav::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-nav::-webkit-scrollbar-track {
                    background: transparent;
                }

                .sidebar-nav::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,0.2);
                    border-radius: 10px;
                }

            /* Collapsible group headers (built up by the accordion script). */
            .nav-group-toggle {
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: space-between;
                user-select: none;
                transition: color .15s;
            }

                .nav-group-toggle:hover { color: #94a3b8; }

                .nav-group-toggle:focus-visible {
                    outline: 2px solid var(--primary);
                    outline-offset: -2px;
                    border-radius: 4px;
                }

                .nav-chevron {
                    font-size: .58rem;
                    opacity: .7;
                    transition: transform .2s ease;
                }

                .nav-group-toggle.collapsed .nav-chevron { transform: rotate(-90deg); }

            /* ── Global search / command palette (Ctrl+K) ─────────────────────── */
            .topbar-search {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.45rem 0.9rem;
                margin-right: 0.75rem;
                background: var(--gray-100);
                border: 1px solid var(--gray-200);
                border-radius: 0.6rem;
                color: var(--gray-500);
                font-size: 0.82rem;
                font-family: inherit;
                cursor: pointer;
                transition: var(--transition-smooth);
            }

                .topbar-search:hover {
                    background: white;
                    border-color: var(--gray-300);
                    color: var(--gray-700);
                    box-shadow: var(--shadow-sm);
                }

                .topbar-search .topbar-search-kbd {
                    font-size: 0.65rem;
                    font-weight: 600;
                    color: var(--gray-400);
                    border: 1px solid var(--gray-200);
                    border-radius: 0.3rem;
                    padding: 0.1rem 0.35rem;
                    background: white;
                }

            @@media (max-width: 768px) {
                .topbar-search .topbar-search-label,
                .topbar-search .topbar-search-kbd { display: none; }
                .topbar-search { padding: 0.45rem 0.6rem; }
            }

            .cmdk-overlay {
                position: fixed;
                inset: 0;
                background: rgba(15, 23, 42, 0.45);
                backdrop-filter: blur(3px);
                z-index: 200;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding: 12vh 1rem 1rem;
            }

                .cmdk-overlay[hidden] { display: none; }

            .cmdk {
                width: 100%;
                max-width: 560px;
                background: white;
                border-radius: 1rem;
                box-shadow: var(--shadow-xl, 0 25px 50px -12px rgba(0,0,0,.25));
                overflow: hidden;
                display: flex;
                flex-direction: column;
                max-height: 62vh;
            }

            .cmdk-input-row {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.9rem 1.1rem;
                border-bottom: 1px solid var(--gray-100);
                flex-shrink: 0;
            }

                .cmdk-input-row > i { color: var(--gray-400); }

                .cmdk-input-row input {
                    flex: 1;
                    border: none;
                    outline: none;
                    font-size: 0.95rem;
                    font-family: inherit;
                    color: var(--gray-800);
                    background: transparent;
                }

                .cmdk-input-row kbd,
                .cmdk-footer kbd {
                    font-size: 0.62rem;
                    font-weight: 600;
                    color: var(--gray-400);
                    border: 1px solid var(--gray-200);
                    border-radius: 0.3rem;
                    padding: 0.12rem 0.4rem;
                    background: var(--gray-50);
                    font-family: inherit;
                }

            .cmdk-results {
                overflow-y: auto;
                padding: 0.4rem;
                flex: 1;
            }

            .cmdk-item {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.6rem 0.8rem;
                border-radius: 0.55rem;
                color: var(--gray-700);
                text-decoration: none;
                font-size: 0.875rem;
                cursor: pointer;
            }

                .cmdk-item i {
                    width: 20px;
                    text-align: center;
                    color: var(--gray-400);
                    font-size: 0.95rem;
                }

                .cmdk-item .cmdk-item-group {
                    margin-left: auto;
                    font-size: 0.66rem;
                    font-weight: 600;
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                    color: var(--gray-400);
                    background: var(--gray-50);
                    border: 1px solid var(--gray-100);
                    border-radius: 2rem;
                    padding: 0.12rem 0.55rem;
                    white-space: nowrap;
                }

                .cmdk-item.selected,
                .cmdk-item:hover {
                    background: var(--gray-100);
                    color: var(--gray-800);
                }

                    .cmdk-item.selected i { color: var(--primary); }

            .cmdk-empty {
                padding: 1.5rem;
                text-align: center;
                color: var(--gray-400);
                font-size: 0.875rem;
            }

            .cmdk-footer {
                display: flex;
                gap: 1rem;
                padding: 0.55rem 1.1rem;
                border-top: 1px solid var(--gray-100);
                color: var(--gray-400);
                font-size: 0.7rem;
                flex-shrink: 0;
            }

            .sidebar-header {
                padding: 1.75rem 1.5rem 1.25rem 1.5rem;
                font-weight: 700;
                font-size: 1.35rem;
                letter-spacing: -0.3px;
                color: white;
                display: flex;
                align-items: center;
                gap: 12px;
                border-bottom: 1px solid rgba(255,255,255,0.06);
                margin-bottom: 0.5rem;
                flex-shrink: 0;
            }

                .sidebar-header i {
                    font-size: 1.6rem;
                    background: linear-gradient(135deg, #b11d23, #d9565d);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                    text-shadow: 0 2px 5px rgba(177, 29, 35,0.3);
                }

                .sidebar-header span {
                    background: linear-gradient(135deg, #fff, #94a3b8);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                }

            .nav-group {
                padding: 0.75rem 1.5rem 0.4rem 1.5rem;
                font-size: 0.65rem;
                text-transform: uppercase;
                letter-spacing: 0.8px;
                font-weight: 600;
                color: #64748b;
                margin-top: 0.5rem;
            }

            .nav-item {
                padding: 0.7rem 1.5rem;
                margin: 0.15rem 0.8rem;
                display: flex;
                align-items: center;
                gap: 12px;
                color: #94a3b8;
                text-decoration: none;
                font-size: 0.875rem;
                font-weight: 500;
                border-radius: var(--radius-sm);
                transition: var(--transition-smooth);
                position: relative;
                cursor: pointer;
            }

                .nav-item i {
                    width: 22px;
                    font-size: 1.05rem;
                    text-align: center;
                    transition: var(--transition-smooth);
                    color: #64748b;
                }

                .nav-item:hover {
                    background: var(--sidebar-hover);
                    color: white;
                    transform: translateX(4px);
                }

                    .nav-item:hover i {
                        color: var(--primary);
                    }

                .nav-item.active {
                    background: linear-gradient(95deg, rgba(177, 29, 35,0.15) 0%, rgba(177, 29, 35,0.05) 100%);
                    color: white;
                    font-weight: 600;
                    border-left: 3px solid var(--primary);
                }

                    .nav-item.active i {
                        color: var(--primary);
                    }

            /* badge indicator on nav items */
            .nav-badge {
                margin-left: auto;
                background: var(--primary);
                color: white;
                font-size: 0.6rem;
                padding: 2px 8px;
                border-radius: 20px;
                font-weight: 600;
            }

            /* ============================================================
                               MAIN AREA
                               ============================================================ */
            .main-area {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                background: var(--bg-main);
            }

            /* ============================================================
                               TOPBAR — glass effect
                               ============================================================ */
            .topbar {
                background: rgba(255,255,255,0.75);
                backdrop-filter: blur(16px) saturate(180%);
                -webkit-backdrop-filter: blur(16px) saturate(180%);
                border-bottom: 1px solid rgba(226,232,240,0.5);
                height: 72px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 2rem;
                position: sticky;
                top: 0;
                z-index: 10;
                transition: var(--transition-smooth);
            }

            .topbar-left {
                display: flex;
                align-items: center;
                gap: 16px;
            }

                .topbar-left h5 {
                    margin: 0;
                    font-weight: 700;
                    font-size: 1.1rem;
                    color: var(--text-primary);
                    letter-spacing: -0.2px;
                }

                    .topbar-left h5 small {
                        font-weight: 400;
                        color: var(--text-muted);
                        font-size: 0.75rem;
                        margin-left: 0.5rem;
                    }

            .mobile-toggle {
                display: none;
                background: white;
                border: 1px solid var(--border-light);
                border-radius: var(--radius-sm);
                padding: 8px 12px;
                transition: var(--transition-smooth);
                color: var(--text-secondary);
            }

                .mobile-toggle:hover {
                    background: var(--primary-surface);
                    border-color: var(--primary);
                    color: var(--primary);
                }

            /* ============================================================
                               USER PROFILE
                               ============================================================ */
            .user-profile {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .profile-link {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                padding: 6px 14px 6px 8px;
                border-radius: 60px;
                transition: var(--transition-smooth);
                background: rgba(255,255,255,0.5);
            }

                .profile-link:hover {
                    background: white;
                    box-shadow: var(--shadow-sm);
                    transform: scale(1.02);
                    text-decoration: none;
                }

            .user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 0.9rem;
                box-shadow: 0 4px 8px rgba(177, 29, 35,0.2);
                transition: var(--transition-smooth);
                flex-shrink: 0;
            }

            .user-info {
                line-height: 1.3;
            }

            .user-name {
                font-weight: 600;
                color: var(--text-primary);
                font-size: 0.85rem;
            }

            .user-role {
                font-size: 0.65rem;
                color: var(--primary);
                font-weight: 600;
                background: var(--primary-surface);
                padding: 2px 10px;
                border-radius: 30px;
                display: inline-block;
            }

            .logout-form {
                display: flex;
                margin: 0;
            }

            .btn-logout {
                background: rgba(239,68,68,0.1);
                border: none;
                color: #ef4444;
                border-radius: 50%;
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: var(--transition-smooth);
                cursor: pointer;
            }

                .btn-logout:hover {
                    background: #ef4444;
                    color: white;
                    transform: scale(1.05);
                    box-shadow: 0 6px 12px rgba(239,68,68,0.25);
                }

            /* ============================================================
                               CONTENT
                               ============================================================ */
            .content {
                padding: 1.8rem 2rem 2rem 2rem;
                overflow-y: auto;
                scroll-behavior: smooth;
                flex: 1;
            }

            /* ============================================================
                               GLOBAL COMPONENTS
                               ============================================================ */
            .card {
                border: none;
                border-radius: var(--radius-md);
                background: var(--bg-card);
                box-shadow: var(--shadow-sm);
                transition: var(--transition-smooth);
                overflow: hidden;
            }

                .card:hover {
                    box-shadow: var(--shadow-md);
                    transform: translateY(-2px);
                }

            .btn-modern {
                padding: 8px 20px;
                border-radius: 40px;
                font-weight: 500;
                transition: var(--transition-smooth);
                letter-spacing: -0.2px;
                border: none;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .btn-modern:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-md);
                }

            .btn-primary-modern {
                background: linear-gradient(135deg, var(--primary), var(--primary-dark));
                color: white;
            }

                .btn-primary-modern:hover {
                    background: linear-gradient(135deg, var(--primary-dark), #7a1418);
                    color: white;
                }

            /* ============================================================
                               SIDEBAR OVERLAY (mobile)
                               ============================================================ */
            .sidebar-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.4);
                backdrop-filter: blur(4px);
                z-index: 1040;
                display: none;
                opacity: 0;
                transition: opacity 0.3s ease;
            }

                .sidebar-overlay.active {
                    display: block;
                    opacity: 1;
                }

            /* ============================================================
                               ANIMATIONS
                               ============================================================ */
            .fade-in {
                animation: fadeInUp 0.5s ease-out;
            }

            @@keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ============================================================
                               RESPONSIVE
                               ============================================================ */
            @@media (max-width: 992px) {
                .sidebar {
                    position: fixed;
                    top: 0;
                    left: -320px;
                    height: 100%;
                    z-index: 1050;
                    box-shadow: var(--shadow-xl);
                    width: 300px;
                }

                    .sidebar.active {
                        left: 0;
                    }

                .mobile-toggle {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .topbar {
                    padding: 0 1rem;
                }

                .content {
                    padding: 1rem;
                }

                .user-info {
                    display: none;
                }

                .profile-link {
                    padding: 6px 10px 6px 6px;
                }
            }

            @@media (max-width: 576px) {
                .topbar-left h5 small {
                    display: none;
                }

                .content {
                    padding: 0.75rem;
                }

                .btn-logout {
                    width: 36px;
                    height: 36px;
                }
            }

            /* ============================================================
                               PRINT
                               ============================================================ */
            @@media print {
                .sidebar, .topbar, .btn-logout, .mobile-toggle {
                    display: none !important;
                }

                .main-area {
                    overflow: visible !important;
                }

                .content {
                    padding: 1rem !important;
                    overflow: visible !important;
                }

                .card {
                    box-shadow: none !important;
                    transform: none !important;
                    break-inside: avoid;
                }
            }
    </style>
</head>

<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        var isAuthPage = currentController == "Account" &&
            (currentAction == "Login" || currentAction == "ForgotPassword" || currentAction == "SetPassword");
    }

    @if (!isAuthPage)
    {
        <!-- Mobile Overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

        <!-- Global search / command palette (Ctrl+K) -->
        <div class="cmdk-overlay" id="cmdkOverlay" hidden>
            <div class="cmdk" role="dialog" aria-modal="true" aria-label="Global search">
                <div class="cmdk-input-row">
                    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                    <input id="cmdkInput" type="text" placeholder="Jump to a module or page…"
                           autocomplete="off" spellcheck="false" aria-label="Search pages" />
                    <kbd>Esc</kbd>
                </div>
                <div class="cmdk-results" id="cmdkResults" role="listbox" aria-label="Search results"></div>
                <div class="cmdk-footer">
                    <span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> navigate</span>
                    <span><kbd>Enter</kbd> open</span>
                    <span><kbd>Ctrl</kbd> <kbd>K</kbd> toggle</span>
                </div>
            </div>
        </div>

        <div class="app-layout">

            <!-- SIDEBAR -->
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <i class="fas fa-headset"></i>
                    <span>Axis IT</span>
                </div>

                <nav class="sidebar-nav" id="sidebarNav" aria-label="Main navigation">
                @{
                    var navRole = Context.Session.GetString("UserRole");
                    var navFull = navRole == "Admin" || navRole == "SystemsAdmin";
                    var navHr = navRole == "HR";
                    var navGeneralManager = navRole == "GeneralManager";
                    // IMS / ISO working roles (see Helpers/Ims/ImsAccess) — who sees the ISO management nav.
                    var navIms = navFull || navRole is "QualityManager" or "GeneralManager" or "DocumentController" or "DepartmentManager" or "Auditor" or "ExternalAuditor";
                    // Project Management (see Helpers/Roles.PmAll) — external clients get the portal instead.
                    var navPm = navFull || navRole is "ProjectManager" or "GeneralManager" or "TeamLead"
                        or "DepartmentManager" or "Finance" or "Procurement" or "Auditor" or "HR" or "Employee";
                    var navPmManage = navFull || navRole is "ProjectManager" or "GeneralManager" or "TeamLead" or "DepartmentManager";
                    var navClient = navRole == "Client";

                    // Controllers that belong to the Project Management module, for nav highlighting.
                    var pmControllers = new[]
                    {
                        "Projects", "ProjectTasks", "ProjectPlan", "ProjectRegisters", "ProjectFinance",
                        "ProjectDocs", "ProjectApprovals", "ProjectReports", "ProjectResources", "ProjectTime"
                    };
                }

                <div class="nav-group">Core</div>
                <a class="nav-item @(currentController == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">
                    <i class="fas fa-chart-line"></i> Dashboard
                </a>

                <a class="nav-item @(currentController == "MyWork" ? "active" : "")"
                   asp-controller="MyWork" asp-action="Index">
                    <i class="fas fa-briefcase"></i> My Work
                </a>

                <a class="nav-item @(currentController == "Tickets" ? "active" : "")"
                   asp-controller="Tickets" asp-action="Index">
                    <i class="fas fa-ticket-alt"></i> Tickets
                    <span class="nav-badge">@(ViewBag.OpenTicketCount ?? 0)</span>
                </a>

                <a class="nav-item @(currentController == "ServiceCatalog" && currentAction == "Index" ? "active" : "")"
                   asp-controller="ServiceCatalog" asp-action="Index">
                    <i class="fas fa-store"></i> Service Catalogue
                </a>

                <a class="nav-item @(currentController == "ServiceCatalog" && (currentAction == "MyRequests" || currentAction == "RequestDetails") ? "active" : "")"
                   asp-controller="ServiceCatalog" asp-action="MyRequests">
                    <i class="fas fa-list-check"></i> My Requests
                </a>

                <a class="nav-item @(currentController == "Activity" ? "active" : "")"
                   asp-controller="Activity" asp-action="Index">
                    <i class="fas fa-tasks"></i> Activity Tracker
                </a>

                <a class="nav-item @(currentController == "ExitClearance" && currentAction == "Mine" ? "active" : "")"
                   asp-controller="ExitClearance" asp-action="Mine">
                    <i class="fas fa-file-signature"></i> My Exit Clearance
                </a>

                <a class="nav-item @(currentController == "EmployeeDocuments" && currentAction == "MyDocuments" ? "active" : "")"
                   asp-controller="EmployeeDocuments" asp-action="MyDocuments">
                    <i class="fas fa-folder"></i> My Documents
                </a>

                <a class="nav-item @(currentController == "IsoDocuments" && currentAction == "MyDocuments" ? "active" : "")"
                   asp-controller="IsoDocuments" asp-action="MyDocuments">
                    <i class="fas fa-user-check"></i> My ISO Documents
                </a>

                <a class="nav-item @(currentController == "Leave" && currentAction != "Queue" && currentAction != "Register" && currentAction != "Balances" && currentAction != "Types" ? "active" : "")"
                   asp-controller="Leave" asp-action="Index">
                    <i class="fas fa-umbrella-beach"></i> My Leave
                </a>
                <a class="nav-item @(currentController == "Leave" && currentAction == "Queue" ? "active" : "")"
                   asp-controller="Leave" asp-action="Queue">
                    <i class="fas fa-inbox"></i> Leave Approvals
                </a>
                <a class="nav-item @(currentController == "Payroll" && (currentAction == "MyPayslips" || currentAction == "MyPayslip") ? "active" : "")"
                   asp-controller="Payroll" asp-action="MyPayslips">
                    <i class="fas fa-receipt"></i> My Payslips
                </a>
