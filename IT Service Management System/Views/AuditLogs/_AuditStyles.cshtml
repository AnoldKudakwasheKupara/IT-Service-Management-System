@*
    Styles shared by every audit-trail page. Kept in one partial so the list, the detail page,
    the timeline and the integrity check cannot drift apart. Everything structural (cards,
    tables, stat cards, filters, badges) comes from site.css; only the audit-specific pieces
    live here.
*@
<style>
    /* ── Action badges ──────────────────────────────────────────────────── */
    .audit-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.6rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid transparent;
    }
    .audit-badge i { font-size: 0.68rem; }

    .audit-created  { background: var(--success-light); color: var(--success); border-color: #c6e0c9; }
    .audit-updated  { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
    .audit-deleted  { background: var(--danger-light); color: var(--danger); border-color: #fed7d7; }
    .audit-login    { background: #ecfdf5; color: #047857; border-color: #a7f3d0; }
    .audit-logout   { background: var(--gray-100); color: var(--gray-600); border-color: var(--gray-300); }
    .audit-failed   { background: var(--warning-light); color: #b45309; border-color: #ffe0b3; }
    .audit-read     { background: #f5f3ff; color: #6d28d9; border-color: #ddd6fe; }
    .audit-security { background: var(--primary-surface); color: var(--primary-dark); border-color: #f4ced0; }
    .audit-system   { background: var(--gray-100); color: var(--gray-500); border-color: var(--gray-300); }
    .audit-other    { background: var(--gray-100); color: var(--gray-600); border-color: var(--gray-200); }

    /* ── Source pill: automatic capture vs an explicitly logged event ───── */
    .source-pill {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        border-radius: 0.4rem;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }
    .source-Automatic { background: #eef2ff; color: #4338ca; }
    .source-Manual    { background: var(--gray-100); color: var(--gray-600); }
    .source-System    { background: #fdf4ff; color: #a21caf; }

    .entity-chip {
        display: inline-block;
        padding: 0.2rem 0.55rem;
        border-radius: 0.4rem;
        background: var(--gray-100);
        color: var(--gray-700);
        font-size: 0.74rem;
        font-weight: 600;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .audit-table td { vertical-align: middle; font-size: 0.84rem; }
    .audit-when { white-space: nowrap; color: var(--gray-600); font-size: 0.8rem; }
    .audit-when small { display: block; color: var(--gray-400); font-size: 0.7rem; }
    .audit-details { max-width: 340px; }
    .audit-details .subject {
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--gray-700);
    }
    .change-count {
        font-size: 0.7rem;
        color: var(--gray-500);
        background: var(--gray-100);
        border-radius: 0.35rem;
        padding: 0.1rem 0.4rem;
    }
    .who { display: flex; align-items: center; gap: 0.5rem; }
    .who .name { font-weight: 600; color: var(--gray-700); font-size: 0.82rem; }
    .who .role { display: block; font-size: 0.7rem; color: var(--gray-400); }
    .ip-cell code { font-size: 0.74rem; color: var(--gray-600); background: var(--gray-50); padding: 0.1rem 0.35rem; border-radius: 0.3rem; }

    /* ── Field-level diff ───────────────────────────────────────────────── */
    .diff-table { width: 100%; border-collapse: collapse; }
    .diff-table th {
        text-align: left;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--gray-500);
        padding: 0.6rem 1rem;
        border-bottom: 1px solid var(--gray-200);
        background: var(--gray-50);
    }
    .diff-table td {
        padding: 0.7rem 1rem;
        border-bottom: 1px solid var(--gray-100);
        font-size: 0.82rem;
        vertical-align: top;
    }
    .diff-field { font-weight: 600; color: var(--gray-700); width: 22%; }
    .diff-value {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        word-break: break-word;
        white-space: pre-wrap;
    }
    .diff-old { background: #fff7f7; color: #9b1c1c; }
    .diff-new { background: #f3fbf6; color: #065f46; }
    .diff-none { color: var(--gray-400); font-style: italic; }
    .diff-redacted { color: var(--gray-500); font-style: italic; }

    /* ── Metadata grid on the detail page ───────────────────────────────── */
    .meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem 1.5rem;
        padding: 1.25rem 1.5rem;
    }
    .meta-item label {
        display: block;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--gray-400);
        margin-bottom: 0.2rem;
    }
    .meta-item .value { font-size: 0.85rem; color: var(--gray-700); font-weight: 500; word-break: break-word; }
    .meta-item .value.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.75rem; }

    /* ── Timeline ───────────────────────────────────────────────────────── */
    .audit-timeline { position: relative; padding: 1.5rem 1.5rem 1.5rem 2.75rem; }
    .audit-timeline::before {
        content: "";
        position: absolute;
        left: 1.15rem; top: 1.5rem; bottom: 1.5rem;
        width: 2px;
        background: var(--gray-200);
    }
    .timeline-item { position: relative; padding-bottom: 1.5rem; }
    .timeline-item:last-child { padding-bottom: 0; }
    .timeline-dot {
        position: absolute;
        left: -1.85rem; top: 0.15rem;
        width: 0.85rem; height: 0.85rem;
        border-radius: 50%;
        background: #fff;
        border: 2px solid var(--gray-300);
    }
    .timeline-item.is-created .timeline-dot { border-color: var(--success); }
    .timeline-item.is-deleted .timeline-dot { border-color: var(--danger); }
    .timeline-item.is-updated .timeline-dot { border-color: #1d4ed8; }
    .timeline-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
    .timeline-time { font-size: 0.75rem; color: var(--gray-400); }
    .timeline-body { margin-top: 0.4rem; font-size: 0.84rem; color: var(--gray-600); }
    .timeline-changes { margin-top: 0.5rem; border: 1px solid var(--gray-200); border-radius: 0.5rem; overflow: hidden; }

    /* ── Integrity check ────────────────────────────────────────────────── */
    .integrity-banner {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1.5rem;
        border-radius: var(--radius-md);
        border: 1px solid;
        margin-bottom: 1.5rem;
    }
    .integrity-banner i { font-size: 1.75rem; margin-top: 0.15rem; }
    .integrity-banner h2 { font-size: 1.1rem; margin: 0 0 0.35rem; }
    .integrity-banner p { margin: 0; font-size: 0.86rem; }
    .integrity-ok { background: var(--success-light); border-color: #c6e0c9; color: #14532d; }
    .integrity-ok i { color: var(--success); }
    .integrity-bad { background: var(--danger-light); border-color: #fed7d7; color: #7f1d1d; }
    .integrity-bad i { color: var(--danger); }

    .hash-chip {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        color: var(--gray-500);
        background: var(--gray-50);
        border: 1px solid var(--gray-200);
        border-radius: 0.35rem;
        padding: 0.15rem 0.4rem;
    }

    .toolbar { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
    .btn-soft-action {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.9rem;
        border-radius: 0.6rem;
        border: 1px solid var(--gray-200);
        background: #fff;
        color: var(--gray-700);
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: var(--transition-smooth);
    }
    .btn-soft-action:hover { background: var(--gray-50); border-color: var(--primary); color: var(--primary); }
</style>
