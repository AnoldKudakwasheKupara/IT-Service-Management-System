@model IT_Service_Management_System.ViewModels.AuditIntegrityViewModel

@{
    ViewData["Title"] = "Audit trail integrity - Axis IT Helpdesk";
    var r = Model.Result;
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div class="flex-grow-1">
                <h1 class="page-title">
                    <i class="fas fa-shield-halved me-2" style="color: var(--primary);"></i>
                    Trail integrity
                </h1>
                <p class="text-muted mt-2">
                    Checked @r.VerifiedAt.ToString("yyyy-MM-dd HH:mm:ss") &middot; this check is itself recorded
                </p>
            </div>
            <a class="btn-soft-action" asp-action="Integrity">
                <i class="fas fa-rotate"></i> Check again
            </a>
        </div>
    </div>

    <div class="integrity-banner @(r.IsIntact ? "integrity-ok" : "integrity-bad")">
        <i class="fas @(r.IsIntact ? "fa-circle-check" : "fa-triangle-exclamation")"></i>
        <div>
            <h2>@(r.IsIntact ? "The chain is intact" : $"The chain breaks at entry #{r.FirstBrokenId}")</h2>
            <p>
                @if (r.IsIntact)
                {
                    <text>
                        Every entry's hash was recomputed and matched, and each links correctly to the one
                        before it. Nothing has been edited or removed since it was written.
                    </text>
                }
                else
                {
                    @r.Problem
                }
            </p>
        </div>
    </div>

    <div class="data-card mb-4">
        <div class="card-header-custom">
            <div><i class="fas fa-list-check me-2"></i><span>What was checked</span></div>
        </div>
        <div class="meta-grid">
            <div class="meta-item">
                <label>Entries verified</label>
                <div class="value">@r.Checked.ToString("N0")</div>
            </div>
            <div class="meta-item">
                <label>Highest entry id</label>
                <div class="value mono">@r.LastId</div>
            </div>
            <div class="meta-item">
                <label>Without a hash</label>
                <div class="value">
                    @r.Unhashed.ToString("N0")
                    @if (r.Unhashed > 0)
                    {
                        <div style="font-size:0.72rem;color:var(--gray-400);">
                            Written before hash chaining — skipped rather than reported as tampering
                        </div>
                    }
                </div>
            </div>
            <div class="meta-item">
                <label>Result</label>
                <div class="value">
                    @if (r.IsIntact)
                    {
                        <span class="audit-badge audit-created"><i class="fas fa-check"></i> Verified</span>
                    }
                    else
                    {
                        <span class="audit-badge audit-deleted"><i class="fas fa-xmark"></i> Broken</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.BrokenEntry != null)
    {
        <div class="data-card">
            <div class="card-header-custom">
                <div><i class="fas fa-crosshairs me-2"></i><span>First entry that failed</span></div>
                <a class="btn-soft-action" asp-action="Details" asp-route-id="@Model.BrokenEntry.Id">
                    <i class="fas fa-eye"></i> Open entry
                </a>
            </div>
            <div class="meta-grid">
                <div class="meta-item">
                    <label>Entry</label>
                    <div class="value mono">#@Model.BrokenEntry.Id</div>
                </div>
                <div class="meta-item">
                    <label>Recorded at</label>
                    <div class="value">@Model.BrokenEntry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</div>
                </div>
                <div class="meta-item">
                    <label>Action</label>
                    <div class="value">@await Html.PartialAsync("_ActionBadge", Model.BrokenEntry.Action)</div>
                </div>
                <div class="meta-item">
                    <label>User</label>
                    <div class="value">@Model.BrokenEntry.UserName</div>
                </div>
                <div class="meta-item">
                    <label>Details</label>
                    <div class="value">@Model.BrokenEntry.Details</div>
                </div>
            </div>
        </div>
    }
    else if (!r.IsIntact)
    {
        <!-- The chain pointed at a row that is no longer there, which is itself the finding. -->
        <div class="data-card">
            <div class="empty-state">
                <i class="fas fa-question-circle"></i>
                <h3>The failing entry is gone</h3>
                <p>Entry #@r.FirstBrokenId broke the chain but can no longer be read from the trail.</p>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_AuditStyles")
