@model IT_Service_Management_System.ViewModels.AuditTimelineViewModel

@{
    ViewData["Title"] = $"History of {Model.Entity} #{Model.EntityId} - Axis IT Helpdesk";
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" asp-route-entity="@Model.Entity" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div class="flex-grow-1">
                <h1 class="page-title">
                    <i class="fas fa-stream me-2" style="color: var(--primary);"></i>
                    History of @Model.Entity #@Model.EntityId
                </h1>
                <p class="text-muted mt-2">
                    @Model.Entries.Count event@(Model.Entries.Count == 1 ? "" : "s") on this record, oldest first
                </p>
            </div>
        </div>
    </div>

    <div class="data-card">
        <div class="card-header-custom">
            <div><i class="fas fa-clock-rotate-left me-2"></i><span>@Model.Subject</span></div>
            <span class="record-count">
                @Model.Entries[0].Timestamp.ToString("yyyy-MM-dd") &ndash;
                @Model.Entries[^1].Timestamp.ToString("yyyy-MM-dd")
            </span>
        </div>

        <div class="audit-timeline">
            @foreach (var entry in Model.Entries)
            {
                var changes = entry.ChangeList();
                var state = entry.Action switch
                {
                    "Created" => "is-created",
                    "Deleted" => "is-deleted",
                    "Updated" => "is-updated",
                    _ => string.Empty
                };
                <div class="timeline-item @state">
                    <span class="timeline-dot"></span>
                    <div class="timeline-head">
                        @await Html.PartialAsync("_ActionBadge", entry.Action)
                        <strong style="font-size:0.85rem;color:var(--gray-700);">@entry.UserName</strong>
                        <span class="timeline-time">@entry.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</span>
                        <a class="timeline-time text-decoration-none" asp-action="Details" asp-route-id="@entry.Id">
                            entry #@entry.Id
                        </a>
                    </div>
                    <div class="timeline-body">
                        @entry.Details
                        @if (!string.IsNullOrEmpty(entry.IpAddress))
                        {
                            <span style="color:var(--gray-400);font-size:0.75rem;">
                                &middot; from @entry.IpAddress@(string.IsNullOrEmpty(entry.Location) ? "" : $" ({entry.Location})")
                            </span>
                        }
                    </div>
                    @if (changes.Count > 0)
                    {
                        <div class="timeline-changes table-responsive">
                            @await Html.PartialAsync("_Diff", changes)
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_AuditStyles")
