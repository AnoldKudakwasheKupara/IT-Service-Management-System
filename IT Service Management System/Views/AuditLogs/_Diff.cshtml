@model IReadOnlyList<IT_Service_Management_System.Models.AuditFieldChange>
@*
    The before/after table for one entry. Shared by the detail page and the timeline so a diff
    reads identically wherever it appears. Sensitive values were replaced with a redaction marker
    at capture time — the fact that they changed is recorded, the values themselves never are.
*@
@if (Model == null || Model.Count == 0)
{
    return;
}

<table class="diff-table">
    <thead>
        <tr>
            <th>Field</th>
            <th>Before</th>
            <th>After</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var change in Model)
        {
            <tr>
                <td class="diff-field">@change.Field</td>
                <td class="diff-value @(change.Old == null ? "" : "diff-old")">
                    @if (change.Old == null)
                    {
                        <span class="diff-none">not set</span>
                    }
                    else if (change.Old == IT_Service_Management_System.Models.AuditFieldChange.Redacted)
                    {
                        <span class="diff-redacted"><i class="fas fa-eye-slash"></i> withheld</span>
                    }
                    else
                    {
                        @change.Old
                    }
                </td>
                <td class="diff-value @(change.New == null ? "" : "diff-new")">
                    @if (change.New == null)
                    {
                        <span class="diff-none">cleared</span>
                    }
                    else if (change.New == IT_Service_Management_System.Models.AuditFieldChange.Redacted)
                    {
                        <span class="diff-redacted"><i class="fas fa-eye-slash"></i> withheld</span>
                    }
                    else
                    {
                        @change.New
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
