@model IT_Service_Management_System.ViewModels.AuditDetailsViewModel

@{
    ViewData["Title"] = $"Audit entry #{Model.Entry.Id} - Axis IT Helpdesk";
    var e = Model.Entry;
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div class="flex-grow-1">
                <h1 class="page-title">
                    <i class="fas fa-fingerprint me-2" style="color: var(--primary);"></i>
                    Audit entry #@e.Id
                </h1>
                <p class="text-muted mt-2">@e.Details</p>
            </div>
            @if (e.EntityId.HasValue)
            {
                <a class="btn-soft-action" asp-action="Timeline" asp-route-entity="@e.Entity" asp-route-id="@e.EntityId">
                    <i class="fas fa-stream"></i> Full history of this record
                </a>
            }
        </div>
    </div>

    <!-- Tamper evidence: recomputes this entry's hash and re-checks its link to the entry
         before it. A mismatch means the stored row no longer matches what was written. -->
    <div class="integrity-banner @(Model.HashValid ? "integrity-ok" : "integrity-bad")">
        <i class="fas @(Model.HashValid ? "fa-circle-check" : "fa-triangle-exclamation")"></i>
        <div>
            <h2>@(Model.HashValid ? "Entry verified" : "Entry could not be verified")</h2>
            <p>
                @if (Model.HashValid)
                {
                    <text>
                        The contents match the recorded hash and the link to the previous entry holds,
                        so this row is exactly as it was written.
                    </text>
                }
                else if (string.IsNullOrEmpty(e.Hash))
                {
                    <text>
                        This entry predates hash chaining, so there is nothing to verify against.
                        Entries written since carry a hash.
                    </text>
                }
                else
                {
                    <text>
                        The contents or the chain link no longer match what was recorded. Run the
                        <a asp-action="Integrity">full integrity check</a> to see where the chain breaks.
                    </text>
                }
            </p>
        </div>
    </div>

    <div class="data-card mb-4">
        <div class="card-header-custom">
            <div><i class="fas fa-circle-info me-2"></i><span>What happened</span></div>
            <span class="source-pill source-@e.Source">@e.Source</span>
        </div>
        <div class="meta-grid">
            <div class="meta-item">
                <label>Action</label>
                <div class="value">@await Html.PartialAsync("_ActionBadge", e.Action)</div>
            </div>
            <div class="meta-item">
                <label>Record type</label>
                <div class="value"><span class="entity-chip">@e.Entity</span></div>
            </div>
            <div class="meta-item">
                <label>Record key</label>
                <div class="value mono">@(e.EntityKey ?? e.EntityId?.ToString() ?? "—")</div>
            </div>
            <div class="meta-item">
                <label>When</label>
                <div class="value">@e.Timestamp.ToString("dddd d MMMM yyyy, HH:mm:ss")</div>
            </div>
            <div class="meta-item">
                <label>User</label>
                <div class="value">@e.UserName</div>
            </div>
            <div class="meta-item">
                <label>Role at the time</label>
                <div class="value">@(string.IsNullOrEmpty(e.UserRole) ? "—" : e.UserRole)</div>
            </div>
            <div class="meta-item">
                <label>IP address</label>
                <div class="value mono">@e.IpAddress</div>
            </div>
            <div class="meta-item">
                <label>Location</label>
                <div class="value">@(string.IsNullOrEmpty(e.Location) ? "—" : e.Location)</div>
            </div>
            <div class="meta-item">
                <label>Device</label>
                <div class="value">@(string.IsNullOrEmpty(e.Device) ? "—" : e.Device)</div>
            </div>
            <div class="meta-item">
                <label>Request</label>
                <div class="value mono">
                    @(string.IsNullOrEmpty(e.RequestPath) ? "—" : $"{e.HttpMethod} {e.RequestPath}")
                </div>
            </div>
            <div class="meta-item">
                <label>Entry hash</label>
                <div class="value"><span class="hash-chip">@(string.IsNullOrEmpty(e.Hash) ? "none" : e.Hash)</span></div>
            </div>
            <div class="meta-item">
                <label>Previous entry hash</label>
                <div class="value"><span class="hash-chip">@(string.IsNullOrEmpty(e.PreviousHash) ? "start of chain" : e.PreviousHash)</span></div>
            </div>
        </div>
    </div>

    <div class="data-card mb-4">
        <div class="card-header-custom">
            <div><i class="fas fa-code-compare me-2"></i><span>Field changes</span></div>
            <span class="record-count">@Model.Changes.Count field@(Model.Changes.Count == 1 ? "" : "s")</span>
        </div>
        @if (Model.Changes.Count > 0)
        {
            <div class="table-responsive">
                @await Html.PartialAsync("_Diff", Model.Changes)
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-code-compare"></i>
                <h3>No field-level values</h3>
                <p>
                    This entry records an event rather than a row change — sign-ins, exports and
                    workflow steps carry their description instead of a before/after diff.
                </p>
            </div>
        }
    </div>

    @if (Model.RelatedInRequest.Count > 0)
    {
        <div class="data-card">
            <div class="card-header-custom">
                <div><i class="fas fa-layer-group me-2"></i><span>Rest of the same request</span></div>
                <span class="record-count">@Model.RelatedInRequest.Count more</span>
            </div>
            <!-- One user action often writes several rows; grouping by request keeps them together. -->
            <div class="table-responsive">
                <table class="data-table audit-table">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Record</th>
                            <th>Details</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var related in Model.RelatedInRequest)
                        {
                            <tr>
                                <td>@await Html.PartialAsync("_ActionBadge", related.Action)</td>
                                <td>
                                    <span class="entity-chip">@related.Entity</span>
                                    @if (related.EntityId.HasValue)
                                    {
                                        <span style="font-size:0.74rem;color:var(--gray-500);">#@related.EntityId</span>
                                    }
                                </td>
                                <td class="audit-details"><span class="subject" title="@related.Details">@related.Details</span></td>
                                <td>
                                    <a class="action-btn btn-view" asp-action="Details" asp-route-id="@related.Id" title="View entry">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_AuditStyles")
