@model IT_Service_Management_System.ViewModels.AuditIndexViewModel
@using IT_Service_Management_System.Models

@{
    ViewData["Title"] = "Audit Trail - Axis IT Helpdesk";
    var f = Model.Filter;
}

<div class="page-container">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-controller="Home" asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div class="flex-grow-1">
                <h1 class="page-title">
                    <i class="fas fa-history me-2" style="color: var(--primary);"></i>
                    Audit Trail
                </h1>
                <p class="text-muted mt-2">
                    Every change, sign-in and export — who did it, when, and what the values were before and after
                </p>
            </div>
            <div class="toolbar">
                <a class="btn-soft-action" asp-action="Integrity">
                    <i class="fas fa-shield-halved"></i> Verify integrity
                </a>
                <a class="btn-soft-action" asp-action="Export" asp-all-route-data="f.RouteValues()">
                    <i class="fas fa-file-csv"></i> Export CSV
                </a>
            </div>
        </div>
    </div>

    <!-- Counts follow the filter below, so narrowing to one person or one week answers
         "what did they change" straight from the cards. -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon total" style="background: var(--primary-surface); color: var(--primary);">
                <i class="fas fa-chart-line"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.TotalCount.ToString("N0")</h3>
                <p>@(f.IsActive ? "Matching events" : "Total events")</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: var(--success-light); color: var(--success);">
                <i class="fas fa-plus-circle"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.CreatedCount.ToString("N0")</h3>
                <p>Created</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #eff6ff; color: #1d4ed8;">
                <i class="fas fa-pen"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.UpdatedCount.ToString("N0")</h3>
                <p>Updated</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: var(--danger-light); color: var(--danger);">
                <i class="fas fa-trash-alt"></i>
            </div>
            <div class="stat-info">
                <h3>@Model.DeletedCount.ToString("N0")</h3>
                <p>Deleted</p>
            </div>
        </div>
    </div>

    <div class="filters-card mb-4">
        <div class="filters-header">
            <i class="fas fa-filter"></i>
            <span>Filter the trail</span>
        </div>
        <form method="get" asp-action="Index" class="filters-body">
            <div class="filter-group">
                <label>User</label>
                <select name="user" class="filter-select">
                    <option value="">Anyone</option>
                    @foreach (var u in Model.Users)
                    {
                        <option value="@u" selected="@(f.User == u)">@u</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Action</label>
                <select name="action" class="filter-select">
                    <option value="">Any action</option>
                    @foreach (var a in Model.Actions)
                    {
                        <option value="@a" selected="@(f.Action == a)">@a</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Record type</label>
                <select name="entity" class="filter-select">
                    <option value="">Any record</option>
                    @foreach (var e in Model.Entities)
                    {
                        <option value="@e" selected="@(f.Entity == e)">@e</option>
                    }
                </select>
            </div>
            <div class="filter-group">
                <label>Source</label>
                <select name="source" class="filter-select">
                    <option value="">Any source</option>
                    <option value="Automatic" selected="@(f.Source == AuditSource.Automatic)">Data change</option>
                    <option value="Manual" selected="@(f.Source == AuditSource.Manual)">Logged event</option>
                    <option value="System" selected="@(f.Source == AuditSource.System)">System job</option>
                </select>
            </div>
            <div class="filter-group">
                <label>From</label>
                <input type="date" name="from" class="filter-select" value="@(f.From?.ToString("yyyy-MM-dd"))">
            </div>
            <div class="filter-group">
                <label>To</label>
                <input type="date" name="to" class="filter-select" value="@(f.To?.ToString("yyyy-MM-dd"))">
            </div>
            <div class="filter-group">
                <label>Search</label>
                <div class="search-wrapper">
                    <i class="fas fa-search"></i>
                    <input type="text" name="q" value="@f.Q" placeholder="User, details, IP address..." class="search-input">
                </div>
            </div>
            <button type="submit" class="btn-clear-filters" style="background:var(--primary);color:#fff;border:none;">
                <i class="fas fa-search"></i> Apply
            </button>
            @if (f.IsActive)
            {
                <a asp-action="Index" class="btn-clear-filters">
                    <i class="fas fa-times"></i> Clear
                </a>
            }
        </form>
    </div>

    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-list me-2"></i>
                <span>Activity</span>
            </div>
            @if (f.IsActive)
            {
                <span class="record-count">Filtered by @f.Describe()</span>
            }
        </div>

        <div class="table-responsive">
            @if (Model.Entries.Count > 0)
            {
                <table class="data-table audit-table">
                    <thead>
                        <tr>
                            <th><i class="fas fa-calendar me-1"></i> When</th>
                            <th><i class="fas fa-user me-1"></i> Who</th>
                            <th><i class="fas fa-tag me-1"></i> Action</th>
                            <th><i class="fas fa-database me-1"></i> Record</th>
                            <th><i class="fas fa-info-circle me-1"></i> Details</th>
                            <th><i class="fas fa-network-wired me-1"></i> Origin</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Entries)
                        {
                            var changeCount = log.ChangeList().Count;
                            <tr>
                                <td class="audit-when">
                                    @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                    <small>@log.Source</small>
                                </td>
                                <td>
                                    <div class="who">
                                        <div class="list-avatar">
                                            @(string.IsNullOrEmpty(log.UserName) ? "?" : log.UserName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <span class="name">@log.UserName</span>
                                            @if (!string.IsNullOrEmpty(log.UserRole))
                                            {
                                                <span class="role">@log.UserRole</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@await Html.PartialAsync("_ActionBadge", log.Action)</td>
                                <td>
                                    <span class="entity-chip">@log.Entity</span>
                                    @if (log.EntityId.HasValue)
                                    {
                                        <a class="ms-1 text-decoration-none" style="font-size:0.74rem;color:var(--gray-500);"
                                           asp-action="Timeline" asp-route-entity="@log.Entity" asp-route-id="@log.EntityId"
                                           title="Full history of this record">#@log.EntityId</a>
                                    }
                                </td>
                                <td class="audit-details">
                                    <span class="subject" title="@log.Details">@log.Details</span>
                                    @if (changeCount > 0)
                                    {
                                        <span class="change-count">@changeCount field@(changeCount == 1 ? "" : "s") changed</span>
                                    }
                                </td>
                                <td class="ip-cell">
                                    <code>@log.IpAddress</code>
                                    @if (!string.IsNullOrEmpty(log.Location))
                                    {
                                        <div style="font-size:0.7rem;color:var(--gray-400);">
                                            <i class="fas fa-map-marker-alt"></i> @log.Location
                                        </div>
                                    }
                                </td>
                                <td>
                                    <a class="action-btn btn-view" asp-action="Details" asp-route-id="@log.Id" title="View entry">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-history"></i>
                    <h3>Nothing to show</h3>
                    <p>
                        @(f.IsActive
                            ? "No audit entries match this filter. Try widening the dates or clearing it."
                            : "The audit trail is empty. Entries appear as soon as anyone changes a record or signs in.")
                    </p>
                </div>
            }
        </div>

        @if (ViewBag.Paging != null)
        {
            @await Html.PartialAsync("_Pagination", (IT_Service_Management_System.Helpers.PagingInfo)ViewBag.Paging)
        }
    </div>
</div>

@await Html.PartialAsync("_AuditStyles")
