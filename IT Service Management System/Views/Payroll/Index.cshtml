@using IT_Service_Management_System.Models.Hr
@{
    ViewData["Title"] = "Payroll";
    var year = (int)(ViewBag.Year ?? DateTime.Today.Year);
    var runs = ViewBag.Runs as List<PayrollRun> ?? new List<PayrollRun>();
    var ceiling = (decimal)(ViewBag.NssaCeiling ?? 0m);
    var currencies = ViewBag.Currencies as List<string> ?? new List<string>();
    var bandCoverage = ViewBag.BandCoverage as Dictionary<string, int> ?? new Dictionary<string, int>();
    var onPayroll = (int)(ViewBag.OnPayroll ?? 0);

    var missingBands = currencies.Where(c => !bandCoverage.ContainsKey(c)).ToList();

    string StatusClass(PayrollRunStatus s) => s switch
    {
        PayrollRunStatus.Paid => "b-active",
        PayrollRunStatus.Approved => "b-leave",
        PayrollRunStatus.Calculated => "b-probation",
        PayrollRunStatus.Cancelled => "b-left",
        _ => "b-neutral"
    };
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-money-check-dollar"></i> Payroll</h1>
                    <p class="page-sub">
                        PAYE, NSSA and the employer levies, calculated against the rates in force
                        for each period
                    </p>
                </div>
                <div class="head-actions">
                    <a asp-action="Salaries" class="btn-ghost-hr"><i class="fas fa-users"></i> Salaries</a>
                    <a asp-action="Statutory" class="btn-outline-hr"><i class="fas fa-scale-balanced"></i> Statutory rates</a>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        @* ── READINESS ───────────────────────────────────────────────────── *@
        @if (ceiling <= 0 || missingBands.Count > 0)
        {
            <div class="notice bad">
                <h4><i class="fas fa-triangle-exclamation"></i> Payroll is not ready to run</h4>
                <p>
                    A run with missing tables does not fail — it silently deducts nothing, which is
                    far worse. Fix these before calculating anything you intend to pay.
                </p>
                <ul style="margin:.6rem 0 0 1.1rem; font-size:.82rem; color:var(--gray-600); line-height:1.7;">
                    @if (ceiling <= 0)
                    {
                        <li>
                            <strong>No NSSA insurable-earnings ceiling.</strong> Contributions are
                            being calculated on uncapped earnings. The ceiling is re-gazetted
                            whenever the currency moves.
                        </li>
                    }
                    @foreach (var c in missingBands)
                    {
                        <li>
                            <strong>No PAYE bands for @c.</strong> No tax will be deducted from any
                            @c payslip. Load the current tables from the Finance Act.
                        </li>
                    }
                </ul>
                <a asp-action="Statutory" class="btn-outline-hr btn-sm" style="margin-top:.75rem;">
                    <i class="fas fa-scale-balanced"></i> Open statutory rates
                </a>
            </div>
        }

        <div class="stats">
            <div class="stat">
                <div class="ic brand"><i class="fas fa-users"></i></div>
                <div><h3>@onPayroll</h3><p>On the payroll</p></div>
            </div>
            <div class="stat">
                <div class="ic blue"><i class="fas fa-calendar-check"></i></div>
                <div><h3>@runs.Count</h3><p>Runs in @year</p></div>
            </div>
            <div class="stat">
                <div class="ic green"><i class="fas fa-circle-check"></i></div>
                <div><h3>@runs.Count(r => r.Status == PayrollRunStatus.Paid)</h3><p>Paid</p></div>
            </div>
            <div class="stat">
                <div class="ic amber"><i class="fas fa-hourglass-half"></i></div>
                <div><h3>@runs.Count(r => r.Status is PayrollRunStatus.Draft or PayrollRunStatus.Calculated)</h3><p>In progress</p></div>
            </div>
        </div>

        @* ── NEW RUN ─────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-plus"></i> Open a run</span></div>
            <div class="card-body">
                <form asp-action="CreateRun" method="post" class="toolbar">
                    @Html.AntiForgeryToken()
                    <div class="fg">
                        <label class="lbl">Year</label>
                        <input name="periodYear" type="number" class="inp" value="@DateTime.Today.Year" required />
                    </div>
                    <div class="fg">
                        <label class="lbl">Month</label>
                        <select name="periodMonth" class="inp">
                            @for (var m = 1; m <= 12; m++)
                            {
                                var monthName = new DateTime(2000, m, 1).ToString("MMMM");
                                <option value="@m" selected="@(m == DateTime.Today.Month)">@monthName</option>
                            }
                        </select>
                    </div>
                    <div class="fg">
                        <label class="lbl">Currency</label>
                        <input name="currency" class="inp" value="@(currencies.FirstOrDefault() ?? "USD")" required maxlength="10" />
                        <span class="hint">One run per currency per month.</span>
                    </div>
                    <div class="fg">
                        <label class="lbl">Pay date</label>
                        <input name="payDate" type="date" class="inp" />
                    </div>
                    <button type="submit" class="btn-hr"><i class="fas fa-plus-circle"></i> Create run</button>
                </form>
            </div>
        </div>

        @* ── RUNS ────────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-list"></i> Runs</span>
                <form method="get" style="display:inline-flex; gap:.4rem;">
                    <select name="year" class="inp" style="width:auto; padding:.35rem .6rem; font-size:.8rem;" onchange="this.form.submit()">
                        @for (var y = DateTime.Today.Year + 1; y >= DateTime.Today.Year - 4; y--)
                        {
                            <option value="@y" selected="@(y == year)">@y</option>
                        }
                    </select>
                </form>
            </div>
            <div class="card-body flush">
                @if (runs.Count == 0)
                {
                    <div class="empty">
                        <i class="fas fa-money-check-dollar"></i>
                        <h3>No runs in @year</h3>
                        <p>Open one above once salaries and the month's variable pay are in place.</p>
                    </div>
                }
                else
                {
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Period</th><th>Currency</th><th class="num">Employees</th>
                                <th class="num">Gross</th><th class="num">PAYE + levy</th><th class="num">NSSA</th>
                                <th class="num">Net</th><th class="num">Employer cost</th><th>Status</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in runs)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Run" asp-route-id="@r.Id" class="ref">@r.Reference</a>
                                        <div><a asp-action="Run" asp-route-id="@r.Id" class="strong-link">@r.PeriodName</a></div>
                                    </td>
                                    <td class="meta">@r.Currency</td>
                                    <td class="num">@r.EmployeeCount</td>
                                    <td class="num">@r.TotalGross.ToString("N2")</td>
                                    <td class="num">@((r.TotalPaye + r.TotalAidsLevy).ToString("N2"))</td>
                                    <td class="num">@r.TotalNssaEmployee.ToString("N2")</td>
                                    <td class="num"><strong>@r.TotalNet.ToString("N2")</strong></td>
                                    <td class="num meta">@r.TotalEmployerCost.ToString("N2")</td>
                                    <td><span class="badge-hr @StatusClass(r.Status)">@r.Status</span></td>
                                    <td style="text-align:right;">
                                        <a asp-action="Run" asp-route-id="@r.Id" class="act view"><i class="fas fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</div>
