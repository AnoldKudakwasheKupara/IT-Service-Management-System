@using IT_Service_Management_System.Models.Hr
@model Payslip
@{
    ViewData["Title"] = $"Payslip — {Model.PayrollRun?.PeriodName}";
    var selfService = ViewBag.IsSelfService as bool? ?? false;

    var earnings = Model.Lines.Where(l => l.Kind == PayslipLineKind.Earning).ToList();
    var statutory = Model.Lines.Where(l => l.Kind == PayslipLineKind.StatutoryDeduction).ToList();
    var deductions = Model.Lines.Where(l => l.Kind == PayslipLineKind.Deduction).ToList();
    var employer = Model.Lines.Where(l => l.Kind == PayslipLineKind.EmployerContribution).ToList();
}

<partial name="_HrStyles" />

<div class="hr narrow">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div style="display:flex; gap:.9rem; align-items:flex-start;">
                    <a href="@(selfService ? Url.Action("MyPayslips") : Url.Action("Run", new { id = Model.PayrollRunId }))"
                       class="btn-back"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-receipt"></i> Payslip</h1>
                        <p class="page-sub">@Model.PayrollRun?.PeriodName · @Model.Currency</p>
                    </div>
                </div>
                <div class="head-actions">
                    <button type="button" class="btn-outline-hr" onclick="window.print()">
                        <i class="fas fa-print"></i> Print
                    </button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><span class="t"><i class="fas fa-user"></i> @Model.Employee?.DisplayName</span></div>
            <div class="card-body">
                <div class="dl">
                    <div><div class="k">Employee number</div><div class="v">@Model.Employee?.EmployeeNumber</div></div>
                    <div><div class="k">Job title</div><div class="v">@Model.Employee?.JobTitle</div></div>
                    <div><div class="k">Department</div><div class="v">@(Model.Employee?.Department?.Name ?? "—")</div></div>
                    <div><div class="k">Period</div><div class="v">@Model.PayrollRun?.PeriodName</div></div>
                    <div><div class="k">Pay date</div><div class="v">@Model.PayrollRun?.PayDate.ToString("d MMM yyyy")</div></div>
                    <div><div class="k">Currency</div><div class="v">@Model.Currency</div></div>
                </div>
            </div>
        </div>

        @if (Model.UnpaidLeaveDays > 0 || Model.HalfPayLeaveDays > 0)
        {
            <div class="notice warn">
                <h4><i class="fas fa-umbrella-beach"></i> Absence affected this month's pay</h4>
                <p>
                    @if (Model.HalfPayLeaveDays > 0)
                    {
                        <text>
                            @Model.HalfPayLeaveDays.ToString("0.##") day(s) of sick leave were at half pay,
                            reducing pay by @Model.Currency @Model.HalfPayLeaveDeduction.ToString("N2").
                            Sick leave runs at full pay for 90 days, then half pay for a further 90,
                            under Labour Act [Chapter 28:01] s.14.
                        </text>
                    }
                    @if (Model.UnpaidLeaveDays > 0)
                    {
                        <text>
                            @Model.UnpaidLeaveDays.ToString("0.##") day(s) were unpaid, reducing pay by
                            @Model.Currency @Model.UnpaidLeaveDeduction.ToString("N2").
                        </text>
                    }
                </p>
            </div>
        }

        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-plus"></i> Earnings</span>
                <strong>@Model.Currency @Model.Gross.ToString("N2")</strong>
            </div>
            <div class="card-body flush">
                <table class="tbl">
                    <tbody>
                        @foreach (var l in earnings)
                        {
                            <tr>
                                <td>
                                    @l.Description
                                    @if (!string.IsNullOrWhiteSpace(l.Basis))
                                    {
                                        <div class="meta" style="font-size:.72rem;">@l.Basis</div>
                                    }
                                </td>
                                <td class="num">@l.Amount.ToString("N2")</td>
                            </tr>
                        }
                        <tr style="background:var(--gray-50); font-weight:700;">
                            <td>Gross pay</td>
                            <td class="num">@Model.Gross.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-landmark"></i> Statutory deductions</span>
                <strong>@Model.Currency @((Model.Paye + Model.AidsLevy + Model.NssaEmployee).ToString("N2"))</strong>
            </div>
            <div class="card-body flush">
                <table class="tbl">
                    <tbody>
                        @foreach (var l in statutory)
                        {
                            <tr>
                                <td>
                                    @l.Description
                                    @if (!string.IsNullOrWhiteSpace(l.Basis))
                                    {
                                        <div class="meta" style="font-size:.72rem;">@l.Basis</div>
                                    }
                                </td>
                                <td class="num">@Math.Abs(l.Amount).ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div style="padding:.85rem 1.25rem; background:var(--gray-50); font-size:.78rem; color:var(--gray-600); line-height:1.6;">
                    Taxable income of @Model.Currency @Model.TaxableIncome.ToString("N2") is gross pay less the
                    NSSA pension contribution and any occupational pension — both are allowable against tax.
                    PAYE was charged at a marginal rate of @Model.MarginalTaxRate.ToString("0.##")%, and the
                    AIDS levy on the tax payable rather than on gross pay.
                </div>
            </div>
        </div>

        @if (deductions.Count > 0)
        {
            <div class="card">
                <div class="card-head">
                    <span class="t"><i class="fas fa-minus"></i> Other deductions</span>
                </div>
                <div class="card-body flush">
                    <table class="tbl">
                        <tbody>
                            @foreach (var l in deductions)
                            {
                                <tr>
                                    <td>@l.Description</td>
                                    <td class="num">@Math.Abs(l.Amount).ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card" style="border:2px solid var(--primary);">
            <div class="card-body" style="display:flex; justify-content:space-between; align-items:center; padding:1.5rem;">
                <div>
                    <div class="k" style="font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; color:var(--gray-400);">Net pay</div>
                    <div style="font-size:1.8rem; font-weight:700; color:var(--gray-800);">
                        @Model.Currency @Model.Net.ToString("N2")
                    </div>
                </div>
                <div style="text-align:right;" class="meta">
                    <div>Gross @Model.Gross.ToString("N2")</div>
                    <div>less deductions @Model.TotalDeductions.ToString("N2")</div>
                </div>
            </div>
        </div>

        @if (!selfService && employer.Count > 0)
        {
            <div class="card">
                <div class="card-head">
                    <span class="t"><i class="fas fa-building-columns"></i> Employer contributions</span>
                    <span class="meta">Not deducted from pay — shown for cost to company</span>
                </div>
                <div class="card-body flush">
                    <table class="tbl">
                        <tbody>
                            @foreach (var l in employer)
                            {
                                <tr>
                                    <td>
                                        @l.Description
                                        @if (!string.IsNullOrWhiteSpace(l.Basis))
                                        {
                                            <div class="meta" style="font-size:.72rem;">@l.Basis</div>
                                        }
                                    </td>
                                    <td class="num">@l.Amount.ToString("N2")</td>
                                </tr>
                            }
                            <tr style="background:var(--gray-50); font-weight:700;">
                                <td>Total cost to company</td>
                                <td class="num">@Model.EmployerCost.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <p class="meta" style="text-align:center; font-size:.75rem;">
            Calculated @Model.CalculatedAt.ToString("d MMMM yyyy HH:mm") against the statutory rates in
            force at @Model.PayrollRun?.StatutoryAsAt.ToString("d MMMM yyyy").
        </p>

    </div>
</div>
