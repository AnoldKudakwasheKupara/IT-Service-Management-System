@using IT_Service_Management_System.Models.Hr
@{
    ViewData["Title"] = "Statutory Rates";
    var parameters = ViewBag.Parameters as List<StatutoryParameter> ?? new List<StatutoryParameter>();
    var bands = ViewBag.Bands as List<PayeTaxBand> ?? new List<PayeTaxBand>();
    var currency = ViewBag.Currency as string ?? "USD";
    var currencies = ViewBag.Currencies as List<string> ?? new List<string>();

    var groups = parameters.GroupBy(p => p.Key.Split('.')[0]).OrderBy(g => g.Key);
    string Unit(StatutoryParameter p) => p.Kind switch
    {
        StatutoryValueKind.Percentage => "%",
        StatutoryValueKind.Amount => p.Currency ?? "",
        StatutoryValueKind.Days => "days",
        _ => "×"
    };
}

<partial name="_HrStyles" />

<div class="hr">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div style="display:flex; gap:.9rem; align-items:flex-start;">
                    <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-scale-balanced"></i> Statutory Rates</h1>
                        <p class="page-sub">The rates, ceilings and PAYE bands every payroll run reads</p>
                    </div>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        <div class="notice">
            <h4><i class="fas fa-circle-info"></i> Changing a rate never rewrites the past</h4>
            <p>
                A changed value creates a new dated row and closes the previous one. Payroll reads
                rates as at the end of the period it covers, so rerunning an old month still applies
                what was in force then. Record the Act, Statutory Instrument or gazette notice against
                every change — a payroll figure nobody can trace is a payroll figure nobody can defend.
            </p>
        </div>

        @foreach (var group in groups)
        {
            <div class="card">
                <div class="card-head">
                    <span class="t">
                        <i class="fas fa-folder"></i>
                        @(group.Key switch
                        {
                            "NSSA" => "National Social Security Authority",
                            "Tax" => "Tax",
                            "Levy" => "Employer levies",
                            "Leave" => "Leave entitlements",
                            "Time" => "Working time and overtime",
                            "Termination" => "Termination and retrenchment",
                            _ => group.Key
                        })
                    </span>
                </div>
                <div class="card-body flush">
                    <table class="tbl">
                        <thead><tr><th>Parameter</th><th class="num">Value</th><th>Effective</th><th>Authority</th><th style="text-align:right;">Change</th></tr></thead>
                        <tbody>
                            @foreach (var p in group.Where(x => x.EffectiveTo == null).OrderBy(x => x.Name))
                            {
                                <tr>
                                    <td>
                                        <strong style="color:var(--gray-800);">@p.Name</strong>
                                        <div class="meta" style="font-size:.7rem; font-family:ui-monospace, monospace;">@p.Key</div>
                                        @if (!string.IsNullOrWhiteSpace(p.Notes))
                                        {
                                            <div class="meta" style="font-size:.74rem; margin-top:.2rem;">@p.Notes</div>
                                        }
                                    </td>
                                    <td class="num">
                                        <strong style="color:@(p.Value <= 0 && p.Kind == StatutoryValueKind.Amount ? "var(--danger)" : "var(--gray-800)");">
                                            @p.Value.ToString("0.####") @Unit(p)
                                        </strong>
                                        @if (p.Value <= 0 && p.Kind == StatutoryValueKind.Amount)
                                        {
                                            <div><span class="badge-hr b-danger">Not set</span></div>
                                        }
                                    </td>
                                    <td class="meta">@p.EffectiveFrom.ToString("d MMM yyyy")</td>
                                    <td class="meta" style="font-size:.75rem; max-width:230px;">@p.Authority</td>
                                    <td style="text-align:right;">
                                        <form asp-action="SaveParameter" method="post" style="display:inline-flex; gap:.3rem; align-items:center;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <input type="number" name="value" step="0.0001" value="@p.Value" class="inp"
                                                   style="width:90px; padding:.25rem .4rem; font-size:.75rem;" required />
                                            <input type="date" name="effectiveFrom" class="inp"
                                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                   style="width:135px; padding:.25rem .4rem; font-size:.75rem;" required />
                                            <input type="text" name="authority" value="@p.Authority" class="inp"
                                                   style="width:140px; padding:.25rem .4rem; font-size:.75rem;" placeholder="Authority" />
                                            <button type="submit" class="act ok" title="Apply from that date"><i class="fas fa-check"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* ── PAYE BANDS ──────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-landmark"></i> PAYE bands — @currency</span>
                <div style="display:flex; gap:.5rem; align-items:center;">
                    <form method="get" style="display:inline-flex;">
                        <select name="currency" class="inp" style="width:auto; padding:.35rem .6rem; font-size:.8rem;" onchange="this.form.submit()">
                            @foreach (var c in currencies.DefaultIfEmpty("USD"))
                            {
                                <option value="@c" selected="@(c == currency)">@c</option>
                            }
                            @if (!currencies.Contains("USD")) { <option value="USD">USD</option> }
                            @if (!currencies.Contains("ZWG")) { <option value="ZWG">ZWG</option> }
                        </select>
                    </form>
                    <button type="button" class="btn-hr btn-sm" onclick="hrToggle('band-form')">
                        <i class="fas fa-plus"></i> Add band
                    </button>
                </div>
            </div>
            <div class="card-body">
                <p class="meta" style="margin-bottom:1rem;">
                    Modelled the way ZIMRA publishes the tables: tax is the income multiplied by the
                    band's rate, less the band's deduction. Load a complete set for each currency you
                    pay in — with none configured, no tax is deducted at all.
                </p>

                <form asp-action="SaveBand" method="post" id="band-form" style="display:none; margin-bottom:1.25rem; padding-bottom:1.25rem; border-bottom:1px solid var(--gray-200);">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="0" />
                    <input type="hidden" name="Currency" value="@currency" />
                    <div class="form-grid three">
                        <div class="fg">
                            <label class="lbl">Period</label>
                            <select name="Period" class="inp">
                                @foreach (var p in Enum.GetValues<PayPeriod>())
                                {
                                    <option value="@p" selected="@(p == PayPeriod.Monthly)">@p</option>
                                }
                            </select>
                        </div>
                        <div class="fg"><label class="lbl">From</label><input name="FromAmount" type="number" step="0.01" value="0" class="inp" required /></div>
                        <div class="fg">
                            <label class="lbl">To</label>
                            <input name="ToAmount" type="number" step="0.01" class="inp" placeholder="blank for the top band" />
                        </div>
                        <div class="fg"><label class="lbl">Rate %</label><input name="Rate" type="number" step="0.01" value="0" class="inp" required /></div>
                        <div class="fg"><label class="lbl">Deduction</label><input name="Deduction" type="number" step="0.01" value="0" class="inp" /></div>
                        <div class="fg"><label class="lbl">Effective from</label><input name="EffectiveFrom" type="date" class="inp" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
                        <div class="fg full"><label class="lbl">Authority</label><input name="Authority" class="inp" placeholder="e.g. Finance Act, 2026" /></div>
                    </div>
                    <button type="submit" class="btn-hr btn-sm"><i class="fas fa-floppy-disk"></i> Add band</button>
                </form>

                @if (bands.Count == 0)
                {
                    <div class="notice bad">
                        <h4><i class="fas fa-triangle-exclamation"></i> No PAYE bands for @currency</h4>
                        <p>Every @currency payslip will show zero tax until a table is loaded.</p>
                    </div>
                }
                else
                {
                    <table class="tbl">
                        <thead><tr><th>Period</th><th class="num">From</th><th class="num">To</th><th class="num">Rate</th><th class="num">Deduction</th><th>Effective</th><th>Authority</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var b in bands)
                            {
                                var live = b.EffectiveFrom <= DateTime.Today && (b.EffectiveTo == null || b.EffectiveTo >= DateTime.Today);
                                <tr style="@(live ? "" : "opacity:.55;")">
                                    <td class="meta">@b.Period</td>
                                    <td class="num">@b.FromAmount.ToString("N2")</td>
                                    <td class="num">@(b.ToAmount?.ToString("N2") ?? "and above")</td>
                                    <td class="num"><strong>@b.Rate.ToString("0.##")%</strong></td>
                                    <td class="num meta">@b.Deduction.ToString("N2")</td>
                                    <td class="meta">
                                        @b.EffectiveFrom.ToString("d MMM yy")
                                        @if (live) { <span class="badge-hr b-active">Live</span> }
                                    </td>
                                    <td class="meta" style="font-size:.75rem;">@b.Authority</td>
                                    <td style="text-align:right;">
                                        <form asp-action="DeleteBand" method="post" class="inline-form"
                                              onsubmit="return confirm('Remove this band?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <input type="hidden" name="currency" value="@currency" />
                                            <button type="submit" class="act del"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function hrToggle(id) {
            const el = document.getElementById(id);
            if (!el) return;
            el.style.display = el.style.display === 'none' ? 'block' : 'none';
            if (el.style.display === 'block') el.querySelector('input, select, textarea')?.focus();
        }
    </script>
}
