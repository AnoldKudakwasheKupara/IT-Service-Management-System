@using IT_Service_Management_System.Models.Hr
@using IT_Service_Management_System.Services.Hr
@model PayrollRun
@{
    ViewData["Title"] = $"{Model.Reference} — {Model.PeriodName}";
    var payslips = ViewBag.Payslips as List<Payslip> ?? new List<Payslip>();
    var returns = ViewBag.Returns as List<PayrollService.StatutoryReturn> ?? new List<PayrollService.StatutoryReturn>();

    string StatusClass(PayrollRunStatus s) => s switch
    {
        PayrollRunStatus.Paid => "b-active",
        PayrollRunStatus.Approved => "b-leave",
        PayrollRunStatus.Calculated => "b-probation",
        PayrollRunStatus.Cancelled => "b-left",
        _ => "b-neutral"
    };
}

<partial name="_HrStyles" />

<div class="hr wide">
    <div class="page-container">

        <div class="page-header">
            <div class="head-row">
                <div style="display:flex; gap:.9rem; align-items:flex-start;">
                    <a asp-action="Index" asp-route-year="@Model.PeriodYear" class="btn-back"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-money-check-dollar"></i> @Model.PeriodName</h1>
                        <div class="page-sub" style="display:flex; gap:.5rem; flex-wrap:wrap; align-items:center;">
                            <span class="ref">@Model.Reference</span>
                            <span class="chip">@Model.Currency</span>
                            <span class="badge-hr @StatusClass(Model.Status)">@Model.Status</span>
                            <span class="meta">rates as at @Model.StatutoryAsAt.ToString("d MMM yyyy")</span>
                        </div>
                    </div>
                </div>
                <div class="head-actions">
                    @if (!Model.IsLocked)
                    {
                        <form asp-action="Calculate" asp-route-id="@Model.Id" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-hr">
                                <i class="fas fa-calculator"></i> @(payslips.Count > 0 ? "Recalculate" : "Calculate")
                            </button>
                        </form>
                    }
                    @if (Model.Status == PayrollRunStatus.Calculated)
                    {
                        <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="inline-form"
                              onsubmit="return confirm('Approve this run? The figures lock and payslips become visible to employees.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-success-hr"><i class="fas fa-check"></i> Approve</button>
                        </form>
                    }
                    @if (Model.Status == PayrollRunStatus.Approved)
                    {
                        <form asp-action="MarkPaid" asp-route-id="@Model.Id" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-outline-hr"><i class="fas fa-money-bill-transfer"></i> Mark paid</button>
                        </form>
                    }
                    <button type="button" class="btn-ghost-hr" onclick="window.print()"><i class="fas fa-print"></i> Print</button>
                </div>
            </div>
        </div>

        <partial name="_HrAlerts" />

        @if (Model.IsLocked)
        {
            <div class="notice">
                <h4><i class="fas fa-lock"></i> This run is locked</h4>
                <p>
                    Approved on @Model.ApprovedAt?.ToString("d MMMM yyyy") by @Model.ApprovedBy?.FirstName
                    @Model.ApprovedBy?.LastName. Payslips cannot change after approval — that is what
                    makes them usable as evidence of what was paid.
                </p>
            </div>
        }

        <div class="stats">
            <div class="stat">
                <div class="ic brand"><i class="fas fa-users"></i></div>
                <div><h3>@Model.EmployeeCount</h3><p>Employees</p></div>
            </div>
            <div class="stat">
                <div class="ic blue"><i class="fas fa-sack-dollar"></i></div>
                <div><h3>@Model.TotalGross.ToString("N0")</h3><p>Gross</p><span class="sub">@Model.Currency</span></div>
            </div>
            <div class="stat">
                <div class="ic red"><i class="fas fa-landmark"></i></div>
                <div>
                    <h3>@((Model.TotalPaye + Model.TotalAidsLevy).ToString("N0"))</h3>
                    <p>PAYE + AIDS levy</p>
                </div>
            </div>
            <div class="stat">
                <div class="ic amber"><i class="fas fa-shield-halved"></i></div>
                <div>
                    <h3>@Model.TotalNssaEmployee.ToString("N0")</h3>
                    <p>NSSA (employee)</p>
                    <span class="sub">@Model.TotalNssaEmployer.ToString("N0") employer</span>
                </div>
            </div>
            <div class="stat">
                <div class="ic green"><i class="fas fa-hand-holding-dollar"></i></div>
                <div><h3>@Model.TotalNet.ToString("N0")</h3><p>Net pay</p></div>
            </div>
            <div class="stat">
                <div class="ic purple"><i class="fas fa-building-columns"></i></div>
                <div>
                    <h3>@Model.TotalEmployerCost.ToString("N0")</h3>
                    <p>Cost to company</p>
                    <span class="sub">incl. levies</span>
                </div>
            </div>
        </div>

        @* ── STATUTORY RETURNS ───────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-file-invoice-dollar"></i> What must be remitted</span>
                <span class="meta">For the month's returns</span>
            </div>
            <div class="card-body flush">
                <table class="tbl">
                    <thead><tr><th>Payee</th><th>Item</th><th class="num">Amount</th><th>Basis</th></tr></thead>
                    <tbody>
                        @foreach (var r in returns.Where(x => x.Amount > 0))
                        {
                            <tr>
                                <td><strong>@r.Payee</strong></td>
                                <td>@r.Description</td>
                                <td class="num"><strong>@r.Currency @r.Amount.ToString("N2")</strong></td>
                                <td class="meta" style="font-size:.75rem;">@r.Basis</td>
                            </tr>
                        }
                        @if (returns.All(x => x.Amount <= 0))
                        {
                            <tr><td colspan="4" class="meta" style="padding:1.25rem;">Nothing to remit — the run has not been calculated, or no statutory rates are configured.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ── PAYSLIPS ────────────────────────────────────────────────────── *@
        <div class="card">
            <div class="card-head">
                <span class="t"><i class="fas fa-receipt"></i> Payslips</span>
                <span class="meta">@payslips.Count</span>
            </div>
            <div class="card-body flush">
                @if (payslips.Count == 0)
                {
                    <div class="empty">
                        <i class="fas fa-receipt"></i>
                        <h3>Not calculated yet</h3>
                        <p>Calculate the run to produce payslips. You can recalculate as often as you like until it is approved.</p>
                    </div>
                }
                else
                {
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Employee</th><th>Department</th><th class="num">Basic</th><th class="num">Gross</th>
                                <th class="num">PAYE</th><th class="num">NSSA</th><th class="num">Deductions</th>
                                <th class="num">Net</th><th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in payslips)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Employee" asp-route-id="@p.EmployeeId" class="strong-link">@p.Employee?.DisplayName</a>
                                        <div class="meta" style="font-size:.7rem;">@p.Employee?.EmployeeNumber</div>
                                        @if (p.UnpaidLeaveDays > 0 || p.HalfPayLeaveDays > 0)
                                        {
                                            <span class="badge-hr b-warn" style="font-size:.65rem;">
                                                @(p.UnpaidLeaveDays > 0 ? $"{p.UnpaidLeaveDays:0.##} unpaid" : "")
                                                @(p.HalfPayLeaveDays > 0 ? $"{p.HalfPayLeaveDays:0.##} half pay" : "")
                                            </span>
                                        }
                                    </td>
                                    <td class="meta">@(p.Employee?.Department?.Name ?? "—")</td>
                                    <td class="num meta">@p.BasicSalary.ToString("N2")</td>
                                    <td class="num">@p.Gross.ToString("N2")</td>
                                    <td class="num">@((p.Paye + p.AidsLevy).ToString("N2"))</td>
                                    <td class="num">@p.NssaEmployee.ToString("N2")</td>
                                    <td class="num meta">@p.TotalDeductions.ToString("N2")</td>
                                    <td class="num"><strong>@p.Net.ToString("N2")</strong></td>
                                    <td style="text-align:right;">
                                        <a asp-action="Payslip" asp-route-id="@p.Id" class="act view"><i class="fas fa-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background:var(--gray-50); font-weight:700;">
                                <td colspan="3">Totals</td>
                                <td class="num">@Model.TotalGross.ToString("N2")</td>
                                <td class="num">@((Model.TotalPaye + Model.TotalAidsLevy).ToString("N2"))</td>
                                <td class="num">@Model.TotalNssaEmployee.ToString("N2")</td>
                                <td class="num">@((Model.TotalPaye + Model.TotalAidsLevy + Model.TotalNssaEmployee + Model.TotalOtherDeductions).ToString("N2"))</td>
                                <td class="num">@Model.TotalNet.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>
        </div>

    </div>
</div>
