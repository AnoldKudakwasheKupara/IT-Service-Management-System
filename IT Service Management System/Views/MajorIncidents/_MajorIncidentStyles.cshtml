@* Command-console specific styling. Global design system (tokens, cards, badges, buttons)
   lives in site.css; this partial only adds the major-incident sections and timeline. *@
<style>
    .mi-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1.25rem; align-items: start; }
    @@media (max-width: 992px) { .mi-grid { grid-template-columns: 1fr; } }

    .mi-section { background: #fff; border: 1px solid var(--gray-200, #e2e8f0); border-radius: 1rem; margin-bottom: 1.25rem; overflow: hidden; }
    .mi-section > h2 { font-size: .8rem; text-transform: uppercase; letter-spacing: .5px; color: var(--gray-500, #64748b);
        margin: 0; padding: .9rem 1.15rem; background: var(--gray-50, #f8fafc); border-bottom: 1px solid var(--gray-200, #e2e8f0);
        display: flex; align-items: center; gap: .5rem; }
    .mi-section .mi-body { padding: 1.15rem; }

    .mi-hero { border-radius: 1rem; padding: 1.5rem 1.75rem; color: #fff; margin-bottom: 1.25rem;
        background: linear-gradient(120deg, #7f1d1d, #dc2626); }
    .mi-hero.sev2 { background: linear-gradient(120deg, #78350f, #d97706); }
    .mi-hero h1 { font-size: 1.5rem; margin: 0 0 .35rem; }
    .mi-hero .mi-ref { font-size: .8rem; font-weight: 700; letter-spacing: .5px; opacity: .85; }
    .mi-hero .mi-meta { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: .9rem; font-size: .85rem; }
    .mi-hero .mi-meta span { opacity: .95; } .mi-hero .mi-meta strong { display: block; opacity: .7; font-size: .68rem; text-transform: uppercase; }

    .mi-roles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; }
    .mi-role { border: 1px solid var(--gray-200, #e2e8f0); border-radius: .6rem; padding: .7rem .85rem; }
    .mi-role .lbl { font-size: .68rem; text-transform: uppercase; color: var(--gray-500, #64748b); letter-spacing: .5px; }
    .mi-role .val { font-weight: 600; color: var(--gray-800, #1e293b); }

    .mi-timeline { list-style: none; margin: 0; padding: 0; }
    .mi-timeline li { position: relative; padding: 0 0 1.1rem 1.4rem; border-left: 2px solid var(--gray-200, #e2e8f0); }
    .mi-timeline li:last-child { border-left-color: transparent; padding-bottom: 0; }
    .mi-timeline li::before { content: ''; position: absolute; left: -6px; top: .2rem; width: 10px; height: 10px;
        border-radius: 50%; background: var(--primary, #3b82f6); }
    .mi-timeline .t-time { font-size: .72rem; color: var(--gray-500, #64748b); }
    .mi-timeline .t-detail { color: var(--gray-800, #1e293b); }
    .mi-timeline .t-kind { font-size: .64rem; text-transform: uppercase; letter-spacing: .5px; color: var(--gray-400, #94a3b8); }

    .mi-update { border: 1px solid var(--gray-200, #e2e8f0); border-radius: .6rem; padding: .8rem .95rem; margin-bottom: .75rem; }
    .mi-update .u-head { display: flex; justify-content: space-between; gap: .5rem; font-size: .72rem; color: var(--gray-500, #64748b); margin-bottom: .3rem; }

    .mi-inline-form { display: flex; flex-wrap: wrap; gap: .5rem; align-items: flex-end; }
    .mi-inline-form .form-control, .mi-inline-form .form-select { min-width: 140px; }
    .mi-field { margin-bottom: .9rem; }
    .mi-field label { display: block; font-size: .74rem; font-weight: 600; color: var(--gray-600, #475569);
        margin-bottom: .35rem; text-transform: uppercase; letter-spacing: .4px; }

    .mi-affected { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .mi-affected th, .mi-affected td { padding: .55rem .6rem; border-bottom: 1px solid var(--gray-200, #e2e8f0); text-align: left; }
    .mi-affected th { font-size: .68rem; text-transform: uppercase; color: var(--gray-500, #64748b); }

    .mi-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: .75rem; }
    .mi-metric { text-align: center; border: 1px solid var(--gray-200, #e2e8f0); border-radius: .6rem; padding: .75rem .5rem; }
    .mi-metric strong { display: block; font-size: 1.35rem; color: var(--gray-800, #1e293b); }
    .mi-metric span { font-size: .68rem; text-transform: uppercase; color: var(--gray-500, #64748b); }
</style>
