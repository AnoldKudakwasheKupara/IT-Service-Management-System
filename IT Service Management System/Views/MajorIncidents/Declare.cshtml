@model IT_Service_Management_System.Models.Itsm.MajorIncident
@using IT_Service_Management_System.Models.Itsm
@{
    ViewData["Title"] = "Declare Major Incident";
    var agents = ViewBag.Agents as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var tickets = ViewBag.Tickets as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}
@await Html.PartialAsync("_MajorIncidentStyles")

<div class="page-container">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title"><i class="fas fa-bullhorn me-2" style="color:var(--danger,#e53e3e);"></i>Declare Major Incident</h1>
                <p class="text-muted mt-2">Open a coordinated response for a high-impact (P1/P2) incident</p>
            </div>
            <a asp-action="Index" class="btn-back"><i class="fas fa-arrow-left me-2"></i>Back</a>
        </div>
    </div>

    <form asp-action="Declare" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mi-grid">
            <div>
                <div class="mi-section">
                    <h2><i class="fas fa-circle-info"></i> Declaration</h2>
                    <div class="mi-body">
                        <div class="mi-field">
                            <label>Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Short, specific summary of the outage" autofocus />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="mi-field">
                            <label>Situation summary</label>
                            <textarea asp-for="Summary" class="form-control" rows="3" placeholder="What is happening and who/what is impacted?"></textarea>
                        </div>
                        <div class="mi-field">
                            <label>Business impact</label>
                            <textarea asp-for="BusinessImpact" class="form-control" rows="2" placeholder="Revenue, customers, safety, compliance impact"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <div class="mi-section">
                    <h2><i class="fas fa-gauge-high"></i> Classification</h2>
                    <div class="mi-body">
                        <div class="mi-field">
                            <label>Severity</label>
                            <select asp-for="Severity" class="form-select">
                                <option value="@MajorIncidentSeverity.Sev1">SEV 1 — Critical (widespread / no workaround)</option>
                                <option value="@MajorIncidentSeverity.Sev2">SEV 2 — High (major degradation)</option>
                            </select>
                        </div>
                        <div class="mi-field">
                            <label>Detected at</label>
                            <input asp-for="DetectedAt" type="datetime-local" class="form-control" />
                        </div>
                        <div class="mi-field">
                            <label>Escalated from ticket</label>
                            <select asp-for="SourceTicketId" class="form-select">
                                <option value="">— none —</option>
                                @foreach (var t in tickets) { <option value="@t.Id">@t.Label</option> }
                            </select>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn-create w-100"><i class="fas fa-bullhorn me-2"></i>Declare Incident</button>
            </div>
        </div>
    </form>
</div>
