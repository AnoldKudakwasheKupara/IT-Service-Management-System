@{
    var active = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="doc-nav-container">
    <div class="doc-nav-wrapper">
        <a asp-action="Categories"
           class="doc-nav-btn @(active == "Categories" ? "active" : "")">
            <i class="fas fa-tags"></i>
            <span>Categories</span>
        </a>
        <a asp-action="Required"
           class="doc-nav-btn @(active == "Required" ? "active" : "")">
            <i class="fas fa-list-check"></i>
            <span>Required Documents</span>
        </a>
        <a asp-action="Retention"
           class="doc-nav-btn @(active == "Retention" ? "active" : "")">
            <i class="fas fa-clock-rotate-left"></i>
            <span>Retention Policies</span>
        </a>
    </div>
</div>

<style>
    /* ===== DOCUMENT NAVIGATION ===== */
    .doc-nav-container {
        margin-bottom: 1.5rem;
    }

    .doc-nav-wrapper {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        background: white;
        padding: 0.5rem;
        border-radius: 1rem;
        border: 1px solid var(--gray-200);
        box-shadow: var(--shadow-sm);
    }

    .doc-nav-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        border-radius: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--gray-600);
        background: transparent;
        border: none;
        text-decoration: none;
        transition: all 0.25s ease;
        cursor: pointer;
        font-family: inherit;
        position: relative;
    }

        .doc-nav-btn i {
            font-size: 0.9rem;
            color: var(--gray-400);
            transition: color 0.25s ease;
        }

        .doc-nav-btn:hover {
            color: var(--gray-800);
            background: var(--gray-50);
            text-decoration: none;
        }

            .doc-nav-btn:hover i {
                color: var(--gray-500);
            }

        .doc-nav-btn.active {
            background: linear-gradient(100deg, var(--primary-dark), var(--primary));
            color: white;
            box-shadow: var(--shadow-sm);
        }

            .doc-nav-btn.active i {
                color: white;
            }

            .doc-nav-btn.active:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-1px);
                color: white;
            }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 576px) {
        .doc-nav-wrapper {
            flex-direction: column;
            padding: 0.5rem;
            gap: 0.25rem;
        }

        .doc-nav-btn {
            justify-content: center;
            padding: 0.6rem 1rem;
            width: 100%;
        }

            .doc-nav-btn i {
                font-size: 0.9rem;
            }
    }

    /* ===== PRINT STYLES ===== */
    @@media print {
        .doc-nav-container {
            display: none !important;
        }
    }
</style>