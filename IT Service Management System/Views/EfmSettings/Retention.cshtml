@model List<IT_Service_Management_System.Models.Efm.RetentionPolicy>
@using IT_Service_Management_System.Models.Efm
@{
    ViewData["Title"] = "Retention Policies - File Settings";
    var cats = ViewBag.Categories as List<DocumentCategory> ?? new();
    var folders = ViewBag.Folders as List<DocumentFolder> ?? new();
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-sliders me-2" style="color: var(--primary);"></i>
                    File Settings
                </h1>
                <p class="text-muted mt-2">
                    Retention rules decide when documents are archived, deleted or flagged after their retention period.
                </p>
            </div>
            <button class="btn-create-ticket" onclick="openPol()">
                <i class="fas fa-plus"></i> New Policy
            </button>
        </div>

        <!-- Navigation -->
        <partial name="_Nav" />
    </div>

    <!-- INFO ALERT -->
    <div class="alert-flash info">
        <i class="fas fa-circle-info"></i>
        <span>
            Retention is measured from a document's issue date (or upload date). The 6-hourly maintenance job applies these rules;
            you can also run it from <a asp-controller="EmployeeDocuments" asp-action="Notifications" class="alert-link">Notifications</a>.
        </span>
    </div>

    <!-- RETENTION POLICIES CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-clock-rotate-left me-2"></i>
                <span>Retention Policies</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-chart-simple"></i>
                <span>@Model.Count</span> policies
            </div>
        </div>
        <div class="table-responsive">
            <table class="tickets-table" id="retentionTable">
                <thead>
                    <tr>
                        <th><i class="fas fa-file-signature me-1"></i> Name</th>
                        <th><i class="fas fa-crosshairs me-1"></i> Scope</th>
                        <th><i class="fas fa-clock me-1"></i> Retain for</th>
                        <th><i class="fas fa-bolt me-1"></i> Action</th>
                        <th><i class="fas fa-chart-simple me-1"></i> Status</th>
                        <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr class="@(p.IsActive ? "" : "inactive-row")">
                                <td>
                                    <div class="policy-name-cell">
                                        <strong>@p.Name</strong>
                                    </div>
                                </td>
                                <td>
                                    @if (p.Category != null)
                                    {
                                        <span class="scope-badge scope-category">
                                            <i class="fas fa-tag"></i> @p.Category.Name
                                        </span>
                                    }
                                    else if (p.Folder != null)
                                    {
                                        <span class="scope-badge scope-folder">
                                            <i class="fas fa-folder"></i> @p.Folder.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="scope-badge scope-all">
                                            <i class="fas fa-globe"></i> All documents
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (p.RetentionYears.HasValue)
                                    {
                                        <span class="retention-period-badge">
                                            <i class="fas fa-calendar-alt"></i> @p.RetentionYears year(s)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="retention-period-badge permanent">
                                            <i class="fas fa-infinity"></i> Permanent
                                        </span>
                                    }
                                </td>
                                <td>
                                    @switch (p.Action)
                                    {
                                        case RetentionAction.Archive:
                                            <span class="action-badge action-archive">
                                                <i class="fas fa-box-archive"></i> Archive
                                            </span>
                                            break;
                                        case RetentionAction.Delete:
                                            <span class="action-badge action-delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </span>
                                            break;
                                        default:
                                            <span class="action-badge action-flag">
                                                <i class="fas fa-flag"></i> Flag
                                            </span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (p.IsActive)
                                    {
                                        <span class="status-badge status-active">Active</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="action-btn btn-edit" title="Edit Policy"
                                                onclick="openPol(@p.Id, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Name))', @(p.CategoryId?.ToString() ?? "null"), @(p.FolderId?.ToString() ?? "null"), @(p.RetentionYears?.ToString() ?? "null"), @((int)p.Action), @p.IsActive.ToString().ToLower())">
                                            <i class="fas fa-pen"></i>
                                        </button>
                                        <form asp-action="ToggleRetention" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button class="action-btn @(p.IsActive ? "btn-toggle-on" : "btn-toggle-off")"
                                                    title="@(p.IsActive ? "Deactivate" : "Activate")">
                                                <i class="fas @(p.IsActive ? "fa-toggle-on" : "fa-toggle-off")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state-mini">
                                    <i class="fas fa-clock-rotate-left"></i>
                                    <span>No retention policies defined — documents are kept permanently.</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="polModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="SaveRetention" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="polId" value="0" />
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-clock-rotate-left me-2" style="color: var(--primary);"></i>
                        <span id="polModalTitle">New Policy</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Policy name <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="name" id="polName" class="form-control" required maxlength="150" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category scope</label>
                            <select name="categoryId" id="polCategory" class="form-select">
                                <option value="">— Any —</option>
                                @foreach (var c in cats)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Folder scope</label>
                            <select name="folderId" id="polFolder" class="form-select">
                                <option value="">— Any —</option>
                                @foreach (var f in folders)
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Retain for (years)</label>
                            <input type="number" name="retentionYears" id="polYears" class="form-control" min="0" max="100" placeholder="Permanent" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Action when reached</label>
                            <select name="action" id="polAction" class="form-select">
                                <option value="1">Archive</option>
                                <option value="0">Flag only</option>
                                <option value="2">Delete</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isActive" id="polActive" value="true" checked />
                                <label class="form-check-label" for="polActive">
                                    <i class="fas fa-check-circle text-success me-1"></i> Active
                                </label>
                            </div>
                            <small class="form-hint">
                                <i class="fas fa-info-circle"></i>
                                Category scope takes precedence over folder scope. Leave both empty to apply to all documents.
                            </small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-modal-save">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openPol(id, name, catId, folderId, years, action, active) {
        document.getElementById('polId').value = id || 0;
        document.getElementById('polName').value = name || '';
        document.getElementById('polCategory').value = catId ?? '';
        document.getElementById('polFolder').value = folderId ?? '';
        document.getElementById('polYears').value = (years ?? '') === null ? '' : (years ?? '');
        document.getElementById('polAction').value = (action ?? 1);
        document.getElementById('polActive').checked = id ? !!active : true;
        document.getElementById('polModalTitle').textContent = id ? 'Edit Policy' : 'New Policy';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('polModal')).show();
    }
</script>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 0.875rem;
        border: 1px solid transparent;
        background: #eff6ff;
        border-color: #bfdbfe;
        color: #1e40af;
        line-height: 1.5;
    }

        .alert-flash i {
            font-size: 1.1rem;
            margin-top: 0.1rem;
            flex-shrink: 0;
        }

        .alert-flash .alert-link {
            color: var(--primary-dark);
            font-weight: 600;
            text-decoration: underline;
        }

            .alert-flash .alert-link:hover {
                color: var(--primary);
            }

    /* ===== DATA CARD ===== */
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .ticket-count {
        font-size: 0.875rem;
        font-weight: normal;
        color: var(--gray-500);
    }

    /* ===== TABLE STYLES ===== */
    .table-responsive {
        overflow-x: auto;
    }

    .tickets-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

        .tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .tickets-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .tickets-table td {
            padding: 0.9rem 1.5rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .tickets-table tbody tr {
            transition: background-color 0.15s;
        }

            .tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

            .tickets-table tbody tr:last-child td {
                border-bottom: none;
            }

            .tickets-table tbody tr.inactive-row {
                opacity: 0.6;
            }

                .tickets-table tbody tr.inactive-row:hover {
                    opacity: 0.8;
                }

    /* ===== POLICY SPECIFIC ===== */
    .policy-name-cell strong {
        color: var(--gray-800);
        font-size: 0.95rem;
    }

    /* ===== SCOPE BADGES ===== */
    .scope-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .scope-category {
        background: #e6f0ff;
        color: var(--info);
        border: 1px solid #cce4ff;
    }

    .scope-folder {
        background: #f3e8ff;
        color: #7c3aed;
        border: 1px solid #e9d5ff;
    }

    .scope-all {
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
    }

    /* ===== RETENTION PERIOD BADGE ===== */
    .retention-period-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.15rem 0.6rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        background: var(--gray-100);
        color: var(--gray-600);
        border: 1px solid var(--gray-200);
    }

        .retention-period-badge.permanent {
            background: #e6f0ff;
            color: var(--info);
            border-color: #cce4ff;
        }

        .retention-period-badge i {
            font-size: 0.65rem;
        }

    /* ===== ACTION BADGES ===== */
    .action-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .action-archive {
        background: #fffbeb;
        color: #92400e;
        border: 1px solid #fde68a;
    }

    .action-delete {
        background: #fee;
        color: var(--danger);
        border: 1px solid #fed7d7;
    }

    .action-flag {
        background: #e6f0ff;
        color: var(--info);
        border: 1px solid #cce4ff;
    }

    /* ===== STATUS BADGES ===== */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.7rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .status-active {
        background: #e6f5e9;
        color: var(--success);
        border: 1px solid #c6e0c9;
    }

    .status-inactive {
        background: var(--gray-100);
        color: var(--gray-500);
        border: 1px solid var(--gray-300);
    }

    /* ===== ACTION BUTTONS ===== */
    .action-buttons {
        display: flex;
        gap: 0.25rem;
        justify-content: flex-end;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.8rem;
        border: none;
        cursor: pointer;
    }

    .btn-edit {
        background: var(--gray-100);
        color: var(--warning);
    }

        .btn-edit:hover {
            background: var(--warning);
            color: white;
            transform: translateY(-2px);
        }

    .btn-toggle-on {
        background: var(--gray-100);
        color: var(--success);
    }

        .btn-toggle-on:hover {
            background: var(--success);
            color: white;
            transform: translateY(-2px);
        }

    .btn-toggle-off {
        background: var(--gray-100);
        color: var(--gray-500);
    }

        .btn-toggle-off:hover {
            background: var(--gray-500);
            color: white;
            transform: translateY(-2px);
        }

    /* ===== EMPTY STATE ===== */
    .empty-state-mini {
        text-align: center;
        padding: 2rem;
        color: var(--gray-500);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .empty-state-mini i {
            font-size: 2rem;
            color: var(--gray-300);
            margin-bottom: 0.25rem;
        }

        .empty-state-mini span {
            font-size: 0.95rem;
        }

    /* ===== MODAL STYLES ===== */
    .modal-content {
        border-radius: 1rem;
        border: 1px solid var(--gray-200);
        box-shadow: var(--shadow-lg);
    }

    .modal-header {
        background: var(--gray-50);
        border-bottom: 1px solid var(--gray-200);
        padding: 1.25rem 1.5rem;
        border-radius: 1rem 1rem 0 0;
    }

        .modal-header .modal-title {
            font-weight: 700;
            color: var(--gray-800);
            font-size: 1.1rem;
        }

            .modal-header .modal-title i {
                color: var(--primary);
            }

    .modal-body {
        padding: 1.5rem;
    }

    .modal-footer {
        background: var(--gray-50);
        border-top: 1px solid var(--gray-200);
        padding: 1rem 1.5rem;
        border-radius: 0 0 1rem 1rem;
        gap: 0.5rem;
    }

        .modal-footer .btn-modal-cancel {
            padding: 0.5rem 1.25rem;
            border-radius: 0.5rem;
            background: white;
            color: var(--gray-600);
            border: 1.5px solid var(--gray-200);
            font-weight: 600;
            font-size: 0.875rem;
            transition: all 0.2s;
            cursor: pointer;
        }

            .modal-footer .btn-modal-cancel:hover {
                background: var(--gray-50);
                border-color: var(--gray-300);
            }

        .modal-footer .btn-modal-save {
            padding: 0.5rem 1.25rem;
            border-radius: 0.5rem;
            background: linear-gradient(100deg, var(--primary-dark), var(--primary));
            color: white;
            border: none;
            font-weight: 600;
            font-size: 0.875rem;
            transition: all 0.2s;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

            .modal-footer .btn-modal-save:hover {
                transform: translateY(-1px);
                box-shadow: var(--shadow-md);
            }

    .modal-body .form-label {
        font-size: 0.8rem;
        color: var(--gray-600);
        margin-bottom: 0.25rem;
    }

    .modal-body .form-control,
    .modal-body .form-select {
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .modal-body .form-control:focus,
        .modal-body .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            outline: none;
        }

    .modal-body .form-check-input {
        accent-color: var(--primary);
        width: 1.1rem;
        height: 1.1rem;
        margin-top: 0.1rem;
    }

    .modal-body .form-check-label {
        font-size: 0.875rem;
        color: var(--gray-700);
        cursor: pointer;
    }

    .modal-body .text-danger {
        color: var(--danger) !important;
    }

    .modal-body .form-hint {
        display: block;
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: var(--gray-500);
    }

        .modal-body .form-hint i {
            margin-right: 0.25rem;
            color: var(--gray-400);
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .page-header .d-flex.align-items-center {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 1rem;
        }

        .alert-flash {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }

        .tickets-table th,
        .tickets-table td {
            padding: 0.6rem 0.8rem;
        }

        .tickets-table {
            font-size: 0.8rem;
        }

        .action-btn {
            width: 30px;
            height: 30px;
            font-size: 0.7rem;
        }

        .modal-dialog {
            margin: 1rem;
        }

        .scope-badge,
        .action-badge,
        .status-badge,
        .retention-period-badge {
            font-size: 0.6rem;
            padding: 0.1rem 0.4rem;
        }
    }

    @@media (max-width: 576px) {
