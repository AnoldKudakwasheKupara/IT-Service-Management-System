@model IT_Service_Management_System.Models.User
@{
    ViewData["Title"] = $"{Model.FullName} - Employee Files";
    var files = ViewBag.Files as List<IT_Service_Management_System.Models.EmployeeFile> ?? new();
    string Size(long b) => b >= 1048576 ? $"{b / 1048576.0:0.#} MB" : b >= 1024 ? $"{b / 1024.0:0.#} KB" : $"{b} B";
    string Icon(string name)
    {
        var e = System.IO.Path.GetExtension(name).ToLowerInvariant();
        return e switch
        {
            ".pdf" => "fa-file-pdf",
            ".doc" or ".docx" => "fa-file-word",
            ".xls" or ".xlsx" or ".csv" => "fa-file-excel",
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".bmp" or ".webp" => "fa-file-image",
            ".zip" or ".rar" or ".7z" => "fa-file-zipper",
            ".txt" => "fa-file-lines",
            _ => "fa-file"
        };
    }
    var categories = new[] { "Contract", "ID Document", "Certificate", "Qualification", "Payslip", "Appraisal", "Medical", "Other" };
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex align-items-center gap-3 mb-4">
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="page-title">
                    <i class="fas fa-user me-2" style="color: var(--primary);"></i>
                    @Model.FullName
                </h1>
                <p class="text-muted mt-2">
                    <i class="fas fa-envelope me-1"></i> @Model.Email
                    <span class="mx-2">·</span>
                    <i class="fas fa-building me-1"></i> @(Model.Department?.Name ?? "No department")
                    <span class="mx-2">·</span>
                    <i class="fas fa-user-tag me-1"></i> @Model.Role
                </p>
            </div>
            <div class="ms-auto">
                <span class="ticket-status-badge @(Model.IsActive ? "active" : "closed")">
                    @if (Model.IsActive)
                    {
                        <i class="fas fa-circle"></i>
                        <span>Active</span>
                    }
                    else
                    {
                        <i class="fas fa-ban"></i>
                        <span>Inactive</span>
                    }
                </span>
            </div>
        </div>
    </div>

    <!-- STATISTICS CARDS -->
    <div class="stats-cards mb-4">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, var(--primary-light), var(--primary));">
                <i class="fas fa-file-alt"></i>
            </div>
            <div class="stat-info">
                <h3>@files.Count</h3>
                <p>Total Documents</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #2c9e6e, #227a55);">
                <i class="fas fa-file-pdf"></i>
            </div>
            <div class="stat-info">
                <h3>@files.Count(f => System.IO.Path.GetExtension(f.FileName).ToLowerInvariant() == ".pdf")</h3>
                <p>PDF Files</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #f5b042, #e6a017);">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-info">
                <h3>@(files.Any() ? files.Max(f => f.UploadedAt).ToString("MMM dd") : "—")</h3>
                <p>Latest Upload</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #8b5cf6, #7c3aed);">
                <i class="fas fa-folder"></i>
            </div>
            <div class="stat-info">
                <h3>@files.Select(f => f.Category).Distinct().Count()</h3>
                <p>Categories Used</p>
            </div>
        </div>
    </div>

    <!-- UPLOAD CARD -->
    <div class="upload-card mb-4">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-cloud-arrow-up me-2"></i>
                <span>Upload Documents</span>
            </div>
            <span class="upload-hint">
                <i class="fas fa-info-circle"></i>
                Up to 25 MB per file
            </span>
        </div>
        <div class="card-body-custom">
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="upload-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="employeeId" value="@Model.Id" />

                <div class="upload-grid">
                    <div class="upload-field">
                        <label class="field-label">
                            <i class="fas fa-tag"></i>
                            Category
                        </label>
                        <select name="category" class="filter-select">
                            <option value="">— None —</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="upload-field">
                        <label class="field-label">
                            <i class="fas fa-pencil-alt"></i>
                            Description (optional)
                        </label>
                        <input type="text" name="description" class="search-input"
                               placeholder="e.g. Signed employment contract 2026" maxlength="500" />
                    </div>
                    <div class="upload-field full-width">
                        <label class="field-label">
                            <i class="fas fa-paperclip"></i>
                            Files
                        </label>
                        <div class="file-drop-zone">
                            <input type="file" name="files" id="fileInput" multiple required />
                            <label for="fileInput" class="file-drop-label">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <span>Drop files here or click to browse</span>
                                <span class="file-hint">Supports all document types</span>
                            </label>
                            <div id="fileList" class="file-list"></div>
                        </div>
                    </div>
                    <div class="upload-field full-width">
                        <button type="submit" class="btn-upload">
                            <i class="fas fa-upload"></i>
                            Upload Files
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- DOCUMENTS CARD -->
    <div class="data-card">
        <div class="card-header-custom">
            <div>
                <i class="fas fa-paperclip me-2"></i>
                <span>Documents</span>
            </div>
            <div class="ticket-count">
                <i class="fas fa-file"></i>
                <span>@files.Count</span> file(s)
            </div>
        </div>
        <div class="table-responsive">
            @if (files.Any())
            {
                <table class="data-table tickets-table" id="filesTable">
                    <thead>
                        <tr>
                            <th><i class="fas fa-file me-1"></i> File</th>
                            <th><i class="fas fa-tag me-1"></i> Category</th>
                            <th><i class="fas fa-weight-scale me-1"></i> Size</th>
                            <th><i class="fas fa-calendar me-1"></i> Uploaded</th>
                            <th><i class="fas fa-user me-1"></i> By</th>
                            <th style="text-align:right;"><i class="fas fa-cog me-1"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in files.OrderByDescending(f => f.UploadedAt))
                        {
                            <tr>
                                <td>
                                    <div class="file-info">
                                        <i class="fas @Icon(f.FileName) file-icon"></i>
                                        <div>
                                            <span class="file-name">@f.FileName</span>
                                            @if (!string.IsNullOrEmpty(f.Description))
                                            {
                                                <span class="file-description">@f.Description</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (string.IsNullOrEmpty(f.Category))
                                    {
                                        <span class="category-badge none">—</span>
                                    }
                                    else
                                    {
                                        <span class="category-badge">@f.Category</span>
                                    }
                                </td>
                                <td class="file-size">@Size(f.FileSize)</td>
                                <td class="file-date">@f.UploadedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td class="file-uploader">@(f.UploadedBy ?? "—")</td>
                                <td style="text-align:right;white-space:nowrap;">
                                    <div class="action-buttons">
                                        <a asp-action="Download" asp-route-id="@f.Id" class="action-btn btn-download" title="Download">
                                            <i class="fas fa-download"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@f.Id" method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Delete this file permanently?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn btn-delete" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-folder-open"></i>
                    <h3>No documents yet</h3>
                    <p>Upload the employee's first document using the form above</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #2563eb;
        --primary: #3b82f6;
        --primary-light: #60a5fa;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #3b82f6;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BACK BUTTON ===== */
    .btn-back {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        border-radius: 0.75rem;
        color: var(--gray-600);
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid var(--gray-200);
        flex-shrink: 0;
    }

        .btn-back:hover {
            background: var(--gray-50);
            color: var(--primary);
            transform: translateX(-2px);
            text-decoration: none;
        }

    /* ===== STATUS BADGE ===== */
    .ticket-status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .ticket-status-badge.active {
            background: #e6f5e9;
            color: var(--success);
        }

        .ticket-status-badge.closed {
            background: var(--gray-100);
            color: var(--gray-500);
        }

    /* ===== STATISTICS CARDS ===== */
    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 1rem;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s ease;
        border: 1px solid var(--gray-200);
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg, var(--primary-light), var(--primary));
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .stat-info h3 {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
        color: var(--gray-800);
    }

    .stat-info p {
        margin: 0;
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* ===== CARDS ===== */
    .upload-card,
    .data-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
    }

    .upload-card {
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--gray-50);
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--gray-200);
        font-weight: 600;
        color: var(--gray-700);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .card-body-custom {
        padding: 1.5rem;
    }

    .upload-hint {
        font-size: 0.75rem;
        font-weight: normal;
        color: var(--gray-500);
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

        .upload-hint i {
            color: var(--primary);
        }

    /* ===== UPLOAD FORM ===== */
    .upload-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .upload-field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

        .upload-field.full-width {
            grid-column: 1 / -1;
        }

    .field-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--gray-600);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .field-label i {
            color: var(--primary);
            font-size: 0.7rem;
        }

    .filter-select {
        width: 100%;
        padding: 0.625rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
        background: white;
        cursor: pointer;
    }

        .filter-select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59,130,246, 0.1);
        }

    .search-input {
        width: 100%;
        padding: 0.625rem 0.75rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        font-family: 'Inter', sans-serif;
    }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(59,130,246, 0.1);
        }

    /* ===== FILE DROP ZONE ===== */
    .file-drop-zone {
        border: 2px dashed var(--gray-300);
        border-radius: 0.75rem;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
        background: var(--gray-50);
        position: relative;
        cursor: pointer;
    }

        .file-drop-zone:hover {
            border-color: var(--primary);
            background: var(--gray-100);
        }

        .file-drop-zone input[type="file"] {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            cursor: pointer;
        }

    .file-drop-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        pointer-events: none;
    }

        .file-drop-label i {
            font-size: 2rem;
            color: var(--primary);
        }

        .file-drop-label span {
            color: var(--gray-600);
            font-size: 0.875rem;
        }

        .file-drop-label .file-hint {
            font-size: 0.75rem;
            color: var(--gray-400);
        }

    .file-list {
        margin-top: 0.75rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .file-item {
        background: white;
        border: 1px solid var(--gray-200);
        border-radius: 0.5rem;
        padding: 0.3rem 0.6rem;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--gray-700);
    }

        .file-item i {
            color: var(--primary);
        }

        .file-item .remove-file {
            cursor: pointer;
            color: var(--danger);
            font-size: 0.65rem;
            margin-left: 0.2rem;
        }

    /* ===== UPLOAD BUTTON ===== */
    .btn-upload {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        font-size: 0.875rem;
        font-family: 'Inter', sans-serif;
    }

        .btn-upload:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

    /* ===== TABLE ===== */
    .data-table.tickets-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table.tickets-table thead {
            background: var(--gray-50);
            border-bottom: 2px solid var(--gray-200);
        }

        .data-table.tickets-table th {
            padding: 1rem 1.5rem;
            text-align: left;
            font-weight: 600;
            color: var(--gray-600);
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .data-table.tickets-table td {
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--gray-200);
            vertical-align: middle;
        }

        .data-table.tickets-table tbody tr {
            transition: background-color 0.2s;
        }

            .data-table.tickets-table tbody tr:hover {
                background-color: var(--gray-50);
            }

    /* ===== FILE INFO ===== */
    .file-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .file-icon {
        font-size: 1.25rem;
        color: var(--primary);
        width: 24px;
        text-align: center;
    }

    .file-name {
        font-weight: 500;
        color: var(--gray-800);
        display: block;
    }

    .file-description {
        font-size: 0.7rem;
        color: var(--gray-500);
        display: block;
        margin-top: 0.1rem;
    }

    .file-size {
        font-size: 0.875rem;
        color: var(--gray-600);
    }

    .file-date {
        font-size: 0.875rem;
        color: var(--gray-500);
    }

    .file-uploader {
        font-size: 0.875rem;
        color: var(--gray-600);
    }

    /* ===== CATEGORY BADGE ===== */
    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #eff6ff;
        color: var(--primary-dark);
        border: 1px solid #cce4ff;
        padding: 0.2rem 0.6rem;
        border-radius: 2rem;
        font-size: 0.72rem;
        font-weight: 600;
    }

        .category-badge.none {
            background: var(--gray-100);
            color: var(--gray-400);
            border-color: var(--gray-200);
        }

    /* ===== ACTION BUTTONS ===== */
    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }

    .action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.2s;
        font-size: 0.875rem;
        border: none;
        cursor: pointer;
    }

    .btn-download {
        background: var(--gray-100);
        color: var(--primary);
    }

        .btn-download:hover {
            background: var(--primary);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }

    .btn-delete {
        background: var(--gray-100);
        color: var(--danger);
    }

        .btn-delete:hover {
            background: var(--danger);
            color: white;
            transform: translateY(-2px);
        }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 3rem;
        color: var(--gray-500);
    }

        .empty-state i {
            font-size: 4rem;
            color: var(--gray-300);
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            color: var(--gray-600);
        }

        .empty-state p {
            margin-bottom: 0;
        }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .upload-grid {
            grid-template-columns: 1fr;
        }

        .upload-field.full-width {
            grid-column: 1;
        }
    }

    @@media (max-width: 768px) {
        .stats-cards {
            grid-template-columns: 1fr 1fr;
        }

        .card-header-custom {
            flex-direction: column;
            align-items: flex-start;
        }

        .data-table.tickets-table th,
        .data-table.tickets-table td {
            padding: 0.75rem 1rem;
        }

        .page-title {
            font-size: 1.5rem;
        }
    }

    @@media (max-width: 576px) {
        .stats-cards {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
            gap: 0.25rem;
        }

        .action-btn {
            width: 28px;
            height: 28px;
            font-size: 0.75rem;
        }

        .file-drop-zone {
            padding: 1rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // File list display
        const fileInput = document.getElementById('fileInput');
        const fileList = document.getElementById('fileList');

        if (fileInput && fileList) {
            fileInput.addEventListener('change', function() {
                fileList.innerHTML = '';
                const files = Array.from(this.files);

                if (files.length === 0) {
                    return;
                }

                files.forEach((file, index) => {
                    const fileItem = document.createElement('span');
                    fileItem.className = 'file-item';
                    fileItem.innerHTML = `
                        <i class="fas fa-file"></i>
                        ${file.name} (${formatFileSize(file.size)})
                        <span class="remove-file" data-index="${index}">
                            <i class="fas fa-times"></i>
                        </span>
                    `;
                    fileList.appendChild(fileItem);
                });

                // Remove file functionality
                document.querySelectorAll('.remove-file').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const index = parseInt(this.getAttribute('data-index'));
                        const dt = new DataTransfer();
                        const files = Array.from(fileInput.files);
                        files.splice(index, 1);
                        files.forEach(f => dt.items.add(f));
                        fileInput.files = dt.files;
                        // Trigger change event to refresh display
                        fileInput.dispatchEvent(new Event('change'));
                    });
                });
            });
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        // Drag and drop visual feedback
        const dropZone = document.querySelector('.file-drop-zone');
        if (dropZone) {
            dropZone.addEventListener('dragover', function(e) {
                e.preventDefault();
                this.style.borderColor = 'var(--primary)';
                this.style.background = 'var(--gray-100)';
            });

            dropZone.addEventListener('dragleave', function(e) {
                e.preventDefault();
                this.style.borderColor = 'var(--gray-300)';
                this.style.background = 'var(--gray-50)';
            });

            dropZone.addEventListener('drop', function(e) {
                e.preventDefault();
                this.style.borderColor = 'var(--gray-300)';
                this.style.background = 'var(--gray-50)';
            });
        }
    });
</script>