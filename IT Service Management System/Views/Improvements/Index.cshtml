@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model List<Improvement>
@{
    ViewData["Title"] = "Continuous Improvement Register";
    var canEdit = (bool)(ViewBag.CanEdit ?? false);
    var status = ViewBag.Status as ImprovementStatus?;

    Func<ImprovementStatus, string> statusClass = s => s switch
    {
        ImprovementStatus.Implemented => "b-published",
        ImprovementStatus.Rejected => "b-critical",
        ImprovementStatus.Proposed or ImprovementStatus.UnderReview => "b-draft",
        _ => "b-medium"
    };
}
<partial name="_ImsStyles" />

<div class="ims">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div>
                    <h1 class="page-title"><i class="fas fa-lightbulb"></i> Continuous Improvement Register</h1>
                    <p class="page-sub">Improvement opportunities &amp; lessons learned — ISO 9001 cl. 10.3 / ISO 27001 cl. 10.2</p>
                </div>
                <div class="head-actions">
                    @if (canEdit)
                    {
                        <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Log Improvement</a>
                    }
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat"><div class="ic blue"><i class="fas fa-lightbulb"></i></div><div><h3>@ViewBag.Total</h3><p>Total</p></div></div>
            <div class="stat"><div class="ic amber"><i class="fas fa-folder-open"></i></div><div><h3>@ViewBag.Open</h3><p>Open</p></div></div>
            <div class="stat"><div class="ic purple"><i class="fas fa-person-digging"></i></div><div><h3>@ViewBag.InProgress</h3><p>In Progress</p></div></div>
            <div class="stat"><div class="ic green"><i class="fas fa-circle-check"></i></div><div><h3>@ViewBag.Implemented</h3><p>Implemented</p></div></div>
        </div>

        <form method="get" class="toolbar">
            <select class="inp" name="status" onchange="this.form.submit()">
                <option value="">All statuses</option>
                @foreach (ImprovementStatus s in Enum.GetValues(typeof(ImprovementStatus)))
                {
                    <option value="@s" selected="@(status == s)">@s</option>
                }
            </select>
            <button class="btn-ghost-ims" type="submit"><i class="fas fa-magnifying-glass"></i> Filter</button>
        </form>

        <div class="card">
            <div class="card-body" style="padding:0;">
                @if (Model.Any())
                {
                    <table class="tbl">
                        <thead>
                            <tr><th>Reference</th><th>Title</th><th>Type</th><th>Department</th><th>Proposed By</th><th>Target</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Model)
                            {
                                <tr>
                                    <td><span class="docnum">@i.Reference</span></td>
                                    <td><a asp-action="Details" asp-route-id="@i.Id">@i.Title</a></td>
                                    <td class="meta">@i.Type</td>
                                    <td class="meta">@(i.Department?.Name ?? "—")</td>
                                    <td class="meta">@(i.ProposedBy?.FullName ?? "—")</td>
                                    <td class="meta">@(i.TargetDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td><span class="badge-ims @statusClass(i.Status)">@i.Status</span></td>
                                    <td>
                                        <div class="act-btns">
                                            <a class="act view" asp-action="Details" asp-route-id="@i.Id" title="Open"><i class="fas fa-eye"></i></a>
                                            @if (canEdit)
                                            {
                                                <a class="act edit" asp-action="Edit" asp-route-id="@i.Id" title="Edit"><i class="fas fa-pen"></i></a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty">
                        <i class="fas fa-lightbulb"></i>
                        <h3>No improvements logged</h3>
                        @if (canEdit)
                        {
                            <a class="btn-primary-ims" asp-action="Create"><i class="fas fa-plus"></i> Log the first one</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
