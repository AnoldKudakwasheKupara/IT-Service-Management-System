@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@using IT_Service_Management_System.Helpers.Ims
@model Improvement
@{
    ViewData["Title"] = "Edit " + Model.Reference;
    var departments = ViewBag.Departments as List<Department> ?? new();
    var users = ViewBag.Users as List<User> ?? new();
}
<partial name="_ImsStyles" />

<div class="ims narrow">
    <div class="page-container">
        <div class="page-header">
            <div class="head-row">
                <div style="display:flex;gap:1rem;align-items:center;">
                    <a class="btn-back" asp-action="Details" asp-route-id="@Model.Id"><i class="fas fa-arrow-left"></i></a>
                    <div>
                        <h1 class="page-title"><i class="fas fa-pen-to-square"></i> Edit @Model.Reference</h1>
                        <p class="page-sub">Update the improvement and record realised benefit on completion.</p>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="card">
                <div class="card-body">
                    <div class="form-grid">
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
                            <input class="inp" asp-for="Title" required />
                            <span asp-validation-for="Title" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-layer-group"></i> Type</label>
                            <select class="inp" asp-for="Type" asp-items="Html.GetEnumSelectList<ImprovementType>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
                            <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-building"></i> Department</label>
                            <select class="inp" asp-for="DepartmentId">
                                <option value="">— None —</option>
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-user"></i> Proposed By</label>
                            <select class="inp" asp-for="ProposedById">
                                <option value="">— None —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" selected="@(Model.ProposedById == u.Id)">@u.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-user-tie"></i> Owner</label>
                            <select class="inp" asp-for="OwnerId">
                                <option value="">— None —</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" selected="@(Model.OwnerId == u.Id)">@u.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-flag"></i> Status</label>
                            <select class="inp" asp-for="Status" asp-items="Html.GetEnumSelectList<ImprovementStatus>()"></select>
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-calendar-day"></i> Target Date</label>
                            <input class="inp" type="date" asp-for="TargetDate" />
                        </div>
                        <div class="fg">
                            <label class="lbl"><i class="fas fa-calendar-check"></i> Completed Date</label>
                            <input class="inp" type="date" asp-for="CompletedDate" />
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-align-left"></i> Description <span class="req">*</span></label>
                            <textarea class="inp" asp-for="Description" rows="4" required></textarea>
                            <span asp-validation-for="Description" class="hint" style="color:var(--danger)"></span>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-chart-line"></i> Expected Benefit</label>
                            <textarea class="inp" asp-for="ExpectedBenefit" rows="3"></textarea>
                        </div>
                        <div class="fg full">
                            <label class="lbl"><i class="fas fa-award"></i> Actual Benefit</label>
                            <textarea class="inp" asp-for="ActualBenefit" rows="3" placeholder="Benefit realised once implemented"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Save Changes</button>
                        <a class="btn-ghost-ims" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
