@using IT_Service_Management_System.Models
@using IT_Service_Management_System.Models.Ims
@model Risk
@{
    var users = ViewBag.Users as List<User> ?? new();
    var departments = ViewBag.Departments as List<Department> ?? new();
    var assets = ViewBag.Assets as List<Asset> ?? new();
}
<div class="form-grid">
    <div class="fg full">
        <label class="lbl"><i class="fas fa-heading"></i> Title <span class="req">*</span></label>
        <input class="inp" asp-for="Title" required />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-tags"></i> Category</label>
        <select class="inp" asp-for="Category" asp-items="Html.GetEnumSelectList<RiskCategory>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-certificate"></i> ISO Standard</label>
        <select class="inp" asp-for="Standard" asp-items="Html.GetEnumSelectList<IsoStandard>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-server"></i> Related Asset</label>
        <select class="inp" asp-for="AssetId"><option value="">— None —</option>
            @foreach (var a in assets) { <option value="@a.Id" selected="@(Model.AssetId == a.Id)">@a.ItemName @(string.IsNullOrEmpty(a.AssetTag) ? "" : $"({a.AssetTag})")</option> }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-user-tie"></i> Owner</label>
        <select class="inp" asp-for="OwnerId"><option value="">— None —</option>
            @foreach (var u in users) { <option value="@u.Id" selected="@(Model.OwnerId == u.Id)">@u.FullName</option> }
        </select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-building"></i> Department</label>
        <select class="inp" asp-for="DepartmentId"><option value="">— None —</option>
            @foreach (var d in departments) { <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option> }
        </select>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-align-left"></i> Description</label>
        <textarea class="inp" asp-for="Description" rows="2"></textarea>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-bolt"></i> Threat</label>
        <textarea class="inp" asp-for="Threat" rows="2"></textarea>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-unlock"></i> Vulnerability</label>
        <textarea class="inp" asp-for="Vulnerability" rows="2"></textarea>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-dice"></i> Likelihood (1–5) <span class="req">*</span></label>
        <input class="inp" type="number" min="1" max="5" asp-for="Likelihood" required />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-burst"></i> Impact (1–5) <span class="req">*</span></label>
        <input class="inp" type="number" min="1" max="5" asp-for="Impact" required />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-shield"></i> Treatment</label>
        <select class="inp" asp-for="Treatment" asp-items="Html.GetEnumSelectList<RiskTreatment>()"></select>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-flag"></i> Status</label>
        <select class="inp" asp-for="Status" asp-items="Html.GetEnumSelectList<RiskStatus>()"></select>
    </div>
    <div class="fg full">
        <label class="lbl"><i class="fas fa-clipboard-list"></i> Treatment Plan</label>
        <textarea class="inp" asp-for="TreatmentPlan" rows="2"></textarea>
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-dice"></i> Residual Likelihood (1–5)</label>
        <input class="inp" type="number" min="1" max="5" asp-for="ResidualLikelihood" />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-burst"></i> Residual Impact (1–5)</label>
        <input class="inp" type="number" min="1" max="5" asp-for="ResidualImpact" />
    </div>
    <div class="fg">
        <label class="lbl"><i class="fas fa-calendar-day"></i> Review Date</label>
        <input class="inp" type="date" asp-for="ReviewDate" />
    </div>
</div>
