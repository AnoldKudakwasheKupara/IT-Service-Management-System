@using IT_Service_Management_System.Models.Ims
@model Risk
@{ ViewData["Title"] = "Edit Risk"; }
<partial name="_ImsStyles" />
<div class="ims narrow"><div class="page-container">
    <div class="page-header"><div class="head-row"><div style="display:flex;gap:1rem;align-items:center;">
        <a class="btn-back" asp-action="Details" asp-route-id="@Model.Id"><i class="fas fa-arrow-left"></i></a>
        <div><h1 class="page-title"><i class="fas fa-pen-to-square"></i> Edit @Model.Reference</h1><p class="page-sub">@Model.Title</p></div>
    </div></div></div>
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">@Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card"><div class="card-body">
            <partial name="_Fields" model="Model" />
            <div class="form-actions"><button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Save</button><a class="btn-ghost-ims" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
        </div></div>
    </form>
</div></div>
