@using IT_Service_Management_System.Models.Ims
@model Opportunity
@{ ViewData["Title"] = "Edit Opportunity"; }
<partial name="_ImsStyles" />
<div class="ims narrow"><div class="page-container">
    <div class="page-header"><div class="head-row"><div style="display:flex;gap:1rem;align-items:center;">
        <a class="btn-back" asp-action="Opportunities"><i class="fas fa-arrow-left"></i></a>
        <div><h1 class="page-title"><i class="fas fa-pen-to-square"></i> Edit @Model.Reference</h1><p class="page-sub">@Model.Title</p></div>
    </div></div></div>
    <form method="post" asp-action="EditOpportunity" asp-route-id="@Model.Id">@Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card"><div class="card-body">
            <partial name="_OppFields" model="Model" />
            <div class="form-actions">
                <button class="btn-primary-ims" type="submit"><i class="fas fa-save"></i> Save</button>
                <a class="btn-ghost-ims" asp-action="Opportunities">Cancel</a>
                <button class="btn-danger-ims" type="submit" formaction="@Url.Action("DeleteOpportunity", new { id = Model.Id })" formmethod="post" onclick="return confirm('Delete this opportunity?');" style="margin-left:auto;"><i class="fas fa-trash"></i> Delete</button>
            </div>
        </div></div>
    </form>
</div></div>
