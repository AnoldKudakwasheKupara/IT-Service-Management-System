@model IT_Service_Management_System.Models.AppConfiguration
@{
    ViewData["Title"] = "Configuration - Axis IT Operations";
    bool smtpPwd = ViewBag.SmtpPasswordConfigured ?? false;
}

<div class="page-container">
    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="page-title">
                    <i class="fas fa-sliders me-2" style="color: var(--primary);"></i>
                    Configuration
                </h1>
                <p class="text-muted mt-2">
                    Security policy &amp; system settings &middot; last updated
                    @Model.UpdatedAt.ToString("MMM dd, yyyy h:mm tt")
                    @(string.IsNullOrEmpty(Model.UpdatedBy) ? "" : $" by {Model.UpdatedBy}")
                </p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn-create-ticket" asp-controller="Security" asp-action="Index" style="background: var(--gray-100); color: var(--gray-700);">
                    <i class="fas fa-shield-halved"></i>
                    Security Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- FLASH MESSAGES -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-flash success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    <div asp-validation-summary="All" class="alert-flash danger"></div>

    <!-- FORM -->
    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="cfg-grid">

            <!-- Password Policy -->
            <div class="data-card cfg-card">
                <div class="card-header-custom">
                    <i class="fas fa-key me-2"></i>
                    <span>Password Policy</span>
                </div>
                <div class="card-body-custom">
                    <div class="cfg-field">
                        <label asp-for="PasswordMinLength">Minimum length</label>
                        <input asp-for="PasswordMinLength" type="number" min="6" max="128" class="cfg-input" />
                        <span asp-validation-for="PasswordMinLength" class="cfg-err"></span>
                    </div>
                    <label class="cfg-toggle">
                        <input asp-for="PasswordRequireUppercase" type="checkbox" />
                        <span>Require uppercase letter</span>
                    </label>
                    <label class="cfg-toggle">
                        <input asp-for="PasswordRequireLowercase" type="checkbox" />
                        <span>Require lowercase letter</span>
                    </label>
                    <label class="cfg-toggle">
                        <input asp-for="PasswordRequireDigit" type="checkbox" />
                        <span>Require a number</span>
                    </label>
                    <label class="cfg-toggle">
                        <input asp-for="PasswordRequireSpecial" type="checkbox" />
                        <span>Require special character</span>
                    </label>
                    <div class="cfg-field">
                        <label asp-for="PasswordExpiryDays">Password expiry (days, 0 = never)</label>
                        <input asp-for="PasswordExpiryDays" type="number" min="0" max="3650" class="cfg-input" />
                        <span asp-validation-for="PasswordExpiryDays" class="cfg-err"></span>
                    </div>
                </div>
            </div>

            <!-- Account Lockout -->
            <div class="data-card cfg-card">
                <div class="card-header-custom">
                    <i class="fas fa-lock me-2"></i>
                    <span>Account Lockout</span>
                </div>
                <div class="card-body-custom">
                    <div class="cfg-field">
                        <label asp-for="LockoutMaxFailedAttempts">Max failed attempts (0 = disabled)</label>
                        <input asp-for="LockoutMaxFailedAttempts" type="number" min="0" max="50" class="cfg-input" />
                        <span asp-validation-for="LockoutMaxFailedAttempts" class="cfg-err"></span>
                    </div>
                    <div class="cfg-field">
                        <label asp-for="LockoutDurationMinutes">Lockout duration (minutes)</label>
                        <input asp-for="LockoutDurationMinutes" type="number" min="1" max="1440" class="cfg-input" />
                        <span asp-validation-for="LockoutDurationMinutes" class="cfg-err"></span>
                    </div>
                    <p class="cfg-hint">
                        <i class="fas fa-info-circle"></i>
                        After this many consecutive failed sign-ins, the account is locked for the duration set above.
                    </p>
                </div>
            </div>

            <!-- Session -->
            <div class="data-card cfg-card">
                <div class="card-header-custom">
                    <i class="fas fa-hourglass-half me-2"></i>
                    <span>Session</span>
                </div>
                <div class="card-body-custom">
                    <div class="cfg-field">
                        <label asp-for="SessionIdleTimeoutMinutes">Idle timeout (minutes)</label>
                        <input asp-for="SessionIdleTimeoutMinutes" type="number" min="1" max="1440" class="cfg-input" />
                        <span asp-validation-for="SessionIdleTimeoutMinutes" class="cfg-err"></span>
                    </div>
                    <p class="cfg-hint">
                        <i class="fas fa-triangle-exclamation" style="color: var(--warning);"></i>
                        Applies after the next application restart.
                    </p>
                </div>
            </div>

            <!-- MFA -->
            <div class="data-card cfg-card">
                <div class="card-header-custom">
                    <i class="fas fa-mobile-screen-button me-2"></i>
                    <span>Multi-Factor Authentication (Email OTP)</span>
                </div>
                <div class="card-body-custom">
                    <label class="cfg-toggle">
                        <input asp-for="MfaEnabled" type="checkbox" />
                        <span>Enable email OTP MFA</span>
                    </label>
                    <label class="cfg-toggle">
                        <input asp-for="MfaRequiredForAdmins" type="checkbox" />
                        <span>Require MFA for Admin / SystemsAdmin</span>
                    </label>
                    <div class="cfg-field">
                        <label asp-for="MfaOtpValidityMinutes">OTP validity (minutes)</label>
                        <input asp-for="MfaOtpValidityMinutes" type="number" min="1" max="60" class="cfg-input" />
                        <span asp-validation-for="MfaOtpValidityMinutes" class="cfg-err"></span>
                    </div>
                </div>
            </div>

            <!-- Email Server -->
            <div class="data-card cfg-card">
                <div class="card-header-custom">
                    <i class="fas fa-envelope me-2"></i>
                    <span>Email Server</span>
                </div>
                <div class="card-body-custom">
                    <div class="cfg-field">
                        <label asp-for="SmtpServer">SMTP server</label>
                        <input asp-for="SmtpServer" class="cfg-input" placeholder="smtp.gmail.com" />
                        <span asp-validation-for="SmtpServer" class="cfg-err"></span>
                    </div>
                    <div class="cfg-field">
                        <label asp-for="SmtpPort">SMTP port</label>
                        <input asp-for="SmtpPort" type="number" min="1" max="65535" class="cfg-input" />
                        <span asp-validation-for="SmtpPort" class="cfg-err"></span>
                    </div>
                    <div class="cfg-field">
                        <label asp-for="SenderName">Sender name</label>
                        <input asp-for="SenderName" class="cfg-input" placeholder="Axis IT Operations" />
                        <span asp-validation-for="SenderName" class="cfg-err"></span>
                    </div>
                    <div class="cfg-field">
                        <label asp-for="SenderEmail">Sender email</label>
                        <input asp-for="SenderEmail" type="email" class="cfg-input" />
                        <span asp-validation-for="SenderEmail" class="cfg-err"></span>
                    </div>
                    <div class="cfg-status @(smtpPwd ? "status-success" : "status-warning")">
                        @if (smtpPwd)
                        {
                            <i class="fas fa-check-circle"></i>
                            <span>SMTP password is configured (stored in user-secrets).</span>
                        }
                        else
                        {
                            <i class="fas fa-triangle-exclamation"></i>
                            <span>SMTP password not set. Run <code>dotnet user-secrets set "EmailSettings:SenderPassword" "&lt;app-password&gt;"</code></span>
                        }
                    </div>
                </div>
            </div>

            <!-- Backup Schedule -->
            <div class="data-card cfg-card">
                <div class="card-header-custom">
                    <i class="fas fa-database me-2"></i>
                    <span>Backup Schedule</span>
                </div>
                <div class="card-body-custom">
                    <label class="cfg-toggle">
                        <input asp-for="BackupEnabled" type="checkbox" />
                        <span>Enable scheduled backups</span>
                    </label>
                    <div class="cfg-field">
                        <label asp-for="BackupFrequency">Frequency</label>
                        <select asp-for="BackupFrequency" class="cfg-input">
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                        </select>
                    </div>
                    <div class="cfg-field">
                        <label asp-for="BackupTime">Time (HH:mm)</label>
                        <input asp-for="BackupTime" class="cfg-input" placeholder="02:00" />
                        <span asp-validation-for="BackupTime" class="cfg-err"></span>
                    </div>
                    <div class="cfg-field">
                        <label asp-for="BackupRetentionCount">Retention (keep last N)</label>
                        <input asp-for="BackupRetentionCount" type="number" min="1" max="365" class="cfg-input" />
                        <span asp-validation-for="BackupRetentionCount" class="cfg-err"></span>
                    </div>
                    <div class="cfg-field">
                        <label asp-for="BackupPath">Backup folder path</label>
                        <input asp-for="BackupPath" class="cfg-input" placeholder="C:\Backups\Helpdesk" />
                        <span asp-validation-for="BackupPath" class="cfg-err"></span>
                    </div>
                    <p class="cfg-hint">
                        <i class="fas fa-info-circle"></i>
                        Manage and run backups from the <a asp-controller="Backup" asp-action="Index" class="cfg-link">Backup</a> screen.
                    </p>
                </div>
            </div>

            <!-- Security Alerts -->
            <div class="data-card cfg-card cfg-span">
                <div class="card-header-custom">
                    <i class="fas fa-bell me-2"></i>
                    <span>Security Alerts</span>
                </div>
                <div class="card-body-custom">
                    <div class="cfg-field">
                        <label asp-for="AlertEmailRecipients">Alert recipient emails (comma-separated)</label>
                        <input asp-for="AlertEmailRecipients" class="cfg-input" placeholder="admin@company.com, security@company.com" />
                        <span asp-validation-for="AlertEmailRecipients" class="cfg-err"></span>
                    </div>
                    <div class="cfg-toggle-grid">
                        <label class="cfg-toggle">
                            <input asp-for="AlertOnMultipleFailedLogins" type="checkbox" />
                            <span>Multiple failed logins</span>
                        </label>
                        <label class="cfg-toggle">
                            <input asp-for="AlertOnNewAdminAccount" type="checkbox" />
                            <span>New administrator account</span>
                        </label>
                        <label class="cfg-toggle">
                            <input asp-for="AlertOnPrivilegeEscalation" type="checkbox" />
                            <span>Privilege escalation</span>
                        </label>
                        <label class="cfg-toggle">
                            <input asp-for="AlertOnSuspiciousLocation" type="checkbox" />
                            <span>Suspicious login location</span>
                        </label>
                        <label class="cfg-toggle">
                            <input asp-for="AlertOnLargeDataExport" type="checkbox" />
                            <span>Large / unusual data export</span>
                        </label>
                        <label class="cfg-toggle">
                            <input asp-for="AlertOnBackupFailure" type="checkbox" />
                            <span>Backup failure</span>
                        </label>
                        <label class="cfg-toggle">
                            <input asp-for="AlertOnDatabaseFailure" type="checkbox" />
                            <span>Database failure</span>
                        </label>
                    </div>
                </div>
            </div>

        </div>

        <!-- Form Actions -->
        <div class="cfg-actions">
            <button type="submit" class="btn-create-ticket">
                <i class="fas fa-save"></i>
                Save Configuration
            </button>
        </div>
    </form>
</div>

<style>
    /* ===== ROOT VARIABLES (from Dashboard) ===== */
    :root {
        --primary-dark: #8f171c;
        --primary: #b11d23;
        --primary-light: #d9565d;
        --success: #2c9e6e;
        --warning: #f5b042;
        --danger: #e53e3e;
        --info: #b11d23;
        --gray-50: #f8fafc;
        --gray-100: #f1f5f9;
        --gray-200: #e2e8f0;
        --gray-300: #cbd5e1;
        --gray-400: #94a3b8;
        --gray-500: #64748b;
        --gray-600: #475569;
        --gray-700: #334155;
        --gray-800: #1e293b;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    /* ===== PAGE CONTAINER ===== */
    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.875rem;
        font-weight: 700;
        color: var(--gray-800);
        margin: 0;
    }

    /* ===== BUTTONS ===== */
    .btn-create-ticket {
        background: linear-gradient(100deg, var(--primary-dark), var(--primary));
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: var(--shadow-sm);
        border: none;
        cursor: pointer;
        font-size: 0.875rem;
        font-family: inherit;
    }

        .btn-create-ticket:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            color: white;
            text-decoration: none;
        }

    /* ===== ALERT FLASH ===== */
    .alert-flash {
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
        font-weight: 500;
        border: 1px solid transparent;
    }

        .alert-flash.success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .alert-flash.danger {
            background: #fef2f2;
            border-color: #fecaca;
            color: #b91c1c;
        }

            .alert-flash.danger:empty {
                display: none;
            }

        .alert-flash i {
            font-size: 1.1rem;
        }

    /* ===== CONFIGURATION GRID ===== */
    .cfg-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .cfg-span {
        grid-column: 1 / -1;
    }

    /* ===== CONFIGURATION CARDS ===== */
    .cfg-card {
        background: white;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--gray-200);
        transition: all 0.3s ease;
    }

        .cfg-card:hover {
            box-shadow: var(--shadow-md);
        }

        .cfg-card .card-header-custom {
            background: var(--gray-50);
            padding: 1rem 1.5rem;
            border-bottom: 1px solid var(--gray-200);
            font-weight: 600;
            color: var(--gray-700);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .cfg-card .card-body-custom {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

    /* ===== FORM FIELDS ===== */
    .cfg-field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--gray-700);
    }

        .cfg-field label {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--gray-600);
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

    .cfg-input {
        padding: 0.55rem 0.75rem;
        border: 1.5px solid var(--gray-200);
        border-radius: 0.6rem;
        font-size: 0.875rem;
        font-weight: 400;
        font-family: inherit;
        background: white;
        transition: all 0.2s;
        width: 100%;
    }

        .cfg-input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(177, 29, 35, 0.1);
        }

        .cfg-input.input-validation-error {
            border-color: var(--danger) !important;
        }

            .cfg-input.input-validation-error:focus {
                box-shadow: 0 0 0 3px rgba(229, 62, 62, 0.1);
            }

        .cfg-input[type="number"] {
            max-width: 120px;
        }

        .cfg-input[type="email"] {
            max-width: 100%;
        }

    /* ===== TOGGLES ===== */
    .cfg-toggle {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.85rem;
        color: var(--gray-700);
        cursor: pointer;
        font-weight: 500;
        padding: 0.3rem 0;
        border-radius: 0.4rem;
        transition: background 0.2s;
    }

        .cfg-toggle:hover {
            background: var(--gray-50);
        }

        .cfg-toggle input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--primary);
            cursor: pointer;
            flex-shrink: 0;
            border-radius: 0.3rem;
        }

    .cfg-toggle-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.4rem;
        margin-top: 0.25rem;
    }

    /* ===== HINTS & STATUS ===== */
    .cfg-hint {
        font-size: 0.75rem;
        color: var(--gray-500);
        margin: 0.15rem 0 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .cfg-hint i {
            color: var(--info);
            font-size: 0.7rem;
        }

    .cfg-link {
        color: var(--primary-dark);
        font-weight: 600;
        text-decoration: none;
    }

        .cfg-link:hover {
            color: var(--primary);
            text-decoration: underline;
        }

    .cfg-status {
        padding: 0.6rem 0.9rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        border: 1px solid transparent;
        margin-top: 0.25rem;
    }

        .cfg-status.status-success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

            .cfg-status.status-success i {
                color: var(--success);
            }

        .cfg-status.status-warning {
            background: #fffbeb;
            border-color: #fde68a;
            color: #92400e;
        }

            .cfg-status.status-warning i {
                color: var(--warning);
            }

        .cfg-status code {
            background: rgba(0, 0, 0, 0.06);
            padding: 0.1rem 0.4rem;
            border-radius: 0.3rem;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--gray-700);
        }

    /* ===== ERRORS ===== */
    .cfg-err {
        color: var(--danger);
        font-size: 0.72rem;
        font-weight: 500;
        margin-top: 0.1rem;
    }

        .cfg-err:empty {
            display: none;
        }

    /* ===== FORM ACTIONS ===== */
    .cfg-actions {
        margin-top: 1.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 992px) {
        .cfg-grid {
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
    }

    @@media (max-width: 768px) {
        .cfg-grid,
        .cfg-toggle-grid {
            grid-template-columns: 1fr;
        }

        .cfg-span {
            grid-column: 1;
        }

        .page-header .d-flex.justify-content-between {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .cfg-card .card-body-custom {
            padding: 1rem;
        }

        .cfg-actions {
            justify-content: stretch;
        }

            .cfg-actions .btn-create-ticket {
                width: 100%;
                justify-content: center;
            }
    }

    @@media (max-width: 576px) {
        .page-title {
            font-size: 1.5rem;
        }

        .btn-create-ticket {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }

        .cfg-input[type="number"] {
            max-width: 100%;
        }

        .cfg-toggle-grid {
            gap: 0.25rem;
        }

        .cfg-status {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.3rem;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}